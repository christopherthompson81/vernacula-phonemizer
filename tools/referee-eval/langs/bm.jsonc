        { "pattern": "[\\u02E5\\u02E6\\u02E7\\u02E8\\u02E9\\uA71C]", "replace": "", "note": "TONE: the Chao tone-letter bars (˥˦˧˨˩) + the downstep marker (ꜜ) — deferred, strip" },
