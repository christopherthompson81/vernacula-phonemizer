    ],
    "secondaryGap": "Single source (wikipron hat_latn_broad, human, 1691). kaikki Haitian Creole is a candidate 2nd but not committed. The map is the standard IPN phonology (Valdman; Pressoir-Faublas 1979); the orthography is near-phonemic so little diverges.",
    "folds": [
        { "pattern": "ʁ", "replace": "ɣ", "note": "the Haitian rhotic is [ɣ]~[ʁ]~[ɰ]~[w] (velar/uvular fricative or glide, position + register variable); we emit [ɣ], fold the variants" },
        { "pattern": "ɰ", "replace": "ɣ", "note": "the rhotic realized as the velar approximant [ɰ] (before a rounded vowel) → fold to [ɣ]" },
        { "pattern": "õ", "replace": "ɔ̃", "note": "⟨on⟩ = [ɔ̃] ~ [õ] (the referee writes both for the nasal o); fold to [ɔ̃]" },
        { "pattern": "ũ", "replace": "u", "note": "⟨oun⟩ occasionally marked nasal [ũ] in the referee (we emit oral [un]); fold — Haitian ⟨ou⟩ before ⟨n⟩ is not phonemically nasal" }
