// Bhojpuri (bho) — Indo-Aryan, Devanagari. The referee is a g2p-MINE of "A Grammar of Bhojpuri" (dissertation,
// Shukla-tradition): 1622 Devanagari→IPA example pairs auto-extracted from the grammar's glossed forms. Single
// published source (🔷). The module was REVISED to match it: 8-vowel /i e ɛ a ʌ ɔ o u/ NO length, ऐ→ɛ/औ→ɔ
// MONOPHTHONGS, श/ष→s, व→w, ण/ञ→n. Folds are NOTATION only (the grammar writes j for ज, c for च, y for य, r for
// the tap, ʌ for schwa, drops the breathy diacritic). Residual = the grammar's schwa-deletion granularity +
// tatsama vowel epenthesis (istiri, iskul) + mining fragments/misalignments — a bounded, documented tail.
{
    "referees": [
        { "file": "bho.grammar-mined.tsv", "source": "A Grammar of Bhojpuri (mined, 1622 pairs)", "role": "primary" }
    ],
    "folds": [
        { "pattern": "[ˈˌ]", "replace": "", "note": "stress — not in the grammar's segmental transcriptions" },
        { "pattern": "j", "replace": "y", "note": "the ⟨य⟩ glide: grammar writes [y] (before ज d͡ʒ→j below)" },
        { "pattern": "dʒ", "replace": "j", "note": "⟨ज⟩ [d͡ʒ] (tie stripped by the backbone): grammar writes [j]" },
        { "pattern": "tʃ", "replace": "c", "note": "⟨च⟩ [t͡ʃ]: grammar writes [c]" },
        { "pattern": "ɾ", "replace": "r", "note": "the ⟨र⟩ tap [ɾ] ~ the grammar's [r]" },
        { "pattern": "ʱ", "replace": "", "note": "breathy voice: the grammar's diaeresis notation is stripped by the backbone → drop ours too" },
        { "pattern": "[ɳɲ]", "replace": "n", "note": "⟨ण ञ⟩ retroflex/palatal nasals — allophones of /n/ (Grammar Table 4.13)" },
        { "pattern": "ə", "replace": "ʌ", "note": "the schwa: fleet ə ~ the grammar's [ʌ]" }
    ]
}
