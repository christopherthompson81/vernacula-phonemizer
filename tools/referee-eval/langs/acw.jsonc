// Hijazi Arabic (western Saudi) (acw) — an Arabic VARIETY on the shared engine, evaluated through phonemizeArabic(text, ...): the MSA
// neural diacritizer restores short vowels, the MSA g2p runs, then the variety's consonant/diphthong shifts apply.
// Referee: wikipron acw_arab_broad (HUMAN, fully-voweled DIALECTAL IPA, INDEPENDENT). Same pausal + gemination
// folds as MSA. Short-vowel restructuring (the diacritizer restores MSA vowels) + learned-word interdental
// retention are the known lexical tail — consonants + diphthongs are the measured backbone.
{
    "referees": [
        { "file": "acw.wikipron-acw-broad.tsv", "source": "wikipron acw_arab broad (human)", "role": "primary" }
    ],
    "segmentJoin": true,
    // ⚠ NO PAUSAL FOLD. ar.jsonc strips a word-final short vowel because MSA's iʕrab case ending is not
    // pronounced in pause. THE SPOKEN DIALECTS DROPPED IʕRAB — a final short vowel here is lexical, not a case
    // ending, so stripping it scored its absence as free (the axis-deletion failure) AND fired asymmetrically,
    // since it ran as a preFold, before the symbol folds. Removing it moved this family +0.5 to +6.1pp.
    // Measured 2026-08-20; see docs/investigations/arz/arz_referee_investigation.md.
    "folds": [
        { "pattern": "(.)\\1+", "replace": "$1", "note": "gemination (shadda): collapse doubling — length already stripped by the backbone" }
    ]
}
