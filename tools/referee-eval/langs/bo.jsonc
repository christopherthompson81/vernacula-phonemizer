        { "pattern": "kʲ", "replace": "c", "note": "the palatalized velar: kʲ (JIPA) ~ c (module) — notation" },
        { "pattern": "[ɻʐʂ]", "replace": "ʐ", "note": "the rhotic /ɻ/ has realizations [ɻ ʐ ʂ ɾ r] (JIPA) — fold to one" },
        { "pattern": "ȵ", "replace": "ɲ", "note": "the palatal nasal: we write ɲ (JIPA inventory), the module writes ȵ — notation" },
