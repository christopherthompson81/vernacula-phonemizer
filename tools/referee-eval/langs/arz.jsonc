// Egyptian Arabic (arz) — the first Arabic VARIETY. Evaluated through the async pipeline phonemizeArabic(text,
// "egyptian"): the MSA neural diacritizer restores the short vowels, the MSA g2p runs, then the Egyptian shifts
// (ج→ɡ, ق→ʔ, ث→t, ذ/ظ→d/dˤ, ay→eː, aw→oː) transform it. Referee: wikipron arz_arab_broad (HUMAN, fully-voweled
// DIALECTAL IPA, INDEPENDENT). Same pausal + gemination folds as MSA. The short-vowel restructuring gap (MSA
// diacritizer restores MSA vowels, not Egyptian) is the documented tail — a dialect vowel lexicon is Phase 2.
{
    "referees": [
        {
            "file": "arz.wikipron-arz-broad.tsv",
            "source": "wikipron arz_arab broad (human)",
            "role": "primary"
        }
    ],
    "segmentJoin": true,
    "preFolds": [
        {
            "pattern": "[aiu]$",
            "replace": "",
            "note": "PAUSAL: drop a word-final short vowel (as MSA; preFold so long aː/iː/uː/eː/oː ending in ː survive)"
        }
    ],
    "folds": [
        {
            "pattern": "(.)\\1+",
            "replace": "$1",
            "note": "gemination (shadda): collapse doubling — length already stripped by the backbone"
        }
    ]
}
