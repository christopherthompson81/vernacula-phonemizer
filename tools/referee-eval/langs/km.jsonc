// Khmer (km) — Austroasiatic, the Khmer two-series abugida. wikipron khm_khmr broad is a LARGE human referee (7107).
// Non-tonal. The g2p renders base(series)→coeng→vowel(by series)→coda. segmentJoin joins the space-segmented IPA.
{
    "language": "km", "name": "Khmer", "script": "Khmer",
    "provenance": "Authored two-series abugida; series + vowel two-readings derived from wikipron khm.",
    "referees": [
        { "file": "km.wikipron-khm-broad.tsv", "source": "wikipron khm_khmr broad (human)", "role": "primary" },
        // NON-Wiktionary lineage — the independent second tradition (kaikki would be the same source as the
        // primary). ⚠ The SHIPPED phonemizeWord must never be scored against it: its dictionary tier IS this
        // data. The eval scores phonemizeWordRules (no lexicon), which is what keeps this non-circular.
        {
            "file": "km.google-lexicon.tsv",
            "source": "google/language-resources km lexicon (human-curated, CC BY 4.0)",
            "role": "secondary",
            "folds": [
                { "pattern": "ʋ", "replace": "w", "note": "the two referees transcribe the SAME phoneme /ʋ/~[w] with opposite letters: in C+coeng+វ clusters wikipron writes ʋ 120:1 while google writes w 1133:288. Pure notation for one phoneme → fold ʋ→w on both sides, THIS referee only (the engine follows the primary\u2019s ʋ)." },
                { "pattern": "ou", "replace": "oː", "note": "the ូ vowel: a TOTAL convention split — wikipron writes ou 471:6, google writes oː 9151:0. Same phoneme, two notations; fold ou→oː on both sides, this referee only. ⚠ ə~ɨ was checked the same way and is NOT foldable: both referees use both at ~2.4:1, i.e. lexical variance, and folding it would hide real errors." }
            ]
        }
    ],
    "segmentJoin": true,
    "folds": [
        { "pattern": "[ptkc]$", "replace": "ʔ", "note": "word-final voiceless stops are variably GLOTTALISED in the referee ([k]~[ʔ]); fold the word-final coda stop ~ ʔ (both sides)" },
        { "pattern": "ɑ(?!ː)", "replace": "a", "note": "the short low-central vowel is transcribed variably ɑ~a (ចន្ទ can ~ cɑn); normalise short ɑ→a on both sides (long ɑː preserved)" },
        { "pattern": "ʔ(?=[pbtdckɡʔszhfmnɲŋrljwʋɓɗ])", "replace": "", "note": "the unwritten minor-syllable glottal /ʔ/ is OPTIONAL medially (Huffman IX.B.2: present in reading, lost in colloquial — the referee carries both, e.g. tʰeəʔ...~tʰɔː...); drop pre-consonantal ʔ on both sides" },
        { "pattern": "ŭ", "replace": "u", "note": "referee marks short vowels with a breve (ŭə vs uə); normalise the short-diphthong notation on both sides" },
        { "pattern": "ŏ", "replace": "o", "note": "breve short-vowel notation → plain (ŏə → oə)" },
        { "pattern": "ĕ", "replace": "e", "note": "breve short-vowel notation → plain (ĕə → eə)" },
        { "pattern": "ʰ", "replace": "", "note": "aspiration is transcribed INCONSISTENTLY in the broad referee (both directions occur — កំប្លែង kampʰlaeŋ~kamplaeŋ, ខ្ញុំ kɲom deaspirated in a cluster); our output keeps canonical per-letter aspiration (ខ→kʰ), so fold ʰ off on both sides for scoring only" }
    ]
}
