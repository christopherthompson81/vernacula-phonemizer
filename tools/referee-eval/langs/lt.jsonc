    "language": "lt", "name": "Lithuanian (lietuvių)", "script": "Latin",
    "provenance": "Authored rule-based g2p (palatalization + voicing) from Lithuanian phonology; validated against the wikipron lit_latn_narrow referee (15,513 human words).",
    "segmentJoin": true,
