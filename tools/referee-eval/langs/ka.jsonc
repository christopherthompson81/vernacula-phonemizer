        { "pattern": "e", "replace": "ɛ", "note": "mid-vowel symbol: ⟨ე⟩ is [e̞] (BACKBONE strips the ̞ → e); we emit the standard phonemic ɛ — fold e→ɛ (we emit no bare e, and referee e only comes from ⟨ე⟩)" },
        { "pattern": "o", "replace": "ɔ", "note": "mid-vowel symbol: ⟨ო⟩ is [o̞]→o; we emit ɔ — fold o→ɔ" },
        { "pattern": "ɫ", "replace": "l", "note": "dark [ɫ] (⟨ლ⟩ before back vowels / in coda) is allophonic — we emit plain l → fold" },
        { "pattern": "ŋ", "replace": "n", "note": "⟨ნ⟩→[ŋ] before a velar is nasal-place assimilation (allophonic) — we emit n → fold" },
        { "pattern": "ʷ", "replace": "v", "note": "⟨ვ⟩ in a consonant cluster is realised as labialisation [ʷ] (ʃʷ, mʷ); we emit the full v everywhere → fold ʷ→v" },
        { "pattern": "x", "replace": "χ", "note": "⟨ხ⟩ has a velar allophone [x] before a front vowel (the referee writes it ~3×, vs χ ~1664×); we emit the uvular χ everywhere → fold the referee's x→χ (our output carries no bare x)" },
        { "pattern": "f", "replace": "v", "note": "⟨ვ⟩ devoices to [f] before a voiceless consonant or word-finally (regressive/final, e.g. ავთანდილ); Georgian has no phonemic /f/ (⟨ფ⟩ is pʰ) — we emit the phonemic v → fold f→v" }
