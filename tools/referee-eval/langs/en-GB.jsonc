// British English (en-GB) — modern Standard Southern British / "BBC" pronunciation, an ACCENT VARIANT of `en`
// (GenAm engine + a lexical-set delta, english-gb.ts). Referee: wikipron eng_latn_uk (HUMAN, NARROW, 76k merged
// variants; the eval credits ANY variant). The backbone already strips the narrow combining marks (a̝, t̪, length,
// stress); we fold aspiration (our kʰ/tʰ vs the referee's unmarked stops) and unify the NURSE/STRUT central vowels.
{
    "referees": [
        { "file": "en-gb.wikipron-uk.tsv", "source": "wikipron eng_latn_uk (human, narrow)", "role": "primary" }
    ],
    "folds": [
        {
            "pattern": "ᵻ",
            "replace": "ɪ",
            "note": "the weak vowel ᵻ has NO counterpart in the referee's inventory, so leaving it unfolded maps it to ALWAYS-WRONG — a uniform penalty on a documented house convention across ~4,525 lexicon rows. Measured per slot against this referee: our ᵻ draws ɪ 71.9% / ə 20.2%, our full ɪ draws ɪ 93.1% / ə 3.9%, our ə draws ɪ 10.1% / ə 82.3% — so ɪ is the best-supported single mapping by a wide margin. ⚠ IT IS NOT FREE: the referee PARTIALLY resolves ᵻ (our ᵻ and our full ɪ draw different ɪ-rates, 72% vs 93%), so this fold gives up catching an ᵻ written where a full ɪ belongs. That axis is kept visible outside the headline by tools/english/en_weak_vowel_survey.mts — see #1282."
        },
        { "pattern": "ʰ", "replace": "", "note": "aspiration on p/t/k — our GenAm engine marks it, the referee doesn't" },
        { "pattern": "ɫ", "replace": "l", "note": "DARK/velarised coda ⟨l⟩ [ɫ] — our engine marks the velarisation, the broad referee writes plain [l]; one phoneme" },
        { "pattern": "ɐ", "replace": "ə", "note": "the near-open central [ɐ] the narrow referee uses for NURSE/STRUT/commA ~ our [ə]/[ɜ]" },
        { "pattern": "ɜ", "replace": "ə", "note": "NURSE [ɜː] ~ [ə] after the backbone strips length — unify with the referee's [ə]/[ɐ]" },
        // The five CLOSING DIPHTHONGS, which en-GB writes with the parent's superscript offglide since #1252
        // — one unit rather than two full vowels that collide with every other language's ə/ɪ/ʊ in a shared
        // IPA corpus. The referee writes them the standard way, so these fold the notation and nothing else.
        // ⚠ EXACTLY THE FIVE `en.jsonc` ALREADY CARRIES, for exactly the same reason; only the GOAT ONSET
        // differs between the two (RP's central [ə] against GenAm's [o]), which is a real phone contrast and
        // is NOT folded here.
        { "pattern": "əᶷ", "replace": "əʊ", "note": "our GOAT offglide əᶷ vs referee əʊ" },
        { "pattern": "eᶦ", "replace": "eɪ", "note": "our FACE offglide eᶦ vs referee eɪ" },
        { "pattern": "aᶦ", "replace": "aɪ", "note": "our PRICE offglide aᶦ vs referee aɪ" },
        { "pattern": "aᶷ", "replace": "aʊ", "note": "our MOUTH offglide aᶷ vs referee aʊ" },
        { "pattern": "ɔᶦ", "replace": "ɔɪ", "note": "our CHOICE offglide ɔᶦ vs referee ɔɪ" }
    ]
}
