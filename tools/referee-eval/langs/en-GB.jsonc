// British English (en-GB) — modern Standard Southern British / "BBC" pronunciation, an ACCENT VARIANT of `en`
// (GenAm engine + a lexical-set delta, english-gb.ts). Referee: wikipron eng_latn_uk (HUMAN, NARROW, 76k merged
// variants; the eval credits ANY variant). The backbone already strips the narrow combining marks (a̝, t̪, length,
// stress); we fold aspiration (our kʰ/tʰ vs the referee's unmarked stops) and unify the NURSE/STRUT central vowels.
{
    "referees": [
        {
            "file": "en-gb.wikipron-uk.tsv", "source": "wikipron eng_latn_uk (human, narrow)", "role": "primary",
            "excludeRows": [
                { "ipa": "[ɚɝ]|[ɹɻr](?!(?:[\u0300-\u0328\u032a-\u036f\u0361\u0362]|[jwɹ]|⁽.⁾)*(?:[aeiouɑɒɔəɛɜɪʊʌæyøœɐɨʉɯɤʏɘɵɞɶᵻãäüĩĭ]|[nmlŋr]\u0329|ː))", "note": "US CONTAMINATION. This file is a UK corpus and 1,441 of its 76,284 headwords have EVERY reading rhotic — either an r-coloured ɚ/ɝ, which is not an RP symbol at all, or a coda ɹ. A non-rhotic engine cannot match one, and the measurement bears that out: WE PASS 0 OF THE 1,441. They are guaranteed failures in the denominator, so this removes false disagreements and costs no credit — the numerator does not move, the same signature the Moby non-rhotic rules produced on en. #1383 names this sweep as the cheap pass that improves every en-GB measurement. ⚠ THE EXCLUSION IS ALL-VARIANTS, which the machinery already enforces: 3,779 further headwords have SOME contaminated reading beside a clean one and are kept, because the scorer credits any variant and the clean one is still evidence. `asdr` is the shape to keep in mind — `eɪɛsdiːɑː` beside `eɪɛsdiːɑːɹ`, so the row stays on the strength of its British reading. ⚠ EVERY TERM IN THE LOOKAHEAD IS A FALSE POSITIVE THAT WAS FOUND, NOT A PRECAUTION. A /ɹ/ is an ONSET — not contamination — when what follows it is: a SYLLABIC consonant (`aboral æbɔːɹl̩`); a vowel behind another combining mark (`dramatize d̠͡ɹ̠ɑmətaɪz`); a GLIDE (`ryukyuan ɹjuːkjuːən`, `yprois iːpɹwɑː`); a PARENTHESISED optional segment (`oleksandrivka olɛksɑndɹ⁽ʲ⁾iʌ̯kɐ`); or a GEMINATE ɹ (`acrasial əkɹɹeɪzɪəl`). The vowel class also carries `ᵻ` (this repo's weak vowel, `prevenient pɹᵻviːniənt`) and the five PRECOMPOSED vowels the corpus uses — it is NOT NFD, and the exclusion runs on the raw string while the scorer normalises (`petitgrain pətiɡɹã`). ⚠ THE FIRST FOUR DRAFTS OF THIS RULE EACH DROPPED ONSETS, so the fixtures are pinned in test/referee-exclude-rows.test.ts — in BOTH directions, because a detector verified only on positives takes onsets with it." }
            ]
        }
    ],
    // ⚠ BEFORE THE BACKBONE, which strips combining marks — the syllabic one has to become a vowel first,
    // not be deleted. Same rule and same reason as en.jsonc; this engine is the same engine. It is
    // BIDIRECTIONAL (this referee writes the mark in 1,196 of its 76,284 rows) and it is NOT fleet-wide —
    // the same fold measured WORSE on sr, cs, mk and de, where both sides already write the mark. See
    // en.jsonc for the numbers.
    "preFolds": [
        { "pattern": "(\\S)\u0329", "replace": "ə$1", "note": "our syllabic sonorant n̩/l̩/m̩ vs the referee's ən/əl/əm. The referee inventory has no syllabicity mark, so unfolded it is always-wrong — the #1282 principle. Worth +1.7pp here against +7.5% of disagreements on en, the difference being that en-GB is scored on the rules-only path, which reaches fewer syllabic slots." }
    ],
    "folds": [
        {
            "pattern": "ʌ",
            "replace": "ə",
            "note": "STRUT and schwa are one phoneme in complementary distribution by stress, and this engine derives them that way (english.jsonc maps AH to ʌ stressed, ə not). The backbone already strips stress, so leaving them unfolded smuggles a stress claim into a segmental comparison. Same reasoning as the ɐ→ə and ɜ→ə folds beside it; see en.jsonc for the measurement."
        },
        {
            "pattern": "ʲ",
            "replace": "",
            "note": "our palatal on-glide before a front vowel — narrow allophonic detail with no counterpart in the referee's broad inventory, exactly like the ʰ and ɫ folds beside it."
        },
        {
            "pattern": "ᵻ",
            "replace": "ɪ",
            "note": "the weak vowel ᵻ is effectively absent from this referee — 13 rows of 76,284 carry it, so unfolded it maps to ALWAYS-WRONG across 5,580 lexicon rows. Measured per slot against THIS referee (not the US one): our ᵻ draws ɪ 84.2% / ə 11.7%, our full ɪ draws ɪ 94.8% / ə 2.2%, our ə draws ɪ 11.2% / ə 79.2% — on 2,019 ᵻ slots across 31,120 aligned words, which is 16x the US referee's sample and is why this variety carries the evidence. ⚠ IT IS NOT FREE: the referee PARTIALLY resolves ᵻ (our ᵻ and our full ɪ draw different ɪ-rates, 84% vs 95%), so this fold gives up catching an ᵻ written where a full ɪ belongs. Audit that with tools/english/en_weak_vowel_survey.mts --gb — see #1282."
        },
        { "pattern": "ʰ", "replace": "", "note": "aspiration on p/t/k — our GenAm engine marks it, the referee doesn't" },
        { "pattern": "ɫ", "replace": "l", "note": "DARK/velarised coda ⟨l⟩ [ɫ] — our engine marks the velarisation, the broad referee writes plain [l]; one phoneme" },
        { "pattern": "ɐ", "replace": "ə", "note": "the near-open central [ɐ] the narrow referee uses for NURSE/STRUT/commA ~ our [ə]/[ɜ]" },
        { "pattern": "ɜ", "replace": "ə", "note": "NURSE [ɜː] ~ [ə] after the backbone strips length — unify with the referee's [ə]/[ɐ]" },
        // The five CLOSING DIPHTHONGS, which en-GB writes with the parent's superscript offglide since #1252
        // — one unit rather than two full vowels that collide with every other language's ə/ɪ/ʊ in a shared
        // IPA corpus. The referee writes them the standard way, so these fold the notation and nothing else.
        // ⚠ EXACTLY THE FIVE `en.jsonc` ALREADY CARRIES, for exactly the same reason; only the GOAT ONSET
        // differs between the two (RP's central [ə] against GenAm's [o]), which is a real phone contrast and
        // is NOT folded here.
        { "pattern": "əᶷ", "replace": "əʊ", "note": "our GOAT offglide əᶷ vs referee əʊ" },
        { "pattern": "eᶦ", "replace": "eɪ", "note": "our FACE offglide eᶦ vs referee eɪ" },
        { "pattern": "aᶦ", "replace": "aɪ", "note": "our PRICE offglide aᶦ vs referee aɪ" },
        { "pattern": "aᶷ", "replace": "aʊ", "note": "our MOUTH offglide aᶷ vs referee aʊ" },
        { "pattern": "ɔᶦ", "replace": "ɔɪ", "note": "our CHOICE offglide ɔᶦ vs referee ɔɪ" }
    ]
}
