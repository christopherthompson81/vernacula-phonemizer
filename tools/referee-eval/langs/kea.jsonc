// Kabuverdianu (kea) — Portuguese-lexified creole, Cape Verde, Latin (ALUPEC). NO machine referee exists (wikipron
// has no kea); the ONLY pronunciations are the 7 IPA-carrying words in the kaikki.org dump. This tiny referee is a
// LOOSE regression TRIPWIRE (the Luo model), NOT a quality score — the real anchor is the exact-match gold in
// test/kabuverdianu.test.ts. `segmentJoin` strips the per-phone spaces. The folds reconcile the two notation
// conventions between our output and the kaikki: the kaikki puts ˈ at the syllable ONSET (with syllable dots) while
// we put it at the NUCLEUS (fleet convention) → strip ˈ and the dots and compare the SEGMENTS; and the kaikki writes
// single ⟨r⟩ loosely as [r] where it is phonemically the tap [ɾ] → fold r→ɾ. See docs/investigations/kea_native_bringup_investigation.md.
{
    "language": "kea", "name": "Kabuverdianu (kriolu)", "script": "Latin",
    "provenance": "Authored ALUPEC phonemic g2p (digraphs + Portuguese-creole nasalization + accent/penult stress) from the ALUPEC orthography + Santiago phonology; anchored on the 7 kaikki IPA words (the only machine pronunciations that exist).",
    "segmentJoin": true,
    "referees": [
        { "file": "kea.kaikki-anchors.tsv", "source": "kaikki.org Kabuverdianu (Wiktionary-derived, human) — the 7 IPA-carrying words (the ONLY machine pronunciations for kea)", "role": "primary" }
    ],
    "secondaryGap": "NO independent referee beyond these 7 kaikki words — wikipron has no Kabuverdianu, and the kaikki dump (1,062 words) carries IPA on only 7. The g2p is AUTHORED from the standardized ALUPEC phonemic orthography + standard Cape Verdean phonology (Lang 2002 / Quint 2000 / Wikipedia); this 7-word set is a LOOSE tripwire, and the exact-match gold in test/kabuverdianu.test.ts is the falsifiable anchor. 🔷 thin single-source (the fleet's thinnest, 7 words vs Luo 17 / Madurese 35).",
    "folds": [
        { "pattern": "ˈ", "replace": "", "note": "STRESS position: the kaikki puts ˈ at the syllable ONSET (ˈko.brɐ), we put it at the NUCLEUS (kˈobɾɐ, fleet convention) — strip it and compare segments (the stressed SYLLABLE matches on all 7)" },
        { "pattern": "\\.", "replace": "", "note": "the kaikki's syllable-boundary dots (ˈko.brɐ)" },
        { "pattern": "r", "replace": "ɾ", "note": "single ⟨r⟩: the kaikki writes it loosely as [r] (kobra→ˈko.brɐ) where it is phonemically the tap [ɾ] (diskabresta→…bɾ…); standard Kabuverdianu single ⟨r⟩=[ɾ] (⟨rr⟩=trill) → fold" }
    ]
