// Central Kurdish / Sorani (ckb) — Iranian (NW), the Sorani Perso-Arabic alphabet. Read by a native greedy scan.
// TWO independent HUMAN referees: wikipron ckb_arab_broad (PRIMARY) + kaikki ckb (SECONDARY). (epitran ckb-Arab
// exists but its Sorani transcription diverges far too heavily — ~25% — to be a usable corroborator, so it is not
// used.) The ONE systematic fold = the UNWRITTEN short /ɪ/ (the "bizroke"): Sorani writes all the long vowels + the
// short /a/ (ە) but NOT the short /ɪ/, which is epenthetic in clusters and not positionally predictable → strip ə/ɪ
// on both sides (the abjad short-vowel wall, but MUCH smaller — only one vowel). Also folds: the inconsistent
// glottal onset ʔ, the tap~trill r~ɾ (the referee mixes them for ⟨ر⟩), the long-vowel narrow lowerings (e̞ː~eː,
// o̞ː~oː, ɑː~aː, ɔː~oː), æ~a, ʊ~u, the u̯/i̯ offglides, and the rare palatal allophones c/ɟ~k/ɡ.
{
    "referees": [
        { "file": "ckb.wikipron-ckb-arab.tsv", "source": "wikipron ckb_arab_broad (human)", "role": "primary" },
        { "file": "ckb.kaikki-ckb.tsv", "source": "kaikki ckb (Wiktionary, human)", "role": "secondary" }
    ],
    "segmentJoin": true,
    "folds": [
        { "pattern": "[ˈˌ]", "replace": "", "note": "stress marks — not emitted (Sorani stress is largely final/unwritten)" },
        { "pattern": "͡", "replace": "", "note": "affricate tie-bar — normalise t͡ʃ~tʃ, d͡ʒ~dʒ" },
        { "pattern": "[ɑɐ]", "replace": "a", "note": "the ⟨ا⟩ back long-a [ɑ] + narrow [ɐ] ~ /a/ (length already stripped by the shared backbone)" },
        { "pattern": "ɔ", "replace": "o", "note": "the ⟨ۆ⟩ open-o variant [ɔ] ~ /o/" },
        { "pattern": "æ", "replace": "a", "note": "the ⟨ە⟩ short front open [æ] ~ /a/" },
        { "pattern": "ʊ", "replace": "u", "note": "short-u lax [ʊ] ~ /u/" },
        { "pattern": "[cɟ]", "replace": "k", "note": "rare palatal allophones [c]/[ɟ] of /k/,/ɡ/ before front vowels (the k~ɡ voicing residual is negligible)" },
        { "pattern": "ʔ", "replace": "", "note": "the word-initial glottal onset ⟨ئ⟩ — the referee marks it INCONSISTENTLY (ئارد→ʔaːɾd yet ئاواز→ɑːwɑːz); drop on both sides" },
        { "pattern": "r", "replace": "ɾ", "note": "the referee mixes the trill [r] (⟨ڕ⟩) and tap [ɾ] (⟨ر⟩) freely — unify to ɾ" },
        { "pattern": "j", "replace": "i", "note": "the ⟨ی⟩ matres lectionis: glide [j] ~ high vowel [i] — the referee (and offglide [i̯], its diacritic already stripped) does not distinguish them reliably" },
        { "pattern": "w", "replace": "u", "note": "the ⟨و⟩ matres lectionis: glide [w] ~ high vowel [u] — likewise not reliably distinguished (offglide [u̯] diacritic already stripped)" },
        { "pattern": "[əɪ]", "replace": "", "note": "the UNWRITTEN short /ɪ/ (bizroke): Sorani does not write it, it is epenthetic in clusters and not positionally predictable → fold on both sides (the abjad short-vowel wall, but only ONE vowel)" }
    ]
}
