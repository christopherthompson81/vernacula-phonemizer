// Tagalog / Filipino — shallow Latin orthography, rule-based g2p. PRIMARY = wikipron tgl_latn broad (HUMAN, 25k),
// which CORRECTLY marks the glottal stops (intervocalic + word-final) the crude epitran omits. The eval uses
// phonemizeWordRules (rule-only, non-circular — the shipped path appends a wikipron-sourced word-final-ʔ set). The
// set is proper-noun/Spanish-loanword heavy, so the folded % is deflated by (a) the genuinely-LEXICAL word-final ʔ
// (closed on the shipped path), (b) ambiguous loanword VV (glide/plain/hiatus — Spanish -ia/-ua), (c) proper-noun
// idiosyncrasy — the common-word gold is 100%. epitran kept as a secondary (crude, wrong on ʔ).
{
    "referees": [
        { "file": "tl.wikipron-tgl-broad.tsv", "source": "wikipron tgl_latn broad (human)", "role": "primary" },
        { "file": "tl.gold-adjudicated.tsv", "source": "adjudicated common-word gold (our convention)", "role": "secondary" },
        { "file": "tl.epitran.tsv", "source": "epitran tgl-Latn (programmatic, crude — omits ʔ)", "role": "secondary" }
    ],
    "segmentJoin": true,
    "folds": [
        { "pattern": "-", "replace": "ʔ", "note": "hyphen = glottal stop [ʔ] (ours) vs literal hyphen (epitran) — pag-asa" },
        { "pattern": "sj", "replace": "ʃ", "note": "⟨sy⟩ palatal: our fused [ʃ] (naʃon) ~ referee decomposed [sj] (nasjon) — same phoneme sequence, same syllable count (notation)" },
        { "pattern": "nj", "replace": "ɲ", "note": "⟨ny⟩ palatal: our fused [ɲ] (abisiɲa) ~ referee decomposed [nj] (abisinja) — notation, not an error" },
        { "pattern": "ij(?=[aeiou])", "replace": "i", "note": "⟨iy⟩ offglide before a vowel: our EXPLICIT [ij] (siya→sija, diyos→dijos) ~ referee's under-specified [i] (sia) — non-contrastive palatal offglide (the referee itself uses both for native words: siya→[sia] vs hiyip→[hijip]). We keep the explicit glide in output per the OmniVoice explicitness principle; fold for the comparison" },
        { "pattern": "uw(?=[aeiou])", "replace": "u", "note": "⟨uw⟩ offglide before a vowel: our EXPLICIT [uw] ~ referee's [u] — the labial counterpart of the ij~i offglide fold" }
    ]
}
