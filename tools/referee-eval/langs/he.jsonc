        { "pattern": "\\.", "replace": "", "note": "the referee marks syllable boundaries with a dot" },
        { "pattern": "[rʀ]", "replace": "ʁ", "note": "RESH: Modern Hebrew ⟨ר⟩ is a uvular [ʁ] (which we emit); the referee writes it [r]~[ʀ] inconsistently — non-contrastive, fold to ʁ" },
        { "pattern": "ŋ", "replace": "n", "note": "VELAR NASAL: ⟨נ⟩ before a velar ɡ/k is [ŋ] allophonically (aŋɡli); the orthography writes plain ⟨נ⟩ and we emit [n] → fold the referee's [ŋ] to n" },
        { "pattern": "ʕ", "replace": "ʔ", "note": "⟨ע⟩: a few referee entries give the pharyngeal [ʕ] (older/careful) vs our glottal [ʔ] — normalise, then the glottal fold strips both" },
        { "pattern": "ʔ", "replace": "", "note": "GLOTTAL: ⟨א⟩/⟨ע⟩ = ʔ is variably realised in Modern Hebrew (the referee marks it (ʔ) or omits it) → fold out (we emit it per the explicitness principle)" }
    ]
