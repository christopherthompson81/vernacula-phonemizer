// Punjabi (Gurmukhi) — Brahmic abugida + TONOGENESIS. The BACKBONE already strips Chao tone letters, so
// the eval measures the SEGMENTAL output: the key is the de-aspiration of the voiced-aspirate letters
// (ਘਝਢਧਭ → k/ɡ t͡ʃ/d͡ʒ … not the breathy series). wikipron pan is a broad HUMAN referee.
{
    "referees": [
        {
            "file": "pa.wikipron-pan-broad.tsv",
            "source": "wikipron pan_guru broad (human)",
            "role": "primary"
        },
        {
            "file": "pa.gold-adjudicated.tsv",
            "source": "adjudicated common-word gold (our convention)",
            "role": "secondary"
        },
        {
            "file": "pa.wikipron-pan-arab-broad.tsv",
            "source": "wikipron pan_arab broad (human) — SHAHMUKHI script",
            "role": "secondary",
            "folds": [
                { "pattern": "[eɛ]", "replace": "i", "note": "MAJHŪL ی: [iː]~[eː]~[ɛ] are ALL written with the single letter ی/ے in the Shahmukhi ABJAD → the quality is unrecoverable from the skeleton (as for sd/ur). Per-referee: Gurmukhi writes ਈ/ਏ/ਐ distinctly, so this fold is NOT applied to the pan_guru referee." },
                { "pattern": "[oɔ]", "replace": "u", "note": "MAJHŪL و: [uː]~[oː]~[ɔ] all written و in the abjad — unrecoverable, Shahmukhi-only (Gurmukhi writes ਊ/ਓ/ਔ)." }
            ]
        },
        {
            "file": "pa.epitran-pan-guru.tsv",
            "source": "epitran pan-Guru (INDEPENDENT rule-based, non-Wiktionary)",
            "role": "secondary",
            "folds": [
                { "pattern": "ɑ", "replace": "a", "note": "epitran writes the long low vowel ɑ where the primary writes aː/ä — notation (the backbone strips length)" },
                { "pattern": "[ŋɳɲ](?=.)", "replace": "", "note": "epitran does NOT restore the homorganic nasal a nasal sign carries before a stop (ਆਂਡਾ ɑ̃ɖɑ against the engine/primary ãɳɖa, referee-derived 26:5) — its known model gap, folded THIS referee only so the engine is not scored down for being right. Anchored on ŋ/ɳ/ɲ (which Gurmukhi virtually never letter-spells, so a real written nasal is untouched); the backbone strips the ̃ that would otherwise anchor the class. Dental/labial (n/m) sign-nasals stay unfolded to protect letter-spelled ਨ/ਮ." }
            ]
        }
    ],
    "segmentJoin": true,
    "folds": [
        {
            "pattern": "ɾ",
            "replace": "r",
            "note": "tap ɾ vs referee r — notation"
        },
        {
            "pattern": "ʋ",
            "replace": "w",
            "note": "ਵ ʋ~w — referee-split notation"
        },
        {
            "pattern": "ᵊ",
            "replace": "",
            "note": "the referee inserts an ULTRASHORT epenthetic schwa (ᵊ, U+1D4A) inside clusters and after aspirates/finals (ʈʰᵊt̪, sᵊ, bᵊ) — a narrow-phonetic detail we don't emit; strip it (not stripped by BACKBONE as it's a modifier letter, not combining)."
        },
        {
            "pattern": "[ɑäɑ̈ɐ]",
            "replace": "a",
            "note": "the ⟨ਾ/ਅ⟩ vowel: the referee writes it back/centralised [ɑ]~[ä]~[ɑ̈]; ours is [a] — notation."
        },
        {
            "pattern": "(.)\\1",
            "replace": "$1",
            "note": "geminate as length ː (ours) vs doubled symbol (referee) — notation"
        },
        {
            "pattern": "ə$",
            "replace": "",
            "note": "word-final inherent schwa: we DELETE it (Punjabi speech); the referee keeps an ultrashort ə̆ — convention"
        },
        {
            "pattern": "ɦ",
            "replace": "",
            "note": "the ਹ /ɦ/ tone-source: Punjabi is TONAL and ਹ is variably lost to tone. The referee is INCONSISTENT — word-initial ɦ kept 62/dropped 8, post-vocalic kept 29/dropped 42 (a register split: formal keeps [ɦ], casual → tone). We keep [ɦ] consistently (a valid formal-register canonical choice; the tone the referee marks is already BACKBONE-stripped). Fold ɦ on BOTH sides to neutralise the referee's ɦ~tone inconsistency, exactly as the Chao letters are stripped. NOT a segmental defect: ɦ never comes from a de-aspiration source (aspiration surfaces as ʰ/ʱ, resolved before any plain-ɦ fallback), so folding it cannot hide a wrong or de-aspirated consonant."
        }
    ]
}
