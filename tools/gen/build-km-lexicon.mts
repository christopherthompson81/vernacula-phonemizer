/**
 * Build the Khmer exceptions lexicon — data/languages/khmer/km-lexicon.tsv.
 *
 * Khmer inherent-vowel LENGTH, internal-doubling minor-syllable vs coda, and the Pali/Sanskrit loanword vowels
 * are LEXICAL — not derivable from the spelling (Huffman 1970). The Romanian-stress / akan-tone pattern applies:
 * the rule engine (phonemizeWordRules) handles the productive majority, and a mined lexicon carries the
 * rule-unpredictable residual, consumed dict-first by the shipped phonemizeWord. phonemizeWordRules stays the
 * non-circular referee-eval signal (this lexicon is derived FROM the wikipron referee, so scoring the shipped
 * dict-first path against wikipron would be circular — mirrors the en-GB lexical-set word lists).
 *
 * Source: wikipron khm_khmr broad (human, from Wiktionary — CC-BY-SA 3.0). Per word we take the MODAL
 * transcription, canonicalise it to our convention (strip the transcriber's breve short-vowel marks, short-low
 * a→ɑ, drop the optional medial /ʔ/), and KEEP the entry only when it genuinely diverges from the rule output
 * under the scoring folds — i.e. only the words the rules cannot predict.
 *
 * Run: npx tsx tools/gen/build-km-lexicon.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { phonemizeWordRules } from "../../src/languages/khmer/khmer.ts";

const HERE = dirname(fileURLToPath(import.meta.url));
const REF = join(HERE, "../referee-eval/referees/km.wikipron-khm-broad.tsv");
const OUT = join(HERE, "../../data/languages/khmer/km-lexicon.tsv");

/** wikipron transcription (space-separated) → our canonical convention. */
function canon(ipa: string): string {
    return ipa
        .replace(/ /g, "")
        .replace(/ŭ/g, "u").replace(/ŏ/g, "o").replace(/ĕ/g, "e") // breve short-vowel notation → plain
        .replace(/a(?![ːejow])/g, "ɑ") // short low vowel a→ɑ (keep the ae/aj/ao/aw diphthongs and long aː)
        .replace(/ʔ(?=[pbtdckɡszhfmnɲŋrljwʋɓɗ])/g, ""); // drop the optional minor-syllable medial /ʔ/
}

/** The referee-eval scoring folds — used ONLY to decide whether a word genuinely diverges (vs pure notation). */
function fold(s: string): string {
    return s
        .replace(/[ptkc]$/g, "ʔ")
        .replace(/ɑ(?!ː)/g, "a")
        .replace(/ʔ(?=[pbtdckɡʔszhfmnɲŋrljwʋɓɗ])/g, "")
        .replace(/[ŭ]/g, "u").replace(/ŏ/g, "o").replace(/ĕ/g, "e")
        .replace(/ʰ/g, "");
}

const lines = readFileSync(REF, "utf8").split("\n").filter((l) => l && !l.startsWith("#"));

// group canonicalised transcriptions per word, keep counts (for the modal pick)
const byWord = new Map<string, Map<string, number>>();
for (const line of lines) {
    const [w, ipa] = line.split("\t");
    if (!w || !ipa) continue;
    const c = canon(ipa);
    const m = byWord.get(w) ?? byWord.set(w, new Map()).get(w)!;
    m.set(c, (m.get(c) ?? 0) + 1);
}

const rows: string[] = [];
let total = 0, kept = 0;
for (const [w, variants] of byWord) {
    total++;
    // modal transcription: most frequent, ties → first seen
    const modal = [...variants].sort((a, b) => b[1] - a[1])[0]![0];
    const rule = phonemizeWordRules(w);
    if (fold(rule) === fold(modal)) continue; // rules already predict it (modulo notation) — no lexicon entry
    rows.push(`${w}\t${modal}`);
    kept++;
}

rows.sort();
const header = [
    "# Khmer exceptions lexicon — word → canonical IPA for the RULE-UNPREDICTABLE residual (inherent-vowel length,",
    "# internal-doubling, Pali/Sanskrit loanword vowels). Consumed dict-first by the shipped phonemizeWord ONLY;",
    "# phonemizeWordRules (the referee-eval signal) never reads it, so the eval stays non-circular.",
    "# Source: wikipron khm_khmr broad (human, from Wiktionary — CC-BY-SA 3.0), modal transcription per word,",
    "# canonicalised (breve→plain, short-low a→ɑ, optional medial ʔ dropped). Generated by tools/gen/build-km-lexicon.mts.",
].join("\n");
writeFileSync(OUT, header + "\n" + rows.join("\n") + "\n");
console.log(`words=${total}  exceptions kept=${kept} (${(100 * kept / total).toFixed(1)}%)  → ${OUT}`);
