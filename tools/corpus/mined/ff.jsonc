    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Montevideo don der subtropics; har der lebbiji je wakkati guldum, nyadugo nange do digiri 30°C doo do duudi." },
        { "cell": "digit-run", "text": "ɓeddari kuje hosugo himɓe guda 300 waɗan ɗum yotta adadu 1300 to a limi be luttuɗum man heɓa usta hebbungo himɓe ha pellel gotel." },
        { "cell": "digit-run", "text": "Zamanu 1960 yakke Algeria heɓɓi enci hoore mako keesum o hooti heɓɓba o jaangina hawtugo filmji." },
        { "cell": "digit-run", "text": "Fuɗɗorde Taiwan fe’i tun yake duuɓi 1500, de himɓe Urop tokkata heri ndiyam ɓe yadu yecci dow inde danneere man Ilha Fomosa ko danneere boɗɗum." },
        { "cell": "digit-run", "text": "Yake zamanu nane tokki ɓawo zamanu duuɓi 1500." },
        { "cell": "fractions", "text": "Nyenya man lugga masin, 5mm(1/5 inch) ko ɓura, bo kareman digga boɗɗum nder yanayi pewɗum." },
        { "cell": "clock", "text": "Maadi juɗɗum ɗiɗi man yotti meetaji 83, jutugo man yotti meetaji 378 bo labbi ɗiɗi mari yajugo meetaji 3.50." },
        { "cell": "clock", "text": "Wakkati 1:15 a.m. yende asawe, no seeda'en yecci, mota manga majum do lanya bawo dum lari yite korino je dillugo amma sai mota mai wari wailiti ha yeso majum." },
        { "cell": "clock", "text": "Bana jamdi 11:29, holo man yotti Whitehall, sali babal Trafalgar, hedi Strand, do sala hedi Aldwych be Kingsway do yaha Holborn ha moftorde Conservative wadata fottorde mabbe je wakkati guldum ha babal walugo je Grand Connaught." },
        { "cell": "clock", "text": "Himɓe wurti yasi ɓe wolwa hala ko woni mbernde maɓɓe fuɗɗi wolugo njamdi 11:00nje wuro man (UTC +1) ha pellel kawrital danejum je woni gefe pellel kugal arɗo wuro man je poliici en hakkilitta dammugal nastugo man ha fattude Dawnin." },
        { "cell": "signs", "text": "Kaeji fere, jeko dudai ha duniya,bedo sorra daga US$11,000 warugo $22,500 ha pat ounce gotel, bo yotti bana de sappo buri chede gold." },
        { "cell": "signs", "text": "Bggol hite je wani der dyam kam jun on hauti lesde Europe be satellite manga mai. Greenland o hauti be bobbdum yari 93% je dudugo himbe mari haje internet" },
        { "cell": "signs", "text": "Amma arɗo man Jon Hawod wi ɓe waɗi ɗum on gam ɓe hakkila be pellel asibiti man heɓa ta gomnati Tasmeniya man usta sembe man, to ɓe hokkan ɓeddari miliyon AUD$45." },
        { "cell": "signs", "text": "European Turkey (eastern Thrace or Rumelia in the Balkan peninsula) wodi kusan 3% je nder laddi mai." },
        { "cell": "dotted", "text": "U.S. vi heɓi andal daga mo ɓe yeccai ko daga toi wari je yecci no suicide bombers naftirta ɓe ummina “pellelji mari ma’ana ” ha Ethiopia be Kenya." },
        { "cell": "dotted", "text": "Fijirdeji perpeton be armor je rival soja en. Kusan 1000B.C., je Assyrians waddi je Ummatore fudarde ." },
        { "cell": "dotted", "text": "Be hokki U.S. Navy`s Seventh Fleet be do Seabo, Nagasaki ha Japan." },
        { "cell": "dotted", "text": "Mo nane U.S. moh volwata hado sare Newt Gingrich wari ha did be 32 ha dar 100." },
        { "cell": "era-marker", "text": "Dimbugo leddi fi Mariana jamdi 07:19 a. m. wakkati lesdinkeejum (09:19p.m. GMT Jumbare)." },
        { "cell": "era-marker", "text": "Porgaram mai fuɗɗi jamdi 8:30 p.m. ha wakkati sare (15.00 UTC)." },
        { "cell": "year", "text": "Bedo tuma Be tabbitinta jo’ende jam ha UN be rabugo nyawu je fuddi ha kombi bawo dimmbande lesdi 2010,ha Haiti." },
        { "cell": "year", "text": "Mo hakkilinta be kwarwal minister Julia Gillardvi wakati campaign je zabe federal 2010 do o yardi Australia warta republic ha karshe lamu queen Elizabeth II." },
        { "cell": "year", "text": "Ko gam ma modibbe fere vi tun wakkati be hebi kwutal hore ha babal mayo(Saravati), bana ha der hakkilo hani be dona (Indus-Saravati Civilization) wobbe fere bo do dona majun (Harappan Civilization) ha babal (Harappa) je fudder de ha babal mai tun jamanu 1920`s." },
        { "cell": "year", "text": "Wakkati 1980 en o huwi do fijirde bana taxi, cheers, be fijirde tracy ullman." },
        { "cell": "decimals", "text": "Be saali mo be je-didi, Johnson do tokka mo be 2,243." },
        { "cell": "decimals", "text": "Kowani dubi ha bana October kusan 1.5 million dabbaji nyamata gene yadu yahugo hirnange babal, tsallika je mara kumbawal, daga hirnange tondire je yende." },
        { "cell": "decimals", "text": "Himbe watta zangazanga ban yidi himbe miliyon 1.2 wata jungo ha derewol be yarinta himbe je darinta be ha gwamnati ha nuwanba." },
        { "cell": "decimals", "text": "Hautobe zanga-zanga vi bana himbe 100,000 vurti ha birniwol Jamus bana Berlin, Cologne, Hamburg, be Hannover." },
        { "cell": "ordinal-latin", "text": "Hala man fuddi 1st je janeru on wakkati himbe jodata totton duddum fuddi holugo ha babal kugal lene Obanazawa do be hebai carti duubi kesum je be vowi hebugo." },
        { "cell": "ordinal-latin", "text": "Bako himbe Spain yotti ha duubi temere je 16th, woyla Chile do les lamu Inca bo himbe Araucan (Mapuche) jodi ha chaka be fombina Chile." },
        { "cell": "ordinal-latin", "text": "Be lendini George Washington gotel yende july 6, mo jangini soja en mako dum ha New York yende july 9. London hebi iri mai ha august 10." },
        { "cell": "ordinal-latin", "text": "Mo ersisini dina majum ha kornuwol 15th kanko on Guru Nanak(1469-1539). Wodi guruji je'nai be jabi bawo mako." },
        { "cell": "units", "text": "Hoseji huro woni chaka diyam hauti ha der cabbal, sai lorti vorti 360km hauti tari hosere Ellsworth, dum hosere booju Minnesota sendi di'di." },
        { "cell": "units", "text": "Tsari man je 35mm ɗo sakla himɓe sai nanda ba je tsari 36mm be yajugo 24mm to ɗo dari." },
        { "cell": "units", "text": "Capsule man tokkai dillugo ha 12.8km kobo 8 miles ha hour, daga san francisco yahugo los angelos hosai minti gootel." },
        { "cell": "units", "text": "Dimborde leddi man do hedi 20 km (15 mileji) woyla- fuuna woyla je dilllon bo 65 km (40 mile ji) fombina Butte." },
        { "cell": "ranges", "text": "Fijerde Nadal nyami 7-2 be himɓe kanada o wowi fijugo." },
        { "cell": "ranges", "text": "O yari 2 bo o valli ha yarugo 2 ha nasara Washington’s 5-3 be Atlanta Thrashers." },
        { "cell": "ranges", "text": "nyamande didabre dum o nyami je jemma kanjum on je nde 60 ha fasluwol ɗo, ɗum waɗi mo aranol fijowo je mari nyamugo 60 be nyamande ko wawata ɓurugo non on ha fasluwol jonta tun 1995-96, sa'e Jaromir Jagr be Mario Lemieux ko moy yotti masayi majum." },
        { "cell": "ranges", "text": "Yake 1683,Qing dynasty (1644-1912) hukuma jafti control je Hirna Taiwan be Wayla coastal bo ɓe hokki doka cewa warti je Qing Empire ha 1885." },
        { "cell": "currency", "text": "Bawo duubi 250, Guinness mauni warti ko waddata choggu je buri euros biliyon 10 (uS$14.7 biliyon) duubi fu." },
        { "cell": "currency", "text": "Batten be wati mo ha 190th ha 2008 400 marbe chede himbe americans be wani dar be tammi bedo mari dukiya yari $2.3 billiom." },
        { "cell": "currency", "text": "Doka ɓe waɗi kesum holli dow kujeji fijerde ha tv ɓikkoi sje ɓe sorata ha wuro Kalifoniya mara windi holla sai toɓe yotti duuɓi 18 bo ɓe windi pat mo sorrini mo duuɓi mako yottai ɓe jaɓan $1000 diga mako." },
        { "cell": "currency", "text": "Jesus mo mari duubi 21 nasti Manchester City duubi sali ha janeru 2017 daga babal fijirde Brazil Palmeiras gam chede miliyon £27." },
        { "cell": "abbrev", "text": "Ha wakkati gulɗum, a lara cufi je wancata fu. Amma ma wala hokka goɗɗo nyawu feere, bedo monna goɗɗo." },
        { "cell": "abbrev", "text": "Be’i sare ɓurna ɓe ɗo resi der garke ɗo wancha do hoseji be pellel nyalde, be mo hakkilinta ɓe ɗo ɓadi bo ɓurna ɓukkoi on ko sukaje en, banni bo mo hakkilinta bali fu. Tsari be mai ɓe naftirta har hande." },
        { "cell": "abbrev", "text": "Nastungo hore ma do der ko be mari haje to ado tefa visa. ha lesde fere, se to a nastini horema be babal a jodata ha baabal hukuma babal man." },
        { "cell": "abbrev", "text": "Kuje ɗo wallan a heɓa laana manga je fottata be kujeji a yiɗi ko kujeji saɗini ma. Heɓa wanna ma no a yiɗi." },
        { "cell": "latin-in-native", "text": "Maube wuro Amsterdam be museum Anne Frank vi do leggal man do mari fungus bo wawai nangugo be nyawu to wadai kodume hado man." },
        { "cell": "latin-in-native", "text": "Haandi a nuuma maarugo gite, ha sare mussamam ma ta wodi insurance hado mai, bo waddugo mai be no be naftirta ha pellel fere." },
        { "cell": "latin-in-native", "text": "Hakke ɗuuɗugo wuro taringa be ndiyam je japan mari, beɗo ‘yona japan “akipelago”" },
        { "cell": "latin-in-native", "text": "Sende hebugo hala didabre man, je yidi be hada gorko be gorko banga, wawan mabbita dammugal ni gorko be gorko banga ha yeso." },
        { "cell": "percent", "text": "Nadal nastini kwalloji 88% ha nder ragaraga pointiji nyamugo fijirde mai 76 pointiji ha wakkati be fuddi" },
        { "cell": "percent", "text": "Ɓe hawti be takunkumi ceede bo be harmingo je kungiya moftorde Turai waɗi dow wurtingobba neebbam keccum, je daga totton tattali risku Iran heɓɓata 80% ceede nastata daga lesɗe yaasi." },
        { "cell": "rate", "text": "Mr Reid habdi laanyi moota New Zealand’s A1GP , balajum boddum haa doggugo ko buurii 160km/h de jediidi ha dow katarko." },
        { "cell": "rate", "text": "En sanda New Zealand du mari damuwa dou dodgodu be bindigaru amma bo Mr Reid do dilla be jawaul, wakkati be hebi be jotgiti mako sai dah o bussti doddgodu 16okm/h." },
        { "cell": "rate", "text": "Fred do dilla ha dou hendu har doggugo 105 miles per hour bo be (165 km/h) bo do dilla her funa on." },
        { "cell": "rate", "text": "Himɓe hakkilitta be ladde suitare man wi to himɓe daran ɓe daya yad/mita 100 ko ɓura diga gefe waandu ladde man, to ɓe daran ha luttuɗum daabba ladde en bo ɓe daaya 25 yadji/mitaji diga daaba en man." },
        { "cell": "roman", "text": "Luxembourg kodai do habda dara ha chaka amma leddi Jamus nyaami be ha habre duniya I be habre duniya II pat." },
        { "cell": "roman", "text": "Kashi 34 ha 100 je subti do numa banni, be yidi lamido elizabeth II warta debbo je laamata australia je ragare." },
        { "cell": "roman", "text": "Nyande je ɗiɗi je lewru Shawwal inji je jirgi acci huwugo sai jirgi man do’I amma wala mo nauni. Roshiya acci no nafturgo iri jirgi man II-76s ɓawo ko fe’I man." },
        { "cell": "initialism", "text": "Dubi nayi ko salali (patent) hebi,kangum on fudurde tyelade je duniyaro ha pellel MRI." },
        { "cell": "initialism", "text": "Apple CEO Steve Jobs vurtini na’ura fere do va’ugo do stage be vurtungo iPhone daga der jiiba mako." },
        { "cell": "initialism", "text": "Jodobe haya ha Lookwood Gardens do lara wodi saroji 40 ko dum buri be'be fartata, tunde be nani dan-sandaji OHA do wada bincike ci'a ji fere ha Oakland dum be tumata hader ci'a be zambi himbe." },
        { "cell": "initialism", "text": "Ko wati kuje ndu saka mako je koiɗol laɓɗum ɓeddi yajuugo darnde wakkati je cakka lesɗe REM." },
        { "cell": "grouped", "text": "ɓawo doggugo o waɗi, harjotta Keselowski on ardata be points guda 2,250." },
        { "cell": "grouped", "text": "Ma’ere be hefti do baabal kusan yari mailji 3,000 daga Miami, florida, do mari ɗuɗɗum je ɓe yardi hendu je 40 mph (64kph)." },
        { "cell": "grouped", "text": "Tun artundere, Onion warti sare jarida manga ,be do fiya jarida, be do yofa ha na'ura dum waddi hobbe 5,000,000 ha lewru October, be wawan wannugo ma talla horema, be tasha habaru dum huwata awa 24, nau'ra redio waya, be bo zane lesde duniyaji dum be waddi kesum duniya bilki en." },
        { "cell": "grouped", "text": "Je asali habre je konu ha 2,400 warbe wadan tsalika ha mayo jenai (miles) funange je trenton, bo be senditi hadar kombaji didi, gotel ha less greene be gotel ha less Sullivan, kogan bewada yedugo ha (ore-dawn) yara hari." },
        { "cell": "letter-name", "text": "Tabbas, superprofits je ɓe heɓi daga Juttunni wakkati je himɓe Filipino hautan keɓal je U,S. imperialism." },
        { "cell": "letter-name", "text": "O jaɓi “Hero of the Soviet Union”, Soviet Union’s muqami je ɓuri ko toi gam kuɗe mako." },
        { "cell": "letter-name", "text": "Hado kujeji, numtugo koh fe’I ha kujeji je sore sore yanayi be sakamako nyamugo nasaraku do valla himbe heba mabbita changi be sabon lawal je kauye julurde kirista." },
        { "cell": "letter-name", "text": "Kampani lantarki Hokuriku yecci dau wala ko fe'I diga dimbol leddi bo kuje chanjugo gotel be ɗiɗi ha babal hautugo lantarki je shika pat ɓe maɓɓi" },
        { "cell": "arithmetic", "text": "In wawan nafturungo mota daidai toh en taskini be hakkilo be dabare amma 4×4 to heban buri bo pellel ji duddum awawata salugo sai be mota mari sembe bana 4×4." },
        { "cell": "ampersand", "text": "O timmini jangirde mako ha makaranta College Of Arts &amp; Sciences je University Virginia ha dubi 1950 bo o latti mardo vallinde ha madarasa mai." },
        { "cell": "sports-time", "text": "Ha fere bo O wari je sappo ha nder roɓe nasti doggudu je furundurde, ha nder wakkati 4:42.30 o timmini, o yottai wakkati hosi Klawdiya Losek ɓii wuro Ostriya mo nyami doggudu man, mo nyami man timmini be minti 2:11.60 bo mo wari je je nai Giyongi Dani ɓii Hongare fu yottii be minti 1:09.02 bako mako." },
        { "cell": "version-dot", "text": "Doggugo 802.11n bɓuri je ɓawo maga yawugo be maksimom tiyoretikal truput 600Mbiy/s" },
        { "cell": "quote-letter", "text": "Noo duulee asama haykaliwol be no dow weendu Tonle Sap woni wadi wa’ago tillde haadii." },
        { "cell": "quote-letter", "text": "Gimee didii daga fijirde, hosugo be wonata nder (bilki’en je hoidata) be wuro je taurari, hebii subtegoo dou gimol mabbe buri saman.Studio Lionsgate jabii subego de 26 –dum burii kala studio pat." },
        { "cell": "quote-letter", "text": "Goto ha nder himɓe makaranta je naneno vi ‘o ɗonno wola iri fere bo o ɗo ekkitina himɓe no ɓe heɓata mo ɓe yiɗi bo o ɗonno bana sobajo himɓe makaranta man’." },
        { "cell": "quote-letter", "text": "See bo a hota woyla hedi hirrna, se bo fahim ebbita mayo Mara, bawo iyeende sa'e April." },
        { "cell": "scaled-currency", "text": "Cafenet el sol do hokka je atata kugal je be yobata ha US$30, koh $10 ha dar balde gotel Sali, koh hani anda ha do Corcovado shafi." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Ha wakkati gulɗum, a lara cufi je wancata fu. Amma ma wala hokka goɗɗo nyawu feere, bedo monna goɗɗo.",
        "Be saali mo be je-didi, Johnson do tokka mo be 2,243.",
        "O jaɓi “Hero of the Soviet Union”, Soviet Union’s muqami je ɓuri ko toi gam kuɗe mako.",
        "Jerusalem kanjum on laamorde bo birni buri maunugo ha Israel, amma wodi lesde fere be kungiya United Nations bé yardai hosi dum laamorde Israel.",
        "Toh jamdi wallungo kare hebaka, bo awala yida watugo safa wogginga, sai atefa a naftira keeke yorungo gasa, to wodi.",
        "Peter Lenz, bingel dubi sappoi tati je watta doggudu keke, o may bawo o do’i be mota ha lawol doggudu je ha Indonesia.",
        "Yimɓe je waɗata jaahangal ɗuɗɗum jonta ɗon hilni be sanjol duniyaru je ɗon saanja tum e law, je kala mo'inol ha nder gikku footi ɓesda laugel.",
        "Amma arɗo man Jon Hawod wi ɓe waɗi ɗum on gam ɓe hakkila be pellel asibiti man heɓa ta gomnati Tasmeniya man usta sembe man, to ɓe hokkan ɓeddari miliyon AUD$45.",
        "Himbe nangata marbe ayebe je Madhya Pradesh hefti komfuta be wujji be waya jundo.",
        "Ceede Chaina heɓata diga duniya wawan ɓura je US ha duuɓi 20 warata ɗo.",
        "duddum daga bangleji babal dua bedo hauta walima petel je babal dua wadi dubi ko gunki mabbe ko hunde fere je shafi babal man.",
        "O wadi ko buri stamp dubu ni Sweden be lesde guda nogas e je tati.",
        "Sirru nasara maɓɓe numol nish maɓɓe on, kuugol musamman on je kala faaturu fu jogi je haɗata ɗum arootirgo be woɓɓe.",
        "Jardin de la Union. be nyibi babal do ni atrium gam kuje wakkati duubi temere, bo Templo de San Diego on tan lutti ha maadi man.",
        "Himbe fere tefata kugal man ha sera do wawan waylutuggo ko be vindi ha demgal fere ha do kujeji ko alluwo ha duniyaru to be titi waya mabbe ha babal kujeji bindi man woni do mai.",
        "(surface tension) buri huwugo ha dou ndyiam gam do joga bandum am majun nabana ha hindu bah ha dau majun.",
        "No intanet huwata waddi laabi fere dau no naftirta be no ɓattata ɗum",
        "Ha klub fijerde man wala mo fiji bo yari gols ɓuri Bobek.",
        "Nder Wakkati ɗungu (Siwtoraandu yahugo Haram minyiraawo), diyam ɗan ɗudai be chippotodan ɗan harai no fotti ndaro.",
        "Gam, be acca himbe nasta bawo leddi fuddugo der may be heban dum daga yendere arande janeru.",
        "Doggudu goɗɗo wawata waɗa jotta yottai je ɓe wati no, ɓe wowi watugo doggudu mph 35 yahugo 40 (gotel be 56 yahugo 64 km kala awa) bo heɗutuggo ɗum ɓuri koɗume nafu.",
        "En sanda New Zealand du mari damuwa dou dodgodu be bindigaru amma bo Mr Reid do dilla be jawaul, wakkati be hebi be jotgiti mako sai dah o bussti doddgodu 16okm/h.",
        "De latti notugo tsari man ɗuuɗai, Jamani tammi ɗum heɓan habaru iri gotel be kujeji habre ndiyam maɓɓe.",
        "Agogo dum be taginga ha banduji ammin do wailita be hore majum bo dingiti tarugo ko wala ko memi dum.",
        "Burna birni leddi Hong Kong do hebbini masin do leddi be wadi chikito ha hedi hunduko mayo woni woyla wuro majum.",
        "Yanayi wuro chaɗɗum ɗo aata kuɗe ɓe habdata ɓe lara pellel hatsari man fe’i heɓa ɓe lara ko wodi himɓe wurti be yonki maɓɓe.",
        "To ado wada jahangal be laptop ko tablet, sigu fere ha memory majum ko disc(a naftira koh wala yanan gizo)",
        "Ministiri man noti be nyogu ɓamtol je Apple wadi kuje “wasmutuggo gonga”.",
        "Soja’en dum be yarbi matakije harbe je 1st be 3rd ha New Hampshire regiments je himbe 200, ha wakilai Colonels John Stark be James Reed (pat mabbe be warti generals daga ba’wo).",
        "Baabe je ɓuri hoosugo yimɓe kugal kaanjum on yimbe wawi iri kugal feere, ngomnati, yimɓe huɗata be ceede, cooggu, be yahdu nanugo belɗum."
    ]
}
