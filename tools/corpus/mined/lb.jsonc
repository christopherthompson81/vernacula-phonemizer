    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "De Fred ass de stäerksten tropesche Wirbelstuerm, dee jeemools zanter dem Opkomme vu Satellittebiller esou wäit südlech an ëstlech am Atlantik opgezeechent gouf, an den drëttgréissten Hurrikan ëstlech vu 35 °W." },
        { "cell": "degrees", "text": "D'Passagéier hu Waasser kritt, wärend se bei 32 °C Hëtzt gewaart hunn." },
        { "cell": "degrees", "text": "De Pompjeeskommandant Scott Kouns huet gesot: \"Et war e waarmen Dag zu Santa Clara, mat Temperaturen ëm 32 °C." },
        { "cell": "digit-run", "text": "Säin 1 000. Timber war d'prachtvoll \"Grouss Dote vun de schweedesche Kinneken\" vum David Klöcker Ehrenstrahl am Joer 2000, deen am Guinness-Buch vun de Weltrekorder opgeféiert ass." },
        { "cell": "digit-run", "text": "D'Portugisen hu se zerstéiert an ënner dem Numm Casa Branca erëm opgebaut, nëmme fir se no engem Äerdbiewen am Joer 1755 ze verloossen." },
        { "cell": "digit-run", "text": "Als NSA huet hien de Carter bei der diplomatescher Ofwécklung vu Weltugeleeënheeten ënnerstëtzt ewéi d'Camp-David-Ofkommes vun 1978; d'Normaliséierung vun de Bezéiungen tëschent den USA a China an de spéiden 1970er; d'iranesch Revolutioun, déi 1979 zu der Geiselkris vum Iran geféiert huet; an d'sowjetesch Invasioun an Afghanistan 1979." },
        { "cell": "digit-run", "text": "De verängschtegte Kinnek Louis XVI, d'Kinnigin Marie Antoinette, hir zwee jonk Kanner (déi 11 Joer al Marie Therese an de véier Joer ale Louis-Charles) an dem Kinnek seng Schwëster, d'Madame Élisabeth, goufen de 6. Oktober 1789 vun engem Mob Maartfraen vu Versailles zeréck op Paräis gezwongen." },
        { "cell": "fractions", "text": "D'Muster sollt déif genuch sinn, 5 mm (1/5 Zoll) oder méi, an d'Material bei kalen Temperature mëll genuch." },
        { "cell": "clock", "text": "D'Endresultat war eng 1-Punkt-Victoire, 21:20, an huet d'Victoiresserie vun den All Blacks iwwer 15 Spiller ënnerbrach." },
        { "cell": "clock", "text": "Tëschent 22.00 an 23.00 Auer MDT hunn d'Insassen e Feier am Haff ugefaangen." },
        { "cell": "clock", "text": "Doduerch ass se ofwäertskompabitel mat 802.11a, 802.11b an 802.11g, virausgesat, datt d'Basisstatioun iwwer zwee Funkapparater verfüügt." },
        { "cell": "clock", "text": "D'Rettungsmannschafte vun de Pompjee hunn d'Feier schlussendlech géint 23.35 Auer geläscht." },
        { "cell": "signs", "text": "Et gëtt erwaart, datt déi meescht Veranstaltungsticketen tëschent 2.500 ¥ an 130.000 ¥ kaschten, woubäi typesch Ticketen ongeféier 7.000 ¥ kaschten." },
        { "cell": "signs", "text": "Dozou gehéiere finanziell Aschränkugnen an e Verbuet vun der Europäescher Unioun fir den Export vu Réiueleg, aus deem d'iranesch Wirtschaft 80 % vun hirem Auslandsakommes kritt." },
        { "cell": "signs", "text": "D'europäesch Tierkei (Ostthrakien oder Rumelien op der Balkanhallefinsel) ëmfaasst 3 % vum Land." },
        { "cell": "signs", "text": "CafeNet El Sol bitt e Reservéierungsservice fir eng Tax vun 30 $, oder 10 $ fir Dageskaarten; Detailer fannt Dir op hirer Corcovado-Säit." },
        { "cell": "dotted", "text": "Vill gängeg Formater (z. B. APS-Formatfamill) entspriechen dësem Säiteverhältnis oder rapprochéiere sech ëm." },
        { "cell": "dotted", "text": "Den U.S. Corps of Engineers huet geschat, datt 152 mm Nidderschlag zum Brochvun de virdru beschiedegten Däicher féiere kéinten." },
        { "cell": "dotted", "text": "Dat fënnt een an Norwegen, Schweden an Neuseeland, ass awer soss zimmlech eenzegaarteg (z. B. läit d'Zuel an Holland bei eent zu véierzeg)." },
        { "cell": "dotted", "text": "Komescherweis ass den Handydéngscht hei awer vill méi staark ewéi laanscht anere Streckenabschnitter, z. B. de Pennsylvania Wilds." },
        { "cell": "era-marker", "text": "Eng Binärzuel kann nëmmen ee vun zwee Wäerter hunn, d. h. 0 oder 1, an dës Zuele ginn als Binärzifferen – oder Bitten (fir Computersprooch ze benotzen) ugesinn." },
        { "cell": "year", "text": "Vun den 1 400 Befrote virun der Bundeswal 2010, hunn déijéineg, déi géint Australien als Republik sinn, zanter 2008 ëm 8 Prozent Zouwuess kritt." },
        { "cell": "year", "text": "Esou ginn zum Beispill &apos;Léieren&apos; a &apos;Sozialiséierung&apos; als wichteg Motivatioune fir d'Internetnotzung ugesinn (James et al., 1995)." },
        { "cell": "year", "text": "Schlussendlech goufen Holzrieder duerch Eiserieder ersat. 1767 goufen déi éischt Volleiseschinnen ageféiert." },
        { "cell": "year", "text": "De Perry huet erkläert, datt hien \"an Texas zeréckkéiere géif, fir d'Resultater vun der haiteger Sëtzung ze beurteelen, ze bestëmmen, ob et fir mech selwer an dësem Rennen e Wee no vir gëtt\", awer huet spéider gesot, datt hien am Renne bleiwen an am Januar 2021 bei de Virwale vu South Carolina untriede géif." },
        { "cell": "decimals", "text": "Den Amazonas ass de breetste Floss op der Äerd, plazeweis knapp 9,7 Kilometer breet." },
        { "cell": "decimals", "text": "Obwuel kee mat Sécherheet weess, wien dat geschriwwen huet, ass bekannt, datt dat grousst Pergamentdokument (et moosst 75,57 cm x 62,23 cm) fréi a sengem Liewe fir d'Lagerung opgerullt gouf." },
        { "cell": "decimals", "text": "Et gouf keng Tsunamiwarnung ausginn a laut der Geophysikagence vun Jakarta gouf keng Tsunamiwarnung ausginn, well d'Biewen d'Ufuerderung vun der Stäerkt 6,5 net erfëllt huet." },
        { "cell": "decimals", "text": "D'Busse fueren de ganzen Dag iwwer vun der Interdistrikt-Busstatioun (op der anerer Säit vum Floss) fort, woubäi déi meescht Busser, besonnesch déi a Richtung Osten an op Jakar/Bumthang fueren, tëschent 6.30 a 7.30 Auer fortfueren." },
        { "cell": "ordinal-latin", "text": "Déi breet Boulevarden, d'Gebaier mat Glasfassaden an d'modern Akafszentre si mat traditionelle rouden Zillendiecher, dem Maart aus dem 18. Joerhonnert an ale Moscheeën a Kierchen iwwerséint, obwuel d'Stad éischter eng Atmosphär vum europäesche Mëttelmierraum ewéi der traditioneller Tierkei huet." },
        { "cell": "ordinal-latin", "text": "Hie war angeeblech a sengen 20er. An enger Erklärung huet de Bieber gesot \"[o]ch wann ech net uwiesend oder direkt un dësem trageschen Accident bedeelegt war, si meng Gedanken a Gebieder bei der Famill vum Affer.\"" },
        { "cell": "ordinal-latin", "text": "Den Zäitalter, an deem d'Ereegnesser sech ofgespillt hunn, gëtt allgemeng als Héichmëttelalter bezeechent, den Zäitalter vun der europäescher Geschicht am 11., 12. an 13. Joerhonnert (1000 – 1300 n. Chr.)." },
        { "cell": "ordinal-latin", "text": "Wärend den 1920er war d'virherrschend Haltung vun de meeschte Bierger an Natiounen, Pazifismus an Isolatioun." },
        { "cell": "units", "text": "De Park erstreckt sech iwwer 19 500 km² an ass a 14 verschidden Ekozonen ënnerdeelt, déi jeeweils ënnerschiddlech Wëlddéiere versuergen." },
        { "cell": "units", "text": "D'Sundarbans sinn de gréisste Küstemangrovestreech vun der Welt an erstrecke sech vun der Küst aus iwwer 80 km (50 Meilen) an d'bangladeschescht an indescht Hannerland." },
        { "cell": "units", "text": "Dat weltwäit am heefegste verwent Fotoformat fir Standbiller ass zum Beispill 35 mm, wat um Enn vun der analoger Filmzäit déi dominéierend Filmgréisst war." },
        { "cell": "units", "text": "Den Archipel läit 120 km nërdlech vun der Hallefinsel. Déi gréisst ass d'King-George-Insel mat der Siidlung Villa Las Estrellas." },
        { "cell": "ranges", "text": "Schlofënnerbriechung ass de Prozess vum geziilten Erwäche wärend dem normale Schlofzäitraum a kuerz dono erëm anzeschlofen (10 – 60 Minutte méi spéit)." },
        { "cell": "ranges", "text": "D'Luno hat 120 – 160 Kubikmeter Kraaftstoff u Bord, wéi se auserneegebrach ass a staarke Wand a Wellen hu se an den Hafendamm gedriwwen." },
        { "cell": "ranges", "text": "Hangeul ass dat eenzegt absichtlech entwéckelt Alphabet am populären deegleche Gebrauch. D'Alphabet gouf 1444 wärend der Herrschaft vum Kinnek Sejong (1418 – 1450) entwéckelt." },
        { "cell": "ranges", "text": "Säin zweete Gol vun der Nuecht war säi 60. vun der Saison, als éischte Spiller, deen zanter 1995 – 1996, wéi d'Spiller Jaromir Jagr an Mario Lemieux, déi jeeweils dëse Meilesteen erreecht hunn, 60 oder méi Goler an enger Saison geschoss huet." },
        { "cell": "currency", "text": "De Gesetzentworf gesäit vir, datt gewalttäteg Videospiller, déi am Bundesstaat Kalifornie verkaaft ginn, mat engem Autocollant mat der Opschrëft \"18\" gekennzeechent ginn a féiert dozou, datt de Verkaf u Mineure mat 1.000 $ jee Strofdot strofbar ass." },
        { "cell": "abbrev", "text": "Behandelt de Site wgl. mat all der Würd, Feierlechkeet an dem Respekt, deen e verdéngt. Maacht keng Witzer iwwer den Holocaust oder Nazien." },
        { "cell": "abbrev", "text": "Insekte waren déi éischt Déieren, déi d'Loft erobert hunn. Hir Fäegkeet ze fléien huet hinne gehollef, Feinde méi einfach auszewäichen an Narung a Partner méi effizient ze fannen." },
        { "cell": "abbrev", "text": "E puer Patiente kéinte sech am Spidol ugestach hunn, mengt den Dr. Moll, a mindestens zwee ware vum Spidolspersonal." },
        { "cell": "abbrev", "text": "Den Arly Velasquez aus Mexiko ass 15. beim Männer-Super-G am Sëtze ginn. Den Neuseelänner Adam Hall ass néngte beim Männer-Super-G am Stoe ginn." },
        { "cell": "latin-in-native", "text": "Berüümt Sänger am ganze Land hu Bhajanen, oder opafferend Lidder, zu de Féiss vum Shri Shyam duergebueden." },
        { "cell": "latin-in-native", "text": "Opgrond vun der grousser Distanz zum Kontinent ware Mamendéieren net an der Lag, d'Rees unzetrieden, wouduerch d'Risendeckelsmouk dat éischt Weedendéier an de Galapagos war." },
        { "cell": "latin-in-native", "text": "Frae sollten erkennen, datt kulturell Ënnerscheeder zu deem féiere kënnen, wat si als Belästegung ugesi kéinten, an et ass net ongewéinlech, verfollegt ze ginn, um Aarm gepaakt ze ginn asw." },
        { "cell": "latin-in-native", "text": "Sue kënnen nëmmen an der eenzeger Bank op den Insele gewiesselt ginn, déi zu Stanley géintiwwer dem &apos;FIC West&apos;-Geschäft läit." },
        { "cell": "percent", "text": "Den Nadal huet 88 % vun den Netzpunkten am Spill agesackt an esou 76 Punkte mam éischten Opschlag gewonnen." },
        { "cell": "rate", "text": "No fënnef Minutte kënnt Wand op, ongeféier eng Minutt méi spéit erreecht de Wand 70 km/h … da kënnt de Reen, awer esou haart an esou staark, datt en ewéi Nolen an d'Haut stécht, dono fale Knëppelsteng vum Himmel, d'Leit verfalen a Panik a jäizen a rennen duercherneen." },
        { "cell": "rate", "text": "Haut de Moie louchen d'Wandgeschwindegkeete bei 83 km/h an et gouf erwaart, datt se méi schwaach géifen." },
        { "cell": "rate", "text": "D'Geschwindegkeete vun 802.11n si mat engem theoreetesche Maximalduerchsaz vu 600 Mbit/s substanziell méi séier ewéi bei sengem Virgänger." },
        { "cell": "rate", "text": "De Fred beweegt sech den Ament mat Wandschwindegkeeten vun 165 km/h (105 Meile/h) a Richtung Nordwesten." },
        { "cell": "roman", "text": "Wärend dem vun der Mau-Beweegung organiséierten Onofhängegkeetskampf huet e friddlecht Treffen an der Stad zu der Ermordung vum ranghéchste Chef Tupua Tamasese Lealofi III geféiert." },
        { "cell": "roman", "text": "D'II-76 war zanter den 1970er en Haaptbestanddeel vum russeschen a sowjetesche Militär an hat schonn de leschte Mount e schwéieren Accident a Russland opzeweisen." },
        { "cell": "roman", "text": "De 7. Oktober ass beim Start e Motor verluer gaangen, ouni Verletzungen. Russland huet den II-76 kuerz nom Accident Startverbuet erdeelt." },
        { "cell": "roman", "text": "D'Interimspremierministesch Julia Gillard huet wärend der Campagne vun de Bundeswalen 2010 behaapt, datt si der Meenung ass, Australie sollt um Enn vun der Regierungszäit vun der Queen Elizabeth II eng Republik ginn." },
        { "cell": "initialism", "text": "D'KI-Fuerschung ëmfaasst d'Hierstellung vu Maschinnen, fir Aufgaben ze automatiséieren, déi intelligent Verhalen erfuerderen." },
        { "cell": "initialism", "text": "D'NHK huet och bericht, datt d'Atomkraaftwierk Kashiwazaki Kariwa an der Präfektur Niigata normal funktionéiert." },
        { "cell": "initialism", "text": "D'Krichsausgabe vum US-Imperialismus bei der Eroberung vun de Philippinne goufe vum philippinnesche Vollek selwer bezuelt." },
        { "cell": "initialism", "text": "Et ass dem Martelly seng fënneft CEP a véier Joer." },
        { "cell": "grouped", "text": "Am nërdlechen Deel, och Sentinel Range genannt, befanne sech déi héchst Bierger vun der Antarktis, de Vinson-Massiv, mam Mount Vinson als héchstem Punkt mat 4 892 m." },
        { "cell": "grouped", "text": "Japan ëmfaasst bal 7 000 Inselen (déi gréisst ass Honshu), wat Japan zu der siwentgréisster Insel vun der Welt mécht!" },
        { "cell": "grouped", "text": "An de Vereenegte Staate vun Amerika ginn et ongeféier 400 000 bekannt Fäll vu Multipler Skleros (MS), wouduerch se d'neurologesch Haapterkrankung bei Jonken an Erwuessene vu mëttlerem Alter duerstellt." },
        { "cell": "grouped", "text": "Geesse goufen anscheinend scho virun ongeféier 10 000 Joer an den Zagros-Bierger vum Iran fir d'éischt domestizéiert." },
        { "cell": "signed-number", "text": "Montevideo läit an den Subtropen; an de Summerméint leien d'Temperaturen üblecherweis iwwer +30 Grad Celsius." },
        { "cell": "letter-name", "text": "D'Haaptzil vun der Wëssenschaft ass et ze klären, wéi d'Welt duerch d'wëssenschaftlech Method funktionéiert. Dës Method leet definitiv de gréissten Deel vun der wëssenschaftlecher Fuerschung." },
        { "cell": "letter-name", "text": "D'Wëssenschaft weist elo dorop hin, datt dës massiv Kuelestoffwirtschaft ee vun de stabillen Zoustänn vun der Biosphär gestéiert huet, déi d'Evolutioun vun der Mënschheet an de leschten 2 Millioune Joer ënnerstëtzt hunn." },
        { "cell": "letter-name", "text": "D'Eegenschaften, déi eng Subkultur als ënnerschiddlech bestëmmen, kënne sproochlech, ästheetesch, reliéis, politesch, sexuell, geografesch oder eng Kombinatioun vu Facteure sinn." },
        { "cell": "letter-name", "text": "D'Haaptrelioun a Moldawien ass Chrëschtlech Orthodox." },
        { "cell": "exponent", "text": "Et ass en Archipel mat 15 Inselen, déi iwwer 2,2 Millioune km² vum Ozean verdeelt sinn." },
        { "cell": "exponent", "text": "D'Sundarbans erstrecke sech iwwer eng Fläch vun 3 850 km², vun deenen ongeféier een Drëttel mat Waasser-/Suppgebidder bedeckt ass." },
        { "cell": "exponent", "text": "Dëst ergëtt eng bal véier Mol esou héich Opléisung ewéi e 35-mm-Negativ (3136 mm² am Verglach zu 864)." },
        { "cell": "ampersand", "text": "Et gëtt zwee lokal Béier, de wichtegsten ass &apos;Number One&apos;, et ass kee komplexe Béier, awer angeneem an beliewend; deen aneren heescht \"Manta\"." },
        { "cell": "ampersand", "text": "Säin Éischte war de Slalom, wou hatt an sengem éischte Laf en &apos;Did Not Finish&apos; kritt huet. 36 vun 116 Participanten haten dat selwecht Resultat an där Course." },
        { "cell": "ampersand", "text": "Wann Dir de Film &apos;Das Vermächtnis der Tempelritter&apos; gesinn hutt, dann denkt Dir eventuell, datt eng Schatzkaart op d'Récksäit vun der Onofhängegkeetserklärung geschriwwe gouf." },
        { "cell": "ampersand", "text": "All Haaptwierder niewent dem Wuert &apos;Sie&apos; fir &apos;Dir&apos; fänken ëmmer mat engem Groussbuschtaf un, och matzen an engem Saz." },
        { "cell": "version-dot", "text": "Den 802.11n-Standard funktionéiert esouwuel op de Frequenzen 2,4 GHz ewéi och 5,0 GHz." },
        { "cell": "quote-letter", "text": "Wéi d'Kämpf nom Transport vun de Verwonnten an d'Spidol opgehalen hunn, sinn ongeféier 40 vun den iwwerege Prisonéier am Haff bliwwen an hu sech geweigert, an hir Zellen zeréckzegoen." },
        { "cell": "quote-letter", "text": "Well d'Studenten dacks de kriteschste Publikum sinn, fänkt de Blogautor un dono ze striewen, seng Schreifweis ze verbesseren, fir Kritik ze vermeiden." },
        { "cell": "quote-letter", "text": "Wëssenschaftler denken, datt Ozelotten Déiere fir z'iessen (Fäng) follegen a fannen, andeem se schnoffelen, wou se um Buedem waren." },
        { "cell": "quote-letter", "text": "Beispiller vun Aktivitéiten op der Plaz si Juegd, Fëschen, Fotografie, Vullebeobachtung an d'Besiche vu Parken an de Studium vun Informatiounen iwwer den Ekosystem." },
        { "cell": "ordinal-caps", "text": "Hien huet sech och mat der Gravur vu Geldschäiner fir vill Länner beschäftegt an déi jéngst Beispiller vu senger Aarbecht ëmfaassen d'Portraite vum Premierminister um Recto vun den neie kanadesche 5- an 100-Dollar-Schäiner." },
        { "cell": "ordinal-caps", "text": "Déi 25-Dunlap-Fluchblieder, vun deene mir wëssen, datt se ëmmer nach existéieren, sinn déi eelst Kopië vum Dokument. D'handgeschriwwen Originalkopie huet net iwwerlieft." },
        { "cell": "ordinal-caps", "text": "De Rolando Mendoza huet mat sengem M16-Gewier op d'Touriste geschoss." },
        { "cell": "ordinal-caps", "text": "Beléift Sportaarte si Fussball, Basketball, Volleyball, Waasserball, Fechten, Rugby, Cyclissem, Äishockey, Rullhockey a F1-Motorsport." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Berüümt Sänger am ganze Land hu Bhajanen, oder opafferend Lidder, zu de Féiss vum Shri Shyam duergebueden.",
        "Israel fuerdert eng stänneg militäresch Presenz fir zéng Joer am Dall, esoubal en Ofkommes ënnerzeechent gëtt, wärend d'palästinensesch Autoritéit dës Presenz nëmme fir fënnef Joer zouloosse wëllt.",
        "Wann Dir een urufft, deen Dausende vu Kilometer ewech ass, da verwent Dir e Satellit.",
        "Hie war net an der Lag, Medikamenter ze huelen, fir seng Péng ze iwwerwannen, well se wärend de Spiller verbuede sinn.",
