        "ایں کم ءچ سکول کالج یونیورسٹی دےسٹوڈنٹس تےاوندےاساتذہ ایں کم ءچ مرکزی کردار ادا کرسکدن",
        "آپ کوں پر ہیز گار تے متقی ہووَݨ دی ریا کاری کرتے انسانیت نال شرمناک اتے ظالمانہ ورتاوے کَرݨ نال ہک تل وی پچھوں تے نی رَہ ، مذہب دے ناں تے معصوم لوکاں کوں کوہَݨ ، انہاں دیاں تریمتیاں کوں",
        "شعری مجموعہ’’سمندر سُک گیا ہوسی‘‘دے خالق طارق محسن قیصرانی دا تعلق تونسہ شریف دی وستی جھوک بودو نال ہے ،آپ دا شمار نویں نسل دے جدید غزل گو شعراء وچ تھیندے،جیکوں جدید غزل دے مہان شاعر حضرت اقبال سوکڑی نویں شاعریں دی قطار دا موہری شاعر آکھئے۔طارق محسن دا شعر آکھن دا اپناں نویکلا انداز تے اپناں مخصوص لب و لہجہ ہے۔اوہ اپنی شاعری اچ نت نویاں سوچاں گھن آکے نویں تجربے کریندا نظر آندے۔اوندے اندر شعور د اسمندر نت نویں موتی باہر اُچھل ڈیندے۔ایہا ای وجہ ہے جو 5اگست 2017ء کوں کوٹ ادو اچ تھیون آلے ہک طرحی مشاعرے دے مقابلے وچ آپ پہلی پوزیشن گھن کے ایوارڈ حاصل کیتا۔طارق محسن شاعری دے نال نال نثر وی لکھدن ،انہاںدا ناول ’’ٹکے سیر‘‘زیرِ طبع ہے۔نمونہ کلام حاضر ہے",
        "محمد یوسف اختا دی ڄاݨ سُنڄاݨ دلنور صاحب لکھدے ٻیٹھن ، یوسف آکدے میݙے ابّے سئیں دا ناں گانموں ہے اَتے اساں رہݨ آلے کھوبگھے والا چوک مُنڈا دے ہیسے ۔ او آکھدے اَڄ کل چوک مُنڈے کوں لوک چوک سرور شہید آکھدن ، تساں چوک مُنڈا دا لفظ ضرور لکھو ، جیکر کوئی مجبوری ہووے تاں لوظ سرور شہید وی نال اَڑا چھوڑو پر کھوبگھے والا تے چوک مُنڈا ضرور آوے کیوں جو اے اساݙی قدیمی سُنڄاݨ ہے۔",
        "اپݨی حیاتی توں ودھ اپݨی پڑھائی دی فکر کرݨ آلے نینگر دا ناں منیر احمد دھریجہ ، گھر آلے پیار توں پُنل سݙیندے ہن۔ منیر احمد دھریجہ میݙے چاچے عبدالعزیز دا پُتر ہا پر اساں سوتریں دا مُنڈھ لا توں آپت ءِ چ ڳانڈھا ایجھا ہاجو برادری دے علاوہ آڑے پاڑے دے سارے حق ہمسائے اساکوں سکا بھرا سمجھدے ہن۔ میݙی بے نصیبی جو میں اتنا زیادہ پڑھ نہ سڳیم پر میکوں لکھݨ پڑھݨ دا ݙاڈھا شوق ہا تے تختی دی مشق میݙی لکھت دی نوک پلک سنوار ݙتی ۔ 1975ء ءِ چ استاد مقبول دھریجہ میکوں خوشخطی سکھاوݨ کیتے کراچی گھن ڳے۔ کراچی پُڄݨ دے بعد میکوں چٹھی دے ذریعے سب توں پہلے جیرھے شخص دیاں دعائیں ملیاں او منیر احمد دھریجہ ہا ۔ انہاں میکوں لکھیا جو ݙاݙی اماں ݙاڈھی مونجھی اے تے روندی راہندی اے ، او آکھدی اے ’’ ظہورݨ کاتل (کاتب دا لوظ انہاں دی زبان تے نہ چڑھدا ہا ) نہ بݨے تے گھر ول آوے ۔ ‘‘ منیر صیب لکھیا جو مونجھے تاں اساں وی ہیسے پر تُساں کم جاری رکھو ۔",
        "میکوں یقین ہے جو اساݙے دانشور ایں موضوع تے ٻہوں کجھ لکھسن ایں طرح سرائیکی وسیب د ے بارے معلومات دا وسیع سلسلہ شروع تھیسی جیندی شروعات پہلے سئیں حمید اُلفت ملغانی تے ہݨ سئیں ظہور احمد دھریجہ کیتی اے تے ایں ٹور کوں اڳوں تے ٹوریے۔ کتاب تہاݙے ہتھیں وچ ہے تے میں اُمید کرینداں جو تُساں وی ساݙے ہتھیں وچ ہتھ پا تے سرائیکی ادبی بورڈ کوں آسرا ݙیسو تاں جو او اے کم جاری رکھے۔ میں سئیں ظہور احمد دھریجہ دا تھورائت آں جو اُنہیں میݙی درخواست تے اے کم کیتے تے انہیں دی اے کاوش تہاکوں کیویں لڳی اے؟ اے ضرور ݙسیسو، اساں تہاݙے مشورے دا انتظار کریسوں۔",
        "شاہد حامد پاکستان دا سیاست دان تے سابق گورنر پن٘جاب ہے۔ شاہد حامد 24 اکتوبر 1947 کوں پیدا تھیا ہا۔ بطور پیشہ او قانون دان ہے۔ انہاں دی سیاسی وابستگی مسلم لیگ (ن) نال ہے۔ شاہد حامد 6 نومبر 1996 کنوں 17 فروری 1997 تئیں وزیر دفاع ریہا۔ ول 11 مارچ 1997 کنوں 18 اگست 1999 تئیں پن٘جاب صوبہ دا گورنر ریہا۔ او تقریبا 2 سال تے 160 ݙین٘ہہ عہدے تے ریہا۔ انہاں کنوں پہلے خواجہ طارق رحیم تے انہاں دے بعد ذوالفقار علی کھوسہ پن٘جاب دے گورنر ہن۔",
        "عبدالمطلب نے نذر منی ہئی کہ جے انہیں دے ݙاہ پتر تھیسن تاں او ہک پتر کوں کعبہ دے کول قربان کر ݙیسن۔ جݙاں انہاں دے ݙاہ پتر تھی ڳئے تاں قرعہ اندازی وچ حضرت عبداللہ دا ناں نکلیا۔ لیکن قریش دے مشورے نال سو اوٹھ قربان کیتے ڳئے۔",
        "ضیاء الحق آپݨے دور اِچ بہاولپور دی دھرتی تے قہر وسایا۔ اُوں سارے پاکستان دے جالندھری ارائیاں کوں کٹھا کر بہاولپور ریاست اِچ آباد کرایا۔ او بھانویں فوجی افسر ہا یا عام مزدور جتھاں سرکاری زمین موجود ہئی ارائیاں کوں ملی ۔اِتھاں ݙوں چیزاں یاد رکھݨ اہم اے۔ ہک ہئی آباد کاری جیندے کیتے نواب آف بہاولپور دعوت ݙتی ݙوجھی ہئی قبضہ گیری جیڑھی ۱۹۷۰ء دے بعد شروع تھئی۔ نواز شریف ہووے یا چوہدری پرویز الٰہی انہاں بہاولپور اِچ قبضے کرائے ڈیموگرافی تبدیل کرائی ہݨ جیڑھے پنجابی حضرات بہاولپور دے الحاق پنجاب دے حامی ہن او ہُݨ بہاولپور صوبہ منگدن ۔ ساݙے اندھیاں کوں سمجھ نی آندی ۔",
        "میں ہم تاں ڄٹاں ٻوٹاں دی اولاد پر رَڄ سوہݨا ہم ۔ ککے ککے وال ہووِن ، فوجی افسر میکوں چا تے خوشی کنوں پُھنڈا وَدا ہووے ، میکوں کھاوݨ کیتے سئے پھل فروٹ ݙتونے ۔ لعلاں کنوں بغیر میݙے سنگھ کنوں تلے کوئی شئے نہ لہے ، میں لعلاں کوں یادکراں ، روواں میکوں دِلاسے ݙتے ، آخر جیپ اِچ ٻلھا تے شہر اپݨے گھر روانہ تھی پئے جیپ کچے رستے تے دُدّڑیں اُݙیندی ہوئی ہک پکی سڑک تے آڳئی ۔ پکی تے فرراٹے مریندی ہوئی شہر داخل تھئی ۔ ہک چوک توں وَل تے کالونی اِچ ہک عالیشان کوٹھی دے پورچ اِچ آݨ رُکی ۔ میݙا مجازی پیو میکوں چا تے کوٹھی دے اندر آیا تے خوشی کنوں زال کوں ہَکل ماریُس فاطمہ ! آ ݙیکھ اللہ سائیں دریا وچوں لعل لبھوائے۔ میں لعل دا ناں سُݨیا تے رووݨ پئےڳیومی جو اللہ ڄاݨے ایں لعل دی لعلاں کتھاں تے کیڑھے حال اِچ ہوسی ۔ مائی فاطمہ بوچھݨ دی ٻکل ماری ہوئی تسبیح ہتھ اِچ پڑھدی ہوئی آئی ۔ میݙے منہ تے پھوکا ݙے تے پُچھیُس ایہہ ٻال کوݨ ہے ، ایکوں ہُݨ اپݨا پُتر سمجھ میݙے پیئو میکوں مائی دی جھولی وچ ݙیندے ہوئے آکھیا ۔ مائی فاطمہ میکوں چُم ہاں نال لاتے ٻولی بے پرواہ سائیاں میݙی جھولی ساوی نہوی کیتی تاں نہ کریں ہا پر کہیں کرماں سڑی دی جھولی تاں نہ اُڄاڑیں ہا ۔ جھولی ہووے ہا تاں اُڄڑے ہا۔",
        "پچادھ اچ: شیر دست آلی، خانےآلی تے ڈھوک علی خیل",
        "غزل دے لغوی معنی عورتاں نال ڳالھیں تے عشق بازی کرݨ ہے ۔ غزل دے ہک معنی ایہ وی ہن جیڑھلے شکاری کتا ہرݨ دا شکار کریندے تے ہرݨ بے وسی اچ کوکدے اُوندی ایں مونجھی کوک کوں ’’غزل القلب ‘‘ آہدن۔",
        "اے ہک طویل نظم ہے ۔ دراصل ایں نظم وچ انھاں لوکاں تے چوٹ کیتی ڳئی ہے جیڑھے سوڑ ݙیکھ تے پیر نیں درگھیندے۔ بلکہ ݙکھاوے دی پھوت پھات کیتے اپݨی حیثیت توں ودھ شادیاں تے خرچ کریندن تے بعد اِچ کمیاں کاسبیاں کنوں لُکدے ودے ہوندن۔ سرائیکی وسیب دا شادیاں تے بے پناہ روپیہ خرچ کرݨ ٻہوں وݙا مسئلہ ہے۔ ایں نظم وچ وݙے سوہݨے طنزیہ تے مزاحیہ انداز اِچ ایں سماجی برائی تے اوندے منفی اثرات دی نشاندہی کیتی ڳئی ہے۔",
        "مولوی عبداللہ موضع ملکہ ہانس ضلع ساہیوال دے رہݨ والے ہن۔ آپ دے والد صاحب دا ناں جان محمد ہئی۔ مولانا اپݨی ساری عمر دین دی تعلیم تے تبلیغ واسطے وقف کیتی ہوئی ہئی۔ بعد وچ آپ ملکہ ہانس توں لاہور تشریف گھن ڳے تے باقی عمر اتھاہیں بسر کیتی۔ ملکہ ہانس دے سکونتی ہووݨ دی وجہ توں آپ دے کلام وچ سرائیکی الفاظ دی کافی آمیزش ہے۔ ڈاکٹر مہر عبدالحق آہدن مولانا عبداللہ دے رسائل وچ زبان تے ملتانی دے اثرات ٻہوں گھاٹے ہن۔ انھاں دی زبان پنجابی ،ملتانی آمیز پنجابی ہے ۔ ہِیں کیتے اساں انھاں دے رسائل کوں ملتانی دے لٹریچر وچ جگہ ݙیندے ہیں۔",
        "تمغہ حسنِ کارکردگی ݙیوݨ کیتے کجھ خاص ڳالھیں ہوندین۔ ایوارڈ حاصل کرݨ آلےبندے دا کم چنڳا ہووݨا چاہیدا ہے تے اوں آپݨے شعبے وچ چنڳی خدمت انجام ݙتی ہووے۔ ایں ایوارڈ کیتے غور کرݨ کیتے ایوارڈ حاصل کرݨ آلے دی قابلیت، تجربہ، تے بین الاقوامی سطح تے اوں دی پہچاݨ کوں ݙٹھا ویندے۔",
        "اتھوں لبھݨ والا کارنیلین، جیڑھا مقامی طور تے نہیں ملدا تے خلیج خمبھاٹ دے آس پاس پایا ویندا ہے، ایہ ظاہر کریندا ہے کہ ایہ تجارت گجرات دے نال پیلو-سرسوتی دریا دے جہاز رانی چینلز دے ذریعے تھیندی ہئی۔",
        "2014: میری کیوری، اون فیم سور لی فرونٹ، اک فرانسیسیبیلجیئم فلم، جیڑھی ایلین برنارڈ ڈائریکٹ کیتی تے ڈومینیک ریمنڈ اداکاری کیتی۔",
        "\"جݙݨ میں 1923 وچ امریکن فزیکل سوسائٹی دی ہک میٹنگ وچ اپݨے نتائج پیش کیتے،\" کومپٹون بعد وچ یاد ݙیوایا، \"تاں ایندے نال سب توں ودھ مقابلہ کیتا ونڄݨ والا سائنسی تنازعہ شروع تھیا جیڑھا میں کݙاہیں ڄاتا ہے۔\" روشنی دی موجی فطرت چنگی طرح ثابت تھی ڳئی ہئی، تے ایہ خیال جو ایندی ݙوہری فطرت تھی سڳدی ہے آسانی نال قبول نہ کیتا ڳیا۔ ایہ خاص طور تے ݙسیندا ہا جو کرسٹل جالی وچ ڈفریکشن کوں صرف ایندی موجی فطرت دے حوالے نال بیان کیتا ونڄ سڳدا ہے۔ ایندے تے کومپٹون کوں 1927 وچ طبیعیات دا نوبل انعام ملیا۔ کومپٹون تے الفریڈ ڈبلیو سائمن ہک ای ویلھے وچ انفرادی منتشر ایکس رے فوٹون تے ریکوئل الیکٹرانز دا مشاہدہ کرݨ دا طریقہ تیار کیتا۔ جرمنی وچ والتھر بوتھے تے ہانس گائگر آزادانہ طور تے ہک ملدڑ طریقہ تیار کیتا۔",
        "یانگ 1971 اچ چین-امریکہ تعلقات اچ بہتری دے بعد پہلی واری چینی سرزمین دا دورہ کیتا ، تے اوں دے بعد چینی طبیعیات برادری کوں تحقیقی ماحول دوبارہ بݨاوݨ اچ مدد کرݨ کیتے کم کیتا جیڑھا ثقافتی انقلاب دے دوران بنیاد پرست سیاسی تحریکاں ولوں تباہ کر ݙتا ڳیا ہئی ۔ سٹونی بروک توں ریٹائر تھیوݨ دے بعد ، او بیجنگ دی تسنگہوا یونیورسٹی دے اعزازی ڈائریکٹر دے طور تے واپس ڳئے ، جتھاں او سینٹر فار ایڈوانسڈ سٹڈی (CASTU) اچ ہوانگ جیبی-لو کائکون پروفیسر ہن ۔ او ݙو شاو پرائز فاؤنڈنگ ممبرز اچوں ہک ہن تے چائنیز یونیورسٹی آف ہانگ کانگ اچ ڈسٹنگوئشڈ پروفیسر ایٹ لارج وی ہن ۔",
        "سپر کنڈکٹیویٹی دے نظریہ تے اپݨا ڈاکٹریٹ مقالہ مکمل کرݨ دے بعد ، شریفر 1957–1958 دا تعلیمی سال نیشنل سائنس فاؤنڈیشن دے فیلو دے طور تے انگلینڈ دی یونیورسٹی آف برمنگھم تے کوپن ہیگن دے نیلز بوہر انسٹیٹیوٹ وچ گزاریا ، جتھاں انہاں سپر کنڈکٹیویٹی تے تحقیق جاری رکھی ۔ یونیورسٹی آف شکاگو وچ ہک سال اسسٹنٹ پروفیسر دے طور تے کم کرݨ دے بعد ، او 1959 وچ فیکلٹی ممبر دے طور تے یونیورسٹی آف الینوائے واپس آ ڳیا ۔ 1960 وچ ، او ہنالے دی ملاقات کیتے بوہر انسٹیٹیوٹ واپس ڳیا ، جیندے دوران انہاں دی منگنی این گریٹے تھامسن نال تھئی جیہناں نال انہاں اوں سال کرسمس تے شادی کیتی ۔ ݙو سال بعد ، شریفر فلاڈیلفیا وچ یونیورسٹی آف پنسلوانیا دی فیکلٹی وچ شامل تھیا ، تے 1964 وچ ، شریفر بی سی ایس تھیوری تے اپݨی کتاب ، تھیوری آف سپر کنڈکٹیویٹی شائع کیتی ۔ انہاں کول میونخ دی ٹیکنیکل یونیورسٹی تے جنیوا دی یونیورسٹی توں آنریری ڈگریاں ہن ۔ 1968 وچ شریفر کوں ، کوپر دے نال ، نیشنل اکیڈمی آف سائنسز توں فزکس وچ کامسٹاک انعام ݙتا ڳیا ۔ انہاں کوں اوں سال امریکن فزیکل سوسائٹی ولوں اولیور ای بکلی کنڈینسڈ میٹر انعام وی ݙتا ڳیا ۔",
        "کینڈل نہ صرف ہک ٻہوں کامیاب فزکس دان ہا ، بھل جو ہک ٻہوں ماہر پہاڑ چڑھݨ والا تے فوٹوگرافر وی ہا ۔ انہاں یوسیمائٹ ویلی وچ وسیع پیمانے تے چٹان چڑھائی کیتی ، ایندے بعد اینڈیز ، ہمالیہ تے انٹارکٹیکا دے سفر کیتے ، وݙے فارمیٹ کیمریاں نال اپݨے تجربات دی تصویر کشی کیتی ۔ انہاں کوں 1982 وچ امریکن اکیڈمی آف آرٹس اینڈ سائنسز دا فیلو منتخب کیتا ڳیا ۔ 7 اپریل 2012 کوں ، امریکن الپائن کلب کینڈل کوں کولوراڈو دے گولڈن وچ ہک ایوارڈ تقریب وچ ہال آف ماؤنٹینئرنگ ایکسیلنس وچ شامل کیتا ۔",
        "ایس پی سی،جی پی ٹی بزنس ٹریننگ کالج نوٹنگھم",
        "ہانگ کانگ 1985 چینی یونیورسٹی آف ہانگ کانگ ڈاکٹر آف سائنس آنورس کاز برطانیہ 1990 یونیورسٹی آف سسیکس ڈاکٹر آف سائنس آنورس کاز تائیوان 1990 نیشنل چیاؤ ٹنگ یونیورسٹی ڈاکٹر آف انجینئرنگ آنورس کاز جاپان 1991 سوکا یونیورسٹی ڈگری آف آنریری ڈاکٹر برطانیہ 1992 یونیورسٹی آف گلاسگو ڈاکٹر آف انجینئرنگ آنورس کاز برطانیہ 1994 ڈرہم یونیورسٹی آنریری ڈی سی ایل آسٹریلیا 1995 گریفتھ یونیورسٹی ڈاکٹر آف دی یونیورسٹی اٹلی 1996 یونیورسٹی آف پادوا ڈاکٹر آف ٹیلی کمیونیکیشنز انجینئرنگ آنورس کاز برطانیہ 1998 یونیورسٹی آف ہل ڈاکٹر آف سائنس آنورس کاز امریکہ 1999 ییل یونیورسٹی ڈاکٹر آف سائنس آنورس کاز برطانیہ 2002 یونیورسٹی آف گرین وچ ڈاکٹر آف سائنس آنورس کاز امریکہ 2004 پرنسٹن یونیورسٹی ڈاکٹر آف سائنس آنورس کاز کینیڈا 2005 یونیورسٹی آف ٹورنٹو ڈاکٹر آف لاز آنورس کاز چین 2007 بیجنگ یونیورسٹی آف پوسٹس اینڈ ٹیلی کمیونیکیشنز آنریری ڈاکٹر برطانیہ 2010 یونیورسٹی کالج لندن ڈاکٹر آف سائنس برطانیہ 2010 یونیورسٹی آف سٹریتھ کلائیڈ آنریری ڈگری ہانگ کانگ 2011 یونیورسٹی آف ہانگ کانگ ڈاکٹر آف سائنس آنورس کاز",
        "کوانٹم میکینکس دے بنیادی ٹیسٹ دا زیلنگر دا پروگرام انفرادی نظاماں کیتے کوانٹم فزکس دیاں ٻہوں ساریاں غیر کلاسیکی خصوصیات دے تجرباتی احساس کوں لاگو کرݨ دا مقصد ہے ۔ 1998 اچ ، انہاں سپر فاسٹ رینڈم نمبر جنریٹرز استعمال کر کے کمیونیکیشن لوپ ہول کوں بند کر کے بیل دی عدم مساوات دا حتمی ٹیسٹ فراہم کیتا ۔ ایندے گروپ آزادی پسندانہ شرط کوں لاگو کریندے ہوئے پہلے بیل دی عدم مساوات دے تجربے دا وی احساس کیتا تے فوٹونز کیتے منصفانہ سیمپلنگ مفروضے دے بغیر بیل ٹیسٹ دا پہلا احساس فراہم کیتا ۔",
        "انہاں خیالات تے ، اتے ٻئے ملدے جلدے خیالات تے ، 1904 وچ رچرڈ ایبیگ او فارمولا بݨایا جیڑھا جو ہݨ ایبیگ دے اصول دے طور تے ڄاتا ویندا اے جیڑھا جو ݙسیندا اے جو ہک عنصر دی زیادہ توں زیادہ مثبت تے منفی ویلنس دے درمیان فرق اکثر اٹھ ہوندے ۔ ایہ اصول بعد وچ 1916 وچ استعمال تھیا جݙاں گلبرٹ این لیوس اپݨی کیوبیکل ایٹم تھیوری وچ اصول وضع کیتا ۔",
        "جیوک کوں 1936 وچ یونائیٹڈ سٹیٹس نیشنل اکیڈمی آف سائنسز دا رکن ، 1940 وچ امریکن فلاسوفیکل سوسائٹی دا رکن ، اتے 1950 وچ امریکن اکیڈمی آف آرٹس اینڈ سائنسز دا رکن منتخب کیتا ڳیا ۔",
        "حل وچ عام کواٹرنیئن الجبرا تے بیضوی فنکشنز دا نظریہ شامل ہئی ، جیڑھا انہاں اے کورس آف ماڈرن اینالیسس توں سکھیا ہئی ۔",
        "1958 وچ ، پولانی این فیرار ڈیوڈسن (1929–2013) نال شادی کیتی ۔ انہاں دے ݙو ٻال ہن - ہک دھی ، مارگریٹ ، جیڑھی 1961 وچ ڄمی ہئی تے ہک پتر ، مائیکل ، جیڑھا 1963 وچ ڄمیا ہا ۔ انہاں دی دھی ہک صحافی ہے ، تے انہاں دا پتر ہک سیاسی سائنسدان ہے جنہاں اپݨے کیریئر دی شروعات ہک طبیعیات دان دے طور تے کیتی ہئی ۔ پولانی اڄ کل پورٹریٹ آرٹسٹ برینڈا بری نال شادی شدہ ہن ۔ اپݨے سائنسی تے پالیسی دے کماں توں ٻاہر ، پولانی دی دلچسپی وچ آرٹ ، ادب تے شاعری شامل ہن ۔ او اپݨے نوجوان دناں وچ وائٹ واٹر کینوئسٹ ہن ، پر ہݨ انہاں اینکوں چلݨ تے سکیئنگ نال بدل ݙتا ہے ۔",
        "کورنبرگ ڈی این اے ٹرانسکرپشن اچ آر این اے پولیمریز II تے ٻئے پروٹینز دے کردار دی سنڄاݨ کیتی ، ایکس رے کرسٹالوگرافی دا استعمال کریندے ہوئے پروٹین کلسٹر دیاں تریخی جہتی تصویراں بݨائیاں ۔",
        "یوشینو دریافت کیتا کہ ہک خاص کرسٹل بݨتر والا کاربونیشیئس میٹریل اینوڈ میٹریل دے طور تے موزوں ہے ، تے ایہ اینوڈ میٹریل اے جیڑھا کمرشل LIBs دی پہلی نسل اچ استعمال تھیا ہا ۔ یوشینو ایلومینیم فوائل کرنٹ کولیکٹر تیار کیتا جیڑھا کم لاڳت تے ہائی سیل وولٹیج کوں ممکن بݨاوݨ کیتے ہک پاسیویشن لیئر بݨیندا ہے ، تے فنکشنل سیپریٹر میموری تیار کیتی تے اضافی حفاظت کیتے مثبت درجہ حرارت کوفیشینٹ (PTC) ڈیوائس تیار کیتی ۔",
        "سرائیکی ثقافت ٻہوں رنگا رنگ ہِے۔ اِیں وِچ مختلف قسم دے رواج، فنون لطیفہ اَتے دستکاریاں شامل ہِن۔ میڈیا اِنھاں سب ثقافتی رنگاں کوں نشابر کریندا ہِے۔ سرائیکی لوک موسیقی، سرائیکی ڈانس، سرائیکی لباس اَتے سرائیکی کھاݨے میڈیا دے ذریعے دُنیا بھر وِچ مشہور تھیندے پِن۔",
        "٭ دلشاد کلانچوی’’قدیم سرائیکی شاعر تے ادیب‘‘ اکادمی سرائیکی ادب بہاولپور توں (۱۹۸۷ئ) اچ چھپݨ آلی کتاب دے مصنف ہن۔",
        "٭ ظہور دھریجہ دی کتاب سرائیکی وسیب کوں چار لکھاں وچ ونڈیا ونڄ سڳدے، تحقیق، تنقید، شخصیات، ثقافت، ایندے وچ مضمونیں دی تعداد ۵۷ ہے۔",
        "افسانہ ’’وٹہ سٹہ‘‘ اِچ افسانہ نگار اپݨے معاشرے دی بُتھی رسماں کوں موضوع بݨیندے ۔ وٹہ سٹہ دی شادی اکثر ہی لڑائی تے جھیڑے دا باعث بݨدی اے ۔ ہک اُجٖڑا گھر نال وسدے ٻئے گھر کوں اپݨے نال گِھن ٻڈدے۔",
        "پاکستان دی دھرتی علم و ادب دا گہوارہ ہے ۔ تہذیب و تمدن دی ایں سوہݨی تے مِٹھی سر زمین تے مختلف زباناں دے پُھل اپݨی خشبواں نال روایات کوں حیاتی ݙیندے ریہے ۔ انہاں روایات وچ اساݙا ثقافتی ورثہ موجود ہے ۔ اساݙے وسیب دی سُنڄاݨ ، ساݙی مٹی دی خشبو ، رسم و رواج تے رہوݨ دے سارے انداز ایندے وچ موجود ہِن۔",
        "سونیا خان (اردو: سونیا خان، کنوں) ہِک پاکستانی اداکارہ ہِے جہڑی پاکستانی سینما نال جڑیل ہِے اَتے فلماں اَتے ٹی وی وِچ کَم کرین٘دی ہِے۔ اُوہ اردو، پنجابی، سولی ووڈ اَتے پشتو فلماں وِچ کَم کرین٘دی ہِے۔",
        "ابو طیب بن غلبون دی سب توں مشہور کتاب \"الإرشاد في معرفة مذاهب القرّاء السّبعة\" ہے، جیہڑی قراءتِ سبعہ دے اصولاں تے مبنی ہئی۔ ایہ کتاب بعد وچ آوݨ آلے علما، جیویں ابن جزری دی \"النشر فی القراءات العشر\" دا بنیادی ماخذ بݨی ۔ انہاں دی ہک ٻئی اہم تصنیف \"الاستكمال لبيان مذاهب القراء السبعة فی التفخيم و الامالة\" وی ہے، جیہڑی خطی شکل وچ مختلف کتب خانے وچ محفوظ ہے ۔",
        "بادشاہ حکم ݙتا ایں باز دے پرکپ گھنّو ‘ ایکوں اپݨے شہپریں تے وݙا غرور ہے ‘ میں نہیں چاہندا جو کوئی طاقتور کہیں کمزور کوں اپݨا زور تے زعم ݙکھاوے۔ بادشاہ دا حکم تھیا اِنوں باز دے پرکپ ݙتے ڳئے ۔",
        "فرانسس ہیری کامپٹن کرک (Francis Harry Compton Crick) ہک ایجھاں سائنس دان ہن جنہاں حیاتیات دے میدان وچ انقلاب برپا کر ݙتے ۔ انہاں دی تحقیق تے دریافتاں نہ صرف سائنس دی دنیا کوں متاثر کیتے بھل انسان دی زندگی کوں وی بدل ݙتے ۔ انہاں دی سب توں وݙی دریافت ڈی این اے (DNA) دی بݨتر دی تشریح ہئی ، جیڑھی حیاتیات دے میدان وچ ہک سنگ میل ثابت تھئی ۔",
        "وارمس نیشنل انسٹیٹیوٹس آف ہیلتھ دے ڈائریکٹر تے نیشنل کینسر انسٹیٹیوٹ دے ڈائریکٹر دے طور تے وی خدمات انجام ݙتیاں ۔",
        "تعلیم مکمل کرݨ توں بعد ، جولیس کجھ عرصہ مختلف یونیورسٹیاں وچ تحقیق کریندے ریہے ۔ ول انہاں بطور پروفیسر کم شروع کیتا ۔ انہاں دا کم زیادہ تر نیورو سائنس تے خاص طور تے درد تے گرمی دے احساس تے مرکوز ہا ۔",
