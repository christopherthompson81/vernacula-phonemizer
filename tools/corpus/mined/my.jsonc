        { "cell": "ampersand", "text": "Akira Nagata၊ ဂျပန်အဆိုတော် (Run&Gun)၊မင်းသားနှင့် အသံမင်းသား" },
        { "cell": "ampersand", "text": "Janelle Monáe၊ အာဖရိကန်-အမေရိကန်R&B/soul ဂီတပညာရှင်" },
        { "cell": "ampersand", "text": "စာရေးဆရာ (G.H luce)က ဗမာနှင့် သက်၊ ရှမ်းစသည်တို့ စစ်ဖြစ်စဉ် ချင်းလူမျိုးများနှင့် မိတ်ဖွဲ့ ဆက်ဆံဘွယ်ရှိခဲ့ကြသည်။ ထို့ကြောင့် ချင်းဆိုသည်မှာ ကျနော် တို့ဗမာနှင့် အချင်းချင်း၊ သူငယ်ချင်းဖြစ်သည်ဟု ဆိုရာမှ ချင်းဖြစ်လာသည်ဟု ဆိုသည်။ ၁၅၅၄ ခုနှစ်၊ မဏိပူရ်မှတ်တမ်းတွင် ချင်းတို့ကို ကူကီးဟုရေးသားထားသည်ကို တွေ့ရသည်။ Carry & Tuck ၏" },
        { "cell": "ampersand", "text": "ဗြိတိသျှတို့က ချင်းတော်လှန်ရေးအဖွဲ့အား မြူဆွယ်နိုင်လိမ့်မည်ဟု ယုံကြည်ခဲ့ကြသည်။ Captain Raike သည် Gan Kaw Valley သို့ ခရီးဆက်ခဲ့ပြီး Haka နှင့် Zokhua (Lai Tribes) အကြီးအကဲများနှင့် တွေ့ဆုံရန် ရည်ရွယ်ခဲ့သော်လည်း Captain Egre နှင့် တွေ့ဆုံပြီးကြောင်း သိရှိသဖြင့် စစ်ကြောင်းပြန်ခေါက်ခဲ့သည်။ Captain Egre သည် Haka, Zokhua အကြီးအကဲများနှင့် တွေ့ဆုံဆွေးနွေးရန် ဆက်သား ၃ ဦး စေလွှတ်ခဲ့သော်လည်း ၂ ဦး အသတ်ခံခဲ့ရသည်။ Zokhua အကြီးအကဲ၏ ဗမာမယား၏သား ရွှေလှိုင်သည် သူ့မိခင်၏ အကူအညီဖြင့် လွတ်မြောက်ပြီး ရခိုင်တောင်တန်းဒေသသို့ ထွက်ပြေးလွတ်မြောက်ခဲ့သည်။ ဤအဖြစ်အပျက်သည် Haka & Zokhua နှင့် အင်္ဂလိပ်တို့၏ ဆက်ဆံရေးကို မည်သို့မျှ မထိခိုက်ခဲ့ပေ။ လိုင်မျိုးနွယ်စုများတွင် တန်ခိုးဩဇာကြီးမားသော ဟားခါးဘော်ဝီ (Hakha Bawi) က ယောနယ်ကို တိုက်ခိုက်ပြီး ၈ ဦးကို သတ်ဖြတ်ကာ ၄၈ ဦးအား ကျွန်အဖြစ် ဖမ်းဆီးခဲ့သည်။ ဗိုလ်ကြီး Raikes နှင့် စီယန်းအကြီးအကဲ ခိုင်ကမ်းတို့အကြား စေ့စပ်ဆွေးနွေးခဲ့သော်လည်း ခိုင်ကမ်းက ကလေးရှိ ရှမ်းလူမျိုးကို ထပ်မံတိုက်ခိုက်ခဲ့ပြန်ရာ ၁ ဦး သေဆုံးပြီး ၄ ဦးကို ကျွန်အဖြစ် ဖမ်းဆီးခဲ့သည်။" },
        { "cell": "ampersand", "text": "• C.A. Soppitt & J. Shakespear: ၎င်းတို့၏ ကိုယ်ပိုင်သုတေသနကျမ်းများတွင် ချင်းတို့သည် တရုတ်ပြည်မှ ဆင်းသက်လာသော တိဗက်-မြန်မာ အနွယ်ဝင်များ ဖြစ်ကြောင်း ရေးသားခဲ့ကြသည်။" },
        { "cell": "ampersand", "text": "• Carey & Tuck: The Chin Hills ကျမ်းတွင် ချင်းတို့၏ သမိုင်းနှင့် ဓလေ့ထုံးတမ်းများကို အသေးစိတ် မှတ်တမ်းတင်ခဲ့သည်။" },
        { "cell": "ampersand", "text": "National Drunk & Drugged Driving Prevention Month မူးယစ်ဆေးနဲ့အရက်သုံးပြီး ကားမောင်းခြင်း ကာကွယ်ရေး အမျိုးသားလ။" },
        { "cell": "iteration", "text": "အအိနိုနိုဘူတာ (相野々駅 အအိနိုနို - အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ အခိတခရိုင်၊ ယိုခိုတဲမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။" },
        { "cell": "iteration", "text": "ဘိဘိဘူတာ (美々駅 ဘိဘိ - အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ ဟော့ကိုင်းဒိုးကျွန်း၊ ချိတိုဆဲမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။" },
        { "cell": "iteration", "text": "အဲရိနိုနိုဘူတာ (襟野々駅 အဲရိနိုနို - အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ ခိုးချိခရိုင်၊ တခအိုခမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။" },
        { "cell": "iteration", "text": "ဟိုဘိုဘူတာ (保々駅 ဟိုဘို - အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ မိအဲခရိုင်၊ ယော့ခအိချိမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။" },
        { "cell": "iteration", "text": "ခိခိဆွတ်ဘူတာ (喜々津駅 ခိခိဆွတ်- အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ နာဂါဆာကီခရိုင်၊ အိဆဟယတိုင်း၊ တရမိမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။" },
        { "cell": "iteration", "text": "ခဲဆဲ ရှိဆုအိဘူတာ (京成酒々井駅 ခဲဆဲ ရှိဆုအိ- အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ ချိဘခရိုင်၊ ရှိဆုအိမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။" },
        { "cell": "iteration", "text": "ကလေးငြိမ်းချမ်းရေးအမှတ်တရရုပ်တုသည် ဗုံးပေါက်ကွဲမှုကြောင့် သေဆုံးသွားသည့် ကလေးငယ်များကို အမှတ်တရ ဖြစ်စေရန် ဆောက်လုပ်ထားသည့် ရုပ်တု ဖြစ်သည်။ ရုပ်တုသည် မိန်းကလေးတစ်ဦး လက်မောင်းကို ဖြန့်ကားထားပြီး သူမ၏ အပေါ်တွင် ခေါက်ထားသည့် ကြိုးကြာငှက်ရုပ် တည်ရှိနေသည့် ပုံစံ ဖြစ်သည်။ ရုပ်တုသည် ဆဒခိုဆဆခိ (佐々木禎子, Sasaki Sadako) ၏ ဖြစ်ရပ်မှန် ဇာတ်လမ်းပေါ်တွင် အခြေခံထားသည်။ ဆဒခိုဆဆခိ ကလေးငယ်မသည် ဗုံး၏ ရောင်ခြည်ဖြာထွက်မှုကြောင့် သေဆုံးခဲ့သည်။ သူမသည် ဂျပန်ပုံပြင်တစ်ခုကို တုံ့ပြန်ရန်အတွက် စက္ကူကြိုးကြာရုပ် ၁၀၀၀ ကျော်ကို ပြုလုပ်ခဲ့သည့်အတွက် လူအများ သိကြသည်။ ယခုအချိန်ကာလတွင် ကမ္ဘာတစ်ဝန်းရှိ လူများ (အထူးသဖြင့် ကလေးများ) သည် ကြိုးကြာရုပ်များကို ပြုလုပ်ကာ ရုပ်တုအနီးတွင် ထားရှိရန်အတွက် ဟီရိုရှီးမားသို့ ပေးပို့ကြသည်။ ရုပ်တု၏ အနီးတွင် ခေါက်ထားသည့် ကြိုးကြာငှက်ရုပ်များကို စုစည်းထားရှိသည်။" },
        { "cell": "iteration", "text": "စီတန်းလှည့်လည်ခြင်းကို သုံးညဆက်ပြုလုပ်ကြပြီး ၎င်းညများကို အစီအစဉ်အလိုက် \"ယောအိယောအိယောအိယာမ\" (宵々々山), \"ယောအိယောအိယာမ\"(宵々山), \"ယောအိယာမ\" (宵山) ဟူ၍ အသီးသီးခေါ်ဆိုကြသည်။ ထိုယောအိယာမ ညအချိန်များတွင် ကျိုတိုမြို့လည်ခေါင်ဧရိယာကို လမ်းလျှောက်သူများအတွက် သီးသန့်နေရာအဖြစ် သတ်မှတ်ထားရှိသည်။ ထို့အပြင် လမ်းများကိုလည်း မီးရောင်စုံများဖြင့် အလှဆင်ထားပြီး ယခိတိုရိ၊ တအိယခိ၊ တခိုယခိ၊ အိုခိုနိုမိယခိ, ဂျပန်သကြားလုံးများ စသည်တို့ကို ရောင်းချကြသည်။" },
        { "cell": "calendar", "text": "ရာသီဥတု ခြောက်သွေ့လာခြင်းကြောင့် မြောက်အမေရိကတိုက်ရှိ" },
        { "cell": "calendar", "text": "အာရှ၏ (ပထဝီ အနေအထားအရ ယူရေးစီယမ် ဥရောပ - အာရှ၏ ကျွန်းဆွယ်ဟု ခေါ်ဆိုနိုင်သော) ဥရောပနှင့် ထိစပ်နေသောအပိုင်းသည် ယူရယ်တောင်တန်းများ၊ ယူရယ်မြစ်၊ ကက်စပီယံပင်လယ်၊ ကော့ကေးဆပ်ပင်လယ်၊ ပင်လယ်နက်၊ အီဂျီယမ်ပင်လယ်၊ ဘော့(စ်)ပေါရပ်(စ်)ဒေသ နှင့် ဒါဒင်နယ်လီ ရေလက်ကြားတလျှောက် ဖြစ်သည်။ အာရှ၏ အာဖရိကနှင့် ထိစပ်မှုသည် မြေထဲပင်လယ်နှင့် ပင်လယ်နီကို ဆက်သွယ်ပေးသော စူးအက်တူးမြောင်းသာလျှင် ခြားသည်။ အာရှ၏အရှေ့မြောက် အစွန်တွင်ရှိသော ဆိုက်ဘေးရီးယားဆိုလျှင် မြောက်အမေရိကတိုက်နှင့် ဘာရင်းရေလက်ကြားသာ ခြားသည်။ အာရှတိုက်၏ တောင်ဘက်နယ်နမိတ်မှာ အေဒင်ပင်လယ်ကွေ့၊ အာရေဗီယမ်ပင်လယ် နှင့် ဘင်္ဂလားပင်လယ်အော်-အရှေ့ဘက်တွင် တောင်တရုတ်ပင်လယ်၊ အရှေ့တရုတ်ပင်လယ်၊ ပင်လယ်ဝါ၊ ဂျပန်ပင်လယ်၊ အော့ခို့(စ်ထ်)ပင်လယ်နှင့် ဘာရင်း ပင်လယ်- မြောက်ဘက်နယ်နမိတ်မှာ အာတိတ်သမုဒ္ဒရာတို့ ဖြစ်ကြသည်။" },
        { "cell": "calendar", "text": "ဌာနလည်း ဖြစ်လေသည်။ ကမ္ဘာပေါ်ရှိ တိုက်ကြီးခြောက်တိုက် ရှိသည့်အနက် အကြီးဆုံးသောတိုက်လည်းဖြစ်၏။ ဥရောပတိုက်နှင့် အာဖရိကတိုက် နှစ်တိုက်ပေါင်းထက်လည်း စတုရန်းမိုင် ၆ဝဝ,ဝဝဝ ခန့် ပိုနေသေး၍ အမေရိကတိုက် နှစ်တိုက်ပေါင်း ထက်လည်း စတုရန်းမိုင် ၆ဝဝ,ဝဝဝ ခန့် ပိုနေသေးသည်။" },
        { "cell": "calendar", "text": "ဥရောပတိုက်မြေပြင်နှင့် ဆက်စပ်လျက် ရှိ၏။ အရှေ့ဘက်တွင် အမေရိကတိုက် အလာစကာပြည်နယ်နှင့် ၃၆ မိုင်ခန့်ကျယ်သော ဗဲရင်းရေလက်ကြားဖြင့်သာ ခြားလျက်ရှိသည်။ အနောက်တောင်ထောင့်ရှိ အာဖရိကတိုက်နှင့်မူ ဆူးအက်တူးမြောင်းမဖောက်မီက ကုန်းချင်းစပ်လျက်ရှိသည်။ သို့ရာတွင် သုံးဘက်စလုံး၌ကား ရေများဝန်းရံလျက်ရှိ၏။ မြောက်ဘက်၌ အာတိတ်သမုဒ္ဒရာ၊ အရှေ့ဘက်၌ ကမ္ဘာပေါ်တွင်အကျယ်ဆုံးသော" },
        { "cell": "calendar", "text": "လမ်းပန်း အဆက်အသွယ် အလွန်ခက်ခဲ၏။ ၂ဝ ရာစုနှစ်အစက ဖောက်လုပ်ပြီးခဲ့သော ရုရှနိုင်ငံ မောစကို မြို့တော်မှ" },
        { "cell": "calendar", "text": "မြောက်အမေရိကတိုက်၊ ဥရောပတိုက်တို့နှင့် နှိုင်းစာလျှင်" },
        { "cell": "calendar", "text": "နှစ် နေခဲ့ရ ပြီးနောက် ၁၉၆၇ ခုနှစ် နိုဝင်ဘာလ ၃ဝ ရက်နေ့" },
        { "cell": "calendar", "text": "အဖြစ်မှ ၁၉၇၁ ခုနှစ် စက်တင်ဘာလ ၁ ရက်နေ့တွင် လုံးဝ" },
        { "cell": "sports-time", "text": "၁၉၆၀ ခုနှစ် ဗာဒီးဗီးယား မြေငလျင် (Valdivia earthquake) (Mw 9.5) (19:11 hrs UTC) ၊ ၁၉၆၄ ခုနှစ် အလက်စကား မြေငလျင် (Alaska earthquake) (Mw 9.2) နှင့် ၂၀၀၄ ခုနှစ် အိန္ဒိယသမုဒ္ဒရာ မြေငလင် (Indian Ocean earthquake)(Mw 9.2) (00:58:53 UTC) တို့သည် မကြာသေးမီက ဖြစ်ပွားခဲ့သည့် အင် အားပြင်းထန်သော ကြီးမားသည့်တွန်းကန်ခြင်း မြေငလျင် ဥပမာများ ဖြစ်ကြသည်။ ၎င်းတို့သည် သမုဒ္ဒရာကြီးများ တစ်ခုလုံးကို ကျော်ဖြတ်သွားနိုင်သည့် ဆူနာမီများ (teletsunamis (တယ်လီဆူနာမီများ) ဟု လူသိများကြသည်) ကို ဖြစ်ပွားစေသည်။ ဂျပန်နိုင်ငံတွင် ဖြစ်ပေါ်သော (Mw 4.2) ရှိ အင်အားနည်းသော မြေငလျင် များသည် ဆူနာမီများ (ဒေသ နှင့် နယ်မြေဆိုင်ရာ ဆူနာမီများဟု ခေါ်ကြသည်) ကို ဖြစ်ပွားစေပြီး ၎င်းတို့သည် အနီးအနားရှိ ကမ်းခြေတို့ကိုသာ မိနစ်အနည်းငယ်အတွင်း ဖျက်ဆီးပစ် နိုင်သည်။" },
        { "cell": "sports-time", "text": "ယူနိုက်တက် လေကြောင်းလိုင်း ခရီးစဉ်အမှတ် ၉၃ ပေါ်တွင်မူ လေယာဉ်ဦးခေါင်းခန်း အသံဖမ်းစက်မှ ပြန်လည် ကြားရသည့် အသံများအရ လေယာဉ်အမှုထမ်းများနှင့် ခရီးသည်များသည် ထိုနေ့ မနက်က အခြား ပြန်ပေးဆွဲခံရသော လေယာဉ်များ အဆောက်အဦးများ အတွင်းသို့ ထိုးဆင်း တိုက်ခိုက်ကြောင်း တယ်လီဖုန်းခေါ်ဆိုမှုများမှ သိရှိပြီးသည့်နောက်တွင် ပြန်ပေးသမားများထံမှ လေယာဉ်ကို ပြန်လည် ရရှိ ထိန်းချုပ်ရန် ကြိုးစားခဲ့ကြောင်း သိရှိရသည်။ ပြန်ပေးသမား တစ်ယောက်က သူတို့အနေနှင့် လေယာဉ် ထိန်းချုပ်မှုကို ခရီးသည်များထံသို့ ပြန်လည် လက်လွတ် ဆုံးရှုံးတော့မည်ကို သိရှိသည့် အခါတွင် လေယာဉ်ကို တစ်ပတ်လှိမ့်ရန် အမိန့်ပေးခဲ့ကြောင်း သိရသည်။ မကြာမီ အချိန်တွင် လေယာဉ်သည် ပင်ဆယ်ဗေးနီးယားပြည်နယ်၊ ဆမ်းမားဆက် ကောင်တီ၊ စတုန်းနီး ခရိ မြို့နယ် အတွင်းရှိ ရှန့်ခ်ဗေးလ် သို့ ဒေသစံတော်ချိန် မနက် ၁၀ နာရီ ၃ မိနစ် ၁၁ စက္ကန့် (၁၄:၀၃:၁၁ UTC) တွင် ပျက်ကြခဲ့သည်။" },
        { "cell": "sports-time", "text": "ဆလီနီအာကာသယာဉ်ကို ၂၀၀၇ခုနှစ်၊ စက်တင်လာလ ၁၄ရက်နေ့တွင် 01:31:01 UTC တွင် H-IIA (Model H2A2022) သယ်ယူပို့ဆောင်ရေးဒုံးပျံဖြင့် Tanegashima Space Center မှ---into a (perigee) / (apogee) geocentric parking orbit. The total launch mass was ." },
        { "cell": "sports-time", "text": "ဧပြီ ၂၀၁၅ နီပေါငလျင် (ဂေါ်ခါငလျင်) သည် ၂၀၁၅ ခုနှစ် ဧပြီ ၂၅ ရက် တနင်္ဂနွေနေ့ နီပေါစံတော်ချိန် ၁၁:၅၆ နာရီ (၆:၁၁:၂၆ UTC) တွင် လှုပ်ခတ်သွားခဲ့သော ပြင်းအား ၇.၈ M w ရှိ ငလျင် တစ်ခုဖြစ်သည်။ ငလျင်ဗဟိုချက်မှာ နီပေါနိုင်ငံ၊ လမ်ဂျန် ခရိုင် အရှေ့-အရှေ့တောင်ဘက် အကွာ၊ အနက် ကို ဗဟိုပြု၍ လှုပ်ခတ်သွားခြင်း ဖြစ်သည်။" },
        { "cell": "sports-time", "text": "ဧပြီ ၂၆ ရက် နီပေါစံတော်ချိန် ၁၂:၅၄:၀၈ နာရီတွင် လှုပ်ခတ်ခဲ့သော ပြင်းအား ၆.၇ ရှိ ငလျင်တစ်ခု အပါအဝင် နီပေါတစ်နိုင်ငံလုံးတွင် နောက်ဆက်တွဲငလျင်များ ၁၅ မိနစ်မှ ၂၀ မိနစ်အတွင်း ဆက်တိုက် လှုပ်ခတ်သွားခဲ့သည်။ ငလျင်ကြောင့် မြေပြိုကျမှုအန္တရာယ်နှင့် ကြုံတွေ့နိုင်ဖွယ်ရှိနေသည်။" },
        { "cell": "sports-time", "text": "ငလျင်သည် ၂၀၁၅ ခုနှစ် ဧပြီ ၂၅ ရက် နီပေါစံတော်ချိန် ၁၁:၅၆ နာရီ (၆:၁၁:၂၆ UTC) အချိန်တွင် နီပေါနိုင်ငံ လမ်ဂျန်ခရိုင် အရှေ့-အရှေ့တောင်ဘက် အကွာ၊ မြေအနက် ခန့်မှန်းခြေ ကို ဗဟိုပြု၍ ခန့်မှန်း စက္ကန့် နှစ်ဆယ်ကြာ လှုပ်ခတ်သွားခဲ့သည်။" },
        { "cell": "sports-time", "text": "Coordinated Universal Time (UTC)နှင့် ဖော်ပြသော အချိန်၏ နောက်တွင် \"Z\" ကို ကြားကွပ်လပ်မချန်ပဲ ပေါင်းထည့်နိုင်သည်။ \"Z\" သည် zero UTC offset ကို ကိုယ်စားပြုသော ဇုန်ညွှန်းအက္ခရာဖြစ်သည်။ \"09:30 UTC\" ကို \"09:30Z\" (သို့) \"0930Z\" အဖြစ် ဖော်ပြနိုင်သည်။ \"14:45:15 UTC\" ကိုလည်း \"14:45:15Z\" (ဝါ) \"144515Z\" အဖြစ် ဖော်ပြနိုင်သည်။" },
        { "cell": "sports-time", "text": "ISO 8601 တွင် ထိုအချိန်များကို 2016-04-28T00:16:28+01:00 ဟု ရေးသားလေ့ရှိသည်။" },
        { "cell": "version-dot", "text": "မြောက် အမေရိက တိုက်သည် ကမ္ဘာ ဂြိုဟ်၏ မြောက် ဗဟိုခြမ်းတွင် တည်ရှိသည်။ မြောက်ဘက်မှ အာတိတ် သမုဒ္ဒရာ၊ အရှေ့ဘက်မှ မြောက် အတ္တလန္တိတ် သမုဒ္ဒရာ၊တောင်ဘက်မှ ကာရစ်ဘီ ယံပင်လယ်နှင့် အနောက်ဘက်မှ မြောက် ပစိဖိတ် သမုဒ္ဒရာ တို့က ထိုတိုက်ကို ဝန်းရံထားသည်။ ဧရိယာအကျယ်အဝန်းမှာ ၂၄၅၀၀၀၀၀စတုရန်းကီလိုမီတာ သို့မဟုတ် ၉၅၄၀၀၀၀စတုရန်းမိုင်ဖြစ်ပြီး ကမ္ဘာ့မျက်မှာပြင်၏ ၄.၈ရာခိုင်နှုန်းကို လွှမ်းခြုံထားသည်။ ၂၀၀၂ ခုနှစ် ဇူလိုင်လ စာရင်းအရ လူဦးရေ ၅၁၄၆၀၀၀၀၀ ကျော်ရှိည်ဟု ခန့်မှန်းရသည်။ အာရှတိုက်နှင့်အာဖရိကတိုက်တို့ပြီးလျှင် မြေနေရာအကျယ်ဝန်းဆုံးတိုက်ဖြစ်သည်။ ထို့ပြင်အာရှတိုက်၊ အာဖရိကတိုက်နှင့် ဥရောပတိုက်တို့ပြီးလျှင် စတုတ္ထမြောက်လူဦးရေအများဆုံးတိုက်ဖြစ်သည်။" },
        { "cell": "version-dot", "text": "ခေတ်သစ် အာဖရိကအတွင် အဆိုးရွားဆုံးသော လက်နက်ကိုင်တိုက်ပွဲမှာ ဒုတိယကွန်ဂို စစ်ပွဲ ဖြစ်သည်။ ၂၀၀၈ ခုနှစ်သို့ ရောက်သောအခါတွင် ထိုစစ်ပွဲနှင့် နောက်ဆက်တွဲ အဖြစ်များကြောင့် လူပေါင်း ၅.၄သန်းမျှ သေဆုံးခဲ့ရသည်။ ၂၀၀၃ ခုနှစ်မှ စ၍ ဒါဖာတွင် စစ်ပွဲ ဖြစ်ပွားခဲ့ရပြီး လူသားချင်း စာနာမှု ဆိုင်ရာ ကပ်ဆိုက်မှု တစ်ခုပင် ဖြစ်သည်။ အေအိုင်ဒီအက်စ် ရောဂါသည်လည်း ကိုလိုနီခေတ်လွန် အာဖရိကတွင် အရေးပါသော ပြဿနာ တစ်ခုပင် ဖြစ်သည်။" },
        { "cell": "version-dot", "text": "ဒုတိယကမ္ဘာစစ် အပြီး ကိုလိုနီစနစ် ဖျက်သိမ်းခြင်း လှုပ်ရှားမှု မတိုင်ခင်က ဥရောပသားများကို အာဖရိက နေရာ အနှံ့အပြားတွင် တွေ့ရသည်။ ၁၉၆၀ ခုနှစ်များ နှင့် ၁၉၇၀ ခုနှစ်များ အတွင်း ကိုလိုနီစနစ် ဖျက်သိမ်းခြင်းကြောင့် ဥရောပ အနွယ်မှ ဆင်းသက်လာသော လူမျိုး အများစုမှာ အာဖရိကမှ အစုလိုက်အပြုံလိုက်ထွက်ခွာသွားခဲ့ပြီး အထူးသဖြင့် အယ်လ်ဂျီးရီးယားနိုင်ငံ၊ မော်ရိုကိုနိုင်ငံ (ပြင်သစ်ကိုလိုနီနေ ဥရောပသား ၁.၆သန်းကျော်) Kenya, Congo, ရိုဒီးရှားနိုင်ငံ၊ မိုဇမ်ဘစ်နိုင်ငံ နှင့် အင်ဂိုလာနိုင်ငံ တို့မှ ဖြစ်သည်။ ၁၉၇၇ ခုနှစ် အကုန်တွင် အာဖရိကတွင် နေထိုင်သော ပေါ်တူဂီလူမျိုး ၁ သန်းကျော် ပေါ်တူဂီသို့ ပြန်ခဲ့ကြသည်။ သို့သော်လည်း လူဖြူအာဖရိကများမှာ အာဖရိနိုင်ငံ အများအပြား အထူးသဖြင့် တောင်အာဖရိကနိုင်ငံ၊ ဇင်ဘာဘွေနိုင်ငံ၊ နမီးဘီးယားနိုင်ငံ နှင့် ရေညွန်နိုင်ငံ တို့တွင် ထင်ရှားသော လူနည်းစု အဖြစ် ကျန်ရစ်ခဲ့သည်။ လူဖြူအာဖရိက အများဆုံးရှိသော နိုင်ငံမှာ တောင်အာဖရိကနိုင်ငံ ဖြစ်သည်။ ဒတ်ချ်အနွယ်ဝင် အာဖရိကန်နာများ၊ ဗြိတိသျှမှ ရွှေ့ပြောင်းဆင်းသက်လာသူများ နှင့် အဖြူသွေးနှောများမှာ အာဖရိကတွင် အများဆုံး ဥရောပ အနွယ်ဝင်များ ဖြစ်သည်။" },
        { "cell": "version-dot", "text": "၂၀၁၄ သန်းခေါင်စာရင်းအရ ပဲခူးတိုင်းဒေသကြီးတွင် လူဦးရေ ၄.၈သန်းရှိသည်။ တစ်နိုင်ငံလုံးတွင် လူဦးရေ ဆဌမမြောက် အများဆုံးနေရာတွင်ရှိသည်။ အမျိုးသား ၂.၃သန်းနှင့် အမျိုးသမီး ၂.၅သန်းရှိသည်။ လူဦးရေသိပ်သည်းဆမှာ စတုရန်းတစ်ကီလိုမီတာလျှင် (၁၂၃.၅)ဦးရှိသည်။ ပဲခူးတိုင်းဒေသကြီးတွင် လူ(၁၀၀)လျှင် ၇၈ဦး ကျေးလက်တွင် နေထိုင်ကြသည်။" },
        { "cell": "version-dot", "text": "၂၀၁၄ သန်းခေါင်စာရင်းအရ ချင်းပြည်နယ်တွင် လူဦးရေ ၄.၇သိန်း နေထိုင်သည်။ ကယားပြည်နယ်ပြီးလျှင် ဒုတိယမြောက် လူဦးရေ အနည်းဆုံးပြည်နယ်ဖြစ်သည်။ တစ်စတုရန်းကီလိုမီတာတွင် လူဦးရေ (၁၃.၃)ဦးဖြစ်သည်။ လူ (၁၀၀)လျှင် (၇၉)ဦးမှာ ကျေးလက်တွင် နေထိုင်သည်။" },
        { "cell": "version-dot", "text": "၂၀၁၄ သန်းခေါင်စာရင်းအရ ရခိုင်ပြည်နယ်တွင် လူဦးရေ ၃.၁သန်း နေထိုင်ကြသည်။ ရခိုင်ပြည်နယ်တွင် မဦးရေသည် ကျားဦးရေထက် အနည်းငယ် ပိုများသည်။ လူဦးရေသိပ်သည်းဆမှာ တစ်စတုရန်းကီလိုမီတာတွင် ၈၆.၇ဦးဖြစ်သည်။ ရခိုင်ပြည်နယ်တွင် လူ၁၀၀လျှင် ၈၃ဦးသည် ကျေးလက်တွင် နေထိုင်ကြသည်။" },
        { "cell": "version-dot", "text": "၂၀၁၄ သန်းခေါင်စာရင်းအရ ကရင်ပြည်နယ်တွင် လူဦးရေ ၃.၅သန်း နေထိုင်ကြသည်။ ကရင်ပြည်နယ်တွင် မဦးရေသည် ကျားဦးရေထက် အနည်းငယ် ပိုများသည်။ လူဦးရေသိပ်သည်းဆမှာ တစ်စတုရန်းကီလိုမီတာတွင် ၅၁.၈ဦးဖြစ်သည်။" },
        { "cell": "version-dot", "text": "၂၀၁၄ သန်းခေါင်စာရင်းအရ မကွေးတိုင်းဒေသကြီးတွင် လူဦးရေ ၃.၉သန်း နေထိုင်ကြသည်။ မကွေးတိုင်းတွင် မဦးရေသည် ကျားဦးရေထက် အနည်းငယ် ပိုများသည်။ လူဦးရေသိပ်သည်းဆမှာ တစ်စတုရန်းကီလိုမီတာတွင် ၇၆ ဦး ဖြစ်သည်။ မကွေးတိုင်းတွင် လူ ၁၀၀လျှင် ၈၅ ဦးသည် ကျေးလက်တွင် နေထိုင်ကြသည်။" },
        { "cell": "quote-letter", "text": "အစ္စလာမ်ဘာသာမှာ ခရစ်ယာန်ဘာသာထက် စော၍ မြန်မာနိုင်ငံသို့ ရောက်ရှိသည်ဟု ဆိုနိုင်သည်။ ပုဂံကျောက်စာအချို့တွင် 'ပန်သေး'၊ 'ပသည်' ဟု ရေးသားထားသဖြင့် ပုဂံခေတ်ကပင် အစ္စလာမ်ဘာသာဝင်များ ရှိလိမ့်မည်ဟု ဆိုနိုင်လေသည်။ ကုန်းဘောင်ခေတ် ရောက်သောအခါ မွတ်စလင်အများအပြား ရှိနေလေပြီ။ မဏိပူရမှလာသော မွတ်စလင်များကို 'ကသည်းမွတ်စလင်' ဟု ခေါ်ပြီး မြန်မာမွတ်စလင်များကို 'ဇေရ်ဘာဒီ' ဟု ခေါ်လေ့ရှိသည်။ စစ်မှုရေးရာနှင့် ကုန်သွယ်မှုတွင် ထူးချွန်သူများ ဖြစ်၏။ ကသည်းမြင်းအစုသည် လွန်စွာထင်ရှားသော မြင်းမှုထမ်းများ ဖြစ်လေသည်။ အလောင်းမင်းတရားလက်ထက်မှစ၍ မွတ်စလင်များ တိုးတက်လာရာ ဘိုးတော်ဘုရားလက်ထက်တွင် မွတ်စလင်စစ်မှုထမ်းများကို ညောင်ရမ်း၊ မိတ္ထီလာ၊ ရမည်းသင်း၊ ပင်းတလဲ၊ တဘက်ဆွဲ၊ မြေဒူး၊ ဒီပဲယင်း စသော ဒေသများ၌ နေမြေ၊ စားမြေပေးသည့်အပြင် အခွန်လွတ်ခွင့်လည်း ပေးခဲ့၏။ မွတ်စလင်တို့၏ ကုလားပျိုသေနတ်အစုမှာ ထင်ရှား၍ ဘုရင်၏ ယုံကြည်မှုခံယူရသူများဖြစ်သောကြောင့် နန်းတော်စောင့်တပ်၊ ကိုယ်ရံတော်တပ်များအဖြစ် အမှုထမ်းခဲ့ကြရ၏။ ၎င်းတို့အတွက် ဗလီဆောက်လုပ်ရာတွင် ဘုရင်ကိုယ်တိုင် ရွှေပန္နက်စိုက်ပေးခဲ့ကြောင်း သိရပေသည်။ ဘိုးတော်ဘုရားလက်ထက်တွင် အိန္ဒိယသို့ သတင်းထောက်လှမ်းရန် စေလွှတ်ခံရသူများမှာလည်း မွတ်စလင်များပင် ဖြစ်ကြပြီး အထင်ရှားဆုံးမှာ ဦးရွှေတုတ် ဖြစ်၏။" },
        { "cell": "quote-letter", "text": "အဆင့်အတန်းအမြင့်ဆုံး ပင်မပန်းချီပညာရပ်မှာ ဆေးရေးပန်းချီ ဖြစ်သည်။ ၎င်းပညာသည် ကမ္ဘာသုံးပန်းချီပညာဖြစ်ပြီး ပုဂံခေတ်မှစ၍ အဆင့်အတန်းမြင့်ခဲ့လေသည်။ မြန်မာ့ဆေးရေးပန်းချီသည် 'ကနုတ်' (ကြာခွေ၊ ကြာလိပ်၊ ကြာရိုး၊ ကြာစွယ်၊ ကြာရွက်၊ ကြာဖူး စသည်တို့ပုံကို အခွေအလိပ်များအဖြစ် ရေးဆွဲခြင်းဖြစ်ပြီး ခြူးပန်းခြူးနွယ်ဟူ၍လည်း သိရှိကြ၏။)၊ 'နရီ' (မိန်းမရုပ် ရေးဆွဲခြင်းကို ဆိုလိုသော်လည်း နောက်ပိုင်းတွင် လူရုပ်အမျိုးမျိုး ရေးဆွဲခြင်း ပါဝင်လာ၏။)၊ 'ကပီ' (မျောက်ရုပ်ဟု အဓိပ္ပာယ်ရှိသော်လည်း ဘီလူး၊ ဂဠုန်၊ နဂါး စသော အရုပ်များကို ကနုတ်ပန်းများနှင့် ရောနှောရေးဆွဲခြင်း ဖြစ်သည်။)၊ 'ဂဇာ' (ဆင်၊ မြင်းစသော တိရစ္ဆာန်များကို ကနုတ်ပန်းစသော အဆင်တန်ဆာမပါဘဲ ရိုးရိုးရေးဆွဲခြင်း ဖြစ်သည်။) ဟူ၍ အခွဲများရှိသည်။" },
        { "cell": "quote-letter", "text": "ခရစ်ဝင်ကျမ်းများတွင် ဤဆုတောင်းချက်၏ ပုံစံနှစ်မျိုးကို မှတ်တမ်းတင်ထားသည်- တစ်ခုမှာ မဿဲခရစ်ဝင်ကျမ်းရှိ တောင်ပေါ်ဒေသနာတော်၌ ပိုရှည်သောပုံစံဖြစ်ပြီး၊ နောက်တစ်ခုမှာ လုကာခရစ်ဝင်ကျမ်းတွင် \"တပည့်တော်တစ်ပါးက 'သခင်၊ ယောဟန်သည် မိမိတပည့်တော်တို့အား ဆုတောင်းရန် သွန်သင်ခဲ့သကဲ့သို့ အကျွန်ုပ်တို့အားလည်း ဆုတောင်းရန် သွန်သင်တော်မူပါ' ဟု ကိုယ်တော်အား လျှောက်သောအခါ\" ပါရှိသည့် ပိုတိုသောပုံစံ ဖြစ်သည်။" },
        { "cell": "quote-letter", "text": "အမေရိကန် ပြည်ထောင်စုတွင် တရားဥပဒေစိုးမိုးရေးကို ဒေသခံ ရဲအဖွဲ့များနှင့် မြို့ဝန်ဌာန (sheriff's departments) မှ ဆောင်ရွက်သည်။ ပြည်နယ်ရဲ အဖွဲ့မှာ ပိုမိုကျယ်ပြန့်သော လုပ်ငန်းဆောင်တာများကို ဆောက်ရွက်ကြသည်။ အက်ဖ်ဘီအိုင် နှင့် ယူအက်စ် မာရှယ် ဆားဗစ် ကဲ့သို့သော ဖက်ဒရယ် အေဂျင်စီများမှာ ပိုမို အထူးပြုသော တာဝန်များကို ထမ်းဆောင်ကြသည်။ ဖက်ဒရယ် အဆင့်နှင့် ပြည်နယ်များတွင် တရားရေးဌာနများသည် သာတူညီမျှ တရားစီရင်ရေး စနစ်ကို ကျင့်သုံးကြသည်။ ပြည်နယ် တရားရုံးများမှ ရာဇဝတ်မှု အများစုကို စီရင်လေ့ ရှိပြီး ဖက်ဒရယ် တရားရုံးများမှ အချို့သော အမှုအခင်း အမျိုးအစားများကို ကိုင်တွယ်ဆောင်ရွက်လေ့ ရှိသည့်အပြင် ပြည်နယ် တရားရုံးများမှ တက်လာသော အချို့သော အယူခံဝင်မှုများကို ဆောင်ရွက်ကြသည်။ မူးယစ်ဆေးဝါးကို ဖက်ဒရယ် ဥပဒေအရ တားဆီးထားသော်လည်း အချို့သော ပြည်နယ်များသည် မူးယစ်ဆေးဝါးကို တရားဝင် သုံးစွဲခွင့်ပြုသော ဥပဒေများကို ဖက်ဒရယ်စနစ်နှင့် ဆန့်ကျင်၍ ပြဋ္ဌာန်းရန် ကြိုးပမ်းလေ့ ရှိသည်။ ဆေးလိပ်သောက်နိုင်သည့် အသက် ကန့်သတ်ချက်မှာ ၁၈ နှစ်ဖြစ်ပြီး အရက်သောက်နိုင်သည့် အသက်ကန့်သတ်ချက်မှာ ၂၁ နှစ် ဖြစ်သည်။" },
        { "cell": "quote-letter", "text": "ဗုဒ္ဓဘာသာသည် ကိုးကွယ်ရာဘာသာတရား လည်းကောင်း၊ သင်ယူလိုက်နာကျင့်ကြံရာ 'ဓမ္မ' လည်းကောင်း ဖြစ်သည်။ ဗုဒ္ဓဟောကြားခဲ့သော အယူဝါဒများ ဖြစ်၍ 'ဗုဒ္ဓဝါဒ' ဟူ၍လည်းကောင်း၊ ဗုဒ္ဓ၏သင်ကြားမှုများဟု အဓိပ္ပာယ်ရသော 'ဗုဒ္ဓသာသနာ' ဟူ၍လည်းကောင်း ခေါ်ဆိုကြသည်။ ဗုဒ္ဓဘာသာတွင် ဂေါတမ ဗုဒ္ဓ၏ သင်ကြားဆုံးမမှုများကို အခြေခံသည့် များစွာသော ရိုးရာဓလေ့ထုံးတမ်းများ၊ ယုံကြည်မှုများနှင့် ကိုးကွယ်မှုဆိုင်ရာများ ခြုံငုံပါဝင်သည်။ 'ဂေါတမ ဗုဒ္ဓ' အမည်တွင် 'ဂေါတမ' သည်မျိုးရိုးအမည် ဖြစ်၍ 'ဗုဒ္ဓ'သည် 'ဉာဏ်အလင်းပွင့်သူ (သစ္စာ လေးပါးကို သိမြင်သူ)' ဟု အဓိပ္ပာယ်ရသည်။ ဗုဒ္ဓဘာသာ ထုံးတမ်းယုံကြည်မှုအရ ဗုဒ္ဓသည် ဘီစီ ၆ ရာစုမှ ဘီစီ ၄ ရာစုအတွင်း အိန္ဒိယ တိုက်ငယ်၏ မြောက်ပိုင်းရှိ မာဂဓတိုင်းပြည်တွင် နေထိုင်သွားသည်ဟု သိရသည်။ ဗုဒ္ဓဘာသာဝင်များသည် ဗုဒ္ဓအား သစ္စာ လေးပါးကို ကိုယ်တိုင်ထိုးထွင်းသိမြင်သူ အဖြစ်လည်းကောင်း တန်ခိုးရှင်ဘုရား အဖြစ်လည်းကောင်း အဝိဇ္ဇာနှင့် တဏှာကို ပယ်သတ်ပြီး သံသရာဒုက္ခမှ လွတ်မြောက်ဖို့အတွက် လမ်းညွှန်ပြသပေးသည့် ဉာဏ်အလင်းပွင့်သူ ဆရာသခင် အဖြစ်လည်းကောင်း မှတ်ယူကြသည်။ ဗုဒ္ဓဘာသာဝင်များသည် သစ္စာ လေးပါးနှင့် ပဋိစ္စသမုပ္ပါဒ်ကို သိမြင်နားလည်ခြင်းအားဖြင့် ဤသို့ ဉာဏ်အလင်းပွင့်မှုကို ရရှိနိုင်သည်ဟု ယုံကြည်ကြသည်။" },
        { "cell": "quote-letter", "text": "အကယ်၍ မြန်မာတို့သာ ဗုဒ္ဓ၏အမြော်အမြင်တော်၊ ဆန္ဒတော်များကို တွေးခေါ်မြော်မြင် သုံးသပ်၍၊ ဗုဒ္ဓအလိုတော်ကျ၊ ဗုဒ္ဓ ဆန္ဒတော်ကျ၊ လမ်းညွှန်တော်မူချက်အရ အပြည့်အဝ ဦးစွာကျင့်သုံး၊ စွန့်ဦးတီထွင်နိုင်ခဲ့ကြမည်ဆိုလျှင် ဂရိတို့၏'ဒီမိုကရေစီ'ဟူသော စကားလုံး စကားရပ်မပေါ်မီပင် မြန်မာတို့၏ ဗုဒ္ဓစာပေ စကားလုံး'အပရိဟာနိယ'ကို ကမ္ဘာတွင် တွင်ကျယ်စွာအသုံးပြုကြပေလိမ့်မည်။ မည်သို့ပင်ဆိုစေကာမူ ဗုဒ္ဓ ၏ အပရိဟာနိယလမ်းစဉ် အမှန်တရားတို့သည် သက်တမ်းရှည် ဗုဒ္ဓဘာသာဝင် မြန်မာနိုင်ငံတော်နှင့် ယခင်ကတည်းက ရင်းနှီးကျွမ်းဝင်ခဲ့သည့် စနစ်တစ်ခုပင်ဖြစ်သည်ကိုမူ ငြင်းပယ်၍ရလိမ့်မည်မဟုတ်ချေ။ (မြတ်ဗုဒ္ဓ၏အပရိဟာနိယဒီမိုကရေစီ၊ ယောအတွင်းဝန်ဦးဘိုးလှိုင်၏ ရာဇဓမ္မသင်္ဂဟကျမ်းနှင့် ဗုဒ္ဓ၏အပရိဟာနိယသုတ္တန်တို့လည်း ကြည့်။)" },
        { "cell": "quote-letter", "text": "၄။ ဧဟိပဿိက ဂုဏ်တော် 'လာပါ၊ ကျင့်စမ်းပါ'ဟု ရဲရဲဝံဝံ ဖိတ်ခေါ်ထိုက်ခြင်း၊ အစမ်းသပ်ခံနိုင်ခြင်းဂုဏ်။" },
        { "cell": "quote-letter", "text": "သစ္စာလေးပါး မဂ္ဂင် ၈ ပါး The Four Noble Truths: the essence of Buddha's teaching" },
        { "cell": "scaled-currency", "text": "စားစရိတ်နှင့် ဟိုတယ်စရိတ်မှာလည်း သိပ်ပြီးဈေးမကြီးလှ။ Old Market မှာပိုးပုဝါနှင့် ငွေထည်များဈေးသက်သာစွာ ဝယ်ယူနိုင်သည်။ ပိုးပုဝါတစ်ထည်လျှင် US$ 2 သို့မဟုတ် $3 ခန့်သာ ပေးရသည်။ ငွေထည်များမှာ ဈေးသက်သာသော်လည်း အရည်အသွေး သိပ်မကောင်းပေ။" },
        { "cell": "scaled-currency", "text": "လျောင်းနင်ပြည်နယ်သည် တရုတ်ပြည် အရှေ့မြောက်ပိုင်းတွင် စီးပွားရေး အင်အားအကြီးဆုံး ပြည်နယ် ဖြစ်သည်။ ၂၀၁၀ခုနှစ်တွင် ဂျီဒီပီ ၁.၈၃ ထရီလီယံ ယွမ် (US$ ၂၇၀ ဘီလီယံ ခန့်) ရှိသည်။ တရုတ်တစ်ပြည်လုံးတွင် ဂျီဒီပီ အဆင့်(၇) ရှိသည်။ လူတစ်ဦးချင်းအလိုက် ဂျီဒီပီမှာ ၄၁,၇၈၂ ယွမ် (US$ ၆,၁၇၂) ဖြစ်သည်။ အရှေ့မြောက်ပိုင်း ပြည်နယ် ၃ခုထဲတွင် လျောင်းနင်ပြည်နယ်သည် ဂျီဒီပီ အများဆုံး ဖြစ်သည်။" },
        { "cell": "scaled-currency", "text": "၁၉၈၉ ခုနှစ်မှစ၍ ကွမ်တုန်းပြည်နယ်သည် တရုတ်တစ်ပြည်လုံးတွင် ဂျီဒီပီ အမြင့်ဆုံးသော ပြည်နယ် ဖြစ်လာသည်။ ကျန်းစူပြည်နယ်နှင့် ဆန်းတုန်းပြည်နယ်တို့မှာ ဒုတိယ နှင့် တတိယ အမြင့်ဆုံး ဖြစ်ကြသည်။ ၂၀၀၉ ခုနှစ်တွင် ကွမ်တုန်းပြည်နယ်၏ ဂျီဒီပီသည် ယွမ်ငွေ ၃,၉၀၈,၁၅၉ သန်း (US$ ၅၇၂,၁၂၁ သန်း) အထိရောက်ရှိခဲ့သည်။ ယင်းပမာဏမှာ အင်ဒိုနီးရှားနိုင်ငံ တစ်နိုင်လုံး သို့မဟုတ် တူရကီနိုင်ငံ တစ်နိုင်ငံလုံးစာ နှင့် ညီမျှသည်။ လူတစ်ဦးချင်းဂျီဒီပီအရမူ ကျန်းစူးပြည်နယ်နှင့် ကျဲ့ကျန်းပြည်နယ်တို့၏ နောက်မှ ကပ်လျက် တတိယလိုက်နေသည်။ ပြည်နယ်မြို့တော် ကွမ်ကျိုးမြို့တွင် ကန်တုန်ကုန်စည်ပြပွဲ (Canton Fair) ဟုခေါ်ဆိုသော တရုတ်ပြည်၏ အကြီးမားဆုံးသော ပို့ကုန်သွင်းကုန် ကုန်စည်ပြပွဲကြီးများကို ကျင်းပလေ့ရှိသည်။" },
        { "cell": "scaled-currency", "text": "စာချုပ်ပါ အပြင်းထန်ဆုံးနှင့် အငြင်းပွားဖွယ်ရာ ပြဋ္ဌာန်းချက်မှာ- \"မဟာမိတ်နှင့် ဆက်စပ်အစိုးရများ က အတည်ပြုပြီး ဂျာမနီနှင့် ၎င်း၏ မဟာမိတ်များသည် မဟာမိတ်နှင့် ဆက်စပ်အစိုးရများနှင့် ၎င်းတို့၏ နိုင်ငံသားများ လက်အောက်ခံ ဆုံးရှုံးနစ်နာမှုအားလုံးကို ဖြစ်ပေါ်စေသည့် ဂျာမနီနှင့် ၎င်း၏ မဟာမိတ်များ၏ တာဝန်ကို လက်ခံပါသည်။ ဂျာမနီနဲ့ သူ့မဟာမိတ်တွေရဲ့ ရန်စမှုတွေကြောင့် စစ်ပွဲရဲ့ အကျိုးဆက်ပါ။” အလားတူ ဆောင်းပါးများပါရှိသော ဗဟိုပါဝါအဖွဲ့ဝင်များသည် စာချုပ်များကို လက်မှတ်ရေးထိုးခဲ့ကြသည်။ ဤဆောင်းပါး၊ ပုဒ်မ ၂၃၁ ကို War Guilt clause ဟုလူသိများသည်။ အဆိုပါစာချုပ်တွင် ဂျာမနီအား လက်နက်ဖြုတ်သိမ်းရန်၊ ကျယ်ပြန့်သော နယ်မြေလိုက်လျောမှုများ ပြုလုပ်ရန်နှင့် Entente ပါဝါများကို ဖွဲ့စည်းထားသည့် နိုင်ငံအချို့အား လျော်ကြေးငွေများ ပေးဆောင်ရန် လိုအပ်သည်။ 1921 ခုနှစ်တွင် အဆိုပါ လျော်ကြေးငွေ၏ စုစုပေါင်းကုန်ကျစရိတ်ကို ရွှေတံဆိပ် 132 ဘီလီယံ (ထို့နောက် $31.4 ဘီလီယံ သို့မဟုတ် £6.6 ဘီလီယံ၊ အကြမ်းဖျင်းအားဖြင့် US$ 442 ဘီလီယံ သို့မဟုတ် UK £284 ဘီလီယံနှင့် 2023 ခုနှစ်တွင် ညီမျှသည်)။ သဘောတူညီချက်ကို ဖွဲ့စည်းတည်ဆောက်ပုံကြောင့် မဟာမိတ်အင်အားကြီးများက ဂျာမနီကို အမှတ် ၅၀ ဘီလီယံဖိုးသာ ပေးချေရန် ရည်ရွယ်ထားသည်။" },
        { "cell": "scaled-currency", "text": "ဤအာကာသစခန်းသည် ဆိုဗီယက်ပြည်ထောင်စု၏ အာကာသတွင် ကြာမြင့်စွာ လူစီးအာကာသယာဉ်စီမံကိန်း( manned spaceflight programme) effort to maintain a long-term research outpost in space, and, following the collapse of the USSR, was operated by the new Russian Federal Space Agency (RKA). As a result, the vast majority of the station's crew were Soviet or Russian; however, through international collaborations, including the Intercosmos, Euromir and Shuttle-Mir programmes, the station was made accessible to astronauts from North America, several European nations and Japan. The cost of the Mir programme was estimated by former RKA General Director Yuri Koptev in 2001 as $4.2 billion over its lifetime (including development, assembly and orbital operation). The station was serviced by Soyuz spacecraft, Progress spacecraft and U.S. space shuttles, and was visited by astronauts and cosmonauts from 12 different nations." },
        { "cell": "scaled-currency", "text": "ချန်းရှားသည် တရုတ်နိုင်ငံ၏ စီးပွားရေးထိပ်တန်းမြို့ကြီး ၂၀ တွင် တစ်ခုအပါအဝင်ဖြစ်သည်။ ၂၀၀၈ တွင် ချန်းရှား၏ ဂျီဒီပီမှာ ¥၃၀၀.၁ ဘီလျံ(US$၄၃ဘီလျံ)ရှိခဲ့ပြီး တစ်နှစ်ထက်တစ်နှစ်တိုးတက်မှုမှာ ၁၅.၁%ဖြစ်သည်။ Its per capita GDP was ¥45,765 (US$6,589). Its GDP grew at an average of 14% per year from 2001 to 2005, compared to the national average of 9% in the period. As of 2005, the service sector generated roughly around 49% Changsha's GDP, up 112% from 2001 figures, and it is expected to continue driving the city's economic growth. Leading to a disposable income for urban residents of 12,343 RMB annually. The manufacturing and construction sectors have grown relatively steadily, growing 116% during 2001-2005. The primary sector, including agriculture, forestry, animal husbandry, and fishery, has grown slightly over this same period. In addition, the consumer market has grown dramatically with income levels. With a minimum salary level of 600 RMB per month in comparison to Beijing 640 RMB or Shanghai at 750 RMB per month. Urban residents in 2005 had average income of about USD 1,500, 15% higher than national average, and up 10% from 2001 figures." },
        { "cell": "scaled-currency", "text": "၂၀၀၈ခုနှစ်တွင် နော့ရော့ပ်-ဂရူးမင် ရုပ်မြင်သံကြားအစိတ်အပိုင်းများထုတ်လုပ်သူ မိုက်ကယ်ဂျော်ဂင်ဆန်၊ အမျိုးသားဘူမိရုပ်သံလိုင်း( National Geographic Channel)တို့အား Ho 229 သည် ကမ္ဘာ့ပထမဆုံးကိုယ်ပျောက်ဗုံးကြဲတိုက်လေယာဉ်ဟုတ်မဟုတ်ဆန်းစစ်နိုင်မည့် ပစ္စည်းများထုတ်လုပ်ပေးရန်မှာယူခဲ့သည်။ နော့ရော့ပ်-ဂရူမင်ကုမ္ပဏီသည် V3 Northrop-Grumman built a full-size reproduction of the V3, incorporating a replica glue mixture in the nose section. After an expenditure of about US$ 250,000 and 2,500 man-hours, Northrop's Ho 229 reproduction was tested at the company's classified radar cross-section (RCS) test range at Tejon, California, where it was placed on a 15-meter (50 ft) articulating pole and exposed to electromagnetic energy sources from various angles, using the same three frequencies in the 20–50 MHz range used by the Chain Home in the mid-1940s." },
        { "cell": "scaled-currency", "text": "၂၀၂၁ ခုနှစ် စစ်အာဏာသိမ်းမှုအပြီးတွင် \"ကြားဖြတ် ဖမ်းယူစက်များ တပ်ဆင်ခြင်းကို နော်ဝေနှင့် နိုင်ငံတကာတွင် ပိတ်ဆို့ထားသည့် အတွက် တယ်လီနော အနေဖြင့် လက်ခံနိုင်စရာမရှိကြောင်း\" တယ်လီနောက ဆိုသည်။ In May 2021, Telenor was forced to write off USD$780 million ၂၀၂၁ ခုနှစ် ဇူလိုင်လ ၈ ရက်နေ့တွင် တယ်လီနောမြန်မာ၏ လုပ်ငန်းများကို လက်ဘနွန်အခြေစိုက် M1 အုပ်စုအား အမေရိကန်ဒေါ်လာ ၁၀၅ သန်းဖြင့် ရောင်းချကြောင်း တယ်လီနောက ကြေညာသည်။ အဆိုပါ ရောင်းချမှုကို ၂၀၂၂ ခုနှစ် မတ်လ ၁၈ ရက်နေ့တွင် မြန်မာအာဏာပိုင်များနှင့် မြန်မာရင်းနှီးမြှုပ်နှံမှုကော်မရှင်တို့က ခွင့်ပြုခဲ့သည်။ အစုရှယ်ယာများ လွှဲပြောင်းရောင်းချခြင်းကို ၂၀၂၂ ခုနှစ် မတ်လ ၂၅ ရက်နေ့တွင် ပြီးမြောက်ခဲ့ပြီး လုပ်ငန်းအား ပိုင်ရှင်သစ်ထံ လွှဲပြောင်းခဲ့သည်။" },
        { "cell": "ordinal-caps", "text": "မာတင်လူသာကင်း ဂျူနီယာ (Martin Luther King Jr) ( January 15,1929-April 4,1968) သည် အာဖရိကန်-အမေရိကန် သင်းအုပ်ဆရာ တစ်ယောက်ဖြစ်ပြီး အမေရိကန် လူ့အခွင့်ရေး လှုပ်ရှားသူများထဲတွင် တက်ကြွထင်ရှားသော သူတစ်ယောက်ဖြစ်သည်။ သူ၏ ထင်ရှားခဲ့သော ဂုဏ်ရည်မှာ အမေရိကန် လူ့အခွင့်အရေးကို ပိုမိုထိရောက်သော အဆင့်အဖြစ်သို့ ပို့ဆောင်ပေးနိုင် ခဲ့ခြင်းဖြစ်သည်။ မာတင်လူသာကင်းအား ယနေ့တိုင်ပင် လူ့အခွင့်အရေး သင်္ကေတ တစ်ခုအဖြစ် မကြာခဏ ရည်ညွှန်း ပြောဆိုလေ့ရှိကြသည်။" },
        { "cell": "ordinal-caps", "text": "မြန်မာအက္ခရာ စာလုံးများအတွက် သတ်မှတ်နေရာကို လည်း U+1000 မှ U+109F အထိ (၁၆၀) ကွက်ထိ တိုးချဲ့ကာ Table 240-Row 10: Myanmar ဟူ၍ သတ်မှတ်နိုင်ခဲ့ပြီး၊ မြန်မာစာကို Burmese အစား Myanmar ဟု ISO ဖော်ပြချက်များ ၌ သုံးစွဲရန်ကိုပါ သဘောတူခဲ့သည်။" },
        { "cell": "ordinal-caps", "text": "Actinium အား ယူရေနီယမ် သတ္ထုရိုင်းများ ထဲတွင် အနည်းငယ် တွေ့ရှိရသည်။ α- ray နှင့် β – ray များ ထုတ်လွှတ်ပြီး တည်ရှိမှု သက်တမ်းသည် ၂၁.၇၇၃ နှစ်ခန့် ရှိသည်။ Uranium သတ္ထုရိုင်း ၁ တန်တွင် actinium ၁၀ ဂရမ်ခန့် ပါဝင်သည်။ Actinium ကို Uranium သတ္ထုရိုင်းများ ထဲတွင် အနည်းငယ် တွေ့ရှိရသော်လည်း အဏုမြူ ဓာတ်ပေါင်းဖိုများတွင် 226-Ra ၏ နျူထရွန် ကွဲထွက်ခြင်းမှာ မီလီဂရမ် အနည်းငယ်မျှ ရှိသည် ဟုသာ ဖော်ပြကြသည်။ Actinium ၏ အိုင်ဆိုတုပ် တစ်ခုဖြစ်သော Ac-227 ကို သဘာဝတွင် အများအပြား တွေ့ရှိရသည်။ Ac-227 (သက်တမ်း ၂၁.၇၇၃ နှစ် )၊ Ac-225 (သက်တမ်း ၁၀ ရက်)၊ Ac-226 (၂၉.၃၇ နာရီ)၊ အစရှိသော အိုင်ဆိုတုပ်များ ကိုလည်း တွေ့ရှိရသည်။" },
        { "cell": "ordinal-caps", "text": "ရှဲ့ဖူကျိ (Xie Fuzhi) (谢富治): July 1952-August 1959" },
        { "cell": "ordinal-caps", "text": "ယန်းဟုန်ယန် (Yan Hongyan) (阎红彦): August 1959-January 1967" },
        { "cell": "ordinal-caps", "text": "ကျိုးရှင့် (Zhou Xing) (周兴): June 1971-October 1975" },
        { "cell": "ordinal-caps", "text": "ကျားချီယွင် (Jia Qiyun) (贾启允): October 1975-February 1977" },
        { "cell": "ordinal-caps", "text": "အန်းဖင်ရှင်း (An Pingsheng) (安平生): February 1977-July 1985" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "မည်သူမဆို ကြည့်ရှုပြင်ဆင်နိုင်သော အခမဲ့လွတ်လပ်စွယ်စုံကျမ်း ဖြစ်ပါသည်။",
        "၄။ ဂုဏ်ဝါပညာကြီးသူ၊ လူ့ဂုဏ်သိက္ခာ၊ လူ့တန်ဖိုးကြီးမားသူများကို မြေတောင်မြှောက် ဂုဏ်ပြုပူဇော်၍၊ အကြံပြုချက် အကြံပြုစကားများကို ကြားနာခံယူခြင်း။",
        "ဒီဇင်ဘာ ၁၁ – Samantha Steele၊ အမေရိကန် အားကစားပြိုင်ပွဲအစီအစဉ်ကြေညာသူ",
        "ဒိုမိန်းတွေဟာ ဒိုမိန်းအမည် မှတ်ပုံတင်လုပ်ငန်း တွေက အသုံးပြုသူတွေအတွက် ဝန်ဆောင်မှုပေးတဲ့ ကုန်ပစ္စည်း (Product) တစ်ခုလည်း ဖြစ်ပါတယ်။ ဒီလို ဒိုမိန်းအမည်မျိုးကိုတော့ မှတ်ပုံတင်ပြီး ဒိုမိန်းအမည် (Registered domain name) လို့ ခေါ်နိုင်ပါတယ်။",
        "ဆန်ဝိုင်အရက်သည် လူကြိုက်များသော အရက်တစ်မျိုးဖြစ်သည်။ ၎င်း၏ ကွာလတီမှာ ကျယ်ပြန့်စွာ ကွဲပြားပြီး အမြဲဆိုသလို သစ်သီးများ သို့မဟုတ် ဆေးဘက်ဝင် သစ်မြစ်များဖြင့် ရောစပ် ထုတ်လုပ်လေ့ ရှိသည်။ ဆွမ်ဘိုင်း အရက်ကဲ့သို့ သစ်သီး သို့မဟုတ် ဟင်းခပ်အမွှေးအကြိုင်များကို ရေစိမ်၍ ထုတ်လုပ်သည့် အခါတွင် \"ဆရာ ထရမ်\" (ရေစိမ်ဝိုင်) ဟို ခေါ်ကြပြီး ဆန်ဝိုင်အရက်နှင့် နှိုင်းယှဉ်လျှင် ပိုမို၍ အဝင်ချောသောကြောင့် ကမ္ဘာလှည့်ခရီးသွားလုပ်ငန်း ဖွံ့ဖြိုးလာသည်နှင့် အမျှ ပို၍ ရေပန်းစားလာခဲ့သည်။",
        "သမ္ပယုတ္တပစ္စယော- တသားတည်း ယှဉ်ဘက်ဖြစ်၍ ကျေးဇူးပြုတတ်သော တရား",
        "67. Besylate, Amlodipine သွေးတိုးဆေး၊ နှလုံးသွေးကြောကျဉ်းရောဂါဆေး၊ 2.5-5-10 mg daily",
        "သို့သော်လည်း ဘာသာရေးတွင် ပါဝင်ပတ်သက်မှုမှာ မြင့်မားပြီး အထူးသဖြင့် ပွဲတော်များနှင့် နှင့် နှစ်သစ်ကူး ပထမဆုံး ဘုရားကျောင်းသို့ သွားခြင်း စသော အခါကြီးများတွင် ဖြစ်သည်။ တရုတ်နိုင်ငံမှာ တာအိုဘာသာ နှင့် ကွန်ဖြူးရှပ် ဘာသာတို့မှာလည်း ဂျပန်တို့၏ ယုံကြည်မှုနှင့် ထုံးတမ်းစဉ်လာများကို လွှမ်းမိုးမှု ရှိသည်။ ဂျပန်နိုင်ငံ ရှိ လမ်းများမှာ တာနာဘာတာ (ကြယ်ပွဲတော်)၊ အိုဘွန် (သင်္ချိုင်းကန်တော့ပွဲ) နှင့် ခရစ်စမတ်တို့တွင် အလှဆင်ထားလေ့ ရှိသည်။ ဂျပန်လူဦးရေ၏ ၁ ရာခိုင်နှုန်း အောက်မှာသာ ခရစ်ယာန် ဘာသာ ကိုးကွယ်ကြသည်။အစ္စလာမ်ဘာသာကိုကိုးကွယ်သူများလည်းရှိသည်။ ျပန်နိုင်ငံရှိအစ္စလာမ်ဘာသာဝင်လူဦးရေ၏၉၀ရာခိုင်နှုန်းမှာပါကစ္စတန်၊အင်ဒိုနီရှားအစရှိသည့်မွတ်ဆလင်နိုင်ငံများမှလာရောက်အလုပ်လုပ်ကိုင်ကြသည့်ပြောင်းရွှေ့လုပ်သားများဖြစ်ပြီးကျန်၁၀ရာခိုင်နှုန်းမှာဂျပန်နိုင်ငံသားများဖြစ်သည်။အစ္စလာမ်ဘာသာအားကိုးကွယ်သူ၂၀၀၀၀၀ရှိသည်။အစ္စလာမ်ဘာသာကိုဂျပန်နိုင်ငံလူဦးရေ၏၀ဒဿမ၁ရာခိုင်နှုန်းကိုးကွယ်ကြသည် ထို့အပြင်ဟိန္ဒူဘာသာဝင်၊ ဆစ်ခ်ဘာသာဝင်နှင့် ဂျူးဘာသာဝင် အနည်းငယ်မျှလည်း ရှိသည်။",
        "အလောင်းတော် ကဿပသည် မုံရွာခရိုင်၊ ယင်းမာပင်မြို့နယ်မှ ပုံတောင်၊ ပုံညာနှင့် မဟူရာတောင် သုံးလုံးဆုံရာရှိ ပိတ်နေသော အုတ်ဂူတွင် အရှင်မဟာကဿပ၏ ရုပ်ကလာပ် အလောင်းတော်ရှိသည်ဟု အများယုံကြည်ကြသော နာမည်ကျော် ဘုရားဖူး၊ ခရီးသွားရာအရပ်ဖြစ်သည်။ အမှန်တကယ် မည်သည့် အလောင်းတော်ဖြစ်သည်နှင့် တည်နေရာ ရှင်းလင်းချက်တွင်မူ မူကွဲများရှိသည်။",
        "ခန္ဒာက်စစ်ပွဲဖြစ်ပွားခဲ့၏။ ယင်းစစ်ပွဲများ ဖြစ်ပွားရာ ဌာန",
        "၄။ မမည်း မဖြူသော ကံ, မမည်းမဖြူအကျိုးရှိသော ကံ။",
        "၃။ သက္ကရာဇ် ၁၁၉၉ (အေဒီ၁၈၃၇) ခုနှစ် ရွှေဘိုမင်းလက်ထက်ကတည်းက ရှိခဲ့တဲ့ ရတီချိန်လေးဆယ်ကျော် လှော်ကားတင်ကြီး ဟုခေါ်သော ပတ္တမြား",
        "UNHRC ၏ အဖွဲ့ဝင် ၄၇ နေရာအား ကုလသမဂ္ဂ အထွေထွေညီလာခံမှ ရွေးချယ်သည်။ ကောင်စီဝင် သက်တမ်းမှာ ၃ နှစ်ဖြစ်ပြီး သက်တမ်းနှစ်ဆက်ထက်ပိုကာ မည်သည့်ကောင်စီဝင်မှ ထမ်းဆောင်ခွင့်မရှိပေ။ ကောင်စီဝင် ၄၇ နေရာတွင် ဒေသအလိုက် အာဖရိကအတွက် ၁၃ နေရာ၊ အာရှအတွက် ၁၃ နေရာ၊ အရှေ့ဥရောပအတွက် ၆ နေရာ၊ လက်တင်အမေရိကနှင့် ကယ်ရေဘီယံ ဒေသအတွက် ၈ နေရာ၊ အနောက်ဥရောပနှင့် အခြားအုပ်စုများအတွက် ၇ နေရာ အသီးသီး ခွဲဝေထားသည်။",
        "၁၉၄၄-ခုနှစ်တွင် ပဲရော့ရုပ်ရှင် ကုမ္ပဏီမှ ဒါရိုက်တာ ဖေကြိုင်က သတ္တိ ဗျတ္တိ အမည်ရှိ ရုပ်ရှင်ဇာတ်ကားရိုက်ကူးရန် စီစဉ်သည်။ ခေါင်းဆောင်မင်းသားအဖြစ် ရွေးချယ်ထားသူမှာ မင်းသားကျော်ရွှေ (နောင် ကျော်ဆွေဟုအမည် ပြောင်းလဲခဲ့သူ) ဖြစ်သည်။ ဇာတ်လမ်းအရ မင်းသား ကျော်ရွှေသည် မော်တော်ဆိုင်ကယ် စီးကာ စော်ဘွားကြီးကုန်း တောင်ကုန်းပေါ်မှ ခုန်ချရမည့် အခန်းပါရှိသည်။ ဒါရိုက်တာဖေကြိုင်က ဤအခန်းကို လူစားမထိုးဘဲ မင်းသားကျော်ရွှေ ကိုယ်တိုင် သရုပ်ဆောင်ရန် ပြောဆိုသည်။ သို့သော် ကျော်ရွှေက ငြင်းပယ်သည်။ သူ့အနေဖြင့် လူစားထိုး ရိုက်ကူးရန်သာ ဆန္ဒရှိခဲ့သည်။",
        "ကိလေသာ ဟူသည် ရယူလက်ခံထားသူရဲ့ စိတ်နှလုံးကို ပူလောင်ဆင်းရဲအောင် နှိပ်စက်တတ်သည့် တရားများပင် ဖြစ်သည်။ ထိုကိလေသာရှိနေသမျှ သံသရာတွင်းမှ မလွတ်ဘဲ တဝဲလည်လည် ကျင်လည်ပြီး သေပြီးရင်းသေ နေရဦးမည်ဖြစ်သဖြင့် ကိလေသာ ကိုလည်း သတ်တတ်သည့် မာရ် ဟုပင်ခေါ်သည်။ ကိလေသာ အကျဉ်း(၁၀)ပါး ရှိသည်။",
        "အမှတ်(၃)လေကြောင်းရန်ကာကွယ်ရေး စစ်ဆင်ရေးကွပ်ကဲမှုဌာနချုပ် - လွိုင်လင်",
        "အလွန်အရေးကြီး၏။ အဘယ်ကြောင့်ဆိုသော် ဤပုံကိုကြည့်၍",
        "အခြားအခြားသော သစ်စေးများနှင့်မတူ ထူးခြားသော သစ်စေးတစ်မျိုးမှာ ပယင်းဖြစ်လေသည်။ ပယင်းသည် အပင်ကို ထွင်း၍၊ ထစ်၍၊ ခြစ်၍ရသော သစ်စေးမဟုတ်ပေ။ နှစ်ပေါင်း ထောင်နှင့်ချီ၍ ကြာမြင့်ခဲ့သောကာလက မြေလွှာအောက်တွင်",
        "၁၃၅ဝ ပြည့်နှစ် (၁၉၈၈ ခုနှစ်)၊ ပြည်သူ့ ဒီမိုကရေစီ အရေးတော်ပုံကြီး အပြီးတွင် အမျိုးသား ဒီမိုကရေစီ အဖွဲ့ချုပ်သို့ ဝင်ရောက်၍ ဗဟို အလုပ်အမှုဆောင် ကော်မတီဝင်၊ ဗဟို ဦးစီး အဖွဲ့ဝင်၊ မွန်ပြည်နယ် စည်းရုံးရေးမှူး တာဝန်တို့ ယူခဲ့သည်။",
        "အနောက်ကျွန်း၏ အကျယ်အဝန်းသည် ယူဇနာ (၇)ထောင် ရှိသည်။ အနောက်ကျွန်း၏ ပုံသဏ္ဌာန်သည် လပြည့်ဝန်းနှင့်",
        "လက်ရှိ ရထားပို့ဆောင်ရေး ဝန်ကြီးဌာနလက်အောက်တွင် အောက်ပါဌာန (၅)ဌာန ပါဝင် ဖွဲ့စည်းထားသည်။",
        "၁၉၄၈ခုနှစ် လွတ်လပ်ရေးရရှိပြီးချိန်တွင် တပ်မတော်၌ တောင်ပိုင်းနှင့် မြောက်ပိုင်းဟူ၍ တိုင်းစစ်ဌာနချုပ် ၂ခုသာရှိခဲ့သည်။ ထိုစဉ်က တောင်ပိုင်းတိုင်းမှူးမှာ ဗိုလ်မှူးချုပ် စောကြာဒိုးဖြစ်သည်။၁၉၄၈ခုနှစ် ၄လပိုင်းတွင် စစ်ဦးစီးချုပ်ရုံး (စစ်ရုံး)ကို စတင်ဖွဲ့စည်းခဲ့ပြီး ထိုအချိန်တွင် တောင်ပိုင်းတိုင်းမှူးမှာ ဗိုလ်မှူးချုပ် အောင်သင်းဖြစ်သည်။၁၉၄၉ခုနှစ် ရောင်စုံသူပုန်ထကြွချိန်တွင် တောင်ပိုင်းတိုင်းမှူးမှာ ဗိုလ်မှူးချုပ် ကျော်ဇောဖြစ်သည်။ ၁၉၅၃ ခုနှစ် ကူမင်တန်အရေးတွင် တောင်ပိုင်းမှ ဗိုလ်မှူးချုပ် ကျော်ဇောအား မြောက်ပိုင်းသို့ရွှေ့ကာ မြောက်ပိုင်းမှ ဗိုလ်မှူးချုပ် အေဒီဘလိတ်မှာ တောင်ပိုင်းရောက်လာခဲ့သည်။ ၁၉၅၉ ခုနှစ် အိမ်စောင့်အစိုးရဖွဲ့စည်းချိန်တွင် တောင်ပိုင်းတိုင်းမှူးမှာ ဗိုလ်မှူးချုပ်အောင်ရွှေဖြစ်သည်။ ၁၉၆၀ ရွေးကောက်ပွဲအပြီး ၁၉၆၁ ခုနှစ်တွင် ဗိုလ်မှူးချုပ် အောင်ရွှေကို ထုတ်ပယ်လိုက်ကာ ၎င်းနေရာတွင် ဗိုလ်မှူးချုပ် စိန်ဝင်းကို ခန့်ထားလိုက်သည်။",
        "ကာလာမတို့ သင်တို့အား ယုံမှားခြင်းငှာ သင့်ပေ၏၊ တွေးတောခြင်းငှာ သင့်ပေ၏၊ သင်တို့အား ယုံမှားခြင်းငှာသင့်သော အရာ၌ ယုံမှားခြင်း ဖြစ်၏။ ....” ဟု အစချီ၍ ဤကာလာမသုတ်ကို ဟောကြားတော်မူ၏။ ကေသမုတ္တနိဂုံး၌ ဟောကြားတော်မူသောကြောင့် ကေသမုတ္တိသုတ် ဟူ၍လည်း အမည်တွင်၏။",
        "လွယ်ကူစွာဖြင့် ခွဲထုတ်ယူနိုင်လေသည်။ ထိုနည်းဖြင့် ဟီလီယမ်ဓာတ်ငွေ့ကို ယခင်ကထက်ဈေးပေါ၍ ရောင်းချ နိုင်ပေသည်။",
        "မြန်မာမှာတော့ ညကြီး ဉ ကလေးလို့ ခွဲသုံးတယ်။ ဗျည်း ၃၃-လုံးမှာ ညကြီးသုံးပြီး အသတ်မှာ ဉ သုံးတယ်လို့ ခွဲခြားမှတ်သားနိုင်ပါတယ်။",
        "အလုပ်ရုံပိုင် အရင်းရှင် လူတန်းစားဘဝသို့ ရောက်ရှိလာခဲ့ခြင်း",
        "ကွန်ရက်နည်းပညာများနည်းတူ နက်ရှိုင်းသော အစုံလိုက်သုံးpacket စစ်ဆေးခြင်း (နှင့် စစ်ထုတ်ခြင်း) သည် ပို၍ အဆင့်မြင့်သော ကွန်ရက် စီမံအုပ်ချုပ်မှု၊ အသုံးပြုသူ ဝန်ဆောင်မှု နှင့် လုံခြုံရေး လုပ်ဆောင်ချက်များ နှင့် အင်တာနက် အချက်အလက်တူးဖော်ခြင်း၊ ခိုးနားထောင်ခြင်း နှင့် ဆင်ဆာပြုလုပ်ခြင်းတို့ကို လုပ်ဆောင်နိုင်သည်။ DPI နည်းပညာကို အင်တာနက် စီမံအုပ်ချုပ်မှုအတွက် နှစ်ပေါင်းများစွာ တိုင်အောင် အသုံးပြုခဲ့ပြီးဖြစ်သော်လည်း ကွန်ရက် ကြားနာရေး ထောက်ခံသူအချို့သည် ထိုနည်းပညာမှာ ပြိုင်ဘက်ကင်းစွာ အသုံးပြုခံ ရနိုင်ခြင်း သို့မဟုတ် အင်တာနက်၏ လွတ်လပ်ခြင်းကို လျော့ချခြင်း တို့ကိုစိုးရိမ်ကြသည်။ လောလောဆယ်တွင် စီးပွားရေးလုပ်ငန်း၊ ဝန်ဆောင်မှုပေးသူများနှင့် အစိုးရများသည် DPI ကို နေရာအတော်များများတွင်ကျယ်ကျယ်ပြန့်ပြန့် အသုံးချနေကြသည်။",
        "စပိန်အခြေခံဥပဒေအရ ဒီမိုကရေစီစနစ်ကိုကူးပြောင်းခဲ့သည်။ အခြေခံဥပဒေဟာ ၁၈၁၂မှ အခြေခံဥပဒေကိုမှီငြမ်းထားခြင်းဖြစ်သည်။ ၁၉၇၆၌ ဘုရင်မင်းမြတ်ဂျွန်ကာလို့စ်မှ ဒေါလ်ဖှိုသွာရေဇ်အား ဝန်ကြီးချုပ်ခန့်အပ်ခဲ့သည်။ ဒီရလဒ်၏အကျိုးဆက်အနေဖြင့် ၁၉၇၇ အထွေ ထွေ ရွေးကောက်ပွဲမှ အခြေခံဥပဒေကောရ်တေသ်သဘောတူချက်အရ စပိန်လွှတ်တော်မှ ၁၉၇၈ အခြေခံဥပဒေကို မူကြမ်းနှင့်အတည်ပြုနိုင်ခဲ့သည်။ ၁၉၇၈ ဒီဇင်ဘာ ၆ရက်နေ့အမျိုးသားဆန္ဒခံယူပွဲပြီးသည့်နောက်ပိုင်းတွင် မဲပေးသူ ၁၉၇၈,၈၈%ဖြင့် အခြေခံဥပဒေသစ်ကိုအတည်ပြုနိုင်ခဲ့သည်။",
        "အပွင့်--မြေပေါ်သို့ ဥမှနေပြီး ၁-၂ ပေခန့် အထိ ရှိသော ရိုးတံ ထွက်လာ သည်။ ၎င်း ရိုးတံပေါ် တွင် အစက်အပြောက် များရှိသည်။ ပွင့်ကာရွက် အုပ်သည် အလွန်ကြီးမား ပြီး ကတော့ သို့မဟုတ် ခေါင်းလောင်း ပုံသဏ္ဌာန် ရှိသည်။ ၎င်း ပွင့်ကာရွက် အုပ်၏ အကျယ်မှာ ၁၁/၂ -၂ ပေ နီးပါး အထိ ရှိတတ်ပြီး အလျား ၁၅ လက်မခန့် ရှည်၍ အနား များ မှာ ပိန်းပင် ကဲ့သို့ ညီညာ ခြင်း မရှိဘဲ လှိုင်းထကာ တွန့်နေသည်။ ပွင့်ကာရွက် အုပ် တစ်ခုလုံး ၏ အနား တစ်ဝိုက် တွင် နီညိုရောင် ဖြစ်ပြီး အောက်ဘက်တွင် အဖြူစက်များ နှော သော မီးခိုးရောင် ဖြစ်လာကာ ကတော့ ပုံသဏ္ဌာန် အတွင်းထဲ၌ ခရမ်းရင့်ရောင် ဖြစ်သွား သည်။ အလွန် ပြင်းထန်သော အနံ့ ရှိသည်။ အပွင့်ကလေး များသည် အလွန်သေးငယ် ပြီး ၁၀-၁၂ လက်မ အရှည် ရှိသော ပွင့်ခိုင် ရိုးတံပေါ် တွင် စီတန်းလျက် ပွင့်ကြသည်။",
        "မည်သည့်နေရာသို့ ကျသွားသော်လည်း ပြန်ထတဲ့ လက္ခဏာ",
        "နိုင်ငံတော် တရားရုံးချုပ်မှလည်း မူသစ်စနစ်သစ်နှင့်",
        "၂၀၁၁ ခုနှစ်၊ ဧပြီလမှ စတင်ပြီး ဖေ့စ်ဘွတ်ခ် အသုံးပြုသူများအတွက် Facebook Chat မှ တစ်ဆင့် ကမ္ဘာတစ်ဝန်းရှိ အသုံးပြုသူ တစ်ဦးနှင့် တစ်ဦး အသံဖြင့်ခေါ်ဆိုမှုကို ပြုလုပ်နိုင်ပြီ ဖြစ်သည်။ အဆိုပါ စနစ်ကို T-Mobile ၏ စနစ်အသစ်တစ်ခု ဖြစ်သော Bobsled service မှ တစ်ဆင့် Facebook Chat တွင် အသံဖြင့် ပြောဆိုနိုင်ရုံမျှမက အသံကိုပါ နားထောင်နိုင်ရန်အတွက် အခမဲ့ ထောက်ပံ့ပေးထားသည်။",
        "တာဘီယမ် (Terbium)သည် Lanthanide အုပ်စုတွင် ပါဝင်သော ပျော့ပြောင်း ပုံသွင်းရလွယ်ကူပြီး ငွေရောင် ဖျော့ဖျော့ ရှိ သတ္တု တစ်မျိုးဖြစ်သည်။ ၎င်းသည် လေထုထဲတွင် တည်ငြိမ်စွာ တည်ရှိနေနိုင်သော်လည်း အောက်စီဂျင်နှင့် နှေးကွေးစွာ ဓာတ်ပြုပြီး ရေနှင့်လည်း ဓာတ်ပြုနိုင်သည်။၎င်းဒြဗ်စင်များကို ရှားပါးသော ဒြဗ်စင်များဟု ခေါ်ကြသော်လည်း၊ စင်စစ်အားဖြင့် အားလုံးရှားပါးကြသည် မဟုတ်ချေ။ အချို့ကို ခဲကဲ့သို့ ကမ္ဘာမြေလွှာတွင် အနှံ့အပြား တွေ့ရသည်။ ရှားပါးသော ဓာတ်မြေပါရှိသည့် တွင်းထွက် ပစ္စည်းများတွင် အခြားဒြဗ်စင်များအပြင် ရေဒီယမ်သတ္တုရှိသည့် သိုရီယမ်ကိုလည်း တွေ့ရသည်။",
        "ဆရာကြီး ဆာဝေါ်လတာစကော့သည် ယင်း ရှုမျှော်ခင်းများ",
        "ကျိုက်မှာ မွန်စကား ဖြစ်၍ ဘုရား သို့မဟုတ် နတ်ဟု အဓိပ္ပာယ်ရသည်။ မွန်လူမျိုးတို့သည် မိမိတို့ ကိုးကွယ်ရာ၊ အထွတ်အမြတ်ထားရာကို ဟု ရှေ့ကထည့်၍ သုံးကြသည်။ ကို မြန်မာတို့က ကျက်၊ ကျတ်၊ ကျိုက်၊ ကျောက် ဟု အသံပြောင်း၍ သုံးစွဲသည်။ အသရေစောင့်နတ်ကို ကျက်သရေ ဟူ၍ ကျက်အသံထွက်ဖြင့်၎င်း၊ 'ကျတ်ခေါက်၊ ကျတ်ပွန်၊ ကျတ်သလွန်၊ မွန်တို့ခေါ်ဝေါဟာ၊' 'သံလျင်မြို့ မြတ်၊ တောင်မတ်မတ်၊ ကျတ်ခေါက်ဘုရားရှင်၊' 'သီဒါရစ်ပတ်၊ ပင်လယ်ထွတ်၊ ကျတ်ခမီရှင်ပင်၊'ဟူ၍ ကဝိ လက္ခဏသတ်ပုံ တွင် စပ်ထုံးပြမှာကဲ့သို့ ကျတ်ခေါက်၊ ကျတ်ပွန်၊ ကျတ်သလွန်၊ ကျတ်ခမီစေတီတော်များတွင် ကျတ်အသံထွက်ဖြင့်၎င်း၊ ကျိုက်ထီးရိုး၊ ကျိုက္ကဆန်၊ ကျိုက္ကလို့၊ ကျိုက်သံလန် စသော စေတီများတွင် ကျိုက် အသံထွက်ဖြင့်၎င်း၊ ပြောဆိုနေကြသည်။ မြန်မာနိုင်ငံအောက်ပိုင်းတွင် ကျိုက်လတ်၊ ကျိုက်ပိ၊ ကျိုက်ထော်၊ ကျိုက်ထို၊ ကျိုက်မရော စသည်ဖြင့် ကျိုက်ပါ သော မြို့ရွာအမည်အများအပြား ရှိလေသည်။",
        "ဦးချိန် (လှေသင်းအတွင်းဝန် မဟာဇေယသင်္ခယာ) (ကောဇာ ၁၁၅၈-၁၂၁၇) သည် ရှေးမြန်မာမင်းမျာလက်ထက်က အရာထမ်းအဖြစ် တာဝန်ရွက်သူ ဖြစ်သည်။ ဒီပနီအမည်ခံ အကျယ်ဖွင့်ကျမ်းများကို ရေးသားခဲ့သော စာဆိုလည်း ဖြစ်၏။",
        "အတွင်း၌ အစာသွားလမ်းကို ဓာတ်မှန်ရိုက်၍ စစ်ဆေးကြည့်ရှု",
        "သည်။ သို့ရာတွင် ခိုင်လုံသော အထောက်အထားများကား မရှိ",
        "နေတိုးကိုယ်တိုင်ရေး \"စေ့ထားသော တံခါးများ\"အမည်ရှိ စာအုပ်ထွက်။",
        "လျှိုမြောင်ဆိုသည်မှာ ရော့ကီး၊ အဲ့လ်ပ်၊ ဟိမဝန္တာ သို့မဟုတ် အင်န်ဒီးစ် ကဲ့သို့သော တောင်တန်းများရှိ တောင်ထွတ်နှစ်ခုကြားရှိ အက်ကြောင်းကိုလည်း ရည်ညွှန်းနိုင်သည်။ များသောအားဖြင့် မြစ် သို့မဟုတ် ချောင်းတစ်ခုသည် တောင်များအကြား ထိုကဲ့သို့သော အက်ကြောင်းများကို တိုက်စားဖန်တီးလေ့ရှိသည်။ တောင်ပေါ်လျှိုမြောင် အမျိုးအစားများ၏ ထင်ရှားသော ဥပမာများမှာ ယူးတားပြည်နယ်ရှိ ပရိုဗို လျှိုမြောင် နှင့် ကယ်လီဖိုးနီးယားပြည်နယ် ဆီယာရာ နီဗားဒါးရှိ ယိုဆဲမိုက် တောင်ကြားတို့ ဖြစ်ကြသည်။",
        "တိုက် ဆရာ‌တော်ဦးဝိုင်း၊ ဦးနာရဒနှင့် စာချဆရာ‌တော်များထံ တွင် ကစ္စည်းသဒ္ဒါကြီး အဘိဓမ္မတ္ထသဂင်္ဟ၊ ရူပသိဒ္ဓိ၊ ကစ္စာယန သာရ၊ ပုဒ်စစ်စ‌သော ကျမ်းဂန်များကိုလည်း‌ကောင်း၊ အမရပူရ မြို့ မင်္ဂလာတိုက်ဆရာ‌တော် ဦးဝိမလထံတွင် မာတိကာဓာတု ကထာယမိုက်၊ ပဋ္ဌာန်း၊ ဋီကာ‌ကျော်ကျမ်းများကိုလည်း‌ကောင်း၊ စစ်ကိုင်းမြို့ စကု‌မော်‌ကျောင်း တိုက် ဆရာ‌တော်နှင့် စစ်ကိုင်း",
        "ဥရောပဒီမိုကရေစီတွင် သတင်းမီဒီယာလုပ်ငန်းကို လွတ်လပ် စွာလုပ်ပိုင်ခွင့်အတွက် အကာအကွယ်ပေးရန်ဥပဒေများ ပြဋ္ဌာန်းပေး ထားသည်။ ဥပမာ ရုရှားဖွဲ့စည်းပုံ အခြေခံဥပဒေတွင် ‘‘ပြည်သူ့ ဆက်ဆံရေးနှင့် သတင်းလွတ်လပ်ခွင့်အတွက်အာမခံချက်အပြည့် ပေးသည်။ သတင်းဆင်ဆာလုပ်မှုကို တားမြစ်သည်’’ ဟုအတိ အလင်း ဆိုထားသည်။ သို့ရာတွင် သတင်းအချက်အလက်ဒေတာ များကို နိုင်ငံတော်၏ လျှို့ဝှက်ချက်အဖြစ် စောင့်ထိန်းရမည်ဟုဆို ထားသည်။ အမေရိကန်နိုင်ငံတွင်လည်း သတင်းမီဒီယာလွတ်လပ် ခွင့်နှင့်ပတ်သက်ပြီး နိုင်ငံတော်တရားရုံးချုပ်၏ ဆုံးဖြတ်ချက် အတိုင်းသာရှိစေရမည်ဟုဆိုထားသည်။ အမေရိကန်ဖွဲ့စည်းပုံ အခြေခံဥပဒေပြင်ဆင်ချက်တွင် ‘‘လွှတ်တော်သည် လွတ်လပ်စွာ ပြောဆိုခွင့်၊ လွတ်လပ်စွာပုံနှိပ်ထုတ်ဝေခွင့်နှင့် ပတ်သက်ပြီး ပိတ်ပင်သည့် ဥပဒေကို မပြဋ္ဌာန်းရ’’ ဟုဖွင့်ဆိုထားသည်။ အမေရိကန်သမိုင်းတွင် အစိုးရသည် သတင်းလွတ်လပ်ခွင့်နှင့်ပတ် သက်ပြီး နည်းမျိုးစုံဖြင့် ပိတ်ပင်နိုင်ရန် ကြိုးစားခဲ့ကြသည်။ အမျိုးသားလုံခြုံရေးနှင့် စစ်ရေးကျူးကျော်မှုကိစ္စများတွင် သတင်း မီဒီယာ၏အခန်းကဏ္ဍကို လုံးဝကန့်သတ်နိုင်ရန် ကြိုးစားခဲ့ကြ သည်။",
        "ကုန်‌သော တွံ‌တေး‌ချောင်းမှလာရ၏။ ယခု‌သော် တွံ‌တေး",
        "အများအပြားတို့က ကန့်ကွက်ခဲ့ကြသည်။ နောက်ဆုံးတွင်",
        "ဂိုးလ်ဒင်းဂိတ်တံတားသည် ဆန်ဖရန်စစ္စကို ပင်လယ်အော်ကို ဖြတ်ကျော်တည်ဆောက်ထားသော တံတားဖြစ်သည်။ ထိုတံတားသည် ဆန်ဖရန်စစ္စကိုမှ အမေရိကန်ပြည်ထောင်စု ကယ်လီဖိုးနီးယားပြည်နယ် မာရင်ကောင်တီသို့ သွားရာလမ်းတွင် ဖြစ်သည်။ ၁၉၃၇ ခုနှစ်တွင် အများအသုံးပြုနိုင်ရန် စတင်ဖွင့်လှစ်ခဲ့ပြီး ၉,၂၆၆ပေ(၂,၈၂၄ မီတာ) မျှ ရှည်လျားသည်။ တံတားပြီးစီးချိန်က ကမ္ဘာပေါ်တွင် အရှည်ဆုံးတံတားတစ်ခု ဖြစ်ခဲ့သော်လည်း ယခုအချိန်တွင်မူ ၎င်းထက် ပို၍ရှည်လျားသော တံတား ရှစ်စင်းမျှ ရှိသည်။ လူအများစုအတွက်မူ ကမ္ဘာပေါ်တွင် အလှပဆုံး တံတား တစ်ခု အဖြစ် ရှုမြင်နေကြသေးသည်။",
        "ရှန်ကျန်းကို အထူးစီးပွားရေးဇုန်ဟု သတ်မှတ်ပြီးကတည်းက ရှန်ကျန်း၏ လူဦးရေမှာ အဆမတန် တိုးပွားလာခဲ့သည်။ ၂၀၀၈ ခုနှစ် စာရင်းများအရ ရှန်ကျန်း၌ လူဦးရေ ၁၄ သန်းခန့် ရှိသည်ဟု သိရသည်။ သို့သော်",
        "အ‌ရှေ့ဘက်မှစီးဝင်‌သော မြစ်လက်တက်များ၏ ‌ရေလုံးအားကြီး",
        "ထားအပ်သော သားရိုးပုတီး၊ ဆေးဝါးဖြင့် စီမံထားအပ်သော",
        "ဂန္ထဝင် ဆိုသည့် စကားလုံးမှာ မြန်မာဘာသာတွင် ပါဠိဘာသာမှ မွေးစားထားခြင်းဟု ယူဆနိုင်သည်။ အလွန်ရှေးကျသော အရာတစ်ခုသည် ယနေ့ထိတိုင်အောင် ပစ်ပယ်မထားနိုင်ပဲ ၎င်းနှင့် အမြဲ ချိန်ထိုးနိုင်ရန်အတွက်အထိ အရေးပါသော အရာဝတ္ထုတစ်ခု သို့မဟုတ် အကြောင်းအရာတစ်ခု ဖြစ်သည်ဟု ဆိုနိုင်သည်။ ထို့ပြင်၎င်းစကားလုံး၏ အဓိပ္ပါယ်ကို အစဉ်ထာဝရ လေးစားထိုက်သော သို့မဟုတ် အမြဲတစေ ချိန်ထိုးရန်အတွက် အကောင်းဆုံးသော စံ ဥပမာတစ်ခုကို ဆိုလိုနိုင်သည်။ မြန်မာဘာသာတွင် နာမ် ဖြစ်သော်လည်း အင်္ဂလိပ်ဘာသာတွင်မူ ဝိသေသနစာ စာလုံးတစ်လုံး ဖြစ်သည့်အပြင် တစ်ခါတစ်ရံ နာမ်(အင်္ဂလိပ်စာအရေးအသားတွင်) အဖြစ် တွေ့ရသည်။",
        "ရှေးအကျဆုံး စာအုပ်များ ဖြစ်နေသည်။ ယင်းကို ဗက်တီကင်",
        "လေသည်။ သို့သော်လည်း သူတို့နှစ်ဦး၏နည်းသည် ဆရာကြီး",
        "တွေ့ရတတ်သော တစ်နှစ်ခံ သို့မဟုတ် နှစ်ကြာခံ ပေါင်းပင်မျိုး",
        "အနောက်ပိုင်းဒေသ: မြေနိမ့်ပိုင်းဖြစ်ပြီး ကျောက်မီးသွေး၊ ဓာတ်သတ္တု၊ သစ်တောနှင့် ကောက်ပဲသီးနှံများ ထွက်ရှိသည်။",
        "ဆွန်ဂရမ်ကိုလည်း ရေတပ်က ပြန်လွှတ် လိုက်လေသည်။",
        "ငါးမိုင်ခန့်အကွာတွင်တည်ရှိသည်။ ပင်လယ်မျက်နှာပြင်ထက်",
        "သည်။ သတ္တုချက်စက်ရုံကြီး တစ်ခုနှင့်ပင် မနိုင်နင်း၍၊",
        "ဖြင့်လည်း တာဝန်ယူ၍ မနောပွဲ ကျင်းပလာခဲ့ခြင်း ဖြစ်သည်ဟု",
        "ကြသည်။ မီးနတ်နှင့် သက်ဆိုင်သော ပုံပြင်အမြောက်အမြားပင်",
        "ယေတာမှ ရေသည် အောက်ဘက်ရှိ ပြွန်မှ စက်အုံအတွင်းသို့",
        "စပါး ကောက်ပဲသီးနှံ့တို့ကို မြို့တွင်းဈေး၌ ရောင်းချသည်။ လမ်းပန်းဆက်သွယ်",
        "များကဲ့သို့ ကန့်လန့်ဖြတ် ခြေတောက်ဖြင့် မနားဘဲ သစ်ကိုင်း၏",
        "ကစားသူများက တို့လဲလိုက်မယ်ဟု ပြောကြသောအခါ မစာရု",
        "ဝါရင့်သူဖြစ်သည်။ ထို့အတူ လေဘာတီ ဒေါ်ခင်ညွန့်သည်",
        "၁၉၆၈၊ လန်ဒန်တက္ကသိုလ်အရှေ့တိုင်းနှင့် အာဖရိကလေ့လာရေးဌာန၊ နိုင်ငံရေးသိပ္ပံဌာန၌ သုတေသနလက်ထောက်အဖြစ် တာဝန်ထမ်းဆောင်သည်။",
        "တင်မြေ|ာက်ခြင်းဖြင့် သမ္မတနိုင်ငံလည်း ဖြစ်စေလိုသည်ဟု",
        "ကမ္ဘာပေါ်တွင် အဖိုးတန်ဆုံး ပတ္တမြားလုံးဖြစ်သော ရတီချိန် ၉ဝ",
        "ပြထားသည်၊ လျှာနောက်ပိုင်းဖြင့် အာခေါင်ပျော့ကို ထိ၍",
        "ကြပြီဖြစ်ရာ ၁၉၄၁ ခုနှစ် မတ်လ ၂၅ ရက်နေ့တွင် ယူဂိုစ",
        "ပထမကမ္ဘာစစ်အပြီးတွင်လည်း ဗြိတိသျှတို့သည် ရေတပ်ကို",
        "အခါ လုပ်ငန်းကြီးကို သားငါးယောက်တို့အား လွှဲအပ်ခဲ့သည်။",
        "စသည့် ဗိုလ်ချုပ်ကြီးများက အုပ်ချုပ်တိုက်ခိုက်၏။ ဗြိတိသျှတို့",
        "မြန်မာဘုရင်လက်ထက် ရွှေခြည်ထိုးပညာသည်များသည် ရှင်ဘုရင် မိဘုရားတို့ ဆင်မြန်းသော မင်းမြောက်တန်ဆာမှအစ အိမ်ရှေ့မင်း၊ ဝန်ကြီး၊ ဝန်ထောက်၊ မှူးမတ်၊ မတ်တော်၊ စစ်သူကြီးနှင့် ရာထူးရာခံ ရှိသူအားလုံးတို့၏ အဝတ်တန်ဆာမင်းခမ်းတော်များကို ရွှေတိုက်ဝန်၏ အမိန့်အတိုင်း ရွှေတိုက်စာတမ်းနှင့် ကိုက်ညီစွာ ရာထူးအလိုက် လုပ်ဆောင်ကြရသည်။ နောက်မှတစ်ဖန် ဘုရင်းမင်းမြတ်သည် သာသနာတော်သို့ ဝင်ရောက်မည့် ရှင်သာမဏေလောင်းတို့အား၎င်း၊ နားထွင်းမင်္ဂလာပြုမည့်",
        "ဖြစ်သည့် (သေနာသနပညာပက) ဘွဲ့ထူးအားချီးမြှင့်ပုံကို ရေးသားဖော်ပြထား",
        "ပါရစ်မြို့သို့ ပြန်လည်ရောက်လာကာ မဟာမိတ်တို့က ထီးနန်းအပ်နှင်းသည်ကိုခံရ၏။",
        "မိချောင်းမင်း၊ (၄၃) ဓဇပဋာက - တံခွန် ကုက္ကား မုလေးပွား၊ (၄၄)",
        "ကြိုးဖြင့် ကျပ်တည်းစွာ ရစ်ပတ်၍ပေးခြင်းဖြစ်လေသည်။ ထိုသို့ပြုလုပ်ပေး",
        "ကာဒွါရ အကြည်နှင့် ဖောဋ္ဌဗ္ဗရုံအတွေ့အထိတို့ ထိခိုက်သောအခါ၊",
        "ဖတ်မြစ်ကမ်းပါးတစ်လျှောက်တို့တွင် တွေ့ရလေသည်။ ပျဉ်းကတိုးပင်များလည်း",
        "ပြည့်စုံသောရဟန္တာများ၊ ဆဠာဘိညရဟန္တာဟူသော",
        "သောတရားဝင် ကြေညာချက်စာတမ်းဖြစ်သည်။ အမွေဆက်ခံခြင်း",
        "အမျိုးသားဒီမိုကရေစီအဖွဲ့ချုပ်မှ ပါတီသင်္ကေတ အမှတ်အသားကို ခမောက်တံဆိပ်မှသည် ‘ခွပ်ဒေါင်း-ကြယ်’အဖြစ် ပြောင်းလဲကြောင်း တရားဝင် ကြေညာ။",
        "များစွာပျက်စီးခဲ့ရလေသည်။ သို့သော်သံနှင့်သံမဏိများကို",
        "မြန်မာနိုင်ငံအလယ်ပိုင်း မိုးခေါင်ရေရှားဒေသဖြစ်ပြီး အပူပိုင်းဇုံတွင် ကျရောက်သဖြင့် တစ်နှစ်ပတ်လုံး ပူပြင်းခြောက်သွေ့သော ရာသီဥတုဖြစ်သည်။ မြို့နယ်၏ အမြင့်ဆုံးအပူချိန် (၄၁)ဒီဂရီစင်တီဂရိတ်နှင့် အနမ့်ဆုံးအပူချိန် (၃၆.၁) ဒီဂရီစင်တီဂရိတ်အတွင်းရှိပြီး မိုးရွာရက်ပေါင်း (၃၂)ရက်မှ (၅၅)ရက်နှင့် မိုးရေချိန် (၂၁)လက်မမှ (၄၃)လက်မအထိ ရွာသွန်းသည်။",
        "ပွဲ မှ အစပြုလျက် ဒုတိယကမ္ဘာစစ် အတွင်း သုံ့ပန်းစခန်းများတွင် စံနစ်တကျ သတ်ဖြတ်မှုများဖြင့် အဆုံးသတ်ခဲ့လေသည်။",
        "အစေးတစ်မျိုးမှာလည်း အလွန်ကောင်းသည်။ ထိုအစေးသည်",
        "သော အပူဓာတ်၏ပမာဏမှာ ရေဒီယေတာ၏ အပူချိန်ပေါ်တွင်",
        "လုပ်သည့် ရှေးရိုနည်းမှာ နေတွင် လှန်းခြင်း ဖြစ်သည်။ နေရောင်",
        "၁၉၄၂ – ဒုတိယကမ္ဘာစစ်:ဗြိတိသျှ ဗိုလ်ချုပ်ကြီး ဘားနတ် မောင်ဂိုမာရီ က ဘာဂီတိုက်ပွဲအောင်မြင်မှုနှင့် ပတ်သက်ပြီး သတင်းစာရှင်းလင်းပွဲတစ်ရပ် ပြုလုပ်ခဲ့သည်။",
        "အာကာသအတွင်း၌ နေ၏ဆွဲအားက လွှမ်းမိုးလျက် ရှိသည်။",
        "စက်မှုဖွံ့ဖြိုးရေး အရယူနိုင်ခဲ့သည့်အတွက် အာရှကျားများဟု တင်စားခေါ်ဝေါ်ခဲ့ကြသော အဆိုပါ နိုင်ငံများ၏ ဖွံ့ဖြိုးရေး ဖြစ်စဉ်ကြီးကို လေ့လာ သုံးသပ်ကြည့်ပါက ခေါင်းဆောင်မှု အခန်းကဏ္ဍ၏ အရေးပါပုံကို ထင်ထင်ရှားရှားကြီး တွေ့ရှိရမည်ဖြစ်သည်။ ကိုလိုနီစနစ်အောက်မှ လွတ်လပ်ရေး ရပြီးခါစ နိုင်ငံများတွင် နိုင်ငံ၏ စီးပွားရေးမူဝါဒကို ဦးဆောင်ခဲ့သူများမှာ စစ်နှင့်တော်လှန်ရေးကို ဖြတ်သန်းခဲ့သည့် နိုင်ငံရေး အစွဲသန်သည့် ပထမမျိုးဆက် ခေါင်းဆောင်များ ဖြစ်ခဲ့သည်။ ယင်း ပထမ မျိုးဆက်ခေါင်းဆောင်များမှာ စီးပွားရေးတိုးတက်ဖို့ စိတ်အခံထက် နိုင်ငံရေး ကစားကွက်များတွင် အာရုံရခဲ့သည့် ဖွံ့ဖြိုးမှုကို ယင်းတို့မျိုးဆက်အတွင်း အရယူပေးနိုင်ခဲ့ခြင်း မရှိပါ။ ဖွံ့ဖြိုးမှုနည်းသော စီးပွားရေးများတွင်ကား တက္ခနိုခရက်များ ခေါင်းဆောင်မှုနေရာကို ရရှိခဲ့ခြင်းမရှိပါ။ အဆိုပါ တက္ခနိုခရက်များမှာ စီးပွားရေးဖွံ့ဖြိုးမှု ဆောင်ကြဉ်းပေးနိုင်ခဲ့ သည့် ဒုတိယမျိုးဆက် ခေါင်းဆောင်များ ဖြစ်လာခဲ့လေသည်။",
        "စကားအတိုင်း ၁၇၈၇ ခုနှစ်တွင် ယခင်က စိတ္တဇရောဂါ",
        "ဤတံတားကြီးသည် ဖွင့်လှစ်ပေးသည့်အတွက် ပဲခူးတိုင်းဒေသကြီးမှတဆင့် မြန်မာပြည်အထက်ပိုင်းနှင့် အောက်ပိုင်းဒေသများသို့ လည်းကောင်း၊ မွန်ပြည်နယ်၊ ကရင်ပြည်နယ်နှင့် တနင်္သာရီတိုင်းဒေသကြီးများသို့လည်းကောင်း၊ မြန်မာပြည်အရှေ့မှအနောက်၊ တောင်မှမြောက်သို့ ကွန်ရက်သဖွယ် ယှက်သွယ်သွားလာနိုင်မည်ဖြစ်သည်။",
        "ဟွိုင်းဗရက်ဗန်အိုက်သည် ဗဲလဂျီယန်နိုင်ငံ (ဖလန်းဒါးပြည်) မဆိုက်နယ်၌ ဖွားမြင်ခဲ့သည်။ သူမွေးဖွားသည့်နှစ်ကို အတိအကျမပြောနိုင်ကြသော်လည်း ခရစ် ၁၃၆၆ ခုနှစ်ဟု ခန့်မှန်းကြသည်။ သူနှင့်သူ့ညီ ယန်ဗန်အိုက်သည် ဖလန်းဒါးနံရံ ပန်းချီစံနစ်ကို အခြေခံချပေးခဲ့ကြသည်။ ရှေးကရှိနှင့်ပြီးဖြစ်သော ဆီဆေးရေးနည်းကို ပိုမိုကောင်းမွန်လာအောင် နည်းသစ်ထွင်၍ ရေးဆွဲခဲ့၏။ အထူးသဖြင့် ပိုး၊ ဖဲ မှန် စသည်တို့နှင့် အရောင်တောက်ပြောင်သော ပစ္စည်းများကို ရေးဆွဲသရုပ်ဖော်ရာ၌ လက်စွမ်းမြောက်လှပေသည်။ ထိုညီအကို နှစ်ယောက်၏ အကောင်းဆုံးလက်ရာ ပန်းချီကားများကို များသောအားဖြင့်",
        "ကျောင်းများ၌ တပ်ဆင်အသုံးပြုသည့် အုတ်ကြွပ်များမှာ ထင်",
        "(အမေစုနဲ့ အတူ လွတ်လပ်တဲ့ ဒီမိုကရေစီကြီးကို ရယူပိုင်ဆိုင် ချင်ပါတယ် ခင်ဗျား)",
        "စွာသော မျိုးနွယ်ဘဝသို့ ရောက်ရှိခဲ့ရရှာပါသည်။ ဤကဲ့သို့ အမျိုးမျိုးသောနွယ်ဖွားဖြစ်ခဲ့ရသည်မှာ ရှေးကာလ ကတည်းက တစ်မျိုးနွယ်တည်းဖြစ်ခဲ့ပြီး တဖြည်းဖြည်းခြင်း ကွဲ",
        "1652 (Qing Dynasty): Qidu (七都), Xiangtan District (縣)",
        "လက္ခဏာရေးသုံးပါးကို သိခြင်း: အလုံးစုံသော သင်္ခါရတရားတို့၏ အနိစ္စ၊ ဒုက္ခ၊ အနတ္တ သဘောကို အကြွင်းမဲ့ သိတော်မူသည်။",
        "ထိုးပြီးနောက် အသားညို ကပ္ပလီမကလေး ဗာရိုနီကာနှင့် လက်",
        "စာအုပ်အမျိုးပေါင်း (၈၁)မျိုး ပုံနှိပ်ထုတ်ဝေခြင်း။",
        "ယင်းဆောင်းပါးမှာ အထူးအောင်မြင်သွားပြီး အမေရိကန်မှ ထုတ်ဝေသော Marine Corps Gazette နှင့် Australian Army Journal တို့တွင် ထပ်မံ ပုံနှိပ်ဖော်ပြခဲ့သည်။ ဒုတိယဆောင်းပါးမှာ (What is takes-Essentials of Special operation) ဖြစ်၍ ၊ ၎င်းင်းအမေရိကန် ဦးစီးတက္ကသိုလ်မှ ကျောင်းဆင်းပြီး ၁၉၆၁ ခုနှစ် ဩဂုတ်လ M.Rတွင် ပုံနှိပ်ခဲ့သည်။ တစ်နှစ်တာကာလအတွင်း ယင်းမဂ်ဂဇင်းအနေနှင့် ဆောင်းပါးရှင်တစ်ဦး၏ ဆောင်းပါးနှစ်ပုဒ်ကို ဖော်ပြခြင်းမှာ အလွန်ဖြစ်တောင့်ဖြစ်ခဲ ဖြစ်သဖြင့် M.R မဂ္ဂဇင်းကို ၎င်းင်းထံ (၆)လ အခမဲ့ပေးပို့ပြီး စာမူခ များလည်း ထိုက်ထိုက်တန်တန် ချီးမြှင့်ခဲ့သည်။ Working People’s Daily နှင့် Guardian သတင်းစာနှင့် မဂ္ဂဇင်းတို့တွင် အင်္ဂလိပ်ဘာသာဖြင့် ဆောင်းပါးပုဒ်ရေ ၂၀ဝ ကျော် ရေးသားခဲ့သည်။ ဒုဗိုလ်မှူးကြီး သောင်းထိုက်သည် ကာကွယ်ရေးဝန်ကြီးဌာနအပြင် အောက်ပါ နယ်ဘက်ဌာနများတွင် တာဝန် ထမ်းဆောင်ခဲ့ပါသေးသည်။ အလုပ်သမားဝန်ကြီးဌာနတွင် ၁၉၆၂ မှ ၁၉၆၄ အထိ အထူးအရာရှိအဖြစ် တာဝန်ထမ်းဆောင်ခဲ့သည်။ အလုပ်သမားအထူးအရာရှိအဖြစ် ကမ္ဘာ့အလုပ်သမားညီလာခံသို့ ၁၉၆၃ နှင့် ၁၉၆၄ နှစ်နှစ်ဆက်တိုက် တက်ရောက်ခဲ့သည်။ ထိုစဉ်က အလုပ်သမားဝန်ကြီးဌာန အတွင်းဝန် (နောက်ပိုင်း ဝန်ကြီးချုပ်) သူရ ဦးထွန်းတင် နှင့်အတူ တက်ရောက်ခဲ့ခြင်း ဖြစ်သည်။",
        "တစ်မျိုးသားလုံးကျန်းမာကြံ့ခိုင်ရေးနှင့် ပညာရည်မြင့်မားရေးဟူသည့် အမျိုးသားရေး ဦးတည်ချက်ကိုအထောက်အကူဖြစ်စေရန်၊",
        "ကွန်ပျူတာတက္ကသိုလ်(မိတ္ထီလာ)ကို ၂၀ဝ၁ ခုနှစ်၊ အောက်တိုဘာလ(၁) ရက်နေ့တွင် အစိုးရကွန်ပျူတာကောလိပ် အဖြစ် စတင်ဖွင့်လှစ်ခဲ့သည်။ ၂၀ဝ၇ ခုနှစ်၊ ဇန်နဝါရီလ(၂၀)ရက်နေ့တွင် ကွန်ပျူတာတက္ကသိုလ်(မိတ္ထီလာ)အဆင့်သို့ တိုးမြှင့်ခဲ့သည်။",
        "ရွေ့ပြောင်းတောင်ယာများက သဘာဝထိန်းသိမ်းရေးနယ်မြေအား ထိုးနှက်လျက်ရှိသည်။",
        "အတွဲ၄တွင်ပါဝင်သည်။ အရိပ်မဲ့လင်းနို့လက်မှလွတ်သွားသည့် အချိန်တွင် ရှီးလန်နှင့်ရှောက်ယွီတို့စကားပြောခန်း၌တင်ဆက်သည်။",
        "အဖွဲ့အစည်းကို ၂၀၀၃ ခုနှစ်တွင် ဝီကီပီးဒီးယား တွဲဖက်တည်ထောင်သူ ဂျင်မီဝေးလ်စ်မှ ဝီကီပီးဒီးယားနှင့် အခြားသော ညီအစ်မပရောဂျက်များကို အကျိုးအမြတ်မယူသောနည်းဖြင့် ရန်ပုံငွေပံ့ပိုးနိုင်ရန်အတွက် တည်ထောင်ခဲ့သည်။",
        "\"Millennium Simulation\" of structure forming – Max Planck Institute of Astrophysics, Garching, Germany",
        "ရုပ်ရှင်တည်းဖြတ်ဆု - အောင်သွင် - (ဆဋ္ဌဂံ)",
        "မိမိအား ပြောပြနေသူကို စိုက်ကြည့်ပြီးသူပြောသမျှ စကားလုံးများကို အမိအရဖမ်းကာ နားထောင်နိုင်လျှင် ပြောသမျှစကားလုံးအားလုံးနီးပါးသည် မိမိဦးနှောက်ထဲသို့ ရောက်နိုင်သည်။ စိတ်ဝင်တစားနှင့် အာရုံစူးစိုက်နားထောင်သည့်အတွက် အချက်အလက်အစီအစဉ်များနှင့်တကွ အသေးစိတ်အချက်အလက်များကိုပါ မှတ်မိနိုင်ပေသည်။ ဦးတင်ဦး(ကျူရှင်)၏ ကျောင်းသားဘဝတွင် ကျောင်းစနေချိန်မှ တက္ကသိုလ်ရောက်သည်အထိ စာမေးပွဲတိုင်း၌ ပထမချည်း ရခဲ့သည်။ ဒုတိယတစ်ကြိမ်မျှမရဖူးသောဟူ၏။ အခြားသူများကဲ့သို့ စာအုပ်နှင့် မျက်နှာမခွာဘဲ စာကျက်နေသည်ကိုလည်း မမြင်ရ။ စာမေးပွဲတွင်တော့ ပထမချည်းပဲ ရသည်။ ဤသည်မှာ သူ၏ လူအများမသိသော အလေ့အကျင့်ကောင်းတစ်ခုကြောင့်ပင် ဖြစ်သည်။ ထိုအလေ့အကျင့်သည်ကား သူတစ်ပါး ပြောသည်ကို နားစိုက်ထောင်တတ်ခြင်း ဖြစ်သည်။ သို့ဖြစ်၍ နားထောင်တတ်ခြင်းသည် ကျောင်းပညာရေးတွင် ထူးချွန်စေနိုင်သော အကြောင်းရင်းတစ်ရပ်ဖြစ်ပေသည်။",
        "Yebyu MMR006004005 Thit To Htaunt သစ်တိုထောင့်",
        "Twantay MMR013027088 Yangon Rubber Chan ရန်ကုန်ရာဘာခြံ",
        "MMR001012702503 Aung Chan Thar Ward အောင်ချမ်းသာရပ်ကွက်",
        "ရိုက်ကူးနေစဉ်တွင် အလုပ်သမားခေါင်းဆောင်အဖြစ် သရုပ်ဆောင်သည့် မင်းသမီး ယိုကို ယာဂူချီကို လုပ်ဖော်ကိုင်ဖက်များက ခေါင်းဆောင်တင်၍ သူတို့၏ အခက်အခဲများ၊ လိုအပ်ချက်များကို ဒါရိုက်တာထံတင်ပြစေသည်။ သူမနှင့် ကူရိုဆာဝါမှာ ဓမ္မာသောက၊ ရှားစေးနှင့်မျက်စောင်းကဲ့သို့ ဖြစ်လာ၍ ဤသို့ မကြာခဏငြင်းခုံကြရာက ပိုမိုနီးစပ်လာသည်။ ၁၉၄၅ခု မေလ ၂၁ ရက် ယာဂူချီကိုယ်ဝန်နှစ်လရှိချိန်တွင် သူတို့နှစ်ဦးလက်ထပ်သည်။ သူမသည် မင်းသမီးအဖြစ်ဆက်လက်လုပ်ကိုင်ခဲ့သည်။ သူမကွယ်လွန်သည့် ၁၉၈၅ ခုထိ လင်မယားပျော်ရွှင်စွာ အတူနေထိုင်ကြသည်။ သားသမီးနှစ်ဦးထွန်းကားရာ ၁၉၄၅ ဒီဇင်ဘာ ၂၀တွင် သား ဟီဆာအိုကိုဖွားမြင်သည်။ သူသည် သူ့အဖေ၏နောက်ပိုင်းအလုပ်များတွင် ထုတ်လုပ်သူလုပ်ခဲ့သည်။ ၁၉၅၄ ဧပြီ ၂၉တွင် သမီး ကာဇူကို ကိုဖွားမြင်သည်။ သူမမှာ အဝတ်အစား ဒီဇိုင်နာဖြစ်လာသည်။",
        "အထက်ပါ အဆိုအရ အိုက်ဒီယာတစ်ရပ်ကို မည်သို့ ရရှိနိုင်ကြောင်း လက်တွေ့ကျကျ ဖော်ညွှန်းထားခြင်း ဖြစ်သည်။ စားသောက်ဖွယ် ဟင်းလျာအသစ် တစ်ခွက်အတွက် အစပ်အဟပ်တည့်အောင် စီစဉ်ဖန်တီးသည်နှင့် တူသည်။ မိမိသိထားပြီးဖြစ်သည့် ဟင်းချက်စရာ အချို့ကို ယူကာ နည်းလမ်းသစ် တစ်မျိုးဖြင့် ရောနှော ချက်လိုက်ခြင်း သဘောအတိုင်းပင် ဖြစ်သည်။",
        "NGC 249 သည် ကြယ်စုတန်း တူကင်နာ မှ emission နက်ဗျူလာဖြစ်သည်။ ယင်းအား နက္ခတပညာရှင် James Dunlop ဆိုသူမှ ၁၈၂၆ တွင် ရှာဖွေတွေ့ရှိခဲဲ့သည်။",
        "ဥရောပလူမျိုးများထဲမှ ရေတံခွန်၏ အောက်ခြေသို့ ပထမဆုံးရောက်ရှိခဲ့ကြောင်း မှတ်တမ်းတင်ခဲ့သူမှ Latvia နိုင်ငံသား စူးစမ်းရှာဖွေသူ Aleksandrs Laime ဖြစ်သည်။ သူသည် ရေတံခွန်သို့ တစ်ယောက်တည်း ၁၉၄၆ ခုနှစ်တွင် ရောက်ခဲ့သည်။ သူသည်ပင် ရေတံခွန်၏ အထက်နားဆီသို့ ပထမဆုံး ရောက်ရှိခဲ့သူလည်း ဖြစ်သည်။ ရေတံခွန်၏ အနောက်ဘက် ဆင်ခြေလျောကုန်းတက်မှ အထက်သို့တက်ခဲ့သည်။ အထက်နားသို့ ရောက်ရှိခဲ့ချိန်မှာ ၁၉၄၆ နောက်ပိုင်း ဖြစ်၏။ အိန်ဂျယ်၏လေယာဉ် မှားယွင်းဆင်းသက်မှုဖြစ်ခဲ့ပြီး ၁၈ နှစ်ကြာပြီးနောက် ရေတံခွန်သို့ ရောက်ခဲ့ပြန်သည်။ Lativa နိုင်ငံ၏ လွတ်လပ်ရေးနေ့ဖြစ်သော ၁၉၅၅ ခုနှစ်၊ နိုဝင်ဘာလ၊ ၁၈ ရက်နေ့တွင် သူသည် ဗင်နီဇွဲလားသတင်းစာ El National သို့ နာမည်မရှိသေးသော စမ်းချောင်းကို Gauja ဟုခေါ်သင့်ကြောင်း ပြောကြားခဲ့သည်။ အဲ့သည်နှစ်တွင်ပင် ထိုအမည်ကို ဗင်နီဇွဲလားနိုင်ငံရှိ Nation Cartographic Institution က အသိအမှတ်ပြုခဲ့သည်။",
        "၁၁ ရက် ဇူလိုင်လ ၂၀၁၄ ခုနှစ်တွင် ရန်နိုင်ဦးသည် ဘရူနိုင်းနိုင်ငံ၌ ကျင်းပသော Hassanal Bolkiah Trophy အတွက် ရွေးချယ်သော လူစာရင်းတွင် ပါဝင်ခဲ့ပြီး ဝင်ရောက်ယှဉ်ပြိုင်ကစားရာ ဖလားကို ရရှိခဲ့သည်။ ထို့နောက် သူသည် ၂၀၁၅ ခုနှစ် ဖီဖာ ယူ-၂၀ ကမ္ဘာဖလားအတွက် ရွေးချယ်ခဲ့သော မြန်မာ အမျိုးသား အသက် ၂၀ နှစ်အောက် ဘောလုံးအသင်းတွင် ပါဝင်ခဲ့ပြီး ထိုနှစ် လူငယ်ကမ္ဘာဖလားအတွက် ပထမဆုံး အဖွင့်ဂိုးကို သွင်းယူနိုင်ခဲ့သည်။",
        "America/Adak သည် IANA အချိန်ဇုန် ဒေတာရင်းမြစ်၏ zone.tab ဖိုင်မှ အချိန်ဇုန်၏ အမှတ်လက္ခဏာဖြစ်သည်။ ပါဝင်သော ဒေတာများမှ အောက်ပါအတိုင်းဖြစ်သည်-",
        "တကယ်လို့ဆိုတော့ တစ်ရွာသား တစ်အားငယ် ဆိုတာလို ကိုမှိုင်းကြီးဟာ ငါတို့ရဲ့နေရာ ရန်ကုန်မြို့ကို ဝင်လာရှာတယ်၊ ခမျာဧည့်သည်မျက်နှာ မငယ်ရအောင်ဟဲ့လို့…၊",
        "\"သူလျှိုတို့ထုံးစံအတိုင်း သူ့လူ ကိုယ့်ဘက်သားလုပ်ပေါင်းလို့ ဒီကမောင်မောင်ပုတို့က တစ်ကြိမ် အထင်လွဲခဲ့ပါပြီ။\"",
        "ဤစာရင်းသည် အိန္ဒိယနိုင်ငံ၊ ဗီဟာပြည်နယ်ရှိ အရေးပါသည့် အမျိုးသား အဆောက်အအုံများ စာရင်း ဖြစ်သည်။ ဗီဟာပြည်နယ်၏ ရှေးဟောင်းသုတေသနလေ့လာမှု ဝဘ်ဆိုက်တွင် ဖော်ပြထားသည့် စာရင်း ဖြစ်သည်။ ASI ဝဘ်ဆိုင်တွင် လေ့လာမှုများမှ အဆောက်အအုံများကို နံပါတ်စဉ်တပ်ကာ သတ်မှတ်ဖော်ပြထားသည်။ ဗီဟာပြည်နယ်တွင် အရေးပါသည့် အမျိုးသားအဆောက်အအုံ (၇၀) ခုရှိသည်ဟု ASI က ဖော်ပြထားသည်။",
        "နိုင်ငံတော်ဗဟိုဘဏ်၏ စာရင်းအရ ၂၀၁၀ ခုနှစ်တွင် ငွေကြေးတန်ဖိုးသည် ၅-၁၁% အထိကျဆင်းခဲ့သည်။ သို့ပါ၍စီးပွားရေးသည် အသင့်အတင့်အနေအထားတွင်သာ ရှိသည်။ အီရန်၏ အချို့ပညာတတ်အုပ်စုများသည် စီးပွားရေးအခက်အခဲနှင့် ပြည်တွင်းပြည်ပ လုံလောက်မှုမရှိသော ရင်းနှီးမြုပ်နှံမှုတို့ကြောင့် စီးပွားရေးတိုးတက်ရန် အလုပ်အကိုင်အခွင့်အလမ်းကောင်းများ ရှာလိုသော အချို့အီရန်တို့သည် နိုင်ငံရပ်ခြားသို့ခရီးဆန့်ကြလေသည်။ လက်ရှိတွင် အီရန်သည် ကမ္ဘာ၌ သွင်းကုန်ဝယ်လိုအားတွင် အဆင့် ၁၈ ရှိပြီး နိုင်ငံတကာ ငွေကြေးသတ်မှတ်မှုစံနှုန်းအဆင့် ၂၉ တွင် ရှိသည်။",
        "အိန္ဒိယ၌နေထိုင်စဉ် တောင်ပိုင်းအိန္ဒိယဗုဒ္ဓဘာသာအသင်း၏ ဥက္ကဋ္ဌအဖြစ်ရွေးချယ်ခန့်အပ်ခြင်းခံရသည်။ နောက် ပရမ်ဘာ၌ အခမဲ့ဗုဒ္ဓဘာသာသင်ကျောင်း ကိုလည်း စီမံဆောင်ရွက်မှုလုပ်ဆောင်ပေးခဲ့လေသည်။ ၁၉၃၈ခု မေလ (၇)ရက်၌ မဒရပ်မြို့တွင် တောင်ပိုင်းအိန္ဒိယဗုဒ္ဓဘာသာအသင်းဝင်များ၏ ကျေးဇူးတင် အသိမှတ်ပြုသိအနေဖြင့် ဤသို့မှတ်တမ်းတင်ခဲ့လေသည်။",
        "\"တောင်လဲရာ မြက်ပြတ်ဆိုသလို မောင်တို့ သမီးယောက်ဖအချင်းချင်း အတွင်းမီး လောင်ကြသည့်အရေးနှင့် ဆင်းရဲသား ကျွန်တော်မျိုးလေးများကို ဘေးမထိပါစေနှင့်။\" [၁၂၈၁] နောင်ဝတ်၊ ပ။ ၁၈၂။",
        "ထိုအခါ အရှင်မဟာမောဂ္ဂလ္လာန်ထေရ်က “ယာနကာရပုတ္တသမိတိနှင့် ပုရာဏယာနကာရပုတ္တ ပဏ္ဍုပုတ္တအာဇီဝကတို့ ဥပမာဖြင့် ပေါ်လာသော အခြေအနေတို့ကို နှိုင်းယှဉ်ဖော်ပြ၍” လျှောက်ထားပါသည်။ ဤသို့ ရဟန္တာအရှင်မြတ်နှစ်ပါးအချင်းချင်း သုဘာသိတဝါစာကို ဝမ်းမြောက်တော်မူပုံကို ပြဆိုရာသုတ်။",
        "၂၇ ကြိမ်မြောက် အရှေ့တောင်အာရှအားကစားပြိုင်ပွဲ ဖွင့်ပွဲအခမ်းအနား ပြီးမြောက်ကြောင်း ကြေညာခြင်း",
        "ထိုအခါ ကန္ဒလိပန်း (သစ္စာပန်း) ခုနစ်ပွင့်ကို အညှာမှ ဖြတ်၍ မြတ်စွာဘုရား၏ ဦးထိပ်၌ တင်လှူပူဇော်ခဲ့သည်။ ထို့နောက် မြစ်ကမ်း၌ နေတော်မူသော တည်ကြည်သော သမာဓိ၊ ရင့်ကျက်သော ပညာရှိတော်မူသော၊ ဣန္ဒြေတို့ကို ပွားစေတော်မူပြီးသော ရွှေအဆင်းနှင့် တူသော အဆင်းရှိတော်မူသော ထိုမြတ်စွာဘုရားကို ချဉ်းကပ်၍ လက်အုပ်ချီပြီး ရှိခိုးခဲ့သည်။",
        "၂၀၁၅ ခုနှစ်၊ မေလတွင် မြို့နေလူဦးရေသည် ၂၅၂၈၁ ဦး ရှိသည်။ လူဦးရေသိပ်သည်းဆသည် တစ်စတုရန်းကီလိုမီတာလျှင် ၆၇.၉ ဦး ရှိသည်။ စုစုပေါင်း ဧရိယာသည် ၃၇၂.၃၄ စတုရန်းကီလိုမီတာ ကျယ်ဝန်းသည်။",
        "၁၉၅၁ ခုနှစ်တွင် လယ်ယာစိုက်ပျိုးရေးဌာနလက်အောက်၌ စိုက်ပျိုးရေးအင်ဂျင်နီယာဌာနခွဲအား ဖွင့်လှစ်၍ စက်မှုထွန်ယက်ရေးလုပ်ငန်းကို စတင်ဆောင်ရွက်ခဲ့သည်။၁၉၆၂ခုနှစ် တွင် စိုက်ပျိုးရေးအင်ဂျင်နီယာဌာနခွဲအား မြေယာကျေးလက်ကြီးပွားတိုးတက်ရေး ကော်ပိုရေးရှင်းလက်အောက်သို့ ပြောင်းရွေ့ပြီးစက်မှုလယ်ယာဌာနခွဲအဖြစ် ဖွဲ့စည်းခဲ့သည်။ ၁၉၇၂ ခုနှစ်၊ မတ်လ (၁၆) ရက်နေ့တွင် လယ်ယာစိုက်ပျိုးရေးနှင့် သစ်တောဝန်ကြီးဌာနလက်အောက်၌ စက်မှုလယ်ယာဦးစီးဌာနအဖြစ်သီးခြား ဖွဲ့စည်းခဲ့သည်။",
        "အိဇုမိုဒိုင်းတိုးဘူတာ (出雲大東駅 အိဇုမိုဒိုင်းတိုး - အဲခိ ) သည် ဂျပန်နိုင်ငံ၊ ရှိမနဲခရိုင်၊ အွန်းနန်းမြို့တွင် တည်ရှိသည့် ဘူတာတစ်ခု ဖြစ်သည်။",
        "မြန်မာ့ပုလဲ ထုတ်လုပ်ရေးနှင့် ရောင်းဝယ်ရေး လုပ်ငန်း",
        "သတင်းအချက်အလက်နည်းပညာဖြင့်စားသုံးသူအခွင့်အရေးများ သိရှိစေရန်။",
        "၁၀၄။ ။ (၁) တပ်မှူးတိုင်းသည်၊ ပြစ်မှုတခုကျူးလွန်သည်ဟု စွပ်စွဲခြင်းခံရသော မိမိကွပ်ကဲရသူ တဦးတယောက်ကို အချုပ်နှင့်ထားကြောင်း မိမိအားသတင်းပို့ပြီးသည့်နောက်၊ ပြည်သူ့အကျိုးကို ထောက်ထားရခြင်းကြောင့်၊ နှစ်ဆယ့်လေးနာရီအတွင်း စုံစမ်းစစ်ဆေးခြင်းပြုလုပ်ရန် မဖြစ်နိုင်ဟု မိမိယူ ဆသည့်အခါမှတပါး၊ ထိုစွပ်စွဲချက်ကို မစုံစမ်းမစစ်ဆေးဘဲ၊ နှစ်ဆယ့်လေးနာရီထက်ပို၍၊ ထိုသူကိုအချုပ် နှင့် မထားရန်ဂရုစိုက်ရမည်။",
        "တင်ဇင်းသည် မတူကွဲပြားသော လူများစုနှင့်အတူ အလုပ်လုပ်ရင်းနှင့် ဘာသာစကား (၇)မျိုးကို တတ်မြောက်လာခဲ့သည်။ နောက်ပိုင်းတွင် ဆာဒါ သို့မဟုတ် အထမ်းသမားခေါင်းဆောင် တစ်ယောက်ဖြစ်လာခဲ့သည်။ ဧဝရက်တောင်သို့ တက်ရောက်သူများကို ဆက်လက်လမ်းပြပေးခဲ့ပြီး တောင်တက်သမား များစွာကို လှုံ့ဆော်မှု ပေးနိုင်ခဲ့သည်။",
        "short ton-force နှင့် long ton-force per square inch,",
        "ရန်ကုန်မြို့ အင်းစိန်မြို့နယ်တွင် ​နေထိုင်​သော ဤအမျိုးသားမှာ ဧပြီလ ၆ရက်​နေ့မှစတင်ကာ ဖျားခြင်း၊​ချောင်းဆိုးခြင်း၊ကိုယ်လက်ကိုက်ခဲခြင်းနှင့် နုံးချိခြင်းတို့ ခံစားခဲ့ရ​သော်လည်း ​ရောဂါလက္ခဏာမပြင်းထန်၍ ​ဆေးရုံမပြခဲ့​ပေ။ဤလူနာသည် အတည်ပြုလူနာများဖြစ်​သော C24၊ C34၊ C35၊ C36၊ C37တို့နှင့် ဘာသာ​ရေးအခမ်းအနား အတူတက်ခဲ့ဖူးသည်။ လူနာသည် ဧပြီ ၁၂ရက်​နေ့တွင် ဖျားခြင်း၊​​ချောင်းဆိုးခြင်းနှင့် ကိုယ်လက်ကိုက်ခဲခြင်းတို့​ကြောင့် အင်းစိန်ပြည်သူ့​ဆေးရုံသို့ လာ​ရောက်ပြသခဲ့သည်။၎င်းအား စောင့်ကြည့်လူနာအဖြစ်ထားပြီး ဓာတ်ခွဲနမူနာထပ်မံရယူစစ်​ဆေးခဲ့ပြီး ဧပြီလ ၁၃ရက်​နေ့ နံနက် (၁၂:၃၀)အချိန်ထုတ်ပြန်ချက်တွင် အတည်ပြုလူနာအဖြစ် ပါဝင်ခဲ့သည်။",
        "အမေရိကန် စနူကာ : ၁၉၂၅ မှစတင်ခဲ့သည့် မူကွဲပုံစံဖြစ်၍ ခုံနှင့် အရွယ်ရှိ ဘောလုံးများနှင့် ကစားသည်။ စည်းမျဉ်းများမှာ အတော်ရိုးရှင်း၍ ပူးလ်ကစားနည်း၏ လွှမ်းမိုးမှုများရှိသည်။ အမေရိကန်ပြည်ထောင်စု စနူကာအဖွဲ့က အသိအမှတ်မပြု၊ အုပ်ချုပ်မှုမရှိသော်လည်း အမေရိက ဘိလိယက်ကွန်ဂရက်စ်က ထိန်းချုပ်ကြီးကြပ်သည်။",
        "ဇောစိတ်တစ်ခုစီ၌ နာမ်တရား ၃၅ လုံး (ယခင် ၃၄ လုံးတွင် သမ္မာဝါစာ ၁ လုံး ထပ်ပေါင်း၍)။",
        "(၁၈၆၈)၊ ပရာမီးသီးယပ်စ် ဒဏ္ဍာရီကို ပထမဆုံး သက်သေပြုသူမှာ ဟီးဆီးယဒ်ဖြစ်၍ နောင်တွင် ပြဇာတ်တွဲ သုံးပုဒ်ကို ဖြစ်နိုင်ခြေရှိသော ရေးဖွဲ့သူမှာ အီးစကီးလပ်စ်ဖြစ်ကာ ထိုသုံးပုဒ်မှာ ပရာမီးသီးယပ်စ်ကို ချည်နှောင်ခြင်း၊ ချည်နှောင်ခြင်းမှ လွတ်ကင်စေခြင်းနှင့် မီးဆောင်ကျဉ်လာသူ ပရာမီးသီးယပ်စ် တို့ဖြစ်၏။]]",
        "သာကစ္ဆသုတ်သည် အသျှင်သာရိပုတြာမိန့်မကြားတော်မူခဲ့သည့် သုတ္တန်တစ်ခု ဖြစ်သည်။",
        "ရွာ()သည် တနင်္သာရီတိုင်းဒေသကြီး၊ မြိတ်ခရိုင်၊ ကျွန်းစုမြို့နယ်၊ တောပြားကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ဖြစ်သည်။",
        "ရမ္မဇူရွာ()သည် တနင်္သာရီတိုင်းဒေသကြီး၊ ထားဝယ်ခရိုင်၊ ထားဝယ်မြို့နယ်၊ ပကာရီကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ဖြစ်သည်။",
        "လုံးချောသည် ပြည်တွင်းနှင့် နိုင်ငံတကာ ပြိုင်ပွဲများတွင် ဝင်ရောက်ထိုးသတ်ခြင်းဖြင့် နာမည်တစ်ခု ရလာခဲ့သူ ဖြစ်သည်။ ဂျပန်နိုင်ငံသို့ သွားရောက်ထိုးသတ်ခဲ့သည့် ပထမဆုံးသော လက်ဝှေ့အားကစားသမားတစ်ဦးလည်း ဖြစ်သည်။",
        "လင်ဖုံကြီးရွာ()သည် ကယားပြည်နယ်၊ လွိုင်ကော်ခရိုင်၊ လွိုင်ကော်မြို့နယ်၊ ထီးစဲခါးကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၆၈၂၆၇ ဖြစ်သည်။",
        "ယာယောရွာ()သည် ချင်းပြည်နယ်၊ မင်းတပ်ခရိုင်၊ မင်းတပ်မြို့နယ်၊ လာလောင်းထွီးကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၆၄၉၀၈ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ လာလောင်းထွီးကျေးရွာအုပ်စုတွင် ကျား ၅၉၇ ဦး၊ မ ၆၈၅ ဦး၊ လူဦးရေ စုစုပေါင်း ၁၂၈၂ ဦး နေထိုင်သည်။",
        "နောင်နန်းရွာ()သည် ကချင်ပြည်နယ်၊ မြစ်ကြီးနားခရိုင်၊ မြစ်ကြီးနားမြို့နယ်၊ နောင်နန်းကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၆၅၆၇၆ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ နောင်နန်းကျေးရွာအုပ်စုတွင် ကျား ၃၆၆၉ ဦး၊ မ ၄၂၆၁ ဦး၊ လူဦးရေစုစုပေါင်း ၇၉၃၀ ဦး နေထိုင်သည်။",
        "တောင်သုံးလုံးရွာ ()သည် ရှမ်းပြည်နယ် (အရှေ့)၊ ကျိုင်းတုံခရိုင်၊ မိုင်းခတ်မြို့နယ်၊ ဖာလန်/ကော်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၂၁၄၁၈ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ဖာလန် / ကော်ကျေးရွာအုပ်စုတွင် ကျား ၇၅၃ ဦး၊ မ ၇၃၈ ဦး၊ လူဦးရေ စုစုပေါင်း ၁၄၉၁ ဦးနေထိုင်သည်။",
        "ကန်မော့ရွာ ()သည် ရှမ်းပြည်နယ် (အရှေ့)၊ မိုင်းဆတ်ခရိုင်၊ မိုင်းဆတ်မြို့နယ်၊ နန်းမွန်းကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၁၃၈၄၀ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ နန်းမွန်းကျေးရွာအုပ်စုတွင် ကျား ၄၄၁ ဦး၊ မ ၄၀၁ ဦး၊ လူဦးရေ စုစုပေါင်း ၈၄၂ ဦးနေထိုင်သည်။ ဤရွာသည် တိမ်ကောသွားပြီ ဖြစ်သည်။",
        "မကျီးဆိပ်ရွာ ()သည် ရှမ်းပြည်နယ် (တောင်)၊ တောင်ကြီးခရိုင်၊ ညောင်ရွှေမြို့နယ်၊ အင်းလျားကျိုင်းခမ်းကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၀၅၅၆ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ အင်းလျားကျိုင်းခမ်းကျေးရွာအုပ်စုတွင် ကျား ၂၀၉၅ ဦး၊ မ ၂၃၅၉ ဦး၊ လူဦးရေ စုစုပေါင်း ၄၄၅၄ ဦးနေထိုင်သည်။",
        "နားပန်လုံရွာ ()သည် ရှမ်းပြည်နယ် (တောင်)၊ ပအိုဝ်း ကိုယ်ပိုင်အုပ်ချုပ်ခွင့်ရဒေသ၊ ဟိုပုံးမြို့နယ်၊ နောင်လိုင်မူဖိတ်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၁၁၀၉ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရနောင်လိုင်မူဖိတ်ကျေးရွာအုပ်စုတွင် ကျား ၁၇၅၇ ဦး၊ မ ၁၈၈၆ ဦး၊ လူဦးရေ စုစုပေါင်း ၃၆၄၃ ဦးနေထိုင်သည်။ ဤရွာသည် တိမ်ကောသွားပြီ ဖြစ်သည်။",
        "ပန်ပိုထီရွာ ()သည် ရှမ်းပြည်နယ် (တောင်)၊ လွိုင်လင်ခရိုင်၊ မိုင်းကိုင်မြို့နယ်၊ ပါခေါင်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၄၆၁၂ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ပါခေါင်ကျေးရွာအုပ်စုတွင် ကျား ၁၃၂၉ ဦး၊ မ ၁၄၈၅ ဦး၊ လူဦးရေ စုစုပေါင်း ၂၈၁၄ ဦးနေထိုင်သည်။",
        "အုံပရီရွာ ()သည် ရှမ်းပြည်နယ် (မြောက်)၊ ဝ ကိုယ်ပိုင်အုပ်ချုပ်ခွင့်ရတိုင်း၊ ဟိုပန်ခရိုင်၊ မိုင်းမောမြို့နယ်၊ အုံပုံကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၇၉၄၃ ဖြစ်သည်။",
        "လွတ်တောက်ရွာ ()သည် ရှမ်းပြည်နယ် (မြောက်)၊ လားရှိုးခရိုင်၊ သိန္နီမြို့နယ်၊ ဟိုပန်မျဉ်းကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၆၂၅၈ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ဟိုပန်မျဉ်းကျေးရွာအုပ်စုတွင် ကျား ၄၃၂ ဦး၊ မ ၃၈၂ ဦး၊ လူဦးရေ စုစုပေါင်း ၈၁၄ ဦးနေထိုင်သည်။ ဤရွာသည် တိမ်ကောသွားပြီ ဖြစ်သည်။",
        "လုံကျိန်ရွာ ()သည် ရှမ်းပြည်နယ် (မြောက်)၊ မူဆယ်ခရိုင်၊ ကွတ်ခိုင်မြို့နယ်၊ ဒေါင်နောကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၈၈၉၈ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ဒေါင်နောကျေးရွာအုပ်စုတွင် ကျား ၆၄၈ ဦး၊ မ ၆၁၂ ဦး၊ လူဦးရေ စုစုပေါင်း ၁၂၆၀ ဦးနေထိုင်သည်။",
        "မန်စန်း (ဆံထုံ)ရွာ ()သည် ရှမ်းပြည်နယ် (မြောက်)၊ ဝ ကိုယ်ပိုင်အုပ်ချုပ်ခွင့်ရတိုင်း၊ မက်မန်းခရိုင်၊ ပန်ဆန်း (ပန်ခမ်း)မြို့နယ်၊ မန်မန်းဆိုင်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၀၇၁၀၀ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ မန်မန်းဆိုင်ကျေးရွာအုပ်စုတွင် ကျား ၁၃၉၂ ဦး၊ မ ၁၂၅၃ ဦး၊ လူဦးရေ စုစုပေါင်း ၂၆၄၅ ဦးနေထိုင်သည်။",
        "သရက်ပင်ရွာ ()သည် မန္တလေးတိုင်းဒေသကြီး၊ ရမည်းသင်းခရိုင်၊ ရမည်းသင်းမြို့နယ်၊ ပဲ့ဆည်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၉၂၆၄၂ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ပဲ့ဆည်ကျေးရွာအုပ်စုတွင် ကျား ၁၆၄၆ ဦး၊ မ ၁၉၄၅ ဦး၊ လူဦးရေ စုစုပေါင်း ၃၅၉၁ ဦးနေထိုင်သည်။",
        "ကုန်းဆာရွာ ()သည် ရှမ်းပြည်နယ် (မြောက်)၊ ကျောက်မဲခရိုင်၊ သီပေါမြို့နယ်၊ ကုန်းဆာကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၂၁၀၀၇၁ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ကုန်းဆာကျေးရွာအုပ်စုတွင် ကျား ၆၀၂ ဦး၊ မ ၆၁၉ ဦး၊ လူဦးရေ စုစုပေါင်း ၁၂၂၁ ဦးနေထိုင်သည်။",
        "ဝန်ကရွာ ()သည် စစ်ကိုင်းတိုင်းဒေသကြီး၊ ခန္တီးခရိုင်၊ ခန္တီးမြို့နယ်၊ တိုက်တီးကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၇၆၃၁၉ ဖြစ်သည်။ ဤရွာသည် တိမ်ကောသွားသည်။",
        "တောင်တွင်းရွာ ()သည် စစ်ကိုင်းတိုင်းဒေသကြီး၊ မော်လိုက်ခရိုင်၊ မော်လိုက်မြို့နယ်၊ မှန်ပင်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၇၆၁၀၈ ဖြစ်သည်။",
        "တနယ်ရွာ ()သည် စစ်ကိုင်းတိုင်းဒေသကြီး၊ ရွှေဘိုခရိုင်၊ ဒီပဲယင်းမြို့နယ်၊ တနယ်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၇၂၄၄၈ ဖြစ်သည်။",
        "ဖုတ်ကုန်းရွာ ()သည် မကွေးတိုင်းဒေသကြီး၊ မကွေးခရိုင်၊ မကွေးမြို့နယ်၊ ဖုတ်ကုန်းကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၈၄၈၅၃ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ဖုတ်ကုန်းကျေးရွာအုပ်စုတွင် ကျား ၉၇၀ ဦး၊ မ ၁၁၁၀ ဦး၊ လူဦးရေ စုစုပေါင်း ၂၀၈၀ ဦးနေထိုင်သည်။",
        "ဖိုးပေါက်စုရွာ ()သည် မကွေးတိုင်းဒေသကြီး၊ မင်းဘူးခရိုင်၊ ပွင့်ဖြူမြို့နယ်၊ ရွှေလှေကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၈၆၂၉၄ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ရွှေလှေကျေးရွာအုပ်စုတွင် ကျား ၂၃၆၇ ဦး၊ မ ၂၆၆၇ ဦး၊ လူဦးရေ စုစုပေါင်း ၅၀၃၄ ဦးနေထိုင်သည်။",
        "ကျောက်တန်းရွာ ()သည် ပဲခူးတိုင်းဒေသကြီး (အရှေ့)၊ တောင်ငူခရိုင်၊ ကျောက်ကြီးမြို့နယ်၊ မီးတိုင်တောကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၈၀၃၅၂ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ မီးတိုင်တောကျေးရွာအုပ်စုတွင် ကျား ၂၈၁၃ ဦး၊ မ ၃၀၂၄ ဦး၊ လူဦးရေ စုစုပေါင်း ၅၈၃၇ ဦးနေထိုင်သည်။",
        "ကြက်မောက် - မကွေးခရိုင်၊ တောင်တွင်းကြီးမြို့နယ်၊ အောင်းစုကျေးရွာအုပ်စု",
        "စာနီစု - သာယာဝတီခရိုင်၊ လက်ပံတန်းမြို့နယ်၊ ကွမ်းသီးတပင်ကျေးရွာအုပ်စု၊ ပီကုတ် (183196)",
        "ကြောင်လျာကုန်း (တောင်)ရွာ ()သည် ပဲခူးတိုင်းဒေသကြီး (အနောက်)၊ ပြည်ခရိုင်၊ ပြည်မြို့နယ်၊ အင်းဝင်းကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၈၁၁၃၂ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ အင်းဝင်းကျေးရွာအုပ်စုတွင် ကျား ၉၃၉ ဦး၊ မ ၁၀၆၂ ဦး၊ လူဦးရေ စုစုပေါင်း ၂၀၀၁ ဦးနေထိုင်သည်။",
        "အိုင်ကြီးဒေါင့်ရွာ ()သည် ပဲခူးတိုင်းဒေသကြီး (အနောက်)၊ သာယာဝတီခရိုင်၊ လက်ပံတန်းမြို့နယ်၊ ခမုံဆိပ်ကျေးရွာအုပ်စု၌ တည်ရှိသည်။ ရွာနေရာကုတ်မှာ ၁၈၃၁၀၆ ဖြစ်သည်။ ၂၀၁၄ သန်းခေါင်စာရင်းအရ ခမုံဆိပ်ကျေးရွာအုပ်စုတွင် ကျား ၄၅၉၅ ဦး၊ မ ၄၉၈၆ ဦး၊ လူဦးရေ စုစုပေါင်း ၉၅၈၁ ဦးနေထိုင်သည်။",
        "ဒလိုင်းလားမားသည် စေတီတော်ကို ဖွင့်လှစ်ပေးခဲ့သည်။ Several Buddhist monks and nuns participated as well. အိန္ဒိယမှ ရာထူးကြီးမြင့်သူများလည်း စေတီတော်ဖွင့်ပွဲသို့ တက်ရောက်ခဲ့ကြပြီး ၎င်းတို့မှာ Akhlaqur Rahman Kidwai, governor of Haryana; Murlidhar Chandrakant Bhandare, governor of Orissa; Tejendra Khanna, Lieutenant Governor of Delhi; Mikhail Gorbachev နှင့် Dinesh Rai တို့ ဖြစ်ကြသည်။",
        "Lapisara Intarasut (Apple) as Benjamaporn \"Honey\" Meeprempi",
        "149 - အို-ယုံကြည်ခြင်း သဒ္ဓါတရားထားရှိသူ အပေါင်းတို့၊ အသင်တို့သည် အကယ်၍သာ ကာဖိရ် ငြင်းပယ်သောသူတို့(ပြောဆိုကြသည့်အတိုင်း) လိုက်နာကြပါမူ၊ ယင်းသူတို့သည်အသင်တို့အား (အစ္စလာမ်သာသနာတော်မှ ကုဖ်ရ် အယူဝါဒများဖက်သို့) ပြန်လည်၍ လှည့်စေကြကုန်အံ့။ သို့ပြန်လှည့်သွားကြလျှင် အသင်တို့သည် နစ်နာဆုံးရှုံးသူများအဖြစ်သို့ရောက်ရှိသွားကြကုန်လတ္တံ့။",
        "၂၀၁၈ တက်ရှ်ကန့် ဂရင်းပရစ် ၆၀ ကီလို ကြေးတံဆိပ်",
        "ငါ့သျှင် အကယ်၍ ဤတရားတို့ကို ကြဉ်၍ စွဲယူမှုမရှိသော ထက်ဝန်းကျင်ငြိမ်းအေးခြင်းသည်ဖြစ်ခဲ့ငြားအံ့၊ ပုထုဇဉ်သည် ထက်ဝန်းကျင်ငြိမ်းအေးရာ၏။ ငါ့သျှင် မှန်၏၊ ပုထုဇဉ်သည် ဤတရားတို့ကိုကြဉ်၍ ဖြစ်၏။ ငါ့သျှင် ဤလောက၌ ဥပမာအားဖြင့် အချို့ကုန်သော ပညာရှိယောက်ျားတို့သည် ပြောဆိုသောစကား၏ အနက်ကို သိကြကုန်၏၊ ထို့ကြောင့် သင့်အား ဥပမာကို ပြအံ့။",
        "၂၀၂၁ နိုဝင်ဘာ ၁၅ အထိ စာရင်းများအရ WeTV ၏ ရေပန်းအစားဆုံး BL ဇာတ်လမ်းများတွင် နံပါတ်တစ်ချိတ်ထားသည်။ နိုဝင်ဘာ ၂၃ တွင် ထိုင်းနိုင်ငံအတွင်း WeTV ၌ ကြည့်ရှုမှုအများဆုံး ဇာတ်လမ်းဖြစ်ခဲ့သည်။",
        "(၉) ကြိမ်မြောက် ကနေဒါရုပ်ရှင်ဆုပေးပွဲ၌ အကောင်းဆုံးဇာတ်လမ်းတိုဆုအတွက်လည်းကောင်း၊ (၂၂) ကြိမ်မြောက် ကွီဘက်ရုပ်ရှင်ဆုပေးပွဲ၌ အကောင်းဆုံးရုပ်ရှင်တိုဆုအတွက်လည်းကောင်း ဆန်ခါတင်ဇာတ်ကားအဖြစ် ရွေးချယ်ခံရသည်။",
        "ချိုင်အင်းဝမ် (; ၃၁ ဩဂုတ်၊ ၁၉၅၆ မွေးဖွား) သည် ၂၀၁၆ ခုနှစ်မှစတင်၍ ထိုင်ဝမ်နိုင်ငံ၏သမ္မတအဖြစ် တာဝန်ထမ်းဆောင်နေသော ထိုင်ဝမ်နိုင်ငံရေးသမားဖြစ်ပြီး ပညာရေးဆိုင်ရာ လက်ရှိတာဝန်ရှိသူဖြစ်သည်။ ဒီမိုကရက်တစ်တိုးတက်ရေးပါတီ (DPP) ၏အဖွဲ့ဝင်တစ်ဦးဖြစ်သည့် ချိုင်အင်းဝမ်သည် ထိုင်ဝမ်၏ ပထမဆုံးသော အမျိုးသမီးသမ္မတဖြစ်သည်။ သူမသည် ၂၀၂၀ ခုနှစ်ကတည်းက DPP ၏ ဥက္ကဋ္ဌအဖြစ် တာဝန်ထမ်းဆောင်ခဲ့ပြီး ယခင်က ၂၀၀၈ မှ ၂၀၁၂ နှင့် ၂၀၁၄ မှ ၂၀၁၈ ထိ တာဝန်ထမ်းဆောင်ခဲ့သေးသည်။",
        "===မည်သူတို့ ဝင်စားနိုင်သနည်း၊ မဝင်စားနိုင်သနည်း===",
        "ရဟန်းတို့ ပညာရှိသော အရိယသာဝကအား ထိုပညာအားလျော်သော သဒ္ဓါ၊ ဝီရိယ၊ သတိ၊ သမာဓိသည် ကောင်းစွာတည်၏-ဟု ရဟန်းတို့အား ဘုရားရှင် ဟောတော်မူသည့်သုတ်။",
        "ဤဂုဏ်ပုဒ်များအပြင် နိဗ္ဗာနနာမာဝလိတွင် ဖော်ပြထားသော အခြားဂုဏ်ပုဒ်များကိုလည်း အာရုံပြု၍ စီးဖြန်းနိုင်သည်။",
        "နတ်လူတို့ဆရာဖြစ်တော်မူသော မြတ်စွာဘုရားသည် ဝေဠုဝန်ကျောင်း၌ သီတင်းသုံးတော်မူစဉ် သက်ကြီး ရဟန်းအိုတို့သည် ကျောင်းစွန်၌ သစ်ရွက်မိုးကျောင်းတို့ကို ဆောက်စေ၍ တပေါင်းတည်း နေကြကုန်၏။",
        "ထိုအမျိုးသား အရွယ်သို့ ရောက်နေသော အမျိုးသမီးတစ်ယောက် ရှိလေ၏။ ထိုအမျိုးသမီးကို အမျိုးသားတစ်ဦးသည် တောင်းလာ၏။ အမျိုးသမီးကို ထိမ်းမြားလက်ထပ်သောအခါ လက်သုပ် ဟင်းလျာအတွက် ရည်ရွယ်၍ သာလူကမည်သော ဝက်တစ်ကောင်ကို ယာဂုထမင်းဖြင့် မွေးမြူထားလေ၏။ သာလူကဝက်သည် ချမ်းသာစွာ ညောင်စောင်းအောက်၌ အိပ်ရ၏။",
        "“အရှင်အိပ်ပျော်နေသောအခါ ညောင်စောင်းပါယူ၍ မိကျောင်းရဲသောမြစ်၌ ချမည်၊ ထိုအခါ မိကျောင်းကိုက်၍ သေလိမ့်မည်”ဟု ပြောလေ၏။ “ရှင်မကောင်းပြီ၊ သင့်အမိအိုဘယ်မှာနည်း”ဟု မေး၏။ “အရှင် အရှင့်အမိအိုထံမှာပင် အိပ်၏”ဟု ပြော၏၊ “ရှင်မလူမှားနေမည်၊ သင်သွား၍ အမိအိုညောင်စောင်းကို ကြိုးချီ၍ မှတ်ထားပါ”ဟု ပြောလေ၏၊ မယားလည်း လင်ခိုင်းသည့်အတိုင်း ညောင်စောင်း၌ ကြိုးချီ၍ မှတ်ထားလေ၏။ လူခြေတိတ်၍ အိပ်သောအခါ လင်မယားနှစ်ယောက်တို့သည် ကြိုးအမှတ် ပြုထားသော ညောင်စောင်းကို ချီမ၍ မြစ်တွင်းသို့ ချလေ၏၊ မယား၏အမိအိုသည် မိကျောင်းကိုက်၍ သေလေ၏၊ နံနက်လင်းသောအခါ မယားသည် မိမိအအိုသေသည့်အဖြစ်ကို သိ၍ ယောက်ျားထံသွားကာ “အရှင်အကျွန်ုပ်အမိအိုသေချေပြီ၊ သင့်အမိအိုကို သတ်ဦးလော”ဟု ပြော၏။ “ရှင်မ ဘယ်လိုသတ်မည်နည်း”ဟု မေးပြန်၏၊ “အရှင်သုသာန်၌ ထင်းပုံပြီးလျှင် မီးရှို့၍ သတ်မည်”ဟု ပြောဆိုတိုင်ပင်ကြကုန်၏။",
        "အကြောင်းတရား: ဉာဏ်ရောင်၏ တောက်ပမှုသည် အတိတ် ပါရမီ နှင့် ပစ္စုပ္ပန် သမာဓိ စွမ်းအား တို့အပေါ်တွင် များစွာ မူတည်သည်။",
        "သဘာဝကိန်းများသည် အနန္တအစု တစ်ခုကို ဖွဲ့စည်းကြသည်။ ၎င်းကို ယေဘုယျအားဖြင့် ဖြင့် သင်္ကေတပြုသည်။ အခြားသောအနန္တအစုများ၏ ဥပမာများတွင် ကိန်းပြည့်များ ၊ ရာရှင်နယ်ကိန်းများ ၊ ကိန်းစစ်များ နှင့် ကိန်းထွေးများ တို့ ပါဝင်သည်။ ထို့ပြင် သုညမဟုတ်သော ကိန်းစစ် ဗက်တာရပ်ဝန်းများ (real vector spaces) ၊ မျဉ်းကွေးများ (curves) နှင့် အခြားသော သင်္ချာဆိုင်ရာ ရပ်ဝန်း အများစုသည်လည်း အနန္တအစုများ ဖြစ်ကြသည်။",
        "“အို-ဓမ္မနတ်သား စင်စစ်သံဖြင့်ရွှေကို ဖြတ် နိုင်၏၊ ရွှေဖြင့် သံကိုမဖြတ်နိုင်၊ အကယ်၍ယခုအခါ ငါအဓမ္မနတ်သားသည် သင်ဓမ္မနတ်သားကို သတ်ငြားအံ့ သံသည် ရွှေကို ဖျက်ဆီးသကဲ့သို့ ဖြစ်ပေမည်”။",
        "(၂) အရိယမဂ်၊ နတ် ပြည်ခရီး။ (ဥဋ္ဌာနပါရိစရိယာ-တို့ဖြင့် မိဘတို့ကို ချမ်းသာအောင် ဆောင်ရွက်မှု ကုသိုလ် တရား။)",
        "တရုတ်နိုင်ငံမှ မီးရထားများဖြစ်ကာ DFH 21 (DFH = \"Dong fang hong\" ရှေ့နေဝင်းနီဟု အဓိပ္ပါယ်ရသော) အမျိုးအစား B'B'-dh ဒီဇယ်စက်ခေါင်းများဖြစ်သည်။ ၂၀၀၉-၂၀၁၀နှစ်များတွင် ယင်း နှစ်ပေါင်း (၃၀)ကျော် သက်တမ်းရှိ အင်ဂျင်စက်ခေါင်းများနှင့် ခရီးသည်တင်ရထားတွဲများနှင့်အတူ မြန်မာနိုင်ငံသို့ ရောင်းချခဲ့သည်။ စက်ခေင်းများကို DD.1111 အဖြစ် သတ်မှတ်ပြီး အဓိကအားဖြင့် ရန်ကုန်မြို့ပတ်လမ်းပိုင်းရှိ Alsthom DD.914 နှင့် အစားထိုး အသုံးပြုခဲ့သည်။",
        "၁၀။ သုခိန္ဒြေ - သုခသဟဂုတ်ကာယဝိညာဏ်စိတ်၌ယှဉ်သော ဝေဒနာ",
        "(၁) ပဉ္စင်္ဂဝိပ္ပဟိန-နီဝရဏ ၅-ပါးတို့ကို ပယ်ပြီးခြင်း။",
        "အဖွဲ့ (Organization) ဆိုသည်မှာ အစိုးရ၏ သီးခြားတာဝန်တစ်ရပ်ရပ်ကို ‌ဆောင်ရွက်ရန်ဟူသော သီးခြား လုပ်ငန်းတာဝန်အတွက် ဆောင်ရွက်ရသည့် ဝန်ထမ်းအဖွဲ့အစည်းမျိုးဖြစ်သည်။ ဥပမာ - ဗဟိုစာရင်းအင်းအဖွဲ့၊ လူမှု ဖူလုံရေးအဖွဲ့",
        "အို- အလ္လာဟ်အရှင်မြတ်... အ(လ်)-ခါလိကွ် (ဖန်ဆင်းသာအရှင်)၊ ကိုယ်တော်သည် ရှိသမျှအရာအားလုံးကို ဖန်ဆင်းတော်မူသော အရှင်ဖြစ်တော်မူ၏။ ကျွန်တော်မျိုးတို့၏ နှလုံးသားများကို အလ္လာဟ်အရှင်မြတ်၏ ဖန်တီးမှုအပေါ် အံ့အားသင့်မှု၊ ရိုသေလေးစားမှုနှင့် ကျေးဇူးတင်စိတ်များဖြင့် ဖြည့်ဆည်းပေးတော်မူပါ။ ကျွန်တော်မျိုးတို့အား ကိုယ်တော်၏ ဖန်တီးမှုများကို တန်ဖိုးထားတတ်သော ဉာဏ်ပညာကို ပေးသနားတော်မူပါ။ အို- အလ္လာဟ်... ကျွန်တော်မျိုးတို့အား ကောင်းမွန်သော အရာများကို ဖန်တီးနိုင်သော စွမ်းရည်ကို ပေးသနားတော်မူပါ၊ ကိုယ်တော်အား အမြဲယုံကြည်ကိုးစားနိုင်သော စိတ်ကို ပေးသနားတော်မူပါ။ အာမီးန်။",
        "သက္ကရာဇ် ၁၁၄၄-ခု၊ တပေါင်းလဆန်း (၁၃)ရက်၊ တနင်္လာနေ့ကား ဆင်းရဲစဉ် အိမ်နိမ့်စံနေရာမြတ်ကို အထိမ်းအမှတ်အဖြစ် ရည်ရွယ်သတ်မှတ်ပြီးလျှင် ကုသိုလ်တော်စေတီတစ်ဆူကို တည်ထားရာ အလုံးစုံ ပြီးပြေအောင်မြင်သဖြင့် ရွှေထီးအထွတ် တင်လှူသည့်နေ့ဖြစ်သည်။ ထိုနေ့တွင် ဘိုးတော်ဦးဝိုင်းသည် မိဖုရား၊ ဗိုလ်ပုံ အစုံအလင်ဝန်းရံလျက် ရတနာရွှေဖောင်တော်ဖြင့် အင်းဝရွှေမြို့တော်မှ စစ်ကိုင်းမြို့သို့ ထွက်တော်မူ၍ ရွှေထီးအထွတ်တင်ရာ အရိယာသံဃာတော် (၃၀၀၀) ကျော်တို့အား ပရိက္ခရာအစုံ ကပ်လှူလျက် ပွဲလမ်းသဘင်ကြီး ခင်းကျင်းကာ ရေစက်ချသာဓုခေါ်ဆိုလေသည်။ ကုသိုလ်တော်စေတီတော်ကိုလည်း (အောင်မြေလောကကျောက်စေတီ) ဘွဲ့တော်သမုတ်လေသည်။",
        "ရူပီးယားဟူသော အမည်သည် သက္ကတဘာသာစကားမှ ဆင်းသက်လာပြီး \"ငွေ\" ဟု အဓိပ္ပာယ်ရသည့် rupyakam (रूप्यकम्) မှ ဆင်းသက်လာခြင်း ဖြစ်သည်။ တစ်ခါတစ်ရံတွင် အင်ဒိုနီးရှားလူမျိုးများက ရူပီးယားဒင်္ဂါးများကို ရည်ညွှန်းရာ၌ \"perak\" (အင်ဒိုနီးရှားဘာသာဖြင့် ငွေ) ဟူသော စကားလုံးကို တရားမဝင် သုံးစွဲကြသေးသည်။",
        "တစ်နေ့သ၌ ဗန္ဓုလစစ်သူကြီးသည် မင်းခစားသွားရာ တရားသူကြီးတို့သည် ကောက်ကျစ်စဉ်းလဲကာ တရားစီရင်ကြသဖြင့် တရားရှုံးသောသူတို့ မြင်လျှင် တစာစာ ငိုကြွေးကုန်လျက် တရားသူကြီးတို့ ကောက်ကျစ်စဉ်းလဲသော အဖြစ်ကို လျှောက်ထားကုန်၏။ ထိုအခါ ဗန္ဓုလသည် တရားစီရင်ရာသို့သွား၍ တစ်ဖန် စစ်ဆေးပြီးလျှင် ဥစ္စာရှင်ကို ဥစ္စာရှင်ပြုကာ အမှန်အတိုင်း ဆုံးဖြတ်စီရင်၏။ ထိုအခါ လူတို့သည် အလွန်ဝမ်းမြောက်သဖြင့် တစာစာ ကောင်းချီးပေးကြကုန်၏။",
        "၁၉၉၃ ခုနှစ် ဇန်နဝါရီလ ၉ ရက်နေ့တွင် နိုင်ငံတော် ငြိမ်ဝပ်ပိပြားမှု တည်ဆောက်ရေးအဖွဲ့ သည် အမျိုးသားညီလာခံကို ရန်ကုန်မြို့ သမ္မတအိမ်တော်အတွင်း၌ စတင်ကျင်းပခဲ့သည်။ အဆိုပါ အမျိုးသားညီလာခံသို့ SNLD မှ ရွေးကောက်ပွဲအနိုင်ရ လွှတ်တော်ကိုယ်စားလှယ် ၅ ဦး၊ ပါတီဗဟိုဦးစီးအဖွဲ့ဝင် ၅ ဦး စုစုပေါင်း ၁၀ ဦး တက်ရောက်ခဲ့ရာတွင် ဦးစိုင်းအိုက်ပေါင်း လည်း ပါဝင်တက်ရောက်ခဲ့သည်။",
        "– အက်ချုဇဝောင်နှင့် ဟဇမတောင်အကြားအတွင် ရှိပြီး လူ ၅၀ ဦး နားနေနိုင်သည်။",
        "ဥပမာ: \"ဤအရာသည် ကုလားထိုင်ဖြစ်သည်\" ဟု ပြောခြင်းမှာ လူသားတို့က ၎င်းပစ္စည်းကို ကုလားထိုင်ဟု အမည်ပေးထားသောကြောင့် မှန်ကန်ခြင်း ဖြစ်သည်။",
        "၂၀၂၅ ခုနှစ်၊ ဒီဇင်ဘာလ ၂ ရက်နေ့တွင် GOD OF MYAING နှင့် EAGLE FIGHTER အဖွဲ့နှစ်ဖွဲ့ ထပ်မံပူးပေါင်းလာသဖြင့် လက်ရှိတွင် တပ်ဖွဲ့ပေါင်း (၇) ဖွဲ့ဖြင့် ဖွဲ့စည်းထားရှိသည်။",
        "ဗုဒ္ဓဘာသာ ရှုထောင့်မှ နောက်ထပ်သီအိုရီတစ်ခုက ကျန္ဒီ ဟူသော ဝေါဟာရသည် ပါဠိစကားလုံး စေဒီ (သက္ကတ: စေတိယ) ၏ ဒေသသုံးပုံစံဖြစ်နိုင်ပြီး ၎င်းသည် စေတီတော်ကို ရည်ညွှန်းသော ထိုင်းစကားလုံး စေဒီ နှင့် ဆက်စပ်နေကြောင်း အကြံပြုသည်။ ၎င်းသည် စုဏ္ဍီဘုရားလောင်း (စုန္ဒီ သို့မဟုတ် စန္ဒာ ဟုလည်း သိကြ) နှင့်လည်း ဆက်စပ်မှုရှိနိုင်သည်။",
        "အခြားတစ်နည်းအားဖြင့် ကွင်း ဟိုမိုမော်ဖစ်ဇင်ဆိုသည်မှာ ကွင်းနှစ်ခုကြားရှိ ပုံဖော်မှုတစ်ခု ဖြစ်သည်။ ၎င်းသည် ကွင်းနှစ်ခု၏ အပေါင်းအခြေခံ အုပ်စုများအတွက် အုပ်စု ဟိုမိုမော်ဖစ်ဇင် (group homomorphism) ဖြစ်သည်။ ထို့ပြင် ကွင်းနှစ်ခု၏ မြှောက်ခြင်းဆိုင်ရာ ဆီမီးအုပ်စုများ (multiplicative semigroups) အတွက်လည်း ဆီမီးအုပ်စု ဟိုမိုမော်ဖစ်ဇင် ဖြစ်သည်။",
        "ရင်ပေါင်တိုင်ရွာတွင် ချင်းပြည်နယ်မှ CDF တပ်ဖွဲ့ဝင်များ ရောက်ရှိနေသည်ဟူသော သတင်းကြောင့် တပ်မတော်က ဩဂုတ်လ ၁၁ ရက်နေ့တွင် ရဟတ်ယာဉ် ၄ စီးဖြင့် စတင်ပစ်ခတ်တိုက်ခိုက်ခဲ့သည်။ တပ်မတော်သည် ၃ ရက်ဆက်တိုက် ရွာအတွင်း တပ်စွဲ၍ လေကြောင်းမှ စက်သေနတ်များဖြင့် ပစ်ခတ်မှုများ ပြုလုပ်ခဲ့ပြီးနောက် ဩဂုတ်လ ၁၄ ရက်နေ့တွင် ပြန်လည်ဆုတ်ခွာသွားခဲ့သည်။ စီးနင်းမှုအတွင်း ရွာအတွင်းရှိ နေအိမ်များ မီးရှို့ဖျက်ဆီးခံခဲ့ရသည်။"
    ]
}
