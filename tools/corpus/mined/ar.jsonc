        "digit-run": 104,      // \d would miss 4
        "fractions": 1,        // in 18 treated languages
        "clock": 13,           // \d would miss 3
        "signs": 8,            // in 17 treated languages
        "dotted": 0,           // in 16 treated languages
        "era-marker": 0,       // in 14 treated languages
        "year": 102,           // \d would miss 4
        "decimals": 21,        // in 12 treated languages
        "ordinal-latin": 0,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 0,            // in 9 treated languages
        "ranges": 5,           // in 7 treated languages
        "currency": 0,         // in 6 treated languages
        "abbrev": 26,          // in 6 treated languages
        "latin-in-native": 46, // in 6 treated languages
        "percent": 5,          // in 5 treated languages
        "rate": 7,             // \d would miss 1
        "zero-width": 0,       // in 4 treated languages
        "roman": 0,            // in 3 treated languages
