// MINED NORMALIZATION CORPUS — cy. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer. The cells
// are the empirical shape of the rules the treated languages actually needed, so coverage of them is the
// completeness criterion — not size.
//
// ⚠ THIS TIER IS NOT A FALLBACK FOR MISSING FLEURS, and this header used to say it was — unconditionally,
// in all 163 artifacts, of which 95 belong to languages that DO have a FLEURS transcript. The two sources
// are COMPLEMENTARY and neither subsumes the other: FLEURS is read-aloud running text, so it is
// frequency-shaped and mostly exercises nothing the normalizer does; this artifact is selected
// ADVERSARIALLY against the pattern cells, so it is far richer per line in exactly the shapes a
// normalization rule has to decide. A language with FLEURS is still worth mining, and most were.
//
// ⚠ SO DO NOT READ THIS FILE AS THE WHOLE HAYSTACK. Shona's layer did: it repeated the old claim and argued
// its refusals from a corpus that was missing 1,901 FLEURS transcripts, which left one count wrong by a
// factor of twenty (#1064). Count over both.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: FLEURS cy_gb
// segmentation: sentence (abbreviation dots protected before splitting)
{
    "language": "cy",
    "source": "FLEURS cy_gb",
    "segmentMode": "sentence",
    "totalSegments": 2004,
    "cellsCovered": 26,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 1,          // in 22 treated languages
        "digit-run": 149,      // in 19 treated languages
        "fractions": 1,        // in 18 treated languages
        "clock": 21,           // in 18 treated languages
        "signs": 15,           // in 17 treated languages
        "dotted": 14,          // in 16 treated languages
        "era-marker": 7,       // in 14 treated languages
        "year": 149,           // in 14 treated languages
        "decimals": 59,        // in 12 treated languages
        "ordinal-latin": 4,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 15,           // in 9 treated languages
        "ranges": 18,          // in 7 treated languages
        "currency": 9,         // in 6 treated languages
        "abbrev": 74,          // in 6 treated languages
        "latin-in-native": 2004, // in 6 treated languages
        "percent": 4,          // in 5 treated languages
        "rate": 2,             // in 4 treated languages
        "zero-width": 0,       // in 4 treated languages
        "roman": 2,            // in 3 treated languages
        "initialism": 124,     // in 3 treated languages
        "grouped": 37,         // in 3 treated languages
        "signed-number": 1,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 108,    // in 3 treated languages
        "exponent": 0,         // in 24 treated languages
        "arithmetic": 0,       // in 2 treated languages
        "ampersand": 0,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 1,      // in 3 treated languages
        "version-dot": 3,      // in 3 treated languages
        "quote-letter": 1422,  // in 4 treated languages
        "scaled-currency": 7,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 110 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 0
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Mae Montevideo yn yr is-drofannau; yn ystod misoedd yr haf, mae tymereddau uwch na +30°C yn gyffredin." },
        { "cell": "digit-run", "text": "Ei 1,000fed stamp oedd y \"Gweithredoedd gwych gan Frenhinoedd Sweden\" ardderchog gan David Klöcker Ehrenstrahl yn 2000, sy'n cael ei restru yn Llyfr Recordiau Byd Guinness." },
        { "cell": "digit-run", "text": "Allan o 1,400 o bobl a gafodd eu holi cyn etholiad ffederal 2010, tyfodd y rheini sy'n gwrthwynebu i Awstralia ddod yn weriniaeth o 8 y cant ers 2008." },
        { "cell": "digit-run", "text": "Er enghraifft, mae \"dysgu\" a \"chymdeithasu\" yn cael eu hawgrymu fel cymhellion pwysig i ddefnyddio'r Rhyngrwyd (James et al., 1995)." },
        { "cell": "digit-run", "text": "Cafodd y Brenin Louis XVl, y Frenhines Marie Antoinette a'u dau blentyn ifanc (Marie Therese 11 oed a Louis-Charles 4 oed) a chwaer y Brenin, Madam Elizabeth dychrynedig, ar y 6ed Hydref 1789 eu gorfodi yn ôl i Baris o Versailles gan haid o fenywod marchnad." },
        { "cell": "fractions", "text": "Dylai'r patrwm fod yn ddigon dwfn, 5mm (1/5 modfedd) neu ragor, a'r deunydd yn ddigon meddal mewn tymereddau oer." },
        { "cell": "clock", "text": "Mae'r safon 802.11n yn gweithredu ar amleddau 2.4Ghz a 5.0Ghz." },
        { "cell": "clock", "text": "Diffoddodd criwiau ymladd tân y tân yn y pen draw erbyn 11:35 p.m." },
        { "cell": "clock", "text": "Mae bysiau'n gadael yr orsaf fysiau rhyng-ardal (dros yr afon) drwy gydol y dydd, er bod y mwyafrif, yn enwedig y rhai hynny sy'n mynd i'r dwyrain a Jakar/Bumthang yn gadael rhwng 06:30 a 07:30." },
        { "cell": "clock", "text": "Rhwng 10:00-11:00 yr hwyr MDT, cafodd tân ei gychwyn gan y carcharorion yn yr iard." },
        { "cell": "signs", "text": "Roedd e hefyd yn ymwneud ag engrafu arian papur i lawer o wledydd, mae enghreifftiau diweddar o'i waith yn cynnwys y portreadau o Brif Weinidogion ar flaenau'r papurau $5 a $100 doler Ganadaidd newydd." },
        { "cell": "signs", "text": "Sicrhaodd Nadal 88% o bwyntiau rhwyd yn yr ornest gan ennill 76 pwynt yn y serfiad cyntaf." },
        { "cell": "signs", "text": "Maen nhw'n cynnwys cyfyngiadau ariannol a gwaharddiad gan yr Undeb Ewropeaidd ar allforio olew crai, y mae economi Iran yn derbyn 80% o'i incwm tramor ohono." },
        { "cell": "signs", "text": "Roedd Batten yn y 190fed safle ar restr 400 Americanwr Cyfoethocaf 2008 gydag amcangyfrif o ffortiwn gwerth $2.3 biliwn." },
        { "cell": "dotted", "text": "Dechreuodd ei enwogrwydd am fod yn uwchganolbwynt moethusrwydd tua 400 O.C. a pharhaodd tan tua 1100 O.C." },
        { "cell": "dotted", "text": "Roedd y dogfennau'n dangos bod pedwar ar ddeg o fanciau wedi helpu cleientiaid cyfoethog i guddio biliynau o ddoleri'r U.D. o gyfoeth er mwyn osgoi trethi a rheoliadau eraill." },
        { "cell": "dotted", "text": "Fe'u gorfodwyd i dalu trethi i gyfundrefn drefedigaethol yr U.D. i dalu swm fawr o'r gwariant a'r llog ar fondiau oedd yn cael eu codi yn enw'r llywodraeth Philipinaidd trwy dai bancio Wall Street." },
        { "cell": "dotted", "text": "Cychwynnodd y rhaglen am 8:30 p.m. amser lleol (15.00 UTC)." },
        { "cell": "era-marker", "text": "Roedd saethau o'u croesfwâu angheuol yn gallu treiddio arfwisg milwyr y gelyn. Tua 1000 C.C., cyflwynodd yr Asyriaid y marchfilwyr cyntaf." },
        { "cell": "era-marker", "text": "Am 1:15 a.m. ddydd Sadwrn, yn ôl tystion, roedd y bws yn mynd trwy olau gwyrdd pan wnaeth y car droi o'i flaen." },
        { "cell": "era-marker", "text": "Tarodd y daeargryn Mariana am 07:19 a.m. amser lleol (09:19 p.m. GMT Dydd Gwener)." },
        { "cell": "era-marker", "text": "Ysgydwodd ddaeargryn cymedrol orllewin Montana am 10:08 p.m. ddydd Llun." },
        { "cell": "year", "text": "Yn y pen draw, cafodd olwynion pren eu disodli gan olwynion haearn. Yn 1767, cafodd y rheiliau haearn llawn cyntaf eu cyflwyno." },
        { "cell": "year", "text": "Fe wnaeth y Portiwgeaid ei ddinistrio a'i ailadeiladu o dan yr enw Casa Branca, dim ond i'w adael ar ôl daeargryn ym 1755." },
        { "cell": "year", "text": "Mae gan y rhan ogleddol neu Sentinel Range fynyddoedd uchaf Antartica, massif Vinsion, ar ei uchaf ym Mynydd Vinson sy'n 4892 m." },
        { "cell": "year", "text": "Fel NSA, roedd yn cynorthwyo Carter i drin materion y bydd yn ddiplomyddol, fel Camp David Accords, 1978; normaleiddio cysylltiadau rhwng yr UD a Tsieina drwy ddiwedd yr 1970au; Chwyldro Iran, a arweiniodd at argyfwng gwystlon Irac, 1979; a'r goresgyniad Sofiet yn Affganistan, 1979." },
        { "cell": "decimals", "text": "Mae gan Japan bron 7,000 o ynysoedd (y fwyaf yw Honshu), gan wneud Japan yn 7fed ynys fwyaf y byd!" },
        { "cell": "decimals", "text": "Mae'r parc yn cwmpasu 19,500 km sgwâr ac mae wedi'i rannu'n 14 ecobarth gwahanol, pob un yn cynnal bywyd gwyllt gwahanol." },
        { "cell": "decimals", "text": "Ledled Unol Daleithiau America, mae tua 400,000 o achosion hysbys o Sglerosis Ymledol (MS), gan ei adael fel y prif afiechyd niwrolegol mewn oedolion iau a chanol oed." },
        { "cell": "decimals", "text": "Mae'n ymddangos bod geifr wedi cael eu dofi gyntaf tua 10,000 o flynyddoedd yn ôl ym Mynyddoedd Zagros Iran." },
        { "cell": "ordinal-latin", "text": "Anfonwyd un at George Washington ar Orffennaf 6, a chafodd ei ddarllen i'w filwyr yn Efrog Newydd ar Orffennaf 9. Fe wnaeth copi gyrraedd Llundain ar Awst 10." },
        { "cell": "ordinal-latin", "text": "Mae slefrod môr bocs i'w gweld ger traethau ac aberoedd afonydd rhwng Hydref ac Ebrill i'r gogledd o 1770. Ambell waith gellir eu canfod y tu allan i'r amseroedd hyn." },
        { "cell": "ordinal-latin", "text": "Y marwolaethau oedd Nicholas Alden, 25, a Zachary Cuddeback, 21. Cuddeback oedd wedi bod yn gyrru." },
        { "cell": "ordinal-latin", "text": "Bydd y Gemau Paralympaidd yn digwydd o 24 Awst tan 5 Medi 2021. Bydd rhai digwyddiadau'n cael eu cynnal mewn lleoliadau eraill ledled Japan." },
        { "cell": "units", "text": "Er enghraifft, y ffformat ffotograffiaeth delwedd lonydd mwyaf cyffredin yn y byd yw 35mm, a dyma oedd y maint ffilm blaenaf ar ddiwedd oes y ffilm analog." },
        { "cell": "units", "text": "Byddai person sy'n pwyso 200 pwys (90kg) ar y Ddaear yn pwyso tua 36 pwys (16kg) ar Io. Felly mae'r disgyrchiant, wrth gwrs, yn tynnu llai arnoch chi." },
        { "cell": "units", "text": "Mae'n debyg y bydd y storm, sydd wedi'i lleoli tua 645 milltir (1040 km) i'r gorllewin o ynysoedd Cape Verde, yn chwalu cyn bygwth unrhyw ardaloedd ar y tir, meddai'r proffwydi tywydd." },
        { "cell": "units", "text": "36mm o led a 24mm o uchder ydy'r fformat 35mm mewn gwirionedd, sydd ychydig yn ddryslyd." },
        { "cell": "ranges", "text": "Torri ar draws cwsg yw'r broses o ddeffro'n bwrpasol yn ystod cyfnod eich cwsg arferol a syrthio i gysgu ychydig yn ddiweddarach (10-60 munud)." },
        { "cell": "ranges", "text": "Gan Del Potro roedd y fantais yn yr ail set, ond roedd hon hefyd yn gofyn am ddatglwm ar ôl cyrraedd 6-6." },
        { "cell": "ranges", "text": "Cyfeirir yn gyffredin at yr oes lle digwyddodd y digwyddiadau fel yr Oesoedd Canol Uchel, y cyfnod o hanes Ewropeaidd yn yr unfed ganrif ar ddeg, y ddeuddegfed ganrif, a'r drydedd ganrif ar ddeg (OC 1000–1300)." },
        { "cell": "ranges", "text": "Record Nadal yn erbyn y gŵr o Ganada yw 7-2." },
        { "cell": "currency", "text": "Mae rhai o'r cerrig, sy'n brin iawn ar y Ddaear, yn cael eu gwerthu o US$11,000 i $22,500 yr owns, sydd tua deg gwaith yn fwy na chost aur." },
        { "cell": "currency", "text": "Ymunodd Jesus, 21 oed, â Manchester City llynedd yn Ionawr 2017 o glwb Palmeiras ym Mrasil am ffi crybwylledig o £27 miliwn." },
        { "cell": "currency", "text": "Mae disgwyl y bydd y rhan fwyaf o docynnau ar gyfer y digwyddiad yn costio rhwng ¥ 2,500 a ¥ 130,000, gyda thocynnau arferol yn costio tua ¥7,000." },
        { "cell": "currency", "text": "Mae'r Prif Weinidog John Howard wedi dweud bod y ddeddf ond i ddiogelu cyfleusterau'r ysbyty rhag cael ei hisraddio gan lywodraeth Tasmania, drwy roi AUD$45 miliwn ychwanegol." },
        { "cell": "abbrev", "text": "Mae technoleg yn cynnig yr ateb gyda rhith-deithiau maes. Gall myfyrwyr edrych ar arteffactau mewn amgueddfeydd, ymweld ag acwariwm, neu edmygu celf hardd tra'n eistedd gyda'u dosbarth." },
        { "cell": "abbrev", "text": "Gorffennodd y sgïwr a nam ar ei olwg o Wlad Pwyl Maciej Krezel a'i dywysydd Anna Ogarzynska yn drydydd ar ddeg yn y Super-G. Gorffennodd Jong Seork Parh o Dde Corea yn bedwerydd ar hugain yn Super-G eistedd y dynion." },
        { "cell": "abbrev", "text": "Cafodd 108 o blatiau o Chhappan Bhog (mewn Hindŵaeth, 56 o eitemau bwytadwy gwahanol, megis losin, ffrwythau, cnau, seigiau ayb. oedd yn cael eu cynnig i'r duwdod) eu gweini i Baba Shyam." },
        { "cell": "abbrev", "text": "Croesawodd Arlywydd yr Unol Daleithiau George W. Bush y cyhoeddiad." },
        { "cell": "latin-in-native", "text": "Gan mai myfyrwyr yn aml yw'r gynulleidfa fwyaf beirniadol, mae ysgrifennwr y blog yn dechrau ymdrechu i wella ysgrifennu i osgoi beirniadaeth." },
        { "cell": "latin-in-native", "text": "\"Collais fy chwaer a'i ffrind, ac ar fy ffordd yno roedd dau berson anabl mewn cadeiriau olwyn gyda phobl yn neidio drostyn nhw ac yn eu gwthio\", meddai Armand Versace." },
        { "cell": "latin-in-native", "text": "Mae'r rhan fwyaf o ardaloedd yn cael eu gwasanaethu gan Fysiau Coaster Japaneaidd bach, sy'n gyfforddus a chadarn." },
        { "cell": "latin-in-native", "text": "Gall dyfrffyrdd mewndirol fod yn thema dda i seilio eich gwyliau arnynt." },
        { "cell": "percent", "text": "Mae Twrci Ewropeaidd (dwyrain Thrace neu Rumelia yng Ngorynys y Balcanau) yn cynnwys 3% o'r wlad." },
        { "cell": "percent", "text": "Diolch i gysylltiadau cebl ffibr optig tanfor ag Ewrop a lloeren band eang, mae gan yr Ynys Las gysylltiad da gyda 93% o'r boblogaeth yn meddu ar fynediad i'r rhyngrwyd." },
        { "cell": "rate", "text": "Mae gan y stormydd aruthrol hyn wyntoedd hyd at 480 cilomedr/awr (133 milltir yr eiliad; 300 milltir yr awr)." },
        { "cell": "rate", "text": "Yn ôl awdurdodau'r parc, arhoswch o leiaf 100 llath/metr oddi wrth eirth a bleiddiaid a 25 llath/metr oddi wrth bob anifail gwyllt arall." },
        { "cell": "roman", "text": "Yn ystod y frwydr am annibyniaeth a drefnwyd gan fudiad Mau, fe wnaeth casgliad heddychlon yn y dref arwain at ladd y prif swyddog Tupua Tamasese Lealofi III." },
        { "cell": "roman", "text": "Fe wnaeth y Prif Weinidog Dros Dro Julia Gillard honni yn ystod ymgyrch etholiadol 2010 ei bod yn credu y dylai Awstralia ddod yn weriniaeth ar ddiwedd teyrnasiad y Frenhines Elizabeth II." },
        { "cell": "initialism", "text": "Mae llawer o fformatau cyffredin (teulu fformatau APS, er enghraifft) yn gydradd â neu'n cyfateb yn fras i'r gymhareb agwedd hon." },
        { "cell": "initialism", "text": "Adroddodd NHK hefyd fod ffatri pŵer niwclear Kashiwazaki Kariwa yn rhaglawiaeth Niigata yn gweithredu fel arfer." },
        { "cell": "initialism", "text": "Mae Israel yn mynnu presenoldeb milwrol parhaus yn y dyffryn am ddeng mlynedd unwaith y bydd y cytundeb wedi'i arwyddo tra bod y PA yn cytuno i adael presenoldeb o'r fath am bum mlynedd yn unig." },
        { "cell": "initialism", "text": "Mewn partneriaeth o NPWS a Chymdeithas Saethwyr Chwaraeon Awstralia (NSW) Inc, cafodd gwirfoddolwyr cymwys eu recriwtio, o dan raglen hela'r Gymdeithas Saethwyr Chwaraeon." },
        { "cell": "grouped", "text": "Apia yw prifddinas Samoa. Mae'r dref ar ynys Upolu ac mae ganddi boblogaeth o ychydig llai na 40,000." },
        { "cell": "grouped", "text": "Fodd bynnag, mae'n ymddangos bod y ganran o XDR-TB yn y grŵp cyfan o bobl sydd â twbercwlosis yn dal i fod yn isel; 6,000 o'r cyfanswm o 330,000 o bobl sydd wedi'u heintio ar unrhyw adeg benodol yn Ne Affrica." },
        { "cell": "grouped", "text": "Ers 1966 mae'r Sundurbans wedi bod yn noddfa i fywyd gwyllt, ac amcangyfrifir bod 400 o deigrod Bengal a thua 30,000 o geirw brych yn yr ardal yn awr." },
        { "cell": "grouped", "text": "Fodd bynnag, cafodd y cynlluniau hyn eu disodli dros nos bron, pan aeth dros 800,000 o filwyr o Fyddin Goch yr Undeb Sofietaidd i mewn a chreu ffryntiau Belarws a'r Wcrain ar ôl ymosod ar ranbarthau dwyreiniol Gwlad Pwyl yn groes i Gytundeb Heddwch Riga, y Cytundeb Anymosod Sofiet-Pwylaidd, a chytundebau rhyngwladol eraill, dwyochrog yn ogystal ag amlochrog." },
        { "cell": "letter-name", "text": "Pan aethoch chi I wlad dramor am y tro cyntaf, mae'n debyg bod pobl yn amyneddgar ac yn oddefgar, gan wybod bod yn rhaid i deithwyr mewn gwlad newydd addasu." },
        { "cell": "letter-name", "text": "Y sgôr terfynol oedd buddugoliaeth o un pwynt, 21 i 20, gan ddod â chyfres ennill 15 gêm y Crysau Duon i ben." },
        { "cell": "letter-name", "text": "Y prif gwrw lleol yw \"Rhif Un\", nid yw'n gwrw cymhleth, ond yn ddymunol ac yn adfywiol. Enw'r cwrw lleol arall yw \"Manta\"." },
        { "cell": "letter-name", "text": "Y brif grefydd ym Moldofa yw Cristnogaeth Uniongred." },
        { "cell": "sports-time", "text": "Gwelodd ei ras arall, y Slalom Fawr, hi yn gorffen yn ddegfed yn ras grŵp eistedd y menywod gydag amser rhediad cyfun o 4:41.30, 2:11.60 o funudau'n arafach na'r un a orffennodd yn y safle cyntaf, Claudia Loesch o Awstria, a 1:09.02 munud yn arafach na'r un a orffennodd yn nawfed, Gyöngyi Dani o Hwngari." },
        { "cell": "version-dot", "text": "Bydd hyn yn caniatáu iddo fod yn gydnaws am yn ôl â 802.11a, 802.11b a 802.11g, ar yr amod bod gan y safle radios deuol." },
        { "cell": "version-dot", "text": "Mae cyflymderau o 802.11n yn sylweddol gyflymach na rhai ei rhagflaenwyr gyda thrwybwn damcaniaethol uchaf o 600Mbit yr eiliad." },
        { "cell": "quote-letter", "text": "Ar ffyrdd rhewllyd ag eira arnyn nhw, mae ffrithiant yn isel ac nid ydych chi'n gallu gyrru fel pe baech chi ar asffalt noeth." },
        { "cell": "quote-letter", "text": "Efallai mai saffaris yw'r atyniad mwyaf i dwristiaid yn Affrica ac yn uchafbwynt i lawer o ymwelwyr." },
        { "cell": "quote-letter", "text": "Er iddo gael ei ddefnyddio'n eang, yn enwedig ymhlith y rhai nad ydynt yn Romani, mae'r gair \"Sipsiwn\" yn cael ei ystyried yn dramgwyddus oherwydd ei gysylltiadau â stereoteipiau negyddol ac amgyffrediad anghywir o bobl Romani." },
        { "cell": "quote-letter", "text": "Mae'n werth hanner awr i fynd am dro o amgylch y pentref diddorol." },
        { "cell": "scaled-currency", "text": "250 mlynedd yn ddiweddarach, mae Guinness wedi tyfu'n fusnes byd-eang sy'n trosi dros 10 biliwn ewro (UD $14.7 biliwn) bob blwyddyn." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Gan mai myfyrwyr yn aml yw'r gynulleidfa fwyaf beirniadol, mae ysgrifennwr y blog yn dechrau ymdrechu i wella ysgrifennu i osgoi beirniadaeth.",
        "Mae Parc Cenedlaethol Kruger (KNP) yng ngogledd-ddwyrain De Affrica ac yn rhedeg ar hyd y ffin â Mozambique yn y dwyrain, Simbabawe yn y gogledd, a'r ffin ddeheuol yw Afon Crocodeil.",
        "Dyma bumed CEP Martelly mewn pedair blynedd.",
        "Roedd y gwyddonwyr yn gallu dod i'r casgliad fod y sylwedd tywyll yn effeithio ar sylwedd tywyll arall yn yr un modd â mae sylwedd rheolaidd yn ei wneud.",
        "Dylai unrhyw un sy'n mynd i yrru ar ledredau uchel neu dros fylchau mynyddoedd ystyried y posibilrwydd o eira, rhew, neu dymereddau rhewi.",
        "Ychwanegodd e \"na ddylid, fodd bynnag, gofyn iddyn nhw gymryd rhwymedigaethau sy'n mynd y tu hwnt i'w cam, cyfrifoldeb a galluoedd datblygiad\".",
        "I'r Springboks, rhoddodd derfyn ar gyfres o golli pum gêm.",
