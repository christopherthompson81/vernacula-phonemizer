// MINED NORMALIZATION CORPUS — cmn. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer. The cells
// are the empirical shape of the rules the treated languages actually needed, so coverage of them is the
// completeness criterion — not size.
//
// ⚠ THIS TIER IS NOT A FALLBACK FOR MISSING FLEURS, and this header used to say it was — unconditionally,
// in all 163 artifacts, of which 95 belong to languages that DO have a FLEURS transcript. The two sources
// are COMPLEMENTARY and neither subsumes the other: FLEURS is read-aloud running text, so it is
// frequency-shaped and mostly exercises nothing the normalizer does; this artifact is selected
// ADVERSARIALLY against the pattern cells, so it is far richer per line in exactly the shapes a
// normalization rule has to decide. A language with FLEURS is still worth mining, and most were.
//
// ⚠ SO DO NOT READ THIS FILE AS THE WHOLE HAYSTACK. Shona's layer did: it repeated the old claim and argued
// its refusals from a corpus that was missing 1,901 FLEURS transcripts, which left one count wrong by a
// factor of twenty (#1064). Count over both.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: FLEURS cmn_hans_cn + zh.wikipedia (targeted fill)
// segmentation: sentence (abbreviation dots protected before splitting)
{
    "language": "cmn",
    "source": "FLEURS cmn_hans_cn + zh.wikipedia (targeted fill)",
    "segmentMode": "sentence",
    "totalSegments": 24256,
    "cellsCovered": 32,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 72,         // in 22 treated languages
        "digit-run": 6915,     // in 19 treated languages
        "fractions": 59,       // in 18 treated languages
        "clock": 22,           // in 18 treated languages
        "signs": 881,          // in 17 treated languages
        "dotted": 29,          // in 16 treated languages
        "era-marker": 1,       // in 14 treated languages
        "year": 6855,          // in 14 treated languages
        "decimals": 865,       // in 12 treated languages
        "ordinal-latin": 11,   // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 59,           // in 9 treated languages
        "ranges": 284,         // in 7 treated languages
        "currency": 5,         // in 6 treated languages
        "abbrev": 67,          // in 6 treated languages
        "latin-in-native": 3089, // in 6 treated languages
        "percent": 743,        // in 5 treated languages
        "rate": 34,            // in 4 treated languages
        "zero-width": 2,       // in 4 treated languages
        "roman": 30,           // in 3 treated languages
        "initialism": 566,     // in 3 treated languages
        "grouped": 856,        // in 3 treated languages
        "signed-number": 21,   // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 285,    // in 3 treated languages
        "exponent": 23,        // in 24 treated languages
        "arithmetic": 17,      // in 2 treated languages
        "ampersand": 34,       // in 1 treated languages
        "iteration": 17,       // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 2,      // in 3 treated languages
        "version-dot": 2,      // in 3 treated languages
        "quote-letter": 52,    // in 4 treated languages
        "scaled-currency": 5,  // in 3 treated languages
        "ordinal-caps": 16,    // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 144 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 129
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "“弗雷德”是卫星图像问世以来，在大西洋南部和东部记录到的最强热带气旋，也是有记录以来西经 35° 以东地区的第三大飓风。" },
        { "cell": "degrees", "text": "大盆地地區和哥伦比亚高原則是乾旱少雨的地區，最乾旱時平均降雨量少於38毫米，夏季時最熱的數個禮拜溫度超過38℃。" },
        { "cell": "degrees", "text": "2℃之间，总体分布趋势为由北向南升高，由盆地向高山降低；全省各地年降水量介于358—621毫米之间，季节分布不均，夏季6—8月降水相对集中，约占全年降水量的60%，且省内降水分布受地形影响较大。" },
        { "cell": "degrees", "text": "冬季时多数地区会非常寒冷，尤其是在内陆和大平原地区，日间气温通常为−15 °C（5 °F），最冷可达−40 °C（−40 °F），风寒指数并经常处于严重水平。" },
        { "cell": "digit-run", "text": "身为国家安全顾问，他曾协助卡特处理诸多国际事务，例如 1978 年签署《戴维营协议》；在20 世纪 70 年代末实现美中关系正常化；1979 年导致伊朗人质危机的伊朗革命；1979 年苏联入侵阿富汗。" },
        { "cell": "digit-run", "text": "在 1789 年 10 月 6 日，受到惊吓的国王路易十六、王后玛丽·安托瓦内特和他们的两个孩子（11 岁的玛丽·特蕾莎和 4 岁的路易斯·查尔斯），以及国王的妹妹伊丽莎白夫人，被一群集市妇女从凡尔赛赶回了巴黎。" },
        { "cell": "digit-run", "text": "北部，或者说森蒂纳尔岭，拥有南极洲最高的山脉文森山脉，最高峰是 4892 米的文森峰。" },
        { "cell": "digit-run", "text": "公园占地 19500 平方公里，分为 14 个不同的生态区，为不同的野生动植物提供支持。" },
        { "cell": "fractions", "text": "虽然没有人能确定作者是谁，但这个大型羊皮纸文档（尺寸为 29¾ 英寸乘以 24½ 英寸）据称在刚写成的时候是卷起来存放的。" },
        { "cell": "fractions", "text": "自加拿大建国以来，人口中心正在逐渐向西扩张，1871年时大部分的加拿大人住在东部的四个省份（安大略，魁北克，新不伦瑞克和新斯科舍），而2016年普查表明，将近1/3的人口住在草原三省以及西部（马尼托巴，萨斯喀彻温，阿尔伯塔和卑诗）。" },
        { "cell": "fractions", "text": "移民是该国人口增长的主要因素（约占2/3），而另外1/3则为自然生育。" },
        { "cell": "fractions", "text": "倘若违规行为发生在首回合，一般情况下处理方式为直接没收首回合比赛并取消次回合（参见：2015/16西班牙国王杯，皇家马德里被驱逐。" },
        { "cell": "clock", "text": "全天都有公交车从城区间公交站（跨河）发车，但大部分车次，特别是开往东部和贾卡尔/布姆唐的公交车都在 06:30 至 07:30 之间发车。" },
        { "cell": "clock", "text": "它能向后兼容 802.11a、802.11b 和 802.11g，前提是基站要有双无线电。" },
        { "cell": "clock", "text": "802.11n 的速度大大快于前代技术，最大理论吞吐量可达 600Mbit/s。" },
        { "cell": "clock", "text": "抗议活动于当地时间 11:00 (UTC+1) 左右在白厅 (Whitehall) 开始，白厅对面是首相官邸唐宁街的入口处，由警察看守。" },
        { "cell": "signs", "text": "在 2010 年联邦大选之前曾对 1,400 名受访者做过调查，受访者中反对澳大利亚成为共和国的人数自 2008 年以来增长了 8%。" },
        { "cell": "signs", "text": "多亏有了与欧洲相连的海底光缆和宽带卫星，格陵兰网络连接畅通，93% 的人口接入了互联网。" },
        { "cell": "signs", "text": "纳达尔（Nadal ）在比赛中把 88% 的净胜分收入囊中，在第一个发球局赢得 76 分。" },
        { "cell": "signs", "text": "这些措施包括金融限制和欧盟对原油出口的禁令，而伊朗经济有 80% 的国外收入来自原油出口。" },
        { "cell": "dotted", "text": "簡稱“the U.S.”，“the US”或者“the States”。" },
        { "cell": "dotted", "text": "库印的上方是首都的地名“WASHINGTON,D.C.”（文中所讲的是指1美元和2美元面值纸钞，下文所讲的行印现其他的面值都是直接写字母数字组合） 行印（BANK SEAL）。" },
        { "cell": "dotted", "text": "J. F. Archibald創辦的《公報》雜誌，提出澳大利亞屬於澳大利亞人的口號，宣傳眾人平等的觀念，具有社會主義的色彩。" },
        { "cell": "dotted", "text": "E.Y./P2 Hub（W.G. Young Hall路对面，停车楼旁）。" },
        { "cell": "era-marker", "text": "10月10日——美國總統比尔·克林顿簽署《H.R.4444號法案》，確立美國與中華人民共和國之間正常貿易關係。" },
        { "cell": "year", "text": "“他在 2000 年制作的第 1000 张邮票取材自大卫·克洛克·埃伦斯特拉尔的名画《瑞典国王的伟大功绩》，并因此入选《吉尼斯世界纪录大全》。”" },
        { "cell": "year", "text": "葡萄牙人毁灭了这座城并进行了重建，还将其命名为卡萨布兰卡 (Casa Branca) ，直到 1755 年地震后才遗弃了它。" },
        { "cell": "year", "text": "早先于全球发布的华硕 Eee PC 个人笔记本，因成本节约及功能性因素，成为 2007 年台北 IT 资讯月备受瞩目的话题。" },
        { "cell": "year", "text": "基什内尔女士在阿根廷大剧院宣布她有意参加总统竞选，2005 年也是在这里，她作为布宜诺斯艾利斯省代表开始竞选参议员。" },
        { "cell": "decimals", "text": "目前还没有发布海啸预警。根据雅加达地质局的说法，由于此次地震没有达到 6.5 级，因此不会发布海啸预警。" },
        { "cell": "decimals", "text": "太空舱将以每秒约 12.8 公里（8 英里）的速度飞行，速度之快，足以在一分钟内从旧金山飞到洛杉矶。" },
        { "cell": "decimals", "text": "这两颗都超过 1,000 磅的卫星以每小时 17,500 英里的速度飞行，在距离地球 491 英里的上空相撞。" },
        { "cell": "decimals", "text": "预计大部分赛事的门票价格将在 2,500 日元到 13 万日元之间，一般票价约为 7,000 日元。" },
        { "cell": "ordinal-latin", "text": "8th enlarged edition." },
        { "cell": "ordinal-latin", "text": "& Wilson, Mark V.H. Fishes of the World (5th ed." },
        { "cell": "ordinal-latin", "text": "Middle East Conflicts from Ancient Egypt to the 21st Century: An Encyclopedia and Document Collection." },
        { "cell": "ordinal-latin", "text": "\" Histoire \", Paris, 2000 (1re éd." },
        { "cell": "units", "text": "例如，世界上最常见的静态图像摄影格式是 35mm 格式，这是胶片电影时代末期占主导地位的电影尺寸。" },
        { "cell": "units", "text": "这样一来，分辨率几乎达到了 35 mm 底片（3136 mm2 对 864）的四倍。" },
        { "cell": "units", "text": "一些中画幅胶片相机使用 6x6cm 的画幅，更准确地说，是 56x56mm 的底片。" },
        { "cell": "units", "text": "多年来，人们使用过很多不同的胶片格式。标准 35mm 胶片（36x24mm 底片）是最常见的。" },
        { "cell": "ranges", "text": "德尔·波特罗（Del Potro）在第二盘刚开局时就占上风，但在比分达到 6-6 后就得进行抢七大战。" },
        { "cell": "ranges", "text": "事件发生的时代通常被称为欧洲史的中世纪盛时，即的 11、12 和 13世纪时期（公元 1000-1300 年）。" },
        { "cell": "ranges", "text": "睡眠中断是指这样的过程：在正常睡眠期间有意地醒来，并且在短时间之后（10-60分钟）睡着。" },
        { "cell": "ranges", "text": "在华盛顿队以 5-3 的比分战胜亚特兰大鸫鸟队的比赛中，他贡献了 2 个进球和 2 次助攻。" },
        { "cell": "currency", "text": "這個不公平競爭行為引起了四面八方的球迷的譴責之聲，於是老虎杯比賽結束後，FIFA向兩隊判罰$40,000美元的罰款（原因：違反公平比賽競爭），結果此球員隨之而來的就是被終身禁止參加國際賽（成了世界第一個球員因為射進烏龍球而被終身禁賽的球員）、國內聯賽禁賽一年。" },
        { "cell": "currency", "text": "然而尼克森還是在10月18日向美國國會請求提供了以色列$22億元的軍火。" },
        { "cell": "currency", "text": "加拿大的人均国内生产总值（购买力评价）估计为$52,085美元（2021年），为世界第11大经济体。" },
        { "cell": "currency", "text": "索科羅縣的住戶收入中位數為$23,439，而家庭收入中位數則為$29,544。" },
        { "cell": "abbrev", "text": "然而，他重申了先前的声明，即罗伊诉韦德案（Roe v. Wade）是“美国的既定法律”，并强调最高法院作出一致性裁决的重要性。" },
        { "cell": "abbrev", "text": "美国政府 美国历史年表 美国宪法 美利堅聯盟國 [编] 《清史稿/卷156》，出自趙爾巽《清史稿》 美國新國會宣誓就職誓詞歷經修改（页面存档备份，存于互联网档案馆） 美国政府官方网站（页面存档备份，存于互联网档案馆） 白宫网站（页面存档备份，存于互联网档案馆） 参议院网站（页面存档备份，存于互联网档案馆） 众议院网站（页面存档备份，存于互联网档案馆） 美国最高法院网站 美国. The World Factbook 2026." },
        { "cell": "abbrev", "text": "ISSN 1000-422X. NCPSSD 1003106319." },
        { "cell": "abbrev", "text": "当美国海军将领约翰·斯洛特（John D. Sloat）从旧金山湾进入加利福尼亚后，这个年轻的共和国被宣布成为美国的领土。" },
        { "cell": "latin-in-native", "text": "此前，铃声 (Ring) 公司 CEO 杰米·西米诺夫曾表示，公司成立之初，他在位于车库的工作室里是听不到门铃响声的。" },
        { "cell": "latin-in-native", "text": "\"布什政府发言人戈登·约翰德罗 (Gordon Johndroe) 称朝鲜的承诺是\"朝着实现朝鲜半岛可核查的无核化目标迈出的重要一步\"。\"" },
        { "cell": "latin-in-native", "text": "在布法罗-匹兹堡高速公路上，行车条件最具挑战性的是波特马里恩 (Point Marion) 到费尔蒙特 (Fairmont) 之间的路段，这段路频繁地途径多处偏僻的边远地区。" },
        { "cell": "latin-in-native", "text": "日本广播协会 (NHK) 还报道说，位于新泻县的柏崎刈羽 (Kashiwazaki Kariwa) 核电站运行正常。" },
        { "cell": "percent", "text": "投票存在两极分化的情况，29% 的受访者认为澳大利亚应该尽快成立共和国，31% 的人则认为澳大利亚永远不应该成立共和国。" },
        { "cell": "percent", "text": "这不是学习能力缺失，而是学习障碍；这“影响着全美儿童的 3% 到 5%，人数可能多达 200 万”。" },
        { "cell": "percent", "text": "前马萨诸塞州州长米特·罗姆尼星期二以超过 46% 的选票在佛罗里达州的共和党总统初选中获胜。" },
        { "cell": "percent", "text": "6%，为世界上人口第二多的国家，仅次于印度並在2023年以前長期居於世界第一。" },
        { "cell": "rate", "text": "表演开始五分钟后，刮起了风，约一分钟后，风速达到了 70 公里/小时……紧接着又下起了雨，雨势如此之大，像针扎一样拍打在皮肤上，随后天上下起了冰雹，惊慌失措的人群尖叫着四散奔逃。" },
        { "cell": "rate", "text": "由于“黑美人”的底盘过低，新西兰警方没法用测速雷达枪来检测里德先生的车速。警方唯一一次成功检测到里德先生的车速，是在他将车速降到 160 公里/小时的时候。" },
        { "cell": "rate", "text": "这些怪物般的风暴，风速高达每小时 480 公里（133 m/s; 300 mph）。" },
        { "cell": "rate", "text": "公园的管理人员表示：与熊和狼至少要保持 100 码/米的距离，而与所有其他野生动物则需要保持 25 码/米的距离！" },
        { "cell": "zero-width", "text": "開普半島以北的沿海地帶西面是大西洋，而東面是​​一排南北向的山脈。" },
        { "cell": "zero-width", "text": "NEOS－新奥地利和自由论坛名列第四​​，有10个席位，彼得·皮尔兹名单（在选战开始时与绿党）第一次进入议会，排在第五位，拥有8个席位。" },
        { "cell": "roman", "text": "在由茅茅运动为争取独立而组织发起的斗争中，该镇的一场和平集会致使大酋长图普阿·塔马塞塞·利罗菲三世（Tupua Tamasese Lealofi III）遇害身亡。" },
        { "cell": "roman", "text": "並且正在研發6代戰機（F/A-XX/次世代制空權） 除夏威夷外，其余49個州都位於美洲大陸。" },
        { "cell": "roman", "text": "真双子叶植物 eudicots 核心真双子叶植物 core eudicots 蔷薇类植物 rosids 豆类植物 fabids（真蔷薇一类植物 eurosids I） 锦葵类植物 malvids（真蔷薇二类植物 eurosids II） 菊类植物asterids 唇形类植物 lamiids（真菊一类植物 euasterids I） 桔梗类植物 campanulids（真菊二类植物 euasterids II） 下面是APG IV分类法真双子叶植物分支中详细的各目。" },
        { "cell": "roman", "text": "其后所有材料经过数字化后进行数字存储，而数字副本返回原始持有者以及在互联网档案进行复制，如果不是公共领域中的内容，可在遵循首次销售原则的受控数字借阅（CDL）理论的前提下，每次借给世界各地的一个顾客。" },
        { "cell": "initialism", "text": "在美国的各个地区，约有 40 万例多发性硬化症 (MS) 病例，这一疾病已经成为中青年的主要神经系统疾病。" },
        { "cell": "initialism", "text": "克鲁格国家公园 (KNP) 位于南非东北部，东部与莫桑比克接壤，北部与津巴布韦接壤，南部以鳄鱼河 (Crocodile River) 为边境。" },
        { "cell": "initialism", "text": "在国家公园野生动物管理局（NPWS）和澳大利亚射击运动员协会（NSW）的合作中，射击运动员协会为狩猎计划招募了合格的志愿者。" },
        { "cell": "initialism", "text": "这是马特利 (Martelly) 四年来第五次入选海地临时选举委员会 (CEP)。" },
        { "cell": "grouped", "text": "土耳其的国土面积（包括湖泊）为 783,562 平方公里（300,948 平方英里），其中 755,688 平方公里（291,773 平方英里）位于西南亚，23,764 平方公里（9,174 平方英里）位于欧洲。" },
        { "cell": "grouped", "text": "根据《Fray Bartolomé de las Casas》（Tratado de las Indias），1492 年至 1498 年间，西班牙侵略者杀害了约 100,000 台诺人。" },
        { "cell": "grouped", "text": "在已知的大约 24,000 块坠落至地球的陨石中，经核实只有 34 块是来自火星。" },
        { "cell": "grouped", "text": "其中一些岩石在地球上非常稀有，售价在每盎司 11,000 美元到 22,500 美元之间，比黄金的价格高出约十倍。" },
        { "cell": "signed-number", "text": "9 °F）在1987年6月26日基爾肯尼郡測得，而記錄的最低溫度為攝氏 -19." },
        { "cell": "signed-number", "text": "据有气象纪录以来的统计，斯德哥尔摩的最高温度是+38 °C（100 °F），最低温度是-32 °C（-26 °F)。" },
        { "cell": "signed-number", "text": "四季的典型温度如下： 冬天：-7 °C到+2 °C (19到36 °F) 春天：+5 °C到+15 °C (41到59 °F) 夏天：+20 °C到+25 °C (68到77 °F)有时更热一点 秋天：+5 °C到+18 °C (41到64 °F) 斯德哥尔摩城所在的行政区是斯德哥尔摩省的一个市镇斯德哥尔摩市镇。" },
        { "cell": "signed-number", "text": "为了更好地了解最近十年的冬季，先来看看1956年2月记录到的都灵历史最低气温： 1956年2月12日：-21." },
        { "cell": "letter-name", "text": "29 岁的 Malar Balasubramanian 医生在俄亥俄州辛辛那提市以北约 15 英里的郊区布鲁艾施被发现，她被找到时身穿 T 恤衫和内裤，躺在路边的地上，看上去服用了大量药物。" },
        { "cell": "letter-name", "text": "罗兰多·门多萨 (Rolando Mendoza) 架起他的 M16 步枪对游客扫射。" },
        { "cell": "letter-name", "text": "今天，A1GP 新西兰队副驾驶约翰·里德 (Jonny Reid) 在合法驾驶的情况下，成为在有 48 年历史的新西兰奥克兰海港大桥上行驶最快的人，从而创造了历史。" },
        { "cell": "letter-name", "text": "英国皇家防止虐待动物协会 (RSPCA ) 新南威尔士州总督察大卫·奥沙纳西 (David O'Shannessy) 告诉 ABC，在澳大利亚监管和视察屠宰场应该是司空见惯的事。" },
        { "cell": "exponent", "text": "2004年，羅蘭·斯庫曼、林登·弗恩斯、達里安·湯森以及里克·内特林的游泳隊贏得2004年雅典奧運會的金牌，同時打破了4×100自由式接力賽的世界紀錄。" },
        { "cell": "exponent", "text": "北領地（North Territory，简称为NT），面积1,349,129 km²，首府達爾文（Darwin） 澳大利亚首都位於堪培拉。" },
        { "cell": "exponent", "text": "德国国土面积在欧洲居第七位，总面积为357,021 km²，其中陆地面积349,223 km²，水域面积7,798 km²。" },
        { "cell": "exponent", "text": "铁矿、煤矿、钾盐、木材、褐煤、铀矿、铜矿、天然气、盐矿、镍矿、耕地和水能 德国土地总面积357,021平方公里，其中包括4,750 km²水田和7,798 km²水资源，最大的湖泊分别是博登湖（总面积536 km²）、米里茨湖（117 km²）和基姆湖（80 km²）。" },
        { "cell": "arithmetic", "text": "如果積分名次相同，通常會按下列比序： 全賽數據比較 全賽獲得積分 全賽球差 全賽進球、然後是客場進球數 全賽勝負、然後是客場勝仗 相關球隊數據比較 比較相關球隊之間賽事獲得的積分 比較相關球隊之間賽事的球差 比較相關球隊之間賽事的進球 如果只有兩隊完全相同且最後一輪相遇進行PK大戰 纪律分：黃牌计作1分，2黃1紅计作4分，直接紅牌计作4分，先黄后直红计作1+4=5分，被计分少的排名靠前。" },
        { "cell": "arithmetic", "text": "除此之外，「佳片250」還套用精算學的「可信度公式」，對評分作加權評級，獨立資料的數量越大（在此就是指合格用戶的評分），統計處理後的可信度越高，IMDb原以下列公式計算加權評級（IMDb不公開現時公式）： W = R v + C m v + m {\\displaystyle W={\\frac {Rv+Cm}{v+m}}} 以上： W {\\displaystyle W\\ } =加權評級 R {\\displaystyle R\\ } =電影從0到10的平均分數（Rating） v {\\displaystyle v\\ } =評分人次（Votes） m {\\displaystyle m\\ } =進入名單的最少評分人次（目前為25000票） C {\\displaystyle C\\ } =全名單平均分數（目前維持在7." },
        { "cell": "arithmetic", "text": "近年来，舟山市主要发展为以绿色石化为首，以船舶海工、海洋生物、海洋电子信息、现代渔业为辅的“1+4”标志性产业。" },
        { "cell": "arithmetic", "text": "烏克蘭電視台有乌克兰国家电视1台、国际电视台、新频道、1+1、ICTV、五频道和基辅电视台等。" },
        { "cell": "ampersand", "text": "Match PES PES 2019 eFootball 2024 实况足球 胜利十一人(Winning Eleven 2012) 职业进化足球(Pro Evolution Soccer 2012) 創造球會(Sakatsuku) FIFA系列(FIFA 14)(FIFA 15)(FIFA 16)（FIFA Online3）（FIFA Online4） 足球经理人(Football Manager 2012) 冠军足球经理(Championship Manager 2009) 最佳11人足球经理，网页游戏(FREEKICK) 足球、策略与荣耀(Football, Tactics & Glory) 《七擒七縱七金剛》，以英格蘭足總盃配合盜金庫行動，由大衛尼雲主演。" },
        { "cell": "ampersand", "text": "在研究和開發（R&D）花費指數上，以色列是第三高的國家，在科技準備（產業界在R&D上的花費、科研社群的創造力、個人電腦和網路覆蓋率）上則是第八，在科技創新上是第十一，高科技出口總額上是第十六。" },
        { "cell": "ampersand", "text": "事实上，除了菲亚特是在都灵成立以外，还有很多企业是在都灵成立的，如电信企业皮埃蒙特水电公司SIP即后来的意大利电信，Seat黄页，EIAR即后来的RAI，Lavazza，Azimut Yachts，Cirio，工业保险公司，王家互助保险，公牛保险，蓝旗亚，乔治亚罗意大利设计室，吉亚，Italgas，Bertone，宾尼法利纳，Farid（欧洲领先的生产垃圾收集工具的公司），Caffarel（成立于1826年，世界首家巧克力工厂），Carpano（发明苦艾酒的公司），Martini & Rossi，Aurora，波旁，Brooksfield，Fisico，Invicta，卡帕，Superga，Jaggy，Carlo Pignatelli，Kristina Ti，Lancetti，De Fonseca。" },
        { "cell": "ampersand", "text": "同一種生物有可能有許多俗名，有的俗名使用較為廣泛，例如：學名Gambusia affinis (Baird & Girard, 1853) ，俗名食蚊魚、大肚仔、胎鱂、大肚魚，其中以「食蚊鱼」最为广泛。" },
        { "cell": "iteration", "text": "下為一些用例： คนอ้วน（khon uan, [kʰon ʔûan ]），意即「一個胖子」 คนอ้วน ๆ（khon uan uan, [kʰon ʔûan ʔûan]），意即「一個非常胖/較為胖的人」 คนที่อ้วนเร็วมาก（khon thi uan rew mak, [kʰon tʰîː ʔûan rew mâːk]），意即「一個胖得非常快的人」 คนที่อ้วนเร็วมาก ๆ（khon thi uan rew mak mak, [kʰon tʰîː ʔûan rew mâːk mâːk]），意即「一個胖得非常非常快的人」 比較級藉由「A X กว่า B」（kwa, [kwàː]）的句型來表達，其意為「A比B還X」。" },
        { "cell": "iteration", "text": "名詞既非單數，亦非眾數，不過一些名詞可藉疊詞來構造集合形，像 เด็ก（dek，意即「小孩」）這個詞就常藉由其疊詞形 เด็กๆ（dek dek）來表「一群小孩」之意。" },
        { "cell": "iteration", "text": "现时，很多人在手写时仍会非正式的使用叠字符号“々”来表示重复的汉字，如「謝謝」写作「謝々」。" },
        { "cell": "iteration", "text": "台湾日治时期的遗迹也使用过「々」，如台语「天烏烏」写作「天烏々」或「天烏〃」，因为不是正写法，所以没有在正式文件中使用。" },
        { "cell": "sports-time", "text": "她的另一项比赛是大回转，在女子站姿组中以 4:41.30 分钟的总成绩名列第十，比排名第一的奥地利选手克劳迪娅·罗什慢了 2:11.60 分钟，比排名第九的匈牙利选手巩基·达尼慢了 1:09.02 分钟。" },
        { "cell": "sports-time", "text": "舉例來說，如果在春季的午夜時分調快1小時，以數字顯示的本地時間將會從11:59:59." },
        { "cell": "quote-letter", "text": "“莱顿 (Layton) 在与首相会面期间要求修改保守党的环境法案，他要求‘彻底重写’保守党的环境法案。”" },
        { "cell": "quote-letter", "text": "“美国表示，他们收到了来自一名不愿公开身份的人士提供的信息，其中专门提到了通过自杀炸弹袭击者炸毁埃塞俄比亚和肯尼亚的‘著名地标’。”" },
        { "cell": "quote-letter", "text": "澳大利亚新州国家公园和野生动物服务中心（NPWS）保护和遗产管理处代理主任米克·奥弗林（Mick O’flynn）表示：选中参与第一次射击行动的四名枪手均已接受全面的安全及培训指导。" },
        { "cell": "quote-letter", "text": "（简体中文）中华人民共和国中央人民政府门户网站 （页面存档备份，存于互联网档案馆） （简体中文）中国网 （页面存档备份，存于互联网档案馆） （简体中文）中华人民共和国文化和旅游部 （页面存档备份，存于互联网档案馆） （简体中文）中华人民共和国外交部 （页面存档备份，存于互联网档案馆） （简体中文）中华人民共和国自然资源部 （页面存档备份，存于互联网档案馆） 維基媒體的the People's Republic of China地圖集 開放街圖上有關中华人民共和国的地理信息 美利堅合眾國（英語：United States of America，縮寫：USA），简称美国、美利堅（英語：America）或合眾國（英語：United States，縮寫：US），是位於北美洲的聯邦制共和國。" },
        { "cell": "scaled-currency", "text": "男性的收入中位數為$28,490，而女性的收入中位數則為$22,482。" },
        { "cell": "ordinal-caps", "text": "截至2023年 (2023-Missing required parameter 1=month!" },
        { "cell": "ordinal-caps", "text": "org/assets/af0248bce6/20090306-Traditional-Chinese-translation-of-ICZN-Code4." },
        { "cell": "ordinal-caps", "text": "截至2009年 (2009-Missing required parameter 1=month!" },
        { "cell": "ordinal-caps", "text": "1996-2007年 （截至2019年 (2019-Missing required parameter 1=month!" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "“我姐姐和她的朋友不见了，路上有两个残疾人坐着轮椅，有人跳过去帮他们推轮椅”，阿尔芒·范思哲说道。",
        "仅靠适当的营养实践并不足以造就出色表现，但这可以显著影响年轻运动员的整体健康状况。",
        "1991年苏联解体后，冷戰結束，美国至此成为世界上唯一的超级大国。",
        "1933年和1949年，加拿大民事案件和刑事案件的终审权分别从英国枢密院司法委员会移交至加拿大最高法院。",
        "1960年代以前，加州長期由共和黨主政，1960年代以後，加州的選民逐漸以民主黨人居多，民主黨在1970年起控制州議會，除了1995－1996年因共和黨革命使共和黨一度得以控制兩年的州議會，但此後民主黨在州議會掌握絕對多數。",
        "地中海沿岸的海岸平原從北部的黎巴嫩邊界一直延伸至南部的加薩，該地區土壤肥沃而潮濕，是農業和水果栽種的重要地帶。",
        "在種族隔離結束後，南非的水資源獲取水平有所提高，由1990年到2010年間，獲取水的人數從66%增至79%。",
        "6月下旬，德國第二軍團砲兵向弗勒里、蘇伊堡、貝爾維爾嶺的法軍砲兵陣地發射光气，然而不斷砲轟法軍陣地。",
        "澳洲建筑业很注重节能环保，法律严格規定了许多建材用料的标准。",
        "斯德哥尔摩大学 皇家工学院 卡罗琳斯卡医学院 斯德哥尔摩皇家音乐学院（Kungliga Musikhögskolan i Stockholm） 斯德哥尔摩皇家艺术学院（Kungliga Konsthögskolan i Stockholm） 谢德托尔学院（Södertörns högskola） 斯德哥尔摩戏剧学院（Teaterhögskolan i Stockholm） 斯德哥尔摩工艺美术学院（Konstfack, University College of Arts, Crafts and Design） 斯德哥尔摩经济学院 斯德哥尔摩是20%的瑞典人的家乡。",
        "西南部为雉鸡场山，南部为伊勒呼里山，西北部为额木尔山。",
        "云南几乎集中了从热带、亚热带至温带甚至寒带的植物品种。",
        "2006年东北大鼓被列为国家级非物质文化遗产。",
        "如“解放海南岛”应该改成“海南岛战役” 简要性原则：如使用“唐诗”，而不用唐代诗文。",
        "都道府縣下的行政區劃為市町村，此外還有郡、支廳、區、特別區等行政單位。",
        "在大革命爆发前，法国的新古典主义建筑有先贤祠和图卢兹市政厅。",
        "之後3個月，民主國軍和日軍發生不少規模不小的血戰，並造成14,000名臺灣兵戰死，史稱「乙未戰爭」，同時也是臺灣史上最大的一場戰爭。",
        "20世纪及21世纪德国流行音乐形式与运动包括新德国浪潮、流行、东方摇滚、重金属/摇滚里最有影响力的乐队是德国战车(Rammstein)、朋克、流行摇滚、独立及施拉格流行等。",
        "俄罗斯文化是指俄罗斯族及其余生活在俄罗斯帝国、前苏联及近现代俄罗斯境内各民族的文化。",
        "雖然混凝土早在1,000年前就在近東地區被發明出來了，但是羅馬人善於利用材料的強度及低廉的成本，將它的使用範圍從城寨擴展到最令人印象深刻的建築物與古蹟。",
        "」 诸多优待政策的初衷主要是为了保证兵源、加强八旗的军事职能。",
        "在台灣，著作權法賦予著作財產權與著作人格權。",
        "另外，選民除非有合理的解釋，否則不得不去投票，違者很可能被警察監視和查問。",
        "第二个是计算机网络访问设备，通过他们而实现的计算机间直接数据传送极大地提升了计算机的价值。",
        "由於其耐久性，鈦已成為更受設計師歡迎的珠寶（尤其是鈦戒指）。",
        "砂拉越、北婆罗洲和文莱一并被日本划入北婆罗地区（日語：北ボルネオ），由日本陆军第37軍负责防御，驻地设于古晋（日本称久镇）。",
        "現代四川汉族大部份無宗教信仰或信奉中国民间信仰，佛教及道教，另有少量的基督徒及穆斯林。",
        "然而，就在30歲生日當天，Nop卻因為恐懼Ja對未來的規劃會奪走他的自由，提出了「分手一段時間」。",
        "荷蘭加勒比區是属于荷蘭本土的三個特別行政區：博奈爾島、聖尤斯特歇斯島和薩巴島的集體名稱，又稱BES島嶼。",
        "每十年舉行的人口普查決定來年的總統選舉各州的選舉人團票數和眾議院議席。"
    ]
