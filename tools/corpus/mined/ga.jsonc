        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 30,           // in 9 treated languages
        "ranges": 14,          // in 7 treated languages
        "currency": 7,         // in 6 treated languages
        "abbrev": 91,          // in 6 treated languages
