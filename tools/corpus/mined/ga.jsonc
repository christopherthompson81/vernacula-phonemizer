        "quote-letter": 262,   // in 4 treated languages
        "scaled-currency": 6,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 121 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 0
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Sna fothrópaic atá Montevideo suite; ní gnách don teocht fanacht faoi +30°C i míonna an tsamhraidh." },
        { "cell": "degrees", "text": "Is é Fred an cioclón trópaiceach is láidre a taifeadadh ó thús na n-íomhánna satailíte atá chomh fada sin ó dheas agus soir san Atlantach, agus is é an tríú mór-hairicín ar taifead atá soir ó 35°W." },
        { "cell": "digit-run", "text": "As 1,400 duine a ndearnadh pobalbhreith orthu roimh thoghchán cónaidhme 2010, tháinig méadú 8 faoin gcéad ó 2008 i leith ar líon na ndaoine a chuireann i gcoinne na hAstráile a bheith ina poblacht." },
        { "cell": "digit-run", "text": "Thug drong ban margaidh ar an Rí Louis XVI, an Bhanríon Marie Antoinette, a mbeirt leanaí óga (Marie Therese 11 bhliain d’aois agus Louis-Charles ceithre bliana d’aois) agus deirfiúr an Rí, Madam Elizabeth, iad uile sceimhlithe, filleadh ar Pháras ó Versailles ar an 6 Deireadh Fómhair 1789." },
        { "cell": "digit-run", "text": "An míliú stampa a rinne sé ná an ceann iontach \"Great Deeds by Swedish Kings\" le David Klöcker Ehrenstrahl in 2000, a liostaíodh sa Leabhar Guinness de Churiarrachtaí Domhanda." },
        { "cell": "digit-run", "text": "Faoi dheireadh, cuireadh rothaí iarainn in ionad rothaí adhmaid. Sa bhliain 1767, tugadh isteach na chéad ráillí uile-iarainn." },
        { "cell": "fractions", "text": "Cé nach fios go cinnte cé a scríobh é, tá a fhios againn go ndearnadh an doiciméad páir mhór (atá 29¾ orlach faoi 24½ orlach) a rolladh suas lena stóráil go luath ina shaol." },
        { "cell": "fractions", "text": "Ba chóir don phátrún a bheith domhain go leor, 5 mm (1/5 orlach) nó níos mó, agus an t-ábhar bog go leor i dteochtaí fuara." },
        { "cell": "clock", "text": "Idir 10:00-11:00 i.n. MDT, lasadh tine sa chlós ag na príosúnaigh." },
        { "cell": "clock", "text": "Cuirfidh sé seo ar a chumas a bheith comhoiriúnach go siarghabhálach le 802.11a, 802.11b agus 802.11g, ar choinníoll go bhfuil dé-raidiónna ag an mbunstáisiún." },
        { "cell": "clock", "text": "Oibríonn caighdeán 802.11n ar mhinicíochtaí 2.4Ghz agus 5.0Ghz araon." },
        { "cell": "clock", "text": "Ar dheireadh thiar mhúch na foirne dóiteáin an tine faoi 11:35 i.n." },
        { "cell": "signs", "text": "Bhí sé i mbun nótaí bainc a ghreanadh ar son iliomad tíortha, samplaí le déanaí dá chuid oibre ná na portráidí an phríomh-aire atá chun tosaigh ar na nótaí nua $5 agus $100 i gCeanada." },
        { "cell": "signs", "text": "Áirítear orthu srianta airgeadais agus toirmeasc ón Aontas Eorpach ar easpórtáil amhola, óna bhfaigheann geilleagar na hIaráine 80% dá ioncam eachtrach." },
        { "cell": "signs", "text": "Tá cuid de na carraigeacha, atá fíor-annamh ar an Domhan, á ndíol ar US$11,000 go $22,500 an unsa, atá thart ar deich n-uaire níos mó ná costas an óir." },
        { "cell": "signs", "text": "Thosaigh an agóid timpeall 11:00 am na háite (UTC+1) ar Whitehall os comhair na slí isteach i Sráid Downing Street, áit chónaithe oifigiúil an Phríomh-Aire. Bhí an tslí isteach faoi chosaint ag póilíní." },
        { "cell": "dotted", "text": "Tá súil ag na N.A. ciste a chur i gcrích chun cabhrú le tíortha atá thíos leis an téamh domhanda déileáil lena iarmhairtí." },
        { "cell": "dotted", "text": "Ba iad muintir na nOileán Filipíneach féin a d'íoc as na costais chogaidh a ghabh le himpiriúlachas na S.A. agus iad ag iarraidh na hOileáin Fhilipíneacha a chur faoi chois." },
        { "cell": "dotted", "text": "Ba sa chuan seo a tharla sáinn míchlúiteach in 1889 nuair a dhiúltaigh seacht long ón nGearmáin, ó na S.A. agus ón mBreatain an cuan a fhágáil." },
        { "cell": "dotted", "text": "Bhí cáil air mar chroílár an tsómais ó 400 A.D. amach go dtí thart ar 1100 A.D." },
        { "cell": "era-marker", "text": "Ag naoi nóiméad déag tar éis a seacht (09:19 p.m. GMT Dé hAoine) ar maidin a bhuail an crith talún Mariana." },
        { "cell": "era-marker", "text": "Ag 8:46 r.n. ag an bpointe, chiúnaigh an chathair ina tost, á leagan síos an nóiméad díreach céanna inar bhuail an chéad scairdeitleán a sprioc." },
        { "cell": "era-marker", "text": "Bhíodh saigheada a gcrosbhoghanna marfacha in ann dul trí chathéide shaighdiúrí an naimhde. Timpeall 1000 R.C., thug na hAisiriaigh isteach an chéad mharcra." },
        { "cell": "era-marker", "text": "Bhuail crith talún measartha iarthar Montana ag 10:08 i.n. Dé Luain." },
        { "cell": "year", "text": "Scrios na Portaingéalaigh é agus rinne siad é a atógáil faoin ainm Casa Branca, ach tréigeadh é tar éis crith talún i 1755." },
        { "cell": "year", "text": "Mar Chomhairleoir Slándála Náisiúnta, chuidigh sé le Carter cursaí an tsaoil a láimhseáil go cáiréiseach, amhail Comhaontuithe Camp David i 1978; caidrimh SAM-an tSin a shocrú go normálta ar feadh blianta deiridh na 1970idí; Réabhlóid na hIaráine as a d'eascair géarchéim na ngiall in Iaráin i 1979; agus ionradh na Sóivéadach ar an Afganastáin i 1979." },
        { "cell": "year", "text": "Mar shampla, deirtear gurb iad \"foghlaim\" agus \"sóisialú\" a spreagann mórchuid daoine leis an idirlíon a úsáid (James et al., 1995)." },
        { "cell": "year", "text": "Bhí an ASUS Eee PC, ar lainseáladh go domhanda níos luaithe é ar chúinsí costais agus feidhmíochta, ina ábhar mór cainte ag an ócáid Taipei IT Month in 2007." },
        { "cell": "decimals", "text": "Tá thart ar 400,000 cás de Scléaróis Iolrach (MS) ar fud Stáit Aontaithe Mheiriceá, a fhágann gurb é an galar néareolaíoch is coitianta a tholgann daoine fásta óga agus meánaosta." },
        { "cell": "decimals", "text": "Tá thart ar 7,000 oileán sa tSeapáin (is é Honshu an ceann is mó), rud a fhágann gurbh í an tSeapáin an 7ú oileán is mó ar domhain!" },
        { "cell": "decimals", "text": "Clúdaíonn an pháirc 19,500 km² agus tá sé roinnte ina 14 éicichrios ar leith, gach ceann acu ina thaca d'fhiadhúlra difriúil." },
        { "cell": "decimals", "text": "Is cosúil go ndearnadh ceansú ar ghabhair den chéad uair thart ar 10,000 bliain ó shin i Sléibhte Zagros na hIaráine." },
        { "cell": "ordinal-latin", "text": "Tá níos mó ná náisiún amháin a mhaíonn gur talamh dá chuid é Inse Shealtainn Theas, ar thángthas air den chéad uair in 1819. Tá an líon is mó bunáiteanna ar na hoileáin, sé cinn déag a bhí gníomhach in 2020.." },
        { "cell": "ordinal-latin", "text": "Rinneadh duine cáiliúil as nuair a aimsíodh an tuama sa bhliain 1922. Cé gur robáladh go leor tuamaí san am atá thart, fágadh an tuama seo beagnach mar a bhí." },
        { "cell": "ordinal-latin", "text": "Faightear an smugairle cuachach in aice le tránna agus in aice le hinbhir abhann ó Dheireadh Fómhair go hAibreán ar an taobh thuaidh de 1770. Bíonn siad ann corruair taobh amuigh de na hamanna sin." },
        { "cell": "ordinal-latin", "text": "Scríofa ar chúl Fhorógra Saoirse Mheiriceá bhí na focail \"Original Declaration of Independence dated 4th July 1776\". Tá an téacs le feiceáil ag bun an doiciméid, bunoscionn." },
        { "cell": "units", "text": "Mar shampla, is í 35mm an fhormáid grianghrafadóireachta íomhá shocair is coitianta atá ar domhan, arb í sin an mhéid is mó úsáide sa scannánaíocht ag deireadh ré na scannán analógach." },
        { "cell": "units", "text": "Tiús 70 cm atá sa screamh ar an taobh is gaire dúinn agus tiús 100 km atá ar an taobh thall." },
        { "cell": "units", "text": "Bhí an taispeántas ar siúl ar feadh cúig nóiméad nuair a d'ardaigh an ghaoth, thart ar nóiméad ina dhiaidh sin tá luas 70km/h tagtha ar an ngaoth... ansin tosaíonn sé ag cur báistí, ach chomh hard agus chomh mór sin go mbuailtear do chraiceann le clabhtaí pianmhara, ansin thit clocha sneachta ón spéir, tháinig scaoll ar dhaoine, iad ag scréachach agus ag rith trasna ar a chéile." },
        { "cell": "units", "text": "Tá an t-oileánra 120 km ó thuaidh den Leithinis. Is é Oileán an Rí Seoirse, ar a bhfuil an socrúchán Villa Las Estrellas, an t-oileán is mó." },
        { "cell": "ranges", "text": "Tugtar cur isteach ar an gcodladh air nuair a dhúisíonn tú d'aon ghnó le linn do ghnáth-thréimhse codlata sula dtiteann tú i do chodladh arís go gairid ina dhiaidh sin (10-60 nóiméad)." },
        { "cell": "ranges", "text": "An Mheánaois Ard an t-ainm coitianta ar an tréimhse sin de stair na hEorpa sna 11ú, 12ú agus 13ú haoiseanna (AD 1000-1300) nuair a tharla na himeachtaí i dtrácht." },
        { "cell": "ranges", "text": "Bhí an luath-bhuntáiste ag Del Potro sa dara seit, ach bhí cluiche réitigh de dhíth ansin freisin tar éis dóibh 6-6 a shroicheadh." },
        { "cell": "ranges", "text": "Faightear speisialú déchosach in iontaisí Australopithecus ó 4.2-3.9 milliún bliain ó shin, cé go bhféadfaí go mbíodh Sahelanthropus ar siúl ar dhá chos chomh luath agus seacht milliún bliain ó shin." },
        { "cell": "currency", "text": "Anuraidh i mí Eanáir 2017 chuaigh Jesus, 21 bliain d'aois, isteach le Manchester City tar éis dó aistriú ón gclub Brasaíleach, Palmeiras, agus ba é £27 milliún an costas tuairiscithe leis sin." },
        { "cell": "currency", "text": "250 bliain ina dhiadh, tá Guinness fásta ina ghnó domhanda a mbaineann láimhdeachas bliantúil 10 mbilliún euro (US$14.7 billiún) leis." },
        { "cell": "currency", "text": "Meastar go mbeidh idir ¥2,500 agus ¥130,000 ar fhormhór na dticéad don imeacht, agus ¥7,000 ar ghnáth-thicéad." },
        { "cell": "currency", "text": "Cuireann CafeNet El Sol seirbhís áirithinte ar fáil ar phraghas US$30, nó $10 le haghaidh pas lae; gheobhaidh tú mionsonraí ar a leathanach Corcovado." },
        { "cell": "abbrev", "text": "Ba iad feithidí na chéad ainmhithe a théann amach faoin aer. Chabhraigh an cumas eitilte a bhí acu naimhde a sheachaint go héasca agus bia agus cairde a aimsiú ar bhealach níos éifeachtaí." },
        { "cell": "abbrev", "text": "Iarrtar ort caitheamh leis an suíomh le gach dínit, sollúntacht agus meas atá ag dul dó. Ná déan magadh faoin Uileloscadh ná faoi na Naitsithe." },
        { "cell": "abbrev", "text": "Ba é an Slalóm a céad rás, ina bhfuair sí 'Gan Chríochnú' dá céad fána. Bhí an toradh céanna ag 36 as na 116 iomaitheoir sa rás sin." },
        { "cell": "abbrev", "text": "B’fhéidir go ndearna othair áirithe an frídín a tholg san ospidéal, dar leis an Dr. Moll, agus ba oibrithe sláinte ospidéil beirt ar a laghad." },
        { "cell": "latin-in-native", "text": "Sna laethanta tosaigh chuaigh cultúr na Biosáinte san oirthear go mór i bhfeidhm ar stíl éadaí." },
        { "cell": "latin-in-native", "text": "Tháinig amhránaithe mór le rá ó cheann ceann na tíre le bhajans, is é sin amhráin chráifeachta, a chur i láthair ag cosa Shri Shyam." },
        { "cell": "latin-in-native", "text": "Tá siad fós ag iarraidh a dhéanamh amach díreach chomh mór is a bhí an tuairteáil agus cén tionchar a bheidh aige ar an Domhan." },
        { "cell": "latin-in-native", "text": "Agus uafáis agus ainghníomhartha an chogaidh feicthe acu le linn an Chéad Chogadh Domhanda, ba mhian le náisiúin a leithéid de rud a sheachaint do na glúine le teacht." },
        { "cell": "percent", "text": "Ghnóthaigh ​​Nadal 88% de na pointí ag an líon sa chluiche agus bhuaigh sé 76 pointe ar a chéad fhreastal." },
        { "cell": "percent", "text": "A bhuíochas ar naisc cábla snáthoptaice chuig an Eoraip agus satailít leathanbhanda, tá ceangal maith ag an nGraonlainn le 93% den daonra a bhfuil rochtain idirlín acu." },
        { "cell": "rate", "text": "Faoi láthair tá Fred ag séideadh gaoithe suas le 105 míle san uair (165 km/h) agus é ag gluaiseacht i dtreo an iarthuaiscirt." },
        { "cell": "rate", "text": "Bhí sé deacair ar phóilíní na Nua-Shéalainne a gcuid gunnaí radair luais a úsáid le feiceáil cé chomh tapa agus a bhí an tUasal Reid ag dul mar gheall ar chomh híseal agus atá Black Beauty, agus an t-aon uair a d’éirigh leis na póilíní clog a chur ar an Uasal Reid ná nuair a mhoilligh sé go 160km/u." },
        { "cell": "rate", "text": "Faoi thús an lae inniu, bhí gaoth thart ar 83 km/h ann, agus bhíothas ag súil go gcoinneodh léi dul i léig." },
        { "cell": "rate", "text": "Tá na luasteorainneacha postáilte i bhfad níos ísle ná mar a bhí i ranna roimhe seo agus dá éis — 35-40 msu (56-64 km/u) de ghnáth — agus tá sé níos tábhachtaí ná riamh go ngéillfimis go hiomlán dóibh." },
        { "cell": "zero-width", "text": "Tháinig sé seo chun bheith ina ghnáthchleachtas, ach ba é an t-iarann an fáth le ​caitheamh níos mó ar rothaí adhmaid na vaigíní." },
        { "cell": "zero-width", "text": "D'ionsaigh sé freisin aon rud a tháinig isteach san uisce; ní bheadh ​​fiú dineasáir ollmhór cosúil leis an T. rex i ndán dó." },
        { "cell": "zero-width", "text": "Fuair ​​siad amach gur oibrigh an Ghrian ar na bunphrionsabail chéanna le réaltaí eile: Fuarthas amach go raibh gníomhaíocht na réaltaí uile sa chóras á tiomáint ag a lonrachas, a rothlú, agus ní ag aon rud eile." },
        { "cell": "zero-width", "text": "Ba iad príomhspriocanna na hIodáile tíortha na hAfraice. Chun na tíortha sin a ghabháil, bheadh ​​ceap lainseála trúpaí ag teastáil uathu, ionas go bhféadfadh trúpaí a sheoladh trasna na Meánmhara agus ionradh a dhéanamh ar an Afraic." },
        { "cell": "roman", "text": "Le linn an troda ar son an neamhspleáchais a d'eagraigh gluaiseacht Mau, bhailigh slua go síochánta sa bhaile ach maraíodh an taoiseach mór Tupua Tamasese Lealofi III mar thoradh air sin." },
        { "cell": "roman", "text": "Mhaígh an Príomh-Aire Sealadach Julia Gillard i rith fheachtas an toghcháin feidearálaigh in 2010 gur chreid sí gur chóir don Astráil a bheith ina poblacht ag deireadh réim Bhanríon Éilis II." },
        { "cell": "roman", "text": "Tá an dearcadh céanna ag 34 faoin gcéad den phobalbhreith, ar mian leo go mbeidh an Bhanríon Éilis II ina monarc deiridh i réim san Astráil." },
        { "cell": "initialism", "text": "Thuairiscigh NHK, chomh maith, go raibh stáisiún cumhachta núicléiche Kashiwazaki Kariwa i maorach Niigata ag feidhmiú mar is gnách." },
        { "cell": "initialism", "text": "Tá neart formáidí coitianta (formáidí APS mar shampla) cothrom le nó an-chóngarach don chóimheas treoíochta seo." },
        { "cell": "initialism", "text": "Tá Páirc Náisiúnta Kruger (KNP) in oirthuaisceart na hAfraice Theas agus tá sé suite feadh theorainn Mhósaimbíc san oirthear, feadh theorainn na Siombáibe sa tuaisceart, agus is í Abhainn na gCrogall an teorainn theas." },
        { "cell": "initialism", "text": "Éilíonn Iosrael go mbeadh láithreacht mhíleata leanúnach sa ghleann ar feadh deich mbliana nuair a shínítear comhaontú ach ní aontaíonn an PA a bheith i láthair ach ar feadh cúig bliana." },
        { "cell": "grouped", "text": "Príomhchathair Shamó is ea Apia. Tá an baile ar oileán Upolu, agus daonra ruainne beag faoi 40,000 ann." },
        { "cell": "grouped", "text": "Is tearmann fiadhúlra iad Sundarbans ó 1966 i leith, agus meastar go bhfuil 400 tíogar Ríoga Bengal agus thart ar 30,000 fia ballach sa cheantar anois." },
        { "cell": "grouped", "text": "Mar sin féin, is cosúil go bhfuil an céatadán XDR-TB sa ghrúpa iomlán daoine a bhfuil eitinn orthu fós íseal; 6,000 den 330,000 duine iomlán ionfhabhtaithe ag aon am amháin áirithe san Afraic Theas." },
        { "cell": "grouped", "text": "Chealaigh an banna an seó ag Staid Chuimhneacháin Cogaidh Maui, a raibh 9,000 duine le bheith i láthair aige, agus gabhadh leithscéal leis an lucht leanúna." },
        { "cell": "letter-name", "text": "B'fhiú leathuair a chloig a chaitheamh ag dul thart ar an sráidbhaile fíorshuimiúil." },
        { "cell": "letter-name", "text": "D'fhéadfaí earraí lámhdhéanta a aithint mar sheandachtaí, cé go mbíonn siad níos nuaí ná earraí comhchosúla olltáirgthe." },
        { "cell": "letter-name", "text": "I bprionsabal, is rud an-simplí é an Búdachas Tibéidis. Cuimsítear Yoga Kundalini, machnamh agus cosán an ghrá uilechuimsithigh ann." },
        { "cell": "letter-name", "text": "B'éigean toiliú d'aon ghuth a fháil ó na stáit uile sula bhféadfaí na hAirteagail a leasú agus bhí na stáit chomh neamhdháiríre sin faoin rialtas lárnach gur minic a bhí a gcuid ionadaithe as láthair." },
        { "cell": "exponent", "text": "Clúdaíonn na Sundarbans limistéar 3,850 km², agus is limistéir uisciúla/réisc thart ar aon trian de." },
        { "cell": "ampersand", "text": "Ag barr an mhargaidh, ar ndóigh bíonn B&Banna san iomaíocht ar dhá phríomhrud: cóir leapa agus bricfeasta." },
        { "cell": "ampersand", "text": "Tá méadú mór ar sheirbhísí chuig an Afraic déanta ag aerlínte amhail Emirates, Etihad Airways, Qatar Airways & Turkish Airlines, agus cuireann siad nasceitiltí ar fáil chuig go leor cathracha móra san Afraic ar rátaí iomaíocha i gcomparáid le haerlínte eile Eorpacha." },
        { "cell": "ampersand", "text": "Bhain sé céim amach ó Choláiste na n-Ealaíon & Eolaíochtaí de chuid Ollscoil Virginia i 1950 agus ba dheontóir suntasach é don institiúid sin." },
        { "cell": "sports-time", "text": "Sa dara rás aici, an Mórshlalóm, tháinig sí sa deichiú háit i ngrúpa suí na mban le ham iomlán fánaí de 4:41.30, 2:11.60 nóiméad níos moille ná an buaiteoir, Claudia Loesch ón Ostair agus 1:09.02 níos moille ná Gyöngyi Dani ón Ungáir a chríochnaigh sa naoú háit." },
        { "cell": "version-dot", "text": "Tá na luais 802.11n i bhfad níos tapa ná luais a réamhtheachtaithe agus tá tréchur teoiriciúil uasta de600M ghiotán sa soicind acu." },
        { "cell": "quote-letter", "text": "Toisc nárbh fhéidir leis na mamaigh dul ann mar go raibh an t-achar ón mór-roinn ró fhada dóibh, d'éirigh leis an olltoirtís a bheith ina príomhainmhí féaraigh sna hOileáin Galápagos." },
        { "cell": "quote-letter", "text": "Phléasc trí bhuama eile gar d’fhoirgnimh an rialtais i dtréimhse dhá uair an chloig." },
        { "cell": "quote-letter", "text": "Ní raibh aon fhoraois mhór i dtalamh Chanán, a d'fhág go raibh adhmad an-chostasach." },
        { "cell": "quote-letter", "text": "Rinne iar-phóilín Filipíneach giall de thurasóirí Hong Cong nuair a d'fhuadaigh sé a mbus i Mainile, príomhchathair na nOileán Filipíneach." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Sna laethanta tosaigh chuaigh cultúr na Biosáinte san oirthear go mór i bhfeidhm ar stíl éadaí.",
        "Tá an pobal bunaidh díreach mar a bhí riamh, agus na hoiriúnaithe céanna de dhíth orthu.",
        "Ba iad muintir na nOileán Filipíneach féin a d'íoc as na costais chogaidh a ghabh le himpiriúlachas na S.A. agus iad ag iarraidh na hOileáin Fhilipíneacha a chur faoi chois.",
        "Déantar Scafaill Fhíorúla a inmheánú sna bogearraí agus tá siad ceaptha le nósanna imeachta, a d’fhéadfadh a bheith dúshlánach don mhac léinn a láimhseáil leo féin, a cheistiú, a spreagadh agus a mhíniú.",
        "Tá almóinn, cnó coill agus cnó crainn eile mar chuid de roinnt earraí bácáilte Gearmánacha. Go minic gabhann cácaí is mó éilimh go maith le cupán caife láidir.",
        "Díreach mar a bhíonn tarraingt ag an ghealach ar an domhan, rud a chruthaíonn taoidí, bíonn Bealach na Bó Finne ag dul i bhfeidhm ar réaltra an tSaighdeora.",
        "Chomh maith leis sin, idir gach ríshliocht tharlódh ré mhíshocair ina mbíodh na cúigí scoilte. An tréimhse is aitheanta díobh sin ab ea tréimhse na dTrí Ríocht a mhair 60 bliain idir na Ríshleachta Han agus Jin.",
        "Is teoiricí iad seo a dhíríonn ar cén fáth a dteastaíonn ó dhaoine áirithe rudaí áirithe a dhéanamh agus cad iad na rudaí ina dtimpeallacht a d'fhágfadh go ndéanfaidís rudaí áirithe nó nach ndéanfaidís iad.",
        "Agus ar ais ansin ó thuaidh, tríd an iarthar, ag trasnú abhainn Mara athuair, tar éis shéasúr na báistí thart ar mhí Aibreáin.",
        "Faoi Airteagal 247 de Bhunreacht na Pacastáine, tá sé de fhreagracht ar na gníomhairí seo seirbhísí rialtais agus breithiúnacha a sholáthar.",
        "Suimiúil go leor, níor ceapadh go raibh sé an-tábhachtach san am ársa agus níor taifeadadh é ar fhormhór na liostaí na ríthe ársa.",
        "Tá cead cúlráide de dhíth chun campáil ar bith a dhéanamh faoi bhun an imill in Grand Canyon.",
        "Is minic a chaithfidh oibrithe ceadú a n-oifigeach uachtarach a fháil d'aon chinneadh a dhéanann siad, agus bítear ag súil go gcomhlíonfaidh siad orduithe a n-oifigeach uachtarach gan aon agó.",
        "Long frithbhearta in aghaidh mianach den aicme Avenger a bhí inti, bhí an long ar a slí chun Puerto Princesa i bPalawan.",
        "Scríofa ar chúl Fhorógra Saoirse Mheiriceá bhí na focail \"Original Declaration of Independence dated 4th July 1776\". Tá an téacs le feiceáil ag bun an doiciméid, bunoscionn.",
        "Rinne Steve Jobs, POF de chuid Apple, an gléas a nochtadh trí shiúl ar stáitse agus an iPhone a bhaint as póca a bhríste géine.",
        "Sa bhliain 1970, d'aimsigh Raymond Damadian, dochtúir leighis agus eolaí taighde, an bonn chun íomháú athshondais mhaighnéadach a úsáid mar uirlis le haghaidh diagnóis leighis.",
        "De ghnáth, déantar gach iarracht i gcasaíne leis an am agus airgead a gcaitheann aíonna ann a uasmhéadú. Is iondúil nach mbíonn fuinneoga agus cloig i láthair agus is féidir go mbeidh sé deacair na bealaí amach a aimsiú.",
        "Féach ar na turais atá á gcur chun cinn ag an ngníomhaire, cibé ar láithreán gréasáin nó i bhfuinneog siopa.",
        "Níor tuairiscíodh aon mhoill ar thrácht trom ar an gcuarbhóthar, bealach malartach na cathrach.",
        "Tuama Thútancáman (KV62). Is féidir gurb é KV62 an tuama is mó cáil as na tuamaí sa Ghleann, an áit a dtáinig Howard Carter ar adhlacadh ríoga beagnach slán an rí óig i 1922.",
        "Le cúnamh Dé tabharfaidh an chuid is mó de dhaoine faoi deara gurb é an rogha is fearr ná a bheith ag obair le chéile.",
        "Baba Kanjar, Bhutha Kanjar, Rampro Kanjar, Gaza Kanjar agus Vishnu Kanjar is ainm dóibh siúd atá cúisithe.",
        "Theastaigh ó roinnt manaigh Ghearmánacha Dia a thabhairt níos gaire don chosmhuintir, agus mar sin chum siad teanga litriúil na hEastóine.",
        "Ina lán áiteanna ar fud an domhain, is comhartha cairdiúil é do lámh a croitheadh, chun \"heileo\" a chur in iúl.",
        "Ina theannta sin, cuimhnigh go meallann bolaí áirithe béir agus fiadhúlra eile, mar sin ná déan bianna a bhfuil boladh láidir uathu a iompar ná a chócaráil agus bíodh an campa glan i gcónaí.",
        "Ar ndóigh, bheadh ​​na sárbhrabúis a fuarthas ón dúshaothrú tarraingthe amach a rinneadh ar mhuintir na nOileán Filipíneach ina mbunghnóthachain d'impiriúlachas na S.A.",
        "Tháinig meath ar a stádas linn an dara haois déag go príomha de bharr na gcrosáidí a d'fhill le bronntanais ar nós síodaí agus spíosraí a raibh níos luachmhaire ná an méid a bhí ar fáil sna margaí Biosántacha.",
        "Chuaigh gach long go tóin poll, seachas cúrsóir amháin Briotánach. Cailleadh beagnach 200 duine idir Mheiriceánaigh agus Ghearmánaigh.",
