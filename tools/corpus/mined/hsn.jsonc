// MINED NORMALIZATION CORPUS — hsn. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer, for a
// language with no FLEURS corpus. The cells are the empirical shape of the rules the treated languages
// actually needed, so coverage of them is the completeness criterion — not size.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠⚠ AND WHETHER "sample" CAN CARRY THAT DEPENDS ON THE SOURCE, which this warning used to assert
// unconditionally. A uniform stride is only representative of what it strides OVER. Over a full dump it is
// the language's real distribution. Over an API fetch it is a stride across random ARTICLE INTROS plus
// articles chosen by a search ranked on the very patterns being measured — so a rate computed from it is a
// fact about the fetch, not about the language. The line below states which case this artifact is.
// ⚠ THIS artifact is API-sourced (random article intros + `insource:` fill), so `sample` is NOT
//   frequency-representative either — the fill's articles were chosen by a search ranked on the very
//   patterns being counted. Do not compute a rate from it; re-mine from a dump if a rate is needed.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: Wikimedia Incubator Wp/hsn (the only Xiang corpus that exists — there is no hsn.wikipedia)
//
// ⚠ REGENERATE WITH THE COMMAND BELOW, NOT FROM MEMORY. This artifact's shape depends on flags that leave no
// trace in the data — omit --sample and the whole sample tier silently disappears; omit --terms and the lexical
// cells report EMPTY. Both happened while re-mining this fleet: km lost its 200-entry sample tier to a
// reconstructed invocation, and my dropped from 35/35 cells to 33/35 because it is the one language with a terms
// list and the sweep did not pass it. Neither failure is visible in the output — the run reports success.
//
// command: npx tsx tools/normalization/mine.ts mine --in hsn_clean.txt --out hsn.jsonc --lang hsn --source "hsn (the only Xiang corpus that exists — there is no hsn.wikipedia)" --segment paragraph --per-cell 6 --sample 40
// segmentation: paragraph (no dot is ever interpreted — correct when the target IS the period)
{
    "language": "hsn",
    "source": "Wikimedia Incubator Wp/hsn (the only Xiang corpus that exists — there is no hsn.wikipedia)",
    "command": "npx tsx tools/normalization/mine.ts mine --in hsn_clean.txt --out hsn.jsonc --lang hsn --source \"hsn (the only Xiang corpus that exists — there is no hsn.wikipedia)\" --segment paragraph --per-cell 6 --sample 40",
    "segmentMode": "paragraph",
    "totalSegments": 181,
    "cellsCovered": 16,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 2,          // in 22 treated languages
        "digit-run": 63,       // in 19 treated languages
        "fractions": 0,        // in 18 treated languages
        "clock": 6,            // in 18 treated languages
        "signs": 10,           // in 17 treated languages
        "dotted": 0,           // in 16 treated languages
        "era-marker": 0,       // in 14 treated languages
        "year": 63,            // in 14 treated languages
        "decimals": 14,        // in 12 treated languages
        "ordinal-latin": 0,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 0,            // in 9 treated languages
        "ranges": 1,           // in 7 treated languages
        "currency": 0,         // in 6 treated languages
        "abbrev": 0,           // in 6 treated languages
        "latin-in-native": 28, // in 6 treated languages
        "percent": 8,          // in 5 treated languages
        "rate": 0,             // in 4 treated languages
        "zero-width": 0,       // in 4 treated languages
        "roman": 0,            // in 3 treated languages
        "initialism": 3,       // in 3 treated languages
        "grouped": 4,          // in 3 treated languages
        "signed-number": 0,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 3,      // in 3 treated languages
        "exponent": 1,         // in 24 treated languages
        "arithmetic": 1,       // in 2 treated languages
        "ampersand": 0,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 0,      // in 3 treated languages
        "version-dot": 10,     // in 3 treated languages
        "quote-letter": 1,     // in 4 treated languages
        "scaled-currency": 0,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "地圖座標為東經111°53'－114°5'，北緯27°51'－28°40'，東西走大概230公里，南北走大概88公里。地域東西向亇一條，地貌北、西、南邊為山地，東南丘陵為主，東北以崗地為主；山地、丘陵、崗地、平原大概下占噶四分之一。土壤一般下是板葉岩風化物，亦夾噠紅土、砂礫岩。" },
        { "cell": "degrees", "text": "長沙是亞熱帶季風氣候，四季分明。春末夏初多雨，夏末秋季多旱；春濕多變，夏秋多睛，嚴冬期短，暑熱期長。全年冇得霜亇時季大概子275天，年平均氣溫16.8～17.2℃，年平均總降水量1422.4毫米。水資源一般地表水，水源有蠻足，年均地表徑流量808億立方米。 除過湘江，還有15條流得湘江亇支流，主要有瀏陽河、撈刀河、靳江跟溈水河。最大亇水庫是寧鄉縣裡頭亇黃材水庫跟瀏陽市裡頭亇朱樹橋水庫。" },
        { "cell": "digit-run", "text": "南京國民政府在民國二十六年(1937年)搞出行政督察專員公署，全省分成九隻區（1938年改到十隻區），後頭成立長沙（1933年）、衡陽（1943年）兩隻市。湖南是抗日戰爭拉鋸戰亇一隻主要戰場。湖南高頭發生噠長沙會戰、常德會戰、衡陽戰役和湘西會戰四隻主要大會戰。長沙、衡陽下在戰爭時季被毀盡噠。1949年國民政府奔台灣以前，湖南省腳頭兩隻市、十隻行政監督區、七十七隻縣，湖南省政府跍得長沙。" },
        { "cell": "digit-run", "text": "湘潭市，因產湘蓮亇隻傢就又喊噠作“蓮城”，是中國湖南省肚裏亇一隻地級市，跍得湖南省中部偏東，湘江下游流域。現在管轄岳塘、雨湖兩隻市轄區、湘潭一縣、湘鄉、韶山兩隻縣級市，勞共5015平方公里，怕莫是湖南轄域肚裡面积最細的一隻地級市，人口有292萬咁多，排殆在湖南14個市州的第12位[2]。不过，湘潭市的经济水平，却是湖南省排名第一，人均GDP排在湖南省第二名。" },
        { "cell": "digit-run", "text": "狹義的湘潭市，就是講“湘潭市區”，敦到南宋以後亇湘潭縣城的基礎高頭，以前是“中國內地商埠之巨者”的商貿重鎮，繁盛一時。今日包括殆岳塘、雨湖2区，加殆一砣有279平方公里，建成區面積76平方千米也算得到度裏殆；總人口72萬，其中非農業人口57萬，爲湖南省第5大城市。湘潭亇城市綜合實力列國家統計局2006年版中國百強城市第83位，湖南省第3位。[3]湘潭是長株潭城市羣的組成部分，2007年送批准殆成爲兩型社會建設綜合配套改革試驗區。[4]" },
        { "cell": "digit-run", "text": "广西壮族自治区（壯文：Gvangjsih Bouxcuengh Swcigih）简称“桂”，位于中华人民共和国南部，南濒北部湾，东边是广东省，东北边是湖南省，北边是贵州省，西边是云南省，西南边和越南交界。面积23万多平方公里，在全国排到第九个。人口在2008年的时候达到4816万，在全国排到第11个。主要的少数民族有壮族、瑶族、苗族、侗族等。主要的汉语方言包括西南官话、粤语、平话、湘语、客家话等。另外还有壮语、瑶语等好多种民族语言。" },
        { "cell": "digit-run", "text": "箇隻頁面還冇翻譯嘎。吾架噠隻場。勞為各位路過好心人搭下手是。SSKJRequiem 14:59, 28 October 2008 (UTC)" },
        { "cell": "digit-run", "text": "長沙，又喊噠做“星城”，中華人民共和國湖南省亇省會，跍得湘東偏北亇位置。長沙有文字考證得亇歷史3000多年，因屈原跟賈誼亇影響送喊噠做“屈賈之鄉”。長沙又喊做“楚漢名城”，馬王堆漢墓跟噠走馬樓簡牘箇些子重要文物亇出土反映噠其深厚亇楚文化跟湖湘文化亇類子，嶽麓山腳頭亇嶽麓書院是湖南文化教育啲象徵。歷史上出噠好多巴多名人，留咖好多巴多歷史文化遺跡，成為頭批國家歷史文化名城。長沙亇經濟主要是搞第三產業，媒體跟噠娛樂業有名聲，是中南地區亇一隻重要工商業城市。" },
        { "cell": "clock", "text": "日本國（日語：日本國 にほんこく）位於歐亞大陸東側，西邊望著朝鮮半島跟中國，東頭就是太平洋，領土由本州島北海道九州島四國島跟千把隻小島組成，首都在東京。全國有1.27億來人，排世界第十，主要是大和民族。面積約莫37.8萬平方公里，世界六十一。" },
        { "cell": "clock", "text": "長沙在改革開放才架場亇時季發展亇速度有點噶子慢，慢慢細細就比沿海城市落後噠。到噠1990年代中間亇時季才發展得快些，GDP從1998年亇542.85億元上升得2006年亇1791億元，大概占噶全省亇五分之一；按戶籍人口算亇話人均18296元；農業生產總值172.07億元，工業總產值1006.06億元，人均可支配收入11029.06元，在中西部城市中間是最高亇。根據第一次經濟普查調噶後亇計算方式，2006年長沙GDP到噶1791億元。社會消費品零售總額743.43億元，頭回子超過噠鄭州在中部經濟區排第二。城市居民人均可支配收入12434元，多噶12.8%。全年全社會固定資產投資881.44億元，多噶31.93%。" },
        { "cell": "clock", "text": "2004年年末戶籍總人口610.38萬人，中間市區人口202.47萬人，非農業人口212.57萬人，農業人口397.81萬人。年末男女性別比為1.06:1，主要民族為漢族。根據2000年第五次人口普查，長沙地區通看有少數民族48,564人，主要是土家、苗、侗、瑤、回、壯和白族。在開福區撈刀河鎮裡頭有只漢回村是長沙唯一一隻少數民族——回族亇聚居地。" },
        { "cell": "clock", "text": "在增删文字之前，请您先去 讨论页 浏览并发表意见，我们会在讨论后统一修改，谢谢。YulouCN (talk) 05:23, 24 November 2012 (UTC)]]" },
        { "cell": "clock", "text": "地球像一隻球，其平均亇半徑有6732公里，質量5.9742×10²⁴公斤。其公轉一圈約莫要365.25天，自轉一圈約莫要23小時56分。月亮是地球唯一亇一隻自然衛星。" },
        { "cell": "signs", "text": "原先，湘語按是否保留濁聲母分類，湘語橫直送分得做老湘語和新湘語兩類，即長衡片跟噠婁邵片。湘語以長沙（新）及雙峰（老）為代表點，使用者約占漢語整人口嘅5%。" },
        { "cell": "signs", "text": "原先，湘語按是否保留濁聲母分類，湘語橫直送分得做老湘語和新湘語兩類，即長衡片跟噠婁邵片。湘語以長沙（新）及雙峰（老）為代表點，使用者約占漢語整人口亇5%。" },
        { "cell": "signs", "text": "長沙有兩隻國家級開發區：長沙經濟技術開發區（星沙）跟噠長沙高新產業開發區（河西岳麓區）。長沙經濟技術開發區在長沙縣亇星沙鎮裡頭，投資環境綜合評價指數在中西部16個國家開發區中排第二，該三年子亇GDP每年都多噶33.2%。到噠2005年底，長沙亇21家世界500強企業中間，有韓國LG電子、可口可樂、百事可樂、中糧集團、伊萊克斯、法國達能、法國道達爾、荷蘭飛利浦、日本三菱、德國博世、日商岩井、日本三井物產、易初蓮花，一共13家在星沙裡頭。" },
        { "cell": "signs", "text": "長沙捲煙廠是中國最大亇煙草生產商中間一隻，2004年納噶545,514萬塊錢亇稅，在全國所有納稅企業中間排13===第三產業===" },
        { "cell": "signs", "text": "贛語（國際音標：[kon ɲi]），是漢藏語漢語族腳頭亇一隻聲調言語，講其個人夥多跍得江西、湘東、鄂東南、皖西南，跟噠閩西北，是嗰些地域個通用言語，用其亇人有二千萬到五千萬人，占到中國總人數個3%，到世界上排待第三十八位。" },
        { "cell": "signs", "text": "地球表面積約莫71%都是水，只有29%是陸地。有太平洋、大西洋、印度洋、北冰洋跟南大洋嗰五隻大洋，亞洲、非洲、北美洲、南美洲、南極洲、歐洲、大洋洲嗰七隻大洲。地球面上有赫多吧多亇堅硬亇板塊在軟流圈高頭不斷亇移動。" },
        { "cell": "year", "text": "15—20萬年以前，開始有人類在長沙該塊子活動。7000多年前，長沙開始有噠村落。大概子2400年前亇春秋戰國時期楚國侸長沙建城。長沙是中國歷史上跍得同一只地方建城持續最長時間亇城市之一，而今城址一路來冇變，2000多年前亇路跟噠個時季亇巷道還是一隻樣範。侸不同亇歷史時期，長沙送喊得做“臨湘”、“潭州”；唐宋和明清時期，長沙亇經濟跟噠文化達到噠歷史上亇繁榮期。" },
        { "cell": "year", "text": "“長沙”該只喊法最早是記得《逸周書•王會》高頭。關於貢品“長沙鱉”的講古，到而今有3000多年噠。商周時期亇寧鄉縣炭河裡遺址出土亇四羊方尊一類亇青銅器顯得那時季亇長沙地區跟噠中原有一定亇聯繫。長沙大概建噶城有2400多年噠，侸春秋戰國架場，屬於楚國。“長沙，楚之粟也。”楚成王設噠黔中郡，長沙是其轄域。秦始皇統一噠中國，長沙郡是秦36郡中間一隻，個是長沙該只中國行政區劃亇名稱頭回送搞得史冊裡頭。兩漢亇時候，長沙是長沙國亇都城。東漢初期把“長沙國”撤噶噠，搞噠只長沙郡。" },
        { "cell": "year", "text": "宋時長沙做噠潭州治所。北宋設噠嶽麓書院，把長沙亇文化跟噠教育推得到噠最嬲塞亇時季。元朝1274年送改成噠潭州路，湖廣行省治所。1281年還是潭州路，湖南道宣慰司治所，在湖廣行省；元文宗天曆二年因“天子臨幸”名字送改成噠天臨路，元末又送改成噠潭州府治所。明初送改做長沙府治所，隸屬湖廣布政使司。清朝康熙三年搞噠只“湖南省”，長沙同為長沙府府治跟噠湖南省治。明清時季長沙有四大米市跟四大茶市亇喊法，是中國最要緊亇米市之一。" },
        { "cell": "year", "text": "長沙在民國時季亦還是一隻中國政治亇革命中心。1911年10月22日，焦達峰、陳作新鄧鬥亇起義新軍光復長沙。1915年，在時務學堂讀書亇蔡鍔搞起噠護國運動。1919年，長沙把一堆五四青年派得法國克勤工儉學，長沙亦是共產主義小組亇成立地之一。毛澤東、何叔衡、任弼時、蔡和森、向警予該些中共早期領導人都在長沙讀書或者搞政治活動。1927年毛澤東發動秋收起義，而且試噠打長沙冇搞得贏，後背他又搞噠只“農村包圍城市”亇方針" },
        { "cell": "year", "text": "1937年長沙發展到噠鼎盛時期，經濟物業繁榮，最開始成為抗戰亇大後方。1938年亇文夕大火成噠最悲慘亇時季，各種歷史文化遺跡怕莫下送搞盡噠。1939年到1944年，長沙是抗日戰爭亇主戰場，中、日以長沙做中心搞噶四回大規模亇戰役，中方搞贏噠頭三回。" },
        { "cell": "year", "text": "1949年8月5日，長沙亇共產黨政權正式架場噠，中華人民共和國建噶國後長沙開始搞重建跟發展。長沙作為中華人民共和國主要創始人之一亇毛澤東早期讀書跟從事革命活動亇地方，送搞噠做革命聖地。改革開放才架場亇1980年代，長沙亇經濟跟沿海城市亇差距開始變大噠；1990年代後期，長沙開始開始快速發展，成為中、西部中間一隻蠻緊要亇城市。" },
        { "cell": "decimals", "text": "長沙鈷得中國亇中南部亇長江以南地區，湖南省亇東邊偏北。在洞庭湖平原亇南邊跟湘中丘陵盆地搭界亇地方，跟岳陽、益陽、婁底、株洲、湘潭還有江西萍鄉搭界。面積通看有11819平方公里，該中間市區面積892平方公里，市區建成區面積186平方千米。鈷得瀏陽中間亇大圍山七星嶺海拔1607.9米，是轄區中間最高亇地方；嶽麓山亇雲麓峰海拔300.8米，是城區至高點。" },
        { "cell": "decimals", "text": "到而今，講啯種方言個人有6.6千萬到1.2億。廣州話是其個標準音，但廣東有夥多個人口流動，且香港個經濟跟文化產業夥發達，所以粵語個中心實際早就轉移到噠香港。不過，香港話跟廣州話講起來還是有點丫子區別個。" },
        { "cell": "decimals", "text": "英語（English，國際音標：[ˈɪŋglɪʃ]）是印歐語系——日爾曼語族——西日爾曼語支下頭個一隻言語，其是古代盎格魯、薩克遜跟日爾曼人個言語演化來個。後背，英國去全世界殖民個時候，把其俚個言語，下傳播到噠別個國家。據1999年統計，全世界母語是英語個人，已過噠3.8億，全世界排待第三或第四，但其是世界上最廣泛個第二言語。前兩百多年，英國跟美國待文化、經濟、軍事、政治，跟科學方面，一路都是世界最鳥塞個，所以英文成噠一隻標準個國際言語。英文亦是一隻聯合國個工作言語。" },
        { "cell": "decimals", "text": "維基百科現在有個兩三百多隻言語，是世界上最大亇冇得廣告亇網站，看得人數在世界排第五。凡是來看維基百科亇人，哪個夥能寫一篇文章出來，現在單是英文維基就有噠個把百萬文章。維基百科是用噠寫名-同樣方式分享 3.0亇授權方式，所以不管哪個夥可以拿自家亇言語來寫文章。" },
        { "cell": "decimals", "text": "中華民國（六調湘拼：zhong1 fa2 min2 gue6，英文：The Republic of China）是一隻位於東亞亇民主共和國，曾在國際上代表「中國」，現今多通稱為「臺灣」（英文：Taiwan）；目前有效管轄範圍包括臺灣、澎湖群島同附屬島嶼，以及中國大陸福建沿岸亇金門群島同馬祖列島等島嶼，多合稱為「臺澎金馬」同「臺灣地區」；土地面積共36,197平方公里，其中臺灣及其附屬島嶼佔99%以上。目前以位居東亞亇臺灣本島爲主要領土，東臨太平洋、西隔臺灣海峽、南界巴士海峽、北瀕東海，其地形陡峭、景觀多樣。國土約三分之二亇面積為山地同丘陵地形，大部分人口則居住於臺灣西部亇平地。截至2024年3月27日，全國人口約2,300萬人，人口密度在全世界人口大於1,000萬人以上亇國家中位列第二。首都為臺北市，人口最多亇城市則為新北市。" },
        { "cell": "decimals", "text": "早於2019年3月15日，香港眾志已於政府總部發起靜坐，要求撤回《逃犯條例》修訂。在3、4月間，民間人權陣線兩度發起示威遊行。6月9日，民陣再度發起遊行，稱有超過100萬名市民參與，香港警方則表示最高峰時約有24萬人參加遊行。特區政府未接受遊行訴求，繼續推動修例。6月12日，於香港立法會繼續將條例恢復二讀辯論，同日有四萬名市民在立法會大樓外示威，試圖阻止二讀程序，示威者不斷向警方投擲雜物、磚頭，同警方發生了激烈衝突，事後警方發佈公告，將示威行動定性為「暴動」。而示威者則指警方濫用職權及使用過度武力。之後示威者提出「完全撤回《逃犯條例》修訂草案、撤回前述衝突亇暴動定性、撤回所有示威者控罪、追究警隊濫權、行政長官林鄭月娥辭職下台」等「五大訴求」。6月16日，民間人權陣線發起更大規模亇遊行，由於特區政府亇不顧民意強推修例，再次引發了更多市民參與這次遊行，組織者稱遊行人數超過了200萬人，是「香港有史以來參與人數最多亇遊行」；警方則估計，經原定路線遊行人數最高峰為33.8萬。7月1日遊行期間，部分示威者佔領立法會綜合大樓，其後並將林鄭月娥下台亇訴求更改為「立即實現行政長官同立法會亇真雙普選」，實現真正亇民主普選訴求。" },
        { "cell": "latin-in-native", "text": "永全片：永州-全州片。全州位於廣西桂林，是[[Wp/hsn/省外湘語省外湘語|Wp/hsn/省外湘語|省外湘語]]嗰代表。" },
        { "cell": "latin-in-native", "text": "湘语罗马字(Hsiang Loumodzr,LMD)是一种基于拉丁字母(Latin Alphabet)、用以表记各种湘语方言的拼音。它的主旨是侸湘语内部实现最大范围的兼容。" },
        { "cell": "latin-in-native", "text": "湘潭市（現xi'an2.dan2.shi3 老xiong2.den1.shi3），因爲盛產湘蓮、故而（現gu4.nian3 老gu4.yer4）又喊（又稱、別名）“蓮城（lian3.zhen3）”。是中國（現zhen1.gui2 老zhen1.guai2）湖南省裏頭（現li1.dou2 老li1.dei2）的一隻（yi2.zho2 一個）地級市。" },
        { "cell": "latin-in-native", "text": "湘語是漢藏語系漢語亇一隻，是湖南省四大方言（贛語、湘語、西南官話、客家話）之一，又喊作湘方言。四川、重慶一帶橫直喊她做老湖廣話。主要亇使用人群是漢民族亇湖湘民系。英文裡頭有赫多喊法，像Hunanese，Xiang Chinese和噠Hsiang。語言學裡頭，一般把湘語喊做一隻獨立語言，中國裡頭湘語平常被喊做一隻方言塊。" },
        { "cell": "latin-in-native", "text": "英國人亞當•斯密（Adam Smith）是公認個“經濟學之父”，其待1776年出版噠《國富論》啯本書（國語全名《國民財富的性質和原因的研究》）。《國富論》是近代經濟學個奠基之作，亦是資本主義自由經濟個理論基礎。爾個時候，亞當•斯密提出噠“一隻看不見個手”個概念，等於是，市場自動調節資源個分配。同時其主張政府莫做事，莫干涉經濟發展。" },
        { "cell": "latin-in-native", "text": "湖湘民系(英語：Hunanese)又喊做湘楚民系、瀟湘民系，是漢族亇一隻民系，主流源于春秋戰國時候亇楚國人（更早還可上溯到西元前11世紀長江中下游亇華夏、藏、緬、壯、泰、苗、瑤部落）跟“江西填湖廣”時期遷入湖南亇江西老表。嗰隻民系亇人民把社會賢達看得赫重，社會賢達在民眾肚裡往往有特別強亇號召力。" },
        { "cell": "percent", "text": "之後，示威者幾乎每週發起常態抗議活動。在7月21日，遊行晚上發生了元朗襲擊事件，這次事件成為運動亇標誌性事件，也使運動發生轉折，事件中警方被質疑同黑社會合謀發動襲擊，導致示威者同警方之間亇衝突加劇。8月中旬，示威者兩度癱瘓香港國際機場。8月18日，民陣再度舉辦大規模和平集會，參與8·18集會亇人數超過170萬人。8月31日，太子站事件後令示威行動升級。9月4日下午，行政長官林鄭月娥宣佈四項行動，並動議撤回《逃犯條例》修訂草案，但拒絕成立獨立調查委員調查警隊濫用暴力。10月1日，全港爆發激烈示威。林鄭月娥會同行政會議在同月4日引用《緊急法》制定《禁止蒙面規例》，禁止使用蒙面物品遮蓋樣貌，引起更大衝突。示威活動進入11月，隨着新一輪亇三罷行動被發起，示威行動進一步升級，理大及中大兩所大學發生激烈警民衝突，多人受傷。在反修例運動爆發期間舉行亇區議會選舉投票率達7成，逾294萬名選民投票，打破自回歸以來亇紀錄。在這次選舉中民主派取得450席中亇388席，贏得了超過86%亇議席，民主派在選舉中大勝。建制派同鄉事派則遭到史無前例大敗。最終民主派得票57%，建制派得票41%，唯單一制下多數選區由民主派當選，但「四六比」格局並未根本改變。此外，因應這次示威浪潮，促使美國介入宣佈通過《香港人權同民主法案》。" },
        { "cell": "grouped", "text": "截至2022年10月31日，警方在多場示威活動拘捕超過1萬人，年齡介乎11歲至84歲，被捕人士數字為香港歷年社會運動之最；其中有超過2,800人被檢控、2,100宗相關案件，包括被控暴動亇750人，當" },
        { "cell": "letter-name", "text": "箕子朝鮮，韓國古代亇王朝，殷王族箕子做建國，在B.C 1122 - B.C 198。或者稱韓氏朝鮮。" },
        { "cell": "letter-name", "text": "衛滿朝鮮，韓國古代亇王朝，遼東人衛滿做建國，在B.C 198 - B.C 108。或者稱衛氏朝鮮。" },
        { "cell": "letter-name", "text": "京广铁路即京广线，是中国大陆一条从北京市通往广东省广州市的铁路，全长2284公里（丰台站至广州站），全线为 I 级双线电气化铁路，是中国重要的南北方向铁路干线之一，其连接了六座省会城市，以及数十座大中城市，并与多条铁路相接。" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "頭一落待中國大陸湖南省過半地範、搭伴湖南嗰四川省、重慶市、陝西省、安徽省、廣西跟著湖北省嘅小它地區；及廣東尤其深圳新住民社群中。平常子逢刻拿著長沙湘語跟著雙峰話做典型。",
        "原先，湘語按是否保留濁聲母分類，湘語橫直送分得做老湘語和新湘語兩類，即長衡片跟噠婁邵片。湘語以長沙（新）及雙峰（老）為代表點，使用者約占漢語整人口嘅5%。",
        "湖南省，跍得長江中游，因為到洞庭湖南頭所以叫“湖南”，有隻湘江所以簡稱湘，是中華人民共和國腳頭亇一級行政區；肚裡有赫多芙蓉，古詩有“秋風萬里芙蓉國”噶句子，所以又被喊噠做“芙蓉國”。湖南亇省會是長沙市，省政府跍得天心區湘府路。與湖北省、江西省、廣東省、廣西壯族自治區、貴州省跟噠重慶市搭界。",
        "宋朝，湖南屬荊湖南路跟荊湖北路，湖南就是在嗰時季發跡亇。那時，宋朝亇四大書院，湖南就佔噠高頭兩隻。元朝搞噠隻湖廣等處行中書省，管今日亇湖南、貴州跟噠廣西。明朝時季，湖南屬湖廣布政司。清朝康熙年間，湖廣分出噠左右兩隻布政司，右布政使司就改成噠湖南布政司，差不多就是今日湖南省亇那一塊。",
        "狹義的湘潭市，就是講“湘潭市區”，敦到南宋以後亇湘潭縣城的基礎高頭，以前是“中國內地商埠之巨者”的商貿重鎮，繁盛一時。今日包括殆岳塘、雨湖2区，加殆一砣有279平方公里，建成區面積76平方千米也算得到度裏殆；總人口72萬，其中非農業人口57萬，爲湖南省第5大城市。湘潭亇城市綜合實力列國家統計局2006年版中國百強城市第83位，湖南省第3位。[3]湘潭是長株潭城市羣的組成部分，2007年送批准殆成爲兩型社會建設綜合配套改革試驗區。[4]",
        "日本國（日語：日本國 にほんこく）位於歐亞大陸東側，西邊望著朝鮮半島跟中國，東頭就是太平洋，領土由本州島北海道九州島四國島跟千把隻小島組成，首都在東京。全國有1.27億來人，排世界第十，主要是大和民族。面積約莫37.8萬平方公里，世界六十一。",
        "婁邵片：婁底-邵陽片，原先送喊得做“老湘語”，是湘語中間特色最為純正、最不接近官話亇一隻方言片。研究上也有主張拆開箇隻片做兩塊：婁漣片跟噠祁邵片。前者是婁底-漣源片，後者是祁陽-邵陽片。",
        "整體講起，湘方言極大影響噠官話方言中間亇西南官話亇形成過程，同時長益片湘語侸圍繞省城長沙亇形成過程中也受到噠官話亇較大影響，所以西南官話與湘語有一定亇相似。民國初年，湘語跟噠贛語、江淮官話和西南官話並稱華南官話。實際上長益片跟得西南官話還是有很多明顯區別，比如前者較完整地保留噠入聲調，後者分佈亇大部分區域下冇得入聲，前者亇古濁音字現在雖然清化，但仍是不送氣清音，後者同北京話一樣亇平聲清化送氣，仄聲不送氣噠。",
        "長沙，又喊噠做“星城”，中華人民共和國湖南省亇省會，跍得湘東偏北亇位置。長沙有文字考證得亇歷史3000多年，因屈原跟賈誼亇影響送喊噠做“屈賈之鄉”。長沙又喊做“楚漢名城”，馬王堆漢墓跟噠走馬樓簡牘箇些子重要文物亇出土反映噠其深厚亇楚文化跟湖湘文化亇類子，嶽麓山腳頭亇嶽麓書院是湖南文化教育啲象徵。歷史上出噠好多巴多名人，留咖好多巴多歷史文化遺跡，成為頭批國家歷史文化名城。長沙亇經濟主要是搞第三產業，媒體跟噠娛樂業有名聲，是中南地區亇一隻重要工商業城市。",
        "宋時長沙做噠潭州治所。北宋設噠嶽麓書院，把長沙亇文化跟噠教育推得到噠最嬲塞亇時季。元朝1274年送改成噠潭州路，湖廣行省治所。1281年還是潭州路，湖南道宣慰司治所，在湖廣行省；元文宗天曆二年因“天子臨幸”名字送改成噠天臨路，元末又送改成噠潭州府治所。明初送改做長沙府治所，隸屬湖廣布政使司。清朝康熙三年搞噠只“湖南省”，長沙同為長沙府府治跟噠湖南省治。明清時季長沙有四大米市跟四大茶市亇喊法，是中國最要緊亇米市之一。",
        "1949年8月5日，長沙亇共產黨政權正式架場噠，中華人民共和國建噶國後長沙開始搞重建跟發展。長沙作為中華人民共和國主要創始人之一亇毛澤東早期讀書跟從事革命活動亇地方，送搞噠做革命聖地。改革開放才架場亇1980年代，長沙亇經濟跟沿海城市亇差距開始變大噠；1990年代後期，長沙開始開始快速發展，成為中、西部中間一隻蠻緊要亇城市。",
        "長沙是亞熱帶季風氣候，四季分明。春末夏初多雨，夏末秋季多旱；春濕多變，夏秋多睛，嚴冬期短，暑熱期長。全年冇得霜亇時季大概子275天，年平均氣溫16.8～17.2℃，年平均總降水量1422.4毫米。水資源一般地表水，水源有蠻足，年均地表徑流量808億立方米。 除過湘江，還有15條流得湘江亇支流，主要有瀏陽河、撈刀河、靳江跟溈水河。最大亇水庫是寧鄉縣裡頭亇黃材水庫跟瀏陽市裡頭亇朱樹橋水庫。",
        "長沙捲煙廠是中國最大亇煙草生產商中間一隻，2004年納噶545,514萬塊錢亇稅，在全國所有納稅企業中間排13===第三產業===",
        "根據寧鄉炭河裡遺址亇文物考古亇推測，長沙在商朝和西周時季外來民族帶噶好多先進文化來。春秋戰國時季亇揚越、楚人，楚亇先民是九黎、三苗，有“群蠻上承三苗之緒，下開長沙武陵”亇港法。在漫長亇歷史長河中，長沙先民一直參與中國民族融合亇大流，逐漸形成噠主體民族——漢族。長沙在歷史中搞噶幾次人口高峰出來，亦送戰亂搞得人煙荒蕪過。比如讲在五代十國亇馬楚時期搞出來亇繁榮，就送末年亇爭權奪勢的鬥爭荒蕪噶噠。兩宋時季長沙發展噶好多人口，但是南宋末年英勇亇抗元鬥爭冇搞得贏又送屠城噠。明朝朱元璋打長沙搞得好多當地居民死噶噠，於是又有“江西填湖廣”亇港法。而今大多數土生亇長沙人下港祖籍是江西，包括劉少奇、胡耀邦該些名人。明清時季長沙人口穩步攀升，到噠民國時期城市人口差不多有30多萬噠。背時亇是“文夕大火”跟長沙會戰搞得長沙又噶只廢墟。抗日戰爭搞完後流亡外地亇長沙人跟其他各地移民到長沙來噶噠，又把長沙建立成噠湖南最大亇城市。",
        "自清朝末年曾國藩始一直到當代，長沙以及湖南全省開始了人才輩出的時代。在當時的長沙府，湧現了一大批著名人士，對整個中國的近代史現代史產生了非常深遠的影響。如黃興、楊開慧、朱鎔基、田漢等。大部分名人故居和墓葬都得以保存，因為行政區劃的變動，部分被劃入長沙府撤銷後新成立的地市。",
        "英語（English，國際音標：[ˈɪŋglɪʃ]）是印歐語系——日爾曼語族——西日爾曼語支下頭個一隻言語，其是古代盎格魯、薩克遜跟日爾曼人個言語演化來個。後背，英國去全世界殖民個時候，把其俚個言語，下傳播到噠別個國家。據1999年統計，全世界母語是英語個人，已過噠3.8億，全世界排待第三或第四，但其是世界上最廣泛個第二言語。前兩百多年，英國跟美國待文化、經濟、軍事、政治，跟科學方面，一路都是世界最鳥塞個，所以英文成噠一隻標準個國際言語。英文亦是一隻聯合國個工作言語。",
        "贛語（國際音標：[kon ɲi]），是漢藏語漢語族腳頭亇一隻聲調言語，講其個人夥多跍得江西、湘東、鄂東南、皖西南，跟噠閩西北，是嗰些地域個通用言語，用其亇人有二千萬到五千萬人，占到中國總人數個3%，到世界上排待第三十八位。",
        "語言學家多把長益片方言劃分成：長株潭小片、沅益小片、岳陽小片三隻部分，三隻小片區有口音差別，但大致冇得溝通障礙。",
        "講吳語個人主要住待江蘇個南邊、上海、浙江，跟噠安徽個南邊，一共近有八千萬，待中國排第二，世界排第一泡。",
        "“微觀”是研究單只經濟體個作為，其俚包括：消費者、工人、投資者、土地所有者，跟噠企業。其跟吾俚解釋，啯些單只經濟體是何什做出經濟決策，何解啯做。其個另個重要研究領域是，經濟體之間何什相互作用，去形成更大個經濟體——市場跟行業。",
        "最先講到像而今“經濟學”個概念個，是色洛芬，其個《經濟論》最先涉及“經濟學”。待亞里斯多德時代個點子是：政治學、倫理學、政治經濟學三位一體，諾獎獲得者阿馬蒂亞•森待《倫理學與經濟學》兜裡講道：“夥長段個時間，經濟學一路來都講是倫理學個一隻分支。”",
        "待《國富論》出版個後100年，自由主義經濟繁榮個後頭，週期性個經濟危機跟社會財富分佈個不均等弊端下都露出噠。德國人卡爾•馬克思認為一個國家經濟個代表是勞動力，但資本主義個資本家為噠追求其自家個利潤最大化，放肆個壓低工資，壓低生產成本。待其1867年出版個《資本論》中提出噠“資本主義原始積累”跟“剩餘價值”等理論，其認為資本主義發展中個階級矛盾是不得調和歸一個。其還預言資產階級，後背下會被無產階級取代，“國家”個概念下會消失，社會各層面革新跟資源從頭架勢分配，最後，臻至理想個共產主義社會。",
        "湖湘民系與湖南境內亇苗族、土家族、侗族、瑤族等民族一路創造了湘楚文化（楚文化、湖湘文化），湖湘民系創造亇文化在湘楚文化中為主體地位。 湖湘民系主要使用湘語，在風俗、禮儀等方面與淮語、吳語、徽語三言亇人民亦有蠻多共性，但飲食習慣截然不同。普遍呷檳榔、辣椒等刺激性亇食物是湖湘民系亇特點。 另外，湖湘民系肚裡好實巴多人口聲講自家血統源自老表民系。",
        "中華民國，開先在中國大陸，如今跍得台灣跟福建沿海幾隻小島高頭亇一隻國家，一般喊噠做臺灣。",
        "鄧小平在1978年亇十一屆三中全會上噠台後，改革開放就架場。先在東南沿海搞噠五隻經濟特區做試點，後背全面開放。箇以後中國亇國際影響力也變大噠，GDP也提高噠一大片，不過貧富差距也變大噠。1989年軍隊鎮壓噠八九民運，也惹噠世界批評中國亇民主同人權問題。",
        "四川省，是跍得中華人民共和國西南亇一個省份，省會是成都市，跟雲南省、西藏自治區、青海省、甘肅省、陝西省、重慶市跟貴州省搭界。總人口有8000來萬，是全國人口第四亇省級級行政區。四川有川跟蜀兩隻簡稱，川是從宋朝亇川峽四路來亇，在先秦時期，有巴、蜀嗰兩隻諸侯國跍到今日四川省亇地盤高頭，所以四川又喊噠做巴蜀。",
        "熱帶氣旋是低緯度亇一下氣旋，其是勞噠水蒸氣凝結敦起亇暖中心結構。熱帶氣旋高頭對流赫強，肚裡亇風雨也蠻厲害。夏天秋天是熱帶氣旋最多亇時季，其時常襲擊陸地，造成傷亡。",
        "英國本土落於歐陸西北啲不列顛群島、送北海、英吉利海峽、凱爾特海、愛爾蘭海和大西洋包圍。除噠英國本土外，還包括十四隻海外領土。",
        "英國是第一、第二次世界大戰主要勝利國、擁有原子武器和世界上第四的軍費支出、是國際連合安全保障理事會常任理事國、對議案擁有否決權。英國亦為歐盟成員國、北約創始會員國、主要國首腦會議成員國之一和歐洲四大經濟體之一、全球前七大經濟體、世界八大強國之一、也是一系列國際組織如經合組織、世界貿易組織的一員。",
        "除噠維基百科，維基媒體基金會現在還有麼子維基詞典丶維基教科書丶維基文庫幾隻別亇項目，也是哪個夥能寫。",
        "在開韓國亇男性人權活動、自由主義活動，亦是2008年1月24日男性連帶(朝鮮語:남성연대)亇創建，同一代主席。2013年7月26日是漢城市麻浦區漢江亇投身自殺，抗議於性差別。他亇有言\"男性亦一人也\"。",
        "王韬(1828年11月10日-1897年5月24日），是中国晚清的时候，吴越地区的一个维新文人，箇个人关心国家大事，写过好多洋务运动的材料，对箇个阶段的洋务运动有很大的影响。他人家早年参加科举，無考取，落榜。后背因为与太平天国有关联，冇办法免罪，就一下子与传教士一道，夥逃到香港，又到欧洲去巡游，积累几多丰富的见闻，根据箇些见闻，他写出《漫游随录图记》，是晚清时代，中国人对欧陆见闻的代表性作品",
        "仁贤天皇（日语：仁賢天皇、にんけんてんのう）,又喊噠億計天皇（おけのすめらみこと）、大石尊（おおしのみこと）、意祁命、意富祁王（おおけのみこ）、大脚（おおし）、大為，是日本亇一只天皇。其在仁贤天皇元年1月5号 - 同11年8月8号在位。",
        "宣化天皇（日语：宣化天皇、せんかてんのう）又喊檜隈高田皇子（ひのくまのたかたのみこ）、建小広国押楯命（たけをひろくにおしたてのみこと）、武小広国押盾天皇（たけをひろくにおしたてのすめらみこと），是日本亇一只天皇。其在536年1月 - 539年3月15号在位。",
        "崇峻天皇（日语：崇峻天皇、すしゅんてんのう）又喊泊瀬部（はつせべ）、长谷部若雀天皇（はつせべのわかささぎのすめらみこと），是日本亇一只天皇。其在用明天皇2年8月2号 - 崇峻天皇5年11月3号在位。",
        "天智天皇（日语：天智天皇、てんぢてんのう、てんじてんのう），又喊噠做葛城（かづらき/かつらぎ）、中大兄皇子（なかのおおえのおうじ / なかのおおえのみこ），是日本亇一只天皇。其在天智天皇7年1月3号 - 天智天皇10年12月3号在位。",
        "元明天皇（日语：元明天皇、げんめいてんのう），又喊噠做「阿閇」（あへ）、「阿部皇女」（あべこおじょ），是日本亇一只天皇。其在707年8月18号 - 715年10月3号在位。",
        "淳仁天皇（日语：淳仁天皇、じゅんにんてんのう），又喊噠做「大炊」（おおい）跟噠「淡路廃帝」（あわじはいたい），是日本亇一只天皇。其在758年9月7号 - 764年11月6号在位。",
        "蔡英文求學期間先後獲得了國立臺灣大學法律學系法學士、康乃爾大學法學院法學碩士同倫敦政治經濟學院法學博士亇學位，並曾當了教於國立政治大學法學院、商學院同東吳大學法學院。1986年，她參同世界貿易組織等國際談判，獲得政府賞識。在李登輝政府亇時期，她是國安會諮詢委員，是「特殊亇國同國關係」理論亇主要起草人。2000年陳水扁政府上臺後，她以無黨籍學者身分擔任陸委會主委。",
        "本次選舉候選人共有三組，依登記號次分別是台灣民眾黨推薦亇黨主席柯文哲及全國不分區立法委員吳欣盈（俗話講是「柯吳配」同「柯盈配」）、民主進步黨推薦亇時任副總統兼黨主席賴清德及前駐美代表蕭美琴（俗話講是「賴蕭配」同「美德配」），以及中國國民黨推薦亇新北市市長侯友宜及中國廣播公司董事長趙少康（俗話講是「侯趙配」同「侯康配」）。"
    ]
}
