// MINED NORMALIZATION CORPUS — hmn. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer, for a
// language with no FLEURS corpus. The cells are the empirical shape of the rules the treated languages
// actually needed, so coverage of them is the completeness criterion — not size.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠⚠ AND WHETHER "sample" CAN CARRY THAT DEPENDS ON THE SOURCE, which this warning used to assert
// unconditionally. A uniform stride is only representative of what it strides OVER. Over a full dump it is
// the language's real distribution. Over an API fetch it is a stride across random ARTICLE INTROS plus
// articles chosen by a search ranked on the very patterns being measured — so a rate computed from it is a
// fact about the fetch, not about the language. The line below states which case this artifact is.
// ⚠ THIS artifact is API-sourced (random article intros + `insource:` fill), so `sample` is NOT
//   frequency-representative either — the fill's articles were chosen by a search ranked on the very
//   patterns being counted. Do not compute a rate from it; re-mine from a dump if a rate is needed.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: Wikimedia Incubator project Wp/mww = White Hmong / Hmong Daw, the only Hmong corpus that exists (no Hmong Wikipedia exists at any code: hmn, mww and hnj all fail to resolve; Wp/hnj does not exist and Wp/hmn is a one-page note saying hmn is a macrolanguage), 112 pages exported 2026-08-12 via wikidump-to-text.py --title-prefix Wp/mww/, then filter-by-language.py --lang hmn which dropped 0 paragraphs as English and 96 as too short
//
// ⚠ REGENERATE WITH THE COMMAND BELOW, NOT FROM MEMORY. This artifact's shape depends on flags that leave no
// trace in the data — omit --sample and the whole sample tier silently disappears; omit --terms and the lexical
// cells report EMPTY. Both happened while re-mining this fleet: km lost its 200-entry sample tier to a
// reconstructed invocation, and my dropped from 35/35 cells to 33/35 because it is the one language with a terms
// list and the sweep did not pass it. Neither failure is visible in the output — the run reports success.
//
// command: npx tsx tools/normalization/mine.ts mine --in mww_paras.hmn.txt --out hmn.jsonc --lang hmn --segment paragraph --per-cell 6 --sample 40 --source " Hmong Daw, the only Hmong corpus that exists (no Hmong Wikipedia exists at any code: hmn,hmn is a one-page note saying hmn is a macrolanguage),, then filter-by-language.py --lang hmn which dropped 0 paragraphs as English and 96 as too short"
// segmentation: paragraph (no dot is ever interpreted — correct when the target IS the period)
{
    "language": "hmn",
    "source": "Wikimedia Incubator project Wp/mww = White Hmong / Hmong Daw, the only Hmong corpus that exists (no Hmong Wikipedia exists at any code: hmn, mww and hnj all fail to resolve; Wp/hnj does not exist and Wp/hmn is a one-page note saying hmn is a macrolanguage), 112 pages exported 2026-08-12 via wikidump-to-text.py --title-prefix Wp/mww/, then filter-by-language.py --lang hmn which dropped 0 paragraphs as English and 96 as too short",
    "command": "npx tsx tools/normalization/mine.ts mine --in mww_paras.hmn.txt --out hmn.jsonc --lang hmn --segment paragraph --per-cell 6 --sample 40 --source \" Hmong Daw, the only Hmong corpus that exists (no Hmong Wikipedia exists at any code: hmn,hmn is a one-page note saying hmn is a macrolanguage),, then filter-by-language.py --lang hmn which dropped 0 paragraphs as English and 96 as too short\"",
    "segmentMode": "paragraph",
    "totalSegments": 188,
    "cellsCovered": 24,
    "cellsTotal": 36,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 3,          // in 22 treated languages
        "digit-run": 64,       // in 19 treated languages
        "fractions": 0,        // in 18 treated languages
        "clock": 0,            // in 18 treated languages
        "signs": 13,           // in 17 treated languages
        "dotted": 8,           // in 16 treated languages
        "era-marker": 1,       // in 14 treated languages
        "year": 64,            // in 14 treated languages
        "decimals": 19,        // in 12 treated languages
        "ordinal-latin": 7,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 4,            // in 9 treated languages
        "ranges": 6,           // in 7 treated languages
        "currency": 3,         // in 6 treated languages
        "abbrev": 117,         // in 6 treated languages
        "latin-in-native": 188, // in 6 treated languages
        "percent": 6,          // in 5 treated languages
        "rate": 0,             // in 4 treated languages
        "zero-width": 1,       // in 4 treated languages
        "roman": 5,            // in 3 treated languages
        "initialism": 27,      // in 3 treated languages
        "grouped": 11,         // in 3 treated languages
        "signed-number": 2,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 16,     // in 3 treated languages
        "exponent": 1,         // in 24 treated languages
        "arithmetic": 1,       // in 2 treated languages
        "ampersand": 0,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 0,      // in 3 treated languages
        "version-dot": 0,      // in 3 treated languages
        "quote-letter": 5,     // in 4 treated languages
        "scaled-currency": 1,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
        "native-terminator": 0, // in 50 treated languages
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Guj kuj txoj hauj lwm nyob rau hauv sab qaum teb Eurasia (ib ncig ntawm lub teb chaws cov lus dag feem ntau sab qaum teb ntawm 50 ° N. M.) Coj mus rau nws qhov kev tso kawm nyob rau hauv lub arctic, subarctic, tsis kub tsis txias thiab cov subtropical climates. Lub predominant ib feem ntawm lub chaw uas zoo heev nyob rau hauv lub cheeb tsam tsis kub tsis txias. Qhov ntau haiv kev nyab xeeb tseem nyob ntawm lub topography thiab qhov sib thooj los yog remoteness ntawm lub hiav txwv." },
        { "cell": "degrees", "text": "Nruab nrab kub nyob rau hauv Lub ib hlis ntuj, raws li kev sib txawv hauv cheeb tsam, xws li los ntawm 6 mus rau -50 ° C, Lub Xya hli ntuj 1 mus rau 25 ° C; dej nag xws li 150 rau 2000 hli ib xyoos twg. Lub permafrost (qhov chaw ntawm Siberia thiab cov Far East) coj 65% ntawm ib ncig ntawm Guj kuj." },
        { "cell": "degrees", "text": "Lub siab tshaj plaws puas tau kaw kub nyob rau hauv ib ncig ntawm niaj hnub Guj kuj twb +45,4 ° C nyob rau ntawm lub chaw nres tsheb meteorological Uta (Kalmykia) (ntsuas 12 Lub Xya hli ntuj 2010). Tus nqi qis tshaj kub twb kaw cai nyob rau hauv Oymyakon Academician Sergei Obruchev lub caij ntuj no 1924 thiab amounted los -71,2 ° C (txawm hais tias qhia thiab qis kub). Tshaj plaws kub sib txawv: 116,6 ° C, raws li qhov no qhia tau Guj kuj Qib thawj nyob rau hauv lub ntiaj teb no." },
        { "cell": "digit-run", "text": "\"Crocodile\" Dundee yog ib xyoo 1986 Australian American romantic comedy taug txuj kev nyuaj. Nws tau teev nyob rau hauv Australian Outback thiab nyob rau hauv New York City. Nws cov hnub qub Paul Hogan thiab Linda Kozlowski." },
        { "cell": "digit-run", "text": "Nws yog raws li lub neej tiag tiag ntawm Rodney Ansell. Cov yeeb yaj kiab tau muaj peev nyiaj ntawm $10 lab. Lawv txhais tau tias ua lag luam Australian zaj duab xis uas Amelikas nyiam. Ntau tus neeg hauv ntiaj teb nyiam qhov yeeb yam. Nws tau ua ob feem ntau ntawm cov yeeb yaj kiab hauv teb chaws As Mes Lis Kas nyob rau xyoo 1986. Nws kuj yog ob qhov nyiaj hauv lub ntiaj teb ua xyoo 1986." },
        { "cell": "digit-run", "text": "Muaj ob feem ntawm zaj duab xis: Australian version, thiab American/thoob ntiaj teb version. Cov American version tau ntau ntau ntawm Australian slang hloov nrog ntau cov ntsiab lus to taub. Nws kuj tseem me ntsis. Muaj ob zaj yeeb yaj kiab: \"Crocodile\" Dundee II (1988) thiab Crocodile Dundee in Los Angeles (2001)." },
        { "cell": "digit-run", "text": "Aus-rab-lias - ib lub teb chaws nyob rau hauv lub yav qab teb Hemisphere, occupying thooj av loj Aus-rab-lias, cov kob ntawm Tasmania, thiab ob peb lwm yam islands nyob rau hauv lub Indian thiab Pacific Oceans; yog lub thib rau lub xeev los ntawm cheeb tsam nyob rau hauv lub ntiaj teb no. Rau sab qaum teb ntawm lub teb chaw ntawm teb chaws Aus-rab-lias nyob East Timor, Ee-dos-neb-xias thiab Wp/mww/Pes-puab - Tshiab Nkib-nis (Papua Niugini), mus rau sab qaum teb-sab hnub tuaj - Vanuatu, Tshiab Caledonia thiab cov Solomon Islands, mus rau sab qab teb-sab hnub tuaj - Tshiab Txib teb (en. New Zealand). Lub shortest kev ncua deb ntawm lub ntsiab kob ntawm Papua - Tshiab Guinea thiab lub mainland ntawm teb chaws Aus-rab-lias tsuas yog 145 km deb, thiab los ntawm Aus-rab-lias kob Boigu Island rau Papua - Tshiab Guinea - tsuas yog 5 kis lus mev. Pejxeem rau lub Ob Hlis 7, 2015 yog 23,822,747, feem ntau ntawm uas nyob rau hauv lub zos nyob rau hauv lub sab hnub tuaj ntug dej hiav txwv." },
        { "cell": "digit-run", "text": "Austria - ib yam ntawm cov richest lub teb chaws nyob rau hauv lub ntiaj teb no. GDP ib capita ntawm txog US $ 46,330 (nyob rau hauv 2012). Txiaj - Euro." },
        { "cell": "digit-run", "text": "Tug tswv cuab ntawm lub tebchaws United Nations, lub European Union. Nyob rau hauv 1955, nws tshaj tawm tas mus li neutrality thiab uas tsis yog-kawm tuab si lug nrog rau tej tub rog blocs." },
        { "cell": "signs", "text": "Tam sim no tseem tsis tau muaj tshuaj txhaj tiv thaiv kab mob los mus pov thaiv Tus Kab Mob Khaus Viv-19 (COVID-19) li. Txoj kev zoo tshaj plaws txhawm rau pov thaiv koj tus kheej yog zam kom tsis txhob raug tau tus kab mob vais lav (virus) uas ua rau tshwm sim muaj Tus Kab Mob Khaus Viv-19 (COVID-19). Nyob twj ywm hauv tsev kom ntau li ntau tau thiab zam tsis txhob nyob sib ze nrog lwm tus. Rau ib daim ntaub npog ntsej muag uas npog koj lub qhov ntswg thiab qhov ncauj nyob rau hauv cov chaw muaj zej tsoom nyob coob. Tu ntxuav kom huv si thiab tsuag tshuaj tua kab mob rau cov chaw (npoo) uas nquag kov (chwv) tas li. Siv xab npum thiab dej ntxuav koj ob txhais tes tas li kom ntev tsawg kawg yog 20 chib (xis nkoos), los sis siv tshuaj ntxuav tes tua kab mob muaj dej cawv cuaj caum yam tsawg txog li 60%." },
        { "cell": "signs", "text": "Ib duas yog ib hom txiaj. Muaj ntau lub teb chaws tau hu lawv cov nyiaj hauv lub duas, yog li nws yog qhov tseem ceeb uas yuav tau hais tias tus nqi yog tham txog. Lub cim rau duas yog ib daim ntawv loj S, pierced los ntawm ib los yog ob txoj kab ntsug: $." },
        { "cell": "signs", "text": "Hauv ntau hom lus uas tau tsim los, Esperanto nyob nruab nrab ntawm \"naturalistic\" (ua raws li cov lus ntuj uas twb muaj lawm) thiab a priori (qhov twg cov yam ntxwv tsis yog raws li cov lus uas twb muaj lawm). Cov lus, cov qauv sau ntawv, thiab cov ntsiab lus ntawm Esperanto feem ntau yog los ntawm cov lus ntawm pawg Indo-European. Feem ntau ntawm nws cov lus (kwv yees li 80%) yog los ntawm cov lus Romance, tab sis nws kuj muaj cov ntsiab lus los ntawm cov lus Germanic, Greek, thiab Slavic. Ib qho ntawm cov yam ntxwv tseem ceeb tshaj plaws ntawm hom lus yog nws txoj kev tsim cov lus los ntawm ntau yam, qhov twg cov lus ua ntej thiab cov lus tom qab tuaj yeem sib xyaw ua ke nrog cov hauv paus hniav los tsim cov lus, ua rau nws muaj peev xwm sib txuas lus zoo nrog cov lus me me." },
        { "cell": "signs", "text": "Lavxias teb sab neeg hais lus ntau tshaj 100 yam lus thiab suab teej tug mus rau lub Indo-European, Uralic thiab Altaic lus tsev neeg, Caucasian thiab Paleo-Asiatic lus pawg. Cov feem ntau lug hais lus yog distinguished Lavxias teb sab, Ukrainian, Belarusian, Armenian, Ossetian thiab German (Indo-European lus tsev neeg), Tatar, Bashkir thiab Chuvash (Altaic lus tsev neeg), Udmurt, Mari, thiab Erzya (Uralic lus tsev neeg), Chechen, Avar thiab Dargin (Northeast Caucasian lus), Kabardino-Cherkessia (Abkhaz-Adyghe lus tsev neeg). Lavxias teb sab yog leej niam tus nplaig rau ib co 130 lab cov pej xeem ntawm Guj kuj (92% ntawm cov pej xeem ntawm Guj kuj)." },
        { "cell": "signs", "text": "Thaum cov Ethnologue distinguished tsuas chaw poob qab hom (Hmoob Daw, Mong ntsuab tsim), \"Miao\" Sinicized mas (Hmoob Shua) thiab nyab laj hom (Hmoob li, Hmoob tsis txhob). Nyab laj hom heev tsis paub tias; pejxeem kwv no tsis muaj nyob txawm. Hauv 2007, Horned cov \"Miao\" mas, \"Miao\" me Flowery mas, thiab pawg Chuanqiandian suav ntawd ncau Mong ntsuab tsim [blu]. Cov hom muaj raws li nram no, nrog rau ib co cov npe ua lwm ('Ch.' = Suav lub npe, 'auto.' = autonym Court npe):" },
        { "cell": "signs", "text": "Cov neeg coob leej yog cov muaj cai ntau tshaj li uas tau tso tseg. Nws yog ib qho nyuaj rau kev ntsuas raws nraim li cas, vim txhua tus neeg muaj sib txawv sib txawv ntawm cov kev nyiam, tab sis muaj li ntawm 5-10% yog cov laug-tes laug." },
        { "cell": "dotted", "text": "Kuv century BC. e. - Lub conquest ntawm cov neeg Loos inhabiting lub ib ncig ntawm hnub no lub Austria Celtic pab pawg neeg boyev, Taurisci thiab ozeriatov thiab nkag mus rau hauv ib ncig ntawm lub xeev ntawm Noricum (nrhiav tau 15 BC. E.) Thiab Pannonia (nrhiav tau nyob rau hauv '10 n. E., Ces muab faib ua Upper Pannonia, uas muaj ib feem ntawm tam sim no-hnub Austria thiab Txo Pannonia). Ciam teb ntawm lub xeev tuav lub western lub zos Vindobona (Vienna), yog nyob rau hauv Pannonia." },
        { "cell": "dotted", "text": "Lub peb hlis ntuj 4, 1933 Federal Chancellor Engelbert Dollfuss yaj Tsoom Fwv Teb Chaws los ua ke, thiab ib xyoos tom qab luam tawm ib tug t. N. «Tej zaum tsab kevcai tswjfwm\", tshem lub Federal los ua ke. \"Thov kom tus Constitution\" yog hloov los ntawm lub teb chaws sawv cev neeg." },
        { "cell": "dotted", "text": "Esperanto yog hom lus pab uas neeg hais ntau tshaj plaws hauv ntiaj teb. L. L. Zamenhof tau tsim xyoo 1887 ua \"Lus Thoob Ntiaj Teb\" (la Lingvo Internacia), nws yog hom lus thib ob rau kev sib txuas lus thoob ntiaj teb. Cov neeg uas tau siv hom lus no thaum ub nyiam lub npe Esperanto thiab tsis ntev tom qab ntawd siv nws los piav txog nws hom lus. Lo lus no txhais ua lus Hmoob tias \"ib tug neeg uas muaj kev cia siab\"." },
        { "cell": "dotted", "text": "Ib tug Hmoob Asmeskas yog ib tug neeg nyob hauv lub teb chaws As Mes Lis Kas uas yog haiv neeg Hmoob qhovntsej thiaj tsis mob. Hmoob Asmeskas yog ib pawg neeg Esxias Asmeskas. Ntau Nplog Hmoob tawg rog rog tsiv mus rau U.S. tom qab tau hauj cov kooj tsham lwm cov teb chaws Nplog xyoo 1975. Thaum pib nyob rau nqeg ntawm xyoo ntawd, cov thawj Hmoob tawg rog txog nyob rau tebchaws Meskas, kev ntawm refugee camps hauv Thaib teb; Txawm li ntawd los, cov 3,466 xwb tau kev tso cai ncuab lub sij hawm no nyob rau hauv qhov Refugee Assistance Act ntawm xyoo 1975." },
        { "cell": "dotted", "text": "L. L. Zamenhof (1859–1917) yog tus tsim Esperanto, uas yog hom lus pabcuam thoob ntiaj teb uas siv dav tshaj plaws." },
        { "cell": "dotted", "text": "Hauv lub tebchaws S. U. As-Meb-Zis-Khas yog ib tug tsoom fwv teb chaws koom pheej uas muaj tsib caug lub xeev thiab tsoom fwv teb chaws koog tsev kawm ntawv. Ntawm 9,85 lab km2 thiab nrog nyob ib ncig ntawm peb puas thiab kaum yim lab cov neeg, hauv lub tebchaws As-Meb-Zis-Khas yog lub ntiaj teb no tus thib plaub-loj tshaj plaws lub teb chaws los ntawm tag nrho cov cheeb tsam thiab thib peb-loj tshaj plaws los ntawm cov pejxeem. Nws yog ib tug ntawm lub ntiaj teb no lub feem ntau ntau hom neeg thiab ntau kab lis kev cai haiv neeg, cov khoom ntawm loj tuaj txawv teb chaws los ntawm ntau lub teb chaws." },
        { "cell": "year", "text": "1156 - Austria sib cais los ntawm cov neeg sab nraud Duchy ntawm Bavaria nyob rau hauv lub German Reich, subordinate mus rau lub huab tais" },
        { "cell": "year", "text": "1276 - pib ntawm Habsburg txoj cai, uas 1438-1806 xyoo twb kav cov vaj ntxwv, ces emperors ntawm tus Vaj Ntsuj Roman faj tim teb chaws" },
        { "cell": "year", "text": "1284 - Mev King Alfonso X cov Wise hu ua lub teb chaws no - Austria, «uas, lawv hais tias, tam sim no hu ua Astarrika.\"" },
        { "cell": "year", "text": "1359 - thaum Rudolf IV (kav 1358-1365 xyoo) rulers ntawm Austria tau txais lub title archdukes" },
        { "cell": "year", "text": "1526 - lub accession ntawm Croatia thiab cov Czech koom pheej mus Austria" },
        { "cell": "year", "text": "1683 - thib ob siege ntawm Vienna los ntawm lub Turks thiab tag nrho yeej ntawm Turkish pab tub rog ntawm Polish-Austrian-German troops" },
        { "cell": "decimals", "text": "Austria - ib lub teb chaws nyob rau hauv Central teb chaws Europe. Cov pej xeem ntawm 8,46 lab cov neeg. Peev - Vienna. Raug raws ntaub ntawv cov lus - German." },
        { "cell": "decimals", "text": "Mev yog understood plhuav tshaj lus nyob rau Western Hemisphere, nrog cov teeb meem loj coob txog cov haiv neeg tham Spanish xws li taub Patagonia kom deb li deb tau north li New York City thiab Chicago. Ntxiv thiab, muaj ntau dua 10,000,000 npliag second lus tham hauv Brazil thiab teb chaws Mis Kas. Txij li xyoo rau thaum ntxov 21st pua, nws muaj arguably superseded Fabkis hauv kab lus uas muaj ob-feem-hluas qhov thiab hom lus thib ob nyob thoob ntiaj teb sib tham, tom qab Hmon" },
        { "cell": "decimals", "text": "Esperanto yog hom lus pabcuam thoob ntiaj teb uas ua tau zoo tshaj plaws thiab yog tib hom lus zoo li no uas muaj cov neeg hais lus ib txwm muaj (denaskuloj), uas kwv yees li ntawm 2,000. Kev kwv yees siv yog qhov nyuaj, tab sis ob qhov kev kwv yees tso tus naj npawb ntawm cov neeg uas paub hais lus Esperanto ntawm kwv yees li 100,000." },
        { "cell": "decimals", "text": "Fabkis txoj kev lag luam muaj ze txog 2.9 lab tuam txhab sau npe. Tsoomfwv muaj ntau txoj hauv kev nyob hauv kev tsheb ciav hlau, hluav taws xob, dav hlau, thiab kev sib txuas lus. Nws tseem tuaj yeem tso foob pob hluav taws los ntawm Fabkis Guiana." },
        { "cell": "decimals", "text": "Nyob rau 1 Lub Ib Hlis 2008, tau kwv yees tias muaj 63,8 lab tus tib neeg nyob hauv Fab Kis, suav nrog rau Tebchaws Fab Kis Tebchaws Asmeskas. 61,875,000 ntawm cov nyob rau thaj tsam ntawm Fabkis, yog ib feem ntawm lub tebchaws uas yog nyob hauv Europe." },
        { "cell": "decimals", "text": "Fab Kis yog qhov chaw thib ib hauv lub ntiaj teb. Nyob rau xyoo 2007, muaj 81,9 lab tus tuab neeg txawv tebchaws tuaj ncig saib tebchaws Fabkis. Qee qhov chaw nto moo tshaj plaws hauv Paris, yog Eiffel Ntauwd thiab Arc de Triomphe. Muaj dua ib tug yog Mont Saint Michel, hauv Normandy." },
        { "cell": "ordinal-latin", "text": "Lub duas no muaj npe tom qab thaler. Tus thaler yog ib lub nyiaj npib loj ua ntej xyoo 1518. Tus thaler npe hu ua Joachimsthal (Joachim Vad) kuv hauv Bohemia (Thal txhais tau hais tias nyob rau hauv German). Tom qab Spanish Peso yog tib yam loj thiab feem ntau hu ua \"Spanish dollar\". Nyob rau hauv lub xyoo pua paub nws ua ib lub ntiaj teb txiaj. Muaj ntau lub teb chaws txiaj ntsim yog cov Asmeskas nyiaj xws li cov tam sim no hu ua dollar los yog peso thiab Japanese yen, Indian rupee thiab Chinese Renminbi." },
        { "cell": "ordinal-latin", "text": "Nyab laj yog sab hnub tuaj teb chaws nyob rau hauv lub Indochina ceg av qab teb nyob rau sab Asia. Nrog ib tug yees 90,5 lab neeg uas nyob raws li ntawm 2014, nws yog ib lub ntiaj teb 13th feem ntau nyob lub teb chaws, thiab lub yim-feem ntau-nyob Asian teb chaws. Lub teb chaws yog ciam teb rau lwm Tuam Tshoj rau sab qaum teb, Nplog mus rau lub qaum teb hnub poob, Qhab Meem teb mus rau lub southwest, thiab rau sab qab zog Tuam Tshoj Hiav txwv rau sab hnub tuaj. Lub teb chaws tseem tau raug theem ntawm cov nyiaj khwv tau los tsis sib xws, tu ncua heev txug kev nkag mus rau kev kho mob, thiab ib tug tsis muaj tub los ntxhais koob pheej ntawm lawv." },
        { "cell": "ordinal-latin", "text": "\"Yexus Lub Tshawj Tseeb\" yog ib lub koom txoos ua tau raug tsim tsa nyob rau Pemceeb, Suav Teb nyob rau xyoo 1917. Niaj hnub niam no, nws muaj li ntawm 2.5 roob tus ntseeg hauv tsib caug peb lub teb chaws thiab rau daim av loj. Lub tshawj no yog ib lub ntawm cov Pentecostal pawg uas ntseeg Yexus uas tau raug tsa rau tiam neesnkaum nyob rau tebchaws Asmesliska. Lawv muaj hom phiaj tshaj txoj moo zoo rau txhua haiv neeg ua ntej Tswv Yexus los zaum ob. Kaum txoj kev ntseeg ntawm lub tshawj yog:" },
        { "cell": "units", "text": "Nws muaj ciam teb rau lwm nrog lub Czech koom pheej (362 km) rau sab qaum teb-sab hnub tuaj - nrog Slovakia (91 km) rau sab hnub tuaj - nrog Hungary (366 km) rau sab qab teb - nrog Slovenia (330 km) thiab Ltalis (430 km) rau sab hnub poob - Liechtenstein (35 km) thiab Switzerland (164 km) rau sab qaum teb-sab hnub poob - nrog lub teb chaws Yelemees (784 km)." },
        { "cell": "units", "text": "Zog ntawm Guj kuj - ib lub teb chaws nyob rau hauv Eastern Europe thiab qaum teb Asia. Pejxeem - 146.270.033 neeg. (2015), lub chaw uas zoo heev - 17.125.187 km². Nws yog ib qhov loj tshaj plaws nyob rau hauv lub ntiaj teb no nyob rau hauv cov av cheeb tsam thiab cuaj loj tshaj plaws los ntawm cov pejxeem." },
        { "cell": "units", "text": "Lub teb chaws Yelemees (Deutschland), yog ib tug tsoom fwv teb chaws koom pheej nyob rau hauv lub sab hnub poob ntawm teb chaws Europe. Nws muaj kaum num xeev, thiab npog thaj 357.021 km2 nrog ib tug loj tsis kub tsis txias raws caij nyoog kev nyab xeeb. Nws loj tshaj plaws nroog yog Berlin. Lub teb chaws Yelemees yog ib tug loj nyiaj txiag thiab kev nom kev tswv lub hwj chim thiab feeb ib tug thawj coj nyob rau hauv ntau kab lis kev cai, kev tshawb xav thiab kev teb. Nrog dhau yim caum lab tus tib neeg, lub teb chaws Yelemees yog lub feem ntau loj tshaj plaws hauv lub xeev nyob rau hauv cov European Union. Nws yog ib tug tsim lub teb chaws nrog ib tug heev tus qauv ntawm nyob, muaj ib tug kev sib raug zoo ruaj ntseg uas muaj xws li lub ntiaj teb no tus hlob kho mob. Paub rau nws cov nplua nuj kab lis kev cai thiab kev nom kev tswv yav dhau los, lub teb chaws Yelemees tau lub tsev uas muaj ntau ntxias, tshuab raj, ua lag luam, kws tshawb fawb thiab cov neeg uas txua yam." },
        { "cell": "ranges", "text": "1740-1748 - Tsov rog ntawm lub Austrian succession; Maria Theresa muab Prussia Silesia" },
        { "cell": "ranges", "text": "Txij li thaum 1156 Austria - Duchy, 1453 - Archduchy, txij li thaum 1804 - lub Habsburg faj tim teb chaws, nyob rau hauv lub xyoo 1867-1918 - Austria-Hungary (dualistic - dual monarchy)." },
        { "cell": "currency", "text": "Raws li xov tooj ntawm tes ua nrov nrov, lawv tau pib them nqi tsawg, thiab ntau tus neeg muaj peev xwm them taus. Cov tswv yim hli pib muaj rau cov nqi qis dua US$30 lossis US$40 ib hlis. Cov xov tooj ntawm tes tau ua kom pheej yig rau tus kheej tias lawv tau hloov cov xov tooj thiab cov xov tooj hauv lub xov tooj tshwj tsis yog rau cov cheeb tsam nroog nrog ntau tus neeg." },
        { "cell": "abbrev", "text": "Tus Aub (Canis lupus familiaris) yog ib tug feem ntau tsiaj plaub ntxhov thiab nqaij noj tug tswv cuab ntawm tus aub tsev neeg. Dev yog feem ntau hu ua \"txiv neej phooj ywg zoo tshaj\". Tus aub yog thawj nyeg tsiaj thiab tau dav khaws cia raws li ib tug ua hauj lwm, mus yos hav zoov, thiab cov tsiaj luag. Nws yog kwv yees muaj nyob nruab nrab ntawm 700 lab thiab ib tug billion dev, ua rau lawv muaj ntau tug tswv cuab ntawm kev txiav txim nqaij noj." },
        { "cell": "abbrev", "text": "Aus-rab-lias yog ib tug ntawm cov tsim lub teb chaws, ua lub thib kaum peb loj tshaj plaws kev khwv nyiaj txiag nyob rau hauv lub ntiaj teb no thiab muaj lub thib rau loj tshaj plaws nyob rau hauv lub ntiaj teb no nyob rau hauv cov nqe lus ntawm GDP ib capita. Aus-rab-lias cov tub rog siv yog lub kaum ob loj tshaj plaws nyob rau hauv lub ntiaj teb no. Qhov thib ob siab tshaj plaws Human Development Index, Aus-rab-lias Qib heev nyob rau hauv ntau qhov chaw, xws li muaj lub neej zoo, noj qab haus huv, kev kawm ntawv, nyiaj txiag txoj kev ywj pheej, kev tiv thaiv ntawm kev ywjpheej thiab kev nom kev tswv txoj cai. Aus-rab-lias yog ib tug tswv cuab ntawm lub G20, OECD, WTO, APEC, UN, teb chaw ntawm Nations, ANZUS, thiab cov Pacific Islands lub rooj sab laj." },
        { "cell": "abbrev", "text": "Aus-rab-lias muaj rau lub xeev, ob thooj av loj ib cheeb tsam thiab lwm yam me me cheeb tsam. Lub xeev yog Vis-thob-zia (VIC), Western Aus-rab-lias (WA), Kheeb-xwg teb (Queensland), New South Wales (NSW), Tas-hmab-nias (TAS) thiab South Aus-rab-lias (SA). Ob tug loj thooj av loj territories yog cov Northern Territory (NT), thiab Tsoom Fwv Teb Chaws Capital ib ncig (ACT). Txheej xwm ntawm lub cheeb tsam yog heev uas zoo sib xws statehood, tsuas hais tias cov tsoom fwv teb chaws Parliament yuav ntxeev cai tej kev txiav txim siab ntawm lub Parliament ib ncig, thaum lub sij hawm nyob rau hauv relation mus rau hauv lub US tsoom fwv teb chaws txoj cai overrides lub xeev txoj cai xwb nyob rau hauv tus neeg mob nyob rau hauv seem teev 51 ntawm lub Constitution. Tag nrho lwm yam teeb meem yog lub luag hauj lwm ntawm lub xeev, xws li kev kho mob, kev kawm ntawv, kev cai lij choj thiab kev txiav txim, pej xeem thauj, txoj kev, judiciary thiab tsoom fwv hauv zos." },
        { "cell": "abbrev", "text": "British Broadcasting Corporation (BBC), yog ib lub koom haum hauv UK. Nws tshaj tawm hauv tebchaws United Kingdom thiab lwm lub teb chaws hauv TV, xov tooj cua thiab hauv Internet. Cov BBC kuj muag nws cov kev pab cuam rau lwm lub koom haum tshaj tawm thoob ntiaj teb." },
        { "cell": "abbrev", "text": "Lub koom haum yog khiav los ntawm ib pab pawg neeg ntawm kaum ob governors uas tau txais txoj hauj lwm los ntawm tus poj huab tais, ntawm lub tswv yim ntawm tsoom fwv cov koom haum. Cov thawj tswj hwm xaiv lub Rooj Tswjhwm Saib Xyuas kev tswj haujlwm los khiav cov lag luam ntawm cov BBC." },
        { "cell": "abbrev", "text": "Batman los rau Joker, Catwoman, The Riddler, Bane, Batgirl, Robin, Penguin qab lus mob kab DC Comics los ib txog. Bob Kane. Bill Finger." },
        { "cell": "latin-in-native", "text": "Tsoom fwv teb chaws lub xeev, ib tug parliamentary koom pheej. Muab faib mus rau hauv tsoom fwv teb chaws cuaj lub xeev." },
        { "cell": "latin-in-native", "text": "VI-VIII xyoo pua - migration mus rau lub cheeb tsam ntawm Bavarian thiab Slavic pab pawg" },
        { "cell": "latin-in-native", "text": "803 - creation ntawm Charlemagne Avar Lub peb hlis ntuj" },
        { "cell": "latin-in-native", "text": "1687 - accession ntawm Hungary thiab Transylvania" },
        { "cell": "latin-in-native", "text": "1713 - rov tswj ntawm ltalis thiab cov lus Mev Netherlands" },
        { "cell": "latin-in-native", "text": "1804 - Franz tau ΙI tau txais lub title ntawm huab tais ntawm Austria" },
        { "cell": "percent", "text": "Cov txiv qaub (Citrus limon) yog ib hom ntoo me me uas muaj tsob ntoo ntsuab hauv cov paj ntoo hauv tsev neeg Rutaceae, ib txwm nyob rau Asia, feem ntau Is Nrias teb (Assam), lossis Tuam Tshoj. Tsob ntoo cov txiv hmab txiv ntoo ellipsoidal daj yog siv rau kev ua noj ua haus thiab tsis yog ua noj ua haus thoob plaws ntiaj teb, feem ntau yog rau nws cov kua txiv hmab txiv ntoo, uas muaj ob qho tib si ua noj ua haus thiab tu siv. Lub pulp thiab rind kuj yog siv los ua noj thiab ci. Cov kua txiv ntawm txiv qaub yog kwv yees li 5% mus rau 6%, nrog pH ntawm ib ncig ntawm 2.2, muab nws cov qaub saj." },
        { "cell": "zero-width", "text": "Lub pob ntseg yog lub hauv nruab nrog cev uas ua kom hnov ​​lus thiab, hauv cov tsiaj nyeg, lub cev sib npaug siv lub vestibular system. Hauv cov tsiaj nyeg, pob ntseg feem ntau tau piav qhia tias muaj pob ntseg yog lub hauv paus ntawm kev hnov ​​lus thiab sib npaug. Qhov chaw ntawm pob ntseg muaj xws li: Pob ntseg sab nraud lossis sab nrauv, muaj xws li: Pinna lossis auricle. Qhov no yog sab nraud ntawm pob ntseg." },
        { "cell": "roman", "text": "Lub tsev ntawm Habsburg, uas yog txuam nrog rau txoj cai ntawm lub flowering ntawm lub Austrian lub xeev, tuaj rau lub hwj chim nyob rau hauv lub xyoo pua XIV, thiab los ntawm 1438 mus 1806 xyoo Archduke ntawm Austria ris lub npe ntawm huab tais ntawm tus Vaj Ntsuj Roman faj tim teb chaws." },
        { "cell": "initialism", "text": "Tus Kab Mob Khaus Lauv Nam Vais Lav (Coronavirus, COVID-19) yog ib tus mob khaub thuas uas tshwm sim los ntawm ib tus kab mob vais lav (virus) uas muaj peev xwm sib kis tau los ntawm ib tus neeg mus rau lwm tus neeg. Tus kab mob vais lav (virus) uas ua rau tshwm sim muaj Tus Kab Mob Khaus Viv-19 (COVID-19) yog ib tus kab mob khaus lauv nam vais lav (coronavirus) tshiab uas tau sib kis mus thoob plaws lub ntiaj teb. Cov tsos mob ntawm Tus Kab Mob Khaus Viv-19 (COVID-19) muaj peev xwm suav xam los ntawm kev mob khaub thuas me ntsis txog rau kev mob khaub thuas hnyav (los sis tsis muaj cov tsos mob hlo li)." },
        { "cell": "initialism", "text": "Koj muaj peev xwm kis tau kab mob los ntawm kev tiv tauj nyob sib ze (cov kev nyob sib nrug deb thaj tsam li 6 fij (feet) los sis ob dag tes) nrog rau ib tus neeg uas muaj Tus Kab Mob Khaus Viv-19 (COVID-19). Tus Kab Mob Khaus Viv-19 (COVID-19) thaum xub thawj ces nws sib kis los ntawm ib tus neeg mus rau lwm tus neeg. Koj muaj peev xwm kis tau kab mob los ntawm cov tee nrog los ntawm txoj hlab ua pa thaum ib tus neeg kis tau kab mob lawm ntawd hnoos, txham, los sis tham lus. Tsis tas li ntawd, koj kuj tseem muaj peev xwm kis tau tus kab mob ntawd los ntawm kev tuav (chwv) ib qho chaw (npoo los sis ntug) los sis khoom uas muaj tus kab mob vais lav (virus), thiab tag ntawd kuj tseem sib kis tau los ntawm kev tuav (chwv) koj lub qhov ncauj, qhov ntswg, los sis qhov muag." },
        { "cell": "initialism", "text": "Nyob twj ywm hauv tsev yog hais tias koj muaj mob, tshwj tsis yog tias yuav tsum tau txais kev saib xyuas kho mob Zam tsis txhob siv kev siv tsheb thauj xa zej tsoom mus los, kev caij tsheb ua ke nrog lwm tus neeg, los sis tsheb tav xij. Cais koj tus kheej tawm ntawm lwm cov neeg thiab cov tsiaj nyeg nyob rau hauv koj vaj tsev. Tsis tau muaj ib txoj ncauj kev kho mob xab phaub twg rau Tus Kab Mob Khaus Viv-19 (COVID-19), tab sis koj muaj peev xwm nrhiav tau kev saib xyuas kho mob txhawm rau pab ntaus koj cov tsos mob kom tsis txhob mob loj. Yog hais tias koj xav tau kev pab tshwj xeeb txog fab kev kuaj mob, hu xov tooj qhia ua ntej." },
        { "cell": "initialism", "text": "Txhua tus neeg yeej muaj kev pheej hmoo kis tau Tus Kab Mob Khaus Viv-19 (COVID-19). Cov neeg laus thiab cov neeg txhua hom hnub nyoog uas muaj cov yam ntxwv mob lwm yam txuam nrog loj lawm tej zaum yuav muaj kev pheej hmoo siab dua txog rau kev mob khaub thuas hnyav ntau dua." },
        { "cell": "initialism", "text": "Gangnam yeej (Kauslim Teb: 강남스타일, IPA: [kaŋnam sɯtʰail]) yog K-pop xwb los rau sab qab zog Kauslim teb tshuab raj PSY. Nkauj tawm rau lub Xya hli 15, 2012, yog cov hlau lead tes ntawm nws thib rau Studio Album PSY 6, Ib feem 1. \"Gangnam Style\" debuted ib tug naj npawb rau lub Gaon ncaj, lub teb chaws ntawv daim ntawv ntawm cov kaus lim qab teb." },
        { "cell": "initialism", "text": "Cov kab lus \"Gangnam Style\" yog ib tug neologism Korean uas hais txog ib txoj kev ua neej nrog lub Gangnam District of Seoul. Zaj kwv txhiaj thiab nws cov yees duab music accompanying mus tus kab mob tom qab lub yim hli ntuj 2012 thiab pawg nrov nyuas txij thaum ntawd los. \"Gangnam Style\" txais mixed rau txoj kev xyuas, uas mus rau nws tus catchy khiav nrawm thiab PSY ntawv txaus luag seev cev xyaum nyob rau hauv cov suab seev yees duab thiab lub sij hawm nyob nrug ntawm ntau qhov chaw xws li Madison Square Garden, The Today Show, The Ellen DeGeneres Show, thiab Samsung coj mus muag" },
        { "cell": "grouped", "text": "Hmoob Paub tias \"Miao\" mas nyob rau Suav teb yog lub suab hais lus pab cov ceg West Hmongic txog cov cov lus \"Miao\" mas, tej zaum kuj paub tias raws li tus Chuanqiandian sawv, hais cov uas lus los ntawm cov neeg Hmoob ntawm Sichuan, Yunnan, Guizhou, Guangxi, qaum teb Nyab Laj teb, Thaib teb thiab los tsuas teb. Muaj ib co 2.7 vam tham txog yam uas tau muaj kev lom zem ntau nrog intelligible, nrog rau cov 260,000 Hmoob Americans. Tshaj ib nrab ntawm tag nrho cov Hmoob tham hais lus ntau lub dialects ntawm pawg Chuanqiandian rau hauv Suav teb, thiab lub suab hais lus Dalnanxshanb (大南山) ntawm Chuanqiandian lub hauv paus uas txheem lus nyob rau hauv Suav teb, tab sis Hmoob Daw \"Miao\" (dawb mas) thiab Mong ntsuab tsim \"Miao\" (ntsuab mas) ntau lug paub txawv tebchaw vim emigration. Hmongs nyob hauv California tau tsim ib tug Hmoob-Hmong online (computer) txhais (as of 2012). Tseem muaj neeg tsiv teb Hmoob uas nyob rau hauv Canada, tab sis yog tsis li muaj ntau nyob rau hauv lub tebchaws United States." },
        { "cell": "grouped", "text": "Cantonese yog hais los ntawm cov neeg nyob rau yav qab teb suav, Hong koob, Macau, Malaysia thiab Singapore, thiab cov chaw uas muaj ntau lub teb chaws Suav uas tuaj ntawm Cantonese hais lus ntawm Suav teb, xws li Melbourne. Nws tseem yog hom lus tshaj tawm ntawm cov Neeg Suav Tebchaws Suav Tebchaws Nplog Tebchaws Asmeskas thiab North America. Nws hais tias tshaj 100,000,000 tus neeg hais lus Cantonese. Nws yog ib hom lus ntawm tonal nrog 6 hom tones. Hos Cantonese tsuas yog cov lus thib peb uas hais lus Suav, tsuas yog qab Mandarin thiab Wu, nws txoj haujlwm hauv Hong Kong thiab Macau ua kom nws paub dav dav ntawm lwm cov lus Suav." },
        { "cell": "grouped", "text": "Wikipedia tau pib thaum Lub Ib Hlis 15, 2001 nrog cov lus Askiv thiab nws muaj ntau dua 35,000,000 cov lus hauv ntau hom lus, suav nrog 77 nplooj ntawv hauv Hmoob. Feem ntau ntawm cov kab lus no yog hom lus uas tsis yog lus Askiv. Txhua hnub, ntau pua tus neeg los ntawm thoob plaws lub ntiaj teb ua ntau pua qhov kev hloov pauv thiab tsim ntau yam tshiab." },
        { "cell": "letter-name", "text": "Fabkis yog tus tswv cuab ntawm G8 pawg ntawm cov thawj coj hauv kev lag luam. Fabkis muaj yim-kev lag luam loj tshaj plaws hauv ntiaj teb los ntawm cov khoom lag luam thoob ntiaj teb. Fabkis thiab kaum tus lwm cov tswvcuab ntawm European Union tau koom tes tsim tsa ib cov nyiaj euro hnub tim 1 Lub Ib Hlis 1999 thiab pib siv xyoo 2002." },
        { "cell": "letter-name", "text": "\"Miao\" horned mas (Ch. \"\"Miao Jiao mas , nws pib. Hmo los yog A-Hmo)" },
        { "cell": "letter-name", "text": "Lub plab yog lub cev J-puab uas zom zaub mov. Nws tsim cov enzymes (cov tshuaj uas tsim cov tshuaj tiv thaiv) thiab cov kua qaub (cov kua txiv hmab txiv ntoo). Qhov sib xyaw ntawm cov enzymes thiab cov kua txiv hmab txiv ntoo zom cov zaub mov kom nws tuaj yeem dhau mus rau koj cov hnyuv. Koj lub plab yog ib feem ntawm txoj hnyuv (GI). Lub plab yog lub cev nqaij daim tawv, hollow organ nyob rau hauv lub plab hnyuv ntawm tib neeg thiab ntau lwm yam tsiaj, nrog rau ob peb invertebrates. Lub plab muaj nyob ntawm ube-zoo li lub cev hauv plab uas tau txais ib feem ntawm cov zaub mov digested los ntawm lub plab, absorbs as-ham thiab kis tau cov zaub mov digested mus rau lub ntsiab tseem ceeb ntawm cov kab mob kis tau los ntawm peb txhais tes." },
        { "cell": "quote-letter", "text": "Los Tshuas Teb yog teb chaws nyob Esxias. Lus Askiv hu Lao People's Democratic Republic." },
        { "cell": "quote-letter", "text": "Tag nrho cov ntxhw muaj ob peb txawv nta lub feem ntau tseem ceeb ntawm uas yog ib tug ntev lub cev, siv rau ntau lub hom phiaj, tshwj xeeb yog ua pa txhawb nqa, txhawb dej thiab ntug dej khoom. Lawv cov hniav loj hlob mus rau hauv kaus hniav, uas yuav ua riam phom thiab raws li cov cuab yeej rau tsiv khoom thiab kev khawb. Ntxhw 'loj pob ntseg pab kom tswj tau lawv lub cev kub." },
        { "cell": "quote-letter", "text": "Cov thawj kaw tseg siv lo lus \"Suav teb\" yog hnub tim 1555. nws yog derived ntawm chīnī, ib tug Persian adjective ntsiab 'Suav' uas yog popularized nyob teb chaws Europe los ntawm Marco Polo." },
        { "cell": "quote-letter", "text": "Lub xov tooj txawb tau siv los sib txuas lus ntev ntev uas tsis muaj xov tooj. Nws ua haujlwm los ntawm kev txuas lus nrog lub chaw nres tsheb nyob ze uas txuas nws mus rau lub xov tooj tseem ceeb. Thaum tsiv, yog hais tias lub xov tooj txawb tau deb ntawm lub xov tooj ntawm tes nws txuas nrog, tias xovtooj xa lus mus rau lwm lub xov tooj los qhia cov xovtooj tshiab coj mus tshaj tawm. Qhov no hu ua ‘tes tawm’, thiab hu xov tooj txuas ntxiv nrog tus xovtooj tshiab ntawm lub xov tooj txuas nrog. Kev ntxuav tes yog ua kom zoo thiab ua tib zoo ua kom tus neeg siv yuav tsis paub txawm tias qhov kev hu xov tooj tau xa mus rau lwm lub xov tooj." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "\"Crocodile\" Dundee yog ib xyoo 1986 Australian American romantic comedy taug txuj kev nyuaj. Nws tau teev nyob rau hauv Australian Outback thiab nyob rau hauv New York City. Nws cov hnub qub Paul Hogan thiab Linda Kozlowski.",
        "Aus-rab-lias - ib lub teb chaws nyob rau hauv lub yav qab teb Hemisphere, occupying thooj av loj Aus-rab-lias, cov kob ntawm Tasmania, thiab ob peb lwm yam islands nyob rau hauv lub Indian thiab Pacific Oceans; yog lub thib rau lub xeev los ntawm cheeb tsam nyob rau hauv lub ntiaj teb no. Rau sab qaum teb ntawm lub teb chaw ntawm teb chaws Aus-rab-lias nyob East Timor, Ee-dos-neb-xias thiab Wp/mww/Pes-puab - Tshiab Nkib-nis (Papua Niugini), mus rau sab qaum teb-sab hnub tuaj - Vanuatu, Tshiab Caledonia thiab cov Solomon Islands, mus rau sab qab teb-sab hnub tuaj - Tshiab Txib teb (en. New Zealand). Lub shortest kev ncua deb ntawm lub ntsiab kob ntawm Papua - Tshiab Guinea thiab lub mainland ntawm teb chaws Aus-rab-lias tsuas yog 145 km deb, thiab los ntawm Aus-rab-lias kob Boigu Island rau Papua - Tshiab Guinea - tsuas yog 5 kis lus mev. Pejxeem rau lub Ob Hlis 7, 2015 yog 23,822,747, feem ntau ntawm uas nyob rau hauv lub zos nyob rau hauv lub sab hnub tuaj ntug dej hiav txwv.",
        "Tsoom fwv teb chaws lub xeev, ib tug parliamentary koom pheej. Muab faib mus rau hauv tsoom fwv teb chaws cuaj lub xeev.",
        "Kuv century BC. e. - Lub conquest ntawm cov neeg Loos inhabiting lub ib ncig ntawm hnub no lub Austria Celtic pab pawg neeg boyev, Taurisci thiab ozeriatov thiab nkag mus rau hauv ib ncig ntawm lub xeev ntawm Noricum (nrhiav tau 15 BC. E.) Thiab Pannonia (nrhiav tau nyob rau hauv '10 n. E., Ces muab faib ua Upper Pannonia, uas muaj ib feem ntawm tam sim no-hnub Austria thiab Txo Pannonia). Ciam teb ntawm lub xeev tuav lub western lub zos Vindobona (Vienna), yog nyob rau hauv Pannonia.",
        "1276 - pib ntawm Habsburg txoj cai, uas 1438-1806 xyoo twb kav cov vaj ntxwv, ces emperors ntawm tus Vaj Ntsuj Roman faj tim teb chaws",
        "1683 - thib ob siege ntawm Vienna los ntawm lub Turks thiab tag nrho yeej ntawm Turkish pab tub rog ntawm Polish-Austrian-German troops",
        "1804 - Franz tau ΙI tau txais lub title ntawm huab tais ntawm Austria",
        "1995 - ua tswv cuab nyob rau hauv cov European Union",
        "Nyob rau hauv 788, ib ncig twb siv rau hauv lub faj tim teb chaws ntawm Charlemagne.",
        "Nyob rau hauv 1919, tsoom fwv teb chaws kev cai txoj cai hais tias Austria tsoom fwv teb chaws ywj pheej parliamentary koom pheej, uas tsim lub Federal los ua ke raws li ib tug PatientsÕ lub cev muaj li ntawm Tsoom Fwv Teb Chaws Council thiab lub teb chaws Council, qhov chaw ntawm lub Federal Thawj Tswj Hwm, Tsoom Fwv Teb Chaws Chancellor thiab tsoom fwv teb chaws cov nom tswv thiab tsoom fwv teb chaws tsoom fwv.",
        "British Broadcasting Corporation (BBC), yog ib lub koom haum hauv UK. Nws tshaj tawm hauv tebchaws United Kingdom thiab lwm lub teb chaws hauv TV, xov tooj cua thiab hauv Internet. Cov BBC kuj muag nws cov kev pab cuam rau lwm lub koom haum tshaj tawm thoob ntiaj teb.",
        "Koj muaj peev xwm kis tau kab mob los ntawm kev tiv tauj nyob sib ze (cov kev nyob sib nrug deb thaj tsam li 6 fij (feet) los sis ob dag tes) nrog rau ib tus neeg uas muaj Tus Kab Mob Khaus Viv-19 (COVID-19). Tus Kab Mob Khaus Viv-19 (COVID-19) thaum xub thawj ces nws sib kis los ntawm ib tus neeg mus rau lwm tus neeg. Koj muaj peev xwm kis tau kab mob los ntawm cov tee nrog los ntawm txoj hlab ua pa thaum ib tus neeg kis tau kab mob lawm ntawd hnoos, txham, los sis tham lus. Tsis tas li ntawd, koj kuj tseem muaj peev xwm kis tau tus kab mob ntawd los ntawm kev tuav (chwv) ib qho chaw (npoo los sis ntug) los sis khoom uas muaj tus kab mob vais lav (virus), thiab tag ntawd kuj tseem sib kis tau los ntawm kev tuav (chwv) koj lub qhov ncauj, qhov ntswg, los sis qhov muag.",
        "Txhua tus neeg yeej muaj kev pheej hmoo kis tau Tus Kab Mob Khaus Viv-19 (COVID-19). Cov neeg laus thiab cov neeg txhua hom hnub nyoog uas muaj cov yam ntxwv mob lwm yam txuam nrog loj lawm tej zaum yuav muaj kev pheej hmoo siab dua txog rau kev mob khaub thuas hnyav ntau dua.",
        "Daim tawv nqaij yog txheej ntawm feem ntau mos, hloov tau cov ntaub so ntswg npog lub cev ntawm ib tug vertebrate; Lwm yam tsiaj npog; Txhua tus tsiaj muaj qee cov plaub hau ntawm lawv daim tawv nqaij yog lub cev loj tshaj plaws. Nws npog tag nrho lub cev. Nws ua haujlwm tiv thaiv tshav kub, lub teeb, raug mob, thiab kis kab mob.",
        "Esperanto yog hom lus pab uas neeg hais ntau tshaj plaws hauv ntiaj teb. L. L. Zamenhof tau tsim xyoo 1887 ua \"Lus Thoob Ntiaj Teb\" (la Lingvo Internacia), nws yog hom lus thib ob rau kev sib txuas lus thoob ntiaj teb. Cov neeg uas tau siv hom lus no thaum ub nyiam lub npe Esperanto thiab tsis ntev tom qab ntawd siv nws los piav txog nws hom lus. Lo lus no txhais ua lus Hmoob tias \"ib tug neeg uas muaj kev cia siab\".",
        "Fab Kis nyob rau sab hnub poob Yu Laus teb. Fabkis sib koom nrog nws cov ciam teb nrog Belgium, Luxembourg, Lub Tebchaws Yelemees, Switzerland, Ltalis, Monaco, Andorra, thiab Spain. Fabkis muaj ob lub roob nyob ze nws cov ciam: Alps nyob rau sab hnub tuaj thiab Pyrenees nyob rau sab qab teb. Muaj ntau cov dej ntws hauv Fabkis, suav nrog Seine thiab Loire. Nyob rau sab qaum teb thiab sab hnub poob ntawm Fabkis, muaj cov roob me thiab hav hav dej tsis muaj zog.",
        "Fabkis txoj kev lag luam muaj ze txog 2.9 lab tuam txhab sau npe. Tsoomfwv muaj ntau txoj hauv kev nyob hauv kev tsheb ciav hlau, hluav taws xob, dav hlau, thiab kev sib txuas lus. Nws tseem tuaj yeem tso foob pob hluav taws los ntawm Fabkis Guiana.",
        "Fab Kis yog qhov chaw thib ib hauv lub ntiaj teb. Nyob rau xyoo 2007, muaj 81,9 lab tus tuab neeg txawv tebchaws tuaj ncig saib tebchaws Fabkis. Qee qhov chaw nto moo tshaj plaws hauv Paris, yog Eiffel Ntauwd thiab Arc de Triomphe. Muaj dua ib tug yog Mont Saint Michel, hauv Normandy.",
        "Zog ntawm Guj kuj - ib lub teb chaws nyob rau hauv Eastern Europe thiab qaum teb Asia. Pejxeem - 146.270.033 neeg. (2015), lub chaw uas zoo heev - 17.125.187 km². Nws yog ib qhov loj tshaj plaws nyob rau hauv lub ntiaj teb no nyob rau hauv cov av cheeb tsam thiab cuaj loj tshaj plaws los ntawm cov pejxeem.",
        "Guj kuj txoj hauj lwm nyob rau hauv sab qaum teb Eurasia (ib ncig ntawm lub teb chaws cov lus dag feem ntau sab qaum teb ntawm 50 ° N. M.) Coj mus rau nws qhov kev tso kawm nyob rau hauv lub arctic, subarctic, tsis kub tsis txias thiab cov subtropical climates. Lub predominant ib feem ntawm lub chaw uas zoo heev nyob rau hauv lub cheeb tsam tsis kub tsis txias. Qhov ntau haiv kev nyab xeeb tseem nyob ntawm lub topography thiab qhov sib thooj los yog remoteness ntawm lub hiav txwv.",
        "Lavxias teb sab neeg hais lus ntau tshaj 100 yam lus thiab suab teej tug mus rau lub Indo-European, Uralic thiab Altaic lus tsev neeg, Caucasian thiab Paleo-Asiatic lus pawg. Cov feem ntau lug hais lus yog distinguished Lavxias teb sab, Ukrainian, Belarusian, Armenian, Ossetian thiab German (Indo-European lus tsev neeg), Tatar, Bashkir thiab Chuvash (Altaic lus tsev neeg), Udmurt, Mari, thiab Erzya (Uralic lus tsev neeg), Chechen, Avar thiab Dargin (Northeast Caucasian lus), Kabardino-Cherkessia (Abkhaz-Adyghe lus tsev neeg). Lavxias teb sab yog leej niam tus nplaig rau ib co 130 lab cov pej xeem ntawm Guj kuj (92% ntawm cov pej xeem ntawm Guj kuj).",
        "Thaum cov Ethnologue distinguished tsuas chaw poob qab hom (Hmoob Daw, Mong ntsuab tsim), \"Miao\" Sinicized mas (Hmoob Shua) thiab nyab laj hom (Hmoob li, Hmoob tsis txhob). Nyab laj hom heev tsis paub tias; pejxeem kwv no tsis muaj nyob txawm. Hauv 2007, Horned cov \"Miao\" mas, \"Miao\" me Flowery mas, thiab pawg Chuanqiandian suav ntawd ncau Mong ntsuab tsim [blu]. Cov hom muaj raws li nram no, nrog rau ib co cov npe ua lwm ('Ch.' = Suav lub npe, 'auto.' = autonym Court npe):",
        "\"Miao\" horned mas (Ch. \"\"Miao Jiao mas , nws pib. Hmo los yog A-Hmo)",
        "Teb Hmoob (auto. txog sub-groups: Hmongb Shib, Hmongb Nzhuab, Hmongb Lens, Hmongb Dlex Nchab, Hmongb Sad; xws li ib co Mong ntsuab tsim saum toj no)",
        "Lub tshuab ua cov Hmoob Daw and Hmoob Njua yog li cov kab kos nram qab no. Xyov yuav muaj ib lub suab hais lus lub suab yog xim coded feem:",
        "Tus txheej txheem Danashan suav yog ua tau zoo. (Yog paub dhos suab sib txawv ntawm cov Hmoob Daw thiab Mong ntsuab tsim color-coded . Me txawv, xws li cov voicing uas nres prenasalized, los sis seb /c/ yog ib tug affricate los yog /h/, velar, tej zaum yuav muaj teeb meem ntawm cov transcription.) Aspirates, voiceless fricatives, voiceless nasals, thiab glottal tso nws tseg xwb kuj nrog yin tones (1, 3, 5, 7). Txheem orthography ntxiv nyob rau ⟨brackets⟩. Glottal nres yog tsis sau; yog tsis cov hauv pes tsawg ib thaum. Kuj muaj ib tug /w/, uas tshwm hauv lus xwb.",
        "Hmoob Dawb yog ib haiv neeg uas nyob rau Thaibteb, Lostsuas, Nyablaj thiab Suavteb. Lub npe Hmoob Dawb tej zaum yog hu raws li cov ntxhais hluasnkauj pheej hnav tiab dawb uas yog ua siv ntaub ntos.",
        "Nws yog feem ntau nyuaj rau hais tias qhov txawv ntawm kos duab thiab lwm yam tib neeg ua.",
        "Txawm hais tias tus neeg hu ua Cantonese hu ua dialect of Suav, Cantonese yog txawv ntawm Mandarin, feem ntau hais lus ntawm Suav, hais tias lawv yog cov tsis paub sib txawv, lub ntsiab lus uas hais lus ntawm ib hom lus tsis nkag siab lwm hom lus tsis tau kawm nws ua ntej. Nws hais tau tias Cantonese yog cov zoo dua qub txog rau Suav Classical tshaj Mandarin.",
        "Los Tshuas Teb yog teb chaws nyob Esxias. Lus Askiv hu Lao People's Democratic Republic.",
        "Lub raj mis yog ib lub taub ntim siv los nqa dej. Cov raj muaj peev xwm muaj ntau qhov sib txawv. Lub raj mis feem ntau yog los ntawm iav los yog yas. Feem ntau, Npias rau ntawm lub khob, thiab haus dej qab zib yog ua los ntawm cov yas.",
        "Tus Miv (Felis catus) yog ib tug me me, feem ntau tsiaj plaub ntxhov, thiab nqaij noj plaub. Lawv yog feem ntau hu ua ib lub tsev miv thaum khaws cia raws li ib tug sab hauv tsev tus tsiaj, los yog tsuas yog ib tug miv thaum tsis muaj yuav tsum tau paub qhov txawv lawv los ntawm lwm yam miv hom. Miv yog feem ntau muaj nuj nqis los ntawm tib neeg rau tus khub, thiab lawv muaj peev xwm mus plob hav zoov Kab Ntxaum thiab tsev neeg kab tsuag.",
        "Nees yog tsiaj ntawm lub hore tsev neeg. Nws tau nyeg los ntawm qus nees los ntawm cov tib neeg tsawg kawg yog tsib txhiab xyoo dhau los. Lawv Dhia paj paws mus txog peb caug mais ib teev. Nees yog zoo nyob dhia. Lawv tau raug siv los ntawm cov tib neeg nyob rau hauv ntau txoj kev sib txawv mus txawv tebchaws, ua hauj lwm, khoom noj khoom haus. Lawv kuj khaws cia raws li ib tug tsiaj rau cov tib neeg thiab.",
        "Cov Nqaij qaib (Gallus gallus domesticus) yog ib tug nyeg noog, ib tug sub tsiaj ntawm liab Zoov nuj txeeg noog. Raws li ib tug ntawm cov feem ntau ntau thiab ntau nyeg tsiaj, nrog ib tug pej xeem ntawm ntau tshaj nees nkaum plaub billion nyob rau hauv 2003, muaj ntau qaib nyob rau hauv lub ntiaj teb no tshaj lwm yam hom noog. Tib neeg kom qaib feem raws li ib qhov chaw ntawm cov zaub mov, siv ob lawv cov nqaij thiab lawv cov qe.",
        "Tag nrho cov ntxhw muaj ob peb txawv nta lub feem ntau tseem ceeb ntawm uas yog ib tug ntev lub cev, siv rau ntau lub hom phiaj, tshwj xeeb yog ua pa txhawb nqa, txhawb dej thiab ntug dej khoom. Lawv cov hniav loj hlob mus rau hauv kaus hniav, uas yuav ua riam phom thiab raws li cov cuab yeej rau tsiv khoom thiab kev khawb. Ntxhw 'loj pob ntseg pab kom tswj tau lawv lub cev kub.",
        "Lub plab yog lub cev J-puab uas zom zaub mov. Nws tsim cov enzymes (cov tshuaj uas tsim cov tshuaj tiv thaiv) thiab cov kua qaub (cov kua txiv hmab txiv ntoo). Qhov sib xyaw ntawm cov enzymes thiab cov kua txiv hmab txiv ntoo zom cov zaub mov kom nws tuaj yeem dhau mus rau koj cov hnyuv. Koj lub plab yog ib feem ntawm txoj hnyuv (GI). Lub plab yog lub cev nqaij daim tawv, hollow organ nyob rau hauv lub plab hnyuv ntawm tib neeg thiab ntau lwm yam tsiaj, nrog rau ob peb invertebrates. Lub plab muaj nyob ntawm ube-zoo li lub cev hauv plab uas tau txais ib feem ntawm cov zaub mov digested los ntawm lub plab, absorbs as-ham thiab kis tau cov zaub mov digested mus rau lub ntsiab tseem ceeb ntawm cov kab mob kis tau los ntawm peb txhais tes.",
        "Roob ris yog Crustacean thiab feem ntau muaj ib tug heev luv luv tus Tsov tus tw. Lawv nyob rau hauv tag nrho lub ntiaj teb dej hiav txwv, nyob rau hauv cov dej tshiab, thiab nyob rau thaj av, thiab muaj ib khub claw. Ntau roob ris nyob rau hauv cov dej tshiab thiab rau daim av, tshwj xeeb yog nyob rau hauv teb chaws cheeb tsam. Hais txog yim pua tsib caug hom roob ris yog dej tsis qab ntsev los yog av raws li.",
        "Soob yog ib qho siav, feem ntau liab txiv hmab txiv ntoo. Nws muaj ntau yam ntau ntau yam yog tam sim no dav zus, tej zaum nyob rau hauv lub tsev xog paj nyob rau hauv txias kev nyab xeeb. Txiv lws suav yog noj nyob rau hauv ntau haiv neeg txoj kev, xws li nyoos, raws li ib tug muaj nyob rau hauv ntau tais diav, kua ntsw, zaub nyoos, thiab dej qab zib. Tus nroj tsuag feem ntau loj hlob mus rau peb mus rau kaum ob txhais taw nyob rau hauv qhov siab thiab muaj ib tug tsis muaj zog kav uas feem ntau nce tshaj hauv av thiab tej hmab tshaj lwm yam nroj tsuag. Ib tug nruab nrab ntau soob nyhav kwv yees li ib puas gram.",
        "Kev nyab xeeb ntawm lub tebchaws As-Meb-Zis-Khas kuj tsis tshua muaj neeg, thiab lub teb chaws yog ib lub tsev mus rau ib tug ntau yam ntawm cov tsiaj qus. Hauv lub tebchaws As-Meb-Zis-Khas yog ib tug tsim lub teb chaws thiab muaj lub ntiaj teb no lub loj tshaj plaws kev khwv nyiaj txiag teb chaws, cov kev pab cuam los ntawm ib tug nplua mais ntawm cov khoom thiab cov neeg ua hauj lwm tsim. Thaum lub US kev khwv nyiaj txiag yog xam post muaj, lub teb chaws tseem yog ib tug ntawm lub ntiaj teb loj tshaj plaws Chaw tsim tshuaj paus. Ris peb caug xya feem pua ntawm cov ntiaj teb no cov tub rog kev siv nyiaj, nws yog ib lub ntiaj teb ua nyiaj txiag thiab cov tub rog lub hwj chim, ib tug mas nom tswv thiab kev cai quab yuam, thiab ib tug thawj coj nyob rau hauv kev tshawb fawb thiab kev nrhav.",
        "Tus Tsov Ntxhuav (Panthera leo) yog ib tug ntawm tsib miv loj nyob rau hauv lub tsov dub hom thiab ib tug tswv cuab ntawm lub miv tsev neeg. Nrog ib co caug tshaj ob puas thiab tsib caug kg nyob rau hauv hnyav, nws yog tus thib ob-loj tshaj plaws nyob miv tom qab tsov. Qus tom tsov ntxhuav tam sim no muaj nyob rau hauv teb chaws Africa thiab nyob rau hauv cov teb chaws Asia. Tom tsov ntxhuav nyob rau kaum rau kaum tsib xyoos nyob rau hauv cov qus, txawm hais tias thaum lawv ntes lawv yuav nyob ntau tshaj nees nkaum xyoo. Nyob rau hauv cov qus, caug tsuj tsawg nyob ntev tshaj li kaum xyoo, raws li kev raug mob pab los ntawm tas mus li sib ntaus sib tua nrog yeeb ncuab caug txo lawv thiav. Lawv feem ntau nyob nyom av, tab sis lawv yuav coj mus rau tsob ntoo thiab hav zoov. Thaum lub sij hawm tom tsov ntxhuav tsis feem ntau plob hav zoov tib neeg, ib txhia tau paub ua li ntawd. Pw tsaug zog mas thaum lub sij hawm hnub, tom tsov ntxhuav yog feem ntau active thaum lub sij hawm tsaus ntuj"
    ]
}
