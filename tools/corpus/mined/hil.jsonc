// MINED NORMALIZATION CORPUS — hil. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer. The cells
// are the empirical shape of the rules the treated languages actually needed, so coverage of them is the
// completeness criterion — not size.
//
// ⚠ THIS TIER IS NOT A FALLBACK FOR MISSING FLEURS, and this header used to say it was — unconditionally,
// in all 163 artifacts, of which 95 belong to languages that DO have a FLEURS transcript. The two sources
// are COMPLEMENTARY and neither subsumes the other: FLEURS is read-aloud running text, so it is
// frequency-shaped and mostly exercises nothing the normalizer does; this artifact is selected
// ADVERSARIALLY against the pattern cells, so it is far richer per line in exactly the shapes a
// normalization rule has to decide. A language with FLEURS is still worth mining, and most were.
//
// ⚠ SO DO NOT READ THIS FILE AS THE WHOLE HAYSTACK. Shona's layer did: it repeated the old claim and argued
// its refusals from a corpus that was missing 1,901 FLEURS transcripts, which left one count wrong by a
// factor of twenty (#1064). Count over both.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠⚠ AND WHETHER "sample" CAN CARRY THAT DEPENDS ON THE SOURCE, which this warning used to assert
// unconditionally. A uniform stride is only representative of what it strides OVER. Over a full dump it is
// the language's real distribution. Over an API fetch it is a stride across random ARTICLE INTROS plus
// articles chosen by a search ranked on the very patterns being measured — so a rate computed from it is a
// fact about the fetch, not about the language. The line below states which case this artifact is.
// ⚠ THIS artifact is API-sourced (random article intros + `insource:` fill), so `sample` is NOT
//   frequency-representative either — the fill's articles were chosen by a search ranked on the very
//   patterns being counted. Do not compute a rate from it; re-mine from a dump if a rate is needed.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: incubatorwiki dump Wp/hil (pages-articles, paragraphs), filter-by-language.py --lang hil
//
// ⚠ REGENERATE WITH THE COMMAND BELOW, NOT FROM MEMORY. This artifact's shape depends on flags that leave no
// trace in the data — omit --sample and the whole sample tier silently disappears; omit --terms and the lexical
// cells report EMPTY. Both happened while re-mining this fleet: km lost its 200-entry sample tier to a
// reconstructed invocation, and my dropped from 35/35 cells to 33/35 because it is the one language with a terms
// list and the sweep did not pass it. Neither failure is visible in the output — the run reports success.
//
// command: npx tsx tools/normalization/mine.ts mine --in hil_paras.hil.txt --out hil.jsonc --lang hil --segment paragraph --per-cell 6 --sample 40 --source "hil (pages-articles, paragraphs), filter-by-language.py --lang hil"
// segmentation: paragraph (no dot is ever interpreted — correct when the target IS the period)
{
    "language": "hil",
    "source": "incubatorwiki dump Wp/hil (pages-articles, paragraphs), filter-by-language.py --lang hil",
    "command": "npx tsx tools/normalization/mine.ts mine --in hil_paras.hil.txt --out hil.jsonc --lang hil --segment paragraph --per-cell 6 --sample 40 --source \"hil (pages-articles, paragraphs), filter-by-language.py --lang hil\"",
    "segmentMode": "paragraph",
    "totalSegments": 3799,
    "cellsCovered": 20,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 1,          // in 22 treated languages
        "digit-run": 1867,     // in 19 treated languages
        "fractions": 0,        // in 18 treated languages
        "clock": 1244,         // in 18 treated languages
        "signs": 4,            // in 17 treated languages
        "dotted": 9,           // in 16 treated languages
        "era-marker": 0,       // in 14 treated languages
        "year": 1867,          // in 14 treated languages
        "decimals": 3351,      // in 12 treated languages
        "ordinal-latin": 1723, // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 3,            // in 9 treated languages
        "ranges": 10,          // in 7 treated languages
        "currency": 0,         // in 6 treated languages
        "abbrev": 110,         // in 6 treated languages
        "latin-in-native": 3799, // in 6 treated languages
        "percent": 1,          // in 5 treated languages
        "rate": 0,             // in 4 treated languages
        "zero-width": 0,       // in 4 treated languages
        "roman": 15,           // in 3 treated languages
        "initialism": 87,      // in 3 treated languages
        "grouped": 1841,       // in 3 treated languages
        "signed-number": 0,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 35,     // in 3 treated languages
        "exponent": 1,         // in 24 treated languages
        "arithmetic": 0,       // in 2 treated languages
        "ampersand": 2,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 0,      // in 3 treated languages
        "version-dot": 0,      // in 3 treated languages
        "quote-letter": 24,    // in 4 treated languages
        "scaled-currency": 0,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 133 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 0
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Ang banwa sang Tapaz yara sa latitudo nga 11° 09’ hasta 11° 09’ 42\" kag sa longitudo nga 121° 11’ hasta 122° 34’ 45\". Ini 55 kilometro (34 mi) halin sa banwa sang Roxas." },
        { "cell": "digit-run", "text": "May 1,821.42 kilometro kwadrado ang kalaparon sini. Makita ini sa pinakaaminhan nga bahin sang Panay. Tupad sini ang mga probinsya sang Antique kag Capiz. Sa atubang sini ang Dagat sang Sibulan kag probinsya sang Romblon sa aminhan. Base sa 2024 census, ini may populasyon nga 634,422. Ang dialing code sini 36." },
        { "cell": "digit-run", "text": "Dako nga impluwensiya ang pagsakop sa pungsod sang Espanya (halin 1565 tubtub 1898) kag Estados Unidos (halin 1898 hasta 1946). Ang pag-abut ni Ferdinand Magellan sang 1521 ang nag-umpisa sa interes kag kolonisasyon sang Espanya sa Pilipinas. Sang 1543, ginhingalanan ni Ruy Lopez de Villalobos ang kapoloan nga Las Islas Filipinas bilang pagtahod kay Philip II sang Espanya. Nalab-ot ni Miguel Lopez de Legazpi ang Pilipinas sang 1565 kag iya ginpalagnag ang gahum sang Espanya sa kapoloan nga nabilin nga kolonya sang Espanya sa sobra 300 ka tuig." },
        { "cell": "digit-run", "text": "Ang Pilipinas may 18 ka mga rehiyon kag 81 ka mga probinsya sang 30 Hunyo 2024. Ang mga rehiyon amo ang National Capital Region, Cordillera Administrative Region, Rehiyon I (Ilocos Region), Rehiyon II (Cagayan Valley), Rehiyon III (Central Luzon), Rehiyon IV-A (CALABARZON), Rehiyon sang MIMAROPA, Rehiyon V (Region sang Bicol), Rehiyon VI (Western Visayas), Negros Island Region (NIR), Rehiyon VII (Central Visayas), Rehiyon VIII (Eastern Visayas), Rehiyon IX (Zamboanga Peninsula), Rehiyon X (Northern Mindanao), Rehiyon XI (Rehiyon sang Davao), Rehiyon XII (SOCCSKSARGEN), Rehiyon XIII (Caraga), kag Bangsamoro Autonomous Region In Muslim Mindanao (BARMM)." },
        { "cell": "digit-run", "text": "Base sa 2010 census, ini may populasyon nga 428,877. Ang dialing code sini amo ang 55." },
        { "cell": "digit-run", "text": "Ang Nabagatnang Leyte (Ingles:Southern Leyte) ang ikatlo nga klase sang probinsya sa Sidlangan nga Visayas, Pilipinas. 1,798.61 kilometro kwadrado ang kalaparon sini. Base sa 2024 census, ini may populasyon nga 434,372. Ang dialing code sini amo ang 53." },
        { "cell": "digit-run", "text": "Ang Kurów isa ka barrio sa sur nga parte sang Poland, sa tunga sang Puławy kag Lublin, malapit sa suba sang Kurówka. Ini kapital sang separado nga gmina, isa ka municipalidad, nga nasakop sang Lublin Voivodeship kag may populasyon nga 2811 ka pumuluyo (sang tuig 2005)." },
        { "cell": "clock", "text": "Eastern Samar ang ika-duha nga klase sang probinsya sa Eastern Visayas, Pilipinas. 4,660.47 kilometro kwadrado ang kalaparon sini." },
        { "cell": "clock", "text": "Ang Guimaras isa ka ika-apat nga klase nga probinsya sa Nakatundang Kabisayaan, Pilipinas. May 604.57 kilometro kuadrado ini nga kalaparon. Base sa 2010 census, ini may populasyon nga 162,943. Ang dialing code sini 33." },
        { "cell": "clock", "text": "Ang Negros Occidental isa ka una nga klase nga probinsya sang Nakatundang Kabisayaan, Pilipinas. 7,965.21 kilometro kwadrado ang kalaparon sang iya duta. Base sa 2010 census, ini may populasyon nga 2,396,039. Ang dialing code sini amo ang 34." },
        { "cell": "clock", "text": "Ang Anahawan ika-lima nga klase sang munisipalidad nga makita sa probinsya sang Southern Leyte, Pilipinas. 58.09 kilometro kwadrado ang iya kalaparon kag makita ini sa bugtong nga distrito kongresyonal." },
        { "cell": "clock", "text": "Ang Hinunangan ika-tatlo nga klase sang munisipalidad nga makita sa probinsya sang Southern Leyte, Pilipinas. May 170.58 kwadrado ini nga kalaparon kag ini kabahin sang bugtong nga distrito kongresyonal." },
        { "cell": "clock", "text": "Ang Libagon ika-lima nga klase sang munisipalidad nga makita sa probinsya sang Southern Leyte, Pilipinas. May 98.62 kwadrado ini nga kalaparon kag ini kabahin sang bugtong nga distrito kongresyonal." },
        { "cell": "signs", "text": "buttonlabel=Maghimo sang bag-o nga artikulo" },
        { "cell": "signs", "text": "Ang arkitekto ay may kaalam kag lisensya sa pagplano kag pagdesayn sang mga bilding, kag ga-intra sila pagbantay sang pag obra sang mga bilding. Kun intindihon gid naton kun ano gid ang kahulugan sang gina siling nga arkitekto ini sa naghalin sa Latin architectus, mismo naghalin ni siya sa Griyego arkhitekton (arkhi-, lider + tekton, ga obra bilding), i.e. lider sa ga obra bilding." },
        { "cell": "signs", "text": "Si Marcos nagdalagan para Presidente sang Pilipinas sa eleksyon sang 2022 sa idalom sang Partido Federal ng Pilipinas, kun diin nagdaog siya nin kadako 59% sang boto. An sa iyang pagdaog amo ang pinakadako sugod 1981, kun diin ang sa iyang amay nagdaog sang 88% sang boto tungod sa isa ka boycott sang oposisyon nga nagprotesta bag-o pa ang eleksyon." },
        { "cell": "signs", "text": "Ang Piso sang Pilipinas ( Ingles nga Pilipinong paghambal: , ; Filipino: o ; simbolo sang kurensiya: ₱; kodigo: PHP), amo ang opisyal nga kurensiya sang Pilipinas. Gikan sa lenggwaheng Kastila nga ang piso may yara depinisyon nga \"bug-at\"." },
        { "cell": "dotted", "text": "Ang katapu kang Kinaray-a Writers Guild sa Antique nagahimurat nga mapatin-ad ang aton hambal. Ang makabag-o nga pagsulat kang literatura sa Kinaray-a naumpisahan ron, kag si Ma. Milagros C. Geremia nga taga Sibalom kag isara sa mga katapu kang U.P. Visayan Center for West Visayan Studies, ang una sa mga manunulat sa kinaray-a nga natugru-an kang nasyonal nga dungog sa Sentro kang Kultura sa Pilipinas. Darwa man ka mga bataon nga manunulat ang dapat naton taw-an kang atensyon: Si Alex Delos Santos nga taga San Jose kag nagtuon sa U.P.; si Gerry Antoy nga taga Bugasong kag sangka brodkaster sa radyo. Gintukod man ni Alex ang Tabig, grupo ka mga manunulat sa Kinaray-a." },
        { "cell": "dotted", "text": "Kag kun lantawon ta sa iban nga pag intindi, ang ngalan nga arkitekto kag arliteltura ay ginagamit sa disipplina sa enhinyero, e.g. kompyuter supwer arkitekt;" },
        { "cell": "dotted", "text": "Ang Estados Unidos sang Amerika (Ingles: United States of America, United States, U.S., US, USA), kilala man sa lip-ot nga katawagang Estados Unidos, isa ka nasyun nga primera makita sa kontinente sang Norteng Amerika. May yara ini nga 50 ka estado, isa kan pederal nga distrito, lima ka mayor nga nagagobernar saiyang kaugalion nga mga teritoryo, 326 nga Indyanong reserbasyon, kag pila ka mga menor nga posesyon." },
        { "cell": "dotted", "text": "Ang nasyunal nga kabisera amo ang Washington, D.C., kag ang may yara pinakadako nga populasyon amo ang dakbanwa sang New York." },
        { "cell": "dotted", "text": "Ang Washington, D.C., pormal nga District of Columbia kag kilala man nga D.C. o Washington lang, amo an kabiserang dakbanwa sang Estados Unidos." },
        { "cell": "dotted", "text": "Si Mariano Perfecto (1853 - 3 Nobyembre 1913) amo ang ika-5ng Gobernador (1910-1912) sang Camarines Sur, pero ang siling nga probinsya upod pa sa Camarines Norte kag ginatawag nga Ambos Camarines. Si Perfecto ginakilala man nga \"Amay sang Literaturang Bikol\" kag \"Amay sang Literaturang Hiligaynon.\" Tumulukud siya sang peryodikong An Parabareta (1899-1900), ang pinakauna nga peryodikong Bikolnon. Sa mga ginsulat niya may beses ang ginabutang niya lang bilang nagsulat, amo ang M.P.." },
        { "cell": "year", "text": "Ginabinagbinag nga sa tunga sg tuig 1431 kag 1442 ang ini nga barrio guin tagaan sg diretso nga mangin siyudad suno sa Magdeburg Law. Bilang isa ka pribado nga municipalidad, ini naging sentro sang negosyo sa pagkaon para sa gapalibot nga lugar. Pila ka mga paktorya sg panit dire man nahamtang." },
        { "cell": "year", "text": "Ang \"True Jesus Church\" isa ka indepindiente nga simbahan nga guin tukod sa Beijing, China sang tuig 1917. Subong, ini may ginabinagbinag nga mga 2.5 ka milyon nga miyembro sa kwarenta'y singko ka pungsod sa anum ka kontinente. Ang ining simbahan kabilang sang Pentecostal nga sanga sang Kristiyanismo nga nag tuhaw sang una nga bahin sang ika biente nga siglo. Ang ining simbahan naga pati man sa \"Oneness Pentecostal\" nga pagtulu-uhan (doctrina sang Jesus-Name). Ang ining simbahan guin tukod sa Pilipinas sang tuig 1983. Sila naga la-um nga mag wali sang ebanghelyo sa tanan nga mga pungsod antes sa Ika-duhang Pagbalik ni Hesus. Ang napulo ka doktrina kag pagtulu-ohan sg sining simbahan nagalakip sang:" },
        { "cell": "year", "text": "Si Magdalena Jalandoni (Natawo: 1891 sa Jaro, Iloilo - Napatay: 1978 sa Jaro) ang una nga Filipina nga manogsulat. Sa kadam-an sang iya nga ginsulat (labi pa sa 60 ka nobela, binalaybay, drama, korido kag hinugpong nga sugilanon) sa pulong sang Hiligaynon/Ilonggo nangin permanente ang iya marka sa panitikan ukon literatura sang Filipinas." },
        { "cell": "year", "text": "Natawo si Magdalena Jalandoni sa Mayo 27, 1891 sa balay sang iya mga ginikanan, didto sa kalye Alvarez (subong Kalye Benedicto) Jaro, sa Cuidad sang Iloilo. Ang iya ginikanan si Gregorio Jalandoni kag si Francisca Gonzaga. Ang iya amay nga si Gregorio ang directorcillo sang Jaro sang namatay sia sa edad sg 25 años." },
        { "cell": "year", "text": "Si Ernesto Guevara de la Serna (Hunyo 14, 1928 – Oktubre 9, 1967), mas kilala sa ngalan nga Che Guevara ukon el Che, isa ka manogbulong nga natawo sa Argentina, rebolusyonaryo nga Marxista, pulitiko, kag pinuno sang hulag gerilya sa Cuba." },
        { "cell": "year", "text": "Base sa 2010 census, ini may populasyon nga 7,942. Ang zip code sini 6610." },
        { "cell": "decimals", "text": "May 11,000,000 ka tawo ang nakahibalo maghambal sini nga pulong. Dala ang ining pulong sa \"10 ka pulong nga austranesian nga may pinakamadamo nga humalambal\"." },
        { "cell": "decimals", "text": "Ang Pilipinas (Ingles: Philippines), opisyal nga kilala nga Republika sg Pilipinas, isa ka pungsod sa Nabagatnan-Sidlangang Asya kag sa Nakatundang Kadagatang Pasipiko. Yara sa aminhan sini ang Taiwan. Katundan sa Katundang Dagat Pilipinas ang Vietnam. Sa bagatnan-katundan ang Dagat Sulu nga gintunpatung-an sang pungsod kag isla sang Borneo. Ang Dagat Celebes ang gasipak sa pungsod sa mga isla sang Indonesia. Galibutan ini sang Dagat Pilipinas sa sidlangan. May 7,641 ka isla ini nga natunga sa tatlo ka bahin: Luzon, Visayas, kag Mindanao. Ang dakbanwa sang Manila ang kabisera sini." },
        { "cell": "decimals", "text": "Ang lenguahe Aklanon (Akeanon) isa sa mga lenguahe nga bisaya nga ginahambal sa probinsya sang Aklan. May 500,000 nga tawo nga kabalo maghambal sang languahe nga ini." },
        { "cell": "decimals", "text": "Ang Bontoc ika-anum nga klase sang munisipalidad nga makita sa probinsya sang Southern Leyte, Pilipinas. May 102.1 kwadrado ini nga kalaparon kag ini kabahin sang bugtong nga distrito kongresyonal." },
        { "cell": "decimals", "text": "Base sa 2010 census, ini may populasyon nga 28,079. Ang zip code sini 6604." },
        { "cell": "decimals", "text": "Base sa 2010 census, ini may populasyon nga 28,415. Ang zip code sini 6608." },
        { "cell": "ordinal-latin", "text": "Base sa 2010 census, ini may populasyon nga 11,890. Ang zip code sini 6609." },
        { "cell": "ordinal-latin", "text": "Base sa 2010 census, ini may populasyon nga 14,352. Ang zip code sini 6615." },
        { "cell": "ordinal-latin", "text": "Base sa 2010 census, ini may populasyon nga 22,817. Ang zip code sini 6612." },
        { "cell": "ordinal-latin", "text": "Base sa 2010 census, ini may populasyon nga 5,835. Ang zip code sini 6605." },
        { "cell": "ordinal-latin", "text": "Base sa 2010 census, ini may populasyon nga 25,386. Ang zip code sini 6601." },
        { "cell": "ordinal-latin", "text": "Base sa 2024 census, ini may populasyon nga 21,691. Ang zip code sini 6603." },
        { "cell": "units", "text": "Negros ang ikaapat nga pinakadako nga isla sa Pilipinas. May yara pagkadako nga 12,706 km² (4,905 m²) an iyang duta. Ang mga tao sa isla ginatawag nga Negrense." },
        { "cell": "units", "text": "Ang Espanya (Ingles: Spain, Espanyol: España) o ang Kaharian sang Espanya (Ingles: Kaharian sang Espanya, Espanyol: Reino de España), isa ka nasyun nga nagasakop sa sur-sidlangan sang Europa sa tangway sang Iberya. Nakapalibot saiya ang Pransya, Andorra hasta sa baybayon sang Biscay sa norte; ang Dagat Mediteraneo sa sur hasta sa sur nga parte sang Gibraltar; kag ang Dagat Atlantiko hasta sa Portugal sa sidlangan. Kaupod man sa nasyun ang Isla sang Baleariko sa Mediterraneano, ang mga Isla sang Canary sa Atlantiko nga lapit sa baybayon sang Aprika, kag ang duha ka awtonomikong dakbanwa sa Norteng Aprika, Ceuta kag Melilla, nga punta sang Morocco. Sa 504,030 km, ang Espanya ang ikaduha nga pinakamauswag nga nasyun sa Katundang Europa pagkasugod sang Pransya." },
        { "cell": "units", "text": "Ang linaw nahamtang sa bagatnan-sidlangan sang Metro Manila, sa tunga sang mga probinsya sang Laguna sa bagatnan kag probinsya sang Rizal sa aminhan. Isa ka linaw nga may tab-ang nga tubig, may ara ini sang nawong nga 911–949 km2 (352–366 sq mi), nga may average nga kadalumon nga mga 2.8 meters (9 ft 2 in) kag ang kataason nga mga isa ka metro sa ibabaw sang nibel sang dagat. Ang linaw daw tiil sang uwak ang korte, nga may duha ka peninsula nga nagaguwa sa naaminhan nga baybayon kag nagapuno sang daku nga bulkan nga Laguna Caldera. Ang Laguna Caldera isa ka posible nga aktibo nga bulkan nga caldera kag isa ka geograpiko nga depresyon nga nagaporma sang tungatunga nga lobe sang Laguna de Bay. Sa tunga sang linaw amo ang daku nga isla sang Talim. Ang tubig sini nagailig pakadto sa Manila Bay agi sa Pasig River." },
        { "cell": "ranges", "text": "Si Josemaría Escrivá de Balaguer (9 Enero 1902–26 Hunyo 1975; Kinatalan: Josepmaria Escrivà de Balaguer) ukon San Josemaría (Kinatalan: Sant Josepmaria) Katsilang paring Katoliko kag ang pundador sang Opus Dei." },
        { "cell": "ranges", "text": "Si Miriam Palma Defensor-Santiago (15 Hunyo 1945 – 29 Septembre 2016) isa ka Pilipinang akademiko, abogado, huwes, awtor, kag politiko nga nagsilbi sa tatlo ka sangay sang gobyernong Pilipinas– sa hudikatura, lehislatura kag ehekutiba. Si Santiago ginpangalanan bilang isa sa 100 nga Poderosong Babae sa Kalibutan sang taon 1997 sang magasin nga The Australian. Nakilala siya sa dugay niyang pagsilbi bilang Senador sang Republika sang Pilipinas, isa ka na-elihir nga huwes sa International Criminal Court, kag ang solamenteng babae nga resipiyente sang pinakataas nga nasyunal na onra sang Pilipinas, ang Quezon Service Cross." },
        { "cell": "ranges", "text": "Si Hatshepsut (/hætˈʃɛpsʊt/; ukon Hatchepsut; Ehiptohanon: ḥꜣt-špswt \"Pinakauna sa mga Talahuron nga Ginang\"; c. 1507–1458 BC) ang ikalima nga faraon sang ika-Dise-otso nga Dinastiya sa Ehipto. Siya ang ikaduha nga napamatud-an nga babaye nga faraon, pagkatapos kay Sobekneferu. Posible nga may iban pa nga babayi nga nagmando bilang faraon ukon maskin ila kaabay bag-o ni Hatshepsut, parehos kay Neithhotep nga1,600 ka tuig nauna sa iya." },
        { "cell": "ranges", "text": "Si Ramsés II (Kinaraang Ehiptohanon: rꜥ-ms-sw Rīʿa-məsī-sū, ginamitlang [ˈɾiːʕaʔ məˈsiːˌsuw], nagakahulogan \"Si Ra ang nagbun-ag sa iya\";[6] c. 1303–1213 BC), mas bantug sa ngalan nga as Ramsés nga Balansagon, ang ika-tato nga faraon sa ika-Disenoybe nga Dinastiya sang Ehipto. Kaupod si Thutmosis III kasagaran siya nga ginatan-aw nga pinakabuggaitan, pinakabalantugon, kag pinakagamhanan nga faraon sang Kahariang Bag-o, nga amo mismo ang pinakagamhanan nga kapanahonan sadto sang Kinaraang Ehipto." },
        { "cell": "ranges", "text": "Si Ciro II sang Persya (c. 600–530 BC; Kinaraang Persyano: 𐎤𐎢𐎽𐎢𐏁 Kūruš), mas kilala sa nagkalainlain nga mga pinulongan nga Dunnganang Ciro kag ginatawag man nga Maguláng nga Ciro sang mga Griyego, ang pumalátok sang Imperyong Achaemenida, ang una nga Persianong Imperyo. Sa idalom sang iya mando, ginhakos sang imperyo ang tanan nga sanguna nga sibilisado nga mga estado sa Kinaraang Lapit-Sidlakan, sa naglapad sang mahanggud hasta sa nasakop ang kalabanan sang Katundang Asya kag laban nga parte sang Katungaang Asya. Gikan sa the Dagat Mediteraneo kag Dardanelos sa katungdan lab-ot sa Subâ Indus sa sidlakan, ang imperyo nga ginbohat ni Ciro sang-una amo ang pinakadako nga imperyo nga nakita sang bilog kalibotan. Sa pinakadako ini nga dagway sa idalom sang iya nga nga nanubli, ang Imperyong Achaemenida nagbuklad halin sa mga parte ka Balkanika (Sidlakang Bulgaria–Paeonia kag Thrace–Macedonia) kag Lasagasang Europa tadlong sa katungdan pakadto sa Walog Indus sa sidlakan." },
        { "cell": "ranges", "text": "Nagaumalámbit ang tanan nga gakabuhi sa Kalibotan sang isa naulíhi nga guráptang kapapóan, nga nabuhi magakapín sa yádto nga 3.5–3.8 bilyon ka tinúig nagligad. Ang marágtasan sang haytó nagapakita sang pagíswag halin sa mga tempráno nga haynayanong grafito, pakádto mga haytó sa mikháy-banig, kag pakádto sa mga nahaytó nga mga dagáyang-sihay nga tátagháy. Ang mga gakadúngan nga dágway sang laksambuhay ginpúrma sang magkaliwan kag magkaliwat-liwat nga pormasyon sang mga bag-o nga ispesye." },
        { "cell": "abbrev", "text": "Kilala man si Hesus sa iya isa pa gid nga ngalan nga si Dios nga Anak. Isa sia sa mga tatlo ka persona sang Santisima Trinidad." },
        { "cell": "abbrev", "text": "Ang Aklan isa sa mga probinsya sang Pilipinas sa Nakatundang Kabisay-ang. Kalibo ang kapitolyo sini. Ika-duha ini nga klase sang probinsya." },
        { "cell": "abbrev", "text": "Karot- Ang gamot sang ini nga tanum dalagkuon kag takus kan-on. Kinahanglan ang isa ka tuig agud nga magdaku ang iya gamot para kan-on. Isa pa gid ka tuig ang kinahanglan agud nga makabunga ang karot sang binhi. Ang tawag sa Ingles sa ini nga klase sang tanum amo ang bienial." },
        { "cell": "abbrev", "text": "Ang politika isa ka pamaagi sa pagdesisyon nga nagaapekto sang kinabuhi sang mga tawo. Ang konteksto sang politika ara halos sa gobyerno kon diin nahanugod kon tawagon ang konsepto sang 'awtoridad' kag 'gahum' sa pag-kontrol sang mga aktibidades sang mga tawo. Naluwas sa ining derpinisyon ang pag-usar sang 'economic power' ukon kontrol sang mga dunang manggad kag ang pag-kontrol sang makagalahum mga ideyolohiya." },
        { "cell": "abbrev", "text": "Ang salakyan sa dalan ukon 'awto' isa ka klase sang transportasyon diri sa duta. Isa isi sa mga pinaka komun nga paagi sang pagbiyahe." },
        { "cell": "abbrev", "text": "Ang kinaray-a karagto pa nga hambal pero wara gid matugru-i kang husto nga pag-italupangod okon respeto. Tulad kang Latin kag Sankrit, ang Kinaray-a indi pwede madura. Suno kay Dr. Leoncio Deriada nga kinaray-a editor kang ANI kag katapu kang Unibersidad kang Pilipinas, ang Kinaray-a, nanay kang lingua franca, Hiligaynon, kag bata kang Aklanon. Suno pa kana, duro pa kuno ang nagagamit kang amo nga hambal kaysa Hiligaynon - bilog nga Antique, halos bilog nga Capiz, mga banwa sa sentro kang Iloilo kag sur kang siudad kang Iloilo nga marapit sa baybay." },
        { "cell": "latin-in-native", "text": "Ang Nasyonal nga Kabeserang Rehiyon (Ininggles: National Capital Region) sa Pilipinas ang pinakaimportanteng sentrong urbano sa Luzón." },
        { "cell": "latin-in-native", "text": "Hiligaynon ang lenguwahe nga ginagamit sang mga pumuluyo sa habagat kag sang mga lapit sa dagat. Samtang Kinaray-a naman ang ginagamit sang mga tumandok sang mga parte-interyor nga mga banwa." },
        { "cell": "latin-in-native", "text": "Tubo kag kalamay ang pinakaimportante na produkto sang Iloilo. Nagapangibabaw man ang pagpangisda sang bangros, tilapia kag pantat." },
        { "cell": "latin-in-native", "text": "Kilala man ang Iloilo sa iya nga mga simbahan nga gintukod pa sa tiempo sang mga Katsila." },
        { "cell": "latin-in-native", "text": "Ang pulong Hiligaynon (ukon Ilonggo; Kinatsila: hiligueino ukon ilongo) isa sa mga Binisaya nga pulong. Ini ginahambal sa madamo nga parte sang Panay, Guimaras, Negros Occidental, Cotabato, South Cotabato kag Sultan Kudarat. Isa sa mga pinadaku nga linggwaheng Binisaya ang Hiligaynon, sunud sa Sugbuhanon." },
        { "cell": "latin-in-native", "text": "Kabahin ini sa pamilya sang mga \"pulong Austronesian\" (Austronesian languages) kaupud sang iban man nga mga pulong sa Pilipinas kaangay sang Sinugbuhanon, Winaray, Tinagalog, Iniluko kag madamo pa." },
        { "cell": "roman", "text": "Ang Rehiyon sang Dabaw ukon Rehiyion XI isa ka rehiyon sa habagatang Pilipinas. Ang Dabaw ang pinakadakong dakbanwa sini." },
        { "cell": "roman", "text": "Ang Tagoloan II ika-apat nga klase sang munisipalidad nga makita sa probinsya sang Lanao del Sur, Pilipinas. May 362.35 kilometro kwadrado ini nga kalaparon kag ini kabahin sang una nga distrito kongresyonal." },
        { "cell": "roman", "text": "Ang politikal career ni Pangilinan nagsugod sang sya isa pa ka estudyante-aktibista sadtong 1985, sa tunga sang People Power Revolution. Sa Senado, nangin siya Lider sang Mayorya sa Senado sugod 2004 hasta 2008. Sadtong Mayo 2014, si Pangilinan napili bilang Kabulig sang Presidente para sa Seguridad sa Pagkaon kag Agrikultural nga Modernisasyon ni Presidente Benigno Aquino III. Si Pangilinan nagdalagan liwat para senador sadtong 2016 sa idalom sang Partido Liberal, kag nag-ikasiyam sa 12 mga nagdaog nga kandidato. Siya karon ang presidente sang partido." },
        { "cell": "roman", "text": "Si Manuel \"Mar\" Araneta Roxas II (Paghambal sa Tagalog: [ˈɾohas]; nabata Mayo 13, 1957) isa ka Pilipinong politiko nga nangin isa ka Senador sang Pilipinas. Siya ang apo kag kapangalan sang daan nga Presidente sang Pilipinas nga si Manuel Roxas." },
        { "cell": "roman", "text": "Si Benigno Simeon Cojuangco Aquino III KGCR (sa lokal bilang [bɛˈniɡnɔʔ aˈkino]; Pebrero 8, 1960 – Hunyo 24, 2021), kilala man bilang Noynoy Aquino kag kolokyal bilang PNoy, isa ka Pilipino nga politiko nga nangin ika-15 presidente sang Pilipinas sugod 2010 hasta 2016." },
        { "cell": "roman", "text": "Si Juan Bautista H. Alegre III (nabata Hunyo 4, 1955), propesyunal nga kilala na Johnny Alegre, isa ka gitarista sang jazz kag kompositor halin sa Manila, Pilipinas. Ginpangunahan niya ang grupo nga Johnny Alegre Affinity kag ang grupo nga musikang duta o world music nga Humanfolk." },
        { "cell": "initialism", "text": "Ang Fabrica natagaan sang pagtamod sa guwa sang pungsod sumugod pa sadtong 1900s asta sa tuig 1976, subong nga lugar sang pinakadaku nga kumpanya pang kahoy kag lagari-an sa kalibutan, ang Insular Lumber Company (ILCO), nga ginapanag-iyahan sang mga Amerikano. Ang ILCO naga ubra sang mga hardwood lumber nga kilala sa bilog nga kalibutan kag gina export sa Estados Unidos." },
        { "cell": "initialism", "text": "Ang Fabrica lng sa Pilipinas ang may kaugalingon nga zip code kasubong sang mga banwa kag siyudad. Ang Fabrica, gina-angot sang duha ka kumpanya pang telegrama nga gina padalagan sang Radio Communications of the Philippines, Inc. (RCPI) kag sang Philippine Telephone and Telegraph Company (PT & T)." },
        { "cell": "initialism", "text": "Sa tiempo sang 1950s asta 1970s, ang Fabrica amo ang sentro sang negosyo sa komersiyo kag industriyal sa bilog nga probinsiya sang Negros Occidental kag Visayas. Madamo nga mga intsik nga negosyante ang nag negosyo sa Fabrica, ilabi na gid sa bario sang Paraiso, nga gin bulag sang madaku kag madalum nga suba, ang suba sang Himoga-an. Ang salsalon nga taytay amo ang naga-angot sining duha ka bario asta subong. Mga enhinyero nga nga Amerikano ang nagpatindug sang sining taytay, nga nangin palatandaan na sang lugar, sa panahon sang mga Amerikano. Madamo ang sini nga mga Amerikano ang may kaugalingon nga balay kag kaugalingon nga kumunidad subong nga may mataas nga pwesto sa ILCO." },
        { "cell": "initialism", "text": "Apang sadtong 1976, nagsarado ang operasyon sang ILCO sa Fabrica tungod sa kakulang na sang mga kahoy, kag ang baryo nangin isa na lamang kabahin sang nagligad." },
        { "cell": "initialism", "text": "Base sa 2024 sensus, ini may populasyon nga 1,902,590. Ang zip code sini 1000 (CPO)." },
        { "cell": "initialism", "text": "Ang Pulilan amo una nga klase nga banwa nga makita sa probinsya sang Bulacan, Pilipinas. 39.89 kilometrong kuwadrado ang kalaparon sang iya duta kag makita sya sa una nga distrito. Base senso sang 2024, may populasyon ini nga 111,384. Ang kodigong ZIP sini amo ang 3005." },
        { "cell": "grouped", "text": "Tungód nga may 511,820 ka pumuluyò sang túig 2010; iní ang may pinakamadamù nga ginapuy-an nga dakbanwa sa Nakatungdan nga Kabisay-an, kag ika-17 sa Pilipínas. Kabahin iní sang Kinalapdan nga Bacolod, upód ang kadakbanwahan sang Silay kag Talisay." },
        { "cell": "grouped", "text": "Ang Uetersen [] isa ka barrio sa sur nga parte sang Alemanya, sa tunga sang Pinneberg kag Schleswig-Holstein, malapit sa suba sang Pinnau. Uetersen kag may populasyon nga 17.865 ka pumuluyo (sang tuig 2007)." },
        { "cell": "grouped", "text": "Base sa 2010 census, ini may populasyon nga 10,525. Ang zip code sini 6602." },
        { "cell": "grouped", "text": "Base sa 2010 census, ini may populasyon nga 9,261. Ang zip code sini 6614." },
        { "cell": "grouped", "text": "Base sa 2010 census, ini may populasyon nga 25,169. Ang zip code sini 6613." },
        { "cell": "grouped", "text": "Base sa 2010 census, ini may populasyon nga 12,528. Ang zip code sini 6611." },
        { "cell": "letter-name", "text": "Remedios T. Romualdez an ika-lima nga klase sang munisipalidad nga makita sa probinsya sang Agusan del Norte, Pilipinas. May 79.15 kilometro kwadrado ini nga kalaparon kag ini kabahin sang ika-duha nga distrito kongresyonal." },
        { "cell": "letter-name", "text": "President Carlos P. Garcia an ika-apat nga klase sang munisipalidad nga makita sa probinsya sang Bohol, Pilipinas. May 54.82 kilometro kwadrado ini nga kalaparon kag ini kabahin sang ika-duha nga distrito kongresyonal." },
        { "cell": "letter-name", "text": "Ang M'lang una nga klase sang munisipalidad nga makita sa probinsya sang Cotabato, Pilipinas. May 312.13 kwadrado ini nga kalaparon kag ini kabahin sang ika-tatlo nga distrito kongresyonal." },
        { "cell": "letter-name", "text": "Ang Braulio E. Dujali ika-apat nga klase sang munisipalidad nga makita sa probinsya sang Davao del Norte, Pilipinas. May 91 kwadrado ini nga kalaparon kag ini kabahin sang ika-duha nga distrito kongresyonal." },
        { "cell": "letter-name", "text": "Ang Datu Blah T. Sinsuat una nga klase sang munisipalidad nga makita sa probinsya sang Maguindanao del Norte, Pilipinas. May 147.21 kwadrado ini nga kalaparon kag ini kabahin sang una nga distrito kongresyonal." },
        { "cell": "letter-name", "text": "Ang General Salipada K. Pendatun n/a nga klase sang munisipalidad nga makita sa probinsya sang Maguindanao del Sur, Pilipinas. May 189.37 kwadrado ini nga kalaparon kag ini kabahin sang ika-duha nga distrito kongresyonal." },
        { "cell": "ampersand", "text": "An unibersidad amo miyembro sang De La Salle Philippines, isa ka network nga gintindog sadtong 2006 nga ginabilog sang 16 ka Lasalyanong edukasyonal nga institusyon sa isla sang Pilipinas. Nagahatag sang preschool, elementarya, sekundarya (junior & senior high), undergraduate, kag graduate programs. Yara ini pito ka kolehiyo: ang Business and Accountancy, Engineering and Technology, Arts and Sciences, Education, Nursing, Law, kag Medicine." },
        { "cell": "quote-letter", "text": "Medyo mabudlay intyendihon kag hambalon ini sang mga pamulongpulong sang Hiligaynon (Ilonggo) kag Kinaray-a tungod sa isa ka tunog nga ginarepresentar sa ila panulat paagi sa letra 'e'. Ang 'e' nga ini daw 'l' sa hiligaynon ukon 'r' sa Kinaray-a." },
        { "cell": "quote-letter", "text": "Sang 14 anyos na siya naimprenta ang iya primero nga sugilambong (ukon nobela) nga ginngalanang 'Ang Mga Tunoc Sang Isa Ca Bulac'. Ginahimo niya ini bisan babayi siya kag ang iya ginapangsulan halos lalaki kag sa ina nga tiyempo indi ginaseryosohan ang mga babayi nga manogsulat. Ogani ginabawalan na sang iloy ni Magdalena magsulat, apang sige-sige pa ang iya sulat." },
        { "cell": "quote-letter", "text": "Ang iya nga pinakabantog nga binalaybay 'Ang guitara', ginabasa kag ginaestudua sang mga estudyante at iskolar tubtob sa gihapon. Ang iban niya nga mabantog nga sinulat amo ang sugilanon \"Si Anabella\", ang mga nobela \"Sa Kaapang sang Inaway\", \"Ang Dalaga sa Tindahan\" kag \"Ang Kahapon sang Panay\"." },
        { "cell": "quote-letter", "text": "Sia ang manogsulat sang 'Fray Butod', isa ka obra nga pampakaladlaw (Satirical Work), tuhoy sa isa ka matambok nga pari." },
        { "cell": "quote-letter", "text": "Ang lugar may ara man punerarya, nga sadtong tiempo indi pa gid uso sa mga tuig 1960's." },
        { "cell": "quote-letter", "text": "Ang Brooke's Point una nga klase sang munisipalidad nga makita sa probinsya sang Palawan, Pilipinas. May 1303.4 kwadrado ini nga kalaparon kag ini kabahin sang ika-duha nga distrito kongresyonal." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "buttonlabel=Maghimo sang bag-o nga artikulo",
        "Ang Sinulog isa ka saot nga may duha ka tawo nga daw ga-inaway-away, apang indi man lamang matuod. Ginahimo ini sa pamalaye, ukon ang tion nga magamuno ang nobyo magpangasal sa iya nobya.",
        "Ang representasyon sang Nynorsk kag mga ablante sini sa mga diyaryong posgerang Norwego",
        "Ang Sibagat una nga klase sang munisipalidad nga makita sa probinsya sang Agusan del Sur, Pilipinas. May 567.82 kilometro kwadrado ini nga kalaparon kag ini kabahin sang una nga distrito kongresyonal.",
        "Base sa 2010 census, ini may populasyon nga 35,102. Ang zip code sini 5702.",
