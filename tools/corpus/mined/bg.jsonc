// MINED NORMALIZATION CORPUS — bg. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer, for a
// language with no FLEURS corpus. The cells are the empirical shape of the rules the treated languages
// actually needed, so coverage of them is the completeness criterion — not size.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: FLEURS bg_bg
// segmentation: sentence (abbreviation dots protected before splitting)
{
    "language": "bg",
    "source": "FLEURS bg_bg",
    "segmentMode": "sentence",
    "totalSegments": 1986,
    "cellsCovered": 25,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 2,          // in 22 treated languages
        "digit-run": 153,      // in 19 treated languages
        "fractions": 2,        // in 18 treated languages
        "clock": 20,           // in 18 treated languages
        "signs": 10,           // in 17 treated languages
        "dotted": 23,          // in 16 treated languages
        "era-marker": 3,       // in 14 treated languages
        "year": 153,           // in 14 treated languages
        "decimals": 20,        // in 12 treated languages
        "ordinal-latin": 1,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 6,            // in 9 treated languages
        "ranges": 14,          // in 7 treated languages
        "currency": 0,         // in 6 treated languages
        "abbrev": 129,         // in 6 treated languages
        "latin-in-native": 153, // in 6 treated languages
        "percent": 8,          // in 5 treated languages
        "rate": 13,            // in 4 treated languages
        "zero-width": 0,       // in 4 treated languages
        "roman": 4,            // in 3 treated languages
        "initialism": 134,     // in 3 treated languages
        "grouped": 19,         // in 3 treated languages
        "signed-number": 2,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 14,     // in 3 treated languages
        "exponent": 1,         // in 24 treated languages
        "arithmetic": 0,       // in 2 treated languages
        "ampersand": 0,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 1,      // in 3 treated languages
        "version-dot": 3,      // in 3 treated languages
        "quote-letter": 5,     // in 4 treated languages
        "scaled-currency": 0,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 107 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 0
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Монтевидео е в субтропичната област; през летните месеци са нормални температури над +30 °C." },
        { "cell": "degrees", "text": "Фред е най-силният тропически циклон, регистриран досега на юг и изток в Атлантическия океан след появата на сателитни изображения, и само третият по големина ураган, регистриран на изток от 35° з.д." },
        { "cell": "digit-run", "text": "Япония притежава почти 7000 острова (най-големият е Хоншу), което я прави седмият по големина остров в света!" },
        { "cell": "digit-run", "text": "Постепенно дървените колела били заменени с железни. През 1767 г. са въведени първите изцяло железни релси." },
        { "cell": "digit-run", "text": "Като съветник по националната сигурност той е помагал на Картър да се справя дипломатично със световните дела, като например споразумението в Кемп Дейвид през 1978 г.; нормализирането на американско-китайските отношения в края на 1970-те години; иранската революция, довела до кризата с иранските заложници през 1979 г. и съветската инвазия в Афганистан през 1979 г." },
        { "cell": "digit-run", "text": "През 2000 година е поставен неговият хиляден печат великолепният „Велики дела на шведските крале“ на Дейвид Кльокер Еренстрал, който е включен в Книгата на световните рекорди на Гинес." },
        { "cell": "fractions", "text": "Макар никой да не знае със сигурност кой го е написал, известно е, че в началото, след като е създаден, големият пергамент (с размери 29¾ инча на 24½ инча) е бил навит на руло, за да се съхрани." },
        { "cell": "fractions", "text": "Материалът трябва да е достатъчно мек при ниски температури, а шарката достатъчно дълбока, 5 mm (1/5 инча) или повече." },
        { "cell": "clock", "text": "Автобусите тръгват през целия ден от междуобластната автобусната станция (зад реката), въпреки че повечето от тях, особено тези, които се движат на изток и към Джакар/Бумтанг тръгват между 06:30 и 07:30 часа." },
        { "cell": "clock", "text": "Стандартът 802.11n работи както на честотите 2,4 Ghz, така и на 5,0 Ghz честоти." },
        { "cell": "clock", "text": "Това ще позволи той да бъде съвместим в обратна посока с 802.11a, 802.11b и 802.11g, при условие че базовата станция има двойни радиа." },
        { "cell": "clock", "text": "Спасителните пожарни екипи са потушили пожара до 23:35." },
        { "cell": "signs", "text": "Въпреки това, 80% от нашите стоки са били обложени с тарифи в страните от Централна Америка." },
        { "cell": "signs", "text": "От 1400 души, анкетирани преди федералните избори през 2010 г., тези, които се противопоставят на идеята за превръщане на Австралия в република, са нараснали с 8 % от 2008 г. насам." },
        { "cell": "signs", "text": "Те включват финансови рестрикции и възбрана от страна на Европейския съюз върху износа на суров нефт, който носи на иранската икономика 80% от чуждестранните ѝ приходи." },
        { "cell": "signs", "text": "Това мнение се споделя от 34% от анкетираните, които искат кралица Елизабет II да бъде последния монарх на Австралия." },
        { "cell": "dotted", "text": "Жените трябва да осъзнаят, че културните различия могат да породят ситуации, считани от тях за тормоз, в които често са следвани, сграбчвани за ръката и т.н." },
        { "cell": "dotted", "text": "На Баба Шиам са сервирани 108 блюда от Чхапан Бхог (в Хиндуизма, 56 различни ядливи артикула, като сладки, плодове, ядки, ястия и т.н., предлагани на божеството)." },
        { "cell": "dotted", "text": "Професор Памела Фъргюсън от Университета в Дънди отбелязва, че „изглежда, журналистите се движат по опасна линия, ако разпространят снимки и т.н. на заподозрени.“" },
        { "cell": "dotted", "text": "Растенията произвеждат кислород, който хората дишат, и приемат въглероден диоксид, който хората изпускат (т.е. издишват)." },
        { "cell": "era-marker", "text": "Някои от много редките скали на Земята се продават от 11 000 на 22 500 щ.д. за унция, което е около 10 пъти повече от цената на златото." },
        { "cell": "era-marker", "text": "Бинарното число може да има само една от две стойности, т.е. 0 или 1, като тези цифри се наричат двоични цифри - или битове, на компютърен жаргон." },
        { "cell": "era-marker", "text": "CafeNet El Sol предлага услуга за резервация срещу такса от 30 щ.д. или 10 щ.д. за еднодневни пропуски; подробности на страницата им в Корковадо." },
        { "cell": "year", "text": "В северната част или хребета Сентинел, е най-високата планина в Антарктида, масивът Винсън, с връх Винсън, достигащ 4892 м." },
        { "cell": "year", "text": "Португалците я разрушават и построяват отново под името „Каса Бранка“, но я напускат след земетресение през 1755 г." },
        { "cell": "year", "text": "Например, „научаване“ и „социализиране“ са посочени като важни мотивации за интернет употреба (James et al., 1995)." },
        { "cell": "year", "text": "На 6 октомври 1789 г. ужасените крал Луи XVI, кралица Мария Антоанета, двете им малки деца (11 - годишната Мари Терез и 4 - годишния Луи - Шарл), както и сестрата на краля, мадам Елизабет, са принудени да се върнат в Париж от Версай от тълпа жени на пазара." },
        { "cell": "decimals", "text": "Според геофизичната агенция на Джакарта предупреждение за цунами не е издавано и няма да бъде издадено, тъй като земетресението не отговаря на изискването за сила с магнитуд 6,5." },
        { "cell": "decimals", "text": "Демонстрантите се надяват да съберат 1,2 милиона подписа за петиция, която да представят пред Националния конгрес през ноември." },
        { "cell": "decimals", "text": "Уистлър (на 1,5 часа път с кола от Ванкувър) е скъпо, но популярно заради Зимните олимпийски игри през 2010 г. място." },
        { "cell": "decimals", "text": "В най-скорошния си месечен доклад ОПЕК посочва, че износът на суров нефт е стигнал най-ниското ниво за последните две десетилетия - 2,8 милиона барела дневно." },
        { "cell": "ordinal-latin", "text": "Кубовидните медузи се срещат близо до плажовете и речните устия от октомври до април северно от град 1770. Понякога могат да бъдат срещнати и извън този период." },
        { "cell": "units", "text": "Има много различни формати на филм, които са били използвани през годините. Стандартният 35 mm филм (негатив 36 на 24 mm) е най-разпространеният от тях." },
        { "cell": "units", "text": "Някои филмови камери в среден формат използват негатив във формат 6 на 6 cm, по - точно 56 на 56 mm." },
        { "cell": "units", "text": "Това дава резолюция почти четири пъти по-голяма от тази на 35 mm негатив (3136 mm2 спрямо 864)." },
        { "cell": "units", "text": "Сундарбан заема площ от 3850 km², като почти една трета от тази територия е покрита с вода и блата." },
        { "cell": "ranges", "text": "Прекъсването на съня е процесът на умишлено събуждане по време на обичайното ви време за сън и заспиване малко по-късно (10-60 минути)." },
        { "cell": "ranges", "text": "Дел Потро имаше ранното предимство във втория сет, но това също изискваше тайбрек след като достигна 6-6." },
        { "cell": "ranges", "text": "Периодът, през който са се случили събитията, обикновено се нарича Късно средновековие - периодът от европейската история през 11-и, 12-и и 13-и век (1000 – 1300 г. сл. Хр.)." },
        { "cell": "ranges", "text": "Рекордът на Надал срещу канадеца в директен двубой е 7–2." },
        { "cell": "abbrev", "text": "Арли Веласкес от Мексико завърши на 15-то място в категорията Super-G седящи за мъже. Адам Хол от Нова Зеландия завърши на 9-то място в категорията Super-G стоящи за мъже." },
        { "cell": "abbrev", "text": "Към края на Средновековието Западна Европа започнала да развива собствен стил. В резултат на кръстоносните походи хората започнали да използват копчета за закопчаване на дрехите си, което е едно от най-големите развития на това време." },
        { "cell": "abbrev", "text": "Не знаем със сигурност, но може да е имал раздвоен език. Храната му включвала костенурки, големи риби, други мозазаври и може дори да е бил канибал." },
        { "cell": "abbrev", "text": "То нападало и всичко, което влезе във водата; не би могъл да се мери с него дори гигантски динозавър като Т. Рекс." },
        { "cell": "latin-in-native", "text": "Парите може да се обменят само в банка, намираща се в Стенли срещу магазина на FIC West, която е единствена на островите." },
        { "cell": "latin-in-native", "text": "Националният парк Крюгер (KNP) се намира в североизточната част на Южна Африка и се простира на изток по протежение на границата с Мозамбик, на север е Зимбабве, а река Крокодил е южната му граница." },
        { "cell": "latin-in-native", "text": "В рамките на ловната програма на Асоциацията на спортните стрелци на Австралия бяха наети квалифицирани доброволци в партньорство с NPWS и Асоциацията на спортните стрелци (NSW) Inc." },
        { "cell": "latin-in-native", "text": "АЕЦ „Кашивазаки Карива“ в префектура Ниигата функционира нормално, съобщи също NHK." },
        { "cell": "percent", "text": "Надал спечели 76 точки в първия сервис и отбеляза 88% нетни точки в мача." },
        { "cell": "percent", "text": "Бившият губернатор на Масачузец Мит Ромни спечели първите президентски избори на Републиканската партия във Флорида в четвъртък с над 46% от гласовете." },
        { "cell": "percent", "text": "Гренландия е добре свързана с 93% от населението, което има достъп до интернет, благодарение на подводни оптични кабелни връзки с Европа и широколентов спътник." },
        { "cell": "percent", "text": "В крайна сметка, 29% от анкетираните вярват, че Австралия трябва да стане република колкото може по-скоро, а според 31% Австралия никога не трябва да става република." },
        { "cell": "rate", "text": "След пет минути се вижда как започва да духа вятър, около минута по-късно вятърът достига 70 км/ч... тогава започва дъждът, но е толкова силен и капките са толкова едри, че удрят кожата ти като игла, след това от небето пада градушка, хората се паникьосват и крещят и се прегазват един друг." },
        { "cell": "rate", "text": "Според парковите органи, от мечки и вълци стойте на поне 100 ярда/метра, а от всички други диви животни на 25 ярда/метра!" },
        { "cell": "rate", "text": "Рано сутринта, ветровете бяха със скорост около 83 км/ч и се очакваше да продължат да отслабват." },
        { "cell": "rate", "text": "Г-н Рийд е успял да мине седем пъти по моста с колата на Нова Зеландия A1GP, Black Beauty, със скорост над 160 км/ч." },
        { "cell": "roman", "text": "По време на организираната от движението „Мау“ борба за независимост, едно мирно събиране в града завършва с убийството на върховния вожд Тупуа Тамасесе Леалофи III." },
        { "cell": "roman", "text": "Изпълняващата длъжността министър-председател Джулия Гилард заяви по време на кампанията за федералните избори през 2010 г., че според нея Австралия трябва да стане република в края на управлението на кралица Елизабет II." },
        { "cell": "initialism", "text": "ООН се надява също да финализира фонд за подпомагане на засегнатите от глобалното затопляне страни, за да могат те да се справят с последиците от него." },
        { "cell": "initialism", "text": "Джордж Буш, президент на САЩ, приветства съобщението." },
        { "cell": "initialism", "text": "Равни или много близки до това съотношение са много често срещани формати (например група от формати APS)." },
        { "cell": "initialism", "text": "В Съединените американски щати са известни около 400 000 случая на множествена склероза (МС), което я прави водещата неврологична болест сред младежите и хората на средна възраст." },
        { "cell": "grouped", "text": "Козите вероятно са опитомени за първи път преди около 10 000 години в планинските масиви Загрос в Иран." },
        { "cell": "grouped", "text": "Апия е столицата на Самоа. Градът се намира на остров Уполу и е с население от почти 40 000 души." },
        { "cell": "grouped", "text": "От 1966 г. насам Сундарбаан е резерват за диви животни, и се смята, че в района вече има 400 кралски бенгалски тигъра и около 30 000 петнисти елена." },
        { "cell": "grouped", "text": "Тези планове, обаче, станаха невалидни почти за една нощ, когато над 800 000 войници от Червената армия на Съветския съюз нахлуха и създадоха беларуския и украинския фронтове, след като завзеха източните региони на Полша, нарушавайки Рижкия мирен договор, Съветско - полския пакт за ненападение и други международни договори, двустранни и многостранни." },
        { "cell": "signed-number", "text": "Il -76 е бил основен компонент на руската и съветската военна сила от 70 - те години на миналия век и вече е участвал в сериозен инцидент в Русия миналия месец." },
        { "cell": "letter-name", "text": "Количеството водородни (H в pH) йони в изпитвания химикал указва нивото на рН." },
        { "cell": "letter-name", "text": "Джони Рийд, втори пилот на отбора на A1GP в Нова Зеландия, днес влезе в историята, карайки най-бързо законно по 48 - годишния Оукланд Харбър Бридж, Нова Зеландия." },
        { "cell": "letter-name", "text": "Те включват Холандия, като вчера Ана Йохимисен завърши девета в категорията седящи за жени в Super-G, и Финландия с Катя Сааринен, финиширала десета в същото състезание." },
        { "cell": "letter-name", "text": "Стардъст ще постави нов рекорд за всички времена за най-бързият космически кораб, върнал се на Земята, като счупи предишния рекорд, постигнат през май 1969 г. по време на завръщането на командния модул на Аполо X." },
        { "cell": "sports-time", "text": "На другото състезание, Гигантския слалом, тя финишира на десето място в женска група за седящи с комбинирано време на бягане 4:41.30, 2:11.60 минути по-бавно от австрийката Клаудия Лоеш, която финишира първа, и 1:09.02 минути по-бавно от финиширалата на девето място унгарка Гьонги Дани." },
        { "cell": "version-dot", "text": "Скоростите от 802.11n са значително по-високи от тези на предшествениците, които достигат максимална теоретична пропускателна способност от 600 Mbit/s." },
        { "cell": "quote-letter", "text": "Според Мик О'Флин, изпълняващ длъжността директор на „Опазване и наследство“ в Националната служба за парковете и дивата природа NPWS, четиримата стрелци, избрани за първата стрелба, са получили подробни инструкции за безопасност и обучение." },
        { "cell": "quote-letter", "text": "С начало от Running Tours Barcelona в Барселона и Copenhagen's Running в Копенхаген, към него бързо се присъединяват Running Tours Prague със седалище в Прага и други." },
        { "cell": "quote-letter", "text": "Карно е известен, но спорен учител по английски език, преподавал в „Modern Education“ и „King's Glory“, който твърди, че е обучавал 9000 студенти в разгара на кариерата си." },
        { "cell": "quote-letter", "text": "Мостът на река Ояпок е кабелен мост. Той се простира над река Ояпок, за да свърже градовете Ояпок в Бразилия и Сен-Жорж-де-л'Ояпок във Френска Гвиана." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "В църковния двор над някои гробници има интересни мраморни скулптури на гълъби.",
        "От 1400 души, анкетирани преди федералните избори през 2010 г., тези, които се противопоставят на идеята за превръщане на Австралия в република, са нараснали с 8 % от 2008 г. насам.",
        "Изследователите предполагат, че макар това да е опашката на млад динозавър, пробата показва оперение на възрастен, а не пух на млад индивид.",
        "Повечето от сградите по границите на комплекса са възстановени, за да се даде на туристите по-добра представа как са се появили.",
        "Според изтеклата информация, документът ще се отнася до спора за границите, които Палестина иска въз основа на границите преди войната за Близкия изток от 1967 г.",
        "Шестима заложници, включително децата и възрастните, както и филипинските фотографи, бяха освободени по-рано.",
        "Екскурзиите са голяма част от училищното обучение. Много често учителят би искал да заведе учениците си на места, до които не може да се отиде с автобус.",
        "Ако слизате на брега, използвайки екскурзиите организирани от кораба, няма да имате нужда от отделна виза (от 2009 г.).",
        "Властите предполагат, че това е знак, че контейнерите за съхранение на ураново гориво на обекта може да са се спукали и да има изтичане.",
        "Със сигурност ще се намокриш, ако пресечеш моста или вървиш по пътеките, криволичещи около водопада.",
        "Каучсърфингът е създаден през януари 2004 г., когато компютърният програмист Кейси Фентън намерил евтин полет до Исландия, но нямало къде да отседне.",
        "Можете сами да отбележите изминалото време, като наблюдавате повтарящи се събития. Циклично е такова събитие, което се случва отново и отново на редовни интервали.",
        "Калехон дел Бесо (Алея на Целувката). Две тераси, разделени само с 69 см, са дом на стара любовна легенда.",
        "Всяко шоу ще дава на децата и препоръки за книги, които да търсят, когато отиват в тяхната библиотеката.",
        "Технологичният детерминизъм е термин, който обхваща широк спектър от идеи на практика - от технологичния тласък или технологичния императив до стриктното усещане, че човешката съдба се ръководи от логика, свързана с научните закони и тяхното проявление в технологиите.",
        "Островите Кук нямат градове, но се състоят от 15 различни острова. Основните са Айтутаки и Раротонга.",
        "Чарлз записва обаче университета в Тринити Колидж, Кеймбридж, където учи антропология и археология, а по-късно и история и получава 2:2 (по-ниска степен втори клас).",
        "Много хора мечтаят за деня, в който хората ще могат да пътуват до друга звезда и да изследват други светове. Някои хора се чудят какво има там, други вярват, че извънземни или друг живот може да живеят на друга планета.",
        "Днес, в японски вестник, издателят на играта Конами заяви, че няма да пусне играта „Шест дни във Фалуджа“.",
        "Еднодневният туризъм включва разстояния между по-малко от миля и по-дълги дистанции, които могат да се изминат за един ден.",
        "Облеклото може да бъде взето назаем от наличното на входа, но то не се пере след всеки потребител, така че може да не се чувствате комфортно, носейки тези поли. Един размер е подходящ за всички мъже!",
        "Най-важното условие за този начин на мислене е, че само един отговор е правилен. Мисли се само за два отговора, а именно верен или грешен.",
        "Учени от Националния център за урагани прогнозират, че до сряда Даниел ще се превърне в ураган.",
        "Лесно да се намерят места около старата Медина, където се продават традиционни марокански стоки, като тагини, керамични изделия, кожени изделия, наргилета и цял спектър от дрънкулки, но всичко това е за туристите.",
        "Острието на съвременната кънка има двоен ръб с вдлъбнатина по средата. Двата ръба осигуряват по-добро сцепление на леда, дори при наклон.",
        "За разлика от Земята, Слънцето няма кора, на която можеш да стъпиш. Цялото е изградено от газове, огън и плазма.",
        "Това дава резолюция почти четири пъти по-голяма от тази на 35 mm негатив (3136 mm2 спрямо 864).",
        "Времето се изучава от учени в сферата на религията, философията и науката в продължение на хиляди години.",
        "Посолството на САЩ в Найроби, Кения предупреди за „екстремисти от Сомалия“, планиращи самоубийствени бомбени атентати в Кения и Етиопия.",
        "Сфинксът служи за фон и разказвач на дълга история."
    ]
}
