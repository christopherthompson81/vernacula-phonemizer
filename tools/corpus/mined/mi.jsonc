        "calendar": 0,         // lexical cell — matched via the term list
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "digit-run", "text": "Nā te iwi Potugese i turaki, ka hanga mai anō me te ingoa o Casa Branca, ka whakarerea hoki whai muri mai i te rū whenua i te tau 1755." },
        { "cell": "digit-run", "text": "I tōna tūranga ki te NSA, i tautoko ia i a Carter i roto i ngā take huhua o te ao, pērā ki ngā take ki Camp David i te 1978, ngā mahinga ngātahi i waenga i a Amerika me Haina i te pito o ngā tau 1970, ngā uauatanga ki Iran i hua ai te raru nui ki reira i te tau 1979 me te urutomonga o te Soviet ki roto o Afghanistan i te tau 1979." },
        { "cell": "digit-run", "text": "Kei te wāhanga raki, kei te Sentinel Range rānei ngā maunga teitei o Te Kōpakatanga ki te Tonga, arā ko te Vinson Massif, ko tōna tihi nui ko Mount Vinson ki te 4892 m." },
        { "cell": "digit-run", "text": "Tāria te wā, i whakakapia ngā wīra rākau ki ngā wīra rino. I te tau 1767, i kitea tuatahitia ngā ara tereina tuatahi he rino-katoa." },
        { "cell": "digit-run", "text": "Mai i te 1,400 tāngata i uia i mua i te pōtitanga ā-motu i te tau 2010, ko te hunga e whakahē ana i te huringa o Ahitereiria ki tētahi whenua kore kīngi, kuini rānei i piki ake ki te 8 ōrau mai i te tau 2008." },
        { "cell": "fractions", "text": "He ahakoa kāore tētahi e mōhio pū nāwai i tuhi, e mōhio nei i te timatanga o tana oranga, te tuhinga pepa nui (ko tana nui ko te 29 3/4 inihi mā te 24 1/2 inihi) i rōrangia hei putunga." },
        { "cell": "fractions", "text": "Me rawaka te hōhonu o te tauira, 5 mm (1/5 inihi) neke atu rānei, ā, me rawaka te ngohe o te matū ki ngā paemahana makariri." },
        { "cell": "clock", "text": "Ahakoa te wā, i tīneia te ahi i mua i te 11:35 pm e ngā kairanga kaitiaki ahi." },
        { "cell": "clock", "text": "I waenganui i te 10:00-11:00 pm MDT, i whakakāngia tētahi e ngā herehere ki te iari." },
        { "cell": "clock", "text": "Ka wehe ngā pahi i te teihana kei te pokapū (kei tērā atu taha o te awa) i te wā e awatea ana, ahakoa ko te nuinga, mātua rā, ko ērā e haere whaka te raki ana, tae atu anō hoki ki a Jakar/Bumthang ka wehe mai i te 6.30 ki te 7.30." },
        { "cell": "clock", "text": "Mā tēnei ka muri hototahi i te 802.11a, te 802.11b me te 802.11g, i runga i te āhuatanga e whai irirangi takirua ana te teihana." },
        { "cell": "clock", "text": "Ko te paerewa 802.11n ka kōkiritia mā runga i te iarere 2.4Ghz me te 5.0Ghz" },
        { "cell": "signs", "text": "I mahi hoki ia i te whakairo i ngā pepa tāra ki ngā tini whenua, ko ētahi tauira o āna mahi nō nākuanei ko ngā whakaahua Pirimia ki te taha whakamua o te tāra $5 me te $100 hou o Kānata." },
        { "cell": "signs", "text": "I riro i a Nadal ngā piro 88% i te whakataetae, ā, me te whiwhi i te 76 piro i te whiunga tuatahi." },
        { "cell": "signs", "text": "Ko ētahi o ngā toka, ētahi rā kāore nei e kitea i tēnei ao nei, e hokona atu ana mai i te US11,000 ki te $22,500 mō te aunihi kotahi, e rite ana tēnei ki te tekau wā neke atu i te utu kōura." },
        { "cell": "signs", "text": "I noho 190 a Batten ki te rārangi 400 Richest Americans o te tau 2008 me te rawa āwhiwhi o te $2.3 piriona." },
        { "cell": "signs", "text": "Engari, hei tā te Pirimia, tā John Howard, ko te kaupapa o te pire he manaaki i ngā hohipera kia kore ai ō rātou mana e takahia e te Kāwanatanga o Tāhimana, ka whakawhiwhia ki te AUD$45 miriona." },
        { "cell": "dotted", "text": "Kei te whakatau tata ngā U.S. Corps of Engineers ko te 6 īnihi o te hekenga ua ka wāwāhi pea i ngā maioro kua pakaru kē." },
        { "cell": "dotted", "text": "I tīmata te hōtaka i te 8.30 p.m. takiwā (15.00 UTC)" },
        { "cell": "dotted", "text": "Ka āhei ngā kōpere mai i ā rātou kōpere whakamate te ngotongoto i te kākahu ārai o ngā hōia hoariri. Tata ki te 1000 B.C., i whakatūria e te hunga Assyrian te ope hōia eke hōiho tuatahi." },
        { "cell": "year", "text": "I te rā 6 o Ōketopa i te tau 1769 i panaia anō atu ki Parī i Versailles e tētahi māpu wāhine mākete te hunga tino mataku a King Louis XVI rātou ko Queen Marie Antoinette ko ā rāua tamariki nohinohi tokorua (a Marie Therese 11 tau te pakeke, rāua ko Louis-Charles e 4 tau te pakeke) ko te tuahine a te Kīngi a Madam Elizabeth." },
        { "cell": "year", "text": "Hei tauira, e marohitia ana te \"ako\" me te \"pāhekoheko\" hei whakahihikotanga hira mō te whakamahinga Ipurangi (James et al., 1995)." },
        { "cell": "year", "text": "Ko tāna pane kuīni tua 1,000 ko te \"Great Deeds by Swedish Kings\" mīharo nā David Klocker Ehrenstrahl i te tau 2000, kua rārangihia ki te Guinness Book of World Records." },
        { "cell": "year", "text": "Ko te wā i tū ai ngā mahi e kīia whānuitia ana ko ngā High Midle Ages arā te wā o te hītori Ūropi i ngā rautau 11, 12 me te 13 hoki (AD 1000-1300)." },
        { "cell": "year", "text": "I whakapuaki a Mrs. Kirchner i tana takune ki te tono i te tūranga perehitene ki te Argentine Theatre, arā ko te wāhi i whakamahia e ia hei tīmata i tana tautohe i te tau 2005 mō te Senate hei mema o te apatono ā-takiwā o Buenos Aires." },
        { "cell": "decimals", "text": "Puta noa i Ngā Whenua Tōpū o Amerika he tata ki te 400,000 kēhi e mōhiotia ana o te Multiple Sclerosis (MS), nō reira ko ia te tahumaero ā-roro matua ki ngā pakeke he rangatahi, he waenga rānei te pakeke." },
        { "cell": "decimals", "text": "Kei te hōkai 19,500 km₂ te rahi o te pāka, ā, kei te whakawehea ki ngā wāhi rauropi 14 rerekē, kei te tautīnei ia wāhi i ngā karerehe rerekē." },
        { "cell": "decimals", "text": "Kei a Hapani ngā motu tata ki te 7,000 (ko te mea nui rawa ko Honshu), nā konei ko Hapani te motu tuawhitu te rahi rawa ki te ao!" },
        { "cell": "decimals", "text": "Heoi anō, i noho korehāhā ēnei mahere i te tata ki te kotahi pō, i te kuhu atu me te hanga a te neke atu i te 800,000 hoia i te Red Army a te Soviet Union i ngā pae Belarussian me te Ukranian i muri i te eke ki ngā rohe rāwhiti o Pōrana me te takahi i te Riga Peace Treaty, te Soviet-Polish Non-Aggression Pact, me ētahi atu tiriti ā-ao, i waenganui i ngā whenua e rua, whenua takitini rānei." },
        { "cell": "decimals", "text": "Kāore tētahi whakatūpato tai āniwhaniwha i tukua, ā, e ai ki te tari takotoranga whenua o Jakarta, kāore tētahi whakatūpato tai āniwhaniwha e tukua i te mea kāore te rū o te whenua i tae ki te hiahia o te 6.5." },
        { "cell": "ordinal-latin", "text": "Kua kitea he pokapū hāereere mai i te rautau 19. He kōwhiringa pai i te nuinga o te wā tētahi kaiwhakarite haerenga mō tētahi haerenga ka neke atu i te wheako o mua o tētahi tangata hāereere o te taiao, te ahurea, te reo, ngā whenua pohara rānei." },
        { "cell": "ordinal-latin", "text": "Ka tū Ngā Taumāhekeheke o te Ao mō te Hunga Pararūtiki atu i te 24 o Ākuhata ki te 5 o Hepetema hei te tau 2021. Ka tū ētahi o ngā mahi ki wāhi kē atu puta noa i Hapani." },
        { "cell": "ordinal-latin", "text": "Ka kitea ngā momo Tīwai nei ki tātahi me te taha o ngā awa mai i te marama o Oketopa me Aperira, ki te raki o 1700. I ētahi ka kitea i waho atu i ēnei wā." },
        { "cell": "units", "text": "Kei te noho te huinga motu te 120 km ki te raki o te Raenga Kūiti. Ko te mea nui rawa ko King George Island me tōna kāinga o Villa Las Estrellas." },
        { "cell": "units", "text": "Ko ngā Sundarbans ngā tātua ritora mangrove nui rawa i te ao, e toro ana i te 80 km (50 mairo) ki roto ki te Bangladeshi me te Iniana whenuaroto tae atu ki te takutai." },
        { "cell": "units", "text": "He tata ki te 70 km te mātotoru o te kirinuku ki te taha tata, ā, e 100 km te mātotoru ki te taha tawhiti." },
        { "cell": "units", "text": "Ka rima meneti i muri i te tīmatanga o te whakaaturanga ka tīmata tētahi hau te pupuhi, ā, kotahi meneti whai muri ake, kua tae atu te hau ki te 70km/h... Kātahi ka tae mai te ua, engari ka pērā rawa te kaha, te rahi ka patua te kiri pērā i te ngira, kātahi ka rere te hukawaitara i te rangi, ka maurirere te hunga, ka tioro, ka takahi tētahi i tētahi." },
        { "cell": "units", "text": "Hei tauira, ko te whakatakotoranga whakaahua ū noa rawa ki te ao ko te 35mm, koirā te rahi kiriata matua i te mutunga o te wā o te kiriata ā-kiko." },
        { "cell": "ranges", "text": "Ko te kokoti moe ko te hātepe o te āta whakaoho i te wā noa o tō moe, me te hoki ki te moe tētahi wā poto whai muri ake (10-60 ngā meneti)." },
        { "cell": "ranges", "text": "I a Del Potro te kāhukahuka wawe ki te huinga tuarua, engari i hiahiatia hoki tēnei i te paenga whitu i muri i te tae atu ki te 6-6." },
        { "cell": "ranges", "text": "Ka puta ngā hau kaha (100-200 mairo/haora te nuinga) ā, e āhei ana te hiki i ngā mea nui ki te rangi, e kawea ana i te nekehanga o te awhiowhio." },
        { "cell": "ranges", "text": "Ko te mauhanga kanohi ki te kanohi o Nadal ki te Kānata he 7-2." },
        { "cell": "ranges", "text": "He whenua mōwai te taiwhenua o Antarctica, e kapia ana e te huka, 2-3 kiromita te whānui." },
        { "cell": "currency", "text": "250 tau ki muri, kua tipu te Guinness ki tētahi pakihi ā-ao ka whiwhi i te 10 piriona euros (US$14.7 piriona) ia tau." },
        { "cell": "currency", "text": "E mea ana tēnei Pire me mau pane \"18\" ngā kēmu ataata katoa ka hokona ki te takiwā o Kariwhōnia, ā, mēna ka hokona atu he kēmu ki te hunga tamariki, ka hāmenetia koe mō te $1,000 mo ia tūkinotanga." },
        { "cell": "currency", "text": "Kei te tuku a CafeNet El Sol i tētahi ratonga whakarite mō te utu o te $US30, te $10 rānei mō ngā tīkiti kotahi-rangi; kei tā rātou whārangi Corcovado ngā taipitopito." },
        { "cell": "abbrev", "text": "Ko ngārara ngā kararehe tuatahi i whai hā. Ko ō rātou pukenga ki te rere i māmā ake ai te ārai atu i ngā hoariri, ki te kai kai, ki te kimi hoa hoki." },
        { "cell": "abbrev", "text": "I mutu tekau mā rima a Arly Velasquez nō Mehiko i te nōhanga Super-G tāne. I tuaiwa a Adam Hall nō Aotearoa i te tūnga Super-G tāne." },
        { "cell": "abbrev", "text": "Kua pāngia ētahi tūroro e te ngārara ki te hohipera, te whakaaro a Dr. Moll, ā, tokorua i te itinga iho he kaimahi hauora hohipera." },
        { "cell": "abbrev", "text": "Ko tā Pōrana kaieke retireti tāne kua hauā te ataata a Maciej Krezel, me te kaiārahi a Anna Ogarzynska i oti tekau mā toru i te Super-G. I oti rua tekau mā whā tā Kōria ki te Tonga a Jong Seork Park i te Super-G noho tāne." },
        { "cell": "abbrev", "text": "He maha ngā tuaone, i runga i te noho waenga a Tāmaki i ngā whanga e rua. Ko ngā mea rorotu kei ngā wāhi e toru." },
        { "cell": "latin-in-native", "text": "Ākuanei pea ko ngā Safari ngā tino mahinga tūruhi ki Awherika me te tīno mahinga mō te tini o ngā tūruhi." },
        { "cell": "latin-in-native", "text": "Nā te mea he nui te wā ko ngā ākonga te minenga tino whakahē, ka tīmata te kaituhi rangitaki ki te whai kia whakapai ake i te tuhinga hei karo i te whakahēnga." },
        { "cell": "latin-in-native", "text": "E whakahau ana ngā mana-ā-rohe o te takiwa o te hanganga kia noho iho ki rō whare, kia whakaweto i ngā whāhauhau, kia kauaka te wai o te kōrere e inungia." },
        { "cell": "latin-in-native", "text": "He hanga haerere te retireti me ngā tini tāngata hikaka, e mōhiotia whānuitia ki te \"reti nono\", te whakarite i ngā hararei reti i tētahi wāhi motuhake." },
        { "cell": "latin-in-native", "text": "Kei tēnei taiao hou he rauemi rerekē, he kaiwhakataetae rerekē, nō reira me whai te taupori hou i ngā āhuatanga rerekē, i ngā urutaunga rerekē rānei kia noho hei kaiwhakataetae kaha i ērā i te hiahiatia i mua." },
        { "cell": "percent", "text": "i runga i te hononga tūhonohono opotiki weu ki a Ūropi me te āmiorangi tūhonohono anō hoki, e pai ana te honohono a Whenuakākāriki arā e 93% o te taupori e whai ana i te āheinga ipurangi." },
        { "cell": "percent", "text": "Kei roto i ērā ko ngā here ā-pūtea me te peitanga o te kawenga o te hinu urutapu e Te Ūniana o Ūropi, ā, ko tēnā tonu hoki te 80% o te whiwhinga pūtea mai i tāwāhi ka riro i a Irāna." },
        { "cell": "percent", "text": "3% o te whenua ko Tāke ki Ūropa (ko Thace ki te rāwhiti, ko Rumelia ki te kūrae o Balkan rānei)" },
        { "cell": "rate", "text": "Kei a Fred i tēnei wā ngā hau o te 105 māero i te hāora (165 km/h), ā, kei te neke atu ki te raki mā-uru." },
        { "cell": "rate", "text": "I raru ngā pirihimana o Aotearoa i te whakamahi i ā rātou pū hihiani tere kia kite i te tere a Matua Reid i runga i te pāpaku o Black Beauty, ā, ko te wā anake i oti i ngā pirihimana te ine i Matua Reid ko te wā i heke tana pōturi ki te 160km/h." },
        { "cell": "rate", "text": "E ai ki ngā mana o te pāka, me noho tonu te 100 iari/mita atu i ngā pea me ngā wuruhi me te 25 iari/mita atu i ērā atu kararehe mohoao katoa!" },
        { "cell": "rate", "text": "I eke a Matua Reid ki te taraiwa i te waka A1GP o Aotearoa, a Black Beauty i ngā tere neke atu i te 160km/h e whitu ngā wā whakawhiti atu i te piriti." },
        { "cell": "rate", "text": "Tae mai ki te ata moata i tēnei rā, tata ki te 83 km/h ngā hau, ā, ko te matapae ka ngoikore haere tonu." },
        { "cell": "roman", "text": "I te rā 7 o Oketopa i wehea tētahi initia i te hārewa, karekau ngā whara. I whakatau taupua a Rūhia i ngā II-76 i muri i taua tukituki." },
        { "cell": "roman", "text": "I whakapono a Pirimia Julia Gillard nōnā e whakarite ana mō te pōtitanga whānui kia noho a Ahitereiria i runga i tōna ake mana motuhake whai muri mai i te matenga o Kuini Irihāpeti II." },
        { "cell": "roman", "text": "He wāhanga nui rawa te II-76 o te ope hōia a Rūhia, a Soviet hoki mai i te tekau tau 1970, ā, kua kitea kētia tētahi aituā nui whakaharahara ki Rūhia i tērā marama." },
        { "cell": "roman", "text": "Kei te 34 ōrau o te hunga ki te pōtitanga e whakaae ana ki tēnei tirohanga, e hiahia ana kia noho a Queen Elizabeth II hei kīngi whakamutunga o Ahitereiria." },
        { "cell": "initialism", "text": "I mua atu, nā te CEO o Ring, nā Jamie Siminoff i kī, i tīmata te kamupene i te wā kāore tāna pere kuaha i te rangona mai i tana toa ki tōna karāti." },
        { "cell": "initialism", "text": "Hei tā te rīpoata a NHK e pai noa ana ngā whakahaeretanga a te wharau hua ruarua ki Niigata." },
        { "cell": "initialism", "text": "Ko te CEP tuarima o Martelly i ngā tau e whā." },
        { "cell": "initialism", "text": "Ki tētahi kōtuitanga o NPWS me te Sporting Shooters Association of Australia (NSW) Inc, i kimihia he kaimahi tūao māraurau, ki raro i te hōtaka aruaru o te Sporting Shooters Association." },
        { "cell": "initialism", "text": "Kei te raki mā rāwhiti o Āwherika ki te Tonga te Kruger National Park (KNP), ā, kei te pae o Mozambique ki te rāwhiti, ki Zimbabwe ki te raki, ā, ko te pae tonga ko te Crocodile River." },
        { "cell": "grouped", "text": "Ko te āhua nei i whakararatatia ngā nanekoti tata ki te 10,000 tau ki muri ki ngā Zagros Mountains ki Irāna." },
        { "cell": "grouped", "text": "Heoi, ko te ōrau XDR-TB o te hunga katoa e pāngia ana e te mate tuberculosis he iti noa; 6,000 ō roto i te 33,000 tāngata e māuiui ana ki Aherika ki te Tonga." },
        { "cell": "grouped", "text": "Ko Apia te tāone matua o Hāmoa. Kei te motu o Upolu te tāone, ā, he rahinga tāngata paku iti iho i te 40,000." },
        { "cell": "grouped", "text": "Mai i te 1966 kua noho iho te Sundarbans hei whakamaurutanga mohoao, ā, e ai ki te kōrero he 400 ngā tāika ariki Bengal me ngā tia korotiwhatiwha e 30,000 i roto i te wāhi." },
        { "cell": "grouped", "text": "Ko te rohe o Tākei, kei roto hoki ngā roto, e noho ana ki te 783,562 koromita pūrua (300,948 maero pūrua), mai i tērā kei te tonga mā uru o Āhia te 755,688 kiromita pūrua (291,773 maero pūrua), ā, kei Ūropi te 23,764 kiromita pūrua (9,174 maero pūrua)." },
        { "cell": "signed-number", "text": "Kei ngā takiwā pārū a Montevideo; i ngā marama o te raumati ka eke noa ake i te +30 tākiri C te pāmahana." },
        { "cell": "letter-name", "text": "I te nuinga o te wā ka aro tētahi akomanga ki te katoa o ngā take e kōrerotia ana ki konei me te taipitopito nui ake, i te nuinga o te wā ki te wheako ā-ringa." },
        { "cell": "letter-name", "text": "I tō haerenga tuatahitanga ki tāwāhi, i te mānawanawa, i te āroharoha ngā tangata, i runga i te mōhio me urutau ngā tūruhi ki tētahi whenua hou." },
        { "cell": "letter-name", "text": "I tuku ngā kaiwaiata rongonui puta noa i te motu i ngā bhajans, arā ko ngā waiata whakapono, ki ngā waewae o Shri Shyam." },
        { "cell": "letter-name", "text": "E ai ki ētahi rīpoata ka whakatau i te nui o ngā mate ki te waru, ā, ko ngā rīpoata ōkawa e whakaae ana ki ngā wharanga tae atu ki te 30; ēengari kāore anō ngā tau otinga kia whakatau." },
        { "cell": "letter-name", "text": "Ko tāna tuatahi ko te Slalom, i reira ia i whakawhiwhia ki te Kāore i Oti i tana rerenga tuatahi. I ōrite te hua mō te 36 mai i te 116 o ngā kaiwhakataetae ki taua rēhi." },
        { "cell": "ampersand", "text": "I whakapōtaetia ia i te College of Arts & Sciences, mai i Te Whare Wānanga o Virginia i te tau 1950, ā, hei kaitoha matua ia ki tērā kura." },
