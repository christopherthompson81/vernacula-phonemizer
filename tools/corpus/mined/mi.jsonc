        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 26,           // in 9 treated languages
        "ranges": 16,          // in 7 treated languages
        "currency": 7,         // in 6 treated languages
        "abbrev": 113,         // in 6 treated languages
