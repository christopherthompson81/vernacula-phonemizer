    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Το Μοντεβιδέο βρίσκεται στην υποτροπική ζώνη. Το καλοκαίρι, θερμοκρασίες άνω των 30 °C είναι συνηθισμένες." },
        { "cell": "digit-run", "text": "Οι Πορτογάλοι την κατέστρεψαν και την έχτισαν εκ νέου με την ονομασία Κάσα Μπράνκα, μόνο για να την εγκαταλείψουν έπειτα από έναν σεισμό το 1755." },
        { "cell": "digit-run", "text": "Εν τέλει, οι ξύλινες ρόδες αντικαταστάθηκαν από σιδερένιες ρόδες. Το 1767 έκαναν την εμφάνισή τους οι πρώτες σιδηροδρομικές γραμμές που αποτελούνταν αποκλειστικά από σίδερο." },
        { "cell": "digit-run", "text": "Από τα 1.400 άτομα που συμμετείχαν στη δημοσκόπηση πριν από τις ομοσπονδιακές εκλογές του 2010, αυτοί που αντιτίθενται στο να γίνει η Αυστραλία δημοκρατία αυξήθηκαν κατά 8 τοις εκατό από το 2008." },
        { "cell": "digit-run", "text": "Στις 6 Οκτωβρίου 1789, ένας όχλος γυναικών της αγοράς ανάγκασαν τον βασιλιά Λουδοβίκο ΙΣΤ΄, τη βασίλισσα Μαρία Αντουανέτα, τα δύο μικρά παιδιά τους (την εντεκάχρονη Μαρία Θηρεσία και τον τετράχρονο Λουδοβίκο Κάρολο) και την αδερφή του βασιλιά, Κυρία Ελισάβετ, οι οποίοι είχαν τρομοκρατηθεί, να επιστρέψουν από τις Βερσαλλίες στο Παρίσι." },
        { "cell": "fractions", "text": "Παρόλο που κανείς δεν γνωρίζει με σιγουριά ποιος τo έγραψε, είναι γνωστό πως από την αρχή το μεγάλο έγγραφο περγαμηνής (διαστάσεων 29¾ επί 24½ ιντσών) τυλίχθηκε προς αποθήκευση." },
        { "cell": "fractions", "text": "Το σχέδιο πρέπει να είναι αρκετά βαθύ, τουλάχιστον 5 mm (1/5 ίντσας), και το υλικό αρκετά απαλό σε ψυχρές θερμοκρασίες." },
        { "cell": "clock", "text": "Μεταξύ 7:00-8:00 π.μ., ξεκίνησε φωτιά από τους κρατούμενους στην αυλή." },
        { "cell": "clock", "text": "Το ίδιο το όχημα απομακρύνθηκε από το σημείο του ατυχήματος περίπου στις 12:00 ώρα Γκρίνουιτς την ίδια μέρα." },
        { "cell": "clock", "text": "Αυτό θα του επιτρέπει να είναι αντίστροφα συμβατό με το 802.11a, το 802.11b και το 802.11g, δεδομένου ότι ο σταθμός βάσης έχει dual radios." },
        { "cell": "clock", "text": "Τα λεωφορεία αναχωρούν από τον διαπεριφερειακό σταθμό (απέναντι από το ποτάμι) καθ' όλη τη διάρκεια της ημέρας, παρότι τα περισσότερα, ιδιαίτερα εκείνα που κατευθύνονται ανατολικά και προς την Τζακάρ/Μπουμτάνγκ αναχωρούν μεταξύ 06:30 και 7:30." },
        { "cell": "signs", "text": "Βεβαια, το 80% των εμπορευμάτων μας ήταν φορολογητέα μέσω δασμών στις χώρες της Κεντρικής Αμερικής. Σας το κάνουμε δώρο." },
        { "cell": "signs", "text": "Το 30% του Μάτσου Πίτσου είχε αποκατασταθεί μέχρι το 1976 και η αποκατάστασή του συνεχίζεται έως τις μέρες μας." },
        { "cell": "signs", "text": "Το 20% του νερού που εκβάλλουν οι ποταμοί της Γης στους ωκεανούς προέρχεται από τον Αμαζόνιο." },
        { "cell": "signs", "text": "Δεν αποτελεί ανικανότητα μάθησης, αλλά διαταραχή μάθησης. «Το 3-5% των μαθητών, πιθανώς γύρω στα 2 εκατομμύρια Αμερικανών παιδιών, διαθέτει τη διαταραχή»." },
        { "cell": "dotted", "text": "Η φήμη του ως το επίκεντρο της αφθονίας άρχισε να διαδίδεται περίπου το 400 μ.Χ. και διήρκησε έως περίπου το 1100 μ.Χ." },
        { "cell": "dotted", "text": "Η Μεγάλη Πυραμίδα, η οποία χτίστηκε από τους Αιγύπτιους τον 3ο αιώνα π.Χ., είναι ένα από τα πολλά μεγάλα οικοδομήματα σε μορφή πυραμίδας που κατασκευάστηκαν προς τιμή των νεκρών φαραώ." },
        { "cell": "dotted", "text": "Η εποχή που συνέβησαν τα γεγονότα αποκαλείται συχνά ως ο Ύστερος Μεσαίωνας, η περίοδος της ευρωπαϊκής ιστορίας τον 11ο, 12ο και 13ο αιώνα (1.000-1.300 μ.Χ.)." },
        { "cell": "dotted", "text": "Ο αναπληρωτής γενικός επιθεωρητής Ντ. Κ. Άρια δήλωσε: «Έχουμε συλλάβει πέντε άτομα που βίασαν την Ελβετή και έχουμε ανακτήσει το κινητό και το λάπτοπ της." },
        { "cell": "era-marker", "text": "Ο Ναός της Αρτέμιδος στην Έφεσο καταστράφηκε την 21η Ιουλίου 356 π.Χ. από εμπρησμό τον οποίο διέπραξε ο Ηρόστρατος." },
        { "cell": "era-marker", "text": "Στις 8:46 π.μ. ακριβώς, μια σιγή σκέπασε όλη την πόλη, σημειώνοντας ακριβώς τη στιγμή που το πρώτο τζετ χτύπησε τον στόχο του." },
        { "cell": "era-marker", "text": "Η ιδέα του σκι είναι πολύ παλιά. Οι τοιχογραφίες σπηλαίων αναπαριστούν σκιέρ που χρονολογούνται από το 5.000 π.Χ.!" },
        { "cell": "era-marker", "text": "Ο Αλέξανδρος ως βασιλιάς προσφέρθηκε να καλύψει τα έξοδα της ανοικοδόμησης του ναού, όμως η προσφορά του δεν έγινε δεκτή. Ο ναός ανοικοδομήθηκε το 323 π.Χ., έπειτα από τον θάνατό του." },
        { "cell": "year", "text": "Το βόρειο τμήμα ή γνωστό ως οροσειρά Σέντινελ περιέχει τα υψηλότερα βουνά της Ανταρκτικής, τον ορεινό όγκο Βίνσον, με μεγαλύτερο υψόμετρο την κορυφή του βουνού Βίνσον στα 4892 μ." },
        { "cell": "year", "text": "Ως σύμβουλος Εθνικής Ασφάλειας, βοήθησε τον Κάρτερ να χειριστεί διπλωματικά τις παγκόσμιες υποθέσεις, όπως οι συμφωνίες του Καμπ Ντέιβιντ του 1978· η εξομάλυνση των σχέσεων ανάμεσα στις ΗΠΑ και την Κίνα στα τέλη της δεκαετίας του 1970· η Ιρανική Επανάσταση, η οποία οδήγησε στην κρίση των ομήρων το 1979, καθώς και η σοβιετική εισβολή στο Αφγανιστάν το 1979." },
        { "cell": "year", "text": "Τη 15η Αυγούστου 1940, οι Σύμμαχοι εισέβαλαν στη νότια Γαλλία· η επιδρομή αυτή ονομάστηκε επιχείρηση «Δράκος»." },
        { "cell": "year", "text": "Από το 1988 πρέπει να φαίνονται οι ψηφοδόχοι για να καθίσταται δυνατό από αυτούς που ψηφίζουν και τους μάρτυρες να πιστοποιούν τη μη ύπαρξη φακέλων στο ξεκίνημα της ψηφοφορίας και ότι δεν μπαίνουν επιπλέον φάκελοι πέραν αυτών που καταμετρήθηκαν νόμιμα και των έννομων εκλογέων." },
        { "cell": "decimals", "text": "Στις Ηνωμένες Πολιτείες της Αμερικής, είναι γνωστά γύρω στα 400.000 περιστατικά σκλήρυνσης κατά πλάκας (ΣΚΠ), καθιστώντας την κύρια νευρολογική πάθηση μεταξύ των νεότερων και μεσηλίκων." },
        { "cell": "decimals", "text": "Στην Ιαπωνία βρίσκονται σχεδόν 7.000 νησιά (το πιο μεγάλο είναι το Χονσού), και είναι έτσι η 7ο πιο μεγάλη νήσος στον πλανήτη!" },
        { "cell": "decimals", "text": "Το πάρκο καλύπτει 19.500 km2 και χωρίζεται σε 14 διαφορετικές περιοχές οικολογικού ενδιαφέροντος υποστηρίζοντας η καθεμία διαφορετικά είδη άγριας πανίδας." },
        { "cell": "decimals", "text": "Η Απία είναι η πρωτεύουσα της Σαμόα. Η πόλη βρίσκεται στο νησί Ουπόλου και έχει σχεδόν 40.000 κατοίκους." },
        { "cell": "ordinal-latin", "text": "Οι κάτοικοι της Πόλης του Βατικανού ανέρχονται περίπου στους 800. Αποτελεί το μικρότερο ανεξάρτητο κράτος στον κόσμο και αυτό με τον μικρότερο πληθυσμό." },
        { "cell": "ordinal-latin", "text": "Οι Παραολυμπιακοί Αγώνες θα λάβουν χώρα από τις 24 Αυγούστου ως τις 5 Σεπτεμβρίου 2021. Κάποια αγωνίσματα θα διεξαχθούν σε άλλες τοποθεσίες σε όλη την Ιαπωνία." },
        { "cell": "units", "text": "Για παράδειγμα, η πιο συνηθισμένη μορφή φωτογραφίας ακίνητης εικόνας είναι 35 mm παγκοσμίως, που ήταν το επικρατέστερο μέγεθος φιλμ στα τέλη της εποχής του αναλογικού φιλμ." },
        { "cell": "units", "text": "Το πρότυπο 802.11n λειτουργεί τόσο στη συχνότητα των 2,4 Ghz όσο και στη συχνότητα των 5,0 Ghz." },
        { "cell": "units", "text": "Η Τουρκία μαζί με τις λίμνες, καλύπτει 783.562 km² (περίπου 301 χιλιάδες mi²), από τα οποία τα 755.688 (περίπου 292 χιλιάδες mi²) είναι στη Ασία σε νότο-δύση και τα 23.764 (περίπου 9 χιλιάδες mi²) βρίσκονται στην ευρωπαϊκή ήπειρο." },
        { "cell": "units", "text": "Ορισμένες φωτογραφικές μηχανές μεσαίου μεγέθους φιλμ χρησιμοποιούν μια μορφή 6 επί 6 cm, και μάλιστα 56 επί 56 mm αρνητικό." },
        { "cell": "ranges", "text": "Στην τελική βαθμολογία σηειώθηκε νική με διαφορά ενός πόντου, 21-20, η οποία έδωσε ένα τέλος στις 15 διαδοχικές νίκες των Όλ Μπλακς." },
        { "cell": "ranges", "text": "Η διακοπή του ύπνου είναι η διαδικασία κατά την οποία ξυπνάτε συνειδητά κατά τη διάρκεια του κανονικού διαστήματος που διαρκεί ο ύπνος σας και κοιμάστε ξανά έπειτα από λίγο (10-60 λεπτά)." },
        { "cell": "ranges", "text": "Ο Ντελ Πότρο αρχικά προηγήθηκε στο δεύτερο σετ, όμως και πάλι απαιτούνταν τάι μπρέικ έπειτα από το 6-6." },
        { "cell": "ranges", "text": "Το χάνγκουλ είναι το μόνο αλφάβητο που επινοήθηκε σκόπιμα και χρησιμοποιείται ευρέως σε καθημερινή βάση. Το αλφάβητο επινοήθηκε το 1444 κατά τη διάρκεια της βασιλείας του βασιλιά Σέτζονγκ. (1418-1450)." },
        { "cell": "currency", "text": "Το CafeNet El Sol διαθέτει υπηρεσία κρατήσεων με χρέωση 30 $ ή 10 $ για μονοήμερα εισιτήρια. Περισσότερες πληροφορίες στη σελίδα του Corcovodo." },
        { "cell": "abbrev", "text": "Εκατόν οχτώ πιάτα Chhappan Bhog (στην ινδουιστική παράδοση, πενήντα έξι ξεχωριστά τρόφιμα, όπως ζαχαρώδη, φρούτα, ξηροκάρπια, εδέσματα κ.λπ. τα οποία δίνονται στους θεούς) υπάρχουν στον Baba Shyam." },
        { "cell": "abbrev", "text": "Τα σπίτια και τα ρούχα μας είναι φτιαγμένα από φυτά. Τα φαγητά που τρώμε στην πλειονότητά τους είναι φυτά. Χωρίς τα φυτά, η επιβίωση των ζώων θα ήταν αδύνατη." },
        { "cell": "abbrev", "text": "Οι ξύλινοι σύνδεσμοι ραγών εμφανίστηκαν αρκετά νωρίς και σκοπό είχαν να κρατούν τις σιδηροδρομικές ράγες στη θέση τους. Σταδιακά όμως, φάνηκε ότι οι ράγες θα ήταν πολύ πιο λειτουργικές με ένα σιδερένιο στήριγμα στην κορυφή." },
        { "cell": "abbrev", "text": "Καθ' όλη τη δεκαετία του 1960, ο Μπρεζίνσκι ήταν σύξμβουλος του Τζον Φ. Κένεντι και στη συνέχεια δούλεψε για την διοιίκηση του Λύντον Μπ. Τζόνσον." },
        { "cell": "latin-in-native", "text": "Οι περισσότερες περιοχές εξυπηρετούνται από μικρά ιαπωνικά λεωφορεία τύπου Coaster, τα οποία χαρακτηρίζονται από την άνεση και την ανθεκτικότητά τους." },
        { "cell": "latin-in-native", "text": "Σε αρκετές περιπτώσεις η εγγραφή σε μάθημα gap-year στο εξωτερικό μπορεί να αυξήσει τις πιθανότητες να προχωρήσετε σε ανώτερη εκπαίδευση στη χώρα σας." },
        { "cell": "latin-in-native", "text": "Το σκι αποτελεί μια σημαντική ταξιδιωτική δραστηριότητα με πολλούς λάτρεις, που συχνά αποκαλούνται ski bums, να σχεδιάζουν ολόκληρες διακοπές για σκι σε μια συγκεκριμένη τοποθεσία." },
        { "cell": "latin-in-native", "text": "Το NHK δήλωσε επίσης ότι ο πυρηνικός σταθμός ηλεκτρικής ενέργειας Κασιβαζάκι-Καρίβα στον νομό Νιιγκάτα λειτουργούσε κανονικά." },
        { "cell": "percent", "text": "Περιλαμβάνουν οικονομικούς περιορισμούς και εμπάργκο από την Ευρωπαϊκή Ένωση στην εξαγωγή αργού πετρελαίου, η οποία αποτελεί και το 80% των εσόδων από το εξωτερικό που λαμβάνει η ιρανική κυβέρνηση." },
        { "cell": "percent", "text": "Οι ανεμοστρόβιλοι εκριζώνουν δέντρα, αποσπούν σανίδες από κτίρια και σηκώνουν αυτοκίνητα στον αέρα. Το σφοδρότερο 2% των ανεμοστρόβιλων διαρκεί πάνω από τρεις ώρες." },
        { "cell": "percent", "text": "Ο πρώην κυβερνήτης της Μασαχουσέτης, Μιτ Ρόμνεϊ, κέρδισε την Τρίτη τις εκλογές του ρεπουμπλικανικού κόμματος της Φλόριντα με περισσότερο του 46% των ψήφων." },
        { "cell": "percent", "text": "Το 34% όσων πήραν μέρος στη δημοσκόπηση συμφωνούσαν με αυτή την ιδέα, διότι θέλουν η βασίλισσα Ελισάβετ Β΄να είναι ο τελευταίος μονάρχης της Αυστραλίας." },
        { "cell": "rate", "text": "Οι ταχύτητες των 802,11 n είναι ουσιωδώς μεγαλύτερες από ό,τι των προκατόχων τους με ανώτατη θεωρητική απόδοση 600 Mbit/δευτερόλεπτο." },
        { "cell": "rate", "text": "Ο τυφώνας Φρεντ αυτή την ώρα έχει ανέμους ταχύτητας 105 μιλίων την ώρα (165 χλμ / ώρα) και κινείται προς τα βορειοδυτικά." },
        { "cell": "rate", "text": "Τα αναρτημένα όρια ταχύτητας είναι εμφανώς μικρότερα από ό,τι σε προηγούμενα και επόμενα τμήματα –συνήθως 35-40 μίλια/ώρα (56-64 χιλιόμετρα/ώρα) και είναι ακόμη σημαντικότερο να υπακούμε αυστηρά σε αυτά." },
        { "cell": "rate", "text": "Παράγουν ισχυρούς ανέμους (συχνά 100-200 μιλίων/ώρα) και μπορούν να σηκώσουν βαριά αντικείμενα στον αέρα και να τα μεταφέρουν ενώ κινείται ο κυκλώνας." },
        { "cell": "initialism", "text": "Ο πρόεδρος των ΗΠΑ, Τζορτζ Ουόκερ Μπους, επικρότησε την ανακοίνωση." },
        { "cell": "initialism", "text": "Ακόμη, ο ΟΗΕ ελπίζει να οριστικοποιήσει τη χρηματοδότηση για τη βοήθεια προς τις χώρες που πλήττονται από την υπερθέρμανση του πλανήτη ώστε να αντιμετωπίσουν τις συνέπειες." },
        { "cell": "initialism", "text": "Το Εθνικό Πάρκο Κρούγκερ (KNP) είναι στο βορειο και ανατολικό τμήμα της Νοτίου Αφρικής και βρίσκεται στη γραμμή των συνόρων της Μοζαμβίκης στο ανατολικό σημείο, της Ζιμπάμπουε στο βόρειο σημέιο, ενώ νότιο σύνορό του θεωρείται το ποτάμι Κροκόδειλος." },
        { "cell": "initialism", "text": "Πολλές συνηθισμένες μορφές (η κατηγορία μορφών APS, για παράδειγμα) είναι ίσες ή προσεγγίζουν στενά αυτές τις αναλογίες εικόνας." },
        { "cell": "grouped", "text": "Από το 1966 το Σούντορμπον αποτελεί ένα καταφύγιο άγριων ζώων, και υπολογίζεται πως υπάρχουν σήμερα στην περιοχή 400 τίγρεις της Βεγγάλης και γύρω στα 30.000 στικτά ελάφια." },
        { "cell": "grouped", "text": "Οι κατσίκες εξημερώθηκαν μάλλον για πρώτη φορά στα Όρη Ζάγκρος του Ιράν πριν 10.000 χρόνια." },
        { "cell": "grouped", "text": "Εντούτοις, τα σχέδια αυτά έπαψαν να είναι ωφέλημα μέσα σε ένα βράδυ σχεδόν, όταν περισσότεροι από 800.000 στρατιώτες του Κόκκινου Στρατού της Σοβιετικής Ένωσης εισήρθαν και δημιούργησαν το μέτωπο της Λευκορωσίας και το μέτωπο της Ουκρανίας, αφού εισέβαλαν στα ανατολικά εδάφη της Πολωνίας παραβιάζοντας τη Συνθήκη Ειρήνης της Ρίγας, το Σύμφωνο μη επίθεσης μεταξύ της Σοβιετικής Ένωσης και της Πολωνίας και άλλες διεθνείς συνθήκες, τόσο διμερείς όσο και πολυμερείς." },
        { "cell": "grouped", "text": "Δημιούργησε περισσότερα από 1.000 γραμματόσημα για τη Σουηδία, καθώς και για άλλες 28 χώρες." },
        { "cell": "negative", "text": "Ο ναός Πνομ Κρομ –12 χιλιόμετρα νοτιοδυτικά του Σιέμ Ριπ– που βρίσκεται στην κορυφή του λόφου χτίστηκε προς το τέλος του 9ου αιώνα, την περίοδο της βασιλείας του Γιασοβαρμάν." },
        { "cell": "letter-name", "text": "Ο Arly Velasquez από το Μεξικό τερμάτισε δέκατος πέμπτος στο Super-G του παραολυμπιακού αλπικού (sit) σκι αντρών. Ο Adam Hall από τη Νέα Ζηλανδία τερμάτισε ένατος στο παραολυμπιακό αλπικό (standing) σκι αντρών." },
        { "cell": "letter-name", "text": "H Μεγάλη Πυραμίδα της Γκίζας αποτελεί το μόνο από τα επτά θαύματα που εξακολουθεί να υπάρχει σήμερα." },
        { "cell": "letter-name", "text": "Το επίπεδο του pH καθορίζεται από την ποσότητα ιόντων υδρογόνου (το H στο pH) της εξεταζόμενης χημικής ουσίας." },
        { "cell": "letter-name", "text": "Στην Κροατία και τη Δανία, υπάρχουν ύποπτα κρούσματα του ιού H5N1 δεν έχουν επιβεβαιωθεί ακόμη." },
        { "cell": "ampersand", "text": "Στο κυριότερο μέρος, τα B&B ανταγωνίζονται ξεκάθαρα σε δύο βασικά θέματα: στις παροχές του δωματίου και το πρωινό." }
