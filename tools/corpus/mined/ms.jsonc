    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Penumpang diberikan air sambil mereka menunggu di bawah suhu panas 90°F." },
        { "cell": "degrees", "text": "Fred adalah siklon tropika paling kuat yang pernah direkod setakat ini di bahagian selatan dan timur Atlantik sejak kewujudan pengimejan satelit, dan hanya merupakan taufan ketiga terbesar yang direkodkan sebelah timur 35°W." },
        { "cell": "digit-run", "text": "Sebagai anggota NSA, beliau telah membantu Carter mengurus urusan sedunia dengan diplomatik, seperti Perjanjian Camp David, 1978, membiasakan hubungan AS-Cina sepanjang tahun 1970-an, Revolusi Iran yang menyebabkan krisis tawanan Iran, 1979, dan Penyerangan Soviet di Afghanistan, 1979." },
        { "cell": "digit-run", "text": "Setem ke-1,000nya adalah setem “Great Deeds by Swedish Kings” yang mengagumkan oleh David Klöcker Ehrenstrahl pada tahun 2000, yang disenaraikan dalam Guinness Book of World Records." },
        { "cell": "digit-run", "text": "Dari 1,400 orang yang diundi sebelum pilihan raya persekutuan 2010, mereka yang menentang Australia menjadi republik meningkat sebanyak 8 peratus sejak 2008." },
        { "cell": "digit-run", "text": "Orang Portugis memusnahkannya dan membinanya semula dengan nama Casa Branca, hanya untuk membiarkanya selepas gempa bumi berlaku pada 1755." },
        { "cell": "digit-run", "text": "Bahagian utara atau Sentinel Range mempunyai gunung tertinggi di Antartika, Vinson Massif, memuncak setinggi 4892m Gunung Vinson." },
        { "cell": "clock", "text": "Skor akhir adalah kemenangan dengan satu mata, 21:20, yang mengakhiri 15 kemenangan berturut-turut All Blacks." },
        { "cell": "clock", "text": "Bas bertolak dari stesen bas dalam daerah (di seberang sungai) sepanjang hari, walaupun kebanyakannya terutama yang berhala ke timur dan Jakar/Bumthang bertolak antara pukul 06.30 dan 07.30." },
        { "cell": "clock", "text": "Ini akan membolehkannya menjadi serasi secara terbalik dengan 802.11a, 802.11b dan 802.11g, dengan syarat bahawa stesen asas mempunyai dwi radio." },
        { "cell": "clock", "text": "Krew penyelamat kebakaran sebenarnya memadamkan api pada 11:35 pm." },
        { "cell": "clock", "text": "Antara 10: 00-11: 00 pm MDT, api telah dimulakan oleh penghuni di kawasan itu." },
        { "cell": "signs", "text": "Rang undang-undang tersebut menghendaki permainan video yang ganas yang dijual di negeri California dilabelkan dengan decal yang bertulis “18” dan menjadikan penjualan kepada individu di bawah umur boleh dikenakan denda $1000 setiap kesalahan." },
        { "cell": "signs", "text": "Sebuah up bow<i> </i>biasanya menghasilkan bunyi yang lembut sementara down-bow menghasilkan bunyi yang lebih kuat dan asertif." },
        { "cell": "signs", "text": "Sebenarnya, kod wilayah tidak mempunyai impak sama sekali pada cetak rompak, sebuah salinan cakera bit by bit<i> </i>bermain seperti biasa dalam sebarang peranti di mana cakera asli dapat dimainkan." },
        { "cell": "signs", "text": "Turki Eropah (Thrace timur atau Rumelia di semenanjung Balkan) membentuk 3% dari negara tersebut." },
        { "cell": "signs", "text": "Sekitar pukul 11:00 waktu tempatan (UTC +1) tunjuk perasaan berlaku di Whitehall bertentangan pintu masuk yang dikawal polis ke Downing Street, kediaman rasmi Perdana Menteri." },
        { "cell": "dotted", "text": "Perbelanjaan perang imperialisme A.S. untuk menakluk Filipina telah dibayar oleh rakyat Filipina sendiri." },
        { "cell": "dotted", "text": "Presiden A.S. George W. Bush mengalu-alukan pengumuman itu dengan baik." },
        { "cell": "dotted", "text": "Syarikat Jurutera A.S. menganggarkan bahawa 6 inci daripada hujan boleh melanggar benteng yang sebelumnya rosak." },
        { "cell": "dotted", "text": "Program ini bermula pada 8:30 p.m. waktu tempatan (15.00 UTC)." },
        { "cell": "dotted", "text": "A.S. mengatakan bahawa mereka telah menerima maklumat daripada sumber yang tidak didedahkan yang secara khusus telah menyatakan penggunaan pengebom berani mati untuk meletupkan “mercu tanda terkenal” di Ethiopia dan Kenya." },
        { "cell": "era-marker", "text": "Pada pukul 1.15 a.m. hari Sabtu, menurut saksi, bas tersebut sedang melintasi lampu hijau apabila kereta itu membelok di depannya." },
        { "cell": "era-marker", "text": "Satu gempa bumi sederhana telah menggegarkan Montana Barat pada pukul 10.08 p.m. pada hari Isnin." },
        { "cell": "year", "text": "Sebagai contoh, “pembelajaran” dan “pemasyarakatan” dicadangkan sebagai motivasi penting untuk penggunaan Internet (James et al, 1995)." },
        { "cell": "year", "text": "Lama-kelamaan, roda kayu diganti dengan roda besi. Pada tahun 1767, landasan besi sepenuhnya yang pertama dilancarkan." },
        { "cell": "year", "text": "Pada 15 Ogos 1940, Pihak Berikat menyerang Perancis selatan, serangan ini dipanggil “Operation Dragoon”." },
        { "cell": "year", "text": "Semenjak penubuhan Asuncion dalam 1537, Paraguay telah berjaya menyimpan watak dan identiti orang aslinya." },
        { "cell": "year", "text": "Semenjak tahun 1988, peti undi perlu lutsinar supaya pengundi dan pemerhati dapat menyaksikan bahwa tidak ada sampul pada awal pengundian dan tidak ada sampul yang dimasukkan kecuali kepunyaan pengundi yang dihitung dan yang diberi kuasa." },
        { "cell": "decimals", "text": "Taman tersebut meliputi 19,500km² dan terbahagi kepada 14 ekozon yang berbeza-beza dengan setiap satu menanggung hidupan liar yang lain." },
        { "cell": "decimals", "text": "Di seluruh Amerika Syarikat, terdapat sekitar 400,000 kes Sklerosis Berbilang (MS) yang diketahui, yang membuatkannya menjadi penyakit neurologikal paling banyak pada dewasa muda dan pertengahan umur." },
        { "cell": "decimals", "text": "Jepun mengandungi hampir 7,000 pulau (yang terbesar ialah Honshu), yang menjadikan Jepun sebagai pulau yang ke-7 terbesar di dunia!" },
        { "cell": "decimals", "text": "Standard 802.11n beroperasi pada kedua-dua frekuensi 2.4Ghz dan 5.0Ghz." },
        { "cell": "decimals", "text": "Tiada amaran tsunami telah dikeluarkan dan menurut agensi geofizik Jakarta, tiada amaran tsunami akan dikeluarkan kerana gempa bumi tidak memenuhi syarat magnitud 6.5." },
        { "cell": "ordinal-latin", "text": "Penduduk Vatican City adalah sekitar 800. Ia adalah negara bebas yang paling kecil di dunia dan negara dengan penduduk yang paling rendah." },
        { "cell": "ordinal-latin", "text": "Agensi pelancongan telah bertapak sejak abad ke-19. Ejen pelancongan biasanya merupakan pilihan yang baik untuk perjalanan yang melangkaui pengalaman terdahulu pelancong ke tempat semula jadi, budaya, bahasa atau negara-negara berpendapatan rendah." },
        { "cell": "ordinal-latin", "text": "Mangsa adalah Nicholas Alden, 25 dan Zachary Cuddeback, 21. Cuddeback telah merupakan pemandu." },
        { "cell": "ordinal-latin", "text": "Paralimpik akan berlangsung dari 24hb Ogos hingga 5hb September 2021. Sebilangan acara akan diadakan di lokasi lain di seluruh Jepun." },
        { "cell": "units", "text": "Sundarbans merupakan hutan paya bakau litoral yang terbesar di dunia dengan keluasan 80 km (50 batu) yang bermula dari pesisiran pantai hingga jauh ke pedalaman Bangladesh dan India." },
        { "cell": "units", "text": "Krusta mempunyai ketebalan 70 km pada sisi dekat dan 100 km pada sisi jauh." },
        { "cell": "units", "text": "Sebagai contoh, imej yang paling biasa dalam format fortografi di dunia ilh 35mm, yang bersamaan dengan saiz dominan filem pada hujung era filem analog." },
        { "cell": "units", "text": "Kepulauan itu terbentang 120 km utara di Semenanjung. Pulau yang terbesar adalah King George Island dengan penempatan Villa Las Estrellas." },
        { "cell": "units", "text": "Pendalaman Antartika adalah dataran tinggi ditutupi oleh 2-3 km ais." },
        { "cell": "ranges", "text": "Del Potro mempunyai kelebihan pada set kedua, tetapi ini juga memerlukan putaran seri selepas mencapai 6-6." },
        { "cell": "ranges", "text": "Gangguan tidur ialah proses bangun secara sengaja selama tempoh tidur normal anda dan tertidur sekejap (10-60 minit)." },
        { "cell": "ranges", "text": "Sesuatu kursus biasanya akan berlangsung selama 2-5 hari dan akan melibatkan permainan peranan, pertolongan cemas yang banyak dan kadangkala latihan senjata." },
        { "cell": "ranges", "text": "Dia mendapat 2 gol dan 2 bantuan dalam kemenangan Washington 5-3 semasa menewas Atlanta Thrashers." },
        { "cell": "ranges", "text": "Pada 1895, selepas kekalahan dalam Perang China-Jepun (1894-1895), Kerajaan Qing menandatangani Perjanjian Shimonoseki, di mana ia menyerahkan kuasa ke atas Taiwan kepada Jepun, yang memerintah pulau itu sehingga tahun 1945." },
        { "cell": "currency", "text": "Adalah dijangka tiket peristiwa sebahagian besar akan berharga di antara ¥2,500 dan ¥130,000, dengan biasa tiket berharga sekitar ¥7,000." },
        { "cell": "currency", "text": "Batten menduduki tempat ke-190 dalam senarai 400 Orang Paling Kaya Di Amerika Tahun 2008 dengan anggaran kekayaan $2.3 bilion." },
        { "cell": "currency", "text": "Jesus yang berusia 21 tahun daripada kelab Brazil Palmeiras telah menyertai Manchester City pada Januari 2017 dengan bayaran yang dilaporkan berjumlah £ 27 juta." },
        { "cell": "currency", "text": "CafeNet El Sol menawarkan perkhidmatan tempahan dengan yuran sebanyak US$30, atau $10 untuk pas harian, butiran terdapat di laman Corcovado." },
        { "cell": "currency", "text": "Namun Perdana Menteri, John Howard telah berkata bahawa tindakan itu hanya untuk melindungi kemudahan hospital daripada diturun taraf oleh kerajaan Tasmania, dengan memberikan tambahan berjumlah $45 juta AUD." },
        { "cell": "abbrev", "text": "Pemain ski lelaki yang cacat penglihatan dari Poland, Maciej Krezel dan pemandunya Anna Ogarzynska menduduki tempat ketiga belas di Super-G. Jong Seork Park dari Korea Selatan menduduki tempat kedua puluh empat dalam acara duduk Super-G lelaki." },
        { "cell": "abbrev", "text": "108 pinggan Chhappan Bhog (dalam agama Hindu, 56 item berbeza yang boleh dimakan, seperti manisan, buah, kekacang, juadah dsb. yang dipersembahkan kepada dewa) dihidangkan kepada Baba Shyam." },
        { "cell": "abbrev", "text": "Saya kehilangan kakak dan rakannya, dan dalam perjalanan terdapat dua orang kurang upaya denga kerusi roda. Orang hanya melompat ke atas dan menolak mereka, kata “Armand Versace”." },
        { "cell": "abbrev", "text": "Arly Velasquez Mexico menamatkan dengan kedudukan lelaki yang kelima belas di Super-G. Adam Hall dari New Zealand menamatkan dengan kedudukan kesembilan di Super-G." },
        { "cell": "abbrev", "text": "Teknologi menawarkan penyelesaian dengan lawatan maya. Pelajar dapat melihat artifak muzium, mengunjungi akuarium atau mengagumi seni yang indah sambil duduk di bilik darjah." },
        { "cell": "latin-in-native", "text": "Polis mengatakan bahawa mayat itu telah berada di sana selama satu hari." },
        { "cell": "latin-in-native", "text": "Kualiti yang menentukan cabang kebudayaan yang berbeza mungkin adalah linguistik, estetika, agama, politik seksual, geografi atau gabungan faktor." },
        { "cell": "latin-in-native", "text": "Dari masa ke masa, sebagai penduduk baru yang bermula untuk menyesuaikan diri dengan persekitaran yang baru, mereka mula kelihatan kurang dan kurang seperti penduduk lain." },
        { "cell": "latin-in-native", "text": "Seorang bekas anggota polis Filipina telah menjadikan para pelancong Hong Kong sebagai tebusan dengan merampas bas mereka di Manila, ibu negara Filipina." },
        { "cell": "latin-in-native", "text": "Berbaloi mengambil masa setengah jam untuk bersiar-siar keliling kampung yang menarik." },
        { "cell": "percent", "text": "Oleh kerana pautan kabel gentian optik bawah laut yang bersambung ke Eropah dan siaran satelit jalur lebar, Greenland terhubung baik dengan 93% dari populasi mempunyai akses Internet." },
        { "cell": "percent", "text": "Nadal mendapat 88% mata bersih dalam perlawanan yang menang 76 mata dalam perkhidmatan pertama." },
        { "cell": "percent", "text": "Ia termasuk kekangan kewangan dan larangan oleh Kesatuan Eropah ke atas eksport minyak mentah, yang menyumbang 80% daripada pendapatan asing kepada ekonomi Iran." },
        { "cell": "rate", "text": "En Reid berjaya memandu kereta A1GP New Zealand, Black Beauty pada kelajuan melebihi 160km/j tujuh kali di atas jambatan." },
        { "cell": "rate", "text": "Kelajuan 802.11n jauh lebih cepat daripada model sebelum ini dengan daya pemprosesan teori maksimum 600Mbit/s." },
        { "cell": "rate", "text": "Menurut pihak berkuasa taman tersebut, kekalkan jarak 100 ela/meter daripada beruang dan serigala dan 25 ela/meter daripada semua binatang liar yang lain!" },
        { "cell": "rate", "text": "Mereka menjana angin kencang (sering 100-200 batu/jam) dan boleh mengangkat objek berat ke udara, membawa mereka sebagai bergerak puting beliung." },
        { "cell": "rate", "text": "Taufan Fred kini mempunyai kelajuan angin 105 batu sejam (165 km/j) dan bergerak ke arah barat laut." },
        { "cell": "roman", "text": "Semasa perjuangan untuk kemerdekaan yang dianjurkan oleh Pergerakan Mau,perhimpunan damai di bandar telah menyebabkan pembunuhan ketua terpenting Tupua Tamasese Lealofi III." },
        { "cell": "roman", "text": "Kapal selam digunakan dalam Perang Dunia I dan Perang Dunia II. Pada ketika itu mereka amat perlahan dan jarak tembak adalah sangat terhad." },
        { "cell": "roman", "text": "34 peratus daripada mereka dalam tinjauan ini berpendapat, inginkan Ratu Elizabeth II menjadi raja terakhir Australia." },
        { "cell": "roman", "text": "Pemangku Perdana Menteri Julia Gillard mendakwa sewaktu kempen pilihan raya 2010 bahawa beliau percaya Australia harus menjadi republik pada akhir pemerintahan Ratu Elizabeth II." },
        { "cell": "initialism", "text": "Israel menuntut kehadiran tentera yang berterusan di lembah selama sepuluh tahun selepas perjanjian ditandatangani sementara PA bersetuju kepada kehadiran tentera untuk hanya selama lima tahun." },
        { "cell": "initialism", "text": "Sebelum ini, CEO Ring, Jamie Siminoff, mengatakan syarikat itu bermula apabila loceng pintu beliau tidak dapat didengar dari kedai dalam garajnya." },
        { "cell": "initialism", "text": "Banyak format biasa (contohnya format dari keluarga APS) adalah sama atau hampir sama dengan nisbah aspek ini." },
        { "cell": "initialism", "text": "Taman Nasional Kruger (NKP) terletak di timur laut Afrika Selatan dan di sepanjang sempadan Mozambique di bahagian timur, Zimbabwe di bahagian utara dan sempadan selatan ialah Sungai Buaya." },
        { "cell": "initialism", "text": "Ia ialah CEP kelima Martelly dalam tempoh empat tahun." },
        { "cell": "grouped", "text": "Sejak tahun 1966 Sundarbans merupakan tempat perlindungan hidupan liar dan kini dianggarkan sebanyak 400 ekor harimau Royal Bengal dan 30,000 ekor rusa berbintik hidup di kawasan itu." },
        { "cell": "grouped", "text": "Walau bagaimanapun, peratusan XDR-TB dalam kesemua kumpulan penghidap tuberkulosis masih rendah; 6,000 dari kesemua 330,000 orang yang terjejas di dalam pada satu-satu masa Afrika Selatan." },
        { "cell": "grouped", "text": "Kambing nampaknya telah pertama kali dijinakkan kira-kira 10,000 tahun dahulu di Pergunungan Zagros di Iran." },
        { "cell": "grouped", "text": "Apia adalah ibu negara Samoa. Bandar ini terletak di pulau Upolu dengan populasi yang kurang daripada 40,000." },
        { "cell": "grouped", "text": "Namun, rancangan-rancangan ini menjadi usang dalam semalan, selepas 800,000 tentera daripada Tentera Merah Kesatuan Soviet masuk dan mewujudkan barisan Belarus dan Ukraine selepas menyerang kawasan timur Poland dengan melanggar Perjanjian Damai Riga, Perjanjian Berkecuali Soviet-Poland, dan lain-lain perjanjian antarabangsa, dua hala dan pelbagai hala." },
        { "cell": "signed-number", "text": "Zaman di mana peristiwa berlaku biasnya dikenali sebagai Zaman Pertengahan Tinggi tempoh sejarah Eropah dalam abad ke 11, 12 dan 13 (AD 1000 -1300)" },
        { "cell": "letter-name", "text": "Sultan Moroccan membina kembali bandar seperti Daru I-Badya dan memberi nama Casablanca oleh pedagang Spanish yang menstabilkan berasas perniagaan di situ." },
        { "cell": "letter-name", "text": "Tahap pH ditunjukkan oleh jumlah ion Hidrogen (huruf H dalam pH) dalam bahan kimia yang diuji." },
        { "cell": "letter-name", "text": "Sukan popular termasuk bola sepak, bola keranjang, bola tampar, polo air, lawan pedang, ragbi, berbasikal, hoki ais, hoki kasut roda dan perlumbaan motor F1." },
        { "cell": "letter-name", "text": "Ia juga menyerang apapun yang memasuki air, malah seekor dinosaur yang raksasa seperti T. rex pun tidak akan dapat bertanding dengannya." },
        { "cell": "letter-name", "text": "Dr. Malar Balasubramanian, 29, ditemui di Blue Ash, Ohio, pinggir bandar kira-kira 15 batu ke utara Cincinnati berbaring di atas tanah di tepi jalan berbaju T-shirt dan seluar dalam dengan keadaan yang mempunyai banyak ubat." },
        { "cell": "exponent", "text": "Sundarbans meliputi kawasan 3,850 km²,<sup> </sup>di mana satu pertiga diliputi oleh air/kawasan paya." },
        { "cell": "ampersand", "text": "Beliau lulus dari sekolah tinggi Seni &amp; Sains University of Virginia pada 1950 dan merupakan penyumbang penting institusi tersebut." },
        { "cell": "ampersand", "text": "Syarikat penerbangan seperti Emirates, Etihad Airways, Qatar Airways &amp; Turkish Airlines telah mengembangkan perkhidmatan mereka ke Afrika, dan menyediakan sambungan penerbangan ke banyak bandar-bandar besar di Afrika dengan harga yang berpatutan berbanding dengan syarikat penerbangan Eropah yang lain." },
        { "cell": "ampersand", "text": "Pada skala mewah, B&B dengan jelas bertanding atas dua perkara, tempat tidur dan sarapan." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Polis mengatakan bahawa mayat itu telah berada di sana selama satu hari.",
        "Beribu-ribu tahun dahulu, seorang lelaki bernama Aristarchus berkata bahawa Sistem Suria bergerak mengelilingi Matahari.",
        "Ia ialah CEP kelima Martelly dalam tempoh empat tahun.",
        "Hari Natal merupakan salah satu perayaaan yang paling penting dalam agama Kristian dan dirayakan sebagai hari jadi Yesus.",
        "Penyelidik dari Princeton University di Amerika Syarikat dan Uppsala University di Sweden melaporkan spesies baharu itu telah berevolusi selepas hanya dua generasi, walaupun proses ini dipercayai mengambil masa yang lebih lama, kerana pembiakan antara seekor burung finch endemik di Darwin, fortes Geospiza, dan burung finch kaktus imigran, Geospiza conirostris.",
        "Kerja yang dilakukan kebanyakannya secara teori, namun program tersebut ditulis untuk mensimulasi pemerhatian yang dibuat ke atas galaksi Sagittarius.",
        "Sukan popular termasuk bola sepak, bola keranjang, bola tampar, polo air, lawan pedang, ragbi, berbasikal, hoki ais, hoki kasut roda dan perlumbaan motor F1.",
        "Blog juga dapat membantu meningkatkan penulisan pelajar. Walaupun pelajar sering memulakan pengalaman blog mereka dengan kesalahan tatabahasa dan ejaan, kehadiran penonton secara amnya dapat mengubahnya.",
        "Pejabat pengurusan kecemasan Marianas Utara mengatakan bahawa tiada kerosakan dilaporkan di negara tersebut.",
        "Penduduk Paris terkenal dengan reputasi egosentrik, biadap dan sombong.",
