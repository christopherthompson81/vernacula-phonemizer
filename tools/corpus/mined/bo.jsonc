        { "cell": "degrees", "text": "བོད་རྒྱལ་ཁབ་ཆེན་པོ་ 《 Tibet Autonomous Region 》《 [ 西藏自治区] 》 ནི་ཀྲུང་གོའི་ལྷོ་ནུབ་ཀྱི་མཐའ་མཚམས་ཁུལ་དུ་ཡོད་ཅིང་། འཕྲེད་ཐིག་བྱང་མ་ 26°50’ ནས་ 36°53′ བར་དང་། ཤར་ཀྱི་གཞུང་ཐིག་ 78°25′ ནས་ 99°06′ བར་དུ་གནས་ཡོད་ཅིང་། རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་ངོས་སྙོམས་གྲུ་བཞི་མ་ས་ཡ་གཅིག་དང་འབུམ་གཉིས་ལྷག་ཙམ་ཡོད་པ་དེས་ཀྲུང་གོའི་སྤྱིའི་རྒྱ་ཁྱོན་གྱི་བརྒྱད་ཆ་གཅིག་ཟིན་གྱི་ཡོད། བོད་ལྗོངས་ཀྱི་བྱང་ངོས་ནི་ཤིན་ཅང་དང་མཚོ་སྔོན་བོད་རིགས་ས་ཁུལ་དང་འབྲེལ་ཡོད་པ་དང་། ཤར་ཕྱོགས་སི་ཁྲོན་དང་། ཡུན་ནན་ལ་འབྲེལ་ཡོད་ཅིང་། ལྷོ་ནུབ་གཉིས་འབར་མ་དང་། རྒྱ་གར། འབྲས་ལྗོངས། འབྲུག་ཡུལ། བལ་ཡུལ། ཀ་ཤི་སྨིར།མོན། ལ་དྭགས་སོགས་དང་འབྲེལ་ཡོད་པ་དང་། རྒྱལ་མཚམས་ས་ཐིག་གི་རིང་ཚད་ལ་སྤྱི་ལེ་4000 ཙམ་ལ་ཉེ་བས་ཕྱི་ཕྱོགས་ལ་སྒོ་མོ་འབྱེད་རྒྱུར་ཆ་རྐྱེན་བཟང་པོ་ཡོད།" },
        { "cell": "degrees", "text": "ཞི་པོའོ་ལི་ཡ་འཁྱགས་ཀློང་ནི་ནུབ་ཝོ་ལར་རི་རྒྱུད་དང་ཤར་པེ་ལིན་མཚོ་འགག ནུབ་འཁྱགས་རོམ་རྒྱ་མཚོ་བྱང་མ། ལྷོ་ཀྲུང་གོ་དང་ཕྱི་སོག་སོགས་ཀྱི་འབྲེལ་མཚམས་སུ་གནས་ཤིང་། གནས་འདིར་སྐམ་སའི་རང་བཞིན་གྱི་ཁྱད་ཆོས་མངོན་པར་གསལ་བས་གྲང་ངར་ཆེ་ཞིང་ཆར་ཆུ་ཉུང་། འཁྱགས་ཀློང་འདིའི་དགུན་ཁའི་ཆེས་དམའ་བའི་ཏུའུ་གྲངས-67℃ཡིན་ཞིང་གཏིང་རིམ་དུ་ཕུན་སུམ་ཚོགས་པའི་གཏེར་རྫས་མང་པོ་ཡོད་པ་དང་གནའ་བོའི་སྲོག་ཆགས་ཀྱི་བེམ་རོ་ཆ་ཚང་མང་པོའང་རྙེད་མུས་སུ་མཆིས།" },
        { "cell": "degrees", "text": "སྤྱི་ལོ་ ༢༠༠༦ ལོར་རྒྱལ་ཁབ་ཀྱི་ས་གཤིས་དང་ནགས་ཚལ་སྤྱི་གླིང་དུ་བདམས་པ་ཡིན་ལ། མཚོ་སྔོན་ཞིང་ཆེན་གྱི་དབུས་འགྱུར་ཟི་ལིང་གྲོང་ཁྱེར་ནས་སྤྱི་ལེ་ ༡༣༡ ལྷག་ཡོད་ལ། གཅན་ཚ་རྫོང་ཐོག་ནས་སྤྱི་ལེ་ ༥༠ ཙམ་ཡོད། རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ ༡༥༢ དང་། ཆ་སྙོམས་རྒྱ་མཚོ་ངོས་ལས་མཐོ་ཚད་སྨི་ ༢༥༠༠ དང་ཆེས་མཐོ་ས་སྨི་ ༣༡༠༠ དང་ཆེས་དམའ་ས་སྨི་ ༢༣༠༠ ཡོད། ལོ་རེའི་ཆ་སྙོམས་དྲོད་ཚད་ ༢༠℃ ཙམ་ཡོད།" },
        { "cell": "degrees", "text": "ལོ་འཁོར་ཆ་སྙོམ་ཚ་གྲང་གི་ཚད་ནི་ 3.4℃ ཡིན་ཞིང་ཚ་ཤོས་ 27℃ དམའ་ཤོས་ཀླད་ཀོར་འོག་གི -25℃ ཡིན་པ་དང་། ས་འཁྱགས་པའི་གཏིང་ཚད་མཐོ་ཤོས་ལ་སོར་ 111 cm. ཡིན།" },
        { "cell": "degrees", "text": "གཞུང་ལམ་ཨང་ 317 པའི་ཕྱོགས་གཡས་གཡོན་གཉིས་ཀར་རང་བྱུང་ཆུ་ཚན་ཆེ་ཆུང་བཅུ་གྲངས་ཡོད་ཅིང་ཆུའི་དྲོད་ཚད་ 38 ནས་ 50 ℃ བར་ཡིན། ཚུ་ཚན་དེ་དག་ཏུ་ཉལ་ན་ལྤགས་ནད་དང་གྲང་བ་སོགས་ལ་ཧ་ཅང་ཕན།" },
        { "cell": "degrees", "text": "ཉིང་ཁྲི་གྲོང་ཁྱེར་ནི་བོད་རང་སྐྱོང་ལྗོངས་གྲོང་ཁྱེར་ལྷ་སའི་ཤར་ལྷོའི་ཕྱོགས་སྤྱི་ལེ་407མཚམས་ཏེ། ཆུ་བོ་ཡར་ཀླུང་གཙང་པོ་རྒྱུག་ཁུལ་གྱི་སྨད་རྒྱུད་དུ་གནས་ཡོད་པ་དང་། ཧ་ལམ་སའི་གོ་ལའི་བྱང་གི་འཕྲེད་ཐིག26°52′ནས30°40′དང་ཤར་གྱི་གཞུང་ཐིག92°09′ནས8°47′མཚམས་ན་ཡོད། གྲོང་ཁྱེར་མི་དམངས་སྲིད་གཞུང་གི་གནས་ཡུལ་ནི་བྲག་ཡིབ་ཆུས་སུ་ཡིན། ཉིང་ཁྲི་གྲོང་ཁྱེར་ས་ཁོངས་ཀྱི་ཤར་ནུབ་རིང་ཚད་ལ་སྤྱི་ལེ647དང་། ལྷོ་བྱང་གི་ཞེང་ཚད་ལ་སྤྱི་ལེ353ཙམ་ཡོད་པ་དེའི་སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་ངོས་སྙོམས་གྲུ་བཞི་མ་ཁྲི11.7ཡོད་རུང་དོན་དངོས་ཚོད་འཛིན་བྱེད་མུས་ཡིན་པའི་ས་ཁོངས་ཀྱི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་ངོས་སྙོམས་གྲུ་བཞི་མ་ཁྲི7.6ཡིན། མཐའ་མཚམས་ཁོ་ནའི་རིང་ཚད་ལ་སྤྱི་ལེ1000ཙམ་ཡོད། ཉིང་ཁྲི་གྲོང་ཁྱེར་གྱི་གནས་ཡུལ་བྲག་ཡིབ་ཆུས་ལ་རྒྱ་མཚོའི་ངོས་ལས་མཐོ་ཚད་རྨིད2986ཡོད་པ་དེའི་ཤར་ངོས་ན་སྤོ་བོ་རྫོང་དང་། ཤར་ལྷོའི་ཕྱོགས་སུ་མེ་ཏོག་རྫོང་དང་རྫ་ཡུལ་རྫོང་། ལྷོ་ངོས་སུ་སྨན་གླིང་རྫོང་།ལྷོ་ནུབ་ཏུ་སྣང་རྫོང་། ནུབ་ངོས་སུ་ཀོང་པོ་རྒྱ་མདའ་རྫོང་བཅས་ཡོད།" },
        { "cell": "degrees", "text": "ཉིང་ཁྲི་གྲོང་ཁྱེར་དུ་ལོ་འཁོར་མོའི་ཆ་སྙོམས་དྲོད་ཚད7℃ནས16℃བར་ཡིན་པ་དང་། ལོ་ཧྲིལ་པོའི་ཆར་ཆུ་འབབ་ཚད་ཁྱོན་ཧོའོ་རྨིད650ཡས་མས་ཟིན་གྱི་ཡོད། སྤྱི་ལོ1981ལོར《མདོ་དབུས་མཐོ་སྒང་གི་གནམ་གཤིས་ཁུལ་དབྱེ་བ》ཞེས་པའི་ནང་འཁོད་པ་ལྟར་ན། ཉིང་ཁྲི་གྲོང་ཁྱེར་ནི་ཤར་ལྷོའི་ཚ་ཁུལ་དང་ཕྱེད་ཚ་ཁུལ་གྱི་རི་མ་ཐང་གི་བརླན་གཤེར་ཅན་གྱི་ཁུལ་དུ་གནས་ཡོད།" },
        { "cell": "degrees", "text": "ཡུལ་ཤུལ་བོད་རིགས་རང་སྐྱོང་ཁུལ་ནི་མཚོ་སྔོན་ཞིང་ཆེན་གྱི་མི་རིགས་རང་སྐྱོང་ཁུལ་དང་པོ་དང་རྒྱལ་ཡོངས་ཀྱི་གཉིས་པར་བགྲངས་པ་ཡིན་ལ། དེ་ནི་མཚོ་སྔོན་ཞིང་ཆེན་གྱི་མདོ་དབུས་མཐོ་སྒང་གི་ལྟེ་བ་རྨ་འབྲི་རྫ་གསུམ་གྱི་འགོ་ཁུངས་སུ་ཡོད་ཅིང་། ཆ་སྙོམས་ཀྱི་མཚོ་འཕགས་ནི་སྨི42000ཡན་ཡིན། དེ་ཡང་ཤར་གྱི་གཞུང་ཐིག89°27′～97°39′དང་བྱང་གི་འཕྲེད་ཐིག31°45′～36°10′བར་དུ་གནས་ཏེ། ཁུལ་ཡོངས་ཀྱི་ཤར་ནུབ་ཀྱི་རིང་ཚད་ལ་སྤྱི་ལེ738ཡོད་པ་དང་། ལྷོ་བྱང་གི་ཞེང་ལ་སྤྱི་ལེ406ཡོད་པ་ཡིན། ཡང་ཁུལ་ཡོངས་ཀྱི་སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ267000ཡོད་པ་དང་། མཚོ་སྔོན་ཞིང་ཆེན་གྱི་སྤྱིའི་རྒྱ་ཁྱོན་གྱི37.2% ཟིན་ཡོད། གཞན་མངའ་ཁོངས་ལ་གྲོང་ཁྱེར1དང་རྫོང5 གྲོང་རྡལ10 ཡུལ་ཚོ35 སྡེ་བ257བཅས་ཡོད། ཡུལ་ཤུལ་ཁུལ་ནི་སྤྱི་ལོ1951ལོའི་ཟླ12པར་བཙུགས་པ་ཡིན་ཏེ། རྒྱལ་ཡོངས་ཀྱི་མི་རིགས་གྲངས་ཉུང་གི་རང་སྐྱོང་ཁུལ་ཁྲོད་ཀྱི་མི་རིགས་གཙོ་བོའི་སྡུར་ཚད་ཆེས་མཐོ་བ་དང་། མཚོ་འཕགས་ཆེས་མཐོ་བ། ཆ་སྙོམས་ཀྱི་མི་གྲངས་ཆེས་མང་བ། སྐྱེ་ཁམས་གནས་ཡུལ་གལ་འགངས་ཆེ་བའི་རང་སྐྱོང་ཁུལ་ཞིག་ཡིན་ལ། འབྲི་ཆུ་དང་རྨ་ཆུ། རྫ་ཆུ་བཅས་གཙང་བོ་ཆེན་པོ་གསུམ་གྱི་འགོ་ཁུངས་ཡིན་ཞིང་། རྨ་འབྲི་རྫ་གསུམ་རང་བྱུང་སྲུང་སྐྱོབ་ས་ཁུལ་དང་ཨ་ཆེན་གངས་རྒྱབ་རང་བྱུང་སྲུང་སྐྱོབ་ས་ཁུལ་གཉིས་ཡོད།" },
        { "cell": "digit-run", "text": "རྗེ་བཙུན་མི་ལ་རས་པ། (1040 - 1123) ནི་ཡོངས་གྲགས་སུ་སྙན་ངག་མཁས་ཅན་དང་རྣལ་འབྱོར་བ་ཞིག་ཡིན། དྭགས་པོ་བཀའ་བརྒྱུད་པའི་བླ་མ་སྙན་གྲགས་ཅན་ཞིག་ཡིན་པར་མ་ཟད། མར་པ་ལོ་ཙཱ་བ་ཆོས་ཀྱི་བློ་གྲོས་ཀྱི་ཐུགས་སྲས་ཤིག་རེད། ཁོང་གིས་མགུར་མ་སྙན་པོ་མང་པོ་བཞེངས་ཡོད། ཐུགས་སྲས་གཙོ་བོ་ལ་ནི་དྭགས་པོ་ལྷ་རྗེ་དང་རྗེ་རས་ཆུང་པ་གཉིས་ཡོད་རེད།" },
        { "cell": "digit-run", "text": "གྲོང་ཁྱེར་ལྷ་ས་ནི། ལོ་ངོ་ཆིག་སྟོང་སུམ་བརྒྱ་ལྷག་གི་ལོ་རྒྱུས་ཡོད་པའི་བོད་ཀྱི་བཙན་པོའི་དུས་ཀྱི་གྲོང་ཁྱེར་ཞིག་ཡིན་པ་ལ། ད་ལྟའང་བོད་རང་སྐྱོང་ལྗོངས་ཀྱི་ལྟེ་བའི་གྲོང་ཁྱེར་ཞིག་ཡིན་པ་རེད། འདི་ནི་བོད་ཀྱི་ཆབ་སྲིད་དང་། དཔལ་འབྱོར། རིག་གནས་ཀྱི་ལྟེ་གནས་ཡིན། རྒྱལ་ཁབ་ཀྱི་ལོ་རྒྱུས་རིག་གནས་གྲོང་ཁྱེར་དང་རྒྱལ་སྤྱིའི་ཁྱད་ཆོས་ལྡན་པའི་ཡུལ་སྐོར་གྲོང་ཁྱེར་སྐད་གྲགས་ཅན་ཞིག་ཡིན། ད་ལྟ་གྲོང་ཁྱེར་འདིའི་སྤྱིའི་འཛུགས་སྐྲུན་གྱི་རྒྱ་ཁྱོན་ནི། སྤྱི་ལེ་ངོས་སྙོམས་ 50 ལྷག་ཙམ་དང་། མི་འབོར་ཁྲི་ 40 ལྷག་ཙམ། རྒྱ་མཚོའི་ངོས་མས་སྤྱི་ཁྲི 3650 ཙམ་གྱིས་མཐོ་བའི་ས་བབས་ཡིན་སྟབས་འཛམ་གླིང་ཐོག་ས་བབས་ཐོ་ཤོས་ཀྱི་གྲོང་ཁྱེར་ཞིག་ཡིན་ཞེས་ཟེར། མ་ཟད་མིང་གཞན་ལ་ཉི་འོད་གྲོང་ཁྱེར་ཡང་ཟེར། གནའ་གྲོང་ལྷ་ས་ནི་གཡུ་ལྟར་སྔོ་བའི་ལྷ་སའི་སྐྱིད་ཆུའི་འགྲམ་དུ་མཆིས། ཉེ་བའི་ལོ་ཤས་རིང་། རྒྱལ་ཁབ་ཕྱི་ནང་གི་ཡུལ་སྐོར་བ་དང་ས་ཁང་མ་འཇོག་པའི་ཚོང་པ་མང་པོ་ཞིག་སྤྲིན་གྱི་ཚོགས་བཞིན་གྲོང་ཁྱེར་འདིར་འདུས་ཤིང་། གནའ་གྲོང་ལྷ་ས་ལ་འཕེལ་རྒྱས་ཀྱི་གསོན་ཤུགས་གསར་བ་རྒྱས་བཞིན་ཡོད་པ་རེད། སྒོར་མོ་མེ་འཁོར་བབས་ཚུགས་ནས་སྤྱི་ལེ་ 1165 ཙམ། སི་ཁྲོན་ཁྲིན་ཏུའུ་གྲོང་ཁྱེར་ནས་སྤྱི་ལེ 2415 ཙམ་བཅས་སོ་སོ་ནས་ལམ་ཐག་དེ་ལྟ་བུ་ཕེབས་ན་གནའ་བོའི་གྲོང་ཁྱེར་འདིར་འབྱོར་གྱི་རེད།" },
        { "cell": "digit-run", "text": "༢ ར་ས་ཞེས་པ་ནི་ལྟ་སའི་མིང་རྙིང་ཞིག་དང་གཙུག་ལག་ཁང་གི་མིང་ཞིག་ཀྱང་ཡིན། དེ་ནི་མི་ལོ་ ༡༣༥༠ ལྷག་ཙམ་གྱི་གོང་བོད་ཀྱི་བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་སྐུ་དུས་སུ་གཙུག་ལག་ཁང་ཐོག་མར་བཞེངས་སྐབས། རྒྱ་བཟས་སྤོར་ཐང་གི་རྩིས་ལ་བརྟེན་ནས་ས་དཔྱད་བརྟགས་པ་ལྟར་ས་གནས་འོ་ཐང་གི་མཚོ་བསུབ་སྐབས་མཚོའི་དཀྱིལ་དུ་རྡོའི་མཆོད་རྟེན་བརྩིགས་པའི་སྟེང་དུ་ཕྱོགས་ བཞི་མཚམས་བརྒྱད་དུ་གདུང་མ་བསྣོལ་མར་བཏང་བའི་ཐོག་ཏུ་ར་དཀར་མོ་ཞིག་ལ་ས་རྡོ་བཀལ་ཏེ་མཚོ་བསུབས་པར་བརྟེན་མཚོ་བསུབས་ཤུལ་གྱི་སྐམ་ས་དེར་ར་ས་ཞེས་མིང་ཐོག་མར་ཐོགས་པ་དང་། མཚོ་བསུབས་ཏེ་གཙུག་ལག་ཁང་བཞེངས་རྗེས་ཐོག་མའི་མཚན་ལའང་ར་ས་སྤྲུལ་པའི་གཙུག་ལག་ཁང་ཞེས་གསོལ། དེ་རྗེས་གཙུག་ལག་ཁང་དེ་ཉིད་ལྟེ་བར་བྱས་ནས་ཆགས་པའི་གྲོང་ཁྱེར་གྱི་མིང་ལའང་ར་ས་ཞེས་རིམ་བཞིན་ཐོགས་པར་མངོན་ལ། ར་དཀར་མོ་དེ་ལྷི་ས་སྐྱིད་ཆུའི་ཕ་རོལ་གྱི་ལྷོ་ནུབ་ངོས་སུ་ཤེལ་དཀར་བྲག་ཁུང་ཞེས་པ་ཞིག་ཡོད་པ་ལས་བྱུང་སྟབས་ཡུལ་མིང་དུ་ར་མ་སྒང་ཞེས་ཐོགས་པ་ལྟར་ད་ལྟའང་དེ་ལྟར་འབོད་བཞིན་ཡོད།" },
        { "cell": "digit-run", "text": "ནམ་ཟླ་དུས་བཞིར་ཉི་འོད་འཕྲོ་ཤུགས་ཤིན་ཏུ་ཆེ་བ་དང་། ལོ་འཁོར་གཅིག་ནང་ཉི་འོད་འཕྲོད་ཚད་ཆུ་ཚོད་ ༣༠༠༠ ཙམ་ཟིན་གྱི་ཡོད། གྲོང་ཁྱེར་དེའི་ས་ནང་བབ་ཀྱི་མཐོ་ཚད་རྒྱ་མཚོའི་ངོས་ལས་སྤྱི་ཁྲི་ ༣༦༥༠ ཙམ་ཟིན་ཡོད་པ་དང་མཁའ་རླུང་ཤིན་ཏུ་གཙང་བ་མ་ཟད། དབྱར་དུས་ཆར་ཆུ་འབབ་ཚད་སྙོམ་པ། ལོ་རེའི་ཧོར་ཟླ་ ༧、༨、༩གསུམ་གྱི་ནང་ཆར་ཆུ་འབབ་ཚད་ཆ་སྙོམས་ལྟར་ན་ཧའོ་རྨིད་ ༤༥༠ ཙམ་དང་། ལོ་རེའི་ཆ་སྙོམས་དྲོད་ཚད་ནི་དྲོད་ཚད་ཨང་གྲངས་ ༨ ཡས་མས་ཡིན། དབྱར་དཀྱིལ་དྲོད་ཚད་མཐོ་ཤོས་ལ་དྲོད་ཚད་ཨང་གྲངས་ ༢༩ ཙམ་ཡོད།" },
        { "cell": "digit-run", "text": "དེའི་སྔོན་ཉི་མའི་གླིང་ཕྲན་ལ་ལྕིང་མའི་གླིང་ག་ཟེར་གྱི་ཡོད་པ་རེད། དེ་རུ་ལྗོན་ཤིང་སྣ་ཚོགས་དང་ཆུ་འགྲམ་གྱི་བྱེ་ཐང་། འཇམ་ཐིང་ཐིང་ངང་བཞུར་བཞིན་པའི་ལྷ་སའི་སྐྱིད་ཆུ་བཅས་ཡོད་རེད། ཟམ་པ་ཆུང་ཆུང་དེའི་མགོ་མཇུག་གཉིས་ཀར་བོད་ཀྱི་རླུང་རྟས་བརྒྱན་ཡོད། ས་གནས་མི་དམངས་ཀྱིས་ཀུ་རེའི་ཚུལ་དུ་ས་ཆ་དེར་རྐུན་མ་གླིང་ག་ཞེས་ཀྱང་བཏགས་ཡོད། དེ་ནི་རྐུན་མ་དག་སྦས་སྐུང་བྱེད་ས་ཡིན་པའི་ཆ་ནས་དེ་ལྟར་བརྗོད་པ་རེད། སྤྱི་ལོ་ ༡༩༩༤ ལོར་ལྷ་སར་གནས་སྡོད་རྒྱའི་རི་མོ་བ་ཆེས་གྲགས་ཅན་ཞིག་གི་ངོ་སྤྲོད་རྒྱབ་གཉེར་འོག་ཨོའོ་མིན་ནས་ཡིན་པའི་རྒྱ་སྐྱེད་པ་ཞིག་དང་ལྷ་སའི་སྲིད་གཞུང་གཉིས་མཉམ་འབྲེལ་ཐོག་བདག་མེད་ཡུལ་ལྗོངས་དེ་རྒྱན་རྩེད་ཁང་ཞིག་ལ་བསྒྱུར་པ་རེད། དེ་ནས་རྒྱ་ནག་གི་འབྱོར་ལྡན་མི་སྣ་ཞིག་གིས་དེ་ཚུར་བླངས་ཏེ་དེའི་ཚབ་ལ་ཀྲུང་ཧེ་རྒྱལ་སྤྱིའི་གྲོང་རྡལ་འཛུགས་སྐྲུན་བྱས་པ་རེད། ཉི་མའི་གླིང་ཕྲན་ལ་ཡུལ་ལུང་འདྲ་མིན་གྱི་ཟས་རིགས་ཀྱི་བྲོ་བ་ལྡན་པའི་ཟ་ཁང་མང་པོ་འདུག བོད་ཀྱི་འབྲོག་ཁྱི་བཙོང་སའི་ཚོང་ཁང་ཡང་ཡོད། ལྷ་ས་མི་རིགས་ཀྱི་རིག་གནས་སྒྱུ་རྩལ་འགྲེམས་སྟོན་ཁང་དང་ལྷ་སའི་སྲིད་གཞུང་གི་གྲོལ་རྡལ་ལས་ཁུངས་སོགས་ཡོད།" },
        { "cell": "digit-run", "text": "བོད་རང་སྐྱོང་ལྗོངས་ལྷ་ས་གྲོང་ཁྱེར་སྔོ་ཚལ་ལས་རིགས་ཀྱིས་ཚོང་རར་ཁ་ཕྱོགས་ནས་རོང་འབྲོག་པའི་ཡོང་སྒོ་ཇེ་མང་དུ་གཏོང་བ་དེ་དམིགས་ཡུལ་དུ་བཟུང་ནས། ཐོན་ཁུངས་ཀྱི་བཟང་ཆ་འདོན་སྤེལ་བྱས་ཏེ། དུས་ཚིགས་ལས་ལྡོག་པའི་སྔོ་ཚལ་དང་སྟོན་དཔྱིད་བར་གྱི་སྔོ་ཚལ་འདེབས་པར་ཤུགས་བསྣན་པས། ལྷ་སའི་སྔོ་ཚལ་ལས་རིགས་རིམ་བཞིན་ས་ཁུལ་ཅན་དང་། ཐོན་ལས་ཅན། ཁྱབ་ཁོངས་ཅན། དེང་རབས་ཅན་བཅས་ཀྱི་ཕྱོགས་སུ་གོང་འཕེལ་བྱུང་སྟེ། ཞིང་ལས་ལ་ཁེ་ཕན་ཐོབ་པ་དང་། ཞིང་བའི་ཡོང་སྒོ་འཕར་བ་མངོན་འགྱུར་བྱས། འཆར་གཞི་ལྟར་ན། 2015 ལོར་བསླེབ་དུས། ལྷ་ས་གྲོང་ཁྱེར་གྱི་སྔོ་ཚལ་འདེབས་འཛུགས་གཞི་ཁྱོན་མུའུ་ཁྲི 8.52 ལ་ཇེ་ཆེར་འགྲོ་རྒྱུ་ཡིན་ཞིང་ཐོན་ཚད་ཏུན་ཁྲི 35 ལ་བསླེབ་ངེས།" },
        { "cell": "digit-run", "text": "སྔོན་འཕགས་པའི་ཡུལ་དུ་སྟོན་པ་བཀའ་དྲིན་ཅན་གྱིས་ཆོ་འཕྲུལ་དུས་སྟོན་མཛད་པར་དྲན་གསོ་ཞུ་ཕྱིར་བོད་ཁ་བ་ཅན་གྱི་ཡུལ་དུ་རྒྱལ་བསྟན་ཉིན་མོར་བྱེད་པའི་དཔལ་མགོན་དམ་པ་ྋཤར་རྒྱལ་བ་ཙོང་ཁ་པ་མཆོག་གི་མཛད་ཆེན་བཞིར་གྲགས་པའི་ཡ་གྱལ་ལྷ་ལྡན་སྨོན་ལམ་ཆེན་མོ་འདི་བཞིན་སྤྱི་ལོ་ ༡༤༠༩ ལོར་གསར་འཛུགས་མཛད། དེ་ནས་བཟུང་སེ་འབྲས་དགའ་གསུམ་གྱིས་གཙོས་དགེ་འདུན་སྟོང་ཕྲག་མང་པོས་ལོ་ལྟར་བོད་ཟླ་དང་པོའི་ཚེས་འགོ་ནས་ཉིན་ཉེར་གཅིག་རིང་སྨོན་ལམ་གསུང་འདོན་གྱིས་མཚོན་ཆོས་ཕྱོགས་ཀྱི་མཛད་པ་སྣ་མང་སྤེལ་ཏེ་གངས་ཅན་རི་བོའི་ཁྲོད་དུ་ཕན་བདེའི་གཞི་མ་རྨད་དུ་བྱུང་བ་ཞིག་འཇོག་གནང་མཛད།" },
        { "cell": "digit-run", "text": "དེ་རྗེས་སྤྱི་ལོ་ ༡༤༩༨ ནས་ ༡༥༡༨ བར་མི་ལོ་ཉི་ཤུ་རིང་ལྷ་ལྡན་སྨོན་ལམ་ཆེན་མོར་བཀའ་བརྒྱུད་པ་དང་ས་སྐྱ་བ་སོགས་ལས་སེ་འབྲས་ཀྱི་དགེ་འདུན་ཞུགས་མི་ཆོག་པའི་གནས་སྟངས་བྱུང་ཞིང། ། སྤྱི་ལོ་ ༡༥༡༨ ལོར་ཕག་གྲུ་སྡེ་སྲིད་ངག་དབང་གྲགས་པས་སྲིད་དབང་བཟུང་པ་ནས་སྔར་ལྟར་ཆོ་འཕྲུལ་སྨོན་ལམ་ཆེན་མོ་དེ་སེ་འབྲས་དགའ་གསུམ་གྱི་དགེ་འདུན་རྣམས་ཀྱིས་གཙོ་སྐྱོང་གནང་ཡོད།" },
        { "cell": "fractions", "text": "བོད་ཀྱི་རྒྱལ་ས་ནི་ལྷ་ས་ཡིན་ལ།ལྷ་ས་ནི་འཛམ་གླིང་ནང་ས་བབ་མཐོ་ཤོས་སུ་ཆགས་པའི་རྒྱལ་སའམ་གྲོང་ཁྱེར་ཞིག་ཡིན་པའི་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད་ལ། དེ་ནི་བོད ་ཀྱི་གྲོང་ཁྱེར་ཆེ་ཤོས་ཀྱང་ཡིན། དེ་བཞིན་བོད་ཀྱི་གྲོ ང་ཁྱེར་ཆེ་ཤོས་ཨང་གཉིས་པ་ནི་གཞིས་ཀ་རྩེ་གྲོང་ཁྱེར་ཡིན།བོད་གཞུང་དགའ་ལྡན་ཕོ་བྲ ང་གི་ སྲི ད་དབང་དང་འཛིན་སྐྱོང་གི་མངའ་ཁོངས་སུ་དབུས་གཙང་དང་།མདོ་སྟོད།མདོ་སྨད་བཅས་བོད་ཀྱི་ས་ཁྱོན་ཡོངས་ རྫོགས་གཏོགས་པ་དང་།དེའི་སྤྱིའི་ས་ཁྱོན་ལ་ཀི་ལོ་མི་ཊར་གྲུ་བཞི་མ་ས་ཡ2.5ཡོད།དེ་ནི་ཧྥ་རན་སེའི་ས་ཁྱོན་དང་བསྡུར་ན་ལྡབ་བཞིས་ཆེ་བ་དང།འཇར་པན་གྱི་ས་ཁྱོན་དང་བསྡུར་ ན་ལྡབ་བརྒྱད་ཀྱིས་ཆེ་བ་ཡོད།བོད་ས་ཡོངས་ཀྱིས་ཡུ་རོབ་སྤྱིའི་ས་ཁྱོན་གྱི་1/4 ལྷག་ཟིན་གྱི་ཡོད།བོད་ ཁྱོན་ཡོ ངས་ ལ་མི་འབོར་ས་ཡ་6ལྷག་ལས་མེད།དེར་བརྟེན་བོད་ནི་མི་འབོར་ཉུང་ལ་ས་ཁྱོན་ཆེ་བའི་རྒྱལ་ཁབ་ཅིག་ཡིན་པའང་ངང་གིས་རྟོགས་ཐུབ་པ་ཞིག་རེད།་་་་་་་" },
        { "cell": "fractions", "text": "དཔལ་འབར་རྫོང་ནས། བོད་ཤར་ཕྱོགས་ཆབ་མདོ་ས་ཁུལ་མངའ་ཁོངས་སུ་ཡོད་ཅིང་། མཐོ་ཚད་རྒྱ་མཚོའི་ངོས། རྨིད་༣༥༠༠/༣༦༠༠ ཙམ་ཡོད། སྤྱིར་ས་མ་འབྲོག་ལས། ཞིང་པ་ཤས་ཆེ་ཙམ་ཡིན། མཛེས་སྡུག་ལྡན་པའི་ཡུལ་ལྗོངས་མང་པོ་ཡོད་པ་ལས། དཔེར་ན། ཕུ་ཡུལ་ཤང་དུ་རིགས་གསུམ་མགོན་པོའི་བླ་མཚོ་གསུམ་ཡོད་པ་ལས། མཚོ་དཀར་པོ་སྤྱན་རས་གཟིགས་ཀྱི་བླ་མཚོ། སེར་པོ་འཇམ་དཔལ་དབྱངས་ཀྱི་བླ་མཚོ། ནག་པོ་ཕྱག་ན་རྡོ་རྗེའི་བླ་མཚོ་ཞེས། ངོ་མཚར་ཅན་གྱི་མཚོ་གསུམ་ཡོད་པ་དེ། ལོ་རྒྱུས་ཐོག་ཆུ་ལ་རང་བྱུང་གི་ཚོན་ཁྲ་ཡོད་པའི་མཚོ་དེ། རྒྱལ་སྤྱིའི་ཐོག་ཨང་དང་པོ་དེ་ཡིན། གཞན་ཡང་རྔོད་པ་ཤང་ཞེས་པ་དེ། གང་བ་ཕུག་མོ་ཞེས་པའི་དབྱར་དགུན་དུས་བཞིར། ལོ་ངོ་སྟོང་ཕྲག་དུ་མའི་གངས་རྒན་དེ་དག་དཀར་ཞིང་བརྗིད་ལ་མཐོ་ཞིང་རྔམས། གངས་འདབས་ན་སྔོ་ལྗང་ཅན་གྱིས་སྤངས་ལྗོངས་དང་ནག་ཚལ་མཛེས་ཤིང་ཉམས་དགའ་བ་དེ་དག། དངོས་སུ་སླེབ་ན་མ་གཏོག་བཤད་ན་ཡིད་ཆེས་དཀའ་བའི་མཛེས་ལྗོངས་ཤིན་ཏུ་མང་པོ་ཡོད། དཔལ་འབར་རྫོང་ཁོང་ཆེས་མཛེས་སྡུག་ལྡན་པའི་ཡུལ་ལྗོངས་སུའི་སི་ལི་གཉིས་པ་ཞེས་པ་དེ་ས་སྟེང་ཤང་དུ་ཡོད་པ་དང་། རྒྱལ་སྤྱིའི་ཐོག་ཆེས་སྙན་གྲགས་ལྡན་པའི་མཁས་མཛང་གཉིས་ལྡན་ཤར་སྤྲུལ་སྐུ་ཕྲེང་གསུམ་པ་དམ་ཆོས་རྒྱ་མཚོ་ཞེས་པ་དེ་འཁྲུངས་ཡུལ་ཡང་ས་སྟེང་ཤང་རྐེ་ཉིན་གྲོང་བྱིའུ་ཚང་ཞེས་པའི་མི་ཚང་དེ་དཔལ་འབར་རྫོང་ཁོང་དུ་ཡོད།། །།" },
        { "cell": "fractions", "text": "༡ཝ་ཐི། = ༡/༡ ༠༠༠ ༠༠༠ ས་ཡ་ཝ་ཐི།(MW) = ༡/༡༠༠༠སྟོང་ཝ་ཐི།(kW) = ༡ ༠༠༠ ༠༠༠ ཝའེ་ཝ་ཐི།(µW)" },
        { "cell": "fractions", "text": "(༣) དཔྱོད་ཤེས་རྒྱང་འབོད། ༢༠༠༡/༣/༢༧ ཟི་ལིང་དུ་བརྩམས། ༢༠༠༡/༧ཀན་སུའུ་མི་རིགས་དཔེ་བསྐྲུན་ཁང་ནས་དཔར་ཐེངས་དང་པོ་དཔར། ༢༠༠༨/༤དཔར་ཐེངས་བཞི་པ་དཔར།" },
        { "cell": "fractions", "text": "གནད་འདི་དག་ལ་ཞིབ་ཏུ་མ་བརྟག་པའམ་བློ་གྲོས་ཀྱིས་མ་ཁྱབ་པར་དེང་སང་དཔེ་རྙིང་མང་པོ་ཞིག་ལ་དུས་གསུམ་གྱི་རྣམ་པར་བཞག་སྟངས་རྟགས་འཇུག་གི་འགྲེལ་བཤད་རྣམས་སུ་དུས་གསུམ་གྱི་མཚན་གཞི་འམ་དཔེར་བརྗོད་གྲགས་ཆེ་བ་བཀོད་པ་རྣམས་ཁྱབ་མཐར་བཟུང་སྟེ། མོན་པའི་རྡོར་གཅོད་པར་མ་བཞིན་བྱས་འདུག་པ་ཡང་མང་དུ་སྣང་བ་ནི་བློ་གྲོས་དང་རྣམ་དཔྱོད་ཀྱི་སྨིན་དཀྱུས་ÍÞOa-¾ºÛ-འདབ་མ་ལྟར་དཀྱུས་རིང་བ་རྣམས་ཀྱིས་ཇི་ལྟ་བ་བཞིན་མཐོང་སྲིད་ཀྱི། གཞན་དག་གིས་ད་དུང་དུས་གསུམ་གྱི་རྣམ་གཞག་ཕྱོགས་རེ་བ་ལ་ཞེན་པའི་རྨོངས་གཉིད་ལས་མ་སད་བར་དུ་གསུང་རབ་ཀྱི་བརྗོད་བྱ་དང་རྗོད་བྱེད་ལ་ཡིན་ལུགས་ཚད་ལྡན་གྱི་གོ་བ་རང་རྐྱ་འཕེར་བ་ཞིག་རྙེད་མི་སྲིད་དོ།།" },
        { "cell": "fractions", "text": "མཁྱེན་དཔྱོད་ÍÞOa¾-མཐིང་གའི་སྤྱན་ཞགས་ཀྱིས།།" },
        { "cell": "fractions", "text": "༧ རིག་འཛིན་ངག་དབང་འཇམ་དཔལ།༡༨༨༦ ནས་༡༩༣༢/༡༩༣༥ བར་" },
        { "cell": "fractions", "text": "༢༠༠༨/༨/༢༦ ཉིན་གནམ་རྒྱལ་གསང་བ་ལྷ་རྩེའི་ཉེ་ཞོལ་ནས།" },
        { "cell": "clock", "text": "དཀར་མཛེས་བོད་རིགས་རང་སྐྱོང་ཁུལ། དེ་ནི་ཀྲུང་གོ་མི་དམངས་དང་སི་ཁྲོན་ཞིང་ཆེན་གྱི་མངའ་འོག་གི་རང་སྐྱོང་ཁུལ་ཞིག་ཡིན་པ་དང་། སི་ཁྲོན་ཞིང་ཆེན་གྱི་ནུབ་རྒྱུད་དུ་གནས་ཡོད། ཁུལ་གྱི་ས་མཚམས་ཨ་ཡུས་ཁུལ་དང་། ཡ་ཨན་གྲོང་ཁྱེར། ནན་དབྱི་ཧྲན་ཀྲོའུ་དང་། ཡུན་ནན་ཞིང་ཆེན་ཏི་ཀྲི་ཀྲོའུ་དང་། ནུབ་ལྗོངས་བོད་རང་སྐྱོང་ཁྲེང་ཆབ་མདོ་གྲོང་ཁྱེར། ནུབ་བྱང་དུ་མཚོ་སྔོན་ཞིང་ཆེན་ཡུས་ཀྲོའུ་དང་བྱང་མཚོ་སྔོན་ཞིང་ཆེན་མགོ་ལོག་ཀྲོའུ་དང་འབྲེལ་ཡོད། ས་ཡི་ས་ཡི་མཚོ་བོད་མཐོ་སྒང་གི་ལྷོ་ངོས་དང་། ས་མཐོ། ས་མཐོ། སི་ཁྲོན་གཤོངས་ས། སི་ཁྲོན་ནུབ་མཐོ་སྒང་གི་རི་མཐོའི་གྲོག་རོང་། བྱང་ཕྱོགས་ཀྱི་ཏ་པ་ལ་རི་བོའི་ཡན་ལག དབུས་སུ་བྱེ་མའི་རི་དང་། གངས་རིའི་རི་བོ། ནུབ་རྒྱུད་ཀྱི་འབྲི་ཆུ་དང་། མཚོ་སྔོན། བོད་ལྗོངས། ལྷོ་རྒྱུད་བཅས་ཞིང་ཆེན་གསུམ་གྱི་ས་མཚམས་ཀྱི་ཆུ་བོ། དབུས་ཀྱི་ཡར་ཀླུང་གཙང་པོའི་བྱང་ངོས་ནས་ལྷོ་ངོས་སུ་ཀྲོའུ་ཡི་མངའ་ཁོངས་སུ་འབབ་ཀྱིན་ཡོད། ཁུལ་ཡོངས་ཀྱི་ངོས་སུ་སྤྱི་ལེ་ངོས་གྲུ་14.97ཡོད་པ་རེད། སི་ཁྲོན་ཞིང་ཆེན་གྱི་ངོས་སུ་ཆེས་ཆེ་བའི་སྒོ་ནས་སྲིད་འཛིན་བྱེད་པ། མི་འབོར། 116.49ཡོད། དེའི་ནང་བོད་རིགས་མི་འབོར་གྱིས་78.3%བཟུང་བ་དང་། རང་སྐྱོང་ཁུལ་གྱི་ལྟེ་བའི་གྲོང་ཁྱེར་ཡན་ཁང་ཏིང་གྲོང་ཁྱེར་དུ་སྐྱོད་ཡོད། དཀར་མཛེས་ཞིང་ཆེན་ཡོངས་ཀྱི་ཕྱུགས་འཚོ་ས་གཙོ་བོ། རྩྭ་ཐང་གི་ངོས་ཀྱིས་བཅུ་ཆ་དྲུག་བཟུང་བ་དང་། རང་བྱུང་མཛེས་ལྗོངས་ལྟ་ན་སྡུག་པ་དང་།" },
        { "cell": "clock", "text": "བོད་ལྗོངས་ཀྱི་བུད་མེད་ནི་ལས་རིགས་ཁག་གི་གཙོ་ཤུགས་དམག་ཏུ་གྱུར་ཡོད་པ་དང་. དེ་ནི་བུད་མེད་ཀྱི་ལས་གནས་འཛོལ་བ་ཡིན །གནས་བབ་ཀྱང་མངོན་གསལ་དོད་པོས་མཐོ་རུ་སོང་ཡོད།བོད་ལྗོངས་ཡོངས་ཀྱི་ལས་ཁུངས་ནང་བོད་རིགས་བུད་མེད་ཀྱི་གཞུང་ཞབས་པས་གཞུང་ཞབས་པ་མི་གྲངས་ཡོངས་ཀྱི་བསྡུར་ཚད་བརྒྱ་ཆ37.99ཟིན་གྱི་ཡོད།ཆེད་ལས་ལག་རྩལ་འདྲ་མིན་གྱི་བོད་རིགས་བུད་མེད་ཀྱིས་བོད་ལྗོངས་ཡོངས་ཀྱི་ཆེད་ལས་ལག་རྩལ་མི་སྣ་ཁྱོན་ཡོངས་ཀྱི་བརྒྱ་ཆ43.77ཟིན་གྱི་ཡོད།བོད་ལྗོངས་ཀྱི་བོད་མིའི་ཚན་རྩལ་ལས་བྱེད་མི་སྣས་བོད་ལྗོངས་ཡོངས་ཀྱི་ཚན་རྩལ་ལས་བྱེད་མི་སྣ་ཁྱོན་ཡོངས་ཀྱི་བརྒྱ་ཆ42.58ཟིན་གྱི་ཡོད།" },
        { "cell": "clock", "text": "ཨེ་ཤ་ཡ་ནི་གླིང་ཕྲན་ཆེན་པོ་བདུན་གྱི་ནང་ནས། རྒྱ་ཁྱོན་ཆེས་ཆེ་ཤོས་དང་མི་འབོར་ཆེས་མང་ཤོས་དེ་ཡིན་པ་དང། ས་གཞི་རིལ་མོའི་ངོས་ཀྱི་རྒྱ་ཁྱོན་གྱི་༨.༧%ཟིན།(ཡང་ན་སྐམ་ས་ཡོངས་ཀྱི་རྒྱ་ཁྱོན་གྱི་༣༠%ཟིན།) མི་འབོར་གྲངས་ཚད་ཧ་ལམ་དུང་ཕྱུར་༤༠ཟིན་ཞིང་། ཧ་ལམ་འཛམ་གླིང་མི་འབོར་གྱི་༦༦.༦༧%ཟིན།ཆ་མི་ཚང་།" },
        { "cell": "clock", "text": "སྤྱི་ལོ༢༠༡༤ལོར་ཨོ་མན་ལ་མི་འབོར་ས་ཡ༤ལྷག་ཡོད་པ་དང་། དེའི་ཁྲོད་ཀྱི་ས་ཡ༢.༢༣ནི་ཨོ་མན་གྱི་རིགས་རྒྱུད་ཡིན་པ་དང་། ས་ཡ༡.༧༦ཡུལ་བྱོལ་པ་ཡིན། ཨོ་མན་གྱི་མི་འབོར་ལོ་ན་ཧ་ཅང་གཞོན་པའི་གྲས་ཡིན་ཏེ། གནས་སྡོད་པའི་བརྒྱ་ཆ༤༣ལྷག་ན་ཚོད༡༥ཡི་འོག་ཏུ་ཡོད། མི་འབོར་སྤྱིིའི་བརྒྱ་ཆ༥༠ཙམ་རྒྱལ་ས་མ་སི་ཁད་དང་རྒྱལ་སའི་ནུབ་བྱང་ཁུལ་གྱི་བྷ་དི་ནཱ་མཚོ་ངོགས་ཀྱི་བདེ་ཐང་དུ་འཚོ་སྡོད་བྱེད་ཀྱིན་ཡོད། ཨོ་མན་མི་རྒྱུད་ཀྱི་འབྱུང་ཁུངས་གཙོ་བོ་ནི་ཨ་རབ་དང་བྷ་ལུ་ཆོ་དང་ཧྤེ་གླིང་བཅས་ཀྱི་རིགས་རྒྱུད་ཡིན།" },
        { "cell": "clock", "text": "རྒྱ་གར། གཞུང་འབྲེལ་ཐོག་རྒྱ་གར་སྤྱི་མཐུན་རྒྱལ་ཁབ་(རྒྱ་གར་སྐད་དུ།: भारत गणराज्य) ཞེས་འབོད་པ་དང་། ལྷོ་ཨེ་ཤི་ཡའི་རྒྱལ་ཁབ། འཛམ་གླིང་གི་མི་འབོར་ཆེ་ཤོས་གཉིས་པ་ཡིན་པ་དང་། ས་རྒྱ་ཁྱོན་ཆ་ནས་འཛམ་གླིང་གི་ཨང་བདུན་པར་སླེབས་ཀྱི་ཡོད། མ་ཟད་དམངས་གཙོ་རྒྱལ་ཁབ་ཆེ་ཤོས་ཞིག་ཡིན། ཨེ་ཤི་ཡ་གླིང་ཆེན་འདིའི་ནང་ལོ་རྒྱུས་ཡུན་རིང་ལྡན་ཞིང་རིག་གནས་ཕུན་སུམ་ཚོགས་པའི་རྒྱལ་ཁབ་ཅིག་ཡིན། རྒྱ་གར་གྱི་སྐམ་ས་ཆེན་མོ་ནི་གོ་ལ་ཕྱེད་བྱང་མའི་ཕྱོགས་སུ་འཕྲེད་ཐིག་ 804’N ནས་ 3706’N ཡི་བར་དང་། གཞུང་ཐིག་ 6807’E ནས་ 97025’E ཡི་བར་དུ་ཆགས་ཡོད། རྒྱ་གར་གྱི་བྱང་ཕྱོགས་སུ་ཧི་མ་ལ་ཡའི་རི་རྒྱུད་དང་། ནུབ་ཕྱོགས་སུ་ཨ་རབ་རྒྱ་མཚོ། ཤར་ཕྱོགས་སུ་བངྒལ་གྱི་མཚོ་ཁུག ལྷོ་ཕྱོགས་སུ་རྒྱ་གར་རྒྱ་མཚོ་བཅས་ཀྱིས་བསྐོར་ཡོད། ཡུལ་འདིའི་ས་ཆའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ས་ཡ 3.28 ཡོད་པ་དང་། བྱང་གི་ཀཱསྨིར་མངའ་སྡེ་ནས་ལྷོ་ཡི་ཀཱན་ཡ་ཀཱུ་མ་རི་དབར་བར་ཐག་ཀི་ལོ་མི་ཊར་ 3,214 ཡོད། དེ་བཞིན་ཤར་གྱི་ཨ་རུ་ནཱ་ཅལ་མངའ་སྡེ་ནས་ནུབ་ཀྱི་གུཇ་རཱཏ་དབར་བར་ཐག་ཀི་ལོ་མི་ཊར་ 2,933 ཡོད། ས་ཆའི་ཆགས་སྟངས་ནི་དཔངས་མཐོ་བའི་རི་བོ་དང་རྒྱ་ཆེ་བའི་བྱེ་ཐང་། བྱང་ ཕྱོགས་གྱི་བདེ་ཐང་། ངོ་མཚར་ཆེ་བའི་མཐོ་སྒང། མཚོ་ཁ་དང་གླིང་ཕྲན་ སོགས་སྣ་མང་རང་བཞིན་གྱིས་གྲུབ་ཡོད། ས་ཁྱོན་ཆེ་བའི་རྒྱལ་ཁབ་འདིའི་གནམ་གཤིས་དང་རྩི་ཤིང་། སྲོག་ཆགས། རིག་གནས་སོགས་ནི་རྒྱལ་ཁབ་གཞན་དང་མི་འདྲ་བའི་ཁྱད་པར་ཆེན་པོ་ཡོད།" },
        { "cell": "clock", "text": "སི་ཁཱན་དྲི་ནཱ་བི་ཡའི(Scandinavian)རྒྱལ་ཁབ་རྣམས་ཀྱི་ཆེས་ཆུང་ཤོས་ཏེན་མག་ཡིན། ཏེན་མག་གི་ཁྱིམ་མཚེས་རྒྱལ་ཁབ་རྣམས་ནི། འཇར་མན(ལྷོ།) དང་སི་ཝེས་དན།(ཤར།) ནོར་ཝེ།(བྱང་།) དབྱིན་ཇི།(ནུབ།) བཅས་ཡིན། ཏེན་མག་གི་ཆ་ཤས་ཆེ་ཤོས་ཇུད་ལན་དྲི(Jutland)ཕྱེད་གླིང་ཕྲན་མ་གཏོགས། རྒྱལ་ཁབ་ཀྱི་མཐའ་ཚང་མ་རྒྱ་མཚོ་ཡིས་བསྐོར་ཡོད་པ་དང་། ས་སྟེང་དུ་འཇར་མན་དང་འབྲེལ་ནས་ཡོད། ཤར་ལྷོ་རུ་བྷལ་ཐྲིག་རྒྱ་མཚོ་དང་ནུབ་ཏུ་བྱང་རྒྱ་མཚོ། བྱང་དུ་སི་ཀཱ་གྷི་རག་རྒྱ་མཚོ། བྱང་ཤར་དུ་ཀཱ་དི་གྷེད་རྒྱ་མཚོ་བཅས་ཡོད། ཏེན་མག་གི་ནུབ་ཕྱོགས་ཆ་ཤས་ཇུད་ལན་དྲི་ཕྱེད་གླིང་ཕྲན་ཡིན་ལ། འཇར་མན་དང་ས་མཚམས་འབྲེལ་ནས་ཡོད། དེ་ནི་ཏེན་མག་གི་གླིང་ཕྲན་མིན་པའི་ཆ་ཤས་གཅིག་པུ་དེ་ཡིན། དེ་བྱིངས་ཀྱི་ཏེན་མག་ནང་མི་འཚོ་གནས་བྱེད་ཡོད་སའི་གླིང་ཕྲན༧༦དང་། གླིང་ཕྲན་ཆུང་ཆུང་མང་པོ་ཡོད། གླིང་ཕྲན་རྣམས་ལས་ཆེས་ཆེ་ཤོས་ནི(Zealand)ཙེ་ལན་དྲི་དང་ཧྥུ་ནན(Funen)ཡིན། ཤར་ཕྱོགས་སུ་བྷལ་ཐྲིག་རྒྱ་མཚོ་རུ་ཡོད་པའི་བྷོན་ཧོ་ལིམ(Bornholm)གླིང་ཕྲན་ཡོད། ཏེན་མག་རྒྱལ་ཁབ་གང་ལ་གང་འཚམས་ཁོད་སྙོམས་པོ་ཡོད། རི་བོ་ཆེས་མཐོ་ཤོས་ནི་མཱོ་ལི་ཧོ་ཇི(Møllehøj)ཡིན་པ་དང་། མཐོ་ཚད་ལ་སྤྱི་ཁྲུ༡༧༠.༨༦ཡོད། རི་བོ་ཆུང་ཆུང་དང་མཚོ། མཚོ་གླིང་། ནགས་ཚལ། ཞིང་ས་བཅས་མང་པོ་ཡོད། ཏེན་མག་གི་མཚོ་འགྲམ་རིང་ཚད་ལ་སྤྱི་ལེ༧༣༡༤ཡོད་པ་དང་། མཚོ་ངོགས་ལས་སྤྱི་ལེ༦༠ལྷག་གི་མཚམས་སུ་འཚོ་གནས་བྱེད་པའི་མི་གཅིག་ཀྱང་མེད།" },
        { "cell": "clock", "text": "ཨུ་རུ་སུ་མནའ་འབྲེལ་སྤྱི་མཐུན་རྒྱལ་ཁབ་སྟེ་བསྡུས་མིང་ལ་ཨུ་རུ་སུ་ཞེས་འབོད་པ་ནི་ཨེ་ཤ་ཡ་གླིང་དང་ཡོ་རོབ་གླིང་གི་བྱང་རྒྱུད་དུ་གནས་ཤིང་། སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི་1707.54ཡོད། ཨུ་རུ་སུ་ནི་ཨེ་ཤ་ཡ་དང་ཡོ་རོབ་གླིང་སྟེ་གླིང་ཆེན་གཉིས་བརྒལ་བའི་འཛམ་གླིང་གི་གཞི་ཁྱོན་ཆེས་ཆེ་བའི་རྒྱལ་ཁབ་ཅིག་ཡིན་ལ། ལོ་རྒྱུས་སྨྲ་བ་དག་གིས་ད་ལྟའི་ཨུ་རུ་སུའི་ཡབ་མེས་ནི་ཤར་མའི་སི་ལ་ཧྥུའུ་ཡི་མི་ཡིན་པར་བཞེད། མི་གྲངས་ཆེས་མང་ཞིང་དཔལ་འབྱོར་འཕེལ་རྒྱས་ཆེས་མགྱོགས་པའི་གྲོང་ཁྱེར་མང་པོ་ཞིག་ཝོ་ལར་རི་རྒྱུད་ནུབ་ཕྱོགས་ཀྱི་ཡོ་རོབ་གླིང་དུ་ཡོད་པས་ཀུན་གྱིས་གཅིག་མཐུན་གྱིས་ཡོ་རོབ་གླིང་གི་རྒྱལ་ཁབ་ཏུ་ངོས་འཛིན་བྱེད། ཨུ་རུ་སུའི་སྤྱིའི་ས་དབྱིབས་ནི་ནུབ་དམའ་ཞིང་ཤར་མཐོ་བ། གཙོ་བོ་ཡོ་རོབ་ཤར་རྒྱུད་ཀྱི་རྩྭ་ཐང་དང་ཝོ་ལར་རི་རྒྱུད། ཞི་པའོ་ལི་ཡའི་ཤར་མའི་བདེ་ཐང་། ཞི་པའོ་ལི་ཡ་བར་མའི་མཐོ་སྒང་། ཡ་པའོ་ལོ་ནོའོ་ཧྥུ་རི་རྒྱུད། ཆེར་སི་ཅི་རི་རྒྱུད་བཅས་ཀྱིས་གྲུབ། ཨུ་རུ་སིའི་ས་རྒྱ་ཆེ་ཞིང་རང་བྱུང་གཏེར་ཁུངས་ཕུན་སུམ་ཚོགས་པར་མ་ཟད། འཛམ་གླིང་སྟེང་གི་ནགས་ཚལ་ཁེབས་རྒྱ་ཆེས་ཆེ་བའི་རྒྱལ་ཁབ་ཅིག་ཡིན། རྒྱལ་ཁབ་འདིའི་བཟོ་ལས་འཕེལ་རྒྱས་ཀྱི་འགྲོས་མགྱོགས་ཤིང་འཐུས་ཚང་བའི་བཟོ་ལས་མ་ལག་གྲུབ་ཡོད་ལ། ས་བབ་དང་གནམ་གཤིས་ཀྱི་དབང་གིས་ལོ་རེའི་ཆར་འབབ་ཚད་ཉུང་ལ་ལྟོས་བཅས་ཀྱིས་ཞིང་ལས་འཕེལ་རྒྱས་ཀྱི་འགྲོས་དལ་བ་དང་ཞིང་ལས་ཐོན་རྫས་ཀྱི་མཁོ་འདོན་མི་འདང་པའི་གནས་ཚུལ་ཡོད།" },
        { "cell": "clock", "text": "པའེ་ཅར་མཚེའུ་ནི་ཨུ་རུ་སུའི་ཞི་པའོ་ལི་ཡའི་ལྷོ་རྒྱུད་དུ་གནས་ཤིང་དེ་ནི་འབྱོར་ཕྱུག་གི་མཚེའུ་ཞེས་པའི་དོན་དུ་འགྲེལ། མཚེའུ་འདི་ཟོར་དབྱིབས་སུ་མངོན་ཞིང་རྒྱ་ཁྱོན་ལ་ཧ་ལམ་སྨི་གྲུ་བཞི་མ་སྟོང་3.15ཡོད། མཚེའུ་འདི་ནི་སྐྱེས་དངོས་ཀྱི་བཤམས་སྟོན་ཁང་ཆེན་པོ་ཞིག་ཏུ་ངོས་འཛིན་བྱེད་པ་སྟེ། འཛམ་གླིང་གི་ས་ཆ་གཞན་ན་མེད་པའི་སྲོག་ཆགས་ཀྱི་རིགས་ཧ་ལམ་1800དང་སྐྱེས་དངོས་ཀྱི་རིགས་ཧ་ལམ་600ལྷག་འདུས་ཡོད། །" },
        { "cell": "signs", "text": "བོད་ལྗོངས་ནི་མི་འདུས་ཚད་ཆུང་ཤོས་ཀྱི་ཞིང་ཆེན་རིམ་པའི་རང་སྐྱོང་ལྗོངས་ཤིག་ཡིན་ཞིང་། ཆ་སྙོམས་སྤྱི་ལེ་ངོས་སྙོམས་གྲུ་བཞི་མ་རེའི་ཐོག་ཏུ་མི་གཉིས་ཡང་ཟིན་གྱི་མེད་། བོད་ལྗོངས་སུ་བོད་རིགས་ཀྱིས་ 96.4% དང་། རྒྱ་རིགས་ཀྱིས་ 2.8% མོན་པ་རིགས་དང་། ལྷོ་པ་རིགས་། ཧུའེ་རིགས་ འཇང་རིགས་སོགས་པའི་མི་རིགས་ཀྱིས་ 0.8% བཅས་ཟིན་གྱི་ཡོད་།" },
        { "cell": "signs", "text": "བོད་ལྗོངས་ནི་འཛམ་གླིང་སྟེང་གྱི་མཚོ་དང་མཚེའུ་མང་ཤོས་ཀྱི་ས་ཁུལ་ཞིག་ཡིན། བོད་ཡོངས་ཀྱི་མཚོ་དང་མཚོའུའི་རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ཉིས་ཁྲི་སུམ་སྟོང་བརྒྱད་ཡོད་པས་ཀྲུང་གོའི་རྒྱལ་ཡོངས་ཀྱི་མཚོ་དང་མཚོའུའི་རྒྱ་ཁྱོན་གྱི་༣༠%ཙམ་ཟིན། བསྡོམས་རྩིས་བྱས་པར་གཞིགས་ན་བོད་ཡོངས་ལ་མཚོ་དང་མཚོའུ་ཆེ་ཆུང་ཆིག་སྟོང་ལྔ་བརྒྱ་ལྷག་ཙམ་ཡོད་ཁོངས་ནས་རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་སྟོང་ཁ་བརྒལ་བའི་མཚོ་ཆེན་གནམ་མཚོ་ཕྱུག་མོ་དང་། སེར་གླིང་མཚོ། བཀྲ་རི་གནམ་མཚོ་བཅས་གསུམ་དང་། རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ལྔ་ནས་བཅུ་བར་ཟིན་པའི་མཚོ་ཁག་སུམ་བརྒྱ་ཉེར་གཅིག་བཅས་ཡོད།" },
        { "cell": "signs", "text": "གྲོང་ཁྱེར་གྱི་ལོ་རྒྱུས་ལ་ཁུངས་གཏུག་ན་མ་ལེ་སྐད་ཡིག་ནི་སིང་གྷ་ཕོར་གྱི་རྒྱལ་ཡོངས་སྐད་ཡིག་ཡིན་མོད། གང་ལྟར་མ་ལེ་སྐད་ཡིག་འབྲི་ཤེས་མཁན་དང་ཀློག་ཤེས་མཁན་ནི་བརྒྱ་ཆ་༢༠ལས་ཉུང་བ་ཡིན། ད་དུང་ཡང་སིང་གྷ་ཕོར་མ་ལེ་མི་མང་ཤོས་ཀྱིས་རང་ཁྱིམ་དུ་མ་ལེའི་སྐད་བེད་སྤྱོད་བྱེད་ཀྱིན་ཡོད། སིང་གྷ་ཕོར་གྱི་ནང་དུ་བེད་སྤྱོད་བྱེད་པའི་མ་ལེ་སྐད་ཡིག་(བྷ་ཧ་སཱ་མ་ལེ་ཡུའུ)ཧིན་ཉི་གི་མ་ལེ་སྐད་ཡིག་དང་བསྡུར་ན་མ་ལེ་ཞི་ཡའི་མ་ལེ་སྐད་ཡིག་དང་འདྲ་བའི་ཆ་མང་པོ་ཡོད། དེ་ལྟར་ཡིན་ཡང་མ་ལེ་ཞི་ཡའི་མ་ལེ་སྐད་ཡིག་དང་སིང་གྷ་ཕོར་གྱི་མ་ལེ་སྐད་ཡིག་གཉིས་ཀྱི་བར་ལའང་དབྱེ་བ་ཡོད། རྒྱལ་ཁབ་རྒྱལ་གླུ་ >མ་ལེ་སྐད་ནང་གཏོང་གིན་ཡོད།" },
        { "cell": "signs", "text": "Bhutan དེའི་རྒྱལ་ས་ནི་ཐིམ་ཕུ་རེད། བོད་གངས་ཅན་ལྗོངས་ཀྱི་ལྷོ་ཕྱོགས་སུ་གནས་ཡོད་པའི་ཆོས་ལྡན་འབྲུག་གི་རྒྱལ་ཁབ་ནི་ >པ་དང་། > >ཞེས་མི་རིགས་གཙོ་བོ་གསུམ་ལས་གྲུབ་པའི་རྒྱལ་ཁབ་ཅིག་དང་། མི་འབོར་ ༧༤༡་༨༢༢ ནང་བརྒྱ་ཆ་ ༩༠ ནང་པ་ཡིན། རྫོང་ཁག ༢༠ གྲོང་བརྡལ། ༢༠༥ ས་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ ༤༧་༠༠༠ ཡོད་པས་ས་བབ་མཐོ་ཤོས་རྒྱ་མཚོ་ངོས་ནས་གངས་ཆེན་ཀུ་ལ་གངས་རི་བར་བརྐྱངས་ཁྲུ་ ༢༤༧༨༠ དང་། དམའ་ཚད་རྒྱ་མཚོའི་ངོས་ནས་ལྷོ་ཕྱོགས་རྒྱ་ཐང་ཁུལ་བར་བརྐྱངས་ཁྲུ་ ༢༠༠ བཅས་ཀྱི་མཚམས་སུ་གནས་ཡོད།" },
        { "cell": "signs", "text": "འབྲུག་རྒྱལ་ཁབ་ཀྱི་གཞུང་འབྲེལ་སྐད་ཡིག་ནི་རྫོང་ཁ་ >ཡིན་ཞིང་ཤུགས་ཆེ་བ་བོད་ཀྱི་བརྡ་རྙིང་ཡིན།" },
        { "cell": "signs", "text": "སྤྱི་ལོ་༡༩༥༠ལོའི་བར་དུ་བལ་བོ་ནི་སོ་ནམ་གྱི་རྒྱལ་ཁབ་ཅིག་ཡིན་ལ། ༡༩༥༡ལོ་ནས་བཟུང་དུས་རབས་ཀྱིས་བལ་བོ་བསྒྱུར་ནས་འཕེལ་རྒྱས་ཆེན་པོ་ཕྱིན་ཡོད། བལ་བོའི་ས་ཁུལ་བརྒྱ་ཆ་༢༠%ཙམ་སོ་ནམ་གྱི་ས་གཞི་དང་། བརྒྱ་ཆ་༣༣%ཙམ་ནགས་ཚལ། གཞན་ས་ཁུལ་ཕལ་ཆེ་བ་རི་རྒྱུད་ཡིན། བལ་བོའི་སྟོན་ཐོག་གཙོ་བོ་ནི་གྲོ་འབྲས་གཉིས་ཡིན་འདུག སྤྱིར་བལ་བོའི་ཚོང་འབྲེལ་ཆེ་ཤོས་ཀྱི་རྒྱལ་ཁབ་ནི་ཀྲུང་གོ་དང་རྒྱ་གར་གཉིས་ཡིན་ལ། ཀྲུང་གོ་ནི་བལ་བོར་ཕྱིར་ཚོང་བ་ཆེ་ཤོས་གཉིས་པ་དེ་ཡིན། ཀྲུང་གོས་བལ་བོ་ནས་ཉོ་བ་ཅི་ཡང་མེད། རྒྱ་གར་ནི་བལ་བོའི་ཅ་དངོས་ཉོ་མཁན་ཆེ་ཤོས་དེ་ཆགས་ཡོད།" },
        { "cell": "signs", "text": "ཨབ་གྷན་ནི་ཁ་ཆེའི་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཅིག་ཡིན་ལ། རྒྱལ་ཁབ་དེའི་མི་འབོར་བརྒྱ་ཆ༩༩.༧%ཙམ་གྱིས་ཁ་ཆེའི་ཆོས་ལུགས་པ་ཡིན། ཨབ་གྷན་གྱི་མི་འབོར་བརྒྱ་ཆ༩༠ཙམ་གྱིས(Sunni Islam)སོ་ནི་ཁ་ཆེའི་རྗེས་འབྲང་བ། ལྷག་མ་རྣམས་ཁ་ཆེའི་ཆོས་ལུགས་བྱེ་བྲག་པ་སཱ་སི་ཁ་ཆེ(Shias)རྗེས་འབྲང་བ་ཡིན་འདུག ད་དུང་གྲངས་ཉུང་མི་རིགས་ཉུང་ངུ་ཞིག་ཧིན་དྷུ་དང་སི་ཁི་ཆོས་ལུགས་ཀྱི་རྗེས་འབྲང་བ་ཡང་ཡོད་འདུག" },
        { "cell": "signs", "text": "རྒྱལ་ཁབ་ཀྱི་ས་ཁྱོན། ཀི་ལོ་མི་ཏྲར་གྲུ་བཞི་མ་83.878ཡིན། མི་འབོར།8.872.865, ཀི་ལོ་མི་ཏྲར་གྲུ་བཞི་མ་གཅིག་གི་སྟེང་ཁྱོན་མི་གྲངས་105.སྡོད་ཀྱི་ཡོད། དངུལ་ལོར། ཨོའོ་རོ་Euro.རྒྱལ་ཁབ་ཀྱི་དུས་ཆེན་གཙོ་བོ། སྤྱི་ཟླ་10ཚེས་26 རང་བཙན་ཉིན་མོ་ཡིན། རྒྱལ་དར་ནི། སྟེང་འོག་དམར་པོ་དང་བར་དུ་དཀར་པོ་ཡིན། དམག་དང་འབྲེལ་བའི་རྟགས། བྱ་འབྲུག་གི་དབུས་སུ་རྒྱལ་དར་དང་དེའི་གཤམ་དུ་ལག་གཉིས་ཀྱི་གཡས་ལ་ཐོ་བ་དང་གཡོན་དུ་ཟོར་བ་བཟུང་བ་ཡོད། རྒྱལ་ཁབ་ཀྱི་མཚོན་རྟགས་སུ། ཨ།A ཡིན། རྒྱལ་ཁབ་ཀྱི་ཁ་པར་ཨང་། +43ཡིན། རི་མཐོ་ཤོས། གྷོ་རོ་སི་ལོག་ནར་Großglockner ཡིན། མཐོ་ཚད་མི་ཏྲར་3798 ཡོད། མཚོ་ཆེ་ཤོས། ནོཡ་སི་ད་ལར་སི་Neusiedler Seeཡིན། ཁྱིམ་མཚེས་རྒྱལ་ཁབ་ནི། ཤར་ལྷོར་ཇར་མན་ནི། ལྷོར་ཅེག ལྷོ་ནུབ་ཏུ་སོ་ལོ་ཝི་ཀི་ཡ། ནུབ་ཏུ་ཧུན་གྷར། ནུབ་བྱང་དུ་སོ་ལོ་ཝི་ནན། བྱང་དུ་ཨི་ཊ་ལི། བྱང་ཤར་དུ་སུད་སི། རྒྱལ་ཁབ་རྣམས་ཡིན། བྱང་ཤར་དང་ཤར་མཚམས་སུ་ནག་རི་དང་བྲག་རི་སྤང་རི་གངས་རི་བཅས་རི་ཧ་ཅང་མང་། རི་བརྒྱུད་ནི། ཨལ་པན་Alpen་དང་འབྲེལ་ནས་ཡོད།" },
        { "cell": "dotted", "text": "ས་ལོ་༡༩༧༥ལོའི་ཟླ་༤ཚེས་༣༠ཉིན་རྒྱལ་ཡོངས་བཅིངས་འགྲོལ་འཐབ་ཕྱོགས་ཀྱིསད་ནམ་མངས་དམག་མིའི་ (N.V.A) རོགསང་" },
        { "cell": "dotted", "text": "སྤྱིར་ཤེས་ཡོན་ཅན་གྱི་མཁས་པར་རིགས་གཉིས་སུ་དགར་ཏེ་ཨུ་རུ་སུའི་ཤེས་ཡོན་ཅན་ཧིར་ཟིན་A.I.Herzin.ལགས་ཀྱིས་བཤད་ཡོད་དེ། གཅིག རིང་ལུགས་གང་རུང་ཞིག་གི་ནང་དུ་བྱ་བ་སྣ་ཚོགས་སྤེལ་བའི་མཁས་པ་དང་། གཉིས། བློ་འབྱེད་ཀྱི་བསམ་བློ་གསར་པའི་སྒྲོན་མེ་སྦར་བའི་ མཁས་པའོ།།" },
        { "cell": "dotted", "text": "དུས་རབས་བཅུ་དགུ་པའི་ཨུ་རུ་སུའི་རླབས་ཆེན་གྱི་བསམ་བློ་མཁན་ཆེར་་ནིས་ཞེ་ཧྥི་སི་ཁི་N.G.chernysherskyསྤྱི་ལོ་༡༨༢༨ལོར་སྐུ་འཁྲུངས་ཤིང་།ཨུ་རུ་སུའི་རླབས་ཆེ་བའི་གསར་རྗེའི་དམངས་གཙོ་རིང་ལུགས་པ་དང་།" },
        { "cell": "dotted", "text": "ཨ་རིའི་རྩོམ་པ་པོ་གྲགས་ཅན་ཧྥུན་ལུན་ལགས་H.W.VanLoonཀྱིས་རང་་" },
        { "cell": "dotted", "text": "ཨུ་རུ་སུའི་ཕུལ་བྱུང་ན་གཞོན་དཔྱད་བརྗོད་པ་ཏོབ་རོལ་ཡུའུ་པོ་ཧྥིN.A.dobrolYubovཁོང་གི་སྐུ་ཚེ་མཐར་མ་ཕྱིན་པར་རྐྱེན་ལམ་དུ་གཤེགས་ཀྱང་། ཁོང་གི་སྙན་གྲགས་དང་ཕྲིན་ལས་ནི་ནམ་ཡང་ནུབ་པ་མེད་པར་ འཇིག་རྟེན་དུ་དར་ཡོད་ལ། མི་སེམས་སྒུལ་བའི་རྩོམ་ཡིག་མི་ཉུང་བ་ཞིག་" },
        { "cell": "dotted", "text": "སྤྱི་ལོ་2008ལོའི་ཟླ་8པར་ཀན་སུའུ་ཞིང་ཆེན་ཏུན་ཧོང་གྲོང་ཁྱེར་དུ་“ཏུན་ཧོང་བོད་བཙན་པོའི་དུས་ཀྱི་རིག་གནས་དཔྱད་གླེང་ཚོགས་འདུ་”ཚོགས་སྐབས། ཚོགས་ཐོག་ཏུ་ཀུན་དགའ་དབང་ཕྱུག་དང་ཁོ་མོ་གཉིས་ཀྱིས་“ཏུན་ཧོང་ཡིག་རྙིང་ཁྲོད་ཀྱི་རེབ་ཀོང་དང་དེ་འབྲེལ་ས་མིང་འགའ་ལ་གསར་དུ་དཔྱད་པ་”ཞེས་པའི་དཔྱད་རྩོམ་ཞིག་ཕུལ་ནས་ཏུན་ཧོང་ཡིག་རྙིང་ལས་བྱུང་བའི་རེབ་ཀོང་ཞེས་པའི་ས་མིང་དང་དེ་འབྲེལ་གནད་དོན་ལ་ཅུང་ཟད་དཔྱད་ཁུལ་བྱས་ཡོད། དཔྱད་རྩོམ་དེར་བཀོད་པའི་རེབ་ཀོང་ཞེས་པའི་ཐ་སྙད་དེ་ཡང་ཏུན་ཧོང་དངོས་མང་བཤམས་སྟོན་ཁང་དུ་ཉར་བའི་ཤོག་དྲིལ་ཨང་རྟགས་Db. t.0328ལས་བྱུང་བ་ཞིག་ཡིན། ད་ལན་ཁོ་མོས་ཧྥ་རན་སིར་ཉར་བའི་ཏུན་ཧོང་བོད་ཀྱི་ཡིག་རྙིང་(སྤྱིན་ཤོག་)ལ་དག་སྒྲིག་བྱེད་སྐབས་ཧྥ་རན་སིར་ཉར་བའི་ཤོག་དྲིལ་འགའ་ལས་ཀྱང་རེབ་ཀོང་ཞེས་པའི་ཐ་སྙད་འདི་ཡོད་ཚུལ་ཤེས་རྟོགས་བྱུང་བས། འདིར་རྒྱུ་ཆ་ཁ་གསབ་ཀྱི་ཚུལ་དུ་ཡང་བསྐྱར་དེའི་སྐོར་ལ་ཅུང་ཟད་བརྗོད་པར་འདོད།" },
        { "cell": "dotted", "text": "⑦ཀན་སུའུ་ཞིང་ཆེན་ཏུན་ཧོང་གྲོང་ཁྱེར་དངོས་མང་བཤམས་སྟོན་ཁང་དུ་ཉར་བའི་ཤོག་དྲིལ་ཨང་རྟགས་Db. t.0328ནང་གསལ།" },
        { "cell": "dotted", "text": "རྒྱ་གར་ལྡི་ལི་གསར་པར་ Governor-general, Rajagopalachari Jawaharlal Nehru, K.P.S. Menon བཅས་མཉམ་དུ་བགྲོ་གླེང་ཐེངས་གཉིས་པ་གནང༌། སྲིད་བློན་ནེཧེ་རུ་མཆོག་ནས་རྒྱ་གར་དང་བོད་གཉིས་པར་ཚོང་འབྲེལ་ཆིངས་ཡིག་དགོས་པ་བསྐྱར་བཤད་ཀྱང་གནང༌། ཁོང་གིས་ཞྭ་སྒབ་པར་བོད་ཀྱིས་གཞན་ལ་འབྲེལ་བ་མ་བྱས་པར་ཐ་དད་རྒྱུན་རིང་གནས་ཐབས་མེད་པ་དང་བོད་ནང་མང་གཅོ་བཅོས་འགྱུར་ངེས་པར་དུ་དགོས་པ་སོགས་ཀྱི་སློབ་སྟོན་གནང་ཡོད། བོད་མིའི་སྐུ་ཚབ་ཚོས་ལྡི་ལིར་བོད་ཀྱི་སྐུ་ཚབ་ལས་ཁུངས་ཤིག་འཛུགས་ཆོག་པའིརེ་སྐུལ་ཞུས་པར་ནེ་ཧ་རུས་སྔ་འཕྲོས་བོད་ཀྱི་ཚོང་དོན་སྐུ་ཚབ་ཞིག་ལྡི་་ལིར་བཙུགས་ན་ཡག་པོ་ཡོད་ཚུལ་གསུངས་ཡོད།" },
        { "cell": "era-marker", "text": "བྱམས་པ་མགོན་པོ།སྤྱི་ལོ་༢༧༠ནས་༣༥༠270-350 A.D." },
        { "cell": "era-marker", "text": "འཕགས་པ་ཐོགས་མེད།སྤྱི་ལོ་༣༡༠ནས་༣༩༠310-390 A.D." },
        { "cell": "era-marker", "text": "སློབ་དཔོན་དབྱིག་གཉེན།སྤྱི་ལོ་༣༡༠ནས་༤༠༠310-400 A.D." },
        { "cell": "era-marker", "text": "སློབ་དཔོན་བློ་གྲོས་བརྟན་པའི་དུས་ཚིགས་ཕྱི་ལོ་༥༡༠ནས་༥༧༠བར་ངེས་པ་བྷ་ལ་བྷིའི་རྒྱལ་པོ་གུ་ཧ་སེ་ནས་(King Guhasena of Valabhi. Ruled from 558 to 566 A.D.)སློབ་དཔོན་བློ་བརྟན་ལ་དགོན་པ་བཞེངས་པར་བརྐོས་ཡིག་ཏུ་གསལ་བ་ལ་རྟེན་ནས་ཤེས་ནུས།སློབ་དཔོན་དེ་གཉིས་དབྱིག་གཉེན་གྱི་དངོས་སློབ་མ་ཡིན་རུང་ལྟ་གྲུབ་གཅིག་པའི་རྒྱུད་འཛིན་ཆེན་པོ་ཡིན་པ་དང་དུས་རབས་ཀྱང་བར་ཐག་དེ་ཙམ་རིང་པོ་མེད་པས་དེ་ལ་བརྟེན་ཀྱང་གོང་གི་དེ་མི་འོས་པ་མེད།འོན་ཀྱང་དྭོགས་པ་གཞན་ཞིག་ནི་སློབ་དཔོན་དབྱིག་གཉེན་གྱི་འདས་རྗེས་ནས་དཔོན་དབྱིག་གཉེན་བལྟམས་པ་དང་། ཚིག་སྟོང་འདས་རྗེས་བལྟམས་པ་དང་།ལོ་དགུ་བརྒྱད་འདས་རྗེས་བལྟམས་པ་བཅས་ཁག་གསུམ་བྱུང་བར་མ་ཟད་རྒྱལ་པོ་སྲས་གྲགས་པ་བཤེས་གཉེན་གྱི་མཛོད་ཀྱི་འགྲེལ་པ་རྒྱལ་སྲས་མ་ལས།སློབ་དཔོན་དབྱིག་གཉེན་སྔ་མའོ༎(Vrddhacarya-Vasubandhu)" },
        { "cell": "era-marker", "text": "བྱམས་པ་མགོན་པོ།སྤྱི་ལོ་༣༠༠Maitreyanatha um 300 N. U. Z." },
        { "cell": "era-marker", "text": "འཕགས་པ་ཐོགས་མེད།སྤྱི་ལོ་༣༡༥ནས་༣༩༠Asanga um 315-390 N. U. Z." },
        { "cell": "era-marker", "text": "དབྱིག་གཉེན་སྔ་མ།སྤྱི་ལོ་༣༢༠ནས་༣༨༠Vasubandhu der Alter um 320-380 N. U. Z." },
        { "cell": "era-marker", "text": "དབྱིག་གཉེན་ཕྱི་མ།སྤྱི་ལོ་༤༠༠ནས་༤༨༠Vasubandhu der Junger um 400-480 N. U. Z." },
        { "cell": "year", "text": "སྤྱི་ལོ་་ ༡༦༤༢ ལོར་ྋགོང་ས་ལྔ་པ་ཆེན་པོས་བོད་རྒྱལ་ཁབ་ཀྱི་སྲིད་དབང་བདག་གིར་བཞེས་པ་ནས་ལོ་རེར་ཆོ་འཕྲུལ་སྨོན་ལམ་སྔར་སྲོལ་ཉམས་མེད་ཐོག་དུས་སྟོན་གྱི་ཆེ་བ་འདེགས་ཆེད་ སྲིད་ཕྱོགས་ཀྱི་མཛད་སྒོ་སྣ་མང་ཞིག་ཀྱང་སྐབས་བསྟུན་གསར་འཛུགས་གནང༌། སྨོན་ལམ་ཆེན་མོར་མང་ཇ་ཚོགས་ཐེངས་གསུམ་དང། །སྨོན་ལམ་གྱི་འདུས་ཚོགས་དངོས་གཞིར་དགའ་ལྡན་ཁྲི་རིན་པོ་ཆེ་ཚོགས་མགོན་དུ་ཕེབས་ཏེ་སྲས་བཅས་རྒྱལ་བའི་སྤྱན་སྔར་མཆོད་སྤྲིན་སྤྲོ་འབུལ་དང་འབྲེལ། མཆོད་བསྟོད་སྨོན་གསུམ་གྱི་རིམ་པ་ཁག་མཛད། ཞོགས་པ་གསུང་རར་དགའ་ལྡན་ཁྲི་རིན་པོ་ཆེ་ནས་སྐྱེས་རབས་སོ་བཞི་པའི་གསུང་ཆོས་དང། །དེ་རྗེས་ལྷ་རམས་དགེ་བཤེས་དམ་འཇོག་པ་ནས་ཚད་མ་ལས་འཕྲོས་པའི་བརྒལ་བརྟག་གི་གསུང་ལན་གནང་རྒྱུ་དང༌། གུང་ཚིགས་གྲོལ་བསྟུན་དབུ་ཕར། དགོང་ཇ་གྲོལ་མཚམས་འདུལ་མཛོད་བཅས་ཀྱི་དམ་འཇོག་མཛད་རྒྱུ་དང། །སྐབས་སོ་སོར་གདན་ས་གསུམ་གྱིས་གཙོས་མཁས་མང་ཡོན་ཏན་བྱེ་བས་མངོན་པར་འཕགས་པ་རྣམས་ཀྱིས་བརྒལ་བརྟག་གཏན་ཚིགས་ཀྱི་ལམ་ནས་རྩོད་པའི་གྲགས་པས་ཕྱོགས་ཀྱི་འཁོར་ལོ་འགེངས་པ་མཛད།" },
        { "cell": "year", "text": "[6]《ལྡེའུ་ཆོས་འབྱུང》ཆོས་འབྱུང་ཆེན་མོ་བསྟན་པའི་རྒྱལ་མཚན་ལྡེའུ་ཇོ་སྲས་ཀྱིས་མཛད་པ་བཞུགས་སོ། མཛད་པ་པོ། ལྡེའུ་ཇོ་སྲས། པར་སྐྲུན་ཁང་། མི་རིགས་དཔེ་སྐྲུན་ཁང་། 1987ལོ།" },
        { "cell": "year", "text": "[8]《བཻ་རོའི་རྣམ་ཐར་འདྲ་འབག་ཆེན་མོ》རྗེ་བཙུན་ཐམས་ཅད་མཁྱེན་པ་བཻ་རོ་ཙ་ནའི་རྣམ་ཐར་འདྲ་འབག་ཆེན་མོ། གཏེར་སྟོན་པ་གཡུ་སྒྲ་སྙིང་པོ། པར་སྐྲུན་ཁང་། ཟི་ཁྲོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་། 1995 ལོ།" },
        { "cell": "year", "text": "[9]《སྲིད་པ་སྤྱི་སྐོང་སྣང་སྲིད་སྤྱི་མདོས》མཛད་པ་པོ། ར་སངས་ཁྲི་ནེ་ཁོད།（དུས་རབས་བརྒྱད་པ）བོན་གྱི་དཔེ་རྙིང་ཕྱོགས་བསྒྲིགས 《ཁུ་བྱུག་སྔོན་མོའི་གསུང་སྙན》ཁྲོད་བསྡུས་ཡོད། སྒྲིག་པ་པོ། མཁར་རྨེའུ་བསམ་གཏན། དཔེ་སྐྲུན་ཁང་། ཉི་ཧོང་གི་མི་རིགས་རིག་པའི་དངོས་མང་བཤམས་མཛོད་ཁང་། 2002 ལོ།" },
        { "cell": "year", "text": "[10]《སྲིད་པའི་མཛོད་ཕུག》སྲིད་པའི་མཛོད་ཕུགས་ཐམས་ཅད་འབྱུང་བའི་སྒོ་མོའང་ཟེར། གསུངས་པ་པོ། སྟོན་པ་གཤེན་རབ་མི་བོ་ཆེ། གཏེར་སྟོན་པ། གྱེར་མི་ཉི་འོད་དང་རྨ་སྟོན་སྲིད་འཛིན། གཏེར་ཐོན་ལོ། 1108 ལོ། ལག་བྲིས་མ།" },
        { "cell": "year", "text": "[12]《གསུང་འབུམ་དཀར་ཆག》ཞྭ་སེར་བསྟན་པའི་སྒྲོན་མེ་རྗེ་ཙོང་ཁ་བ་ཆེན་པོས་གཙོས་སྐྱེས་ཆེན་དམ་པ་རིམ་བྱུང་གི་གསུང་འབུམ་དཀར་ཆག་ཕྱོགས་གཅིག་ཏུ་བསྒྲིགས་པའི་ དྲི་མེད་ཟླ་ཤེལ་གཙང་མའི་མེ་ལོང་ཞེས་བྱ་བ། སྒྲིག་པ་པོ། བོད་ལྗོངས་པོ་ཏ་ལ་རིག་དངོས་སྲུང་སྐྱོབ་སོའོ། དཔེ་སྐྲུན་ཁང་། བོད་ལྗོངས་མི་དམངས་དཔེ་སྐྲུན་ཁང་། 1990 ལོ།" },
        { "cell": "year", "text": "[15]《འདུལ་བའི་ལེགས་བཤད་སྐལ་བཟང་ནོར་བུའི་ཕྲེང་བ》མཛད་པ་པོ། པ࿄་ཆེན་བདེ་ལེགས་ཉི་མ། དཔེ་སྐྲུན་ཁང་། ཀྲུང་གོའི་བོད་རིག་པ་དཔེ་སྐྲུན་ཁང་། 2007 ལོ།" },
        { "cell": "year", "text": "[16]《འདུལ་བའི་ལྒིང་འབུམ་ཆེན་མོ》ལེགས་པར་གསུངས་བའི་དམ་པའི་ཆོས་འདུལ་བའི་ལྒིང་གཞི་དང་རྟོགས་པ་བརྗོད་པ་ལུང་སྡེ་བཞི་ཀུན་ལས་བཏུས་པ་རིན་པོ་ཆེའི་མཛོད་ ཅེས་བྱ་བ་བཞུགས་སོ། མཛད་པ་པོ། རྗེ་དགེ་འདུན་གྲུབ། པར་སྐྲུན་ཁང་། མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་། 1990 ལོ།" },
        { "cell": "decimals", "text": "བོད་ཀྱི་སྐད་དང་ཡི་གེ་སྤྱི་ཚོགས་ཀྱི་འཚོ་བའི་ཕྱོགས་གང་སར་བཀོལ་སྤྱོད་ཐུབ་ཡོད།རླུང་འཕྲིན་དང་བརྙན་འཕྲིན་ཉིན་རེར་བོད་སྐད་ཀྱི་ཐོག་ནས་སྒྲོག་སྦྱང་བྱེད་ཚད་ཆུ་ཚོད20ལྷག་ཙམ་ཟིན་པ་དང་། སྤྱི་ལོ1989ལོ་ནས་བཟུང་པར་སྐྲུན་བྱས་པའི་བོད་ཡིག་གི་དཔེ་ཆ 400 ལྷག་ཙམ་ཟིན་པ་དང་། སློབ་གསོའི་ཁྱབ་ཁོངས་སུ་བོད་ཀྱི་སྐད་ཡིག་ཐོག་ནས་སློབ་ཁྲིད་བྱེད་རྒྱུ་གཙོ་བོ་བྱེད་པའི་སྐད་གཉིས་སློབ་གསོ་ཕྱོགས་ཡོངས་ནས་ཁྱབ་གདལ་བྱེད་འགོ་ཚུགས་ཟིན་པ་རེད། མི་རིགས་སློབ་གསོ་ཚ་ཚ་འུར་འུར་ངང་འཕེལ་རྒྱས་འགྲོ་བཞིན་ཡོད། ད་བར་བོད་ལྗོངས་སུ་གསོ་སྐྱོང་བྱས་པའི་སློབ་གྲྭ་ཆེན་མོའི་སློབ་མ་ཁྲི 2 ལྷག་ཙམ་ཡོད་པ་དང་།འབྲིང་རིམ་ཆེད་ལས་ཀྱི་སློབ་ཐོན་སློབ་མ་ཁྲི 2.3 ལྷག་ཙམ་ཡོད་པ་དང་།བོད་རིགས་ཀྱི་འབུམ་རམས་པ་དང་།རབ་འབྱམས་པ་ཁག་གཅིག་ཡོད་པ་མ་ཟད།བོད་རིག་གི་ཚན་རིག་མཁས་ཅན་དང་། བཟོ་སྐྲུན་མཁས་པ། སློབ་དཔོན་ཆེན་མོ། སྨན་པ་གྲགས་ཅན། རྩོམ་རིག་སྒྱུ་རྩལ་མཁས་པ་སོགས་ཆེད་ལས་ཤེས་ལྡན་མི་ཁག་གཅིག་ཡོད།" },
        { "cell": "decimals", "text": "ལྷ་ས་ནས་གོང་དཀར་གནམ་གྲུ་ཐང་བར་གྱི་ཆེད་སྤྱོད་གཞུང་ལམ་གྱི་རིང་ཚད་ཡོངས་ལ་སྤྱི་ལེ་ 37.9 ཡོད་པ་དང་།ལམ་གཡས་གཡོན་སོ་སོར་འཁོར་ལམ་བཞི་ཡོད་པ། མྱུར་ཚད་ཆུ་ཚོད་རེར་སྤྱི་ལེ་20རྒྱུག་ཐུབ་པའི་ཇུས་འགོད་བྱས་ཡོད། གཞུང་ལམ་གྱི་འགོ་འཛུགས་ས་ནི་ལྷ་ས་གྲོང་ཁྱེར་སྣེའུ་ཁུལ་གསར་གྱི་དུས་རབས་ལམ་ཆེན་ཡིན་པ་དང་སྣེའུ་གསར་སྤེལ་ཁུལ་དང་ཚལ་སྣེ་ཤང་བརྒྱུད་མཐར་ལྷ་ས་སྐྱིད་ཆུའི་ཟམ་ཆེན་གྱི་ལྷོ་འགོར་འབྱོར་གྱི་ཡོད། ལམ་ཐིག་དེ་སྤྱིར་ལྷ་ས་སྐྱིད་ཆུའི་ལྷོ་ངོས་བརྒྱུད་ནས་ཇུས་འགོད་བྱས་ཡོད་པ་དེ་ནུབ་ནས་ཤར་གྱི་ཕྱོགས་སུ་ཡིན།" },
        { "cell": "decimals", "text": "སིང་གྷ་ཕོར་ནང་གི་མི་མང་བརྒྱ་ཆ་༤༠ཕྱིའི་རྒྱལ་ཁབ་ཀྱི་མི་ཡིན་ལ། དེའི་གྲས་ནས་ཕྱི་མི་མང་ཆེ་བ་ཨེ་ཤ་ཡ་ནས་འོང་བ་ཡིན། མ་ལེ་ཞི་ཡ་(མང་ཆེ་བ་མ་ལེ་ཞི་ཡའི་རྒྱ་མི)རྒྱལ་ཁབ་དང་ཀྲུང་གོ་རྒྱལ་ཁབ་གཉིས་ནས་ཕྱི་མི་མང་ཤོས་ཡོང་གིན་ཡོད།༢༠༠༩ལོར། སིང་གྷ་ཕོར་ནང་དུ་ལས་ཀ་བྱེད་མཁན་གྱི་མ་ལེ་ཞི་ཡའི་མི་༣༥༠,༠༠༠ཡོད། རྒྱ་སྐད་བཤད་མཁན་གྱི་ཕྱི་མི་དང་རྒྱ་སྐད་བཤད་མཁན་གྱི་སིང་གྷ་ཕོར་མི་མང་པོ་ཞིག་གིས་ཞབས་ཞུའི་བྱ་བ་གཉེར་གྱིན་ཡོད་པར་བརྟེན། དེང་སང་སིང་གྷ་ཕོར་ནང་དུ་སྐོར་ཚོང་བ་དང་། སིལ་ཚོང་ལས་རོགས་པ། སྐྲ་བཟོ་བ་སོགས་ལྟ་བུའི་ལས་མི་མང་པོ་ཞིག་གི་སྐད་ཡིག་གཙོ་བོ་ནི་རྒྱ་ཡིག་ཡིན།" },
        { "cell": "decimals", "text": "སིང་གྷ་ཕོར་རྒྱལ་ཁབ་ཀྱིས་ས་རྒོད་གསར་དུ་སྦོལ་བའི་འགོ་བརྩམས། སྐབས་དེར་སིང་གྷ་ཕོར་གྱི་ས་ཆའི་རྒྱ་ཁྱོན་ཧྲིལ་བོ་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་༥༨༡.༥ཡོད་པ་དང་།༡༩༩༠ལོར། སྤྱི་ལེ་གྲུ་བཞི་མ་༦༣༣ལ་འཕེལ་སྐྱེད་བཏང་ཡོད། དེ་ནི་ས་ཆའི་རྒྱ་ཁྱོན་ཧྲིལ་བོའི་བརྒྱ་ཆ་༩ཙམ་ཟིན་ཡོད། དེང་སྐབས་སྤྱི་ལེ་གྲུ་བཞི་མ་༧༠༤(ལེ་དབར་གྲུ་བཞི་མ་༢༧༢)ཡོད། ༢༠༣༠ལོར་སྤྱི་ལེ་གྲུ་བཞི་མ་༡༠༠(ལེ་དབར་གྲུ་བཞི་མ་༤༠)ཡིས་ཇེ་ཆེར་འགྲོ་བ་རེད། ས་སློག་ལས་གཞི་འགའ་ཤས་ནི་གླིང་ཕྲན་ཆུང་བ་རྣམས་ལྷན་གཅིག་ཏུ་སྦྲེལ་ནས། གླིང་ཕྲན་ཆེན་པོ་དང་ཇོས་རོང་གླིང་ཕྲན་ལྟར་བེད་སྤྱོད་ཡོད་པ་ཞིག་ཏུ་སྒྱུར་རྒྱུ་དེ་ཡིན། སིང་གྷ་ཕོར་གྱིས་ས་རྒོད་གསར་སྦོལ་བྱེད་པའི་ཐབས་ལམ་བེད་སྤྱད་ནས་སིང་གྷ་ཕོར་གྱི་ལྷོ་ཕྱོགས་ཀྱི་རྒྱ་མཚོ་རུ་ས་སློག་བྱེད་ཀྱིན་ཡོད། སིང་གྷ་ཕོར་གྱི་མགྱོགས་མྱུར་ས་སློག་ལས་གཞི་དེའི་རྐྱེན་པས། ཁྱིམ་མཚེས་རྒྱལ་ཁབ་མ་ལེ་ཞི་ཡ་དང་ཧིན་ཉི་ལྷན་དུ་རྩོད་གླེང་བྱུང་།" },
        { "cell": "decimals", "text": "ལྷོ་ཁོ་རེ་ཡའི་ནང་དུ་མི་དམངས་ཀྱི་བརྒྱ་ཆའི་༡༩.༧ནི་ཡི་ཤུའི་ཆོས་ལུགས་གསར་མ་དང་བརྒྱ་ཆའི་༦.༦ཁེ་ཐོ་ལིག་ཆོས་ལུགས་པ། བརྒྱ་ཆའི་༢༣.༢ནང་པ་སངས་རྒྱས་པ་ཡིན་ལ། བརྒྱ་ཆའི་༤༩.༣གྱིས་ཆོས་ལུགས་ཉམས་ལེན་བྱེད་ཀྱིན་མེད་པ་དང་བརྒྱ་ཆའི་༡.༣ཆོས་ལུགས་གཞན་ལ་དད་པ་བྱེད་མཁན་ནམ་ཤེས་རྟོགས་མེད་པའི་དད་པ་བྱེད་ཡུལ་ཡོད།" },
        { "cell": "decimals", "text": "ཨེ་མན་ནི་ཇོར་དན་གྱི་རྒྱལ་སའམ་གྲོང་ཁྱེར་ཆེ་ཤོས་དེ་ཡིན་ལ། རྒྱལ་ཁབ་ཀྱི་དཔལ་འབྱོར་དང་ཆབ་སྲིད། རིག་གཞུང་སོགས་ཀྱི་ལྟེ་གནས་གཙོ་བོ་ཞིག་ཆགས་ཡོད། གྲོང་ཁྱེར་དེ་ཇོར་དན་གྱི་བྱང་དབུས་སུ་ཡོད་ཅིང་ཨེ་མན་མངའ་སྡེའི་སྤྱི་ཁྱབ་ལས་ཁུངས་ཀྱང་ས་གནས་དེར་ཡོད་འདུག གྲོང་ཁྱེར་དེར་མི་འབོར་ས་ཡ༤ཙམ་ཡོད་ལ་ས་རྒྱ་སྤྱི་ལེ་གྲུ་བཞི་མ༡.༦༨༠ཙམ་ཡོད། དེང་སང་ཨ་རབ་ཀྱི་གྲོང་ཁྱེར་ཁག་ལས་ཨེ་མན་ནི་ནུབ་ཕྱོགས་པའི་ལམ་སྲོལ་དུ་བསྒྱུར་ཆེ་ཤོས་ཀྱི་གྲོང་ཁྱེར་ཞིག་དང། ད་དུང་གྲོང་ཁྱེར་དེ་ནི་ཡོ་རོབ་དང་ཨ་རབ་ཀྱི་ཡུལ་སྐོར་བ་ཚོའི་ཡུལ་སྐོར་འགྲོ་ཡུལ་གཙོ་བོ་དེ་ཡང་ཆགས་ཡོད། སྤྱི་ལོ༢༠༡༤ལོའི་ནང་ཨེ་མན་དུ་ཡུལ་སྐོར་བ་ཧ་ལམ་ས་ཡ་གཉིས་ཙམ་འབྱོར་ཡོད་པ་དང་། འཛམ་གླིང་ནང་ཡུལ་སྐོར་བ་སླེབས་མང་ཤོས་ཀྱི་གྲོང་ཁྱེར་ཨང་རིམ༩༣པ་དང་། ཨ་རབ་ཀྱི་གྲོང་ཁྱེར་ཁག་ལས་ཨང་ལྔ་པ་དེ་ཆགས་ཡོད་འདུག དེ་བཞིན་ཨེ་མན་ནི་བྱང་ཤར་ཨ་ཧྥེ་རི་ཀའི་གྲོང་ཁྱེར་དག་ལས་དཔལ་འབྱོར་དང་ཐོན་རྫས། ཁོར་ཡུག སྤྱི་ཚོགས་རིག་གནས་སོགས་ཡར་ཐོན་ཆེ་ཤོས་ཀྱི་གྲོང་ཁྱེར་ཞིག་ཀྱང་ཡིན་པ་གྲགས་འདུག" },
        { "cell": "decimals", "text": "སྤྱི་ལོ་༢༠༠༥ལོར་ཚོད་དཔག་བྱས་པའི་ཕྱི་རྒྱལ་བུ་ལོན་ནི་ཨ་སྒོར་ཐེར་འབུམ་༤༠ལ་ཉེ་བ་ཡོད་པ་རེད། གང་ལྟར་ཡང་རྒྱལ་སྤྱིའི་དངུལ་རྩའི་ཐེབས་རྩ་ཚོགས་པ་དང་ཨ་རིའི་གལ་གནད་ཅན་གྱི་བུ་ལོན་གདུང་སེལ་གྱི་རོགས་སྐྱོར་འོག་བུ་ལོན་དེ་ཉུང་དུ་གྱུར། དངུལ་ལོར་འདྲ་མཉམ་རང་བཞིན་ཉོ་སྒྲུབ་(Purchasing Power Parity)ཀྱིས་ཚད་འཇལ་བའི་ཕ་ཀི་སི་ཐན་གྱི་རྒྱལ་ནང་ཐོན་སྐྱེད་རྩ་འབོར་ནི་ཚོད་དཔག་བྱས་པ་ལྟར་ན་ཨ་སྒོར་ཐེར་འབུམ་༤༧༥.༤ཡིན་པ་དང་། མི་རེའི་ཆ་སྙོམས་ཡོང་འབབ་ནི་ཨ་སྒོར་༢༩༤༢ཡིན། ཕ་ཀི་སི་ཐན་ནང་དབུལ་ཕོངས་ཀྱི་ཚད་ནི་ཚོད་དཔག་བྱས་པ་ལྟར་ན་བརྒྱ་ཆ་༢༣ནས་༢༨བར་ཡིན་འདུག" },
        { "cell": "decimals", "text": "བལ་ཡུལ་ནི་རི་བོ་ཧི་མཱ་ལ་ཡའི་རི་རྒྱུད་དུ་ཁེལ་བའི་ལྷོ་ཨེ་ཤེ་ཡའི་རྒྱལ་ཁབ་ཅིག་ཡིན་ལ། རྒྱལ་ཁབ་འདི་ལ་གཞུང་འབྲེལ་གྱིས་བལ་ཡུལ་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཟེར། རྒྱལ་ཁབ་འདིའི་ནང་མི་འབོར་ས་ཡ་ ༢༦.༤ ཙམ་ཡོད་པ་དང་འཛམ་གླིང་ནང་མི་འབོར་མང་ཤོས་ཀྱི་རྒྱལ་ཁབ་ཨང་ ༤༨ པ་དང་། ས་ཁམས་ཀྱི་ཆ་ནས་ཨང་ ༩༣ པ་དེ་ཆགས་ཡོད། བལ་ཡུལ་གྱི་ཁྱིམ་མཚེས་རྒྱལ་ཁབ་ནི་རྒྱ་ནག་དང་། བོད་དང་། འབྲུག རྒྱ་གར། པཱཀིསྟཱན། བཱང་ག་ལ་དེ་ཤ་བཅས་ཡིན། རྒྱལ་ཁབ་འདིའི་ནང་གངས་རི་དང་ནགས་རི། སྤང་རི་སོགས་ས་བཅུད་ཕུན་སུམ་ཚོགས་པ་ཡོད་ལ། ཡོངས་སུ་གྲགས་པའི་འཛམ་གླིང་གི་རི་བོ་མཐོ་ཤོས་རི་བོ་ཇོ་མོ་གླང་མ་ཡང་རྒྱལ་ཁབ་འདིའི་ནང་ཡོད། རྒྱལ་ཁབ་འདིའི་ནང་གནས་ཆེན་གྱི་མིང་ཐོགས་པའི་མངའ་སྡེ་གཉིས་དང་། གངས་རི་ཆེན་པོའི་མིང་ཐོགས་པའི་མངའ་སྡེ་གཉིས་དང་། ཆུ་བོ་ཆེན་པོའི་མིང་ཐོགས་པའི་མངའ་སྡེ་བཅུ་བཅས་མངའ་སྡེ་བཅུ་བཞི་ཡོད།" },
        { "cell": "ordinal-latin", "text": "འཛམ་གླིང་དམག་ཆེན་གཉིས་པའི་ནང་འཇར་པན་ཕམ་པར་བརྒྱབས་རྗེས་མཉམ་འགྲོས་དྲང་ཐིག་སོ་བརྒྱད་པར་38th Parallel འབོད་པའི་ས་མཚམས་བཅད་དེ་ཀོ་རི་ཡའི་ཉེ་བའི་གླིང་ཕྲན་དུམ་བུ་གཉིས་སུ་ཕྱེས། བྱང་མ་ཨུ་རུ་སུ་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱིས་བཟུང་ཞིང་ལྷོ་མ་ཨ་རི་ཡིས་བཟུང་། དམག་དཔོན་ཀིམ་ཨིལ་སུང་ Kim II Sung བྱང་ཀོ་རི་ཡའི་སྐབས་འཕྲལ་མི་དམངས་མཐུན་ཚོགས་ཀྱི་གཙོ་འཛིན་དུ་བསྐོས། ཨུ་རུ་སུའི་དམག་སྤྱི་ Terentii Shtykov ཊེ་རན་ཊིཤི་ཊའེ་ཀོ་ཧྥི་ཡི་འཛིན་སྐྱོང་འོག་ནས་བྱང་ཀོ་རི་ཡར་སྤྱི་ཚོགས་གྲལ་རིམ་མེད་པར་བཟོས་ཤིང་ས་གཞི་བཅོས་བསྒྱུར་དང་བཟོ་གྲྭ་ཆེ་ཁག་ཚང་མ་གཞུང་བཞེས་བཏང་། སྤྱི་ཚོགས་རིང་ལུགས་ཀྱི་ལམ་ལུགས་གསར་པ་དེའི་འོག་ཏུ་ས་བདག་རྣམས་དང་འཇར་པན་གྱི་ལག་སྦྲེལ་ཚོང་གཉེར་བ་དག་འདུག་མ་ཐུབ་པར་ལྷོ་ཀོ་རི་ཡར་བྲོས་དགོས་ཐུག་པ་རེད། སྤྱི་ལོ་1946 ལོའི་མོ་སི་ཁོའི་ཚོགས་ཆེན་ Moscow Conference སྟེང་དུ་ཨ་རི་ཡིས་དགོས་འདུན་བཏོན་པ་ལྟར་ཨ་ཨུ་གཉིས་ལ་ཀོ་རི་ཡའི་དབང་འཛིན་ཐད་ལོ་ལྔའི་དོ་དམ་འགན་དབང་གི་ཐོབ་ཐང་ཡོད་པ་བྱས། དེ་ནི་ཀོ་རི་ཡ་ལོ་ལྔའི་རྗེས་ནས་རང་བཙན་རྒྱལ་ཁབ་ཏུ་འགྱུར་རྒྱུའི་སྟ་གོན་ཡིན་པ་རེད།" },
        { "cell": "ordinal-latin", "text": "རྗེ་འདིའི་ཞལ་སློབ་ཀྱི་གཙོ་བོ་རྡོ་གྲུབ་འཇིགས་མེད་བསྟན་པའི་ཉི་མ (1865–1926)། གཏེར་སྟོན་བསོད་རྒྱལ (1856–1926)། རྫོགས་སྤྲུལ་ལྔ་པ་ (ཐུབ་བསྟན་ཆོས་ཀྱི་རྡོ་རྗེ (1872–1935)། དང་དགེ་མང་མཁན་པོ (9th cent.)། ཞེ་ཆེན་རབ་འབྱམས་ (ལྔ་པ་འགྱུར་མེད་ཀུན་བཟང་བསྟན་འཛིན 1864–1909)། དང་རྒྱལ་ཚབ (འགྱུར་མེད་པདྨ་རྣམ་རྒྱལ 1871–1926། ཀཿཐོག་སི་ཏུ་(ཚོས་ཀྱི་རྒྱ་མཚོ1880–1924)། དཔལ་ཡུལ་རྒྱ་སྤྲུལ་(མདོ་སྔགས་བསྟན་འཛིན 1830–1892)། ཨ་འཛོམ་འབྲུག་པ་(འགྲོ་འདུལ་དཔའ་བོ་རྡོ་རྗེ1842–1924)། གྲུབ་དབང་ཤཱཀྱ་ཤྲཱི (1853–1919)། ངོར་དཔོན་སློབ་སོགས། མདོར་ན་ཀཿདཔལ་ཞེ་རྫོགས་དཔལ་སྤུངས་སྡེ་དགེའི་དགོན་ཆེན་རེབ་ཀོང་བར་གྱི་ས་དགེ་བཀའ་རྙིང་གི་སྤྲུལ་སྐུ་སྐྱེས་ཆེན། གཞུང་ལུགས་རབ་འབྱམས་སྨྲ་བའི་མཁས་པ། བསླབ་པ་གསུམ་ལྡན་གྱི་མཁན་པོ། རིམ་གཉིས་གདེང་ལྡན་གྱི་སྔགས་པ། ཚོ་བློས་བཏང་གི་བྱ་བྲལ་སོགས་གསུང་གི་སྲས་སུ་གྱུར་པ་བགྲང་གིས་མི་ལང་ཞིང་། ཐུགས་སྲས་སྐྱེས་ཆེན་རྣམས་ཀྱིས་བླ་མའི་ཕྲིན་ལས་སྤེལ་བ་ལ་བརྩོན་པ་ཆེ་ཐང་དུ་བསྐྱེད་བཞིན་པའོ། །རྗེ་འདིས་ས་གཏེར་དངོས་སུ་བཞེས་པའི་ཐུགས་རྩོལ་མ་གནང་ཡང་དགོས་པ་ཁྱད་པར་ཅན་དང་འབྲེལ་བའི་བསྐྱེད་རྫོགས་མན་ངག་ལས་ཚོགས་སོགས་སྔར་མ་གྲགས་པ་མང་པོ་ཞིག་དགོངས་གཏེར་དུ་བརྡོལ་བ་བསྟན་བཅོས་ཀྱི་ཚུལ་དུ་སྤེལ་བར་མཛད་པ་སྟེ། དོན་ལ་གཏེར་ཐམས་ཅད་ཀྱི་རྒྱལ་པོ་ཟབ་མོ་དགོངས་པའི་ཀློང་མཛོད་ལ་མངའ་དབང་བསྒྱུར་བའི་གཏེར་སྟོན་རྒྱལ་པོ་མཆོག་ཏུ་གྲུབ་པ་ཡིན་ནོ། །" },
        { "cell": "ordinal-latin", "text": "2010 ཕྱི་ཟླ་ ༨ པའི་ནང་ཁ་ན་ཌ་ཝེན་ཁུ་ཝར་གཙུག་ལག་སློབ་གྲྭ་ཆེན་མོར་ The University of British Columbia, Vancouver རྒྱལ་སྤྱིའི་བོད་རིག་པའི་ཞིབ་འཇུག་ཚོགས་ཆེན་ཐེངས་བཅུ་གཉིས་ 12th Seminar of the International Association for Tibetan Studies པར་བཅར།" },
        { "cell": "ordinal-latin", "text": "2007 ཕྱི་ཟླ་ ༨ པའི་ནང་དབྱིན་ཡུལ་ལོན་ཌོན་དུ་རྒྱལ་སྤྱིའི་གཞོན་ནུའི་བོད་རིག་པ་ཞིབ་འཇུག་ཚོགས་ཆེན་ཐེངས་དང་པོའི་ 1st International Seminar of Young Tibetologist ཐོག་ཚོགས་བཅར་ཞུས།" },
        { "cell": "ordinal-latin", "text": "2006 ཕྱི་ཟླ་ ༨ པའི་ཟླ་མཇུག་ནང་འཇར་མན་བྷོན་སློབ་གྲྭ་ཆེན་མོར་ Seminar for Central Asian Studies-Bonn University རྒྱལ་སྤྱིའི་བོད་རིག་པའི་ཞིབ་འཇུག་ཚོགས་ཆེན་ཐེངས་བཅུ་གཅིག་ 11th Seminar of the International Association for Tibetan Studies པར་བཅར།" },
        { "cell": "ordinal-latin", "text": "[29]དབང་རྒྱལ་དང་བསོད་ནམས་སྐྱིད། ཏུན་ཧོང་ནས་ཐོན་པའི་བོད་ཀྱི་ལོ་རྒྱུས་ཡིག་ཆ། 【G】མི་རིགས་དཔེ་སྐྲུན་ཁང༌། 1992. P12." },
        { "cell": "ordinal-latin", "text": "༢༠༢༠ ལོའི་ཟླ་བ་ ༧ ཚེས་ ༢༧–༣༡ ཉིན་ཁོ་མོའི་གློག་བརྙན་\"མེ་ཏོག་དང་ཟླ་འོད། flower & Moonlight\"ཅེས་པ་དེ་འགྲེལ་སྤེལ་བྱས་པ་དེ་ཉིད་སྐབས་ཉེར་གསུམ་པའི་ཧྲང་ཧེ་རྒྱལ་ཡོངས་གློག་བརྙན་དུས་སྟོན་The 23rd Shanghai International Film Festival Film Channel Media Focus Unit)ཐ་མའི་མིང་གཞུང་ནང་ཚུད་ཐུབ་པ་བྱུང་།" },
        { "cell": "ordinal-latin", "text": "ཆོས་ཚན་འདི་ནི་མཛད་པ་པོ་པཎ་ཆེན་བློ་བཟང་ཆོས་རྒྱན་མཆོག་གིས་དུས་རབས་བཅུ་བདུན་པ་ (17th century) ཙམ་ལ་བརྩམས་པར་སྙམ།" },
        { "cell": "units", "text": "རྒྱལ་ཁབ་འདིའི་གྲོང་ཁྱེར་ཆེ་ཤོས་སམ་རྒྱལ་ས་ལ་བོད་སྐད་དུ་ཡམ་བུ་དང་། ཡོངས་གྲགས་ལ་ཀཱ་ཋ་མཱཎྜཽཾ་ཟེར། རྒྱལ་སའི་རྒྱ་ཁྱོན་ 600km² ཡོད་ལ། དུས་རྒྱུན་མི་འབོར་འབུམ་ཉི་ཤུ་རྩ་ལྔ་ལྷག་གནས་སྡོད་བྱེད།" },
        { "cell": "units", "text": "ཡུལ་འདིའི་གནམ་གཤིས་ནི་དགུན་དུས་གྲང་ཞིང་སྐམ་ཤས་ཆེ་བ་དང་། དབྱར་དུས་ཚ་གྲང་སྙོམ་ཞིང་གཤེར་ཚད་མཐོ། ལོ་འཁོར་མའི་ཚ་གྲང་གི་འགྱུར་བ་ཆུང་ཡང་ཉིན་གཅིག་གི་ཚ་གྲང་གི་འགྱུར་བ་ཧ་ཅང་ཆེ། ལོ་འཁོར་མོ་གཅིག་གི་ནང་ཆུ་ཚོད་ 2457 རིང་ཉི་མ་འཆར་བས་འཆར་ཡུན་རིང་བ་དང་། ལོ་འཁོར་ཆར་ཞོད་ཀྱི་ཚད་ནི་ 641 mm ཡིན་ཞིང་སད་འབྱུང་བའི་དུས་ཚོད་མངོན་གསལ་མེད།" },
        { "cell": "units", "text": "རྡ་རམ་ས་ལ་(རྡ་ས)ནི་རྒྱ་མཚོའི་ངོས་ནས་ཆ་སྙོམས་མཐོ་ཚད་་༡༤༥༧m (༤༧༨༠ft)དང་སའི་རྒྱ་ཁྱོན་ནི་༢༩km² ཙམ་ཡོད། །རྡ་རམ་ས་ལ་ནི་ཀང་ར་དཀྱིལ་ཤོང་གི་རྡ་ལ་རྡར་རི་རྒྱུད་ནང་དུ་ཆགས་ཡོད། །སྤྱི་ལོ་༡༨༥༢་ལོ་ནས་བཟུང་ཀང་ར་ས་གནས་ཀྱི་རྒྱལ་ས་ཡིན་། ཐག་ཉེ་ཤོས་ཀྱི་མེ་འཁོར་འབབ་ཚུལ་དང་གནམ་ཐང་(གའ་དགའལ)ནི་ཀང་ར་ཡོད། དེར་ཉིན་ལྟར་ལྡི་ལི་བར་ཕར་ཚུར་འཕུར་སྤྱོད་བྱེད་ཀྱི་ཡོད་།" },
        { "cell": "units", "text": "སྤྱི་ལོ 2002 ལོ་ནས་བཟུང་གློག་བརྙན་བསྒྱུར་སྒྲིག་དང་འཁྲབ་ཁྲིད་ཀྱི་ལས་གཉེར་ཞིང་། ཁོང་གི་གློག་བརྙན་ཐོག་མ་སྟེ་གློག་བརྙན་ཐུང་ངུ《ལྷིང་འཇགས་ཀྱི་མ་ཎི་རྡོ་འབུམ》ཞེས་པར་སྤྱི་ལོ 2003 ལོར་སྐབས 4 བའི་སློབ་གྲྭ་ཆེན་མོ་བའི་གློག་བརྙན་དུས་ཆེན་གློག་བརྙན་ཐུང་ངུའི་འགྲན་བསྡུར་ཚན་པའི་ཆེད་ལས་ཚོགས་ཆུང་གི་འཁྲབ་པའི་གློག་བརྙན་གྱི་ནང་དོན་རིགས་ཀྱི་ཕུལ་བྱུང་བྱ་དགའ་ཐོབ་པར་མ་ཟད། པེ་པེ་ཅིན་གློག་བརྙན་སློབ་གླིང་གི་མཆོད་རྟེན་དབྱིབས་ཀྱི་བྱ་དགའ་ཞེས་པའི་སྐབས་དང་པོའི་གློག་བརྙན་རྩེ་གྲའི་བྱ་དགའ་དང་། པེ་པེ་ཅིན་གི་རྒྱལ་སྤྱིའི DV གླེང་སྟེགས་སྐབས་དང་པོའི་བྱུང་རིམ་གློག་བརྙན་གྱི་བྱ་དགའ། སྐབས 2 པའི་ཡ་ཞི་ཡའི་རྒྱལ་སྤྱིའི་གློག་བརྙན་ཐུང་ངུའི་དུས་ཆེན་དཔྱད་འདེམས་ཚོགས་པའི་བྱ་དགའ་བཅས་ཀྱང་ཐོབ་མྱོང་བ་རེད། 35mm ཡི་ཚོན་ལྡན་གཏམ་རྒྱུད་ཐུང་ངུ《རྩྭ་ཐང》ཞེས་པར་སྐབས་གསུམ་པའི་རྒྱལ་སྤྱིའི་སློབ་གྲྭ་ཆེན་མོ་བའི་གློག་བརྙན་བརྩམས་ཆོས་འགྲེམས་སྟོན་གྱི་ཀྲུང་གོའི་སློབ་མའི་གློག་བརྙན་ཐུང་ངུ་རྩེ་གྲའི་བྱ་དགའ་ཐོབ་པར་མ་ཟད། ཧྥ་རན་སི་དང་ཉི་ཧོང་། ཨུ་རུ་སི། ཁོ་རེ་ཡ། ཧོ་ལན་སོགས་རྒྱལ་ཁབ་ཀྱི་རྒྱལ་སྤྱིའི་གློག་བརྙན་འགྲེམས་སྟོན་དུ་ཞུགས་པ་རེད།" },
        { "cell": "units", "text": "མ་རྡུལ་ནང་གི་ཕོ་རྡུལ་དང་མོ་རྡུལ་གཉིས་པོ་སོ་སོར་ཕོ་མོའི་འགལ་ཟུངས་ལྡན་ཡང་ཕྱོགས་གཉིས་པོའི་ཟུངས་ཚད་(1.6*10-19C)སྙོམས་ཤིང། གྲངས་ཚད་ཀྱང་མང་ཉུང་ཆ་སྙོམས་ཡོད། དེའི་དབང་གིས་རྒྱུན་གཏན་གྱི་རྡུལ་ཕྲན་དེ་ཚོ་ནི་ཕོ་མོའི་གློག་ཟུངས་གང་གིས་ཀྱང་ཕྱོགས་སུ་མ་ལྷུང་པའི་བར་གནས་ཀྱི་ངོ་བོ་ཞིག་ཏུ་གྲུབ་ཡོད། ཉིང་རྡུལ་ནང་གི་ཕོ་རྡུལ་གྱི་གྲངས་ཚད་དེ་ལ་རྡུལ་གྲངས་ཞེས་ཟེར། ཕོ་རྡུལ་དང་བར་རྡུལ་ལ་ལྗིད་ཚད་ 1.672*10-27Kg ཡོད་པ་དེ་ནི་མོ་རྡུལ་གྱི་ལྗིད་ཚད་ལས་ལྡབ་ 1850 མང་བ་ཡོད། མོ་རྡུལ་ལ་ལྗིད་ཚད་ 9.107*10-31Kg ཡོད། མོ་རྡུལ་གྱི་ཞེང་ཚད་ནི་ཕོ་རྡུལ་ལས་ལྡབ་གསུམ་གྱིས་ཆེ་བ་ཡོད། བར་རྡུལ་དང་ཕོ་རྡུལ་མཉམ་སྡེབ་ཀྱི་ལྗིད་ཚད་དེ་ངེས་རྫས་ཤིག་གི་རྡུལ་ཕྲན་གྱི་ཡང་ལྕིའི་ཚད་འཛིན་དེ་ཡིན། འཁྱིར་བཞིན་པའི་མོ་རྡུལ་དེ་དག་ནི་ཕོ་རྡུལ་གྱི་འགལ་ཟུངས་འཐེན་ཤུགས་ལ་ལྟོས་ཏེ། ཉིང་རྡུལ་གྱི་མཐའ་ཁྱོན་དུ་འཁོར་བསྐྱོད་བྱེད་བཞིན་ཡོད། ཚན་རིག་པ་མང་པོས་རྡུལ་ཕྲན་གྱི་དབྱིབས་གཟུགས་དང་འབྲེལ་བའི་རྣམ་གཞག་འདྲ་མིན་མང་པོ་ཞིག་མཛུབ་འཁྲིད་བྱས་ཡོད་པ་དེ་དག་ལས་ནེལ་བྷོར་གྱི་རྡུལ་ཕྲན་དཔེ་དབྱིབས་དེ་ནི་ཆེས་རྒྱ་ཁྱབ་ཆེ་ཤོས་དེ་ཡིན། ནེལ་བྷོར་གྱིས་རྡུལ་ཕྲན་ནི་ཕོ་ཤས་ཅན་གྱི་གློག་ཟུངས་ལྡན་པའི་ཉིང་རྡུལ་གྱི་མཐའ་ཁྱོན་དུ་མོ་ཤས་ཅན་གྱི་གློག་ཟུངས་ལྡན་པའི་མོ་རྡུལ་རྣམས་འཁོར་ལམ་ནང་འཁོར་བསྐྱོད་བྱེད་བཞིན་ཡོད་པ་གསལ་སྟོན་བྱས་ཡོད།" },
        { "cell": "units", "text": "གངས་ཏེ་སེའི་རི་རྒྱུད་དེ་ནི་ནུབ་སེངྒེ་གཙང་བོ་ནས་ཤར་གཞིས་ཀ་རྩེའི་བར་དུ་བསྲིངས་ཡོད། ཞེང་ལ་སྤྱི་ལེ 80km དང་མཐོ་ཚད་ལ་མཚོ་ངོས་ནས་སྨི6000m ལྷག་ཡོད།" },
        { "cell": "units", "text": "ཡམ་བུ་ནི། བལ་ཡུལ་རྒྱལ་ཁབ་ཀྱི་གྲོང་ཁྱེར་ཆེ་ཤོས་སམ་རྒྱལ་ས་ཡིན་ལ། ཡོངས་གྲགས་ལ་ཀཱ་ཋ་མཱཎྜཽཾ་ཟེར། རྒྱལ་སའི་རྒྱ་ཁྱོན་ 600km2 ཡོད་ཅིང་། དུས་རྒྱུན་མི་འབོར་འབུམ་ཉི་ཤུ་རྩ་ལྔ་ལྷག་གནས་སྡོད་བྱེད།" },
        { "cell": "units", "text": "ཟླ་9ཚེས་26ཉིན་གྱི་ཞོགས་པ་སྔ་པོ་ནས་རྒྱ་མཚོའི་རླུང་འཚུབ་དྲག་པོས་ཧྥེས་ལི་པེན་གྱི་ལུའུ་ཙུན་གླིང་ཕྲན་བརྒལ་ནས་ལྷོ་མཚོའི་ཕྱོགས་སུ་བསྐྱོད། ཆར་རླུང་དྲག་པོའི་ལྟེ་གནས་ཀྱི་ཉེ་འདབས་ཀྱི་ཆེས་ཆེ་བའི་རླུང་ནི་12-13(118-149km/h)རིགས་14ཡི་རླུང་འཚུབ་ཡིན།" },
        { "cell": "ranges", "text": "[66]《རྒྱའི་བཙུན་པ་ཧྥ་ཤན་གྱི་རྒྱ་གར་ལམ་ཡིག》བོད་འགྱུར་མ། མཛད་པ་པོ། ཆོས་ཀྱི་སྣང་བ（334-420）དཔེ་ཁུངས། གློག་རྡུལ་ཡིག་ཚགས།" },
        { "cell": "ranges", "text": "[152]《གྲུབ་མཐའ་རྒྱན་གྱི་མེ་ཏོག》བཅོམ་ལྡན་རིག་པའི་རལ་གྲི（1127-1250）ཡིས་བརྩམས། ལག་བྲིས་མ།" },
        { "cell": "ranges", "text": "བྱུང་རབས་ཀྱི་རིང་ལ། ཏཱ་ལའི་བླ་མ་ (Dalai Lamas) མཆོག་གིས་བོད་ཀྱི་ཆོས་སྲིད་གཉིས་ཀྱི་འགན་འཁུར་ཞིང་། བོད་ཡུལ་དང་དེའི་རིང་ལུགས་ཀྱི་ཐད་ལ་དབང་འཛིན་ཚད་གཞི་འདྲ་མིན་ཡོད། འདི་ནི་སྤྱི་ལོ་ ༡༦༤༢ ལོར་དྷ་ལའི་ལཱ་ལྔ་པའི་སྲིད་སྐྱོང་དང་འགོ་འཛུགས་ཏེ་ ༡༩༥༠ ལོའི་ལོ་ ༡༩༥༠ བར་ (༡༧༠༥ ནས་ ༡༧༥༠ བར་མ་གཏོགས་) བརྩོན་ཤུགས་བསྐྱེད་ཡོད། དུས་སྐབས་དེའི་རིང་དྷ་ལིལའི་ལམ་རྣམས་ཀྱིས་བོད་གཞུང་གི་སྲིད་སྐྱོང་ (Ganden Phodrang) གྱི་དབུ་འཁྲིད་བྱས་པ་ཡིན། འོན་ཀྱང་ ༡༩༡༢ ལོའི་བར་དུ་ ༡༣ པ་དང་དྷ་ལའི་ལ་མཱ་གྱིས་བོད་རང་བཙན་ཆ་ཚང་ཐོབ་པའི་གསལ་བསྒྲགས་བྱས་སྐབས། ཁོང་གི་སྲིད་སྐྱོང་ནི་ཐོག་མར་མོང་གོ་རྒྱལ་པོའ ་ི (༡༦༤༢-༡༧༢༠) དང་དེའི་རྗེས་མ་མོང་གོ་དབུ་འཁྲིད་པའི་ཅིན་རྒྱལ་བརྒྱུད་ (༡༧༢༠-༡༩༡༢) ཀྱི་སྲུང་སྐྱོབ་དང་སྲུང་སྐྱོབ་ཀྱི་དབང་འོག་ཏུ་གནས་ཡོད་དོ༎" },
        { "cell": "ranges", "text": "(གཡོན)གཉིས་ཀྱི་དཀོན་པའི་པར་རིས། ༡༩༥༤–༡༩༥༥]]" },
        { "cell": "ranges", "text": "སིང་གྷ་ཕོར་ནང་དུ་སློབ་མ་ཚོས་ལོ་ངོ་དྲུག་རིང་གི་གཞི་རིམ་སློབ་གྲྭ་ངེས་པར་དུ་འགྲིམས་དགོས་པ་དང་། སློབ་མ་ཡོད་ཚད་ཀྱིས་རྒྱལ་ཡོངས་གཞི་རིམ་སློབ་གྲྭའི་ཡིག་རྒྱུགས་སྤྲོད་དགོས་པ་རེད། དེ་ནས་སློབ་མ་རང་ཉིད་ཀྱི་རྒྱལ་ཡོངས་གཞི་རིམ་སློབ་གྲྭའི་ཡིག་རྒྱུགས་ཀྱི་མཇུག་འབྲས་ལ་བལྟས་ཏེ། ཁོ་ཚོ་ཆེད་ལས་སྡེ་ཚན་དང་ཆེད་བརྗོད་སྡེ་ཚན། འཆར་ཅན་སློབ་གྲྭའཆར་ཅན་བཟོ་ལས་སྡེ་ཚན་སོགས་ལ་སྤོ་བ་རེད། འབྲིང་རིམ་སློབ་གྲྭའི་དུས་ཡུན་(༤-༥)ནི་ཁོ་ཚོ་སྡེ་ཚན་གང་ལ་འཛུལ་ཡོད་པར་རག་ལས་ཡོད།" },
        { "cell": "ranges", "text": "ཕྱག་བཏབ་པའི་དུས། ལོ་རྒྱུས་ཡིག་ཆའི་ནང་དུ་སྤྱི་ལོ་ཞིབ་ཕྲ་མ་གསལ་ཡང་། ཁོང་གིས་པཎ་ཆེན་བློ་བཟང་ཡེ་ཤེས་ (༡༦༦༣-༡༧༣༧) དང་ལྷ་ཆེན་ཚངས་པ་རྣམ་གཉིས་ཀྱི་ལུང་བསྟན་ལ་བརྟེན་ནས་དགོན་པ་བཏབ་པར་གསུངས་ཡོད་པས། དེ་ནི་དུས་རབས་བཅོ་བརྒྱད་པའི་མགོ་སྟོད་ཙམ་ལ་ཡིན་པར་ཚོད་དཔག་བྱེད་ཐུབ།" },
        { "cell": "ranges", "text": "སི་ཁྲོན་ཞིང་ཆེན་ནི་ཀྲུང་གོ་ལྷོ་ནུབ་སྟེ་འབྲི་ཆུའི་སྟོད་རྒྱུད་དུ་ཆགས་ཡོད། ས་བབ་ཀྱི་ཆགས་རིམ་ནི་ནུབ་བྱང་མཐོ་ལ། ཤར་ལྷོ་དམའ་བ་དང་། སྤྱིའི་ཆ་ནས་ཤར་ཕྱོགས་སི་ཁྲོན་གཞོངས་ས་ཆེན་མོ་དང་ནུབ་ཕྱོགས་མཐོ་སྒང་རི་ཁུལ་ཡིན། ཆུ་བོ་གཙོ་ཤོས་ནི་འབྲི་ཆུ་དང་། ཉག་ཆུ། རྒྱལ་མོ་རྔུལ་ཆ་སོགས་ཡིན། གཞོངས་ས་འདི་ནི་བརླན་གཤེར་ཆེ་བའི་ཚ་ཁུལ་དུས་རླུང་གི་གནམ་གཤིས་ལ་གཏོགས་པ་དང་། ནུབ་ཕྱོགས་མཐོ་སྒང་ནི་གྲང་ངར་ཆེ་བའི་གནམ་གཤིས་ལ་གཏོགས་པ་ཡིན། ཞིང་ཆེན་ཡོངས་ཀྱི་ལོ་རེའི་ཆ་སྙོམས་དྲོད་ཚད་ཏུའུ ༡-༡༨བར་ཡིན།" },
        { "cell": "ranges", "text": "ཡུལ་འདི་ནི་ས་ཁམས་གྱི་ཐོག་ནས་བཤད་ན།ཐེ་བོ་རོང་ནི་བྱང་ཐིག་33-34ཤར་ཐིག་102-104ཡི་མཚམས་སུ་ཡོད་ལ།ནུབ་བྱང་ནས་ཤར་ལྷོའི་ཕྱོགས་སུ་གྲུབ་པའི་རོང་ཆེན་ཞིག་ཡིན་ལ།ཐེ་ཆུའམ་འབྲུག་དཀར་གཙང་བོ [1] ་ནི་རོང་མཐིལ་དུ་དལ་གྱིས་འབབ་ཞིང་།གཙང་པོའི་ངོགས་གཉིས་སུ་ལྗོན་ཤིང་དང་།ཞིང་ས་གཤིན་པོ་དག་གིས་ཁྱབ་ཅིང་།རི་བོའི་ངོས་ནི་སྲིབ་ལ་ནགས་ཚལ་སྟུག་པོ་ལེ་དབར་བརྒྱ་ཕྲག་ལ་སྦྲེལ་བ་དང་།ཉིན་ལ་སྤང་རི་དང་རྫ་རི་དག་གིས་ཁྱབ་ཡོད།རིམ་པར་སྨད་ཕྱོགས་སུ་ཕྱིན་པས་ས་དྲོ་བའི་མཐུས།ཤིང་འབྲས་སྣ་ཚོགས་དང་།སྟར་ཀ།མ་རྨོས་ལོ་ཏོག་དང་རྒུན་འབྲུམ་སོགས་ཀྱང་སྐྱེས།" },
        { "cell": "currency", "text": "སྤྱི་ལོ་ ༢༠༡༣ ནས་བཟུངས་ཀྲུང་གོ་ནི་འཛམ་གླིང་གི་དཔལ་འབྱོར་ཨང་རིམ་གཉིས་པར་སླེབས་ཡོད། རྒྱལ་སྤྱིའི་དངུལ་ཚད་གཏན་འབེབ་ཁང་ནས་གསལ་སྟོན་བྱས་པར་གཞིགས་ན་ཁྱོན་ཨ་སྒོར་ཐེར་འབུམ་ $༩.༤༦༩ ཙམ་གྱི་རྒྱལ་ཡོངས་ཐོན་བསྐྱེད་རྩ་འབོར་ཡོད། ཉོ་སྒྲུབ་ནུས་པའི་དོ་མཉམ་ (PPP) གཞིར་ན་ཨ་སྒོར་ $༡༦.༡༤༩ ཀྲུང་གོ་ནི་ཨ་རི་ཕུད་པའི་འཛམ་གླིང་ཨང་རིམ་གཉིས་པ་ཡིན། ཆ་སྙོམས་གྱི་རྒྱལ་ཡོངས་ཐོན་བསྐྱེད་རྩ་འབོར་ནི་ཨ་སྒོར་$༦,༩༥༩. ཙམ་ཡིན་པས་འཛམ་གླིང་གི་ཨང་རིམ་དགུ་བཅུ་ཙམ་དུ་སླེབས་ཀྱི་ཡོད།" },
        { "cell": "currency", "text": "ཀྲུང་གོ་ནི་འཛམ་གླིང་ཚོང་འབྲེལ་ལྷན་ཚོགས་ཀྱི་ཚོགས་མི་ཡིན་པ་དང་ཚོང་འབྲེལ་སྟོབས་ཆེན་རྒྱལ་ཁབ་ཞིག་ཀྱང་ཡིན། ༢༠༡༢ ལོར་ཉོ་འཚོང་གི་ཆ་སྙོམས་བསྡུར་གྲངས་ཨ་སྒོར་ཐེར་འབུམ་ $3.87 ཟིན་ཡོད།" },
        { "cell": "currency", "text": "2012 ལོར་ཀྲུང་གོའི་འབྱོར་འབྲིང་གྲལ་རིམ་གྱི་མི་འབོར་ནི་(ལོ་རེའི་ཆ་སྙོམ་ཡོངས་འབབ་ཨ་སྒོར་ ༡༠,༠༠༠ ནས་$༦༠,༠༠༠ བར་ལོན་མཁན་) ས་ཡ་སུམ་བརྒྱ་ཙམ་ཟིན་ཡོད། མ་ཟད་ ཨ་སྒོར་དུང་ཕྱུར་ལས་བརྒལ་བའི་ ཕྱུག་བདག་གི་མི་གྲངས་ནི་ ༡༣༠ནས ༢༥༡ བར་ཟིན་ཡོད། འཛམ་གླིང་སྟེང་གི་དུང་ཕྱུར་ཅན་གྱི་ཕྱུག་བདག་མི་གྲངས་མང་ཤོས་གཉིས་པར་སླེབས་ཡོད།" },
        { "cell": "currency", "text": "དེང་གི་རིན་ཐང་། ཕལ་ཆེར་ཨ་སྒོར་ $110 ཙམ། (2025 ལོའི་གསེར་གོང་ལྟར་ན།) ཚད་གཞི་འདི་ནི་ཐེ་ལན་ཌིའི་ནགས་ཁྲོད་ཀྱི་བརྒྱུད་པ་སོགས་གནས་བརྟན་སྡེ་པའི་ལུགས་འཛིན་པ་མང་པོས་ཁས་ལེན་གནང་གི་ཡོད། གང་ལགས་ཤེ་ན། འདི་ནི་གནའ་བོའི་ཉོ་ནུས་ (ཉིན་ཕྱེད་དང་གཉིས་ཀྱི་གླ་ཕོགས) དང་མཐུན་པས་སོ།" },
        { "cell": "currency", "text": "ནུབ་ཕྱོགས་ཀྱི་དགེ་སློང་ཁ་ཤས་ཏེ། དཔེར་ན་ཨ་ཛན་བྲཧྨ་ (Ajahn Brahm) ལྟ་བུས། \"བརྡུང་བའམ། བཙོན་དུ་འཇུག་པའམ། ཡུལ་ནས་ཕྱུང་བ\" ཞེས་པའི་ཚིག་ལ་གཙིགས་ཆེར་འཛིན་གྱི་ཡོད། ཁོང་ཚོས་དངུལ་གྱི་གྲངས་འབོར་དེ་ནི་དུས་སྐབས་དེའི་ཉེས་པ་ལྕི་བའི་རང་བཞིན་མཚོན་པ་ཙམ་རེད་ཅེས་རྩོད་པ་བྱེད་ཀྱི་ཡོད། དེར་བརྟེན་ཡུལ་ལུང་སོ་སོའི་ཁྲིམས་ལུགས་ལྟར། ཡུལ་ནས་ཕྱུང་བའམ་བཙོན་འཇུག་ཡུན་རིང་བྱེད་དགོས་པའི་རྐུ་མ་ཆེན་པོའི་རིགས་ (མང་ཆེ་བ་ཨ་སྒོར་ $1,000 ལས་བརྒལ་བ) བརྐུས་ན་གཞི་ནས་ཕམ་པ་འབྱུང་བར་འདོད་དོ།" },
        { "cell": "currency", "text": "ཌི་ཇི་ཊལ་ (Digital) གྱི་རྐུ་མ། མཉེན་ཆས་དང་གློག་རྡུལ་གྱི་དངོས་པོ་རྐུ་བ་ལྟ་བུ་ནི་མ་བྱིན་པར་ལེན་པ་ཡིན་མིན་ཐད་རྩོད་པ་ཡོད། རིན་ཐང་གི་ཆ་ནས་ཚད་ ($110 ལས་མཐོ་བ) ལོངས་སྲིད་ཀྱང་། \"སྦྱོར་བ\" འམ་གནས་ནས་སྤོ་བའི་ཆ་དེ་གསལ་པོ་མེད། ཡིག་ཆ་ཞིག་བཤུ་ལེན་ (Copy) བྱེད་པ་དེ་གནས་ནས་སྤོས་པ་ཡིན་ནམ། འདུལ་བ་འཛིན་པ་མང་པོས་འདི་ནི་བདག་པོ་ལ་ཁེ་བཟང་གི་གྱོང་གུད་ཕོག་པ་ལས་དངོས་པོ་རང་ཉིད་བོར་བ་མིན་པས། ཕམ་པ་མིན་པར་ སྦོམ་པོའི་ལྟུང་བར་ངོས་འཛིན་བྱེད་ཀྱི་ཡོད།" },
        { "cell": "currency", "text": "གླ་མི་སྤྲོད་པ། མེ་འཁོར་སོགས་ལ་གླ་མ་སྤྲད་པར་འཛུལ་བ་ནི་ཉེས་པ་ཆུང་བར་བརྩི། འགྲུལ་བཞུད་ཀྱི་ཁེ་ལས་ལ་གྱོང་གུད་ཕོག་ཀྱང་། འགྲུལ་གླ་གཅིག་གི་རིན་ཐང་ནི་གསེར་གྱི་ཚད་གཞི་ ($110) ལས་དམའ་བ་ཡོད་པ་དང་། དངོས་པོ་གནས་ནས་སྤོས་པའི་དོན་ཡང་མི་ཚང་བས་སོ།" },
        { "cell": "currency", "text": "དོ་མའི་ནང་དུ་ཡོད་པའི་རྫས་གཙོ་བོ་ནི་ arecoline ($C_8H_{13}NO_2$) ཞེས་པ་འདི་ཡིན། འདིས་མིའི་དབང་རྩའི་མ་ལག་ལ་ཕོག་ཐུག་བཏང་སྟེ་སེམས་འཁྲུག་པ་དང་ལུས་པོ་དྲོད་འབར་བ་བཟོ་གྱི་ཡོད། ¹¹ ཚུནི་ཡིས་དོ་མའི་ནང་གི་རྫས་རྣམས་ཁྲག་གི་ནང་དུ་འཐིམ་པར་རོགས་བྱེད་ཀྱི་ཡོད། ⁶" },
        { "cell": "abbrev", "text": "རྒྱལ་ཁབ་ཀྱི་སྐད་ཡིག་ཇར་མན་སྐད་ཡིག་Deutschཡིན། དེ་མིན་ཀོ་རི་ཏྲི་ཤི། སོ་ལོ་ཝི་ནི་ཤི། ཧུན་གྷར་ཤི། རྒྱལ་ཁབ་ཀྱི་ངོ་བོ། གྲོས་ཚོགས་ལམ་ལུགས་ཀྱི་དམངས་གཙོ། ཁྱོན་མངའ་སྡེ་དགུ་ཡོད། ཝི་ཡན། སྦུ་གྷར་ལན་ཌེ། ཀེའ་རན་ཏན། ནིའ་དར་ཨོ་སི་ཏྲི་རག ཨོ་སྦར་ཨོ་སི་ཏྲི་རག སལ་ཛི་སྦུག ཤེ་ཏེར་མག ཏྲི་རོ། ཧྥོ་རལ་བྷག རྣམས་ཡིན། རྒྱལ་ས་དང་མངའ་སྡེ་གཙོ་བོ་ཝིནWeinཡིན། རྒྱལ་ཁབ་ཀྱི་གཙོ་འཛིན། ཧན་ཛེ་ཧྥི་ཤར།Alexander Van der Bellen. རྒྱལ་ཁབ་ཀྱི་སྲིད་འཛིན། ཝིར་ནར་ཧྥེ་མན།Christian Kern. རྒྱལ་ཁབ་ཀྱི་གཙོ་འཛིན་ལོ་ཡུན་དྲུག་ཡིན། གྲོས་ལ་མཐུས་མི་183 ཡོད།" },
        { "cell": "abbrev", "text": "འབར་མའི་ཡི་གེ་ག་དུས་བྱུང་མིན་དང་དེའི་བྱུང་ཁུངས་སོགས་ཀྱི་ཐད་མཁས་པ་རྣམས་ལ་འདོད་ཚུལ་མི་འདྲ་བ་ཡོད་པར་ངེས། དཔེར་ན་འབར་མའི་རིག་གཞུང་དང་ལོ་རྒྱུས་ལ་ཉམས་ཞིབ་ཡུན་རིང་གནང་བའི་མཁས་པ་འགས་འདི་འདྲ་གསུངས་ཡོད། “འབར་མའི་གཞུང་འབྲེལ་གྱི་མ་སྐད་དངས་མ་ནི་བོད་ཀྱི་སྐད་ཡིག་དང་རྒྱ་ནག་གི་སྐད་དང་འབྲེལ་ཡོད་” (Ethnologue; Languages of the World by Raymond G. Gordon ཞེས་པ་ལས་གསལ།) ཅེས་དང་། ཡང་མཁས་པ་གཞན་དག་འགས། “འབར་མའི་ཡིག་གཟུགས་ནི་ཕྱི་ལོའི་དུས་རབས་བརྒྱད་པའི་ནང་དུ་རྒྱ་གར་ལྷོ་ཕྱོགས་ཀྱི་ཡི་གེ་ལས་འཕེལ་རྒྱས་བྱུང་བ་ཡིན། ” ཞེས་དང་། ཡང་གཞན་འགའ་ཞིག་གིས་ “འབར་མའི་ཡིག་གཟུགས་ནི་ཕྱི་ལོའི་དུས་རབས་བཅུ་གཅིག་པའི་ནང་དུ་པཱ་ལིའི་ཡི་གེ་བེད་སྤྱད་མྱོང་བ་ལས་རིམ་པར་བྱུང་བ་” སོགས་འདོད་ཚུལ་མི་འདྲ་བ་འགའ་ཞིག་འདུག" },
        { "cell": "abbrev", "text": "Dr. Charles Malik(ལེ་པ་ནོན་)Alexandre Bogomolov(སུ་ལན་)Dr. Peng-chun Chang (རྒྱ་ནག）René Cassin(ཧྥ་རན་སི་)Eleanor Roosevelt (ཨ་རི་)Charles Dukes(དབྱིན་ཇི་)William Hodgson(ཨོ་སི་ཁྲུ་རི་ཡ་)Hernan Santa Cruz (ཆི་ལི་)John P. Humphrey(ཁ་ན་ཊ་)" },
        { "cell": "abbrev", "text": "ཚིག་ག་བའི་རིགས་ནི་སྐད་ཁག་གཅིག་ལ་ལྡོག་པའི་རིགས་སུ་（passive） [20] ཡིན་པར་ངོས་འཛིན་བྱས་འདུག་མོད།ཨེ་ཌི་ཝར་ཁེ་ན（Edward L. Keenan ）དང་མ་ཟོའུ་ཌིར་ཡེ（Matthew S. Dryer）(2007)གཉིས་ཀྱིས་དེ་ནི་སྤྱིར་བཏང་གི་རིགས་ཤིག་ལ་ངོས་འཛིན་བྱས་འདུག [21] ཡིན་ན་ཡང་ཕྱོགས་གཅིག་ནས་དེ་ནི་བརྗོད་སྟངས་ཀྱི་ཆ་ནས་བྱེད་པ་པོ་བསྡུས་པ་ལས།ཚིག་གི་བརྡ་སྤྲོད་ཀྱི་ཆ་ནས་བསྡུས་པ་མིན་པའི་གོ་བ་བླངས་ཆོག" },
        { "cell": "abbrev", "text": "སན་པི་ཏི་པོག་(དབྱིན་ཇིའི་སྐད།: St. Petersburg)ནི་ཧྥོ་ལོ་རི་ཌ་ཀྱི་གྲོང་རྡལ་ཞིག་རེད།" },
        { "cell": "abbrev", "text": "འདི་ག་གསར་ཁང་དུ་དང་བླངས་ཀྱི་ལས་གཉེར་གནང་མྱོང་མཁན། མེ་ཏུའུ་སི། Mr. Mateus བྷི་ར་ཟིལ། ཁི་རི་སི་ཊོབ་པེར། Mr. Christopher ཨ་རི། ཀ་ཊིས་ལིན། Ms. Katie Lynn ཨ་རི། དྷོ་རོ།Ms. Dorota པོ་ལན་ཌི། ཨར་ཆིས། Mr. Archie དབྱིན་ལན་ཌི ཇོན་ཨུ་ཡེན་ནོ། John Uyeno ཁ་ན་ཌ། ཕེ་བྷེ། Pheebe ཨ་རི། ཇེ་ཧམ་མིལ་ཊོན། J.Hamilton ཨ་རི། ཨེ་སི་ཧར་ཊི། S.Hartigan ཨ་རི།" },
        { "cell": "abbrev", "text": "ཀ. གཅེན་དཔལ་ལྡེའུའི་རྒྱུད་སྔོན་པོ་ཚོན་པོར་ཐུག་སྟེ་ཁབ་གུང་ཐང་པ་དང་ཀླུ་རྒྱལ་པ། སྤྱི་པ་ལྷ་རྩེ་བ། གླང་ལུང་རྩད་སྐོར་བ་སོགས་ཡིན་ནོ།" },
        { "cell": "abbrev", "text": "ཁ. འབྲིང་པོ་འོད་ལྡེའུ་ལ་སྲས་བཞི་ལས་ཕ་བ་དེ་སེའི་རྒྱུད་གཙང་རོང་སྣུབས་ཡུལ་དང་ཉང་སྟོད་སོགས་ན་ཡོད། གཉིས་པ་ཁྲི་ལྡེའུ། མདོ་ཁམས་སུ་བྱོན་ཏེ་ཙོང་ཁ་ཡུལ་ཆེན་བཅོ་བརྒྱད་ལ་སོགས་མདོ་སྨད་ཕལ་ཆེར་ལ་མངའ་མཛད་པས་སྨད་དུ་རྒྱལ་ཁྲིམས་ལྷམ་ཙམ་ཆགས་ཞེས་གྲགས་ཤིང་སྤྱན་སྔ་དོན་ཆེན་ལ་སོགས་པའི་རྒྱལ་རྒྱུད་བྱུང༌། གསུམ་པ་ཉག་ལྡེའུའི་རྒྱུད། གཡས་རུའི་སྐྱིད་མཁར་བཙན་པོ་ལ་ཐུག། བཞི་པ་ཁྲི་ཆུང༌། ཡར་ཀླུངས་སུ་བྱོན། འབངས་ཀྱིས་ཕོ་བྲང་བརྩིགས་ནས་ཕུལ་བའི་འབངས་བརྩིགས་དང་སྐུ་མཁར་མཆིང་ང་སྟག་རྩེ་བཟུང༌། ཁྲི་ཆུང་གི་སྲས་འོད་སྐྱིད་འབར། འོད་སྐྱིད་འབར་ལ་སྲས་བདུན་ཡོད་པ་ནི། གཅེན་ཞང་རྗེ་ཚ་ཁྲི་ལྡེའུ་འབར། གཅུང་གཙང་ཚ་སྤུན་དྲུག་ཅེས་པ་ལྷ་སྤྱན་གཡུ་སྤྱན་གཉིས། ད་ར་ལྷུན་པོ་གཉིས། འོད་བཙན་གུང་བཙུན་གཉིས་ཏེ་དྲུག་གོ།" },
        { "cell": "latin-in-native", "text": "Administratively speaking, Lhasa is a prefecture-level city that consists of one district and seven counties. ཁྲེང་ཀོན་ཆུས་ནི་ལྷ་ས་གྲོང་ཁྱེར་གྱི་གྲོང་ཁུལ་གཙོ་བོ་ཞིག་ཡིན་ཞིང་། The mayor and vice-mayor of Lhasa are Doje Cezhug and Jigme Namgyal, respectively." },
        { "cell": "latin-in-native", "text": "དེ་དུས་ཆོས་རྗེ་ངག་དབང་ཕུན་ཚོགས་ཉིད་ཕུ་བོ་ནམ་མཁའ་འོད་ཟེར་གྱི་དྲུང་དུ་ཕེབས་ནས་ཁོང་གིས་རྒྱལ་དབང་ལྔ་པའི་མདུན་དུ་དགོན་སྡེ་བཅུ་གསུམ་འདེབས་པའི་དམ་བཅའ་ཕུལ་ཚུལ་རྣམས་ཞིབ་ཏུ་ཁུ་བོ་ལ་གསོལ་བར། ཁུ་བོས་ཀྱང་བླ་མ་བྱ་བྲལ་བའི་ལུང་བསྟན་ཚུལ་སྐོར་བསྙད་དེ་མཐར་ཁུ་དཔོན་རྣམ་གཉིས་ནས་བཀའ་བགྲོས་ལེགས་པར་མཛད་དེ། ཆོས་རྗེ་ངག་དབང་ཕུན་ཚོགས་ཀྱིས་ཧོར་དགོན་སྡེ་བཅུ་གསུམ་གྱི་ཐོག་མ་དཀར་མཛེས་དགོན་འདེབས་པའི་རྟེན་འབྲེལ་གྱི་དབུ་བཙུགས་ཏེ། བོད་རབ་བྱུང་བཅུ་གཅིག་པའི་ཆུ་ཕོ་སྟག་སྤྱི་ལོ་1622ལ་སྔར་ཡོད་དཀར་མཛེས་དགོན་པ་རྒྱ་བསྐྱེད་བྱས་ཏེ་གཙུག་ལག་ཁང་ཆེན་པོ་འདི་ཉིད་ཀྱི་རྟེན་དང་བརྟེན་པར་བཅས་པ་ལེགས་པར་བཞེངས་ཏེ་མཚན་ལ་དཀར་མཛེས་བཀྲ་ཤིས་བཤད་སྒྲུབ་ནོར་བུ་གླིང་ཞེས་གསོལ། （ཀུན་གཟིགས་པཎ་ཆེན་སྐུ་འཕྲེང་བཅུ་པ་ཆོས་ཀྱི་[page 7] རྒྱལ་མཚན་དཔལ་བཟང་པོ་ནས་“བཤད་སྒྲུབ་”ཞེས་གསར་སྣོན་ཕྱག་བྲིས་ཕྱག་ཐམ་བཅས་1985ལོར་གནང་བ་ད་ལྟ་དཀར་དགོན་དུ་བཞུགས）ཕྱིས་སུ་གཙུག་ལག་ཁང་འདི་མདོ་བསྔགས་རིག་གནས་ཀུན་ལ་སྦྱངས་པའི་མཚན་ཉིད་གྲྭ་ཚང་དུ་བྱས། དེ་ནས་རིམ་གྱིས་རྫ་དགོན་གསར་བཀྲ་ཤིས་དགའ་ལྡན་གླིང་། ལྕོག་རི་དགོན། རྩིས་ཚང་དགོན་སོགས་དགོན་སྡེ་བཅུ་གསུམ་ལེགས་པར་བཏབ་སྟེ། དགོན་སྡེ་སོ་སོར་འདུལ་བའི་བཅོས་ཁྲིམས་དང་གཞི་གསུམ་གྱི་ཕྱག་ལེན། བཅའ་ཡིག་ཆེན་མོ་སོགས་འཇོག་པར་མཛད། ལྷག་པར་དུ་དཀར་མཛེས་དགོན་པ་འདི་ལ་གོས་ཆེན་སེར་པོའི་བཅའ་ཡིག་ཞེས་པ་དེང་སང་གི་བར་དུ་ཡོད་དོ།" },
        { "cell": "latin-in-native", "text": "དེ་ནས་ཆོས་རྗེ་ཉིད་ཀྱིས་རྒྱལ་བའི་ཐུགས་དགོངས་ལྟར་མཁར་དཀར་པོ་ཐུགས་བརྩེགས་དགུ་ཡོད་པ་ཞིག་གསར་བསྐྲུན་མཛད་དེ་རྣམ་རྒྱལ་གྲྭ་ཚང་ཞེས་མཚན་གསོལ། རྣམ་རྒྱལ་གྲྭ་ཚང་འདི་ནི་རྒྱལ་བ་རིན་པོ་ཆེའི་སྐུ་ཞབས་གྲྭ་ཚང་དང་འདྲ་བ་བྱས་ནས་དགོན་པ་གཞུང་ནས་འདོན་བཟང་སྐད་བཟང་མང་ཙམ་ཞིག་ཟུར་གྱི་སྐུ་རིམ་ཞབས་བརྟན་སོགས་སྒྲུབ་མིའི་ཞབས་ཕྱི་ལ་བཞག་པ་ཡིན། བསྐང་གསོལ་དང་ལྷ་མོའི་མདོས་ཆེན། འཆམ། གནམ་ལོ་གསར་པའི་ཚེས་གཅིག་ཉིན་དམག་ཟོར་མ་ལ་ཚེས་གཏོར་འབུལ་རྒྱུའི་སྐོར་དང་། ཟླ་རེར་ཡར་ངོ་མར་ངོའི་ཚེས་བཅུའི་སྐོར་སོགས་དུས་མཆོད་བརྒྱད་རེ་སྟེ་ཆོ་ག་ཕལ་ཆེ་བ་ཀུན་གཟིགས་ལྔ་བའི་སྐབས་ཀྱི་རྣམ་རྒྱལ་གྲྭ་ཚང་གི་ཕྱག་ལེན་ལྟར་བཙུགས། ཕྱིས་སུ་ཚེས་གཏོར་སྐོར་ནི་པཎ་ཆེན་བློ་བཟང་ཆོས་རྒྱན་གྱི་ཕྱག་ལེན་ལྟར་བཙུགས་པའོ། །ལོ་རེ་བཞིན་ལྷ་མོའི་མདོས་ཆེན་བཙུགས་ཏེ་ཆོས་རྗེ་རང་ཉིད་ཚོགས་དབུར་མཛད་ནས་འཆམ་དང་གཏོར་རྒྱག་སོགས་གནང་བ་དང་། དེའི་ཕྱག་སྲོལ་ད་ལྟའི་བར་མ་ཉམས་པར་གནས་ཡོད།[page 8]" },
        { "cell": "latin-in-native", "text": "འོན་ཀྱང་ཆོས་རྗེ་ངག་དབང་ཕུན་ཚོགས་ཀྱི་ཡབ་ཧོར་ནམ་མཁའ་རྒྱལ་མཚན་སྙན་གྲགས་ཆེ་བ་དང་ཆོས་རྗེ་ཉིད་སྐུ་ན་གཞོན་སྟབས། དགོན་སྡེ་བཅུ་གསུམ་འདེབས་པའི་སྐབས་སུ་ཪྙིང་མ་དང་བཀའ་བརྒྱུད། བོན་པོ་སོགས་ཀྱི་དགོས་གནས་མང་པོ་གཏོར་ཏེ་གྲུབ་མཐའ་དགེ་ལུགས་པར་བསྒྱུར་ནས་བཙན་དྲག་མང་དུ་མཛད་པའི་སྟབས་ཀྱིས་དགོན་གནས་དེ་དག་གི་ཆོས་སྐྱོང་གི་གནོད་པ་ཡིན་ནམ། ཧོར་གྱི་དགོན་ཁག་འདི་རྣམས་སུ་སྐྱིད་སྡུག་གང་གི་ཐད་ལའང་ནང་མི་མཐུན་པ་དང་། ལྷག་པར་དུ་དཀར་མཛེས་དགོན་འདིའི་དང་དུ་བཀྲ་མི་ཤིས་པ་ཤིན་ཏུ་མང་ཞིང་དབང་ཤེད་ཆེ་བ་དག་གིས་འཐབ་རྩོད་དཀྲུགས་ཤིང་བྱེད་པ་ཤིན་ཏུ་མང་བ་སོགས་ཀྱི་གནས་ཚུལ་ལོ་རྒྱུས་ཀྱི་ཡི་གེ་རྣམས་སུ་གསལ་བ་ཇི་བཞིན་[page 9] བྲིས་པ་ཡིན། དེ་ལྟར་ཧོར་ཡུལ་ཕྱོགས་ཀྱི་བསྟན་པ་སྤྱི་དང་ལྷག་པར་དུ་དགེ་ལྡན་བསྟན་པའི་རྩ་བ་ནི་ཧོར་ཆོས་རྗེ་ངག་དབང་ཕུན་ཚོགས་དང་ཁོང་གི་ཁུ་བོ་བཀའ་བཅུ་ནམ་མཁའ་འོད་ཟེར་གཉིས་ཡིན་པ་དང་། བསྟན་པའི་སྦྱིན་བདག་གི་རྩ་བ་ཡང་ཧོར་རིགས་དཔོན་པོ་སྤྱི་དང་ལྷག་པར་དུ་ཆོས་རྗེ་ངག་དབང་ཕུན་ཚོགས་ཀྱི་ཡབ་ནམ་མཁའ་རྒྱལ་མཚན་ཡིན་པས་བཀའ་དྲིན་ལྷག་པར་ཆེ་བ་ཡིན།" },
        { "cell": "latin-in-native", "text": "མཚན་ཉིད་གྲྭ་ཚང་གི་མདོ་སྔགས་གཞུང་ལ་སློབ་གཉེར་བྱེད་པའི་ཡིག་ཆ་ནི། སེ་ར་རྗེ་བཙུན་པའི་ཡིག་ཆའི་སྟེང་ནས་སྦྱོང་བ་ཡིན། དེ་ཡང་གྲྭ་པ་མང་ཤོས་ཀྱིས་བསྡུས་གྲྭ་རིགས་ལམ་ཆུ་བ་དང་། རིགས་ལམ་འབྲིང་བ་གཉིས་ལ་སྦྱངས་པ་རྫོགས་རྗེས་དབུས་ཀྱི་གདན་ས་སེ་འབྲས་དགའ་གསུམ་གང་[page 12] རུང་ལ་ཕེབས་ཏེ་ལོ་ངོ་གསུམ་བཞི་ཙམ་ལ་དེ་གར་གཞུང་ལ་སྦྱངས་པ་བྱས་ཏེ་ཕྱིར་རང་དགོན་དུ་ཕེབས་ཏེ་བཞུགས་པ་ཡིན། གྲྭ་པ་ཉུང་ཤས་ཤིག་གིས་དབུས་གཙང་དུ་ལོ་ངོ་དུ་མའི་རིང་ལ་གཞུང་བཀའ་པོད་ལྔ་ལ་ཞིབ་ཏུ་སྦྱངས་ནས་དགེ་བཤེས་སོགས་ཀྱི་མཚན་རྟགས་ལེན་པའང་ཡོད། སྔགས་པ་གྲྭ་ཚང་གིས་དཔལ་ལྡན་རྒྱུད་སྨད་གྲྭ་ཚང་གི་ཕྱག་ལེན་ལྟར་རྒྱུད་སྡེ་སོ་སོའི་རྩ་བཤད་ཀྱི་སྒོ་ནས་འཆད་ཉན་དང་། ཁྱད་པར་དུ་གར་ཐིག་དབྱངས་གསུམ་སོགས་ལ་སྦྱངས་ཏེ་ལམ་རིམ་གཉིས་ལ་ཉམས་ལེན་བྱེད་པ་ཡིན། རྣམ་རྒྱལ་གྲྭ་ཚང་གིས་གཙོ་བོ་སྐུ་རིམ་ཞབས་བརྟན་དང་། བསྐང་གསོ། ལྷ་མོའི་མདོས་ཆེན་སོགས་འདོན་ཆོས་སྐོར་ལ་རྦུངས་བརྩོན་བྱེད། བཤད་སྲོལ་ལ་མདོ་སྔགས་གྲྭ་ཚང་གསུམ་འབྲེལ་བར་བཤད་ཀྱང་སྔགས་པ་གྲྭ་ཚང་གི་གྲྭ་མང་གིས་གྲྭ་ཇ་སོགས་སྔགས་པ་གྲྭ་ཚང་དུ་ཕེབས་ཀྱི་ཡོད།" },
        { "cell": "latin-in-native", "text": "རྒྱུ་ཤིང་ལས་གྲུབ་པའི་དབྱེན་འདུམ་མཆོད་རྟེན་ཁང་བརྩེགས་གཅིག་ཅན་དང་། གཟིགས་རྒྱབ་གཤིམས་ཁང་དུ་རྗེ་ཡབ་སྲས་སྐུ། གྲུབ་ཐོབ་བརྒྱད་ཅུའི་སྨན་སྐུ། རོང་ཚའི་གཟིམས་ཆུང་ནང་བྱམས་པ། རིགས་གསུམ་མགོན་པོ། གཞན་ཡང་གསེར་ཟངས་ལི་སྐུ་སྣ་ཚོགས་ལྔ་བརྒྱ་ལྷག ཞལ་ཐང་སྐོར་ལ་གསང་བདེ་འཇིགས་གསུམ། ཙོང་ཁ་བརྒྱད་ཅུ། ལྷ་མོ། རྟ་མགྲིན། དུས་གསུམ་སངས་རྒྱས། དཔག་བསམ་ཁྲི་ཤིང་། རྒྱན་དྲུག་མཆོག་གཉིས། གྲུབ་ཐོབ་བརྒྱད་ཅུ། གནས་བརྟན་བཅུ་དྲུག་རྒྱལ་དབང་[page 14] དང་པཎ་ཆེན་སྐུ་ཕྲེང་རིམ་བྱོན་སོགས་ཀྱི་གྱན་ཐང་། གསུང་རྟེན་སྐོར་ལ་སྡེ་དགེ་པར་མའི་བཀའ་འགྱུར་དང་བསྟན་འགྱུར། རྗེ་ཡབ་སྲས་བཀའ་འབུམ། ལམ་བྲག་གསུང་འབུམ། པཎ་ཆེན་ཆོས་རྒྱན་བཀའ་འབུམ། བཀའ་ཆེན་ཡེ་ཤེས་རྒྱལ་མཚན་གྱི་བཀའ་འབུམ། རྒྱལ་བ་བསྐལ་བཟང་རྒྱ་མཚོའི་བཀའ་འབུམ། གུང་ཐང་། ཁྲི་ཆེན་ངག་དབང་ཆོས་ལྡན། ཐུབ་བསྟན་ཆོས་ཀྱི་ཉི་མ། ལྕང་སྐྱ་རོལ་པའི་རྡོ་རྗེ་སོགས་ཀྱི་བཀའ་འབུམ། དམིགས་བརྩེ་མའི་བེའུ་བུམ་པོད་གསུམ། རྡོ་དྲིལ་ཆ་ཚང་བརྒྱ་དང་ལྔ་བཅུ་བཅས་མཐའ་ཡས་པ་བཞུགས།" },
        { "cell": "latin-in-native", "text": "བཞི་པ་རྣམ་རྒྱལ་གྲྭ་ཚང་གི་རྟེན་གཙོ་སྨན་སྐུ་ཐུབ་པ་ཚུལ་ཁྲིམས་མ་བྱིན་ཅན། དུས་གསུམ་སངས་རྒྱས། རྗེ་ཡབ་སྲས། འཇིགས་བྱེད་སོགས་ཡི་དམ་སྐོར་དང་། མགོན་ཆོས་རྒྱལ་རྟ་མགྲིན་སོགས་སྲུང་མའི་སྐོར། ལྷ་མོའི་སྐུ་ཐོག་བརྩེགས་གཉིས་ཅན། ཙོང་ཁ་བརྒྱད་ཅུ། དཔག་བསམ་འཁྲི་ཤིང་། གསེར་བྲིས་སངས་རྒྱས་སྟོང་སྐུ་སོགས་ཞལ་ཐང་བརྒྱ་དང་ལྔ་བཅུ་ལྷག གཞན་ཡང་རྣམ་རྒྱལ་མཆོད་[page 15] རྟེན། མ་ཎི་དུང་འཁོར། གདུགས་དཀར་དུར་འཁོར། བླ་མ་བཤེས་གཉེན་རྣམས་ཀྱི་སྐུ་གདུང་མཆོད་རྟེན་བཅུ་གཅིག་ལྷག གསུང་རབ་སྐོར་ལ། བཀའ་འགྱུར་གཅིག རྗེ་ཡབ་སྲས་གསུང་འབུམ། ཧོར་ཆོས་རྗེའི་གསུང་འབུམ། བརྒྱད་སྟོང་གསེར་བྲིས་སོགས་ཞིབ་ཏུ་བྲི་བར་མི་ནུས་སོ།།" },
        { "cell": "latin-in-native", "text": "དེང་སྐབས་གསར་དུ་བཙུགས་པའི་དགོན་པའི་བདག་གཉེར་དོ་དམ་ཚན་ཁག་ནི། དམངས་[page 18] གཙོའི་རང་བཞིན་ལྡན་པའི་རྩ་འཛུགས་ཤིག་ཡིན། བདག་གཉེར་ཨུ་ཡོན་རྣམས་འདེམ་བསྐོ་བྱ་ཚུལ་ནི། དགོན་པའི་བདག་གཉེར་བ་དང་། ཁང་ཚན། དགེ་རྒན་རྣམས་འཚོགས་ནས་གཙོ་བོ་མི་ནུས་པ་ཅན་དང་གཞུང་དྲང་པོ་ཡིན་པ་རྣམས་འདམ། དེ་རྗེས་འདེམས་ཤོག་འཕེན་པ་དང་ལག་པ་ཡར་བཀྱགས་པའི་བྱེད་ཐབས་ལ་བརྟེན་ནས་མང་ཉུང་དང་བསྟུན་ཏེ་གཏན་ཕབ་བྱེད་པ་ཡིན། གྲྭ་པའི་སྒྲིག་ལམ་གྱི་སྐོར་ཚང་མ་ཆོས་འདུལ་བ་དང་དགོན་པའི་ནང་ཁྲིམས་ཇི་བཞིན་སྲུང་དགོས་པ་ཡིན། བླ་སྤྲུལ་སུ་ཡིན་ཡང་དམིགས་བསལ་གང་ཡང་མེད། དགོན་པའི་ཆོས་ཕྱོགས་དང་གཞན་པའི་བྱ་ལས་ཚང་མ་བདག་གཉེར་ཚན་ཁག་གི་མི་རྣམས་ཚོགས་ནས་ཐག་གཅོད་པ་ཡིན། དམིགས་བསལ་ཆབ་སྲིད་དང་འབྲེལ་བ་ཡོད་པའི་གནད་དོན་རྣམས་རྫོང་ནང་བསྟན་མཐུན་ཚོགས་དང་རྫོང་ཆོས་ལུགས་ལས་དོན་ལས་ཁུངས་དང་མཉམ་འབྲེལ་བྱས་ནས་ཐག་གཅོད་པ་ཡིན།" },
        { "cell": "percent", "text": "ཧྥུའུ་ཨེར་ཅ་གཙང་པོ་ནི་ཨུ་རུ་སུའི་ནུབ་བྱང་ཁུལ་དུ་གནས་ཤིང་། གཙང་པོ་འདིའི་སྤྱིའི་རིང་ཚད་ལ་སྨི་36900ཡོད་པ་དང་ཡོ་རོབ་གླིང་གི་ཆེས་རིང་བའི་གཙང་པོ་ཡིན་པར་མ་ཟད་འཛམ་གླིང་གི་ཆེས་རིང་བའི་ནང་བཞུར་གཙང་པོར་ངོས་འཛིན་བྱེད། ཧྥུའུ་ཨེར་ཅ་གཙང་པོས་ཨུ་རུ་སུའི་རྒྱལ་དམངས་དཔལ་འབྱོར་དང་མང་ཚོགས་ཀྱི་འཚོ་བའི་ཐད་ལ་ཕན་ནུས་གལ་ཆེན་འདོན་བཞིན་ཡོད་གཤིས་ཨུ་རུ་སུའི་མིས་དེ་ལ་མ་ཡུམ་གཙང་པོ་ཞེས་འབོད། གཙང་པོ་འདི་ནི་ཡོ་རོབ་ཤར་རྒྱུད་ཀྱི་ཝེར་ཏེ་ཡི་དེའུ་འབུར་མང་པའི་མཚེའུ་ཚོགས་ཡིན་ལ། ནགས་ཚལ་ཁུལ་དང་ནགས་ཚལ་རྩྭ་ཐང་ཁུལ། རྩྭ་ཐང་ཁུལ་བཅས་བརྒྱུད་ཅིང་། གཙང་པོའི་འགྲམ་རྒྱུད་དུ་ཁྱོན་བསྡོམས་མི་གྲངས་ཁྲི་6450འཚོ་སྡོད་བྱས་ཡོད་པ་དང་དེས་ཨུ་རུ་སུ་སྤྱིའི་མི་གྲངས་ཀྱི་43%ཟིན། ཧྥུའུ་ཨེར་ཅ་གཙང་པོས་ཨུ་རུ་སུའི་རིག་གནས་དང་ལོ་རྒྱུས། དཔལ་འབྱོར་བཅས་ཀྱི་འཕེལ་རྒྱས་ལ་ཕན་ནུས་ཆེན་པོ་ཐོན་པས་ཨུ་རུ་སུའི་མིའི་སེམས་སུ་གཙང་པོ་འདིར་གོ་གནས་གལ་ཆེན་ཟིན་ཡོད།" },
        { "cell": "percent", "text": "སློབ་གྲྭས་ད་རག་བར་བསྡོམས་པས་དམའ་འབྲིང་སློབ་མ4970དང༌། མཐོ་འབྲིང་སློབ་མ2281། ལས་རིགས་འཛིན་གྲྭའི་སློབ་མ་160བསྡུས་པ་ལས་འབྲིང་རིམ་ཆེད་ལས་སློབ་གྲྭར་བསྡོམས་པས་སློབ་མ787བསྐྱལ་བ་དང༌།དེས་དམའ་འབྲིང་མཐར་ཕྱིན་སློབ་མའི22.7%ཟིན། སློབ་གྲྭ་ཆེན་མོར་སློབ་མ་1015བསྐྱལ་ལ། དེས་མཐོ་འབྲིང་མཐར་ཕྱིན་སློབ་མའི་66.6%ཟིན། 1996ལོའི་ཚུན་གྱི་ལོ་ངོ་བརྒྱད་ཀྱི་རིང་ལ་སློབ་གྲྭ་འདིས་བསྟུད་མར་འབྲིང་རིམ་དང་མཐོ་རིམ་སློབ་གྲྭར་སློབ་མ་བསྐྱལ་ཚད་ཁུལ་ཡོངས་ཀྱི་ཨང་དང་པོ་བླངས་ལ།ལོ་འདི་འགའི་རིང་ལ་ཕུལ་བྱུང་སློབ་མ900ལྷག་གིས་ཞིང་ཆེན་ཕྱི་ནང་གི་མཐོ་རིམ་དང་འབྲིང་རིམ་སློབ་གྲྭ་དག་ན་སློབ་གཉེར་བྱེད་པའི་སྒང་ཡིན།" },
        { "cell": "percent", "text": "མཚོ་སྔོན་ཞིང་ཆེན་གྱི་བསྡུས་མིང་ལ་ཆེན༼青༽ཟེར་ཞིང་། སའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི72དང་། མི་གྲངས་ཁྲི་481ཡོད། འདུས་སྡོད་བྱེད་པའི་མི་རིགས་ནི་རྒྱ་རིགས་དང་བོད་རིགས། ཧུའེ་རིགས། ཧོར་རིགས། ས་ལར་རིགས། སོག་རིགས། ཧ་སག་རིགས་སོགས་ཡིན། ཞིང་ཆེན་འདིའི་ལྟེ་གནས་གྲོང་ཁྱེར་ནི་ཟི་ལིང་ཡིན། མངའ་ཁོངས་སུ་ས་ཁུལ 1དང་། རང་སྐྱོང་ཁུལ 6 ས་ཁུལ་རིམ་པའི་གྲོང་ཁྱེར 1 རྫོང་རིམ་པའི་གྲོང་ཁྱེར 2 རྫོང 30 རང་སྐྱོང་རྫོང 7 བཅས་ཡོད། བོད་རིགས་རང་སྐྱོང་ས་ཁུལ་གྱིས་ཞིང་ཆེན་འདིའི་ས་རྒྱ་ཁྱོན་གྱི་80%ལྷག་ཟིན། བོད་རང་གི་སྲོལ་རྒྱུན་གྱི་ས་ཁོངས་དབྱེ་ཕྱོགས་ལྟར་ན་འདི་ནི་ཨ་མདོ་ཡུལ་ལ་ངོས་འཛིན།" },
        { "cell": "percent", "text": "རིམ་པ།གྲུབ་ལུགས།གྲངས་ཀབརྒྱ་ཆའི་གྲངས།༡མིང་རྐྱང༌།114229.09༢སྔོན་འཇུག+མིང་གཞི།93724.78༣མགོ་ཅན+མིང་གཞི།57714.70༤མིང་གཞི།+འདོགས་ཅན།49912.71༥སྔོན་འཇུག+མིང་གཞི+འདོགས་ཅན།2947.49༦སྔོན་འཇུག+མགོ་ཅན།+མིང་གཞི།1894.81༧མགོ་ཅན།+མིང་གཞི །+འདོགས་ཅན།1894.81༨སྔོན་འཇུག+མགོ་ཅན།+མིང་གཞི།+འདོགས་ཅན།631.60གོང་གི་སྡོམ་རྩིས་ཀྱི་རེའུ་མིག་འདི་ལས་ང་ཚོར་བསྟན་དོན།སྤྱིར་བཏང་བརྒྱ་ཆའི་30%ཙམ་བོད་ཡིག་གི་ཆེས་སླ་བའི་གསལ་བྱེད་རྐྱང་བའི་གྲུབ་ཅིང༌།བརྒྱ་ཆའི་གཉིས་ཟིན་མ་ཟིན་ཙམ་ཆེས་རྙོག་འཛིང་གི་གསལ་བྱེད་འདུས་མས་གྲུབ་པ་ཡིན་ལ།འདི་ལས་སྔོན་འཇུག་དང་མིང་གཞིའི་གྲུབ་པའི་ཡི་གེ་དེ་མགོ་འདོགས་ཀྱིས་གྲུབ་པའི་ཡི་གེ་ལས་མང་བ་འདིས་བོད་ཡིག་གི་འཕྲེད་དང་གཞུང་གི་རིས་དབྱིབས་ཀྱིས་གྲུབ་པའི་ཁྱད་པར་ཤེས་ཐུབ།" },
        { "cell": "percent", "text": "ཡིག་རྟགས་ཀྱི་རིང་ཚད།བོད་ཡིག་གི་གྲངས་ཀརྒྱུགས་ཚད།(བརྒྱ་ཆའི་གྲངས%)1300.76240210.243128732.784143636.58563616.2061233.137120.31གོང་གི་སྡོམ་རྩིས་ཀྱིས་བསྟན་དོན༌།ཡི་གེ་གསུམ་དང་བཞིའི་གྲུབ་པའི་བོད་ཡིག་ནི་ཡི་གེ་གཞན་པའི་གྲུབ་ལུགས་ཀྱི་ལྡབ་བརྒྱ་འགྱུར་གྱིས་མང་ལ།ཡི་གེ་གསུམ་དང་བཞིའི་གྲུབ་པའི་བོད་ཡིག་ནི་རིང་ཚད་ཡི་གེ་སྤྱིའི་བརྒྱ་ཆའི་69.36%ཟིན་ཡོད་པ་འདིས་བོད་མིའི་བློ་གྲོས་ཀྱི་རྩལ་སྟེ།མང་ན་ཉོག་ཅིང་ཉུང་ན་མིང་གི་ཁྱད་པར་འབྱེད་དཀའ་བའི་ཁྱད་ཆོས་ཀྱང་མངོན་ཡོད།།" },
        { "cell": "percent", "text": "སྤྱི་ལོ་ 2020.6 པར་མི་འབོར་བསྐྱར་ཞིབ་ལྟར་ན་མི་གྲངས་ 92,900 སྟེ་འབུམ་ལ་ཉེ་བ་ཡོད་ཅིང་། དེ་དག་ལས་བརྒྱ་ཆ་ 95%བོད་རིགས་དང་། གཞན་དག་ནི་ཧན་རིགས་ (Han 汉族) དང་། ཁ་ཛག་རིགས། (Kazak 哈萨克族) ན་ཤིའི་རིགས། (Naxi 纳西族) ཧུའི་རིགས། (Hui 回族) བའི་རིགས། (Bai 白族) མན་ཆུའི་རིགས། (Manchu,满族) ཡིའི་རིགས། (Yi 彝族) ཏུ་ཇི་ཡ་ཡི་རིགས་Tujia 土家族) སོགས་ཡོད།" },
        { "cell": "percent", "text": "སྤྱི་ལོ2014ལོའི་ཟླ་མཇུག་བར། འབར་ཁམས་གྲོང་ཁྱེར་གྱི་སྤྱིའི་མི་གྲངས་ཁྲི56166ཡོད་ལ། སྤྱིའི་མི་གྲངས་ཁྲོད་སྐྱེས་པའི་མི་གྲངས་ཁྲི28862ཡོད་པ་དང་རྒྱུན་སྡོད་མི་གྲངས་ཀྱི52.5%ཟིན་ཡོད། སྐྱེས་མའི་མི་གྲངས་ཁྲི27304ཡོད་པ་དང་རྒྱུན་སྡོད་མི་གྲངས་ཀྱི47.5﹪ཟིན་ཡོད། དེ་ཡང་བོད་རིགས་མི་གྲངས་ཁྲི43103ཡོད་པ་དང་རྒྱུན་སྡོད་མི་གྲངས་ཀྱི72.7﹪ཟིན་ཡོད། ཆའང་རིགས་མི་གྲངས1659ཡོད་པ་དང་རྒྱུན་སྡོད་མི་གྲངས་ཀྱི2.6﹪ཟིན་ཡོད། རྒྱ་རིགས་མི་གྲངས་ཁྲི1053ཡོད་པ་དང་རྒྱུན་སྡོད་མི་གྲངས་ཀྱི23.1﹪ཟིན་ཡོད། མི་རིགས་གཞན་པའི་མི་གྲངས959ཡོད་པ་དང་རྒྱུན་སྡོད་མི་གྲངས1.6﹪ཟིན་ཡོད།" },
        { "cell": "percent", "text": "དཔལ་འབྱོར་གྱི་གྱོང་གུད་ཀྱང་ཧ་ཅང་ལྕི་བ་སྟེ་ལོ་རེའི་ཐོན་སྐྱེད་ཡོང་འབབ་བརྒྱ་ཆ་70% ཙམ་མར་ཆགས། ཀོ་རི་ཡའི་དམག་འཁྲུག་འདི་ནི་ཨ་རི་དང་ཨུ་རུ་སུ་སྤྱི་མཐུན་རྒྱལ་ཁབ་གཉིས་ཀྱི་བར་དུ་ལངས་བའི་གྲང་དམག་སྐབས་ཀྱི་དམག་འཁྲུག་དང་པོ་དེ་ཡིན་ཞིང་འདི་ལ་ཚབ་མཚོན་དམག་འཁྲུག་དང་ནང་འཁྲུག་སོགས་ཕྱོགས་སོ་སོ་ནས་མིང་མི་འདྲ་བ་མང་པོ་བཏགས་ཡོད་པ་རེད། སྤྱི་ལོ་ 1953 ལོའི་ཟླ་ 7 ཚེས་ 27 ཉིན་དམག་འཁྲུག་མཚམས་འཇོག་གི་ཆིངས་ཡིག་བཞག་ནའང་ལྷོ་བྱང་གཉིས་ཀྱི་རྙོག་དྲ་མུ་མཐུད་དུ་གནས།" },
        { "cell": "rate", "text": "འཐེན་ཤུགས་ལ་བརྟེན་པའི་མྱུར་སྣོན་ (ཨིན་སྐད་: Gravitational acceleration) ―― རང་ལྷུང་གི་དངོས་པོ་ཞིག་གི་མྱུར་སྣོན། སའི་གོ་ལའི་ཕྱི་ངོས་ཀྱི་ཉེ་འགྲམ་དུ་མྱུར་སྣོན་གྱི་གྲངས་ འབོར་ནི་ ༩.༨m/s༢ ཡིན།" },
        { "cell": "zero-width", "text": "རེའུ་​མིག་​འདི་​ནི་​རྒྱལ་​དབང་​ལྔ་​པའི་​དེབ་​ཐེར་​ལྟར་​བཀོད་​པ་​ཡིན་​ལ།" },
        { "cell": "zero-width", "text": "སྐྱིད་​ཤོད་​སྡེ་​པ་​ཆོས་​རྗེ་​རང་​གི་​རྣམ་​ཐར་​ལས་​གཡུལ་​རྒྱལ་​ནོར་​བུ་​ལ་​སྲས་​བསོད་​ནམས་​རྒྱལ་​མཚན། ཡིད་​བཞིན་​ནོར་​བུ། སྲས་​པོ་​རབ་​བརྟན། ཆོས་​རྗེ་​རང་​ཉིད་​བཅས་​སྲས་​བཞི་​ཡོད་​པར་​གསུངས།" },
        { "cell": "zero-width", "text": "སྡེ་​པ་​སྟག་​རྩེ་​པ་​ལྷ་​རྒྱལ་​རབ་​བརྟན་​ནི་​རྡོ་​རྗེ་​རྣམ་​རྒྱལ་​གྱི་​སྲས་​ཡིན་​པར་​མི་​དབང་​བཤད་​སྒྲ་​པས་​མཛད་​པའི་​བསམ་​ཡས་​དཀར་​ཆག་​ལས་​གོ་​ཐུབ།" },
        { "cell": "zero-width", "text": "རྡོ་རྗེ་སེམས་དཔའ​་ནི་ནང་པ་སངས་རྒྱངས་ཀྱི་ལྷ་གཅིག་རེད། གསང་སྔགས 1 སྡིག་སྒྲིབ་སྦྱོང་བ་ལ་ས་ཕྱོད་ཤིན་ཏུ་ཆེ་བའི་ཡི་དམ་ཞིག ཕྱག་གཡས་རྡོ་རྗེ་སྙིང་གར་གསོར་ཤིང༌། གཡོན་པའི་དྲིལ་བུ་དཀུ་ལ་བརྟེན་པ། ཞབས་གཉིས་སྐྱིལ་མོ་ཀྲུང་གིས་བཞུགས་པ། སྐུ་མདོག་དཀར་གསལ་ཟླ་བའི་མདོག་ཅན། དེ་ལ་ལྷ་ཡབ་རྐྱང་དང༌། ཡུམ་བཅས་གཉིས་ཡོད། 2 རྒྱལ་བ་རྡོ་རྗེ་འཆང་ལའང་འཇུག་པའི་སྐབས་མང་པོ་ཡོད། རྗེའི་གསང་འདུས་བསྐྱེད་རིམ་གྱི་ཟིན་བྲིས་ལས། མདོར་བྱས་སུ། རེག་བྱ་རྡོ་རྗེ་ཉིད་དང་ནི། །རྡོ་རྗེ་སེམས་དཔའ་དང་ལྡན་གནས། །ཞེས་གསུངས་ཤིང་རྡོ་རྗེ་སེམས་དཔའ་ནི་རྡོ་རྗེ་འཆང་ངོ༌། །ཞེས་གསུངས་པ་དང་། མཁས་གྲུབ་ཆོས་རྗེའི་བསྐྱེད་རིམ་དངོས་གྲུབ་རྒྱ་མཚོ་༡༧བ༤ལས། བླ་མ་རྡོ་རྗེ་སེམས་དཔའ་ལྟར་འགྱིང་བག་ཅན་རྒྱན་ཐམས་ཅད་ཀྱིས་བརྒྱན་ནས་བཞུགས་པ་གསལ་བར་བལྟས་ལ། ཞེས་བླ་མ་རྡོ་རྗེ་འཆང་དུ་བསྒོམ་པར་གསུངས་པས། ཞེས་གསུངས་སོ། །སྒྲ་བཤད་ནི། བདེ་སྟོང་དབྱེར་མེད་ཀྱི་ཡེ་ཤེས་ཀྱི་དཔལ་དང་ལྡན་པའི་ཟུང་འཇུག་ནི་ངེས་དོན་གྱི་རྡོ་རྗེ་དང༌། དེ་ཉིད་གཟུགས་སྐུའི་རྣམ་པར་ཤར་བས་ན་སེམས་དཔའོ། །གཞན་ཡང་། བདེ་མཆོག་རྫོགས་རིམ་དངོས་གྲུབ་སྙེ་མ་༦༡ན༢ལས། འགྲོ་བའི་འདྲེན་མཆོག་རྡོ་རྗེ་སེམས་དཔའ་དེ། །དམིགས་མེད་བརྩེ་བས་ཀུན་ནས་བསྐྱེད་པ་ཡིས། །གདུལ་བྱའི་དབང་པོའི་རིམ་པ་ཇི་བཞིན་དུ། །མདོ་དང་བྱ་བ་སྤྱོད་པ་རྣལ་འབྱོར་དང་། གསང་མཐའ་རྣལ་འབྱོར་བླ་མེད་རྒྱུད་རྣམས་གསུངས། །ཞེས་གསུངས་པ་ལྟར་རོ། །" },
        { "cell": "zero-width", "text": "ནའུ་རུ་(Nauru)ནི་རྒྱ་མཚོ་ཆེན་པོའི་གླིང་ཆེན་གྱི་རྒྱལ་ཁབ་ཞིག་རེད། དེའི་རྒྱལ་ས་ནི་ཡ་རེན​་རེད།" },
        { "cell": "zero-width", "text": "ཧྥེ་ཧྥེ་ཡི་གདོང་དབྱིབས་ཁྱད་པར་ཅན་དུ་སྣང་ཡང་། དེ་ནི་སྤྲེལ་རིགས་ཀྱི་བྱེ་བྲག་ཅིག་ཡིན། ཨ་ཧྥེ་རི་ཁ་གླིང་ཆེན་དང་ཨ་རབ་གླིང་ཕྲན་ཕྱེད་མ་ཁོ་ནར་ཁྱབ་ཡོད། དེ་དག་ནགས་ཚལ་ལས་བྲལ་ཏེ་སྡོང་ཚོམ་དང་བྲག་རི། བྱེ་ཐང་དང་སྤང་ཐང་འདྲེས་མཚམས་སུ་གནས་བཅའ​། ཕོ་མོ་དང་ཕྲུ་གུ་མཉམ་དུ་ཁྱུ་ཚོའི་འཚོ་བ་སྐྱེལ། སྤྲེལ་ཁྱུའི་ནང་སྤྲེལ་རྒྱལ་གཅིག་དང་གཞོན་པ་འགའ་ཤས་ཡོད། ཉིན་དཀར་གཟན་འཚོལ་བར་འགྲོ་ཞིང་། མཚན་མོ་ཚང་དུ་ལོག་ནས་ངལ་གསོ་བྱེད། ཧྥེ་ཧྥེ་ཡིས་གཙོ་བོ་རྩི་ཤིང་གི་ས་བོན་། རྩངས་པ་དང་འབུ་སྲིན་སོགས་གཟན་དུ་བརྟེན།" },
        { "cell": "zero-width", "text": "ཀྲོའུ་ཝུའུ་ཝང་(རྒྱ་སྐད།: 周武王)ནི་ཝུན་ཝང་གི་སྲས་ཡིན། ཁོང་གིས་ཡབ་ཀྱི་ཁྲི་བཟུང་དུས་ཧྲང་བསྣུབ་པའི་ཆ་རྐྱེན་འཛོམས་ཡོད་ན་ཡང་ཁོང་གིས་སྔར་བཞིན་སེམས་ཆུང་བྱས། དེ་ནས་ཡང་ལོ་༡༠ལ་གྲ་སྒྲིག་བྱས་རྗེས་ས་གཟོད་ཁྲའོ་ཀོ་ལ་དམག་དྲང་ས་ཏེ། མུའུ་ཡེ་ནས་ཀྲོའུ་ཝང་དང་རྒྱལ་ཕམ་འགྱེད་པའི་གཡུལ་བཤམས། སྐབས་དེར་ཧང་རྒྱལ་རབས་ནི་ཁ་ཐོར་སྣ་ཐོར་དུ་སོང་ཡོད། གཡུལ་འགྱེད་ཀྱི་མགོ་བརྩམས་མ་ཐག ཝུའུ་ཝང་གིས་འཐབ་འཁོར་ཤིང་རྟ་༣༠༠དང་དཔའ་ཐུལ་༣༠༠༠གི་སྣེ་དྲངས་ཏེ་ཀྲོའུ་ཝང་ལ་དྲག་རྒོལ་བྱས་པར​། ཀྲོའུ་ཝང་གིས་འགོག་མ་ཐུབ་པར་ཕྱིར་ཕོ་བྲང་དུ་བྲོས་ཤིང་། ལུའུ་ཐའེ་ནས་རང་ཉིད་མེ་རུ་བསྲེགས་ཏེ་ཤི། དེ་ནས་དབྱིན་ཧྲང་གི་དབང་སྒྱུར་མཇུག་རྫོགས་སོང་བ་རེད།" },
        { "cell": "zero-width", "text": "སུང་ཐའེ་ཙུའུ་(༩༢༧-༩༧༥)(རྒྱ་སྐད།: 宋太祖)ཀྲའོ་ཁོང་དབྱིན་(རྒྱ་སྐད།: 赵匡胤)ནི་སུང་རྒྱལ་རབས་ཀྱི་རྒྱལ་ཁབ་འཛུགས་ལཁན་གོང་མཡིན​། ཁོང་ནི་མ་གཞིར་ཀྲོའུ་ཕྱི་མའི་དམག་དཔོན་ཆེན་མོ་ཞིག་ཡིན་ལ་ཀྲོའུ་ཧྲི་ཙུང་གིས་ཡིན་ཆེས་བརྟན་པོ་བྱེད། ཀྲོའུ་ཧྲི་ཙུང་གྲོངས་རྗེས། ཁོང་གིས་ཁྲེན་ཆའོ་ས་ཆར་དམག་འགྱུར་བསླངས་ནས་རང་ཉིད་གོང་མ་མཛད་དེ་སུང་རྒྱལ་རབས་བཙུགས། ཁོང་གིས་དམག་འགྱུར་ལ་བརྟེན་ནས་སྲིད་དབང་བླངས་པ་ཡིན་པས། སྲིད་དབང་བཅད་བཟུང་དང་དམག་དཔོན་གྱིས་སྒེར་གཅོད་བྱེད་པ་སོགས་ཀྱི་ཉེན་ཁ་གསལ་བོར་མཁྱེན་གྱིན་ཡོད་པར་བརྟེན། གོང་མརྒྱལ་པོ་བྱས་ནས་ལོ་ངོ་གཅིག་ཀྱང་མ་འགོར་པར། གསོལ་སྟོན་མཚན་གསོལ་ལམིང་གཡར་ནས་དྲིན་གཟོ་དང་དྲག་ཤུལ་སྦྲགས་མར་སྤྱད་དེ་དམག་དཔོན་འགའ་ཞིག་ལ་དམག་དབང་སྤྲོད་དུ་བཅུག་པ་ལ། ལོ་རྒྱུས་སྟེང་དུ་\"ཆང་ཕོར་བཏེགས་ནས་དམག་དབང་བླངས་\"ཞེས་སུ་བརྗོད། དུས་དེ་ནས་བཟུང་སྲིད་དབང་དང་དམག་དབང་། ནོར་དབང་སོགས་ཚང་མ་དབུས་སྲིད་དུ་དབང་བར་མཛད་དེ་དབུས་སྲིད་དུ་དབང་ཆ་གཅིག་སྡུད་བྱེད་པའི་ལམ་ལུགས་ལ་ཤུགས་སྣོན་མཛད།" },
        { "cell": "roman", "text": "དབྱིན་ཡིག་གི (Washington) ཟེར་བ་འདི་ཐད་ཀར་བོད་ཡིག་ཏུ་བསྒྱུར་ན་ཝ་ཤིང་ཊོན་ཞེས་པའི་སྒྲ་གདངས་འདི་ཐོན། འོན་ཀྱང་དེ་རྒྱ་ཡིག་ལ་བསྒྱུར་ནས། རྒྱ་ཡིག་དེ་བོད་ཡིག་ལ་བསྒྱུར་ན་ཧྭ་ཤིན་ཀྲོན་ནམ་ཡང་ན་ཝ་ཧྲིང་ཏོན་ལྟ་བུ་ཞིག་ཐོན། གང་ལྟར་འདི་ནི་དེང་སང་ཨ་རིའི་རྒྱལ་ཕྲན་མཉམ་འབྲེལ་རྒྱལ་ཁབ་ཀྱི་རྒྱལ་ས་རེད། ཡང་འདི་ལ་དབྱིན་ཡིག་ནང Washington DC, ཟེར་ནས་བྲིས་ཡོད། དེ་ནི (District of Columbia) ཟེར་བ་དེའི་བསྡུས་ཚིག་རེད། དེ་ནི་མ་རེ་ལེན་ཊི་(Maryland) མངའ་སྡེ་དང་། བེར་ཇེའུ་ནེ་ཡ་(Virginia) མངའ་སྡེ་གཉིས་ཀྱིས་ས་ཆ་ཤས་རེ་སྤྲད་ནས་ཁུལ་ལྟ་བུ་ཞིག་བཟོས་པ་དེའི་དོན་རེད།" },
        { "cell": "roman", "text": "Intel ཀུང་ཟི་ནི་འཛམ་གླིང་ཐོག་ཆེས་སྐད་གྲགས་མཐོ་བའི་བཟོ་གྲྭ་ཞིག་ཡིན་ཏེ 1968 ལོར་དབུ་བརྙེས། དོན་དུ་བཟོ་གྲྭ་འདིས་བཟོས་པའི་གློག་རྫས་ལ་ཚན་རིག་རང་བཞིན་གྱི་ཁྱད་ཆོས་ལྡན་པས་ཚོང་རྭ་སོ་སོས་དགའ་བསུ་ཆེན་པོ་བྱེད་ཀྱིན་ཡོད། 1971ལོར་འཛམ་གླིང་སྟེང་ཆེས་ཕྲ་བའིCPUགསར་གཏོད་བྱས་པ་དེས་ཀུང་ཟིའི་འབྱུང་འགྱུར་ལ་སྔ་ན་མེད་པའི་རྨང་གཞི་ཞིག་བསྐྲུན། དེར་བརྟེན1997ལོར། Intel ཀུང་ཟིས་སླར་ཡངPentium MMX CPU གསར་གཏོད་བྱས་པས་དེའི་བཟོ་རྩལ་ནི་སྔར་ལས་ཁྱད་དུ་འཕགས་ལ། བྱེད་ནུས་སོགས་ལྡབ་འགྱུར་གྱིས་འཕེལ་རྒྱས་བྱུང་བས་ཀུན་གྱིས་གདེང་འཇོག་ཚད་མེད་བྱོས། དེ་བཞིན་ཕུལ་དུ་བྱུང་བའི་གྲུབ་འབྲས་ཁྲོད།Intel ཀུང་ཟིས་སྔ་གཞུག་ཏུ Pentium 2 དང Pentium3 Pentium4 Pentium D སོགས་མང་པོ་བཏོན་ལ། མིག་སྔར་ཆེས་བཟང་པའི CPU ནི་སྲོག་གཉིས་རང་བཞིན་གྱི Core 2 སྐོར་ཡིན།" },
        { "cell": "roman", "text": "དཔེར་ན། ཟངས་མེ་རུ་བསྲེག་ཚེ། འཚོ་རླུང་དང་འདུས་ཏེ་ཟངས་(II)འཚོ་ལྡན་གྲུབ་ཐུབ། ཟངས་འཚོ་ལྡན་ནི་མདོག་ནག་པོ་ཞིག་ཡིན།" },
        { "cell": "roman", "text": "༢༠༠༨ལོའི་པེ་ཅིང་གི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་༼དབྱིན་ཇིའི་སྐད།: the Games of the XXIX Olympiad༽ནི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་ཞིག་རེད། དུས་ཚོད། ༢༠༠༨ལོའི་ཟླ་༨ཚེས་༨ཉིན་ནས་ཟླ་༨ཚེས་༢༤ཉིན་བར། སགནས། ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་རྒྱལ་ས་པེ་ཅིང་གྲོང་ཁྱེར།" },
        { "cell": "roman", "text": "༢༠༡༢ལོའི་ལོན་ཊོན་གྱི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་༼དབྱིན་ཇིའི་སྐད།: the Games of the XXX Olympiad༽ནི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་ཞིག་རེད། དུས་ཚོད། ༢༠༡༢ལོའི་ཟླ་༧ཚེས་༢༧ཉིན་ནས་ཟླ་༨ཚེས་༡༢ཉིན་བར། སགནས། དབྱིན་ཇིའི་རྒྱལ་ས་ལོན་ཊོན་གྲོང་ཁྱེར།" },
        { "cell": "roman", "text": "༢༠༡༦ལོའི་རིའོ་ཌེ་ཇ་ནེའུ་རའོའི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་༼དབྱིན་ཇིའི་སྐད།: the Games of the XXXI Olympiad༽ནི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་ཞིག་རེད། དུས་ཚོད། ༢༠༡༦ལོའི་ཟླ་༨ཚེས་༥ཉིན་ནས་ཟླ་༨ཚེས་༢༡ཉིན་བར། སགནས། པུ་རུ་ཟིལ་གྱི་རིའོ་ཌེ་ཇ་ནེའུ་རའོ།" },
        { "cell": "roman", "text": "༢༠༡༦ལོའི་ཕྱེང་ཆང་ཀྱི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་༼དབྱིན་ཇིའི་སྐད།: the XXIII Olympic Winter Games༽ནི་དགུན་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་ཞིག་རེད། དུས་ཚོད། ༢༠༡༨ལོའི་ཟླ་༢ཚེས་༩ཉིན་ནས་ཟླ་༢ཚེས་༢༥ཉིན་བར། སགནས། ལྷོ་ཀོ་རི་ཡའི་ཕྱེང་ཆང།" },
        { "cell": "roman", "text": "༢༠༡༤ལོའི་སོ་ཆིའི་དབྱར་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་༼དབྱིན་ཇིའི་སྐད།: the XXII Olympic Winter Games༽ནི་དགུན་ཁའི་ཨའོ་ལིན་ཕིག་ལུས་རྩལ་འགྲན་ཚོགས་ཞིག་རེད། དུས་ཚོད། ༢༠༡༤ལོའི་ཟླ་༢ཚེས་༧ཉིན་ནས་ཟླ་༢ཚེས་༢༣ཉིན་བར། སགནས། ཨུ་རུ་སུའི་སོ་ཆི།" },
        { "cell": "initialism", "text": "ཕ་ཀི་སི་ཐན་(Pākistān)ཞེས་པའི་མིང་དེ་ནི་ཕིར་ཞི་ཡ་དང་ཡུར་དྲུ་གཉིས་ཀྱི་སྐད་ཡིག་ནང་དྭངས་གཙང་གི་ཡུལ་ཞེས་པའི་དོན་ཡིན། ལྷོ་དབུས་ཨེ་ཤ་ཡའི་རྒྱལ་ཁབ་རྣམས་དང་མངའ་ཁུལ་མང་པོ་ཞིག་གི་མཇུག་ཏུ་སི་ཐན་(stan)ཞེས་པའི་ཡིག་འབྲུ་འདི་ཡོད། དཔེར་ན་ཨབ་གྷན་སི་ཐན་དང་ཕ་ཀི་སི་ཐན། བྷ་ལུ་ཆི་སི་ཐན། ཁུར་དྲི་སི་ཐན། ཏུར་ཀི་སི་ཐན་ལྟ་བུ་ཡིན། ཡིག་འབྲུ་དེ་ནི་སྡོད་པ་དང་གནས་པ་ཡི་དོན་སྟོན་པའི་སི་ཐ་(STA)ཞེས་པའི་ཨི་རག་སྐད་ཡིག་གི་ཡིག་འབྲུ་དེ་རྩ་བ་བྱས་ནས་གྲུབ་པ་ཡིན་ལ། དེ་ནི་ས་ཆ་(མི་སྡོད་སའི་གནས།)དང་ཕ་ཡུལ་དང་རྒྱལ་ཁབ་ཅེས་པའི་དོན་ལ་གོ།" },
        { "cell": "initialism", "text": "སྤྱི་ལོ༢༠༠༥ལོའི་ཟླ༡༢པའི་ནང་སྲིད་འཛིན་ལོ་ཧཱ་མི་ཌི་ཀར་ཛཱ་ལགས་དམངས་གཙོའི་ལམ་ནས་འོས་འདེམ་བྱས་པའི་ཨབ་གྷན་གྱི་སྲིད་འཛིན་ཐེངས་དང་པོ་དེ་ཆགས་ཡོད། འཛམ་གླིང་དམག་ཆེན་གཉིས་པའི་རྗེས་སུ་བཙུགས་པའི་ཚོགས་པ་ནུབ་གླིང་རྒྱ་མཚོ་བྱང་མའི་དམག་དོན་སྒྲིག་འཛུགས(NATO)ཀྱིས་ཨབ་གྷན་གྱི་དམག་སྡེ་དང་གཞུང་གི་སྒྲིག་འཛུགས། སློབ་གྲྭ་དང་སློབ་ཆེན་ཁག་གསར་འཛུགས་བྱས། ད་དུང་བུད་མེད་ཀྱི་ཐོབ་ཐང་དང་ཤེས་ཡོན། ལས་རིགས་སོགས་གོང་འཕེལ་དུ་བཏང་། ཨབ་གྷན་གྱི་བུད་མེད་མང་པོ་ཆབ་སྲིད་པ་དང་བློན་ཆེན་གྱི་ཕྱག་ལས་གནང་བཞིན་ཡོད་ཅིང་། ཚོང་པ་དང་དམག་མི། ཉེན་རྟོག་པའི་བྱ་བ་གཉེར་མཁན་ཡང་ཡོད། སྤྱི་ལོ༢༠༡༢ལོར་ནུབ་གླིང་རྒྱ་མཚོ་བྱང་མའི་དམག་དོན་སྒྲིག་འཛུགས་ཀྱིས་མ་འོངས་པ་སྟེ། ༢༠༡༤ཡི་རྗེས་སུ་ལོ་ངོ་བཅུ་ཕྲག་གི་རིང་ཨབ་གྷན་ལ་རོགས་སྐྱོར་བྱ་རྒྱུ་ཡིན་པ་ཁས་ལེན་བྱས་ཤིང་། ད་སྐབས་རྒྱལ་ཁབ་ཀྱི་དཔལ་འབྱོར་སྔར་ལས་དར་ཞིང་རྒྱས་བཞིན་པ་དང་རྒྱལ་སྤྱིའི་འབྲེལ་ལམ་ཡང་ཇེ་བཟང་དུ་ཕྱིན་ཡོད།" },
        { "cell": "initialism", "text": "ཨབ་གྷན་སི་ཐན་ནི་དམངས་གཙོའི་རྒྱལ་ཁབ་གསར་པ་ཞིག་ཡིན་ལ། དེའི་རྩ་ཁྲིམས་གསར་པའི་འོག་ལོ་ལྔ་རེར་སྲིད་གཞུང་གི་སྲིད་འཛིན་དང་སྲིད་འཛིན་གཞོན་པ་འོས་འདེམ་བྱེད་ཀྱི་ཡོད།རྒྱལ་སྤྱིའི་སྲུང་སྐྱོབ་དམག་དཔུང་མཐུན་འགྱུར་ཚོགས་པ(ISAF)ཡིས་རྒྱལ་ཁབ་གསར་འཛུགས་དང་སྲིད་གཞུང་རྒྱུན་སྐྱོང་ཐད་སྔ་ཕྱི་བར་གསུམ་དུ་རྒྱབ་སྐྱོར་བྱས། ཏ་ལེ་བྷན་དང་སྲིད་གཞུང་གཉིས་ཀྱི་བར་དུ་ད་དུང་ཡང་མང་ཚོགས་ཀྱི་སྲི་ཞུ་དང་རྒྱལ་ནང་གི་བདེ་འཇགས་སོགས་ལ་དཀའ་ངལ་འཕྲད་ཀྱིན་ཡོད།" },
        { "cell": "initialism", "text": "སྤྱི་ལོ༡༩༤༠ལོའི་ཟླ༤ཚེས༩ཉིན། འཇར་མན་ནཱ་རྫེ་ཡིས་ཏེན་མག་ལ་བཙན་འཛུལ་བྱས་པ་དང་། འཛམ་གླིང་འཁྲུག་ཆེན་གཉིས་པ་ཧྲིལ་པོའི་རིང་ནཱ་རྫེའི་མི་རྣམས་ཏེན་མག་ནང་དུ་བསྡད། སྤྱི་ལོ༡༩༤༣ལོའི་དམག་འཁྲུག་གི་སྐབས་སུ། ནཱ་རྫེའི་མིས་འཇིའུ་རིགས་རྣམས་འཛིན་བཟུང་བྱེད་དུས། ཏེན་མག་མི་རྣམས་ཀྱིས་འཇིའུ་རིགས༨༠༠༠ལྷག་ལ་རོགས་བྱས་ཏེ་ཏེན་མན་ནས་སི་ཝེས་དན་དུ་འབྲོ་རུ་བཅུག འཛམ་གླིང་འཁྲུག་ཆེན་གཉིས་པའི་རྗེས་སུ། ཏེན་མག་རྒྱལ་ཁབ་བྱང་ཨེད་ལན་ཐྲིག་ཆིངས་ཡིག་སྒྲིག་འཛུགས(NATO) དང་ཡོ་རོབ་མཉམ་འབྲེལ་རྒྱལ་ཁག(European Union) གི་ཁོངས་མིར་གྱུར། གྷི་རེན་ལན་དྲི་གླིང་ཕྲན་དང་ཧྥ་རུ་གླིང་ཚོམ་གཉིས་ད་ཆ་ཏེན་མག་གི་ཆ་ཤས་ཡིན་པ་དང་། ཁོ་ཚོ་ལ་རང་ཉིད་ཀྱི་སྲིད་གཞུང་དང་ཚད་བཀག་དབང་ཚད་ཡོད།" },
        { "cell": "initialism", "text": "ལ་ཊིན་ Confoederatio Helvetia Helvetia CH" },
        { "cell": "initialism", "text": "ཕྱི་ལོ་༢༠༠༥ ནས་གཞིས་བྱེས་ལྷན་འཛོམས་དྲ་རྒྱའི་འགན་འཛིན་དང༌། རྩོམ་སྒྲིག་གི་འགན་ཁུར། དྷ་ས་བོད་ཀྱི་བརྡ་འཕྲིན་རིག་པའི་(DITG)ཚོགས་ཆུང་གི་ཚོགས་མི་དང༌། བོད་ཀྱི་གསར་འགོད་པའི་མཐུན་ཚོགས་ཀྱི་ཚོགས་མི་ཡང་བྱས།" },
        { "cell": "initialism", "text": "འབར་མ་རྒྱལ་ཁབ་ནི་ལྷོ་ཤར་ཨེ་ཤ་ཡའི་ཁོངས་སུ་ཡོད་ལ་མི་འབོར་ 60,280,000 དང་། མི་ལོ་ ༡༢༠༠༠ ལྷག་གི་ལོ་རྒྱུས་ལྡན་པའི་རྒྱལ་ཁབ་ཅིག་ཡིན། རྒྱལ་ཁབ་གཞན་གྱི་ལོ་རྒྱུས་སྤྱི་མཚུངས་ལྟར་འབར་མ་ཡང་དུས་ཀྱི་འགྱུར་འགྲོས་དང་བསྟུན་ནས་རིམ་པར་འགྱུར་ལྡོག་ཕྱིན་རྗེས། ད་ལྟའི་ང་ཚོས་འབོད་བཞིན་པའི་འབར་མ་ཞེས་པའི་མིང་ཐོག་ས་ནི་མཱོན་ (Mon) ཞེས་པའི་མི་རིགས་ཞིག་དང་། ཡང་ན་པྱུ་ (Pyu) ཞེས་པའི་བོད་མིའི་རིགས་ལས་ཆད་པར་འདོད་མཁན་མི་འདྲ་བ་འགའ་ཞིག་ཡོད། མཱོན་ཞེས་པའི་མི་རིགས་འདིས་ཕྱི་ལོའི་གོང་གི་ལོ་སྟེ་ ༡༥༠༠ BC ལོར་ཡས་མས་ནས་ཨེ་རཱ་ཝ་ཌི་ (Irrawaddy) ཞེས་པའི་གཙང་པོའི་རྒྱུད་དུ་གཞིས་བཟུང་ནས་ཕྱི་ལོའི་གོང་གི་དུས་རབས་བཅུ་པའི་ནང་དུ་འབར་མའི་ལྷོ་ཕྱོགས་ཀྱི་ཡུལ་སྤྱི་ལ་དབང་སྒྱུར་བའི་འགོ་ཚུག འོན་ཀྱང་དེའི་གོང་གི་ལོ་སྟོང་ཕྲག་བརྒྱད་དགུའི་རིང་ལ་ཡུལ་སྤྱི་ལ་དབང་སྒྱུར་བའི་མི་རིགས་ཞིག་གམ་རྒྱལ་རབས་ཤིག་བྱུང་མེད་པ་འདྲ།" },
        { "cell": "initialism", "text": "དབྱིན་ཇ་ – དབྱིན་ཇི་རྒྱལ་གཞིས་མཉམ་འབྲེལ་དང་བྱང་ཨར་ལན་ཌི UK དབྱིན་ཇི་རྒྱལ་ཁབ United Kingdom of Great Britain and Northern Ireland 大不列顛及北愛爾蘭聯合王國" },
        { "cell": "grouped", "text": "རི་བོ་ཇོ་མོ་གླང་མ་ནི་བོད་རང་སྐྱོང་ལྗོངས་དང་བལ་བོ་གཉིས་ཀྱི་ས་མཚམས་སུ་ཡོད་ལ་བལ་བོའི་སཱ་གཱ་མཱ་ཐཱ་ཟེར། རི་བོ་དེ་འཛམ་གླིང་ནང་གི་རི་བོ་མཐོ་ཤོས་ཡིན་ཞིང་། དེའི་མཐོ་ཚད་མཚོ་ངོས་ནས་སྨི་༨,༨༤༨ཙམ་ཡོད། རོ་བོ་དེ་སྲོག་ཉེན་ཡུལ་གྱི་སྒང་ལ་ཡོད་པས་འཚོ་རླུང་མ་སྤྱོད་པ་རི་རྩེར་འཛེག་མི་ཐུབ། ཇོ་མོ་གླང་མ་ལ་འཛེག་ལམ་ཕྱོགས་གཉིས་ཡོད་པ་ལས་གཅིག་ནི་ཇོ་མོ་གླང་མའི་ལྷོ་ཕྱོགས་ཏེ་བལ་བོའི་ནང་དང་། གཞན་དེ་ཇོ་མོ་གླང་མའི་བྱང་ཕྱོགས་སུ་བོད་རང་སྐྱོང་ལྗོངས་ཀྱི་ས་ཁུལ་དུ་ཡོད། ལྷོ་ཕྱོགས་འཛེག་ལམ་གྱི་མཐོ་ཚད་སྨི་༥,༣༦༤ཙམ་ཡོད་པ་དང་། བྱང་ཕྱོགས་འཛེག་ལམ་གྱི་མཐོ་ཚད་སྨི་༥,༡༥༠ཙམ་ཡོད། ལྷོ་ཕྱོགས་འཛེག་ལམ་དུ་ཤར་པ་དང་དོས་འཁྱེར་པ་ཚོས་གཡག་དང་སེམས་ཅན་ལ་བརྟེན་ནས་འཛེག་གི་ཡོད་པ་དང་། བྱང་ཕྱོགས་འཛེག་ལམ་དུ་དབྱར་ཟླའི་ནང་རླངས་འཁོར་འགྲོ་ལམ་ཡོད་འདུག འཛེག་ལམ་དེ་གཉིས་ནི་ཇོ་མོ་གླང་མར་རི་འཛེག་པ་དང་གནས་སྐོར་བ་ཚོའི་འགྲོ་ལམ་གཙོ་བོ་གཉིས་ཆགས་ཡོད།" },
        { "cell": "grouped", "text": "ཕྱིས་སུ་རྒྱལ་ཁབ་དེའི་ནང་ལོ་མང་རིང་དམག་འཁྲུག་གི་རྐྱེན་པས་ཁོར་ཡུག་དང་དཔལ་འབྱོར་སོགས་ལ་གནོད་སྐྱོན་ཆེན་པོ་བཏང་ཡོད་པ་དང་། རྒྱལ་ཁབ་ཀྱི་རྒྱལ་སྤྱིའི་ཚོང་འབྲེལ་ལ་ཡང་གནོད་སྐྱོན་ཆེན་པོ་བཏང་ཡོད། རྒྱལ་ཁབ་ཀྱི་སྤྱིའི་རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ༦༥༢,༢༣༠ཙམ་ཡོད་པ་དང་མི་འབོར་ས་ཡ༣༠ཙམ་ཡོད། མི་འབོར་ས་ཡ༣ཙམ་ཁྱིམ་མཚེས་རྒྱལ་ཁབ་ཕ་ཀི་སི་ཐན་དང་ཨི་རན་སོགས་ལ་སྐྱབས་བཅོལ་དུ་ཡོད། རྒྱལ་ཁབ་ཀྱི་རྒྱལ་སའམ་གྲོང་ཁྱེར་ཆེ་ཤོས་ལ་ཁ་པུལ་ཟེར་ཞིང། སྤྱི་ལོ༢༠༡༡ལོར་གྲོང་ཁྱེར་དེའི་ནང་མི་གྲངས་ས་ཡ༣ལྷག་ཙམ་གནས་སྡོད་བྱེད་ཀྱིན་ཡོད་འདུག" },
        { "cell": "grouped", "text": "ཧིན་ཉི་ལ་ཁྱོན་མི་འབོར༢༣༨༤༥༢༩༥༢(སྤྱི་ལོ༢༠༠༤ལོ)ཡོད་ལ་འཛམ་གླིང་སྒང་མི་འབོར་མང་ཤོས་ཀྱི་རྒྱལ་ཁབ་ཨང་བཞི་པར་གྱུར་ཡོད། མི་འབོར་གྱི་ཕྱེད་ཀ་ཇ་བ་ནང་འཚོ་སྡོད་བྱེད་ཀྱི་ཡོད་པ་དང་སྤྱི་ལེ་རེ་རེར་མི༡༡༡གནས་ཀྱི་ཡོད་ལ། སྐྱེས་པ་དང་བུད་མེད་ཀྱི་མང་ཉུང་ཕལ་ཆེར་གཅིག་མཚུངས་ཡིན། སྤྱིའི་ས་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ས་ཡ༡.༩༠༤དང་མེག་སི་ཁོ་ལས་ཕྲན་ཙམ་ཆུང་བ་ཡིན།" },
        { "cell": "grouped", "text": "པ་ལི་ངམ་ཕ་རི་སི་(ཧྥ་རན་སིའི་སྐད།: Paris )ནི་ཧྥ་རན་སི་ཡི་རྒྱལ་ས་རེད། རྒྱལ་ས་འདི་ནི་ ཧྥ་རན་རི་ཡི་བྱང་ཕྱོགས་ཀྱི་སེ་ན་གཙང་པོའི་སྟོད་དུ་ཆགས་ཡོད། Île-de-Franceཁྱབ་ཁོངས་ཀྱི་ལྟེ་དབར་གནས་ཡོད། པ་ལི་གྲོང་ཁྱེར་ནི་གྲོང་ཁྱེར་འདིའི་མི་འབོར་ནི་(སྤྱི་ལོ་༢༠༠༧ལོའི་ཟླ་བ་དང་པོ་) ༢,༡༩༣,༠༣༡གཡས་གཡོན་ཙམ་ཡོད། འོན་ཀྱང་པ་ལི་གྲོང་ཁྱེར་ཆེན་པོར་ མི་འབོར་(སྤྱི་ལོ་༢༠༠༧ལོའི་ཟླ་བ་དང་པོ་) ༡༡,༨༣༦,༩༧༠ཡོད་པ་དང་འདི་ནི་ཡོ་རོབ་གླིང་གི་མི་འབོར་མང་ཤོས་ཀྱི་གྲོང་ཁྱེར་ཆེ་ཤིས་ཞིག་རེད།" },
        { "cell": "grouped", "text": "ལྦེ་ནི་སུ་ནི་ལོ་སུ་འན་ན་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་ཆེས་ཆེ་བའི་གྲོང་ཁྱེར་དང་རྒྱལ་ས་ཡིན། ཕྱི་ལོ་༢༠༠༥ལོའི་ཟླ་༡༡པར་རག་བར་དུ་མི་གྲངས་བསྡོམས་འབོར་༥༥༣.༩༠༤དང་ལྦེ་ནི་སུ་རྫོང་དང་བསྡོམས་ན་༨༥༠.༧༠༠ཡོད།" },
        { "cell": "grouped", "text": "སེལ་འོ་སུ་འན་གྱི་སྐད (ślōnskŏ gŏdka, ślōnski, མཚམས་ལ་རེར་ད་དུང po naszymuཞེས་སུ་འབོད) ནི་ཕོ་ལན་རྒྱལ་ཁབ་ཀྱི་སེལ་འོ་སུ་འན་ས་ཁུལ་གྱི་མིས་ཤོད་བཞིན་པའི་སྐད་ཆ་ཞིག་ཡིན། དེ་ལས་གཞན་ད་དུང་ཆད་སི་ཁོ་སྤྱི་མཐུན་རྒྱལ་ཁབ་དང་འཇར་མན་དུ་སྐད་རིགས་འདི་འཆད་མཁན་ཡོད་ལ། སྤྱི་ལོ ༢༠༠༢ སེད་འོ་སུ་འན་གྱི་མི ༥༦ ༠༠༠ ཉེ་བ་ཙམ་གྱི་སེལ་འོ་སུ་འན་གྱི་སྐད་ཁོ་ཚོས་ཕ་སྐད་ཡིན་པར་ཁྱབ་བསྒྲགས་བྱས། འོན་ཀྱང་ཚོད་དཔག་ལྟར་ན་མི་གྲངས ༡ ༢༥༠ ༠༠༠ ཉེ་བ་ཙམ་གྱི་སྐད་འདི་རྒྱག་བཞིན་ཡོད། སེལ་འོ་སུ་འན་ནི་ཕོ་ལན་སྐད་དང་ཉེ་ལ་དེའི་རྐྱེན་གྱི་སྐད་རིགས་སྨྲ་བ་ཚོས་སྐད་འདི་ཕོ་ལན་སྐད་གྱི་ནང་གསེས་ཡུལ་སྐད་ཅིག་ལ་ངོས་འཛིན་མཁན་ཡང་ཡོད་དོ། །" },
        { "cell": "grouped", "text": "མཚོ་ལྷོ་ཁུལ་ནི་མཚོ་བོད་མཐོ་སྒང་གི་ཤར་བྱང་གི་གྲུ་ན་ཡོད་ཅིང་།སའི་ཐིག་ཚད་ལྟར་ན་བྱང་གི་འཕྲེད་ཐིག34.55ནས101.50སྣོལ་སར་ཡོད། ཤར་ནི་མཚོ་ཤར་ས་ཁུལ་དང་རྨ་ལྷོ་བོད་རིགས་རང་སྐྱོང་ཁུལ་གཉིས་ལ་འབྲེལ་བ་དང་། ལྷོ་ནི་མགོ་ལོག་བོད་རིགས་རང་སྐྱོང་ཁུལ་ཐུག་པ་དང་། ནུབ་ནི་མཚོ་ནུབ་སོག་རིགས་བོད་རིགས་རང་སྐྱོང་ཁུལ་དང་ཕན་ཚུན་ལྟའོ། ། ཤར་ནུབ་གཉིས་ཀྱི་སྲིད་ལ་སྤྱི་ལེ༢༦༠དང་། ལྷོ་བྱང་གི་ཞེང་ལ་སྤྱི་ལེ༢༧༠དང་། སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་༤༦.༠༠༠ཙམ་ཡོད་དེ། འབྲུག་ཡུལ་དང་ཆེ་ཆུང་འདྲ། རང་སྐྱོང་ཁུལ་སྲིད་གཞུང་ཆབ་ཆར་བཙུགས་པ་དང་། ཁུལ་གྱི་མངའ་འོག་ཏུ་གུང་ཧོ་དང་། ཁྲི་ཀ་རྫོང་། མང་རྫོང་། འབའ་རྫོང་། ཞིན་ཧེ་རྫོང་སྟེ་རྫོང་ལྔ་དང་ལུང་ཡངས་འགག་ཆུ་གློག་འདོན་སྤེལ་ས་ཚིགས། ཁྱོན་མངའ་ཁུལ་ཡོངས་སུ་ཞང་དང་གྲོང་རྡལ༤༡དང་། སྡེ་དམངས་ཨུ་ཡོན་ལྷན་ཁང༣༨༥དང་། མཉམ་ལས་ཁང༡༢༦༩བཅས་ཡོད།" },
        { "cell": "grouped", "text": "གངས་ཏི་སེའམ་གངས་རིན་པོ་ཆེ་ (Kailāsa, 冈仁波齐峰) ནི་བོད་ལྗོངས་སྤུ་ཧྲེང་རྫོང་གི་བྱང་རྒྱུད་མཚོ་མ་ཕམ་དང་ཁད་ཉེར་དུ་ལྷུན་ཆགས་སུ་ཡོད་ཅིང་། རྒྱ་མཚོ་ངོས་ལས་མཐོ་ཚད་སྨི་ (6,638 m (21,778 ft).ཡོད་པ་དང་། གང་སྐོར་ཐེངས་གཅིག་ལ་སྤྱི་ལེ་ 52 དང་སྒྲོལ་མ་ལ་ཡི་མཐོ་ཚད་སྨི་ 5723 ཡོད། གནས་འདིར་ལོ་ངོ་སྟོང་ཕྲག་མང་པོའི་སྔོན་ནས་ནང་པ་སངས་རྒྱས་དང་། ཕྱི་རོལ་རིག་བྱེད་པ་སོགས་ཀྱིས་ངོས་འཛིན་ཚུལ་མི་འདྲ་བ་བྱུང་ཡོད། གང་ལྟར་ས་གནས་འདི་བོད་ནུབ་ཁུལ་རྒྱ་ནག་དང་། རྒྱ་གར། བལ་ཡུལ་བཅས་ཀྱི་ས་མཚམས་སུ་ཆགས་ཡོད།" },
        { "cell": "signed-number", "text": "(+86)0973 འདི་ནི་རྨ་ལྷོ་བོད་རིགས་རང་སྐྱོང་ཁུལ་གྱི་རྫོང་ཡོངས་ཀྱི་ཚབ་གྲངས་དང་གཅིག་གྱུར་ཡིན།" },
        { "cell": "signed-number", "text": "༢༠༠༢--༢༠༢༡བར། འཇར་མན་དང་། ཨ་མེ་རི་ཀ་དང་། ཉི་ཧོང་སོགས་ཀྱིས་མཚོན་པའི་རྒྱལ་ཁབ་བཅུ་གྲངས་ཀྱི་གཙུག་ལག་སློབ་ཆེན་དང་ཉམས་ཞིབ་སྡེ་ཚན་ཁག་ཏུ \" སྙན་ངག་གི་བོད \" ལ་སོགས་ཀྱི་བཤད་པ་དང་འཆད་ཁྲིད་སྣ་ཚོགས་མཛད་གནང་ཡོད་པ་དང་རྒྱལ་སྤྱིའི་རང་བཞིན་གྱི་སྙན་ངག་དུས་སྟོན་དང་གློག་བརྙན་དུས་སྟོན་ལ་མཉམ་ཞུགས་གནང་ཡོད་འདུག་ལ། བཟོས་གནང་གློག་བརྙན་དག་ཀྱང་དབྱིན་ཇིའི་སྐུད་ལམ་བཞི་པ་ལ་སོགས་བརྙན་འཕྲིན་བརྒྱུད་ལམ་དང་གློག་བརྙན་ཁང་འདྲ་མིན་ནས་གཟིགས་འབུལ་ཐོབ་ཡོད་འདུག" },
        { "cell": "signed-number", "text": "མགོ་ལོག་བོད་རིགས་རང་སྐྱོང་ཁུལ་ནི་མཚོ་སྔོན་ཞིང་ཆེན་གྱི་ཤར་ལྷོའི་ཕྱོགས་སུ་ཡོད་ལ། ཤར་གྱི་གཞུང་ཐིག97°54′-101°50′དང་བྱང་གི་འཕྲེད་ཐིག32°31′-35°40 ཡི་བར་དུ་གནས་ཤིང་། ཁུལ་ཡོངས་ཀྱི་སྤྱིའི་རྒྱ་ཁྱོན་ལ་སྟོང་སྨི་གྲུ་བཞི་མ76312ཡོད། གཞན་ཁུལ་མི་དམངས་སྲིད་གཞུང་ནི་རྨ་ཆེན་རྫོང་ཐོག་ཏུ་ཡོད། མགོ་ལོག་ཁུལ་གྱི་ཐོན་ཁུངས་ཧ་ཅང་ཕུན་སུམ་ཚོགས་པ་ཡིན་ཏེ། གཙང་བོ་ཆེ་ཆུང36ཡོད་པ་དང་། ཆུ་བོའི་བཞུར་རྒྱུན་གྱི་རིང་ཚད་ལ་སྤྱི་ལེ3300ལྷག་ཡོད་ཅིང་། སོ་སོར་རྨ་ཆུ་དང་འབྲི་ཆུ་གཉིས་ཀྱི་ནང་དུ་འབབ་ཀྱིན་ཡོད།" },
        { "cell": "signed-number", "text": "--113.63.113.54 ༡༥:༡༨, ༤ ཟླ་བཅུ་གཉིས་པ། ༢༠༡༣ (UTC)== གཏམ་དཔེ། ==" },
        { "cell": "signed-number", "text": "ཀྲུང་གོའི་སའི་ཆགས་ཚུལ་ནི་འཕྲེད་ཐིག་ ༡༨° ནས ༥༤° N བར་དང། གཞུང་ཐིག་ཤར་མ་ ༧༣° ནས་ ༧༣° བར་ཡིན། ཤར་ཕྱོགས་སུ་ཤར་རྒྱ་ནག་རྒྱ་མཚོ་དང། རྒྱ་མཚོ་སེར་པོའི་མཐའ་ཁོབས་སུ་མི་འབོར་ཧ་ཅང་གི་མང་བའི་ཁུལ་དང། ས་གཤིས་ཀྱང་ཧ་ཅང་གི་བཟང་པོ་ཡོད། བྱང་ཕྱོགས་ཁུལ་དུ་ནང་སོག་གི་ཡངས་ཤིང་རྒྱ་ཆེ་བའི་རྩ་ཐང་གི་ཁྱབ་པ་དང། ཀྲུང་གོའི་ལྷོ་ཕྱོགས་ནི་རི་རྒྱུད་ཆུང་གྲས་ཁ་ཅིག་གི་ཁྱབ་ཡོད། དབུས་ཤར་ཁུལ་དུ་ཆུ་ཆེན་ཁ་ཅིག་གི་ཆུ་འབབ་ཁུལ་འཁེལ་ཡོད། མ་ཟད་ཡར་ཀླུང་གཙང་པོ་དང། སེང་གེ་གཙང་པོ། གླང་ཆེན་གཙང་པོ། སོགས་ཁ་འབབ་རྣམ་བཞི་དང། འབྲི་ཆུ། རྨ་ཆུ། རྒྱལ་མོ་རྔུལ་ཆུ་སོགས་འཛམ་གླིང་གི་མི་འབོར་ཕྱེད་ཀ་ཙམ་ལ་ཉེ་བར་འཁོ་བའི་ཆུ་ཆེན་ཁག་མཚོ་བོད་ས་མཐོ་བརྒྱུད་རྒྱ་གར། རྒྱ་ནག། སོགས་ལ་རྒྱུག་བཞིན་ཡོད། ཧི་མ་ལ་ཡའི་རི་རྒྱུད་ནི་འཛམ་གླིང་ཐོག་གི་ཆེས་མཐོ་བའི་རི་རྒྱུད་མང་དག་ཞིག་གི་རྟེན་གནས་ཡིན། ཇོ་མོ་གླང་མ་ནི་བལ་ཡུལ་དང་བོད་གཉིས་ཀྱི་ས་འཚམ་སུ་ཡོད་པ་དང། དེ་མིན་གི་མཐོ་ཚད་རྨིད་༨༠༠༠ བརྒལ་བའི་རི་ཆེན་ཁག་བཅུ་ཙམ་ཡོད། ཏུར་ཕན་གཤོངས་ Turpan Depression. ཁུལ་གི་ཨའི་ཏིང་མཚོ་སྐམ་ Ayding Lake (−154m) ནི་རྒྱལ་ཁབ་གི་ཆེས་དམའ་ཤོས་གི་ས་ཁུལ་དང། འཛམ་གླིང་གི་ཆེས་དམའ་ཤོས་གསུམ་པར་སླེབས་ཀྱི་ཡོད།" },
        { "cell": "signed-number", "text": "འགྲོ་སོང་ཀུན་བསྡོམས་ན ། གཤོར་འབོ་ཁལ་ཉག་གི་གྲོ་ཞིབ་བཙགས་མ་ཁལ་464 -5དང་། སྣུམ་ཁལ་184 – 18 སྒྲོན་ནག་ཁལ་61 – 10 སྤྱིན་འདེགས་ཁལ་220 – 14 – 3 བལ་ལྕགས་འདེགས་ཁལ་5 – 8 -2 ལྕགས་འཛོག་འདེགས་ཁལ་18 – 4 – 3 སོལ་བ་ཁལ་4899 སྟག་པང་ངོ་གྲངས་27446ཤོག་བུ་ཉིས་སྦྱར་དྲས་ཆོག་བྲེ་ཁ་18291 ཤོག་བུ་བཞི་སྦྱར་དྲས་ཆོག་བྲེ་ཁ་40889 འཇམ་རྡར་ཝོལ་ཁོག་སྤུས་ལེགས་ཆེ་ཆུང་ཅི་རིགས་ངོ་གྲངས་408 རྩུབ་རྡར་ངོ་གྲངས་97 གེགས་སེལ་སྐུ་རིམ་ལ་སོང་བ་ནས་ཁལ་2072 – 5གོང་གསལ་དེ་རྣམས་རིན་གོང་ཡུལ་ཐང་ལ་རྩིས་ན་ས་སྐབས་དེའི་དངུལ་རྡོ་ཚད་120 – 25 – 6 – 9 སྲང་རེར་གཤོར་ཁལ་20 རེ་རྩིས་པ་བསྡོམས་ནས་ཁལ་120513 – 16 ཐོབ་བོ ། །" },
        { "cell": "signed-number", "text": "གསུང་རབ་རིན་པོ་ཆེའི་ལས་གྲྭར་བཞུགས་མི་མི་གྲངས་ཆིག་སྟོང་ལ་ཉེ་བ་ཡོད་པ་ནས་འགོ་པ་དང་། ཤིང་བཟོ་དབུ་མཛད ། ཡིག་གེའི་དབུ་མཛད ། པར་བ་དབུ་མཛད ། དབུ་ཆུང་བ་རྣམས་ལ་ཟླ་ཕོགས་རྩམ་གཤོར་ཁལ་ལྔ། ཆང་ནས་ཁལ་གཅིག་དང་བྲེ་བཅུ ། ཤ་ཆུང་ཁོག་གཅིག སྦྲེ་ཚྭ་ཕུལ་ཕྱེད ། ཉིན་གླ ། གཤོར་བཅུ་བཅས་དང་ ། བྱིངས་ལ་རྩམ་གཤོར་ཁལ་ལྔ ། ཆང་ནས་ཁལ་གཅིག་དང་བྲེ་བཅུ ། ཤ་ཆུང་ཁོག་གཅིག བྲེ་ཚྭ་ཕུལ་ཕྱེད ། ཉིན་གླ་བྲེ་བཞི་ཕུལ་ཕྱེད་བཞི་བཞི་ཆ་རེ་ཐོབ་པ་བཅས་བཟོ་བོ་མི་གྲངས་ཆིག་སྟོང་ལ་ཉེ་བ་དང་ ། གཡོག་མི་གྲངས་100 སྐོར་ལ་ལོ་གཅིག་དང་ཟླ་བ་དྲུག་ནང་གླ་ཕོག་འགྲོ་ཆ་བསྡོམས་ན་གཤོར་འབོ་ཁལ་ཉག་གི་བར་ཞིབ་170 རྩིང་ཁལ་49146 – 12 – 1 ཆང་ནས་ཁལ་13557 – 6 – 23 ཚྭ་ཁལ་405 – 19 – 3 – 4 – 1 སྣུམ་ཁལ་113 – 2 – 4 – 1 ཕྱུར་བ་ཁལ 605 - 1 – 12 – 1 དྲལ་ཆག་ཁལ་ 48 – 15 ཆུ་ལྡུར་ཁལ་ 292 – 10 རྒྱར་ངོ་སྤྲོད་ཤ་ཆུང་ཁོག་8823 ཤ་བཟང་ངན་ཕྱེད་འཁྱེར་ཆུང་ཁོག་ 220 – 5 – 2 བཟང་ཇ་འདེགས་ཁལ་ 693 – 9 – 3 མར་འདེགས་ཁལ་ 2962 – 8 – 2 – 20 – 1 ཤ་སྐམ་རུས་འཛོགས་འདེགས་ཁལ་ 648 – 16 – 3 ཡོན་འབྲུར་ཕབ་པ་ཁལ་99460 – 4 – 5 -32 – 1 ཤ་དོད་ཕོགས་ཕྲེང་གླ་ཡོན་བཅས་སྤུས་ཁལ་33285 – 17 – 2 – 10 – 1 གཟན་པ་འདེགས་ཁལ་ 1745 ལྕི་བ་འདེགས་ཁལ་ 188972 – 2 བཅས་པ་རྣམས་ཀྱི་རིན་གོང་སྐབས་དེའི་ཡུལ་ཐང་ལྟར་རྩིས་པ་ཁྱོན་བསྡོམས་དངུལ་རྡོ་ཚད་275 – 33 – 7ལ་སྲང་རེར་གཤོར་ཁལ་20རེ་རྩིས་ཁལ་275674ཐོབ་བོ ། །" },
        { "cell": "signed-number", "text": "ཇི་མི་ཀར་ཀྲར་ ༼༡༩༢༤།-༢༠༢༤།༽ནི་ཁོང་ནི་ཨ་མེ་རི་ཁ་རྒྱལ་ཕྲན་མཉམ་འབྲེལ་རྒྱལ་ཁབ་ཡི་ཆབ་སྲིད་མཁས་ཅན་ཞིག་རེད།" },
        { "cell": "letter-name", "text": "༡༩༨༧ ལོར་ ཝ་ཤིང་ཊོན་ དུ་འཚོགས་ པའི་གྲོས་ཚོགས་ཀྱི་འགྲོ་བ་མིའི་ཐོབ་ཐང་ཚོགས་ཆེན་ ཐོག་ཏཱ་ལའི་བླ་མ་མཆོག་གིས་བོད་ཀྱི་མ་འོངས་པའི་གནས་བབ་ཐད་ཀྱི་བསམ་ཚུལ་བརྗོད་པའི་གསུང་བཤད་གནང་ཡོད། འཆར་གཞི་དེས་བོད་དེ་ རྡུལ་ཕྲན་མཚོན་ཆ་ མེད་པའི་དམངས་གཙོའི་\"ཞི་བདེའི་ས་ཁུལ་\"ཞིག་ཏུ་འགྱུར་དགོས་པ་དང་། འགྲོ་བ་མིའི་ཐོབ་ཐང་ ལ་རྒྱབ་སྐྱོར་བྱེད་དགོས་པའི་སྐུལ་མ་བཏང་ཡོད། ༡༩༨༨ ལོའི་ཟླ་ ༦ ཚེས་ ༡༥ ཉིན་ཏཱ་ལའི་བླ་མས་སི་ཊར་ སི་བྷོར་གྷི་གྲོང་ཁྱེར་ དུ་འཆར་གཞི་དེ་རྒྱ་བསྐྱེད་བཏང་བས་འཆར་གཞི་དེ་ལ་\"སི་ཊར་སི་བྷོར་གྷི་གྲོས་འཆར\"ཞེས་འབོད་ &#x5B; ཡོད &#x5D; དེ་ནི་རྒྱ་ནག་གཞུང་དང་གྲོས་མོལ་བྱས་ནས་བསྒྲུབ་རྒྱུ་ཡིན་ འོན་ཀྱང་འཆར་གཞི་དེ་བཙན་བྱོལ་བོད་གཞུང་གིས་༡༩༩༡ལོར་ཁས་མ་བླངས་པ་རེད། ༡༩༧༠ ལོར་ ཆེས་མཐོའི་འགོ་ཁྲིད་ ཏེང་ཞའོ་ཕིང་གིས་ ཏཱ་ལའི་བླ་མ་ལ་རྒྱ་ནག་གི་ཕྱིར་ལོག་དགོས་པའི་དགོས་མཁོ་གཅིག་པུ་དེ་ཁོང་གིས་\"རྒྱ་ནག་གི་མི་སེར་ཞིག་ཡིན་པའི་ཆ་ནས་ཕྱིར་ལོག་དགོས་པ་དེ་ནི་རྒྱལ་ཞེན་ཡིན་\"ཞེས་བཀོད་" },
        { "cell": "letter-name", "text": "ཕ་ཀི་སི་ཐན་གྱི་བྱང་ཕྱོགས་དང་ནུབ་ཕྱོགས་ཀྱི་མཐོ་ས་དག་གི་ཁོངས་སུ་ཧ་ཅང་མཐོ་བའི་ཀ་ར་ཀོ་རམ་དང་། ཁེ༢་(K2མཐོ་ཚད་ལ་སྤྱི་ཁྲི་༨༦༡༡ཡོད།)དང་ནན་གྷ་ཕར་བྷ་(མཐོ་ཚད་ལ་སྤྱི་ཁྲི་༨༡༢༦ཡོད།)ལྟ་བུའི་འཛམ་གླིང་གི་རི་བོ་མཐོ་ཤོས་འགའ་མཉམ་དུ་སྦྲེལ་བའི་ཕེ་མིར་རི་རྒྱུད་ཡོད་ལ། ནུབ་ཏུ་བྷ་ལོ་ཆི་སི་ཐན་མཐོ་སྒང་དང་ཤར་དུ་ཐར་བྱེ་ཐང་དང་བྱེ་འདམ་ཆུ་སྙིགས་ཀྱི་ཐང་གཤོངས་འགའི་ས་ཁུལ་ཞིག། ཕུན་ཇབ་དང་སེན་དྲི་བཅས་ཡོད། རིང་ཚད་ལ་སྤྱི་ལེ་༡༦༠༩ཡོད་པའི་ཨན་ཌ་སི་ཆུ་བོ་དང་དེའི་ཆུ་ལག་རྣམས་བདག་བཟུང་བྱས་པའི་ཀ་ཞི་མིར་གྱི་རྩོད་གཞི་རུ་གྱུར་ཡོད་པའི་མངའ་ཁོངས་ནས་ཕ་ཀི་སི་ཐན་བརྒྱུད་དེ་ཨ་རབ་རྒྱ་མཚོར་འབབ་ཀྱིན་ཡོད།" },
        { "cell": "letter-name", "text": "བལ་བོ་ལ་བལ་བོའི་མཁའ་དམག་དང་མི་དམངས་སྐོར་སྲུང་པ། གཞོགས་འདེགས་དཔུང་དམག་བཅས་ཡོད། བལ་དམག་ཚོ་ངེས་པར་དུ་ལོ་ན་༡༨ཟིན་པ་ཡིན་དགོས། སྤྱི་ལོ་༢༠༠༤ལོར་བལ་བོ་གཞུང་གིས་ཨ་སྒོར་ས་ཡ་༩༩.༢ཙམ་དམག་དོན་འགྲོ་གྲོན་བཏང་ཡོད་ལ། རྒྱལ་ཁབ་ཀྱི་དམག་གི་ཡོ་ཆས་དང་གོ་མཚོན་ཕལ་ཆེར་བ་རྒྱ་གར་ནས་ནང་འདྲེན་བྱས་པ་དང། དེ་བཞིན་ཨ་རི་ཡིས་(M16s,M4s)གོ་མཚོན་སོགས་མཐུན་སྦྱོར་བྱས་ཡོད། M16མེ་མདའ་ནི་བལ་དམག་གི་མེ་མདའ་ཚད་གཞི་མཐོ་ཤོས་དེ་ཡིན་འདུག བལ་དམག་གི་སྒྲིག་ཁྲིམས་གསར་བའི་ནང་དུ་བལ་བོའི་བུད་མེད་དམག་མི་ཚོ་ལག་འཛིང་གི་གནས་སྐབས་དང་། དམག་འཁྲུག་གི་མདུན་ཕྱོགས་སུ་དམག་འཛིང་མི་དགོས་པ་ཁྲིམས་བཟོས་ཡོད། འོན་ཀྱང་། གསང་བའི་ལས་དོན་གྱི་སྡེ་ཁག་དང་དམག་སྤྱིའི་ལས་ཁུངས་སྡེ་ཁག བརྡ་ལན་དམག་དཔུང་སྡེ་ཁག་སོགས་ལ་དམག་གི་ཆ་ཤས་ལེན་ཆོག" },
        { "cell": "letter-name", "text": "དཔེར་ན། X+Y=30ལྟ་བུ་ནི་རྒྱུ་གཉིས་ཐེངས་གཅིག་གི་མཉམ་བྱ་ཡིན།" },
        { "cell": "letter-name", "text": "དཔེར་ན། X=22ནི་མཉམ་བྱ་x+12=34 ཡི་འགྲོལ་ཐང་ཡིན།" },
        { "cell": "letter-name", "text": "ཁྱད་པར་གསོམ་སྡོང [2] ་གི་རིགས་མང་བོ་མཆིས་ཤིང་།དུས་རབས་ཉི་ཤུ་བའི་འགོ་སྟོད་དུ་ཡུལ་འདི་སླེབས་པའི་ཕྱི་གླིང་བ་ཇོ་སེ་ཧྥོ་རོ་ཁེ་（Joseph F·Rock l884-1962）ཡིས་གསོམ་སྡོང་རིགས་བཅུ་ཡི་ས་བོན་དང་མ་དཔེ་ཨ་རིར་འཁྱེར་ཞིང་།ཨར་ནོལ་དྷྀ་སྐྱེ་དངོས་ར་བ་（Arnold Arboretum） [3] ནས་འདེབས་འཛུགས་གསོག་ཉར་བྱས་ཤིང་།ཐེ་བོའི་སྐོར་གྱི་པར་རིས་སོགས་1928ལོའི་ཟླ་11པའི་ནང་དུ་འགྲེམས་སྤེལ་བྱས་པའི་ཨ་རིའི་དུས་དེབ་རྒྱལ་ཡོངས་ས་རྒྱུས་（National Geographic） [4] ཀྱི་ནང་དུ་བཀོད་ཡོད།སྐབས་དེར་ཀྲུང་གོའི་རྒྱལ་ཡོངས་སུའང་གསོམ་སྡོང་གི་རིགས་བཅུ་བདུན་ལས་མེད་པར་བཤད།དེ་མིན་ཐང་ཤིང་དང་།ཤུག་པ།སྒྲོན་ཤིང་།སྟག་དཀར།སྟག་དམར།ཚིས་པ།བྲག་གདན།འོ་ཇོ།སྤ་ངུ།ཤུག་ཚེར།གཡར་བ།ཚར་རུ།སྨྱུག་མ།ལྕང་མ།སུ་དཀར།སུ་ནག།བེ་ལོ།རྫས་རྐྱང་།ལ་སྡོང་།གླང་མ།བྲ་མ།སྤེན་མ།སྐྱེར་བ།གདོང་དྲུགཤིང་རྩེ་དཀར་དཀར་སོགས་མང་དུ་ཡོད།" },
        { "cell": "letter-name", "text": "2. གོང་ གསལ་མཐེབ་གཞོང་གི་བཀོད་སྒྲིག་ཇུས་འགོད་རྩ་དོན་ལ་གཞིར་བཟུང་ནས། གསལ་བྱེད་ཡི་གེ་དང་དེ་ཚོའི་འགྱུར་བ་ཁག་ཚང་མ་མཐེབ་གཞོང་མ་འདྲ་བའི་མཐེབ་གནས་ གཅིག་སྒང་བཞག་ཡོད། དཔེ་ན་གསལ་བྱེད་ན་དང་དེའི་འགྱུར་བ་གསུམ་ ྣ དང་ཎ ྞ ཚང་མ་མཐེབ་གཞོང་གཙོ་བ་དང་ཞོར་འདེགས་མཐེབ་གཞོང་གི་མཐེབ་བཀྱག་N སྒང་ལ་བཞག་ཡོད།" },
        { "cell": "letter-name", "text": ">ནི་སྤྱི་ལོ་༡༩༤༨ལོའི་ཟླ་༡༢ཚེས་༡༠ཉིན། མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱི་ཚོགས་ཆེན་གྱི་གྲོས་གཞི་ཨང་A/RES/217ལ་འོས་འཆམ་བྱུང་ནས། པེལ་རེས་སིའི་chaillotཕོ་བྲང་ནས་ཕྱི་ཕྱོགས་ལ་ཁྱབ་བསྒྲགས་མཛད་པའི་འགྲོ་བ་མིའི་གཞི་རྩའི་ཐོབ་ཐང་ལ་སྲུང་སྐྱོབས་ཀྱི་རྩ་དོན་འཛིན་པའི་རྒྱལ་སྤྱིའི་རང་བཞིན་གྱི་ཡིག་ཆ་ཞིག་རེད། དེ་ནི་མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱིས་མི་བུའི་ཐོབ་ཐང་གི་སྲུང་བརྩིའི་སྐོར་ལ་བཞག་པའི་ཡིག་ཆ་དང་པོ་དེ་ཡིན་པའི་ངོས་ནས། དང་ཐོག་གི་བསྐྱེད་རྒྱུ་གཙོ་བོ་ཞིག་ནི། འཛམ་གླིང་དམག་ཆེན་གཉིས་པ་ཡིན་པ་དང་། ཡིག་ཆ་དེའི་ནང་དུ་འཛམ་གླིང་མངའ་ཁོངས་ཀྱི་མི་བུ་ཚང་མ་ལ་ཡོངས་ཁྱབ་ཀྱི་ཐོབ་ཐང་ག་རེ་ཡོད་མེད་གསལ་སྟོན་གནང་ཡོད་རེད། མཉམ་འབྲེལ་རྒྱལ་ཚོགས་ཀྱི་སྒེར་ངོས་དྲ་བ་རུ་དེ་གའི་ཡིག་ཆ་ཆ་ཚང་འཁོད་ཡོད།" },
        { "cell": "exponent", "text": "འཁོར་ལམ་གཅིག་ནང་མོ་རྡུལ་གྱི་གྲངས་ཚད་ཇི་ཙམ་གནས་ཐུབ་མིན་ནི། N=2n² གདམས་ངག་གིས་འཚོལ་ཐུབ། དེའི་ནང་ n ནི་འཁོར་ལམ་གྱི་གྲངས་ཚད་ཡིན། ཆེས་ནང་མའི་འཁོར་ལམ་དེའི་ནང་མོ་རྡུལ་གྱི་གྲངས་ཚད་གཉིས་དང་དེ་ནས་བརྒྱད། དེ་ནས་བཅོ་བརྒྱད་བཅས་འཁོར་ལམ་སོ་སོའི་ནང་མོ་རྡུལ་གྱི་གྲངས་ངེས་པ་ཡིན། ཆེས་ཕྱི་མའི་འཁོར་ལམ་དེའི་ནང་བརྒྱད་ལས་མང་བའི་མོ་རྡུལ་གནས་ཀྱི་མེད། འཁོར་ལམ་མི་འདྲ་བ་རེ་རེའི་ནང་གི་མོ་རྡུལ་སོ་སོར་ངེས་གཏན་གྱི་ནུས་ཤུགས་རེ་ཡོད། འཁོར་ལམ་གྱི་འཁོར་ཁྱོན་ཇི་ཙམ་ཆེ་བ་དེ་ཙམ་གྱིས་མོ་རྡུལ་ལམ་གློག་རྡུལ་གྱི་ནུས་ཟུངས་ཆེ་བ་ཡོད། འོད་དང་དྲོད་གང་རུང་ཤིག་མོ་རྡུལ་ཐོག་ཕོགས་ཚེ། མོ་རྡུལ་དེ་ཉིད་ནུས་ངར་ཆེ་རུ་ཕྱིན་ཏེ་འཁོར་ལམ་ནང་མ་ནས་འཁོར་ལམ་ཕྱི་མར་འཛེགས་འགྲོ་བ་རེད། མོ་རྡུལ་ཞིག་འཁོར་ལམ་ཕྱི་མ་ནས་ཕྱིར་བཏོན་པ་ལས་འཁོར་ལམ་ནང་ནས་ཕྱིར་བཏོན་པར་ནུས་ཤུགས་མང་བ་བེད་སྤྱད་དགོས། དེར་བརྟེན་འཁོར་ལམ་ཕྱི་ནང་གཞིར་བཟུང་གིས་མོ་རྡུལ་སོ་སོར་ཚད་གཞི་ངེས་ཅན་ཞིག་གི་ནུས་ཟུངས་ལྡན་ཡོད་པ་དེ་ལ་གོང་བུའི་ནུས་ཚད་ཟེར། གོང་བུའི་ནུས་ཚད་ནི་མོ་རྡུལ་གྱི་ནུས་ཟུངས་འཇལ་བའི་ཚད་གཞིར་ངོས་འཛིན་པ་ཡིན། དེས་ན་མོ་རྡུལ་གྱི་ནུས་ཟུངས་ནི་ནང་མའི་ནང་མ་ཞན་ལ་ཕྱི་མའི་ཕྱི་མ་བཟང་བ་ཡིན།" },
        { "cell": "exponent", "text": "རྒྱལ་སྤྱིའི་ཚད་གཞི་རུ། ཁུར་ནི་ཁུ་ལོམ་པ་ (Coulomb) ཞེས་པས་འཇལ་བ་དང་། མཚོན་རྟགས་སུ་ C འབྲི་བ་ཡིན། ཁུ་ལོམ་པ་གཅིག་ནི་གློག་རྡུལ་གྲངས་ 6×1016 གི་ཁུར་དང་ཕལ་ཆེར་མཚུངས་པ་ཡིན། ༼ གློག་རྡུལ་གཅིག་ལ་ཁུར་མོ་ 1.6x10- 19 ལྡན་ཡོད། ༽ གློག་རྒྱུན་ནི་ཨེམ་ཕེར་གྱི་ཚད་གཞིས་འཇལ་བ་དང། མཚོན་རྟགས་ A འབྲི་བ་ཡིན། ཨེམ་ཕེར་ཞེས་པ་ནི་ཧྤ་རན་སིའི་ཚན་རིག་པ་ཨན་ཌརེ་ཨེམ་ཕེར་ Andre Amphere གྱི་མིང་ལས་བླངས་པ་ཡིན། ཨེམ་ཕེར་གཅིག་ནི་སྐར་ཆ་རེར་ཁུར་ཁུ་ལོམ་པ་རེ་རྒྱུ་བ་དང་མཚུངས་པས་ན།" },
        { "cell": "exponent", "text": "དེང་རབས་ཀྱི་དུས་འཁོར་རེའུ་མིག་གི་འཁོར་ཚན་དང་པོ་དང་གཉིས་པ། གསུམ་པ་བཅས་སོ་སོའི་ནང་དུ་རྩ་རྫས་ཇི་ཙམ་གནས་པའི་ཚོད་དཔག་བྱེད་ཐུབ་བམ། འདིར་ང་ཚོས་འཁོར་ལམ་འདྲ་མིན་ནང་དུ་གློག་རྡུལ་ཇི་ལྟར་གནས་པའི་རང་བཞིན་ལ་ལྟོས་ཏེ་འཁོར་ཚན་དེ་དག་ནང་དུ་རྩ་རྫས་ཇི་ཙམ་གནས་པ་བརྗོད་ཐུབ། ཆོ་ག་2n² སྤྱད་དེ་འཁོར་ལམ་ཞིག་གི་ནང་དུ་གློག་རྡུལ་ཇི་ཙམ་གནས་མིན་འཚོལ་འདུག ། འདིར་ཨིན་ཡིག་གི་ཚིག་ n ནི་འཁོར་ལམ་གྱི་གྲངས་ཡིན།" },
        { "cell": "exponent", "text": "དེ་ལྟར་གཞུང་འདིའི་ནང་དུ་ཚིག་གིས་དངོས་སུ་ཟིན་མ་ཟིན་གྱི་ངག་སྒྲ་མི་འདྲ་བ་གྲངས་༢༩༥༣༢༧༩༠༠ཙམ་གྱི་རྣམ་བཞག་དངོས་སུ་བཤད་ཡོད། དེ་དག་ནི་མང་ཆེ་བ་བོད་སྐད་ལ་མཁོ་བའི་ངག་གམ་ཐོན་ལུགས་ཀྱི་ངག་སྒྲ་ཡིན། གྲངས་ཀ་འདི་འགྲུབ་པའི་སྤྱི་འགྲོས་ནི: x²*20+x³*20=295,237,900་ཡིན། x་ནི་འདིར་དངོས་སུ་རྒྱས་པར་བཤད་པའི་ཀ་མད་ཀྱི་གྲངས་ཀ་དེ་ཡིན། དེ་ལ་༢༤༥ ཡོད། འདིའི་ཐོག་ཏུ་ཕྱི་རྒྱལ་ལ་མཁོ་བའི་ངག་སྒྲ་༣༩༧༠༦༨༠་ཙམ་ཁ་སྣོན་དུ་ངོས་སྤྲོད་ཙམ་བྱས་ནས་ཞིབ་པར་ཤུགས་ལ་རྟོགས་ཐུབ་པར་བྱས་ཡོད། གྲངས་ཀ་འདི་རེ་རེ་བཞིན་ངོས་སྤྲོད་རྒྱུ་ཡོད་པའི་དངོས་ཡོད་ཀྱི་གྲངས་ཡིན་ཏེ, ཀ་མད་རྐྱང་པ་སུམ་རེས་ངག་སྒྲ་རེ་བཟོ་ཆོག་པ་ཡང་ཡོད་པས་སོ། འདི་ད་དུང་ཁོ་བོས་བཤད་པའི་མིའི་ངག་གི་སྒྲའི་གྲངས་ཀྱི་དབྱེ་ཚུལ་བསྡུས་ཤོས་ཀྱི་བརྩི་ལུགས་དེ་ཡིན།" },
        { "cell": "arithmetic", "text": "༡སྐར་ཆ། = ༡ ༠༠༠ སྐར་ཆ་ཕྲ་མོ།(ms) = ༡༠༠༠ ༠༠༠ཝེ་སྐར་ཆ།(µs) = ༡༠༠༠ ༠༠༠ ༠༠༠ ༠༠༠ ཕི་ཁོ་སྐར་ཆ།(ps)" },
        { "cell": "arithmetic", "text": "སི་ཁྲོན་ཞིང་ཆེན་བོད་ཡིག་སློབ་གྲྭས་བདམ་བསྒྲིགས་བྱས་པའི་དེབ་འདིའི་ནང་གནའ་རབས་རྒྱ་གར་གྱི་དམ་པ་རྣམས་ཀྱིས་རིག་པའི་བཅུད་དུ་བསྒྲུབས་པའི་ལེགས་བཤད་དང་བསྟོད་ཚིག་གང་འཚམ་དང་། སྔོན་བྱོན་བོད་ཀྱི་མཁས་པས་མཛད་པའི་བཅད་ལྷུག་སྤེལ་གསུམ་གྱི་ལྗགས་རྩོམ་ཅི་རིགས་བཀོད་ཡོད། དེ་མིན་བོད་དམངས་ཁྲོད་ཀྱི་སྒྲུང་གཏམ་ཉུང་ཤས་ཤིག་ཀྱང་བསྡུས་ཡོད། ཀློག་བདེ་བའི་ཆེད་དུ་རྩོམ་སོ་སོའི་མཐར་བརྡ་འགྲོལ་ཡང་གང་འཚམ་ཞིག་དང་། དེབ་མཇུག་ཏུ་ལུང་ཁུངས་རེའུ་མིག་ཀྱང་བཞུགས་པ་འདི་པེ་ཅིན་དུ་མི་རིགས་དཔེ་སྐྲུན་ཁང་ནས་པར་དུ་བསྐྲུན། སྤྱི་ལོ༡༩༩༡ ཟླ༦ ཚེས༡ ལ་པར་གཞི་དང་པོ་བསྒྲིགས། ༡༩༩༨ ལོའི་ཟླ༨ ལ་པར་ཐེངས་གཉིས་པ་བརྒྱབ། དེབ་ཚད་༨༥༠×༡༡༦༨ ། དཔར་ཤོག་༡༡་༨༧༥ ཡིན། དེབ་དངོས་གཞི་ལ་ཤོག་ངོས༣༥༨ བཞུགས། ད་ལྟ་སི་ཁྲོན་ཞིང་ཆེན་བོད་ཡིག་སློབ་གྲྭ་སོགས་སློབ་གྲྭ་མི་ཉུང་བས་སློབ་དེབ་ཏུ་བེད་སྤྱོད་གཏོང་བཞིན་པའོ། །" },
        { "cell": "arithmetic", "text": "རིག་བྱེད་ (Rig Veda / Vedic tradition) = वेद परम्परा, हिन्दु धर्मसँग सम्बन्धित प्राचीन ज्ञान र धार्मिक ग्रन्थहरू।" },
        { "cell": "arithmetic", "text": "བསྟན་པ་ (Buddhist teaching / Buddha Dharma) = बुद्धको शिक्षा, अर्थात् बौद्ध धर्मको उपदेश।" },
        { "cell": "arithmetic", "text": "འཁོར་ལམ་ K→ 2 x (1)² = 2 ཡིན་ན། འཁོར་ཚན་དང་པོའི་ནང་དུ་རྩ་རྫས་གཉིས་ཡོད།" },
        { "cell": "arithmetic", "text": "འཁོར་ལམ་ L→ 2 x (2)² = 8 ཡིན་ན། འཁོར་ཚན་གཉིས་པའི་ནང་དུ་རྩ་རྫས་བརྒྱད་ཡོད།" },
        { "cell": "arithmetic", "text": "འཁོར་ལམ་ M→ 2 x (3)² = 18 ཡིན་ན། འཁོར་ཚན་གསུམ་པའི་ནང་དུ་རྩ་རྫས་བཅོ་བརྒྱད་ཡོད་དགོས་ཀྱང་།" },
        { "cell": "arithmetic", "text": "Al 2 O 3 + 2NaOH → 2NaAlO 2 + H 2 O(བུལ་རྫས་ཧ་འཚིས་ཅན།)" },
        { "cell": "ampersand", "text": "གྲོང་ཁྱེར་ཡོངས་ལ་སྤྱིའི་ས་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ15715.79(མུའུ23573668）ཡོད་པ་དང་། ས་ཞིང་མཁོ་སྤྱོད་རང་བཞིན་གྱི་གྲུབ་སྟངས་ལས་ཞིང་སའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི5.53ཡོད་ཅིང་དེས་ས་ཁྱོན་སྤྱིའི0.24％ཟིན་ཡོད། ནགས་ལས་ཀྱི་སའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི312.45ཡོད་ཅིང་དེས་ས་ཁྱོན་སྤྱིའི13.27％ཟིན་ཡོད། རྩྭ་སའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི1793.63ཡོད་ཅིང་དེས་ས་ཁྱོན་སྤྱིའི76.20％ཟིན་ཡོད། &nbsp;སྡོད་གནས་དང་གཏེར་ལས་ཐད་བཀོལ་བའི་སའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི1.59ཟིན་ཞིང་དེས་ས་ཁྱོན་སྤྱིའི0.08％ཟིན་ཡོད། འགྲིལ་འགྲུལ་ལ་བཀོལ་བའི་སའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི1.04ཟིན་ཞིང་དེས་ས་ཁྱོན་སྤྱིའི0.04％ཟིན་ཡོད། ཆུ་ཡིས་ཁྱབ་པའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི16.23ཡོད་ཅིང་དེས་ས་ཁྱོན་སྤྱིའི0.69％ཟིན་ཡོད། བཀོལ་སྤྱོད་མ་བྱས་པའི་སའི་རྒྱ་ཁྱོན་ལ་མུའུ་ཁྲི23.53ཟིན་ཞིང་དེས་ས་ཁྱོན་སྤྱིའི9.48％ཟིན་ཡོད། གནམ་གཤིས་དང་ས་བབས་ཀྱི་དབྱིབས། ཆུའི་འབབ་ཁུལ། ས་གཤིས་དང་སྐྱེ་དངོས་སོགས་ཀྱི་རྣམ་པ་དང་། བཀོལ་སྤྱོད་རང་བཞིན་སོགས་ཀྱི་རྒྱུ་རྐྱེན་ལ་གཞིགས་ནས་ས་ཁམས་ལ་སྐུ་རྒྱལ་(རྒྱམ་རྡོ་ཏི་གངས་དཀར་མཆེད་བརྒྱད་ཡི་འབྲོག་ལས་གཅིག་པོའི་ས་ཁུལ་དང་འབྲི་ཆུའི་ལྷོ་རྒྱུད་ལུང་འགག་གི་ཞིང་ནགས་འབྲོག་གསུམ་འདུས་པའི་ས་ཁུལ། རྩི་ཆུ་དང་མཚོ་ཆུའི་རི་ཀླུང་ཤིང་ནགས་ཀྱི་ས་ཁུལ་བཅས་གསུམ་ལ་དབྱེ་ཆོག" },
        { "cell": "ampersand", "text": "གྲོང་ཁྱེར་འདིར་གནས་མཚོ་དུ་མས་བསྐོར་བའི་གནས་རི་གྲགས་ཅན་ཞིག་ཡོད་པ་དེའི་མིང་ལ་རྒྱམ་རྒྱལ་རྡོ་ཏི་གངས་དཀར་མཆེད་བརྒྱད་ཟེར་ཞིང་། དེ་ནི་བོད་ཁམས་གནས་ཆེན་གངས་ཙཱ་རྡོ་གསུམ་(གངས་རི་དང་ཙཱ་རི། རྡོ་ཏི）ཡི་ཡ་གྱལ་ཡིན་ལ། བོད་ཀྱི་སྒྲུབ་གནས་གངས་ར་ཉེར་གཅིག་དང་དགེ་བསྙེན་ཉེར་གཅིག་གི་བྱེ་བྲག་ཞིག་ཀྱང་ཡིན། མདོ་ཁམས་གནས་ཆེན་ཉེར་ལྔའི་འཕྲིན་ལས་ཀྱིས་འགྲོ་བ་འདུལ་བའི་ཞི་བའི་གནས་ཡིན་ཞིང་རྡོ་ཏི་དུང་རྒྱ་མ་ཞེས་ཡོངས་སུ་གྲགས། ད་དུང་གནས་ཆེན་པད་མ་མཐོང་གྲོལ་དང་ཤོ་དཀར་འབེལ། རིན་ཆེན་ཤེལ་བྲག གཉན་རྒྱལ་རི་མཚོ་ཕུག་གསུམ། དང་པོ་གནས། རིགས་གསུམ་མགོན་པོ། བདུད་འདུལ་གླང་ཆེན་སོགས་གནས་བྱིན་རླབས་ཅན་མང་པོ་ཡོད། གནས་འདི་ནས་ཆུ་ཆེན་འབྲི་ཆུའི་ཡན་ལག་ཆེ་ཤོས་ལ་གཡི་ཆུ་དང་བྱ་ཆུ། ཟླ་ཆུའི་ཡན་ལག་ཆེ་ཤོས་ལ་རྩི་ཆུ་དང་མཚོ་ཆུ་གཙོ་བྱེད་པའི་འབབ་ཆུ་གྲངས་ལས་འདས་པ་ཞིག་གི་ཆུ་མགོ་འདི་རུ་ཡོད་ཅིང་ལྷུང་ལྷུང་བཞུར་བཞིན་ཡོད། འདབ་ཆགས་ཀྱི་གླིང་གར་གྱུར་པའི་གཉེན་རྒྱལ་མཚོ་དང་གསེར་གཡུ་མཚོ། རོང་པོ་མཚོ། རྒྱམ་མཚོ་ནག&nbsp;&nbsp; སྲིའུ་འོ་མཚོ་སོགས་དུ་མ་ཡོད། ཐང་ཆེན་ཞིག་ཡོད་པའི་མིང་ལ་དཔལ་ཐང་ཟེར་ཞིང་། དེ་ནི་གནའ་དུས་དམངས་སྲོལ་གཏམ་རྒྱུད་གཏམས་པའི་གསེར་གྱི་ནོར་གཞོང་ཆེན་མོ་ཞིག་ཡིན་ལ། དེར་ཡུལ་ཤུལ་དཔལ་ཐང་གནམ་གྲུ་འབབ་ཐང་འཛུགས་སྐྲུན་བྱས་ཡོད་པས་ཡུལ་ཤུལ་དང་ཕྱི་རོལ་ཡུལ་གྱི་མཁའ་ནས་འབྲེལ་བ་བྱ་སའི་གནས་གཅིག་པུ་དེ་ཡིན།" },
        { "cell": "ampersand", "text": "ཏཱ་ཧོར་ཐུབ་བསྟན་ཆོས་འཁོར་གླིང་། &#126;2026-29348-77 (talk) ༢༣:༢༥, ༡༥ སྤྱི་ཟླ་ལྔ་པ། ༢༠༢༦ (UTC)" },
        { "cell": "ampersand", "text": "&ndash; རྟག་ཏུ་འཕྲད་སྲིད་པའི་ཝེ་ཁེ་རིག་མཛོད་ནང་གི་རྨང་གཞིའི་དཀའ་རྙོག་སྐོར།" },
        { "cell": "ampersand", "text": "&ndash; འཚོལ་ཞིབ་、ལྟ་ཀློག་ད་དུང་ཝེ་ཁེ་རིག་མཛོད་བེད་སྤྱོད་ཐད་ཀྱི་དཔྱད་གཞི།" },
        { "cell": "ampersand", "text": "&ndash; ཇིད་འདྲ་བྱས་ན་ཝེ་ཁེ་རིག་མཛོད་ནང་རྩོམ་སྒྲིག་དང་རང་ཉིད་ཀྱི་ལེགས་སྐྱེས་འབུལ་བའི་སྐོར།" },
        { "cell": "ampersand", "text": "&ndash; ཝེ་ཁེ་རིག་མཛོད་ཤོག་ངོས་གསར་བཟོ་དང་རྩོམ་སྒྲིག་སྐོར་གྱི་རྨང་གཞིའི་གནད་དོན།" },
        { "cell": "ampersand", "text": "&ndash; དོ་དམ་མི་སྣ་ཟེར་བ་གང་ཡིན་པ་དང་（“sysop”ཡང་ཟེར་）ཞབས་ཞུའི་འཕྲུལ་ཆས་དོ་དམ་གྱི་ཆ་འཕྲིན་ཟེར་བ་གང་ཡིན་པའི་སྐོར།" },
        { "cell": "sports-time", "text": "ཁ་བ་རི་བའི་མཐོ་སྒང་ནས་ཡོང་བའི་བོད་ཀྱི་བུད་མེད་འདི་ལ2012ལོའི་ལོན་ཏོན་ཨོ་ལིན་ཕིག་འགྲན་ཚོགས་སྟེང་སྤྱི་ལེ20ཡིནཔའི་འདུར་རྒྱུག་འགྲན་བསྡུར་ཁྲོད་ཟངས་ཀྱི་རྟགས་མ་ཐོབ་པ་དང་། ཆུ་ཚོད1:25:16བཀོལ་ནས་ཨེ་ཤེ་ཡའི་ཟིན་ཐོ་ལས་བརྒལ་བ་རེད། དེ་ནི་བོད་རིགས་ཀྱིས་ཨོ་ལིན་ཕིག་འགྲན་ཚོགས་ཐོག་ལེན་པའི་རྟགས་མ་ཨང་དང་པོ་དེ་ཡིན།" },
        { "cell": "sports-time", "text": "2009-10-08 11:50:00 བེ་རི་འཇིགས་མེད་དབང་རྒྱལ། ཀློག་གྲངས། 179 མཆན 0 ཡོད།" },
        { "cell": "sports-time", "text": "རྩོམ་པ་པོ་དཀོན་མཆོག་བསྟན་འཛིན། རྩོམ་སྒྲིག་པ་བསོད་ནམས་རྡོ་རྗེ། དུས་ཚོད2008-4-9 10:43:23 ཡོང་ཁུངས་མཚོ་སྔོན་པོ་དྲ་བ།" },
        { "cell": "sports-time", "text": "ཟླ་ཚེས། 2018-10-14 17:06:44 རྩོམ་པ་པོ། སྟོང་སྐོར་གཡུང་དྲུང་བསྟན་པ། རྩོམ་ཁུངས། ཧི་མ་ལ་ཡའི་བོན། མཁན་པོ་ཨོ་རྒྱན་རིག་འཛིན་ནས་དྭ་ངོས་འདིར་སྒྲིག་འཇུག་བྱས།" },
        { "cell": "version-dot", "text": "ཁ་ཆེ་པ་བརྒྱ་ཆ༨༥.༩ (གཞུང་འབྲེལ་ཆོས་ལུགས་ནི་ཨེ་བྷ་ཌི་དང་སུ་ནཱི་དང་ཞི་ཡ་ཆོས་རྒྱུད་བཅས་ཡིན་ཡང་ཨེ་བྷ་ཌི་མང་ཤོས་ཡོད་པ་དང་གཞན་གཉིས་ཉུང་ངུ་ལས་མེད།) དང་ཡི་ཤུའི་ཆོས་པ་བརྒྱ་ཆ༦.༥དང་། ནང་པ་བརྒྱ་ཆ༥.༥དང་འཇིའུ་ཆོས་པ་བརྒྱ་ཆ༠.༡དང་། ཆོས་ལུགས་གཞན་བརྒྱ་ཆ༡དང་ཆོས་ལུགས་མེད་པ་བརྒྱ་ཆ༠.༢ཡིན།" },
        { "cell": "version-dot", "text": "སྒོར་དབྱིབས་རྩལ་འགྲན་ར་བ་ནི་རོ་མའི་དུས་རབས་ཀྱི་ཆེས་རླབས་ཆེ་བའི་བཟོ་སྐྲུན་ཞིག་ཡིན་ལ་ད་ལྟ་ཉར་ཚགས་བྱས་པ་ཆེས་ལེགས་པའི་སྒོར་དབྱིབས་ཀྱི་རྩལ་འགྲན་ར་བའང་ཡིན། དེ་ནི་རོ་མ་གྲོང་ཁྱེར་ཝེ་ནེ་སི་ཐང་ཆེན་གྱི་ཤར་ལྷོའི་མཚམས་སམ་ཨོ་ལེ་ལི་ཨན་ལྕགས་རིའི་ནང་རོལ་དུ་ཡོད་པ་དང་། དེའི་གྲུབ་ཚུལ་སྒྲིག་གཞི་སོགས་ཉར་ཚགས་བྱས་པ་ལེགས་པོ་ཡོད་པས་འཛམ་གླིང་གི་དཔེ་མཚོན་ལྟ་བུར་གྱུར་ཡོད། སྒོར་དབྱིབས་རྩལ་འགྲན་ར་བ་འདིའི་ཕྱི་ཚུལ་བཙན་རྫོང་ཆེན་པོ་ཞིག་དང་འདྲ་ཞིང་། རྒྱ་ཁྱོན་ལ་སྨི་གྲུ་བཞི་མ་20000དང་སྒོར་མཐའི་རིང་ཚད་ལ་སྨི་527 ཚངས་ཐིག་ལ་སྨི་188 མཐོ་ཚད་ལ་སྨི་57 ཡོད་དེ་ད་ལྟའི་རྩེགས་རིམ་19ཅན་གྱི་ཐོག་ཁང་ཞིག་གི་མཐོ་ཚད་དང་མཚུངས་ཤིང་འཁྱམས་རའི་ནང་ལྟད་མོ་བ་ཁྲི་10.7ཙམ་ཤོང་ཐུབ།" },
        { "cell": "version-dot", "text": "འཛམ་གླིང་སྟེང་མིང་དུ་གྲགས་པའི་གཏོར་གཟུགས་མཆོད་རྟེན་ནི་སྤྱི་ལོ་སྔོན་གྱི་2600ལོར་བསྐྲུན་འགོ་ཚུགས་ཤིང་ད་ལྟའི་བར་ཁྱོན་བསྡོམས་གཏོར་གཟུགས་མཆོད་རྟེན་བརྒྱ་ལ་ཉེ་བ་གསར་རྙེད་བྱུང་། དེ་ནི་འཛམ་གླིང་ཐུན་མོང་གི་ཁས་ལེན་པའི་གནའ་བོའི་འཛམ་གླིང་གི་ངོ་མཚར་ཆེན་པོ་བརྒྱད་ཀྱི་གཅིག་གྲས་ཡིན། གཏོས་ཆེ་ཞིང་མིང་དུ་གྲགས་པ་ནི་མི་རབས་གསུམ་གྱི་གཏོར་གཟུགས་མཆོད་རྟེན་ཏེ་ཧོ་ཧྥོ་གཏོར་གཟུགས་མཆོད་རྟེན་དང་ཧ་ཧྥོ་ལ་མཆོད་རྟེན་ཆེན་མོ། མེན་ཁ་ཝོ་ལ་གཏོར་གཟུགས་མཆོད་རྟེན་བཅས་ཡིན། དེ་ལས་རྔམ་བརྗིད་ལྡན་ཞིང་མིང་དུ་གྲགས་པ་ནི་ཧོ་ཧྥོ་གཏོར་གཟུགས་མཆོད་རྟེན་ཆེན་མོ་ཡིན། གཏོར་གཟུགས་མཆོད་རྟེན་འདིའི་རྨང་མཐའི་རིང་ཚད་ལ་སྨི་270དང་མཐོ་ཚད་ལ་སྨི་157.1ཡོད་ལ། བརྩེགས་རྡོ་ཆེན་པོ་ཁྲི་230ཡིས་གྲུབ་ཅིང་རྡོ་ལེབ་རེའི་ལྗིད་ཚད་ལ་ཆ་སྙོམས་ཀྱི་ཏུན་205ཡོད་པ་རེད། བཟོ་བཀོད་ཀྱི་གཏོས་ཆེ་ཞིང་སྒྲིག་གཞིའི་ཚགས་དམ་པའི་གནའ་བོའི་ཤེས་རིག་གི་བསྡུས་གཟུགས་འདི་ཚན་རིག་ཆེད་མཁས་པ་མང་པོ་ཞིག་གི་མཚར་འཛིན་གྱི་བློ་ཁ་ཕྱོགས་ཡུལ་ཞིག་ཏུ་གྱུར་ཡོད། གནའ་བོའི་ཨེ་ཅིབ་མིའི་བཤད་རྒྱུན་ལྟར་ན་གཏོར་གཟུགས་མཆོད་རྟེན་ནི་གནའ་བོའི་ཨེ་ཅིབ་ཀྱི་རྒྱལ་རབས་སོ་སོའི་རྒྱལ་པོ་དག་གི་བང་སོ་ཡིན་པ་དང་། རྒྱལ་པོ་དང་འབྱོར་ལྡན་སྐུ་དྲག་དག་ཚེ་ལས་འདས་རྗེས་ཀྱི་འདོད་རྒུ་ལོངས་སུ་སྤྱོད་སའི་གནས་ཤིག་ཀྱང་ཡིན་པར་གྲགས།" },
        { "cell": "version-dot", "text": "སྟག་རྩེ་ཞེས་པ་ནི། རི་བོ་སྟག་ལྟ་བུའི་རྩེ་མོར་གནས་པས་རྫོང་ངམ་རྫོང་བཙན་པོ་སྟག་ལྟ་བུའི་དོན་སོགས་གསུང་སྲོལ་མི་འདྲ། ད་ལྟའི་སྟག་རྩེ་རྫོང་ནི། སྔོན་གྱི་སྟག་རྩེ་རྫོང་གི་མིང་རང་སོར་བཞག་པ་དང་། སྔོན་གྱི་སྟག་རྩེ་རྫོང་ནི། ད་ལྟའི་སྟག་རྩེ་རྫོང་གི་ཆུ་ཕར་ཕྱོགས་ཕུན་ཚོགས་གླིང་ཞེས་པར་རྫོང་ཤུལ་དང་བཅས་པ་ཡོད། ད་ལྟའི་སྟག་རྩེ་རྫོང་ནི་སྔོན་བདེ་ཆེན་རྫོང་གི་འདབས་ཁྲོན་བོད་རླངས་འཁོར་འགྲོ་ལམ་གྱི་ཞོགས་སུ་ཆགས་ཡོད། རྫོང་དེའི་སྤྱིའི་རྒྱ་ཁྱོན་ནི་སྤྱི་ལེ་ངོས་སྙོམ་གྲུ་བཞི་མ་1370དང་། ས་ཞིང་མུའུ་ཁྲེ་6.8ནགས་ཚལ་མུའུ་ཁྲི་17མི་འབོར་ཁྲི་2.3ཆ་སྙོམས་རྒྱ་མཚོའི་ངོས་ལས་སྤྱི་ཁྲི་4500ཙམ་གྱི་ས་བབས་བཅས་ཡིན།" },
        { "cell": "version-dot", "text": "ལི་ཐུ་ཨེ་ནི་ཡ་ངམ་ལེ་སུ་ནི་ཡྰ་ ༼ ལི་ཐུ་ཨེ་ནི་ཡའི་སྐད་དུ་Lietuva ༽ ལེ་སུ་འན་ན་ཞེས་ཀྱང་འབོད། མིང་ཆ་ཚང་ལ་ལོ་སུ་འན་ན་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཡིན། རྒྱུན་པར་ཡོ་རོབ་གླིང་།ཡོ་རོབ་གླིང་གི་ཤར་ཕྱོགས་དང་ལྷོ་ཕྱོགས་ཀྱི་ཁོངས་གཏོགས་ཤིག་གི་རྒྱལ་ཁབ་ཅིག་ལ་ངོས་འཛིན། རྦོ་ལི་ཁུ་མཚོའི་ཤར་བྱང་གི་འགྲམ་ངོགས་སུ་ཆགས་ཡོད་ལ། ལྷོ་བྱང་གི་མཚམས་སུ་ལོ་ཐྲི་བ་དང་སྦྲེལ་ཡོད་ལ། ཤར་བྱང་གི་མཚམས་སུ་རྦེ་ལོ་རོས་རྒྱལ་ཁབ་དང་སྦྲེལ་ཡོད། ནུབ་ལྷོའི་མཚམས་སུ་པོ་ལན་དང་ཨུ་རུ་སུའི་ཁ་ལེན་རྒི་ར་རྡུ་དང་སྦྲེལ་ཡོད། མི་གྲངས་ལ་ཁྲི་༣༠༠.༤ལྷག་ཙམ་ཡོད། ལྦེ་ན་འ་སི་ནི་ཆེས་ཆེ་བའི་གྲོང་ཁྱེར་དང་རྒྱལ་ས་ཡིན། ཕྱི་ལོ་༡༣༠༠ལ། ལེ་སུ་འན་ན་ནི་ཡོ་རོབ་གླིང་དུ་ཆེས་ཆེ་བའི་རྒྱལ་ཁབ་ཞིག་ཏུ་གྱུར།" },
        { "cell": "version-dot", "text": "སི་ཁྲོན་ཞིང་ཆེན་གྱི་བསྡུས་མིང་ལ་ཧྲུའུ(蜀)ཟེར་ཞིང་། སའི་རྒྱ་ཁྱོན་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི ༤༧.༨༣དང་། མི་གྲངས་ཁྲི ༨༣༢༣ ཡོད། འདུས་སྡོད་བྱེད་པའི་མི་རིགས་ནི་རྒྱ་རིགས་དང་། དབྱིས་རིགས། བོད་རིགས། མིའི་རིགས། ཧུའེ་རིགས། འཇང་རིགས་བཅས་ཡིན། ཞིང་ཆེན་འདིའི་ལྟེ་གནས་གྲོང་ཁྱེར་ནི་ཁྲིན་ཏུའུ་ཡིན་ལ། མངའ་ཁོངས་སུ་རང་སྐྱོང་ཁུལ ༣ དང་། ས་ཁུལ་རིམ་པའི་གྲོང་ཁྱེར ༡༨ རྫོང་རིམ་པའི་གྲོང་ཁྱེར ༡༤ རྫོང ༡༢༣ རང་སྐྱོང་རྫོང ༣ བཅས་ཡོད།" },
        { "cell": "version-dot", "text": "རྒྱལ་མོ་རྔུལ་ཆུའི་བཞུར་རྒྱུན་གྱི་སྤྱིའི་རིང་ཚད་ལ་སྤྱི་ལེ ༣༢༠༠ དང་། བཞུར་ཡུལ་གྱི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི ༣༢.༥ཡོད། བོད་ཡུལ་དུ་རྒྱལ་མོ་རྔུལ་ཆུའི་བཞུར་རྒྱུན་གྱི་རིང་ཚད་ལ་སྤྱི་ལེ ༡༥༤༠ དང་། བཞུར་ཡུལ་གྱི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི ༡༢ ཡོད། རྒྱལ་མོ་རྔུལ་ཆའི་བཞུར་རྒྱུན་མགྱོགས་པ་མ་ཟད། བཞུར་ཡུལ་གྱི་ས་བབ་རྩུབ་ཅིང་གྲོག་རོང་མང་བས་ཆུ་བེད་ཐོན་ཁུངས་ཧ་ཅང་ཕུན་སུམ་ཚོགས་པའི་ཆུ་བོ་ཞིག་ཡིན།" },
        { "cell": "version-dot", "text": "ཁྲུང་ཆིན་གྲོང་ཁྱེར་གྱི་བསྡུས་མིང་ལ་ཡུས༼渝༽ཟེར་ཞིང་། སའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ་ཁྲི༨.༢༣དང་། མི་གྲངས་ཁྲི༣༠༤༢ཡོད། འདུས་སྡོད་བྱེད་པའི་མི་རིགས་ནི་རྒྱ་རིགས་དང་། ཧུའེ་རིགས། མིའོ་རིགས། ཐུའུ་ཅ་རིགས། དབྱིས་རིགས། བོད་རིགས་བཅས་ཡིན། མངའ་ཁོངས་སུ་ས་ཁུལ༡༤དང་། རྫོང་རིམ་པའི་གྲོང་ཁྱེར༤ རྫོང༨ རང་སྐྱོང་རྫོང༤བཅས་ཡོད།" },
        { "cell": "quote-letter", "text": "ལོ་ཧྲིལ་བོའི་ཆ་སྙོམས་དྲོད་ཚད་ནི་ ༧.༨'c དང་། ལོ་ཧྲིལ་བོའི་ཆར་ཆུའི་འབབ་ཚད་ནི་མི་ལི་མེ་ཏྲེར་ ༣༥༠ ནས་ ༤༠༠ བར་ཡིན། རྫོང་ཁོངས་སུ་རྨ་ཆུའི་བཞུར་རྒྱུན་གྱི་རིང་ཚད་ནི་ཀི་ལོ་མེ་ཏྲེར་༩༦ དང་། དེ་ནི་དབྱར་དགུན་སྟོན་དཔྱིད་མེད་པར་དྭངས་ཤིང་གཙང་ལ་གཡུ་མདོག་དང་ལྡན་པས་རྨ་ཆུ་སྔོན་པོ་ཞེས་སུ་གྲགས། རྒྱལ་ཁབ་ཀྱི་བཟོ་སྐྲུན་གཙོ་བོའི་གྲས་དང་རྨ་ཆུའི་སྟོད་རྒྱུད་ཀྱི་སྐས་རིམ་ཆུ་བེད་ལྟེ་བའི་བཟོ་སྐྲུན་ཨང་གཉིས་པར་གྱུར་བའི་སྔོ་རྒྱའི་འགག་ཆུ་གློག་ས་ཚིགས་ཀྱི་ཤོང་ཚད་ལ་མེ་ཏྲེར་ལྷམ་པ་དུང་ཕྱུར་ ༡༦.༥ དང་། ཆུ་རགས་ཀྱི་མཐོ་ཚད་ལ་མེ་ཏྲེར་ ༡༦༥ དང་། ཆུ་མཛོད་ཧྲིལ་བོའི་ཆུ་ངོས་རྒྱ་ཁྱོན་ལ་ཀི་ལོ་མེ་ཏྲེར་གྲུ་བཞི་མ་ ༣༢ ཡོད་པས། དྭངས་ཤིང་གཙང་ལ་གཡུ་མདོག་ལྡན་པའི་མཚོ་མོ་ཞིག་ཏུ་གྱུར་ཡོད། ཆུ་གློག་ས་ཚིགས་འདིས་ལོ་རེར་གློག་ཤུགས་སྟོང་ལྦད་དུང་ཕྱུར་ ༥༩ འདོན་སྤེལ་ཐུབ་པ་ཡིན།" },
        { "cell": "quote-letter", "text": "ནགས་ཚལ་དུ་གནའ་བོའི་གསོམ་པ་དང་ཚ་གྲང་ནད་ཀྱི་གཉེན་པོར་གྱུར་བའི་སྨན་རིགས་མང་བོ་ཡུལ་འདིའི་འགྲོ་བ་ཡོངས་ཀྱི་སྤྱི་མཐུན་ལས་ཀྱི་སྐལ་བར་ཤར་ཡོད་པས་མི་ཚད། དྭངས་གཙང་ཡིད་དུ་འོང་བའི་ཆུ་མིག རང་བྱུང་ལྷུན་གྱིས་གྲུབ་པའི་བྲག་ཕུག ལྷུང་ལྷུང་སྒྲ་སྙན་སྒྲོག་པའི་ཆུ་ཕྲན་སོགས་ཀྱིས་མཛེས་སྡུག་ཡིད་གར་འོང་བའི་རང་བྱུང་གི་མཛེས་ལྗོངས་ཤིག་ངང་གིས་གྲུབ་ཡོད། གཞན་སྟོད་ན་དཀར་བོ་ལྷ་ཡི་རྫོང་དྲུག་དང་བར་ན་དམར་བོ་བཙན་གྱི་རྫོང་དྲུག སྨད་ན་སྔོན་མོ་ཀླུ་ཡི་རྫོང་དྲུག་ཏུ་འབོད་པའི་ཁམས་རའི་རྫོང་ཆེན་བཅོ་བརྒྱད་ཀྱང་མ་བཞེངས་པའི་ལྷ་སྐུ་རང་བྱོན་དང་མ་བསྒྲུབས་པའི་གཏོར་མ་རང་གྲུབ་ཀྱི་ཚུལ་དུ་ཡོད་ལ། རྫོང་ཆེན་བཅོ་བརྒྱད་ཀྱི་ཆ་སྙོམས་མཐོ་ཚད་ལ་རྒྱ་མཚོའི་ངོས་ལས་མེ་ཏྲེར་ ༢༠༠༠ ནས་ ༣༠༠༠ བར་ཡིན་ལ། ཆེས་མཐོ་སར་རྒྱ་མཚོའི་ངོས་ལས་མེ་ཏྲེར་ ༤༡༡༨ དང་། ཆེས་དམའ་སར་རྒྱ་མཚོའི་ངོས་ལས་མེ་ཏྲེར་ ༢༠༨༢ ཡིན། ལོ་རེའི་ཆ་སྙོམས་དྲོད་ཚད་ནི་ ༢.༩'c དང་། རྫོང་ཆེན་བཅོ་བརྒྱད་ཀྱིས་གཙོ་པའི་གནས་རི་ཕལ་ཆེར་བ་བྱེ་རྡོ་དམར་མདངས་ལས་གྲུབ་པས་ས་སྒང་གི་གསོན་སྙིང་དམར་བོ་ཞིག་དང་མཚུངས།" },
        { "cell": "quote-letter", "text": "ཞང་ཀང(རྒྱ་ཡིག: 香港､ དབྱིན་ཡིག: Hong Kong)་ མིང་ཡོངས་ལ་ཟེར་ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཞང་ཀང་དམིགས་བསལ་སྲིད་འཛིན་ཁུལ(རྒྱ་ཡིག: 中華人民共和國香港特別行政區､ དབྱིན་ཡིག: Hong Kong Special Administrative Region of the People's Republic of China)་ གྱི་སའི་རྒྱ་ཁྱོན་ལ་སྤྱི་ལེ་གྲུ་བཞི་མ ༡༡༠༦དང་ མི་གྲངས་ཁྲི ༧༢༩ལྷག་ཡོད འདུས་སྡོད་བྱེད་པའི་མི་རིགས་ནི་རྒྱ་རིགས་དང་ཧེའུ་རིགས་སོགས་ཡིན མངའ་ཁོངས་སུ་ཞང་ཀང་གླིང་ཕྲན་དང་ཅིའུ་ལུང་ ཞིན་ཅེ། ཉེ་འགྲམ་གྱི་གླིང་ཚོམ་སོགས་ཡོད།" },
        { "cell": "quote-letter", "text": "ཨལ་ལྗེ་རི་ཡ་ – ཨལ་ཇེ་རི་ཡ་དམངས་གཙོ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ People's Democratic Republic of Algeria 阿爾及利亞" },
        { "cell": "quote-letter", "text": "བྷང་ལ་རྡེ་ཤུ་ – བྷང་ལ་རྡེ་ཤུ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ People's Republic of Bangladesh 孟加拉" },
        { "cell": "quote-letter", "text": "ཀྲུང་ཀོ་ / རྒྱ་ནག་ – ཀྲུང་ཧྭ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ People's Republic Of China 中國" },
        { "cell": "quote-letter", "text": "ཀྲོང་གོ་ – China 中國 རྒྱ་ནག ཀྲོང་གོ་ ཀྲོང་གོ་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ People's Republic Of China 中華人民共和國" },
        { "cell": "quote-letter", "text": "བ་སོ་མཚོ་ཁ་ – བ་སོ་མཚོ་ཁ་སྤྱི་མཐུན་རྒྱལ་ཁབ Republic of Côte d'Ivoire" },
        { "cell": "ordinal-caps", "text": "ནང་བསྟན་དཔེ་ཚོགས་ལྟེ་གནས། BDRC: སྡོམ་པ་གསུམ་གྱི་སྙིང་པོ་བསྟན་པ་ཞེས་བྱ་བ། (IE0OPIDDB781DE)" },
        { "cell": "ordinal-caps", "text": "ནང་བསྟན་དཔེ་ཚོགས་ལྟེ་གནས། BDRC: དབུ་མའི་གཞུང་ལུགས་གསུམ་གསལ་བར་བྱེད་པ་ངེས་དོན་གྲུབ་པའི་ཤིང་རྟ་ཞེས་བྱ་བ། (IE0OPIDDB781DE)" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "རྗེ་བཙུན་མི་ལ་རས་པ། (1040 - 1123) ནི་ཡོངས་གྲགས་སུ་སྙན་ངག་མཁས་ཅན་དང་རྣལ་འབྱོར་བ་ཞིག་ཡིན། དྭགས་པོ་བཀའ་བརྒྱུད་པའི་བླ་མ་སྙན་གྲགས་ཅན་ཞིག་ཡིན་པར་མ་ཟད། མར་པ་ལོ་ཙཱ་བ་ཆོས་ཀྱི་བློ་གྲོས་ཀྱི་ཐུགས་སྲས་ཤིག་རེད། ཁོང་གིས་མགུར་མ་སྙན་པོ་མང་པོ་བཞེངས་ཡོད། ཐུགས་སྲས་གཙོ་བོ་ལ་ནི་དྭགས་པོ་ལྷ་རྗེ་དང་རྗེ་རས་ཆུང་པ་གཉིས་ཡོད་རེད།",
        "ཏཱ་ལའི་བླ་མ་མཆོག་གིས་ཁོང་གི་རྩོམ་ཡིག་\"སྙིང་རྗེའི་ཀུན་སྤྱོད\"(1999)ཞེས་པའི་ནང་གལ་ཏེ་ང་ཚོས་སྙིང་རྗེ་དེ་ང་ཚོས་བརྩེ་བ་ཡོད་མཁན་ཁོ་ནར་ཉར་ཚགས་བྱས་ན། མཐའ་མར་ང་ཚོས་སྙིང་རྗེའི་སྤུས་ཚད་དེ་མི་ཚེའི་ཆ་ཤས་ཤིག་ཏུ་འགྱུར་རྒྱུ་ཡིན་པ་ཤེས་རྟོགས་བྱུང་ནས་མིའི་སྤུས་ཚད་དང་ནང་སེམས་ཀྱི་སྟོབས་ཤུགས་ལ་སྐུལ་འདེད་གཏོང་རྒྱུ་ཡིན་ཞེས་བྲིས་ཡོད།",
        "རེའུ་​མིག་​འདི་​ནི་​རྒྱལ་​དབང་​ལྔ་​པའི་​དེབ་​ཐེར་​ལྟར་​བཀོད་​པ་​ཡིན་​ལ།",
        "མོ་སམ་བྷི་ཁུ་ – མོ་སམ་བྷི་ཁུ་སྤྱི་མཐུན་རྒྱལ་ཁབ Republic of Mozambique 莫三比克共和國",
        "ཚེས་༢ཉིན་ལས་འཁུར་དམ་བཅའ་ཕུལ་བ་བཅས་བཙན་བྱོལ་བོད་གཞུང་མང་གཙོའི་ལམ་སྲོལ་དུ་བསྒྱུར་བཅོས་མཛད།བོད་ཀྱི་མ་འོངས་རྩ་ཁྲིམས་ཀྱི་ཟིན་བྲིས་བསྡུས་པ་ཞིག་འདོན་སྤེལ་དང༌། བོད་ཆུ་ཡོས་སྤྱི་ལོ་༡༩༦༣ལོར་བོད་ཀྱི་མ་འོངས་རྩ་ཁྲིམས་རྒྱས་པ་གཏན་འབེབས་མཛད།",
        "བླ་བྲང་དགོན་བཏབ་ནས་ལོ་ཉིས་བརྒྱ་ལྷག་གི་རིང་ལ་མཁས་བཙུན་བཟང་གསུམ་ལྡན་ཞིང་འཆད་རྩོད་རྩོམ་གསུམ་ལ་མངའ་བརྙེས་པའི་མཁས་པ་སྐར་ཚོགས་ལྟར་གྲངས་མང་བ་དང་། སྒོས་སུ་འཇམ་དབྱངས་སྐུ་ཕྲེང་དང་པོ་དང་གཉིས་པ། གུང་ཐང་བསྟན་པའི་སྒྲོན་མེ། ཞང་བསྟན་པ་རྒྱ་མཚོ། ཤེས་རབ་རྒྱ་མཚོ། ངག་དབང་པཎྡི་ཏ་དཀོན་མཆོག་རྒྱལ་མཚན། གུང་ཐང་བློ་གྲོས། བླ་ཁོ་རིན་པོ་ཆེ། བྲག་དགོན་པ་བསྟན་པ་རབ་རྒྱས། དཔའ་རིས་རབ་གསར་སོགས་མཁས་པའི་ཡང་རྩེར་གསོན་པ་མཁས་མང་རྒྱུ་སྐར་གྱི་ཁྲོད་དུ་ཉི་ཟླ་ལྟར་བྱོན།",
        "Pamphylia, a nation made up of every tribe",
        "རྒྱལ་ཁབ་དེ་རུ་མི་རིགས་སྣ་མང་དང་རིག་གཞུང་སྣ་མང་འཛོམས་ལ་མི་མང་ཕལ་ཆེ་བ་མ་ལེ་མི་རིགས་ཡིན་པ་དང་། རྒྱ་རིགས་དང་རྒྱ་གར་མི་རིགས་ཀྱང་ཡོད། མ་ལེ་ཞི་ཡའི་གཞུང་འབྲེལ་སྐད་ཡིག་ནི་ལ་དན་གསལ་བྱེད་ཡིག་ཕྲེང་ནང་བྲིས་ཡོད་པའི་མ་ལེ་སྐད་ཡིག་ཡིན། དབྱིན་ཡིག་ནི་ཆེ་མཐོང་འཇོག་པའི་སྐད་ཡིག་ཅིག་ཡིན་ལ་ད་མེལ་སྐད་ཡིག་དང་རྒྱ་ཡིག་ཀྱང་རྒྱུན་དུ་བཀོལ་སྤྱོད་བྱེད་ཀྱིན་ཡོད། མ་ལེ་ཞི་ཡའི་ནང་ཁྱོན་སྐད་ཡིག་༡༣༠ཡོད་དེ། སྐད་ཡིག་༩༤མ་ལེ་ཞི་ཡའི་བྷོར་ལེའོ་ནང་དང་༤༠ཕྱེད་གླིང་ཕྲན་ནང་བཀོལ་གྱིན་ཡོད། ཁ་ཆེའི་ཆོས་ལུགས་ནི་གཞུང་འབྲེལ་གྱི་ཆོས་ལུགས་ཡིན་མོད། འོན་ཀྱང་མ་ལེའི་མི་སེར་མིན་པ་ཚོས་ཆོས་ལུགས་གཞན་རྣམས་ཉམས་ལེན་བྱེད་པའི་རང་དབང་ཡོད།",
        "ཝང་ཞི་ཀྲི་(༣༢༡-༣༧༩)(རྒྱ་སྐད།: 王羲之)ནི་ཅིན་རྒྱལ་རབས་ཀྱི་ཡིག་གཟུགས་དང་རི་མོ་མཁས་ཆེན་ཡིན་ཞིང་བྱེ་བྲག་ཏུ་ཡིག་གཟུགས་སྒྱུ་རྩལ་ལ་ནང་བྱན་ཆུད་པའི་མཁས་པ་ཞིག་ཡིན། ཁོང་གིས་ཀྲུང་ཡའོ་དང་ཀྲང་ཀྲི་ཐོད་ལ་བཀུར་ནས་ལུའེ་བྲིས་དང་འཁྱུག་བྲིས་ལ་སྦྱངས་པ་གཉེར་ཡོད། ༼ལན་ཐིང་འགོ་བརྗོད་ཕྱག་བསྟར་མ་༽ཞེས་པ་ནི་ཁོང་གི་དཔེ་མཚོན་མཛད་ཆོས་ཡིན་ལ་རྒྱ་ཡིག་གི་གཟབ་མ་འཁྱུག་གི་བྲིས་དཔེ་སྔ་ཤོས་ཡང་ཡིན། ཐང་རྒྱལ་རབས་ཀྱི་རྗེས་ནས་ཝང་ཞི་ཀྲི་ལ་\"ཡིག་གཟུགས་ཀྱི་རྗེ་བོ་\"ཞེས་པའི་སྙན་མིང་ཡོད།",
        "ཞེས་བྱ་བྱེད་ལ་ཡོད་པའི་ལས་གཉིས་པོ་དེ་ལ་ལས་ཞེས་བཏགས་རུང་བ་ཙམ་དུ་གསུངས་པའི་ཕྱིར། འགའ་ཞིག་གིས་འདིའི་གནས་ལུགས་མ་ཤེས་པར། གོང་གི་ཚིགས་བཅད་དེ་དང༌།",
        "སྤྱི་སྒྲ་ནི། བརྗོད་བྱའི་དོན་དེ་དམིགས་ཀྱིས་མ་བསལ་བར་དེའི་རིགས་སམ་སྤྱི་ཙམ་བརྗོད་པའི་ཚིག་ཕྲད་དེ། དཔེར་ན། གང་ཞིག་ཀུན་ལ་མུན་པ་གཏན་བཅོམ་ཞིང༌།། ལྟ་བུ།",
        "༦ ག་ག་ང་ཁ་བ་ས་ལ་། ཨ་་ཝ་་ལག་པ་མ་གང་།",
        "ཤོད་སྲོལ་གཞན་ཞིག་ནི། ཚོགས་མཆོད་སེར་སྦྲེངས་ནི་རྒྱལ་མཆོག་ལྔ་པ་ཆེན་པོའི་ཐུགས་ཀྱི་མནལ་ལམ་དུ་སེར་སྦྲེངས་ཀྱི་དབུ་ནས་ཁྱམས་ར་བརྒྱུད་རྩེ་ཕོ་བྲང་ལ་བསྐོར་བ་དང་། དེ་ནས་ར་མོ་ཆེ་བརྒྱུད་མཐར་གཙུག་ལག་ཁང་དུ་འབྱོར་ནས་སླར་ཡང་ཇོ་བོའི་ཐུགས་ཁར་རང་འཇགས་ཐིམ་པའི་གཟིགས་སྣང་བྱུང་བ་རྣམས་གོང་ས་ལྔ་པ་སྐུ་ངོ་མས་དབུ་ཁྲིད་ནས་སེར་སྦྲེངས་ཀྱི་ཡོ་བྱད་བསམ་གྱིས་མི་ཁྱབ་པ་རྣམས་ཇི་མ་ཇི་བཞིན་ལེགས་བསྒྲུབས་ཀྱིས་ཚོགས་མཆོད་སེར་སྦྲེངས་དེ་གསར་གཏོད་གནང་བ་ཡིན་ཟེར།",
        "ཁོར་ཡུག་(མ་ལག་)ནི་མཐའ་འཁོར་གྱི་བྱ་དངོས་ཀྱི་དངོས་ཁམས་མ་ལག་དང་སྤུད་ཚད། ནུས་ཚད། ད་དུང་དེ་མིན་གྱི་ནུས་པ་ཕན་ཚུན་ནུས་པ་ཐོན་རེས་བྱེད།",
        "ཧྲོའུ་སི་(ཉི་ཧོང་སྐད།: 寿司)ནི་ཞེས་པ་སྒྲ་སྒྱུར་བྱས་པ་སྟེ། དེ་ནི་རི་པིན་གྱི་རྒྱུན་ཟས་ཤིག་ཡིན། རྒྱུ་ཆ་ལ་ཕག་ཤ་བསྙལ་མ་དང་། འབྲས། སྒོ་ང་། ཚྭ་ཁུ། ཚུའུ་སོགས་ཡོད། རྒྱུ་ཆ་དེ་དག་ལེགས་པོར་བསྡེབས་རྗེས། གློག་ཟངས་ནང་དུ་བཙོ་བར་བྱེད་ལ། དེ་ནས་སྒོང་ལེབ་སྲེག་མའམ་ཡང་ན་སྨུག་ཚལ་གྱི་ཕྱི་ཤུན་གྱིས་རྒྱུ་ཆ་དེ་དག་དང་སྔོ་ཚལ། ཡང་ན་སིལ་ཏོག་སོགས་བསྒྲིལ་ནས་ཟ་བ་རེད།",
        "\"ཡུལ་བླ་ན་མེད་པའི་ཡོན་ཏན་གྱི་ཞིང་ཁྱད་པར་ཅན་དཀོན་མཆོག་གསུམ་\" ཞེས་པས་དཀོན་མཆོག་གསུམ་ཡོན་ཏན་ཆེན་པོས་ཁྱད་པར་དུ་ཕྱེ་བའི་ཞིང་གི་ཁྱད་ཆོས་ཡིན་པ་དང་། སངས་རྒྱས་ནི་མ་རིག་པའི་མུན་པ་སངས་ཤིང་ཤེས་བྱའི་ཡེ་ཤེས་རྒྱས་པས་ན་སངས་རྒྱས་ཞེས་བརྗོད། ཆོས་ནི་འཁྲུལ་པ་དང་སྡུག་བསྔལ་ལས་སྐྱོབ་པའི་ཆོས་ཉིད། དགེ་འདུན་ནི་ཆོས་ལ་སྤྱོད་པའི་ཚོགས་ཏེ་གསུམ་པོ་འདི་ནི་སེམས་ཅན་ཐམས་ཅད་ཀྱི་སྐྱབས་གནས་མཆོག་ཡིན་ནོ། །",
        "གཟིམ་ཤག ༡ གཟིམ་ཁང་དང་འདྲ། ༢ སྡོད་ས་ཡི་ཁང་པའི་ཞེ་ས། སྐུ་ངོ་མདའ་དཔོན་ཚང་གི་གཟིམ་ཤག་ཟེར་བ་ལྟ་བུ།།",
        "སླད་མར་ཡང་ལུས་ཚོའི་འཕྲོད་སྐྱོང་ལྷོད་མེད་ནས་རིན་བྲལ་ཡོན་ཏན་གནང་མཁན་དགེ་རྒན་ལ་བཅོས་མིན་སྲི་ཞུ་དང་སློབ་གྲོགས་ཕན་ཚུན་བར་མ་གཅིག་མངལ་ལས་སྐྱེས་པའི་སྤུན་མཆེད་ལྟ་བུའི་མཐུན་སྒྲིལ་བྱེད་ཁར་དཀའ་སྤྱད་འབད་བརྩོན་གྱིས་རང་འཁྲིའི་སློབ་ཚན་ཁག་ལེགས་པར་སྦྱངས་ཏེ་གུང་ཁྲན་རིང་ལུགས་ཀྱི་གོ་རྟོགས་ཇེ་མཐོར་བཏང་ནས་འབྱུང་འགྱུར་མཐུན་སྒྲིལ་དང་ཕྱུག་པོ། ཤེས་རིག་ལྡན་པའི་གངས་ཅན་གསར་བ་འཛུགས་སྐྲུན་བྱེད་མཁན་དམར་ཞིང་མཁས་པ་ཞིག་བྱེད་རྒྱུའི་བརྩོན་ལེན་བྱེད་པའི་འདུན་པ་ཤིན་ཏུ་ཆེ།",
        "འབའ་བྱང་དཀར་དགོན་ནི་སྔ་འགྱུར་རྙིང་མའི་སྨིན་གྲོལ་གླིང་གི་དགོན་ལག་ཞིག་ཡིན།ལོ་རྒྱུས་རིང་ལ།མཚན་སྙན་ཡང་ཤིན་ཏུ་ཆེ།སྨིན་གྲོལ་གླིང་གི་ཐོག་མ་རྒྱུད་པའི་ཕྱག་ལེན་མ་ཉམས་པར་ད་ལྟ་བཞུགས་ཡོད།",
        "ས་དཔྱད། དམར་པོ་རི་ལ་ལྕགས་རི་རྒྱ་ཁྱོན་དཔག་ཚད་གཅིག་ཡོད་པས་ལྕགས་པོ་རི་དང་། བར་མ་རིའང་ནང་དུ་ཚུད་ཡོད་ཅེས་གསུངས།",
        "བསྲེས་བརྒྱུད་ལ་ཞ་མ་ཕོ་མོའི་ལུགས་བསྲེས་པ་དུམ་བུ་ཀོ་བྲག་པའི་ལུགས། ཞ་མ་ཕོ་མོ་གཉིས་ས་ལུགས་དང་གསུམ་བསྲེས་པ་ཆ་གན་གྱི་ལུགས། འབྲོག་མི་དང་གྱི་ཇོའི་ལུགས་གཉིས་བསྲེས་པ་ཇོ་ནང་ཀུན་སྤོང་བའི་ལུགས། ལམ་འབྲས་སྦྱོར་དྲུག རྫོགས་ཆེན་གསུམ་བསྲེས་པ་ལ་སྟོན་དབང་རྒྱལ་གྱི་ལུགས་སོ།།",
        "མཛོད་ལས་\"ཀེང་རུས་ཆགས་བཅས་ཐམས་ཅད་ལ། རུས་པ་རྒྱ་མཚོའི་བར་དུ་ནི། །སྤྲོ་ཞིང་སྡུད་པས་ལས་དང་པོ། །ཀེང་རུས་ནས་ནི་ཐོད་ཕྱེད་བར། །བཏང་བས་སྦྱང་བ་བྱས་པར་བཤད། །\"ཅེས་གསུངས་པ་ལྟར་མི་སྡུག་པ་བསྒོམ་པའི་རིམ་པ་ལ་ཀེང་རུས་ནི་གཙོ་བོ་ཞིག་ཡིན། \"གཞན་ཤི་བའི་རོ་ཞག་དུ་མ་ལོན་པ་སྟེ་བམ་པ་དང་རུལ་མྱགས་ཀྱི་སྔོ་བ་དང་དམར་བ་དང་བསྣགས་པ་དང་འབུས་བཤིགས་པ་དང་ཀེང་རུས་མ་འཐོར་བ་དང་འཐོར་བ་དང་ཆར་ལྷགས་ཀྱིས་རུས་གོང་ཐི་བའི་མདོག་ལྟར་གྱུར་པ་རྣམས་ལ་བརྟག་ཅིང་བདག་གི་ལུས་ཀྱང་འདི་ལས་མ་འདས་སོ་ཞེས་ཡང་ཡང་བསམ་\" ཞེས་གསུངས་སོ། །",
        "ཟུར་དུ་བཀོད་པ། ཡི་དམ་ཆེན་པོ་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་བཀའ་བསྒོ་བྱ་ཚུལ་སོགས་མང་དུ་",
        "སྐར་རྩིས་ཀྱི་གཞུང་ལས། རེས་གཟའ་བདུན་པོ་དེ་གཡོན་བསྐོར་དང། རྒྱུ་སྐར་ཉེད་བདུན་པོ་རླུང་འགྲོས་ཀྱིས་གཡས་བསྐོར་དུ་བགྲོད་པ་ལྷན་ཅིག་ཏུ་འཛོམས་པ་ན་འབྲས་བུ་བཟང་ངན་སྣ་ཚོགས་འབྱུང་བར་བཤད་ཅིང། དཔེར་ན། སྨན་རྩིས་ཁང་གིས་སྔ་ལོ་ལྕགས་བྱ་ལོའི་གནམ་དཔྱད་འབྲས་བཤད་མདོར་བསྡུས་བྲིས་པའི་ནང། གཟའ་བདུན་སོ་སོས་ལོ་གཅིག་རིང་འབྱུང་འགྲོས་དང་འཁྱོག་འགྲོས་ཀྱི་ཁྱད་པར་མ་བརྟེན་ནས་ཟླ་བ་སོ་སོར་ཆར་ཞོད་ཆེ་ཆུང་དང་རླུང་ཤུག། ཐན་པ། སེར་བ་སོགས་ཡོད་མེད་དང། ལོ་ཐོག་སྐྱེས་བཟང་ངན་སོགས་གསལ་བཤད་བྱས་པ་ལྟ་བུ་ཡིན།",
        "དམིགས་བསལ་གྱིས་གཏན་འབེབས་བྱས་པའི་རྩ་འཛིན་ཁྲིམས་ཡིག །",
        "ཚངས་པའི་མིང་སྟེ་གསེར་གྱི་པདྨ་ལས་སྐྱེས་པའམ་ཁྱབ་འཇུག་གི་ལྟེ་བའི་པདྨ་ལས་སྐྱེས་པའི་ཆ་ནས་བརྗོད་འགྲེལ་པར་བཤད་ཅིང་། པད་སྐྱེས་མགྲིན་སྒྲ་ནི་ཚངས་པའི་དབྱངས་ཞེས་པའི་དོན་ཡིན།",
        "འདི་ལྟར་གན་དྷིའི་གསུང་དོན་དུ། འགྲོ་བ་མིའི་རིགས་ཀྱི་ལོ་རྒྱུས་ཡིག་ཆ་ལ་བལྟས་ན། མི་རྣམས་ཐོག་མ་ཉིད་ནས་ཕན་ཚུན་འཁོན་འཛིན་དང་། གསོད་གཏུབ། འཐབ་རེས་འཛིང་རེས་བྱས་པའི་གནས་ཚུལ་མཐོང་དུ་ཡོད་པ་མ་གཏོགས། འདི་ལྟར་འཚེ་བ་མེད་པ་དང་ཞི་བ་ལ་གནས་པའི་ཚུལ་ནི་མཐོང་དུ་མེད། གལ་སྲིད་ལོ་རྒྱུས་ལ་ཡོད་པ་དེ་ལྟར་དེ་ཁོ་ན་ཡིན་ན་ནི་འགྲོ་བ་མི་རྣམས་སྔ་མོ་ནས་རྒྱུད་ཆད་དེ་ཕྱི་མ་ཡོད་སྲིད་ཀྱི་མ་རེད། བདེན་པ་ཞིག་ལ། མི་རྣམས་ནི་ཕན་ཚུན་ཞི་བདེ་དང་། མཛའ་མཐུན། བྱམས་བརྩེའི་སེམས་ཀྱི་སྙིང་སྟོབས་ལ་བརྟེན་ནས་འཚོ་ཐུབ་པ་བྱུང་ཡོད། ཁོ་བོའི་བདེན་པའི་སྟོབས་ཤུགས་སམ་སེམས་ཀྱི་སྙིང་སྟོབས། ཡང་ན་སེམས་ཀྱི་རང་སྐྱོང་འདི་ནི་ཏག་ཏག་ལོ་རྒྱུས་སུ་བཙལ་ཀྱང་མཐོང་དུ་མེད་པའི་བདེན་པ་དེ་ཡིན་ཏེ། འཚེ་མེད་ཞི་བའི་རང་བཞིན་ཅན་ཡིན་ནོ།། ཞེས་བདེན་པ་བསྟན་འདུག་ནའང་། “མེ་མདའི་ཁ་ལས་སྲིད་དབང་ཐོན”པར་སྨྲ་བ་དང་། དམར་པོ་ཁྲག་གིས་རྒྱལ་ཁ་ལེན་པར་འདོད་པ། མི་བུའི་ཐོབ་ཐང་དམ་དྲག་གིས་གནོན་པར་བྱེད་པ། ཅིས་ཀྱང་དྲག་པོའི་ལས་ལ་རྔམ་རྔམ་གྱིས་འཇུག་པར་བྱེད་པའི་རིགས་ཀྱིས་ནི་ཞི་བའི་འཐབ་རྩོད་གང་དེར་སྣང་འཇོག་མི་བྱེད་ལས་ཆེ་མོད། འོན་ཀྱང་། གན་དྷི་དང་གན་དྷི་ལ་སོགས་པའི་སྐྱེས་བུ་ཆེན་པོ་རྣམས་ཀྱིས་ནི་ཏག་ཏག་ཉམས་ལེན་དེ་དང་། ཐབས་ལམ་དེ་དང་། གཏན་ཚིགས་དེ་དང་། ཨུ་ཚུགས་དེ་ལ་བརྟེན་ནས་ཞི་བའི་རྒྱལ་སར་འཁོད་ཅིང་འཛམ་གླིང་ཡོངས་ལ་བདེན་པའི་མན་ངག་བསྟན་སོང་ངོ་།།",
        "བརྡའི་དབང་གིས་གོ་བར་བྱ་བ་དེ་བརྗོད་བྱའི་མཚན་ཉིད། བརྗོད་བྱ་དང་། ཡུལ། གཞན་བྱ་གསུམ་དོན་གཅིག དཔེར་ན། བུམ་པ་དེ་བུམ་པ་ཞེས་བརྗོད་པའི་སྒྲའི་བརྗོད་བྱ་ཡིན་པ་བཞིན་ནོ། །",
        "དེ་རྗེས་ཨ་མདོ་སྟག་ཚང་ལྷ་མོས་ནང་ཆེན་གྱི་ཕྱོགས་ལ་དམག་དྲངས་སྐབས། རབ་བྱུང་བཅོ་ལྔ་པའི་ས་འབྲུག་སྤྱི་ལོ༡༨༦༨ལོར་རྒྱལ་ས་ནང་ཆེན་སྒར་དུ། ནང་ཆེན་གྲྭ་ནང་གི་དམག་བསྡུས། དམག་དཔོན་དུ། རྒྱལ་ཚབ་བརྒྱ་གྲངས་དཔོན་བསྐོས་ཤིང་། དེའི་རུ་གནོན་དཔུང་རོགས་སུ་ཁྱུང་པོ་མི་རིང་མ་དང་། སྦྲ་ཆེན་བཙན་གྲགས། སྤས་འབྲུག་རྒྱལ། ཨ་དྷི་བུ་དཀར་སོགས་རུ་འདྲེན་གྱི་དམག་དཔོན་དུ་བསྐོས་ཏེ་ལས་དམག་མང་པོ་དྲངས་ནས་སྟག་ཚང་ལྷ་མོའི་དམག་དང་འཐབ་འཛིང་བྱས་པས། དམག་དཔོན་རྒྱལ་ཚབ་བརྒྱ་གྲངས་དཔོན་དང་། སྦྲ་ཆེན་བཙན་གྲགས། ཨ་དྷི་བུ་དཀར། དེ་མིན་དམག་མི་མང་པོ་ཚེ་སྲོག་དགྲ་བོའི་མཚོན་འོག་ཏུ་ཤོར།",
        " ཕྱིས་གདན་ས་ཐོག་འོག་ལ་ཉམས་རྒུད་རིམ་པར་བྱུང་བ་དང་།",
        "མཁྱེན་བརྩེའི་སྤྲིན་དཀར་ཕྱོགས་མཐར་དཀྲིཌ་པ་ཡི།།",
        "མ་གི་ཐང་ལ་ངལ་བས་རྒྱུ་བའི་མིག་མེད་གྲོག་མ་ཡན་ཆད་དུ།།",
        "ལ་གཞིག་པའི་རྩོམ་ཡིག་རེ་གཉིས་ལས་མཐོང་རྒྱུ་མེད་པ་ནི་ཅི་འདྲ་་",
        "གར་ཁོ་ནས་ད་ལྟའི་བར་མུན་ནག་གི་དུས་རབས་ཞིག་བརྒྱུད་ནས་འོང་",
        "ལ་མི་འཇུག་པའི་བག་ཆགས་འཇོག་ཐབས་བྱ་དགོས། བྱིས་པས་བསམ་",
        "འོད་ཀོར་འདྲ་ན་རྒྱལ་པོ་གནོད། །ཙིག་ཁུང་ཉི་ཤར་འདྲ་ན་བཙན། །དར་ལྕེ་འདྲ་ན་ཀླུ་བཙན་གནོད། །སྡིག་པ་འདྲ་ན་ཀླུ་བདུད་གནོད། །ཤ་རུ་",
        "ན་དེ་གནས་བྱེད་གཞན་གང་། །གལ་ཏེ་རང་འཇིག་ངང་ཚུལ་བདག །མིན་ན་དེ་གནས་བྱེད་གཞན་གང་། ༈ །ལུས་ཀྱི་ཕུལ་བྱུང་འགྲིབ་",
        "སྣང་བ་བསླད་པ་ཉིད། །དེ་ལ་གཅིག་ནི་མེད་པས་ཀྱང་། །གཉིས་ཀའང་ཉམས་པར་འགྱུར་བ་ཡིན། ༈ །དེ་ཕྱིར་གཉིས་སྟོང་གང་ཡིན་པ། །",
        "བྲལ་གྱི། །དམ་བཅའ་ནུས་པ་མཚུངས་པ་ཡིས། །དམ་བཅའ་ཇི་བཞིན་དོན་ཅན་གྱི། །རྗེས་དཔག་ལ་ནི་ཇི་ལྟར་གནོད། །ལུང་རྣམས་ཚད་",
        "དེ་ཡང་གངས་ཅན་བོད་ཀྱི་རིག་པའི་གནས་ཆེན་ཀུན་གྱི་ཡ་གྱལ་སྒྲ་རིག་པའི་བསྟན་བཅོས་ཀྱི་རྗེས་འབྲེལ་རིག་གནས་ཆུང་བ་ལྔ་ལས། ཚིག་རྒྱན་ཤེས་ ན་སྙན་ངག་ལ་མི་རྨོངས་ཞེས་པའི་སྙན་ངག་དེ་ཉིད་སྦྱང་དགོས་པའི་དོན་",
        "མིག་དང་། རྣ་བ་། སྣ་། ལྕེ་། ལུས་། ཡིད་བཅས་ཀྱི་རྣམ་ཤེས་དྲུག་གམ་། ཡང་ན་སེམས་དྲུག་སྟེ་། རྩ་བའི་སེམས་དང་། རྗེས་སུ་དཔྱོད་པའི་སེམས་། རྣམ་པར་དཔྱོད་པའི་སེམས་། ངོས་པར་འཛིན་པའི་སེམས་། སྡོམ་པའི་སེམས་ སྨོན་པའི་སེམས་།",
        "ན་མོ་གུ་རུ་ཀ་ཡ་རཏ་བྷཿ ཆོས་རྗེ་དཔལ་ལྡན་བླ་མ་ཀུན་མཁྱེན་ཡབ་སྲས་ཀྱི་རྣམ་ཐར་ངོ་མཚར་རབ་གསལ་ཞེས་བྱ་བ། སྤྲུལ་སྐུ་ཆེན་པོ་ཆོས་རྗེ་མཚུངས་མེད་ཡབ་སྲས་རྣམས་ལ་ཕྱག་འཚལ་ཞིང་སྐྱབས་སུ་མཆིའོ།། ཐུགས་བརྩེ་བ་ཆེན་པོས་དུས་ཀུན་རྗེས་སུ་བཟུང་དུ་གསོལ།",
        "གླ་ཆ་སྤྲད་པ་ཙམ་མིན་པའི་རྟ་དང་འུ་ལག་ངོ་གཏོང་དགོས་པ།༼དུང་དཀར་ཚིག་མཛོད་ཆེན་མོ་༽ལས་བཏུས།",
        "རྒྱུད་ཁོངས་འདིའི་ནང་འབྲུག་ཡུལ་གྱི་རྫོང་ཁ་ཡིག་གཟུགས་གསར་སྣོར་བྱས་ཡོད་པ་དང་རྫོང་ཁ་ཡིག་གཟུགས་དང་བོད་ཡིག་གཉིས་ཀྱི་རྒྱལ་སྤྱིའི་ཨང་བསྒྲིགས་གཅིག་མཚུངས་ཡིན་སྟབས་བོད་ཡིག་ཆ་འཕྲིན་ལ་རྒྱབ་སྐྱོར་ཆེན་པོ་ཐེབས་ཡོད་པ་རེད།",
        "ཡོངས་གྲགས་སུ་རོ་སྒྲུང་ཟེར། འདི་ནི་རྒྱ་གར་གྱི་སློབ་དཔོན་ཆེན་པོ་ཀླུ་སྒྲུབ་ཀྱིས་རོ་ལངས་སྒྲུབ་ནས་ལུས་གསེར་དུ་བསྒྱུར་བའི་གཏམ་རྒྱུད་ལེའུ་མང་པོ་ཡོད་པ་ཞིག་ཡིན། སྒྲུང་ཤོད་མཁན་ནི་རོ་དངོས་གྲུབ་རྡོ་རྗེ་ཟེར་བའི་རོ་ལངས་དེ་སློབ་དཔོན་གྱི་སློབ་མ་བདེ་སྤྱོད་བཟང་པོས་བཏུལ་རྗེས་སྒལ་པར་ཁུར་ནས་ཁྱེར་ཡོང་བའི་ལམ་བར་དུ་རོ་དངོས་གྲུབ་རྡོ་རྗེས་བཤད་པ་ཡིན་ཟེར་སྲོལ་ཡོད། འདི་ལ་ལིའུ་ཉི་ཤུ་རྩ་གཅིག་ཡོད་པ། ཉི་ཤུ་རྩ་བདུན་ཡོད་པ། སུམ་ཅུ་སོ་བདུན་ཡོད་པ་སོགས་སྣ་ཚོགས་འདུག མཚོ་སྔོན་མི་རིགས་དཔེ་སྐྲུན་ཁང་དང་། མི་རིགས་དཔེ་སྐྲུན་ཁང་གཉིས་ནས་དཔར་སྐྲུན་བྱས་ཡོད།དུང་དཀར་ཚིག་མཛོད་ཆེན་མོ་༽ལས་བཏུས།",
        "ཉོན་མོངས་པས་བསྐྱེད་པའི་ལས་ངན་པའི་དབང་གིས་སེམས་ཅན་གྱི་ཤེས་པ་ལ་སྣང་བའི་འཁྲུལ་བའི་སྣང་བ་སྟེ། གསོད་བྱེད་ཀྱི་ཚུལ་དུ་མངོན་པར་འཆར་ཞིང་སེམས་ཅན་ལ་སྡུག་བསྔལ་བསྐྱེད་ཀྱང་ངན་སོང་དང་མཐོ་རིས་ཀུན་ཏུ་གནོད་པ་སྦྱིན་པར་བྱེད་པའོ། །",
        "རྗེས་སུ་ངས་ལྷ་མོ་ལ་མཛུབ་དཀྲིས་དེ་ཕྱིར་སྟེར་སྐབས། རྒྱུ་མཚན་མཐའ་དག་གཞི་ན་ཧ་གོ་སོང་། གང་ལྟར་ཀྱང་ལྷ་སྐྱིད་དང་ངེད་གཉིས་ཀྱི་བསམ་ཚུལ་ནི་གཅིག་པ་གཅིག་རྐྱང་རེད། ཡིན་ན་ཡང་། ལྷ་སྐྱིད་དང་ངེད་གཉིས་ཀྱི་འབྲེལ་བ་དེ་ལྷ་མོ་མ་གཏོགས་སུས་ཀྱང་མི་ཤེས་ལ། ཐ་ན་ངའི་ཕུ་བོ་ལའང་རྒྱུ་མཚན་གཅིག་ཀྱང་བཤད་མ་མྱོང་།",
        "མཐོ་རིམ་སྲོག་ཆགས་ཀྱི་རྩ་དཀར་རྒྱུད་རིམ་གྱི་ཆ་ཤས་གཙོ་བོ་ཡིན་ཞིང་ཀླད་རུས་ཀྱི་ནང་དུ་ཆགས་ཡོད། དེ་ཀླད་ཆེན་དང་ཀླད་ཆུང་། ཀླད་འབྲིང་། རྒྱུངས་པ་བཅས་འདུས་ནས་གྲུབ་པ་ཡིན་ཞིང་། དབང་པོ་ལྔས་ཡུལ་ཤེས་པ་དང་ལུས་ཀྱི་འགུལ་སྐྱོད་སོགས་ལ་དབང་སྒྱུར་བྱེད་ཀྱིན་ཡོད། མིའི་ཀླད་པ་བསམ་པ་དང་དྲན་ཤེས་ལ་སོགས་པའི་སེམས་ཉིད་ཀྱི་འཕྲོ་འདུ་ལ་དབང་སྒྱུར་བྱེད་ཀྱི་དབང་པོ་ཡིན། ཀླད་པའི་ཕྱི་ཤུན་སྐྱི་མོ་ལ་ཀླད་རྒྱ་ཟེར།",
        "མ་སྨད་མས། བྱ་ལེན་མ་གློ་བུར་བ་རྣམས་ལ་བསྙེན་པ་ནི་རིགས་པ་ཉིད་ཡིན་པས་བདག་ཅག་ཀྱང་འདིར་སྡོད་དོ།།",
        "དགུང་ལོ་ ༡༩ ཤིང་ཡོས། ༡༣༧༥ ཞ་ལུར། ལོ་ཙྪ་པ་མཁས་ཆེན་རིན་ཆེན་རྣམ་རྒྱལ་ལས་བདེ་མཆོག་མཻ་ཏྲི་བཅུ་གསུམ་མའི་དབང་། ས་བཟང་དུ། ས་བཟང་མ་ཏི་པཎ་ཆེན་ལས་སྒྲ་རིག་སོགས་ཆོས་འབྲེལ་གསན་ཞིང་། ས་སྐྱ་དང་། ངམ་རིང་། འགའ་རོང་། འདར་བཟང་ལྡན། བོ་དོང་བཅས་སུ་ཕར་ཕྱིན་གྱི་གྲྭ་སྐོར་མཛད་སྐབས་སྟོན་ཀ་ཡས་མས་ཡིན་པར་འདུག་ ཅིང་། དེ་ནས་ས་ཆ་མང་པོར་ཕེབས་པ་དང་། ཆོས་མང་དུ་གསན་ཅིང་སློབ་གཉེར་མཛད་པ་དང་། གནས་རྙིང་དུའང་ཆོས་ཐོག་ཙམ་བཞུགས་པ་སོགས་ཀྱིས་དགུང་ལོ་བཅུ་དགུའི་སྨད་དང་། ཉི་ཤུའི་དཔྱིད་རྫོགས་པར་མངོན། ༼འཇུག་ངོགས་(༢༠)ལས། དགུང་ལོ་བཅུ་དགུའི་སྟེང་། ནས། (༢༡) གཟུགས་སྒྲུབ་ཀྱི་སྟེང་དུ་ཕར་ཕྱིན་གྱི་གྲྭ་སྐོར་མཛད། ཅེས་པའི་བར། ༽",
        "དོན་ལ་རྒྱ་དམར་གཞུང་གིས་རྫུན་གཏམ་བཟོ་མཁན་རྣམས་རྒྱ་ཡན་དུ་བཏང་ཡོད་པ་ནི་ཆབ་སྲིད་ཀྱི་དམིགས་འབེན་ཡ་ང་བ་ཞིག་རེད། བོད་རྒྱའི་འགལ་བའི་བརྫུས་སྣང་བརྒྱུད་ནས་རྒྱ་ནག་དམར་ཤོག་གིས་བོད་ནང་བཟོས་ཟིན་པའི་མིའི་རིགས་ལ་རྒོལ་བའི་ཉེས་པ་འགེབས་ཐབས་དང་བོད་མིའི་ངོ་རྒོལ་གྱི་ཁ་གཏད་ཡུལ་མག་མོག་བཟོས་ཡོད་པས། བོད་རྒྱ་མི་རིགས་གཉིས་ཀྱི་བར་འགལ་བ་བསླངས་ཐུབ་པའི་ཁར། ཁག་དབྱེ་དབང་བསྒྱུར་གྱི་དམིགས་འདུན་འགྲུབ་ཡོད་པར་མ་ཟད། བོད་རྒྱ་གཉིས་སྟོབས་ཤུགས་གཅིག་སྒྲིལ་གྱིས་དྲག་གཞུང་ལ་ངོ་རྒོལ་བྱེད་པའི་ལམ་ཁ་བཀག་ཚར་ཡོད།",
        "1856ལོ(ལོ47)སྤྱི་མཐུན་ཏང་ནང་སྲིད་འཛིན་གཞོན་པའི་གོ་མིང་རྩོད་ལེན་བྱས་རུང་། འདེམས་ཤོག་བརྒྱ་ཡང་མ་བརྒལ།",
        "འགྲོ་ལ་རྗེས་སུ་བརྩེ་བ་གྲུབ་པ་ཀུན་ཐོབ་གྱུར།། མདོ་རྒྱན་ལེའུ་༡༨",
        "ཡང་ན་རེ་ཏི་མགོ་ཡག་ནི། དང་ཐོག་གནོད་སྦྱིན་ནག་པོའི་མངའ་ཁོངས་ཀྱི་ཚོ་པ་ཞིག་གམ་བློན་པོ་ཞིག་ཡིན་ལ། རང་གི་རྒྱལ་པོ་ལ་ངོ་ལོག་བརྒྱབ་ནས་སྲས་མོ་དྲི་ལྡན་མའི་དཔུང་གིས་ཡང་ཡང་དམག་འཁྲུག་བསླངས་པ་ལ་བརྟེན་ནས་སྲིད་དབང་ཐོབ་པ་ཞིག་ཡིན་ནམ་ཡང་སྙམ་སྟེ། འདིའི་སྲས་མོ་དང་གནོད་སྦྱིན་ཀྱི་རྒྱལ་པོ་གཉིས་དམག་འཁྲུག་བྱས་པའི་ལོ་རྒྱུས་ཤིག་ཀྱང་ཡོད་འདུག་པའི་ཕྱིར་རོ།། (འདི་དག་དམག་འཁྲུག་བྱས་པའི་གཏམ་རྒྱུད་རིག་བྱེད་ཀྱི་སྒྲུང་འདྲ་པོ་ཞིག་བླ་མ་འགའི་ཞལ་ལས་ཐོས་མྱོང་ཡང་མཐོང་མ་མྱོང༌། གལ་སྲིད་དེ་འདྲ་ཞིག་མཐོང་ན་བོད་ཀྱི་གནའ་བོའི་ལོ་རྒྱུས་ལ་དཔྱད་གཞིའི་རིན་ཐང་འགངས་ཆེར་ལྡན་ཡོད་པར་ཐེ་ཚོམ་མེད།) གང་ལྟར་འཛམ་གླིང་འདིའི་ཐོག་ལྷོ་འདུལ་བྱང་འཐབ་ཀྱི་དམག་འཁྲུག་ཐམས་ཅད་ནང་སུས་ཀྱང་འགྲན་ཟླ་མེད་པས་ཀུན་གྱིས་རྦད་དེ་བདུད་དུ་རྩིས་ནས་འཐབ་པའི་རེ་བ་ལྟ་བཞག་མིང་ཙམ་ཐོས་པས་སྐྲག་སྣང་བྱེད་དགོས་པ་ཞིག་ཏུ་གྱུར། ལྷག་པར་སྲས་མོ་དྲི་ལྡན་མས་དམག་གི་དམག་དཔོན་བྱས་ཏེ་འཛམ་གླིང་ཤར་ནུབ་ཀུན་ཏུ་དམག་བཀྱེས་ཏེ་འཐབ་ན་མི་རྒྱལ་བ་མེད་པའི་རྒྱལ་ཁ་བསྟུད་མར་བླངས་པས་སྙན་པའི་གྲགས་པ་ཕྱོགས་བཅུར་ཁྱབ་སྟེ་དམག་ཟོར་རྒྱལ་མོ་ཞེས་པའི་མཚན་གསོལ།",
        "དང་། ཁྱབ་ཆེའི་རང་བཞིན་ཅན་གྱི་ལས་འགུལ་ཅི་རིགས་ སློང་སྲིད་ལ། དེ་ལ་བཀག་འགོག་དང་། ངོ་རྒོལ་གྱི་སྦྱོར་བ་སྣ་ ཚོགས་རྩོམ་པའི་བླུན་རྨོངས་ཀྱི་དཔུང་ཚོགས་ཤིག་ཀྱང་ཤུགས་་བྱུང་དུ་འབྱུང་བ་ཆོས་ཉིད་རེད། དེ་ལྟར་མིའི་རིགས་སྤྱི་ཡོངས་ ཀྱི་ལོ་རྒྱུས་ལ་བྱུང་མྱོང་བའི་གོད་ཆག་སྟེ། རྨོངས་རྒོད་ཚོས་་་ ངན་སྦྱོར་བརྩམས་པའི་ཁྲོད་ནས་དམ་པ་གང་མང་ཞིག་ཉེས་་་་་ མེད་དུ་ཤི་གྲོན་ལ་སོང་བའི་སྐྱོ་གར་དེ་འདྲ་ནི་ལོ་རྒྱུས་ཀྱི་ཕམ་་་ཁ་བསུབ་ཏུ་མེད་པ་ཞིག་ཡིན་ནའང་། དེ་ལྟ་དེ་ཟློག་མེད་དུ་ བྱུང་ཞིང་འབྱུང་བ་ནི་ཆོས་ཉིད་ཀྱི་ནུས་པས་ཀྱང་ངོ་ལེན་མི་་་་་་ ཐུབ་པའི་རྦབ་རྒོད་ཐུར་འགྲིལ་གྱི་མངོན་སྟངས་གཞན་ཞིག་་་་་་་ རེད།",
        "རིན་འཁོར་ཕྱེད་དང་གཉིས་རེ་བཀྲས་ལྷུན་དུ། །",
        "ཅེས་ཟབ་གསང་ཆོས་འཁོར་གླིང་གི་ལོ་རྒྱུས་འདི་ནི། སྟོན་པའི་འདས་ལོ་ ༢༥༥༤ བོད་རྒྱལ་ལོ་ ༢༡༤༠ སྤྱི་ལོ་ ༢༠༡༣ ཟླ་བ་ ༧ ཚེས ༢༥ རབ་བྱུང་ ༡༧ པའི་ ཆུ་སྦྲུལ་ལོའ་ིཆུ་སྟོད་ཟླ་བའི་དམར་ཕྱོགས་ཀྱི་རྒྱལ་བ་དང་པོའ་ིཉིན། རྒྱ་སྟོན་པ་ཉི་ཤར་ སྤྲུལ་སྐུའམ་ཡོངས་གྲགས་སུ་ཤར་སྤྲུལ་དམ་ཆོས་རྒྱ་མཚོས་ཕྱག་བཏབ་པའི་བཤད་སྒྲུབ་གཉིས་ལྡན་གྱི་ཆོས་སྡེ་ཆེན་པོ། ཟབ་གསང་ཆོས་འཁོར་གླིང་ག་ལ་བ་དེར། རྒྱལ་སྟོན་པ་མཁན་པོ་ཨོ་རྒྱན་བསྟན་འཛིན་ཤེས་རབ་ཀྱིས་སྦྱར་བའོ།། དགེའོ།། །།",
        "༡༣. ཡོངས་ཕྲོག་གི་གབ་ཚིག ་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་་(346)",
        "དེ་ལ་སུམ་སྐུད་འཁྲུལ་ལྕེ་བྱས།། སྦྲུལ་སྣ་ཁྲ་འུར་འབབ་པ་ལ།།",
        "གཡུ་མགོན་གྱིས་གསུངས་པ། མཁས་པ་དེ་རྣམས་རིམ་ཅན་དུ་འབྱོན་ཏེ།བི་བྱི་ལེགས་མགོན། འུག་པ་ཆོས་བཟང་། ཆེར་རྗེ་ཞིག་པོ།མི་ཉག་རོང་རྗེ།གཡུ་ཐོག་མགོན་པོ། བྲང་ཏི་རྒྱལ་བཟང་། གཉའ་པ་ཆོས་བཟང་། སྟོད་སྨན་གྲགས་རྒྱལ། མཐའ་བཞི་དར་པོ་རྣམས་འབྱོན། དེ་རྣམས་ཀྱིས་བོད་ཡུལ་དུ་བོད་ཡུལ་དུ་གསོ་དཔྱད་སྤྱི་དང་། ཁྱད་པར་དཔལ་ལྡན་རྒྱུད་བཞི་དར་བར་བྱེད་གསུངས་པས། སྔར་གྱི་གསོ་དཔྱད་འབྱུང་ཁུངས་ཀྱི་ལོ་རྒྱུས་དང་།གསོ་དཔྱད་ཀྱི་དཔེ་རྣམས་ཇོ་བོ་བ་ནུ་མ་ལ་གནང་ངོ་།།དེས་བྲམ་ཟེ་ཤེས་རབ་རལ་གྲི་ལ་གནང་།དེས་རྒྱལ་པོ་དགའ་བའི་བློ་གྲོས།དེས་རྒྱལ་པོ་པདྨའི་དཔལ།དེས་རྒྱལ་པོ་དཔལ་ལྡན་ཕུན་ཚོགས་ལ།དེས་རྒྱལ་པོ་སྡོང་འདུམ་སྐྱེས།དེས་རྒྱལ་པོ་རྔ་ཆེན་པོ་ལ།དེས་སྨན་པ་བི་བྱི་དགའ་བྱེད།དེས་སྨན་པ་དུང་གི་ཐོར་ཅོག་ཅན་ལ་གནང་ངོ།།",
        "བོད་བཙན་པོའི་རྒྱལ་ཁབ་སིལ་བུར་འཐོར་ནས་ལོ་ངོ་དྲུག་ཅུ་བདུན་ཅུ་ལྷག་འགོར་རྗེས། གུ་གེ་རྒྱལ་བོ་བླ་མ་ཡེ་ཤེས་འོད་དང་ཕོ་བྲང་ཞི་བ་འོད།ཡེ་ཤེས་འོད་ཀྱི་ཚ་བོ་བྱང་ཆུབ་འོད་སོགས་ཀྱི་རིང་ལ་རྒྱ་གར་གྱི་དཔལ་ན་ལེན་དྲའི་པཎ་གྲུབ་བཅུ་བདུན་གྱི་ཡ་གྱལ་ཇོ་བོ་རྗེ་དཔལ་ལྡན་ཨ་ཏི་ཤ་བོད་དུ་གདན་འདྲེན་དགོས་པའི་རྒྱུ་རྐྱེན་ཡང་སྙིང་གང་ཡིན་པར་དཔྱད་ཞིབ་ཅུང་ཙམ་བྱས་ཡོད།",
        "དེ་ལྟརམིན་ན་དགུན་ཤིང་ ྡོང་པོས་རེ་བའི་ང་ྒུག་སུ་ལ་བྱེད།།",
        "ཏཱ་ལའི་བླ་མའི་བཀའ་དྲིན་འོག་ནས་ཐ་མར་ང་ཅག་འཕགས་ཡུལ་སླེབས།།",
        "ཅི་ཞིག་དྲིས་པས་གསལ་བཤདལན་དུ་བྲིས་པའི་དགོངརྣ་ཤོག་མདུན་དུ་བསྟར།།",
        "མི་ཚེ་འཕེན་པ་བསྐྱེལ་རྒྱུའི་དམ་བཅའ་དེ་མ་རྗེད།།",
        "བཞི་པ། སྒྲུང་གི་གྲུབ་ཆ་གཙོ་བོ་ནི་སྐད་ཆ་ཡིན། དེར་བརྟེན་སྐད་ཆའི་རིམ་རྒྱུན་ལ་རྩོམ་པ་པོའི་ཞེ་འདོད་ཀྱི་དམིགས་ཡུལ་གང་ཞིག་ཡོད་པ་དེ་མ་བརླགས་པའི་ཐོག་ནས་ཀློག་པ་པོའི་བསམ་བློར་དགའ་སྐྱོ་ཁྲོ་ཆགས་ཀྱི་རྣམ་པར་བསྒྱུར་ཐུབ་པའི་སྒྱུ་རྩལ་གྱི་ཉམས་ཐོན་ཐབས་བྱེད་དགོས།",
        "བརྟུན་པར་བསྐྱེད་དེ་གདན་སའི་ཆོས་གྲྭར་འགྲིམས།།",
        "མདོ་སྟོད་ནང་ཆེན་ཀ་གཞུང་སྒལ་ཁའི་དབྱར་ས། སྡོམ་ཕུ་རུ་ཡོད་པའི་རི་གྲགས་ཅན་ཞིག མིང་གི་རྣམ་གྲངས་ལ། དུང་རི། ཤ་ཕོ་དུང་རྭ་སོགས་ཟེར། མཚོ་ངོས་ཀྱི་མཐོ་ཚད༥༥༤༧ཡོད། རི་རྩེ་བྲག་རི་དང་། རི་རྐེད་རྫ། རི་སྨད་སྤང་ལྗོངས་ཀྱིས་རྒྱན་པ་ཞིག་ཡིན། འདི་བསེ་ལྕགས་དུང་གསུམ་དང་། ཡང་ན་སྤུ་གྲི་མཆེད་གསུམ་གྱི་གྲས་ཡིན།",
        "ཚིག་གི་རྒྱན་ནི། རྒྱས་སྲས་སྤྲིན་གྱི་བཞོན་པ་རྒྱལ་སྲིད་དོར་ནས་འགྲོ་རྩིས་གནང་བ་དེ་གཏན་དུ་ཕན་ཚུན་འགྲོ་འོང་བྱེད་མཁན་གྱི་རླུང་བུའི་དཔེར་བྱས་པ་དང་། ཐོབ་དཀའ་ཞིང་དོར་མི་སླ་བའི་རྒྱལ་སྲིད་དབང་ཐང་དཔལ་འབྱོར་ལོངས་སྤྱོད་དང་བཅས་པ་ཕ་མའི་སྲི་ཞུའི་ཆེད་དུ་བློས་གཏོང་ནུས་པའི་བསམ་བློའི་ཁོག་རྒྱ་གཞན་ལས་ཆེ་བ་མཚོན་པས། དཔེ་དང་འདྲེས་པའི་བསམ་པ་རྒྱ་ཆེ་བའི་རྒྱན་ཡིན།སྙན་ངག་མེ་ལོང་ལས།རཱ་ཝ་ཎ་ཡི་མགོ་གཅོད་པའི། །བྱ་བའི་ཁུར་ཡང་བཟོད་པ་གང། །རཱ་གྷུའི་བུ་དེས་བླ་མ་ཡི། །བཀའ་ལས་འདའ་བར་ནུས་མ་གྱུར། ། ཞེས་འབྱུང་བ་དང་ཁོག་འདྲ།",
        "གཞན་ཡང་ཁོང་ཉིད་ཀྱི་ཞལ་ནས། བདག་ཐོས་པ་ཆུང་བ་ཡང་མ་ཡིན་ཏེ། ཆོས་ཐམས་ཅད་ལ་མ་ཐོས་པ་མེད་དོ། ། ཐོས་པ་ཆེ་བ་ཡང་མ་ཡིན་ཏེ། ཆོས་ཕལ་ཆེ་བ་ཚར་རེ་ལས་མ་ཐོས། ཞེས་གསུངས།",
        "རྟག་སྦྱོར་གུས་སྦྱོར་གྱིས་ཞོན་ཚུལ་མཁས་པས། །",
        "༤.༣ རྨ་ལོ་ཙཱ་བ་དང་ཞ་མ་ལྕམ་སྲིང་གིས་བསྟན་པ་ཇི་ལྟར་བསྐྱངས་པའི་སྐབས།",
        "འགྲོ་བསོད་རྒྱལ་མཚན་རྩེ་མོར་ལེགས་བཀོད་རྒྱུས། །",
        "བདག་ཚོགས་མ་བསགས་པས་ཟབ་མོའི་དོན་རྟོགས་པའི་སྐལ་པ་མེད་པས་ན།",
        "མི་མཐུན་ཕྱོགས་སྤོང་བའི་མཐུ་ཇི་ལྟ་བུ་ཡིན་ཞེ་ན་སྦྱིན་པས་སེར་སྣ་སེལ་ནུས་པར་མཐོང་བ་སོགས་ཕར་ཕྱིན་གཞན་རང་རང་གི་མི་མཐུན་ཕྱོགས་འཆལ་ཚུལ་ཁོང་ཁྲོ་ལེ་ལོ་རྣམ་གཡེང་ཤེས་འཆལ་སྤང་ནུས་པའོ། །",
        "མདོར་ན་བྱང་ཆུབ་སེམས་དཔས་རང་གཞན་དོན་གཉིས་བསྒྲུབ་པའི་ཕྱིར། ཐོག་མར་རང་ཉིད་ཀྱིས་རིག་པའི་གནས་ལྔའི་བསྟན་བཅོས་སམ་གཙུག་ལག་གི་གཞུང་ཉིད།",
        "འགྱུར་བྱང་ནི། རྒྱ་གར་གྱི་མཁན་པོ་ཤཱཀྱ་སིཾ་ཧ་སྟེ་ཤཱཀྱ་སེང་གེ་ཞེས་པ་དང་། ཞུ་ཆེན་གྱི་ལོ་ཙཱ་བ་བནྡེ་སྐ་བ་དཔལ་བརྩེགས་ལ་སོགས་པས་བསྒྱུར་ཞིང་ཞུས་ཏེ་གཏན་ལ་ཕབ་པ། སླད་ཀྱི་པཎྜི་ཏ་བ་ར་ཧི་ཏ་དང་། བྲམ་ཟེ་ཆེན་པོ་སད་ཛ་ན་དང་། ལོ་ཙཱ་བ་རྔོག་བློ་ལྡན་ཤེས་རབ་ཀྱིས་ཅུང་ཟད་བཅོས་ལེགས་པར་བཤད་ནས་གཏན་ལ་ཕབ་པའོ། །ཞེས་སོ། །",
        "དེ་འདོད་དེ་དབུ་མའི་ལམ་གྱི་སྟོང་ཉིད་རྟོགས་པ་དང་མ་འབྲེལ་ན་རྡོ་རྗེ་ཐེག་པའི་ལམ་གྱིས་ཐར་དང་རྣམ་མཁྱེན་མི་འགྲུབ་ཅེ་ན། རྣམ་གྲངས་མིན་པའི་ཆོས་ཉིད་དབྱིངས་སྣང་སྟོང་ཟུང་འཇུག་རྣམ་ཀུན་མཆོག་ལྡན་གྱི་སྟོང་ཉིད་ཆོས་ཐམས་ཅད་ལ་ཡེ་ནས་ཆོས་ཉིད་དུ་གནས་པ་དེ་ཡིན་ནམ། རྣམ་གྲངས་པའི་མེད་དགག་ཙམ་ཡིན། རྣམ་མིན་ནི་འཕགས་པ་མ་གཏོགས་མི་ཤེས་པར་ཁས་བླང་བས་སོ་སྐྱེས་ཇི་ལྟར་འདྲེན། རྣམ་གྲངས་པ་ནི་སྟོང་ཉིད་མཚན་ཉིད་པ་མིན་ཏེ་ཡིད་རྟོག་བཅས་ཁོ་ནའི་སྤྱོད་ཡུལ་ཡིན་ན།",
        "བདེན་གཉིས་དཔྱོད་པའི་ཚད་མས་གྲུབ་ཚུལ་བདེ་བླག་ཏུ་ཤེས་ནུས་སོ། །དོན་དམ་དཔྱོད་པ་ལ་མ་ལྟོས་པར་ཐ་སྙད་དཔྱོད་བྱེད་ཀྱི་ཚད་མས་རྟོགས་པས་ཕར་བཏགས་ཙམ་ལས་དོན་རང་གི་ངོ་བོ་མེད་པར་འགྲུབ་མི་ནུས་སོ། །མངྒ་ལཾ། །",
        "དེ་ལ་མཐའ་གཉིས་སེལ་ཚུལ་ནི། རྒྱུ་འབྲས་བུར་འཕོ་བ་མེད་ཅིང་སྐྱེ་བ་མེད་པས་རྟག་པའི་མཐའ་དང་བྲལ། རྒྱུ་སྔོན་དུ་སོང་བ་ལ་བརྟེན་ནས། འབྲས་བུ་འགགས་པ་མེད་པས་ཆད་པའི་མཐའ་དང་བྲལ་བ་སྟེ་དེ་ཐམས་ཅད་སྟོང་པ་དང་སྟོང་པ་རྟེན་འབྱུང་དང་སྟོང་དང་རྟེན་འབྱུང་དབྱེ་བསལ་མེད་པར་བསྒྲུབ་དགོས་སོ། །",
        "བཞི་པ་སོར་བཤགས་ལ་གཉིས། བསྟན་པ། བཤགས་པའོ། །དང་པོ། སོ་སོར་བཤགས་བྱའི་སྡེ་བཞི་ནི། །ཞེས་འདིའི་ལྟུང་བ་བྱུང་ན་ལྟུང་བའི་མིང་ནས་སྨོས་ཏེ་སྨྲེ་སྔགས་འདོན་པའི་ཚུལ་དུསོ་སོར་བཤགས་དགོས་པས་དེ་སྐད་དུ་བྱ་ཞིང་། དེའི་སྡེ་ཚན་དབྱེ་ན་བཞི་ཡོད་པ་ནི། ཞེས་སོ། །གཉིས་པ་ནི། ལམ་དྲུང་སོགས་ཚིགས་བཅད་གཅིག་དང་རྐང་པ་གསུམ་སྟེ། གྲོང་ངམ་གྲོང་གི་ཉེ་འཁོར་རམ་ལམ་པོ་ཆེའི་དྲུང་དུ་ཉེ་མིན་དགེ་སློང་མ་ལས་དགེ་སློང་མ་རང་ཉིད་ཀྱི་བཟའ་བྱའི་དོན་དུ་བསྒྲུབས་པའི་ཟས་བསླངས་ནས་ཟོས་པ་དང། སྦྱིན་བདག་གི་ཁྱིམ་དུ་དགེ་སློང་མས་ཟས་བྲིམ་པ་ན་གྲལ་གོང་ནས་རིམ་པས་མ་བྲིམ་པར་བསྣོལ་ཏེ་ཐད་ཀར་འདི་ལ་དྲོང་ཞེས་འགྲིམ་བཅུག་པ་གྲལ་གོང་མ་ལ་བྲིམས་ཤིག་ཅེས་པ་ལྟ་བུའི་ཚིག་གིས་མ་བཟློག་པར་བླངས་ཏེ་ཟོས་པ་དང་། ཁྱིམ་བདག་ནོར་རྒུད་པ་ལ་དགེ་འདུན་གྱི་ལས་ཀྱིས་ཁྱིམ་གྱི་བསླབ་སྡོམ་བྱིན་པ་ལ། རུང་བ་ཉུངས་མ་ཙམ་ལས་དགེ་སློང་གིས་དེ་ལས་གཞན་བཟའ་བཏུང་བླངས་མི་འོས་པ་ལས་བཟའ་བཅའ་བསླངས་ཏེ་ཟོས་པ་དང་། དགོན་པའི་གནས་དགྲ་རྐུན་གཅན་གཟན་སོགས་ཀྱི་འཇིགས་པ་དང་བཅས་པའི་ནགས་སུ་དགེ་འདུན་གྱིས་ནགས་ཉུལ་བ་པོར་བསྐོས་པས་འཇིགས་པ་ཡོད་མེད་མ་བརྟགས་པར་དགོན་པར་ཁྱིམ་བདག་ལས་ཟས་བསླངས་ཏེ་ཟོས་ཤིང་བསྡད་པའོ། །འདིའི་ཆོམ་རྐུན་སོགས་འཇིགས་པ་ཡོད་མེད་དཔག་ཚད་ཕྱེད་ཚུན་ཉུལ་ཏེ་འཇིགས་དོགས་ཡོད་ན་བ་དན་སྔོན་པོ་དང་། མེད་ན་དཀར་པོ་བསྒྲེངས་བས་མཚོན་པར་བྱ་ཞིང་། འདི་ནགས་ཉུལ་པ་པོ་ཁོ་ནའི་ལྟུང་བར་ཡང་བཤད་དོ། །",
        "སྨྲྀ་ཏི་ཐོག་མར་བོད་དུ་ཕེབས་དུས་བོད་སྐད་མི་མཁྱེན་ཅིང་གཙང་རྟ་ནག་ཏུ་ཁྱིམ་ཚང་ཞིག་གི་ར་ལུག་འཚོ་བའི་རྫི་བོ་བྱས། དེར་བཞུགས་དུས་ངུ་བྲོ་བ་གསུམ་དང་དགོད་བྲོ་བ་གསུམ་བྱུང་བའི་ལོ་རྒྱུས་ཡོད། ཁོང་གིས་ཁྱིམ་དེའི་ཕྱི་སྒོའི་ཡ་ཐེམ་ལ།",
        "སི་ཏུས། འགྲེལ་བྱེད་སྔ་མ་ཁ་ཅིག་ཨ་ཡིག་རྟགས་མེད་དུ་འདོད་པ་དེ་བཀག་པ་ནི་ད་དུང་ཞིབ་འཇུག་བྱེད་དགོས་པའི་གནས་སུ་སྣང་སྟེ། རྒྱུ་མཚན་ནི། ལོ་ཆེན་བྱང་ཆུབ་རྩེ་མོའི་བུ་ཆེན་ལོ་ཙཱ་བ་ནམ་མཁའ་བཟང་པོའི་སུམ་རྟགས་འགྲེལ་བ་བསྟན་པའི་སྒྲོན་མེར། ཨ་ཡིག་རྟགས་མེད་པའོ། །ཞེས་དང་། ཞྭ་ལུ་ལོ་ཆེན་དགུང་ལོ་བགྲེས་པའི་སྐབས་སུ་མཛད་པའི་དག་ཡིག་ཟ་མ་ཏོག་ལས།",
        "[དཔེ་བཤུས] མ་ཕྱི་ལས་བུ་བཤུས་བྱས་པ་སྟེ་བྲིས་པ།",
        "ཐེག་མཆོག་བསྟན་འཕེལ་དཀོན་རྒྱལ་མཚན་དཔལ། །ངག་དབང་གྲགས་པ་བསོད་ནམས་རྒྱལ་མཚན་དང་། །འགྱུར་མེད་ཡེ་ཤེས་རྣམས་ལ་གསོལ་བ་འདེབས། །བསྟན་སྙིང་དུང་དཀར་བཀའ་བརྒྱུད་བཀྲ་ཤིས་མཚན། །བསམ་གཏན་རྒྱ་མཚོ་གཏེར་སྲས་གསང་སྔགས་དང་། །ཕུར་བུ་རབ་འབྱོར་སྒྲུབ་སྤྲུལ་མངོན་སྤྲུལ་པ། །ཀརྨ་བཟོད་པ་རྣམས་ལ་གསོལ་བ་འདེབས། །ཕྲིན་ལས་དབང་ཕྱུག་བསྟན་འཛིན་ཆོད་དར་དང་། །མི་ནུབ་རྒྱལ་མཚན་ཀརྨ་ཆོས་འཕེལ་ཞབས། །ཚེ་དབང་ཀུན་ཁྱབ་ཨོ་རྒྱན་རྣམ་མཁྱེན་དང་། །མི་འགྱུར་མཁའ་ཀློང་ཡང་པར་གསོལ་བ་འདེབས། །རྡོ་རྗེ་འཆང་དངོས་ཁྱུང་པོ་པད་འཕྲིན་རྗེ། །མན་ངག་དོན་སྟོན་འཆི་མེད་རྡོ་རྗེའི་ཞབས། །དྲིན་ཆེན་བླ་མ་འཇམ་མགོན་བློ་རབ་མཆོག །བཀའ་དྲིན་སུམ་ལྡན་གསུམ་ལ་གསོལ་བ་འདེབས། །ཁྱད་པར་འབའ་རོམ་སྙིང་པོའི་བསྟན་སྲོག་འཛིན། །སྦས་པའི་རྣལ་འབྱོར་ཨིན་དྲའི་མཚན་འཛིན་པའི། །དྲན་པས་གདུང་སེལ་རྩ་བའི་བླ་མ་ལ། །རྩེ་གཅིག་གདུང་ཤུགས་དྲག་པོའི་གསོལ་བ་འདེབས། །ཞལ་མཇལ་གསུང་ཐོས་དབང་དང་གདམས་པ་བསྩལ། །བསྟན་པ་ཡོངས་རྫོགས་དོན་རྒྱུད་མན་ངག་གཏད། །རྣམ་མང་སློབ་དཔོན་རྗེས་དྲན་གསོལ་བཏབ་མཐུས། །བདག་ཅན་སྐལ་ངན་འཇིགས་ལས་སྐྱོབ་པར་མཛོད། །མདོར་ན་སྐྱེ་དང་ཚེ་རབ་ཐམས་ཅད་དུ། །རྗེ་བཙུན་བླ་མ་རྣམས་དང་མི་འབྲལ་ཞིང་། །ནང་གི་ལམ་ནས་རྡོ་རྗེའི་ལམ་བགྲོད་ཏེ། །ཐུགས་ཡིད་ཅིག་འདྲེས་མངོན་སངས་རྒྱས་གྱུར་ཅིག །ཅེས་གསུངས་པས་མཚོན་མཚན་ལྡན་དགེ་བའི་བཤེས་གཉེན་རྣམས་ལས། ཐུན་མོང་ཐུན་མིན་གྱི་གདམས་པ་གསན་བསམ་མཐའ་ཡས་པ་མཛད།",
        "༡ འཇིག་རྟེན་བྱེད་པོ་ནི་ཡེ་ཧུ་ཧྭ་གཅིག་པུ་ཁོ་ན་སྟེ་དེ་ལས་གཞན་དུ་འཇིག་རྟེན་བྱེད་པོ་ཞིག་མེད་པ།",
        "ཁྱད་མེད་ཐུགས་བརྩེ་མཉམ་པས་འཇིག་རྟེན་འདིའི། །",
        "དྲིན་ཅན་རྩ་བའི་བླ་མའི་སྐུར་བཞེངས་པ། །རྒྱལ་མཆོག་ཡབ་སྲས་གཉིས་ལ་ཕྱག་འཚལ་ལོ། །",
        "གཅེས་ཉར་སྲོག་ཆགས་དེ་ཉིད་ཕྱུགས་རིགས་དང་། རི་སྐྱེས་སྲོག་ཆགས། བདག་མེད་སྲོག་ཆགས་སོགས་དང་འབྲེལ་འདྲིས་བྱེད་དུ་འཇུག་རྒྱུ་མེད་པ་དང་། གཅེས་ཉར་སྲོག་ཆགས་གང་བྱུང་དུ་འཁྱམ་འཇུག་རྒྱུ་མེད་ལ་བྱི་བ་བཟུང་ནས་ཟ་རུའང་འཇུག་རྒྱུ་མེད་པ།",
        "བོད་མི་ཆགས་ཚུལ་ནི། ཐང་གིས་ནུབ་ཕྱོགས་སུ་རྒྱ་བསྐྱེད་པའི་སྐབས་རྨ་སྟོད་མགོ་ལོག་གི་ས་ཆ་སོགས་སུ་ཐང་དམག་གིས་མ་བཟུང་བར། དེ་གར་གཉུག་མར་གནས་པའི་བོད་ཀྱི་མི་སྡེ་ཡོད་པ་ནི། རྨར་རོལ་གྱི་ས་ཆའི་སྟོད་དུ་སྦྲ་རིགས་ཀྱི་དཔོན་གཉན་རྩེ་ཟེར་བ་ཡོད་ལ། བར་དུ་སྦྲ་རིགས་ཀྱི་དཔོན་མཁར་རེ་ཟེར་བ་ཡོད། སྨད་དུ་སྦྲ་རིགས་ཀྱི་དཔོན་བ་ལི་ཟེར་བ་འབངས་བཅས་ཡོད།",
        "མངར་ལྡན་རོ་བརྒྱ་འཛགས་པའི་ཤིང་ཏོག་གི་རིགས་དང༌། ། སྨིན་ལེགས་ཞིང་སར་རྒྱས་པའི་འབྲུ་དྲུག་གི་ལང་ཚོ། ། ཟད་མེད་ཟས་སྣ་བརྒྱ་ཡི་ལོངས་སྤྱོད་དེ་འབོལ་བ། ། རྨོ་འདེབས་ཞིང་ལས་བྲེལ་བའི་རོང་ཕྱོགས་དེ་དྲན་བྱུང༌། །",
        "བྱང་ཆུབ་སེམས་དཔའ་ལ་དད་པ་དང་མོས་པ་བྱེད་པའི་བསོད་ནམས་ནི་བསམ་གྱིས་མི་ཁྱབ་པ་ཞིག་ཡིན་ཏེ། \"ཐེག་པ་ཆེན་པོ་ལ་མོས་པའི་བྱང་ཆུབ་སེམས་དཔའ་ལ་སེམས་དང་བས་ལྟ་ན་འདི་ནི་དེ་བས་ཆེས་བསོད་ནམས་ལྷག་པར་སྐྱེའོ། །\" ཞེས་པས་ཕྱོགས་བཅུའི་འཇིག་རྟེན་གྱི་སེམས་ཅན་ཐམས་ཅད་ཀྱི་མིག་བཏོན་ནས་མིག་གསར་པ་སྐྱེད་པའི་བསོད་ནམས་ལས་ཀྱང་བྱང་ཆུབ་སེམས་དཔའ་ལ་སེམས་དང་བའི་བསོད་ནམས་ཆེས་ལྷག་པ་ཡིན་པ་གསལ་པོར་འགྲེལ་བཤད་བྱས་ཡོད།",
        "བོད་ཟླ་ལྔ་པའི་ཚེས་བཅུ་ནས་བཟུང་ཉེར་དགུའི་བར་ཉིན་ཉི་ཤུའི་རིང་སྨན་སྟོད་ལྕམ་སྦ་ཡེར་ཚང་ཚེ་རིང་སྒྲོལ་དཀར་གྱིས་ཞུས་དོན་བཞིན་རྗེ་དེ་ཉིད་ཀྱི་དྲུང་ནས་བཞི་སྡེ་འདུ་ཁང་དུ་བླ་སྤྲུལ་དགེ་བཤེས་གྲྭ་དཀྱུས་མི་སྐྱ་ཐེ་བའི་ཆོས་ཞུ་བ་སྟཽང་ཕྲག་མ་ཟིན་ཙམ་དང་ལྷན་ཅིག་བདེ་མཆོག་དྲིལ་བུའི་ལུགས་ཕྱི་དཀྱིལ་ལྷ་ལྔའི་དབང་ཆེན་དང་ལུས་དཀྱིལ་གྱི་དབང་ཆེན། དྲིལ་བུ་ལུས་དཀྱིལ་རིམ་གཉིས་ཀྱི་འཁྲིད། ན་རོ་ཆོས་དྲུག་གི་མྱོང་འཁྲིད་བཅས་ཞུས། ལྕགས་སྟག་༡༩༥༠དབྱར་ཆོས་ཆེན་པོའི་ནང་སེར་བྱེས་མཁན་སྙན་གྲྭ་ཚང་གི་མཁན་རབས་རེ་གསུམ་པ་དགེ་བའི་བཤེས་གཉེན་ཆེན་པོ་ཏྲེ་ཧྲོར་ཐུབ་བསྟན་བསམ་གཏན་གྱིས་ཇི་ལྟར་གསོལ་བ་བཏབ་པ་བཞིན། སེར་བྱེས་མཁན་སྙན་གྲྭ་ཚང་གི་འདུ་ཁང་དུ། གྲྭ་ཚང་བྱེས་སྨད་སྔགས་གསུམ་མཁན་ལས་ཟུར་དང་བླ་སྤྲུལ་དགེ་བཤེས་དགེ་འདུན་འདུས་དམངས། གཞན་ཡང་ལྷ་ས་དང་འབྲས་སྤུངས་བཅས་ཀྱི་གྲྭ་བླ་བསྡོམས་པའི་ལྔ་སྟོང་ལྷན་གཅིག་ཏུ་ྋསྐྱབས་རྗེ་ཁྲི་བྱང་རིན་པོ་ཆེའི་དྲུང་ནས། ལམ་རིམ་བདེ་ལམ་དང་མྱུར་ལམ། འཇམ་དཔལ་ཞལ་ལུང་གསུམ་སྦྲགས་ཀྱི་སྟེང་ནས་ལམ་རིམ་གྱི་ཉམས་ཁྲིད་དང༌། བློ་སྦྱོངས་དོན་བདུན་མའི་ཁྲྀད། ཐུན་དྲུག་བླ་མའི་རྣལ་འབྱོར་གྱི་བཀའ་ཁྲིད་བཅས་ཞུས། སྐྱབས་མགོན་རྒྱལ་བའི་དབང་པོ་མཆོག་གི་ཞལ་གྱི་བུམ་བཟང་ནས།",
        "ཟླ3པའི་ཚེས15ཉིན་ནས་ཚེས21ཉིན་བར་བླ་མ་འདས་མཆོད།",
        "ཨོ་རྒྱན་འོད་གསལ་མདོ་སྔགས་བཤད་སྒྲུབ་དར་རྒྱས་གླིང་།",
        "དོན་དུ་བསྟན་ཏོ། །ཡང་གཞན་ལས་ཆོས་ཀྱི་སྐུ་ནི། བྱང་ཆུབ་ཀྱི་ཕྱོགས་ཀྱི་ཆོས་རྣམས་ཡོངས་སུ་བསགས་པའི་ལུས་ནི་གཉིས་སུ་མེད་པའི་ཡེ་ཤེས་ཏེ། དེ་ནི་ཆོས་ཀྱི་སྐུ་ཡིན་ལ། དེའི་གཟུགས་བརྙན་དང་ཕྱག་རྒྱར་གྱུར་པ་ནི་མཆོད་རྟེན་ནོ་ཞེས་སོ། །དོན་དེ་དག་གིས་དཀོན་མཆོག་མཆོད་ཅིང་བཀུར་བའི་སྒོ་ནས་བསོད་ནམས་ཀྱི་ཚོགས་ཀྱི་གཞིར་བསྟན་ཏོ། །གཟུགས་བརྙན་དེ་ཡང་འགྲོ་བའི་དོན་དུ་ཉེ་བར་གནས་པའི་ཕྱིར་ཡིན་གྱི། གཞན་གྱི་ཕྱིར་མ་ཡིན་པའི་སྒོ་ནས་ཀྱང་བསོད་ནམས་ཀྱི་ཚོགས་སུ་གྱུར་པ་ཡིན་ནོ། །ད་ནི་ཡོན་ཏན་གྱི་བྱ་བ་རྣམས་ཇི་ལྟར་བསྒྲུབ་པའི་ཐབས་གོང་དུ་སྨོས་པ་རྣམས་གསལ་བར་བརྗོད་པར་བྱ་སྟེ། དེ་ལ་ལས་གྲུབ་པར་བྱ་བ་ལ་ཞི་བའི་ལས་གྲུབ་པར་འདོད་པ་རྣམས་ཀྱིས། བདག་ཉིད་བཅོམ་ལྡན་འདས་རྣམ་པར་སྣང་མཛད་ཀྱི་ཏིང་ངེ་འཛིན་དུ་ཞུགས་ཏེ། བྱང་ཆུབ་མཆོག་གི་ཕྱག་རྒྱ་དང་ལྡན་པས། དེ་ཉིད་ཀྱི་གསང་སྔགས་གང་ཡང་རུང་བ་བརྗོད་ཅིང་མཆོད་རྟེན་གདབ་པར་བྱ་སྟེ། དེའི་ཚེ་ཏིང་ངེ་འཛིན་གྱིས་བདག་དང་མཆོད་རྟེན་དཀར་པོ་འོད་འབར་བ་ལས། འོད་ཟེར་དཀར་པོ་ཡི་གེ་ཨོཾ་གྱི་རང་བཞིན་ནམ། འཁོར་ལོ་འམ། སྐུ་ཕྲ་མོ་",
        "ཡུལ་དགས་2ཀྱི་གྲུ་བཞི་ན། རྗེ་དགས་རྒྱལ་གྱྀ་སྤྲོག་ཟིན། བློན་པོ་ཕོ་གུ་དང་པོག་རོལ་གཉིས། །",
        "ཆོས་མངོན་པ་ཀུན་ལས་བཏུས་པའི་བཤད་པ་བམ་པོ་བཅུ་པ་སློབ་དཔོན་ཆནེ་པོ་རྒྱལ་བའི་སྲས་ཀིས་མཛད་པ།རྒྱ་གར་གི་ མཁན་པོ་ཛི་ན་མི་ཏྲ་ི དང་། ཤི་ལེན་ྡྲ བོ་དི་དང་། ཞུ་ཆེན་གི་ལ་ོ ཙཱ་བ་ཡེ་ཤེས་སའེ ི་འགྱུར། ཆོས་མངོན་པ་ཀུན་ལས་བཏུས་པའི་རྣམ་པར་ བཤད་པ་སློབ་དཔོན་རྒྱལ་བའི་སྲས་ཀིས་མཛད་པ།རྒྱ་གར་གི་མཁན་པོ་ཛ་ིན་མི་ཏྲ་དང་།ཞུ་ཆེན་གི་ལོ་ཙཱ་བ་ཡ་ེཤསེ་སེའི་འགྱུར།ར་ འགེལ་འདི་གཉིས་ལོ་པཎ་ཆེས་ཆེར་མཁས་པ་རྣམས་ཀིས་ལེགས་པར་བསྒྱུར་ཡོད་ཀི། འོན་ཀང་རྒྱ་གར་གི་དཔ་ེ ལ་འགེལ་པའི་ནང་ན་ ར་བའི་ཚིག་ཡོངས་སུ་རྫོགས་པར་ཡདོ ་པ་དང་། སྐབས་ལ་ལར་འགེལ་པ་ཆད་པ་དང་། དེ་ལར་དིས་ལན་དང་མཚམས་སོར་གི་ཚིག་",
        "ཟོག་དང་ཚུལ་འཆོས་ཀིས་རང་གཞན་སེམས་ཅད་ཐམས་ཅད་བས་བར་བྱེད་པ་སོགས་དེང་དུས་བདག་ཅག་རྣམས་ལ་ སྤྱོད་ངན་ཇི་ལྟར་ཡོད་པ་ཐམས་ཅད་ཆསེ ་གསལ་བར་ལུང་བསྟན་དང་ཞལ་ཏ་མང་དུ་གནང་ནས་སར་ཡང་ཐུགས་རེ་ཆེན་པོའི་ ཐུགས་ཀར་ཐིམ་མོ། །",
        "མཁོའི་རིགས་ཐམས་ཅད་དང་། ལམ་བྲག་སྐལ་བཟང་རྣམ་རྒྱལ་གིས་མཛད་པའི་ལམ་རིམ་ཚིགས་བཅད་མ་དང་། ཐུགས་རེ་ཆེན་པོ་ དཔལ་མོ་ལུགས་ཀི་བདག་འཇུག་དང་། གནས་བཅུ་ཕག་མཆོད་སྙུང་གནས་སོགས་ཚུགས་སྒོ་རྒྱུན་འཛུགས་ཡང་གལ་ཆེ་བ་འགའ་ རེ་ལས་ཧ་ཅང་འཚོགས་སྒོ་མང་པོ་ཐུགས་ལ ་མི་བབས་ཤིང་། རྒྱུན་དུ་དགེ་རྒན་མ་བསྟེན་ནས་དགེ་ཚུལ་གི་བསབ་བྱ། ལམ་རིམ་བོ་ སྦྱོང་སོགས་ལ་ཐོས་བསམ་དང་ནང་དུ་ཡང་དག་འཇོག་ལ་བརྩོན་པ་ཟུང་འབྲེལ་བྱེད་དུ་བཅུག་པས།དའེི་དུས་སུ་དགེ་ཚུལ་མ་བྱང་ ཆུབ་ལམ་རིམ་བོ་སྦྱོང་སོགས་ཧ་ཅང་མཁས་པ་དང་ཉམས་ལེན་གི་གདིངས་ཐོབ་པ་དུ་མ་བྱུང་འདུག་གོ།ཡང་དའེི་དུས་སུ་སྐར་ འཛིན་དགོན་པའི་གྲྭ་པ་ཅི་ཡང་མི་ཤསེ་པ་དུ་མ་འདུས་ནས་བ་མ་བྱམས་པ་རབ་བརྟན་འདི་མི་བྱེད་དགུ་བྱེད་བུད་མེད་ཀི་དགོན་ གཞི་བཏབ། འདི་སྤྱིར་སངས་རྒྱས་ཀི་བསྟན་པ་ལ་གནོད་པ་དང་།",
        "དག་བཞིས་འཕིན་ལས་བཞི་འགྲུབ་པ་དང་།ཕག་རེ་རེ་ལ་དམིགས་པའི་ཕན་ཡོན་མི་འད་བ་རེ་ར་ེསོགས་མཐའ་ཡས་པ་གསུངས་ ས།ོ །ད་ེདག་ནི་རྒྱུད་གཟུངས་དག་གི་དཀྱུས་སུ་བསྟན་པའི་སྨྱུང་གནས་དང་གཟུངས་སྔགས་ཆོ་གའི་ཕན་ཡོན་མདོར་བསྡུས་ཏེ།བ་ མ་གོང་མའི་མན་ངག་གི་ཕག་བཞསེ་སྒྲུབ་མཆོད་ལུགས་ལ་ནི།དའེི་སྟངེ་དུ་ཕན་ཡོན་ལྷག་པོ་དུ་མ་འབྱུང་སྟེ།ཡན་ལག་བདུན་པོ་རེ་ རེའི་ཕན་ཡོན་ཀང་བརོད་ཀིས་མི་ལངས་པའི་ཕིར་རོ། །",
        "དཀོན་མཆོག་རིན་ཆནེ ་གསུམ་ལ་ཕག་འཚལ་ལོ།།ན་མཿཨཪྱ་ཛ་ནྙཱ་སཱ་ག་ད།ཕག་འཚལ་ལོ་འཕགས་པ་ཡེ་ཤེས་རྒྱ་མཚོ་ལ། བཻ་རོ་ཙ་ན། ལས་ཅན་རྣམ་པར་སྣང་མཛད།",
        "ཉེར་གཅིག་ནས་བརྒྱ་བར་གྱི་གྲངས་ལ་སྔོན་འཇུག་དང་མགོ་ཅན་ནམ་ཡང་མི་འཇུག་པ། དཔེར་ན། ཉེར་གཅིག ཉེར་གཉིས། ཉེར་གསུམ། ཉེར་བཞི་ལྟ་བུ་དང༌། སོ་གཅིག་ནས་སོ་དགུ་བར་དང༌། ཞེ་གཅིག་ནས་ཞེ་དགུ་བར་དང༌། ང་གཅིག་ནས་ང་དགུ་བར། རེ་གཅིག་ནས་རེ་དགུ་བར། དོན་གཅིག་ནས་དོན་དགུ་བར། གྱ་གཅིག་ནས་གྱ་དགུ་བར་ལྟ་བུའོ།།",
        "༥ བླ་མ་དང་ཞལ་མཇལ་བའི་མཛད་པ་སྟེ། མཆོག་གི་མཛད་པ་དང་པོ།",
        "རྒྱ་དམར་གྱིས་བཙན་འཛུལ་སྐབས་གསེར་རྟའི་ཆེས་ཛ་དྲག་གི་གནས་སྟངས་དང༌། མདོ་དབུས་ཁམས་གསུམ་གྱི་གནད་ཡོད་མི་སྣས་གསེར་རྟ་མགོ་ལོག་ཡིན་པའི་ལྟ་ཚུལ།",
        "བོད་ཀྱི་གཙུག་ལག་རིག་པའི་ཟབ་སྦྱོང་ཚོགས་ཆེན་ཐོག་ཕུལ་བའི་གཏམ་བཤད།",
        "སྒོམ་ནས་རྒྱུད་ལ་སྦྱར་བའི་ཉམས་ལེན་ཙམ་མེད་པར།།",
        "རྩོམ་ན་ལུས་རྒྱན་སྲོག་གི་གོམ་འགྲོས་བརྟན།།",
        "སྙིང་སྟོབས་སྤོབས་པའི་རླབས་ཆེན་སྤྱོད་པ་གཞན་དྲིངས་མེད་པའི་དཔུང་ཤུཊ་ཀྱིས།།",
        "༢༠༠༢་ ཟླ་བ་ ༦ ཚེས་ ༨ ཉིན་བེ་སྨྱོན་དང་ཀླུ་སྨྱོན་གཉིས་ཀྱིས་ལྡི་ལི་མན་ཇུག་ཏྲི་ལ་ཏྲི་ཏྲི་ཟ་ཁང་ནང་དུ་བྲིས།༢༠༠༥ལོར་《གཉན་ཆེན་ཐང་ལྷ་》ཐོག་བཀོད།",
        "ཁྲི་ཕུན་ཚོགས་ལྡེ་ ཁོང་ནི་རབ་བྱུང་དྲུག་པའི་ས་ཕོ་སྟག་ལོ་སྟེ་སྤྱི་ལོ 1338 ལོར་གུང་ཐང་ཁབ་གོང་དུ་ཡབ་ཁྲི་བཀྲ་ཤིས་ལྡེ་དང་། ཡུམ་བསོད་ནམས་འབུམ་གཉིས་ཀྱི་སྲས་སུ་སྐུ་འཁྲུངས། རབ་བྱུང་དྲུག་པའི་ལྕགས་ཕོ་ཁྱི་ལོ་སྟེ་སྤྱི་ལོ 1370 ལོར་སྐུ་གཤེགས། ཁོང་གིས་ཐོག་མར་དགེ་བའི་བཤེས་གཉེན་རྣམས་ལ་བསྟེན་ནས་དཔེ་ཡིག་ལུང་གསུམ་ལ་སྦྱངས་པ་མཛད། དེ་ནས་ཡབ་ཀྱི་དགོངས་རྫོགས་སུ་དེ་བཞིན་གཤེགས་པའི་སྐུ་བརྙན་མི་ཚད་བསྐྲུན་པ་སོགས་རྣམ་དཀར་དགེ་བའི་མཛད་འཕྲིན་གྱིས་མང་ཡུལ་གུང་ཐང་གི་ཆབ་སྲིད་བསྐྱངས། ས་སྐྱ་པ་དང་སྐུ་གཉེན་ཡིན་སྟབས་སྲིད་འཕེལ་འདུན་མ་གཅིག་པའི་བཅའ་ཡིག་མནའ་བསྒྲིགས་ཀྱང་མཛད། བྱང་པ་ཏཱ་དབེན་གྱི་སྲས་མོ་ནམ་མཁའ་འབུམ་ཁབ་ཏུ་བཞེས་ཏེ་རིགས་སྲས་ཁྲི་རྒྱལ་བསོད་ནམས་ལྡེ་སྐུ་འཁྲུངས། འགུང་ལོ་སུམ་ཅུ་སོ་གསུམ་པར་བཙུན་མོ་དངོས་ཀྱི་གྱོད་པོ་ཏཱ་དབེན་གྱིས་ལོག་པའི་བསམ་པས་ངན་བསྐུལ་བྱས་ཏེ་ཞང་རྟ་ཚག་པ་སྨོན་ལམ་རྒྱལ་མཚན་གྱིས་བཀྲོངས་སོ། ཁོང་ནི་མང་ཡུལ་གུང་ཐང་གི་རྒྱལ་རབས་བཅུ་བཞི་པ་ཡིན་ནོ།།",
        "ནུབ་ཕྱོགས་པའི་སྤྱི་ཚོགས་ཁྲོད་དཀར་ཟས་བསྟེན་མཁན་དང་དམར་ཟས་སྤྱོད་མཁན་གྱི་དབར་ལ་ཁ་རྩོད་དང་། མཚང་འབྲུ། སྡང་ཟུག ཐ་ན་གྲིས་རྒྱག་རེས་བྱས་པའི་གནས་ཚུལ་ཡང་བྱུང་ཡོད།",
        "༣༽ ས་གནས་གང་དུ་སླེབས་ཀྱང་དེའི་གནམ་གཤིས་འགྱུར་འགྲོས་དང་། རི་ལུང་ཆགས་དབྱིབས། ཐ་ན་ཁང་པའི་ནང་གི་ནང་ཆས་སྒྲིགས་བཀོད་ཚུན་ཆད་རྒྱུན་ལྡན་ནས་དོ་སྣང་ནན་པོ་གནང་དགོས། དེས་རང་ཉིད་ཀྱིས་སྒྲུང་རྩོམ་གང་ཞིག་འབྲི་ནའང་། སྒྲུང་རྩོམ་དེ་དང་འབྲེལ་བའི་ཁོར་ཡུག་གམ་མཛེས་བཀོད་དམ་ཡང་ན་ཡུལ་ལྗོངས་བཀོད་སྒྲིག་གི་ཆ་ལག་ཐད་དཀའ་ཚེགས་མེད་པའི་སྒོ་ནས་འབྲི་ཐུབ།",
        "༼ རྗེའི་འགྲེལ ༽ མིང་པོ་བརྒྱད། ༡ གཅེན་པོ་ཤི་རབས་རླག་རུམ་རྗེ། ༢ དེ་འོག་བདུད་རབས་བཙན་རུམ་རྗེ། ༣ དེ་འོག་གདོན་རབས་བགེགས་རུམ་རྗེ། ༤ དེ་འོག་ཀླུ་རབས་གཉན་རུམ་རྗེ། ༥ དེ་འོག་གནོད་སྦྱིན་དྲུག་རུམ་རྗེ། ༦ དེ་འོག་ཟ་བྱེད་སྲིན་རུམ་རྗེ། ༧ དེ་འོག་ཁ་ལྡིང་དྲི་ཟ་རྗེ། ༨ དེ་འོག་ལྟོ་འཕྱེ་སྲིད་རུམ་རྗེ། སྲིང་མོ་བརྒྱད། ༡ གཅེན་མོ་ས་ཡི་ནག་མོ་མིག་དགུ་མ། ༢ དེ་འོག་མ་བླ་ཆུད་མོ་རེ་འབྱམས། ༣ དེ་འོག་མོ་གདོན་རྒྱལ་མོ་ཟོང་ཟང་། ༤ དེ་འོག་ཀླུ་ལྕམ་ཁོད་དེ་རིང་མོ། ༥ དེ་འོག་ས་གཞི་རིན་ཆེན་གཙུག་འབེབས་མ། ༦ དེ་འོག་ས་སྲིན་ནག་མོ་མགོ་དགུ་མ། ༧ དེ་འོག་འཇིགས་བྱེད་འགོག་མ་རླུང་མགོ་ཅན། ༨ སྲིད་ཟ་མོང་བུ་ཐུང་།",
        "ཟླ་༢ཚེས་༡༦ཉིན་ནི་སྤྱི་ལོའི་ལོ་གཅིག་གི་ནང་གི་ཉི་མ་༤༧པ་ཡིན། ལོ་མཇུག་ལ་ད་དུང་ཉིན་༣༡༨ཡོད།",
        "ཕྱི་ལོ་ ༢༠༡༧ ལོའི་ཟླ་ ༡༡ ཚེས་ ༡ ནས་ ༥ བར་བཞུགས་སྒར་དྷ་རམ་ས་ལའི་ཉེ་འཁྲིས་རྒྱུད་སྟོད་གྲྭ་ཚང་གི་དཔེ་མཛོད་ཁང་གིས་གོ་སྒྲིག་བྱས་ཏེ་ཉིན་ལྔའི་རིང་དཔེ་དེབ་ཞུ་སྒྲིག་དང་། གནའ་དེང་དཀར་ཆག་རིག་པའི་རྒྱལ་ཡོངས་ཟབ་སྦྱོང་ཞིག་འཚོགས་ཡོད། སྐབས་དེར་ཚོགས་སྡེ་དང་སློབ་གཉེར་ཁང་ ༣༦ ནས་ཕེབས་པའི་ཚོགས་བཅར་བ་ ༧༠ ལྷག་མཉམ་ཞུགས་གནང་ཡོད།",
        "རྒྱ་གར་ཕ་དམ་པས་ཞི་བྱེད་ཀྱི་གྲུབ་མཐའ་བོད་ཡུལ་དུ་དར་སྤེལ་མཛད་ཅིང་། དེའི་ཡ་གྱལ་གཅོད་ཡུལ་གྱི་གདམས་པ་གཙང་དུ་སྐྱོ་སྟོན་བསོད་ནམས་བླ་མ་དང་། ཡར་ཀླུང་གི་སྨྲ་ར་སེར་པོ་གཉིས་ལ་གནང་བ་རིམ་འཕེལ་གྱིས། རབ་བྱུང་དང་པོའི་ཤིང་ལུག་ཕྱི་ལོ་ཆིག་སྟོང་ང་ལྔ་ལ་འཁྲུངས་པའི་མ་གཅིག་ལབ་སྒྲོན་གྱི་གདམས་པ་བརྒྱུད་པ་དྲུག་ལྡན་གྱི་སྒོ་ནས་བོད་ཡུལ་དུ་ཟབ་མོ་བདུད་ཀྱི་གཅོད་ཡུལ་འདིའི་ལྟ་སྒོམ་གྱི་སྲོལ་ཕྱེས་པས། གཅོད་པ་དོན་འགྲུབ་དང་། མཁའ་འགྲོ་སྐྱབས། ཡུམ་སྐྱབས་རྒྱལ། ཤེས་རབ་སྒྲོལ་མ། མཁའ་འགྲོ་བདེ་ཆེན་སོགས་ལུགས་འདི་དང་འབྲེལ་བའི་མིང་གི་ཐ་སྙད་ཀྱང་གསར་དུ་དར། ཕྱིས་སུ་རབ་བྱུང་དྲུག་པའི་མེ་བྱ་(ཕྱི་ལོ་༡༣༥༧)་ལོར་རྗེ་ཙོང་ཁ་བ་བློ་བཟང་གྲགས་པས་འབྲོག་རི་བོ་དགའ་ལྡན་རྣམ་པར་རྒྱལ་བའི་གླིང་ཕྱག་འདེབས་མཛད་པ་ནས་དགེ་ལུགས་པའི་གྲུབ་མཐའི་སྲལ་བྱུང་། དེའི་གྲུབ་མཐའ་འཛིན་པའི་སྐྱེས་བུ་རིམ་བྱོན་གྱི་མཚན་ལ། དགེ་འདུན་གྲུབ་པ་དང་། དགེ་ལེགས་དཔལ་བཟང་། དགེ་འདུན་རྒྱ་མཚོ། བློ་བཟང་དོན་འགྲུབ། ཡོན་ཏན་རྒྱ་མཚོ། བློ་བཟང་ཡེ་ཤེས། ཚངས་དབྱངས་རྒྱ་མཚོ། བློ་བཟང་རྒྱ་མཚོ་ལ་སོགས་པས་མཚོན། དེ་དག་གི་རྗེས་འཇུག་གྲྭ་བ་དང་བཙུན་མ་རྣམས་ལའང་བློ་བཟང་བསྟན་འཛིན་དང་། ཤེས་རབ་རྒྱ་མཚོ། དགེ་འདུན་བཟང་བོ། དགེ་འདུན་བཟང་མོ། བློ་བཟང་སྒྲོལ་མ། དགེ་འདུན་བཟང་མོ་སོགས་མདོ་མཚན་ཉིད་ཐེག་པའི་བཀའ་བབས་ཀྱི་ཁྱད་ཆོས་མངོན་པར་མཚོན་ཡོད་པ་མ་ཟད།",
        "ནེ་མཱར་གྱིས་ཕྱི་ལོ་ ༢༠༡༥ དང་ ༢༠༡༧ ལོའི་ FIFA Ballon d'Or ཀྱི་འགྲན་བསྡུར་ཐེངས་གསུམ་པར་མཇུག་བསྡུད། ཕི་ཕ་པ་སི་རས་ཀྱི་གཟེངས་རྟགས་ཐོབ་པ། ཕི་ཕ་ལ་ FIFPro World11 དང་ UEFA Team of the Year གཉིས་པར་འདེམས་བསྐོས་བྱས། UEFA Champions League Season Squad ཚར་གསུམ་ལ་འདེམས་བསྐོས་གནང་། ས་སྟོང་ཕྱི་རོལ་དུ་ཁོ་ནི་འཛམ་གླིང་གི་རྩེད་འགྲན་པ་གྲགས་ཆེ་ཤོས་ཀྱི་གྲལ་ལ་ཡོད། SportsPro 2012 དང་ 2013 ལོར་ ESPN གིས་ཁོ་ནི་འཛམ་གླིང་གྱི་རྩེད་འགྲན་གྱི་སྙན་གྲགས་ཅན་བཞི་པའི་རྩེད་འགྲན། 2016 ལོར་མིང་བཏགས་ཡོད། ༡༩༧༧ ལོར་དུས་དེབ་ཐེངས་ ༡༠༠ གྱི་ལོ་རེའི་ཐོ་འགོད་ནང་ཁོ་འཛམ་གླིང་གི་མི་གྲགས་ཆེ་ཤོས་བརྒྱ་ཆ་༡༠༠ གྱི་ཐོ་འགོད་ནང་ཚུད་ཡོད། སྤྱི་ལོ་ ༢༠༡༨ ལོར་ France Football གིས་ Neymar མཆོག་ལ་འཛམ་གླིང་གི་དངུལ་ཕོགས་མཐོ་ཤོས་ ༣ པ་ཏུ་བརྩི་འཛིན་བྱས་འདུག ཕྱི་ལོ་ ⁇ ོ་བྷེསི་ ལོར་ Forbes གྱིས་ཁོ་འཛམ་གླིང་གི་དངུལ་ཕོགས་མཐོ་ཤོས་ ༣ པ་ཏུ་བརྩི་འཛིན་བྱས་ཤིང་། ཕྱི་ལོ་ ༢༠༢༠ ལོར་གནས་རིམ་ ༤ པ་ཏུ་གྱུར་པ།",
        "དེ་བཞིན་དེང་རབས་ཀྱི་པར་མ་གསར་པ་དཔལ་བརྩེགས་རྙིང་རྒྱུད་ (W1KG14783) དང་ཀྲུང་གོ་བོད་རིག་པའི་རྙིང་རྒྱུད་ (W3CN3207) སོགས་སུའང་ཆ་ཚང་བཞུགས་ཡོད། འོན་ཀྱང་། འབྲུག་སྤ་གྲོ་གདོང་དཀར་ལའི་རྙིང་རྒྱུད་དང་། ལ་དྭགས་བརྒྱུད་བཻ་རོ་རྙིང་རྒྱུད་ (W21519) གཉིས་སུ་བཞུགས་མེད་པ་སོགས་ཀྱི་ཁྱད་པར་ཡང་ཡོད།",
        "\"ཐུན་མིན་ལྟར་ན་རྒྱུད་ལས། གང་དུ་བདེ་ཆེན་ཞེས་བྱ་གཅིག་པུ་ཉིད། དུ་མའི་ཉམས་ཀྱིས་སྣ་ཚོགས་གར་མཛད་དོ། ཞེས་པ་ལྟར་བདེ་བ་ཆེན་པོ་ཡེ་ཤེས་གཉུག་མའི་སེམས་ཀྱི་རྡོ་རྗེ་ཉིད་ཀྱི་རང་རྩལ་ལས་བརྟན་གཡོ་སྲིད་ཞིའི་གནས་སྣང་གི་བཀོད་པ་འདི་ཉིད་འཕྲུལ་ཞིང་ཅི་ཙམ་དུ་མར་ཤར་ནའང་། དོན་དུ་སེམས་ཉིད་བདེ་བ་ཆེན་པོ་རང་བྱུང་རིག་པའི་ཀློང་ལས་ཕྱི་རོལ་ཏུ་ཅུང་ཟད་ཙམ་ཡང་འཕོས་པ་མི་སྲིད་པའི་ཕྱིར་རིག་པའི་ངང་དུ་གྲོལ་བ་ངེས་གསང་ཐེག་པ་ལས་མི་འདའ་བར་བསྐུལ་བ།\"",
        "མི་ ཞེས་པ་ནི་ཡིད་ཤེས་ཆེ་བས་ན་མི་སྟེ། འཇིག་རྟེན་འདིར་གནས་པའི་སེམས་ཅན་གྱི་ཁྱད་པར་ཅན་ལ་གོ །",
        "བཟོད་པ་སྐྱེད་པའི་དགོས་པ།ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ལ་རྒྱལ་བ་རྣམས་ཀྱི་ཡུམ་ཞེས་བཏགས་པས་སེམས་ཅན་རྣམས་ལ་སྟོང་པ་ཉིད་ཀྱི་ཆོས་འདི་ལ་བཟོད་པ་སྐྱེད་པའི་དགོས་པ་ཡོད། \"རྒྱལ་བ་རྣམས་ཀྱི་ཡུམ་ཤེར་ཕྱིན་ཐོས་ན་ཡིད་སྐྲག་པར་ཡོད་ཡེ་མི་འགྱུར་\" ཞེས་གསུངས།",
        "སྣང་བྱེད་ཀྱི་ནུས་པ་ལ་བརྟེན་ནས་བློ་གྲོས་དང་ཡེ་ཤེས་ཀྱི་སྣང་བ་སྐྱེ་བའི་ཚུལ་འདི་འདུལ་བ་སྡེ་པ་བཞིའི་ངོས་ནས་འཆད་ཡོད། \"གང་ཟག་བཞི་པོ་འདི་དག་ནི་བཤད་མ་ཐག་པའི་དོན་ཟབ་མོ་དེ་ལ་མི་སྐྲག་སྟེ། རྒྱལ་བའི་སྲས་པོ་བདེན་དོན་ཟབ་མོ་ལ་མཁས་པ་སྟེ་བདེན་པ་མཐོང་བའམ་ཤེས་རབ་སྦྱང་བ་དང༌། བྱང་ཆུབ་སེམས་དཔའ་ཕྱིར་མི་ལྡོག་པ་ཆེན་པོ་རྣམས་དང༌། འཕགས་པ་དགྲ་བཅོམ་པ་\" ཞེས་གསུངས་འདུག",
        "གལ་ཏེ་གང་ཞིག་ལ་བདག་ཏུ་འདུ་ཤེས་པ་དང་སེམས་ཅན་དུ་བདེན་པར་འདུ་ཤེས་པ་མེད་ན། དེ་ལ་ནི་ཐ་དད་པར་འཛིན་པའི་ཞེན་ཆགས་ཀྱང་མེད། དེས་ན་ཚུལ་ཁྲིམས་འཆལ་བའི་རྒྱུ་ཡང་མེད་པས་སྡོམ་པ་ཉམས་པ་ཞེས་བྱ་བ་ག་ལ་ཡོད། \"གང་ལ་རྟག་པ་དང་བདག་ཏུ་འདུ་ཤེས་པ་དང་སེམས་ཅན་དུ་བདེན་པའི་འདུ་ཤེས་མེད་པས་ཐ་དད་བདེན་པའི་འདུ་ཤེས་ཀྱི་འདོད་ཆགས་དང་བྲལ་བ་དེ་ལ་འཆལ་བའི་རྒྱུ་ཟད་པས་སྡོམ་པ་མེད་ཅེས་བྱ་བ་ག་ལ་ཡོད་དེ་མེད་དོ། །\" ཞེས་གང་ཞིག་ལ་རྟག་པར་འདུ་ཤེས་པ་དང་བདག་ཏུ་འདུ་ཤེས་པ། སེམས་ཅན་དུ་བདེན་པར་འདུ་ཤེས་པ་མེད་ན། དེ་ལ་ཐ་དད་པར་འཛིན་པའི་འདོད་ཆགས་མེད། དེས་ན་ཚུལ་ཁྲིམས་འཆལ་བའི་རྒྱུ་ཟད། དེ་ལ་སྡོམ་པ་ཉམས་ཞེས་བརྗོད་ས་མེད།",
        "འགྲོ་བའི་གནས་ཞེས་པ་ནི་འཁོར་བའི་ནང་གི་སེམས་ཅན་སྐྱེ་གནས་དང་གནས་རིམ་ཁག་ལ་ཟེར་བ་ཡིན། དེ་ཡང་རིགས་དྲུག་གམ་གནས་རིས་ཀྱི་ཁྱད་པར་ཅན་གྱི་སྐྱེ་གནས་རྣམས་ལ་གོ་དགོས། འགྲོ་བའི་གནས་ནི་འཁོར་བའི་ནང་དུ་སེམས་ཅན་རྣམས་ཀྱིས་ལས་ཀྱི་དབང་གིས་སྐྱེ་བར་གྱུར་པའི་གནས་ཚུལ་ལ་ཟེར་བ་ཡིན།",
        "ཕན་ཡོན། ལ་\"རང་གཞན་སེམས་ཅན་ཐམས་ཅད་ཀྱི་པགས་པ་གསེར་མདོག་ལྟ་བུའི་མཚན་བཟང་ཐོབ་པར་ཤོག\" ཅེས་གསུངས་པ་ལྟར་ཡིན།",
        "དབུལ་པོ་ཞེས་པ་ནི་ནོར་ལོངས་སྤྱོད་ཀྱིས་ཕོངས་པ་དང་ཉམས་མྱོང་ལ་མ་སྦྱངས་པས་འདོད་པའི་དོན་རྫོགས་པར་མ་ནུས་པ་ལ་ཟེར། དེ་ལ་རྣམ་པ་གཉིས་ཡོད་དེ། ནོར་ལོངས་སྤྱོད་ཀྱིས་ཕོངས་པའི་དབུལ་པོ་དང་བསམ་པ་མ་རྫོགས་པའི་དབུལ་པོའོ། དབུལ་པོ་རྣམས་ནི་ལུས་སེམས་གཉིས་ཀའི་སྡུག་བསྔལ་གྱིས་ཉམ་ཐག་པའི་གནས་སྟངས་ལ་གནས་ལ། དེ་དག་ལ་སྦྱིན་པ་མ་བྱས་ན་མིའི་སྐྱེ་བ་དོན་མེད་དུ་འགྱུར་བ་དང་མ་ལ་སྡུག་བསྔལ་འབའ་ཞིག་སྐྱེད་པར་ཟད་དོ། །",
        "དྲི་མཆོག་ཅེས་པ་ནི་ཙནྡན་དཀར་པོ་ལ་སོགས་པའི་དྲི་ཞིམ་པོ་མཆོག་ཏུ་གྱུར་པ་ཞིག་སྟེ། སངས་རྒྱས་དང་བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་སྐུ་ལ་བྱུག་པའི་མཆོད་པའི་རྫས་གལ་ཆེ་བ་ཞིག་ཡིན། དེའི་དགོས་པ་ནི་སྐུ་ལ་རྡུལ་མི་འབྱུང་བར་བྱེད་པ་དང། མཆོད་པ་དམ་པ་ཞིག་ཏུ་གྱུར་པར་བྱེད་པའོ། །",
        "དྲན་པའི་ངོ་བོ། \"དྲན་པའི་ངོ་བོ་ནི། བླང་དོར་གྱི་གནས་མི་བརྗེད་པ་དང། ཤེས་བཞིན་གྱི་ངོ་བོ་ནི་རང་མང་པོའི་ནང་ངམ་གཅིག་པུར་འདུག་ཀྱང་རུང་སྟེ་རྣམ་པ་ཐམས་ཅད་དུ་རང་གི་སྒོ་གསུམ་གྱི་སྤྱོད་པར་ཡང་ཡང་བརྟགས་ཏེ་བླང་དོར་ལ་ཤེས་བཞིན་དུ་འཇུག་པ་ཉིད་ཡིན།\" ཅེས་གསུངས་པ་ལྟར། དྲན་པ་ནི་བླང་དོར་གྱི་གནས་རྣམས་མི་བརྗེད་པ་ཡིན་ལ། ཤེས་བཞིན་ནི་སྒོ་གསུམ་གྱི་སྤྱོད་པ་རྣམས་ལ་ཡང་ཡང་བརྟགས་ཏེ་བླང་དོར་ལ་ཤེས་བཞིན་དུ་འཇུག་པ་ཡིན།",
        "གློ་ཞེས་པ་ནི་བུམ་པ་སོགས་ཀྱི་ཁ་དང་གཞི་བར་གྱི་ཁུང་དུ་གོ་དགོས་པ་དང་། རྡོལ་ཞེས་པ་ནི་ཁུང་ཡོད་པ་ཞེས་པའི་དོན་ཅན་ཡིན། དེས་ན་གློ་རྡོལ་ཞེས་པ་ནི་སྣོད་ཀྱི་གློ་དང་གཞི་བར་དུ་ཁུང་ཡོད་པའི་སྣོད་ལ་གོ།",
        "ཤེས་རབ་འབྱུང་གནས་བློ་གྲོས་ཀྱིས་བསླབ་བཏུས་ལས་བསླབ་པའི་གནད་ཀྱི་གནས་དྲངས། \"གང་ལ་བྱང་ཆུབ་སེམས་དཔའ་རྣམས་གོམས་པ་གློད་ཅན་ཡང་ལྟུང་བར་རྣམ་པར་གཞག་པ་འདི་ནི་བྱང་ཆུབ་སེམས་དཔའི་སྡོམ་པ་མདོར་བསྡུས་པ་ཡིན་ནོ། །\" འདིས་བསླབ་པའི་རྩ་བ་ནི་ལུས་ལོངས་སྤྱོད་དགེ་རྩ་གསུམ་པོ་སེམས་ཅན་ཐམས་ཅད་ལ་གཏོང་བ་དང་། དེ་བསྲུང་བ། དག་པར་བྱ་བ། སྤེལ་བ་བཅས་བཞི་ལ་བསྡུས་འདུག་པ་སྟོན།",
        "མཆིལ་པ་ནི་ལྕགས་ཀྱུ་ལྟ་བུའི་སྨོན་ལམ་ངན་པ་དང་གནོད་སེམས་དྲག་པོའི་སྡིག་པའི་ལས་ལ་གོ \"ཉ་བས་ཉ་རྣམས་ལྕགས་ཀྱུས་བཟུང་ནས་སྣོད་དུ་བཙོ་བ་བཞིན་དུ་ཀུན་སློང་ཉོན་མོངས་པ་ཉ་བ་དང་འདྲ་བས་བཏབ་པ་ཡི་སྨོན་ལམ་ལོག་པ་ལ་སོགས་པའི་མཆིལ་པ་སྟེ་ལྕགས་ཀྱུ་འདྲ་བ་འདི་ནི་མི་བཟད་པ་གཟེ་བའམ་རྣོ་བ་དེས་བཟུང་ནས་སེམས་ཅན་དམྱལ་བའི་ལྕགས་བསྲེག་གི་བུམ་པར་རམ་དམྱལ་ཟངས་ཆེན་པོའི་ནང་དུ་ཡང་གཤིན་རྗེས་ལས་མཁན་དམྱལ་བའི་སྲུང་མས་བདག་ཉིད་ཡུན་རིང་དུ་འཚེད་ཅིང་བསྲེག་པའི་སྡུག་བསྔལ་ཤིན་ཏུ་མི་བཟོད་པ་མྱོང་བར་ངེས་པའི་ཕྱིར་རོ། །\" ཞེས་གསུངས་སོ། །",
        "\"རྙེད་བཀུར་གྱི་ཕྱིར་བདག་བསྟོད་གཞན་སྨོད་དང་བདག་ནི་ཆོས་ཟབ་མོ་ལ་བཟོད་པ་ཐོབ་པའོ་ཞེས་མི་ཆོས་བླ་མའི་རྫུན་སྨྲ་བ་\" ཞེས་པའི་དོན་ནི་རང་ལ་མཆོད་སྦྱིན་དང་རྙེད་བཀུར། གཟེངས་བསྟོད། ཞབས་འདེགས་ལ་སོགས་པ་ཐོབ་པའི་ཆེད་དུ་རང་ཉིད་ལ་ཆོས་ཀྱི་ཤེས་པ་དང་བཟོད་པ། སྙིང་རྗེ། ཞི་གནས་ལྷག་མཐོང་ལ་སོགས་པའི་ཡོན་ཏན་མེད་ཀྱང་ཡོད་པ་ལྟར་བརྫུན་དུ་སྨྲ་ཞིང་བསྔགས་བརྗོད་བྱེད། ཡང་ན་འགྲན་སེམས་དང་ཕྲག་དོག་གི་དབང་གིས་གཞན་ལ་དེ་འདྲའི་ཡོན་ཏན་ཡོད་ཀྱང་མེད་པར་སྒྲོ་སྐུར་བྱེད་དམ། མེད་པའི་སྐྱོན་མང་པོ་ཡོད་པར་སྒྲོ་འདོགས་ཀྱིས་སྨོད་པ་བྱེད་པ་ཞིག་ལ་གོ འདི་ནི་བརྫུན་སྨྲ་བ་དང་སྨོད་པ་གཉིས་ཀ་སྦྲགས་པའི་མི་དགེ་བ་ཆེན་པོ་ཞིག་ཡིན་ལ། རྙེད་བཀུར་གྱི་ཆེད་དུ་བྱེད་པས་ཆེད་དུ་བཟང་པོ་མིན་པའི་ལས་ཀྱི་རིགས་སུ་གཏོགས། དེ་ལྟར་ཆོས་ཤེས་པ་མེད་བཞིན་དུ་ཡོད་ཅེས་བརྫུན་སྨྲ་བ་ལྟ་བུ་ཡིན། འགྲན་སེམས་ཀྱི་སྨོད་པ།",
        "\"ཉེས་པ་ཐམས་ཅད་ཁྱོད་ལ་བརྟེན་པ་ཡིན་ཏེ། རང་ཉིད་སེམས་ལུས་མེད་པར་གྱུར་པ་ཡང་ཁྱོད་ཉིད་ཀྱི་བསམ་པ་ཉིད་ཀྱིས་འདི་ཐམས་ཅད་དུ་འཇུག་པར་བྱེད་དེ། དེས་གང་འགའ་ཞིག་ཏུ་ངན་གཡོ་ཅན་དུ་རྟེན་པར་བྱེད་དོ། །\" ཞེས་པས་ཉེས་པ་ཐམས་ཅད་ཀྱི་རྩ་བ་རང་གཅེས་འཛིན་གྱི་སེམས་ལ་ཡོད་པར་རྟོགས་པའི་ཚུལ་ཡིན། རང་ཉིད་སེམས་ལུས་མེད་པར་གྱུར་ཀྱང་རང་གཅེས་འཛིན་གྱི་སེམས་ཀྱིས་ཐམས་ཅད་དུ་འཇུག་པར་བྱེད་ཅིང་། དེ་ཡང་ཉོན་མོངས་པ་དང་ལྡན་པའི་ངན་གཡོ་ཅན་དུ་རྟེན་པར་བྱེད་པས་སེམས་དེ་ཉིད་མི་དགེ་བའི་རྩ་བ་ཡིན་པར་བསྟན་པ་ཡིན།",
        "\"ཡུལ་དང་དབང་པོ་དང་རྣམ་པར་ཤེས་པ་གསུམ་པོ་དག་འདུས་པ་ནི་རེག་པ་ཡིན་ཏེ།\" ཞེས་གསུངས་པ་ལྟར། དབང་དོན་ནི་རྣམ་ཤེས་སྐྱེ་བའི་རྒྱུ་རུ་གྱུར་པའི་དབང་པོ་དང་ཡུལ་གཉིས་ཀྱི་ཚོགས་པ་ལ་བྱ་སྟེ། འདི་གཉིས་ཚོགས་པ་ལས་རྣམ་པར་ཤེས་པ་འབྱུང་བའི་ཕྱིར་རོ། །",
        "དེ་ལྟར་ཐུན་དངོས་གཞི་ཐོ་རེངས་དང་། སྔ་དྲོ། ཕྱི་དྲོ། དགོང་མོ་བཅས་ཐུན་བཞིའམ། ལྕོགས་ན་ཉིན་མཚན་ཆ་བགོས་ཀྱིས་ཐུན་དྲུག་དང༌། བརྒྱད་སོགས་དང༌།དེ་འདྲ་མི་ལྕོགས་པས་ནི་ཐོ་རེངས་དང༌། དགོང་མོ་སྟེ་ཐུན་གཉིས་ཙམ་སྒོམ། ལྟ་བའི་གོ་མྱོང་ཕྲན་བུ་དྲག་ཏུ་ཕྱིན་པའི་མཚམས་འགྲོ་འཆག་ཉལ་འདུག་གི་སྤྱོད་ལམ་ཀུན་ཏུ་ལྟ་བའི་ངེས་པ་ངམ་ངམ་ཤུགས་ཀྱིས་འབྱུང༌། དེ་ནས་སྟོང་ཉིད་ལ་དམིགས་པའི་ཞི་གནས་མེད་པར་སྟོང་ཉིད་རྟོགས་པའི་ལྷག་མཐོང་སྐྱེ་ས་མེད་པས་ཞི་གནས་ངེས་པར་བཙལ་དགོས་པས་དེའི་ཚུལ་ནི་ལོགས་སུ་ཤེས་པར་བྱའོ། །",
        "༄༅། །«ཆོས་ཀྱི་དབྱིངས་སུ་བསྟོད་པ་» ནི་ཐེག་པ་ཆེན་པོའི་སློབ་དཔོན་ཆེན་པོ་ཀླུ་སྒྲུབ་ཀྱིས་མཛད་པའི་བསྟན་བཅོས་གལ་ཆེན་ཞིག་ཡིན། གཞུང་འདི་ནི་སློབ་དཔོན་ཀླུ་སྒྲུབ་ཀྱི་བསྟོད་ཚོགས་ཀྱི་སྐོར་དུ་གཏོགས་ཤིང་། དེའི་ནང་དུ་སེམས་ཅན་ཐམས་ཅད་ཀྱི་རྒྱུད་ལ་རང་བཞིན་གྱིས་གནས་པའི་ཆོས་ཀྱི་དབྱིངས་སམ་བདེ་བར་གཤེགས་པའི་སྙིང་པོའི་རང་བཞིན་གསལ་བར་སྟོན་ཡོད། བསྟན་བཅོས་འདིས་ཆོས་ཀྱི་དབྱིངས་དེ་ཉིད་གློ་བུར་གྱི་དྲི་མ་རྣམས་ཀྱིས་གཡོགས་པའི་ཚུལ་དང་། དྲི་མ་དེ་དག་ལམ་གྱི་གཉེན་པོས་སྦྱངས་པ་ན་ཆོས་སྐུ་མངོན་དུ་འགྱུར་བའི་ཚུལ་དཔེ་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་རྒྱས་པར་བཀྲལ་ཡོད། དེར་བརྟེན་གཞུང་འདི་ནི་བོད་ཀྱི་ནང་བསྟན་ལྟ་གྲུབ་ཀྱི་ཁྲོད་དུ། ལྷག་པར་དུ་གཞན་སྟོང་དབུ་མའི་ལྟ་བ་དང་བདེ་གཤེགས་སྙིང་པོའི་སྐོར་ལ་སློབ་གཉེར་བྱེད་མཁན་རྣམས་ལ་མེད་དུ་མི་རུང་བའི་གཞུང་ལུགས་གནད་འགག་ཅན་ཞིག་ཏུ་བརྩི་བཞིན་ཡོད།",
        "ཆོས་ཐམས་ཅད་མིང་ཙམ་དུ་བསྟན་པ། མཐར་གཏུགས་ན་ཆོས་འདི་དག་ཐམས་ཅད་མིང་ཙམ་དང་རྟོག་པས་བཏགས་པ་ཙམ་ལས་བརྗོད་བྱའི་དོན་ལ་རང་བཞིན་ཞིག་གྲུབ་པ་མེད་ཅེས་གསུངས་ཡོད། དེ་བཞིན་གཤེགས་པ་དང་ཆོས་དབྱིངས་ཀྱང་དོན་ལ་ཐ་མི་དད་པར་མཉམ་པ་ཉིད་དུ་བཞེད་པ་གསུངས།",
        "གཞུང་འདི་ནི་སློབ་དཔོན་རྟ་དབྱངས་ཀྱིས་སངས་རྒྱས་ཀྱི་ཡོན་ཏན་དང་དཔའ་རྩལ། ལྷག་པར་དུ་བདུད་དགྲའི་དཔུང་ཚོགས་ཕམ་པར་མཛད་པའི་ལེགས་བཤད་ལ་དམིགས་ནས་བརྩམས་ཡོད། འདི་ནི་རྒྱ་གར་གྱི་སྙན་ངག་དང་བསྟོད་པའི་རིག་གནས་ལ་གཞིགས་ཏེ་བུད་མེད་ཀྱི་འདོད་ཆགས་དང་བདུད་ཀྱི་ཐབས་ལམ་ལས་རྣམ་པར་རྒྱལ་བའི་སངས་རྒྱས་ཀྱི་དཔའ་རྩལ་ཆེ་བའི་ཚུལ་རྒྱས་པར་དཔྱད་པའི་གཞུང་ལུགས་ཤིག་ཡིན།",
        "བརྗོད་བྱ། དཔལ་དགྱེས་པའི་རྡོ་རྗེ་ཞལ་བརྒྱད་པའི་སྒྲུབ་ཐབས་དང་། རྒྱུད་སྡེ་བླ་ན་མེད་པའི་ཉམས་ལེན།",
        "འདིར་དཔྱད་གཞིའི་ཁུངས་ཐོ་ཞིབ་ཏུ་འགོད་དགོས། (འདི་ནི་ཝེ་ཁེ་རིག་མཛོད་ཀྱི་རྩོམ་ཡིག་ལ་མེད་དུ་མི་རུང་བའི་ཆ་ཤས་གལ་ཆེན་ཞིག་ཡིན།)",
        "སྒྲུབ་པ་དང་འབྲས་བུའི་རྣམ་གཞག། གཞུང་འདིའི་ནང་། རྒྱུན་དུ་ཞུགས་པའི་འབྲས་བུ་ལ་སོགས་པ་ནི་བདག་མེད་པ་བསྒོམས་པས་བསྐྱེད་པར་བྱ་བ་ཡིན་པའི་ཕྱིར་ན་བསྒྲུབ་པར་བྱ་བ་ཡིན་པར་གསུངས་ཡོད། དེ་བཞིན་དུ་། དེ་སྒྲུབ་པའི་ཐབས་ནི་བདག་མེད་པ་བསྒོམ་པ་ཡིན་པར་བསྟན་ཡོད།",
        "བརྩམས་པའི་དུས་རབས། དུས་སྐབས་གསལ་བོ་ཤེས་དཀའ།",
        "དེ་བཞིན་གཤེགས་པ་ཐམས་ཅད་སྤྱན་དྲངས་ཏེ། དབང་བསྐུར་ཅིག་ཅེས་གསོལ་བ་འདེབས་པ་དང་། རིན་པོ་ཆེའི་བུམ་པས་དབང་བསྐུར་བ། མགོ་ན་མི་བསྐྱོད་པ་མགོན་པོའི་དབུ་རྒྱན་དུ་བྱོན་པའི་ཆོ་ག་ཡོད།",
        "ཚར་གཅོད་པའི་ལས། དྲག་པོའི་ལས་ཀྱི་སྐབས་སུ་གཏོར་མའི་ནང་དགྲ་བགེགས་ཀྱི་གཟུགས་བརྙན་(རཱུ་པ)དམིགས་ནས། དྲག་པོའི་འབྱུང་པོ་རྣམས་སྤྱན་དྲངས་ཏེ། གནོད་བྱེད་ཀྱི་དགྲ་བགེགས་ཀྱི་སྲོག་དང་ནོར་འཕྲོག་པ་སོགས་དྲག་པོའི་ཕྲིན་ལས་བཅོལ་དགོས་པར་བསྟན་ཡོད།",
        "ལས་ (ཀརྨ) ཞེས་པ་ནི་ཞི་རྒྱས་དབང་དྲག་གི་བྱ་བ་སྟེ་ལས་ཀྱི་རིགས་མི་འདྲ་བ་རྣམས་ལ་གོ།",
        "རྒྱ་གར་མཁན་པོ་ལི་ལ་བཛྲ (Līla Vajra) ནི་རྒྱ་གར་གྱི་སིདྡྷ་དང་མཁན་པོ་གྲགས་ཅན་ཞིག་ཡིན། ཁོང་ནི་དུས་རབས་བཅུ་གཅིག་པ་ནས་བཅུ་གསུམ་པའི་བར་དུ་བྱོན་པའི་རྒྱུད་ཀྱི་མཁས་པ་ཆེན་པོ་ཞིག་ཡིན་པར་གྲགས། ཁོང་གིས་བླ་མེད་རྒྱུད་ཀྱི་གཞུང་དང་སྒྲུབ་ཐབས་མང་པོ་མཛད་ཅིང་། ལྷག་པར་དུ་མཁའ་འགྲོ་དང་ཧེ་རུ་ཀའི་སྒྲུབ་ཐབས་ཁག་གི་སྐོར་ལ་ཐུགས་འགན་བཞེས་ཡོད།",
        "གཞུང་འདིས་རླུང་གི་ཡོན་ཏན་ཆོ་ག་ཡིས་ལྟེ་བ་ཡི་དབུས་ནས་བསྐྱོད་དེ། གདུ་བུ་ཨུཏྤལ་གྱི་ནང་དུ་བདེ་བའི་རྒྱལ་པོ་ཁྱབ་པར་བྱེད་ཚུལ་གསལ་བཤད་གནང་ཡོད། དེ་ལ་ནང་གི་རེག་བྱ་ཡི་གནས་སུ་འཇུག་པ་དང་། བརྗོད་མེད་ཉམས་སུ་མྱོང་བར་བྱེད་པ། འདུ་ཤེས་ཐམས་ཅད་ལས་གྲོལ་ཏེ། རང་དང་གཞན་གྱི་བྱེ་བྲག་མི་ཤེས་པའི་ཉམས་ཞིག་སྐྱེ་བར་བཤད། བསྲུབས་དང་བསྲུབ་པའི་སྦྱོར་བ་ཡིས་རྣམ་པར་སྨིན་པའི་འབྲས་བུ་རྙེད་པ་དང་། ཡེ་ཤེས་རླུང་གིས་དགུག་པ་ཡིས་མཚན་ཉིད་བྲལ་བའི་དངོས་གྲུབ་རྙེད་ཚུལ་གསལ།",
        "ཁྲོ་བོའི་བརྗོད་པ་ནི་སྤྲིན་བྱུང་འབྲུག་སྒྲ་ལྟ་བུའི་ཡི་གེ་ཧཱུཾ་གྱི་ཚིག་དང་། རྡོ་རྗེའི་བརྗོད་པ་ནི་ལྕེ་རྩེ་ཤིན་ཏུ་མི་བསྒུལ་བའི་ཚུལ་གྱིས་བྱེད་པ་སོགས་གསལ་པོར་བཤད་ཡོད།",
        "སོ་སོར་སྡུད་པ་ནི་སྦྱོར་དྲུག་གི་དང་པོ་ཡིན་ཏེ། འདི་ནི་ལུས་དང་སེམས་ཀྱི་གཡེང་བ་དགག་ནས། རླུང་རྣམས་ནང་དུ་འཆིང་བའི་ཐབས་ཤིག་ཡིན། ལུས་ཀྱི་བྱེད་པ་དང་གཙུག་ཏོར་ཆེན་པོའི་ལྟ་སྟངས་བཅས་ཀྱི་ཐོག་ནས་ཉམས་སུ་ལེན་པ་སྟེ། མཚན་མོ་དང་ཉིན་མོའི་སྔ་ཕྱིར་དུས་བགོས་ནས་བསྒོམ་པ་དང་། ནམ་མཁའ་ཞེན་པས་ནམ་མཁར་བལྟ་བ་སོགས་ཀྱི་ཉམས་ལེན་གྱི་གནད་ཁག་བཤད་ཡོད།",
        "གཟའ་རྩིས་ནི་གཟའ་དང་པོ་ནས་བཟུང་སྟེ་གཟའ་བདུན་གྱི་གོ་རིམ་ཤེས་པའི་རྩིས་ཤིག་ཡིན། རྐང་པ་ནི་གཟའ་དང་ཉི་མ། ཟླ་བ་བཅས་ཀྱི་གནས་སྟངས་གསལ་བར་བྱེད་པའི་རྩིས་ཀྱི་ཆ་ཤས་ཤིག་ཡིན། ཚེས་གྲངས་ལ་རྐང་པ་སྦྱིན་པ་སོགས་ཀྱི་ཐབས་ལམ་གྱིས། གཟའ་དང་ཉི་ཟླའི་ལོངས་སྤྱོད་ཀྱི་གནས་སུ་གཏན་འབེབས་བྱེད་ཐུབ།",
        "བླངས་ནས་ཁས་འདོན་བུམ་མེ་བཞིན། །\" ཞེས་གསུངས་པ་ལྟར་རོ། ། དེར་བརྟེན་བློ་དམན་རྣམས་ཀྱིས་ཀྱང་རྒྱུད་ཀྱི་དོན་ལ་འཇུག་པར་བྱ་བའི་ཕྱིར་དང་། ལྷག་པར་དུ་འབུམ་པའི་རྩ་རྒྱུད་ལས་ཕྱུང་བའི་བསྡུས་པའི་རྒྱུད་ལ་དགའ་བ་རྣམས་ཀྱི་དོན་དུ་དཀའ་གནད་རྣམས་གསལ་བར་བྱེད་པའི་ཆེད་དུ་བསྟན་བཅོས་འདི་མཛད་པ་ཡིན།",
        "གཞུང་འདི་བོད་སྐད་དུ་བསྒྱུར་བའི་སྐོར་མཇུག་བྱང་ལས། \"རྒྱ་གར་གྱི་མཁན་པོ་དེ་ཉིད་དང་། ལོ་ཙཱ་བ་དགེ་སློང་གྲགས་མཆོག་ཤེས་རབ་ཀྱིས་བསྒྱུར་ཏོ། །\"ཞེས་གསལ་བ་ལྟར། མཛད་པ་པོ་པཎྜི་ཏ་སུ་མ་ཏི་ཀཱིརྟི་དངོས་དང་བོད་ཀྱི་ལོ་ཙཱ་བ་དགེ་སློང་གྲགས་མཆོག་ཤེས་རབ་ཟུང་གིས་བོད་སྐད་དུ་བསྒྱུར་གནང་མཛད་པ་ཞིག་ཡིན་ནོ། །",
        "* ལེའུ་བཅུ་བདུན་པ། རྫོགས་རིམ་གྱི་དོན་གཙོ་བོར་བསྟན་པ་དང་། ཉམས་ལེན་གྱི་ཕན་ཡོན་དང་འབྲས་བུ་བཅས་བསྟན་ནས་གཞུང་མཇུག་བསྡུས།",
        "རང་བཞིན་གྱིས་གྲུབ་པའི་དགག་བྱ་དེ་ཇི་ལྟར་ངོས་འཛིན་བྱེད་དགོས་པ་ནི་དབུ་མ་པའི་ལྟ་བ་རྟོགས་པའི་གནད་ཀྱི་ཡི་གེར་གསུངས། དགག་བྱ་ངེས་པར་དུ་ངོས་འཛིན་ཐུབ་དགོས་ཤིང་། དེ་ལ་ཆ་ཆུང་ཆ་ཆེན་གྱི་སྐྱོན་སྤང་དགོས།",
        "བ་སནྟ། (vasanta) ཞེས་པ་ནི་བོད་སྐད་དུ་དཔྱིད་ཅེས་པའི་དོན་ཏེ། དཔྱིད་ཀྱི་དུས་སུ་སྐྱེ་དངོས་ཐམས་ཅད་གསར་དུ་འཁྲུངས་ཤིང་སོས་དལ་བག་ཕེབས་ཀྱི་དགའ་བ་སྟེར་བ་ལྟར། གཞུང་འདིའི་ལམ་ཉམས་སུ་བླངས་པས་ལྷན་སྐྱེས་ཀྱི་བདེ་བ་ཆེན་པོ་འཆར་བར་བྱེད་པ་མཚོན།",
        "གཞུང་འདི་མཛད་པ་པོ་ནི་རྒྱ་གར་གྱི་པཎྜི་ཏ་ཆེན་པོ་དཔལ་པྲཛྙཱ་རཀྵི་ཏ་ (Prajñārakṣita) ཡིན། ཁོང་ནི་གསང་སྔགས་ཀྱི་གཞུང་ལུགས་ལ་མཁས་པའི་སློབ་དཔོན་ཞིག་ཡིན་པར་མངོན།",
        "«ཡི་གེ་བདུན་པའི་སྒྲུབ་ཐབས།»འདི་ནི་དཔལ་འཁོར་ལོ་སྡོམ་པའི་རྒྱུད་ལ་ཁུངས་གཏུགས་པའི་ཉམས་ལེན་གྱི་མན་ངག་ཡིན་པས། རྩ་བའི་གཞུང་ལྟ་བུ་ཞིག་ཡིན། འདི་ལ་བརྟེན་པའི་འགྲེལ་པ་དང་ལམ་སྟོན་ཁག་བཀའ་བརྒྱུད་པའི་མཁས་གྲུབ་རིམ་བྱོན་གྱི་གསུང་རྩོམ་ཁྲོད་དུ་ཡོད་སྲིད།",
        "མཚན་བྱང་ཆ་ཚང་། དཔལ་བདེ་མཆོག་གི་དཀྱིལ་འཁོར་གྱི་ཆོ་ག",
        "དུས་འཁོར་རྒྱུད་ཀྱི་ལམ་ལ་བརྟེན་ནས་སངས་རྒྱས་ཀྱི་ས་མྱུར་དུ་འགྲུབ་པའི་ཡོན་ཏན་དང་། ལྷག་པར་དུ་རིག་པ་གཟུགས་མེད་ཀྱི་གོ་འཕང་ལ་འགོད་པའི་ཁྱད་ཆོས། སེམས་ཅན་རྣམས་ལ་ཕན་པའི་ཐུགས་རྗེའི་སྤྱོད་པ་སོགས་འབྲས་བུའི་གོ་འཕང་གི་ཡོན་ཏན་རྣམས་བརྗོད་པ་ལ་བསྟོད་པ་ཕུལ་ཡོད།",
        "རྒྱུད་གསུམ་ནི། འཇིག་རྟེན་པའི་ཕ་མའི་རྒྱུད་དང་། འཇིག་རྟེན་ལས་འདས་པའི་ཐབས་དང་ཤེས་རབ་ཀྱི་རྒྱུད། བླ་ན་མེད་པའི་དེ་བཞིན་གཤེགས་པའི་རྒྱུད་དོ། །གཏུམ་མོ་སྦར་བའི་ཐབས་ནི་སྲུབ་དང་བསྲུབ་བྱའི་སྦྱོར་བ་ལས་ལས་ཀྱི་རླུང་གིས་བསྐྱོད་པའི་ཡེ་ཤེས་ཀྱི་མེས་ཕུང་པོ་དང་ཁམས་བསྲེགས་ཏེ་སྣང་བ། མཆེད་པ། ཐོབ་པའི་ཡེ་ཤེས་རིམ་པ་བཞིན་དུ་འབྱུང་བའི་རིམ་པ་གསལ་བར་བཀོད་ཡོད།",
        "ཝེ་ཁེ་བོད་ཀྱི་རིག་མཛོད། རུས་སྦལ་ཞབས་ཀྱི་སྒྲུབ་པའི་ཐབས།",
        "སེམས་བསྐྱེད་ཀྱི་རྗེས་སུ་བླ་མའི་རྣལ་འབྱོར་གསུངས་ཡོད། འདིར་རྣལ་འབྱོར་པས་རང་གི་སྤྱི་བོར་བླ་མ་བསྒོམ་པ་ནི་གསང་སྔགས་རྡོ་རྗེ་ཐེག་པའི་ཉམས་ལེན་ཐམས་ཅད་ཀྱི་སྒོ་འབྱེད་ཅིག་ཡིན། བླ་མ་ལ་མོས་གུས་དང་བརྟན་པའི་དད་པས་གསོལ་བ་འདེབས་པ་དང་། བླ་མ་ལྷ་དང་དབྱེར་མེད་དུ་བསྒོམ་པའི་ཐབས་ནི་བྱིན་རླབས་ཐོབ་པའི་རྒྱུ་དངོས་སུ་གྱུར་པ་རེད། གཞུང་འདིར་སྤྱི་བོར་བླ་མ་བསྒོམ་པ་ནི་རང་ཉིད་ལ་བླ་མའི་བྱིན་རླབས་བསྐུལ་ཏེ། འོད་ཟེར་དང་བདུད་རྩི་བབས་པས་རང་གི་སེམས་རྒྱུད་བྱིན་གྱིས་བརླབས་པའི་རྣལ་འབྱོར་གསལ་བར་གསུངས་ཡོད།",
        "«གཞན་དོན་སློབ་མ་རྗེས་སུ་བཟུང་བའི་ཆོ་ག»ཞེས་པ་ནི་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་རྒྱུད་སྡེའི་ནང་ཚན་ཞིག་སྟེ། སློབ་དཔོན་གྱིས་སློབ་མ་གསར་པ་གསང་སྔགས་ཀྱི་ལམ་དུ་འཇུག་པའི་དབང་བསྐུར་གྱི་ཆོ་ག་འདི་ཉིད་བསྟན་པའི་གཞུང་ཞིག་ཡིན། གཞུང་འདིས་དཀྱིལ་འཁོར་བསྒྲིགས་ཚུལ་དང་། བུམ་དབང་གི་ཆོ་ག། ཡེ་ཤེས་འབེབས་ཚུལ་སོགས་སྒྲུབ་ཐབས་ཀྱི་རིམ་པ་མ་ཚང་བ་མེད་པར་བཀོད་ཡོད། བོད་བསྒྱུར་མ་འདི་བཀའ་འགྱུར་གྱི་རྒྱུད་སྡེའི་སྐོར་དུ་བཞུགས་ཤིང་། བཀའ་བརྒྱུད་དང་ས་སྐྱའི་རྡོ་རྗེ་རྣལ་འབྱོར་མའི་སྒྲུབ་བརྒྱུད་ཁྲོད་དུ་གལ་ཆེན་པོའི་གཞུང་ཞིག་ཏུ་གྲགས།",
        "གཞུང་འདིས་ལག་པ་གཡོན་པའི་སོར་མོ་ལྔ་དང་སེན་མོ་ལྔ་ལ་སངས་རྒྱས་ཀྱི་རིགས་ལྔ་བསྒོམ་པའི་ཐབས་བསྟན། མཐེ་བོ་ནས་མཐེའུ་ཆུང་བར་གོ་རིམས་བཞིན་དུ་རྡོ་རྗེ་སེམས་དཔའ། རྣམ་པར་སྣང་མཛད། འོད་དཔག་མེད། མི་བསྐྱོད་པ། རིན་ཆེན་འབྱུང་ལྡན་བཅས་བསྒོམ། སེན་མོ་དྲུག་པ་ལ་དོན་ཡོད་གྲུབ་པ་བསྒོམ་པར་བསྟན། ལྷ་རེ་རེ་ལ་ཁ་དོག་སོ་སོ་སྟེ། དཀར་པོ་དང་། སེར་པོ། དམར་པོ། ནག་པོ། དམར་སེར། ལྗང་གུ་བཅས་དང་། ས་བོན་གྱི་ཡི་གེ་སོ་སོ་སྟེ། ཨོཾ་ཧ། ན་མཿཧི། སྭཱ་ཧཱ་ཧུ། བཽ་ཥ་ཊ་ཧེ། ཧཱུཾ་ཧཱུཾ་ཧོ། ཕཊ་ཧཾ་བཅས་བཀོད་དགོས་པར་བསྟན།",
        "བཅོམ་ལྡན་འདས་ཀྱི་དབང་པོ་དྲུག་ཏུ་ཡི་གེ་དྲུག་བཀོད་པ་ནི་གོ་ཆའི་རྣལ་འབྱོར་ཡིན། མིག་གི་དབང་པོ་ལ་ཨོཾ་ཡིག་དམར་པོ། རྣ་བའི་དབང་པོ་ལ་ཧཱུཾ་ཡིག་སྔོན་པོ། སྣའི་དབང་པོ་ལ་ཙི་ཡིག་སེར་པོ། ལྕེའི་དབང་པོ་ལ་ཨ་ཡིག་དཀར་པོ། གཙུག་ཏོར་གྱི་གནས་སུ་རེ་ཕ་ལྗང་གུ། ཡིད་ལ་ཁེ་ཡིག་དཀར་པོ། དེ་ནས་ཨོཾ་ཨཱཿཧཱུཾ་གིས་སྐུ་གསུང་ཐུགས་བྱིན་གྱིས་བརླབས་པ་སྟེ། གོ་རིམས་བཞིན་མགོ་བོ་མགྲིན་པ་སྙིང་གར་བསྒོམ།",
        "འཁོར་གྱི་ལྷ་བསྐྱེད་པ། གཙོ་བོའི་ཕྱོགས་བཞིར་རྡོ་རྗེ་མཁའ་འགྲོ་མ། དྲག་མོ་མཁའ་འགྲོ། རོ་ལངས་མ། གདོལ་པ་མོ་བཅས་དང་། མཚམས་བཞིར་སེང་གེ་མ། སྟག་མོ། ཅེ་སྤྱང་མ། འུག་པ་མོ་བཅས་འཁོར་གྱི་ལྷ་མོ་རྣམས་བསྐྱེད་པ།",
        "བི་དྷིཿ (Vidhi): ཞེས་པ་ནི་ \"ཆོ་ག་\" འམ་ \"རིམ་པ་\" ཞེས་པའི་དོན་ཡིན།",
        "དྷ་རོ་ (Dharo): འདི་ནི་ \"དྷ་ར་\" (Dhara) ཞེས་པ་ལས་དྲངས་པ་སྟེ། བོད་སྐད་དུ་ \"འཛིན་པ་\" འམ་ \"གནས་པ་\" ཞེས་པའི་དོན་ཡིན། ཟབ་མོའི་དོན་རྣམས་ཕྱོགས་གཅིག་ཏུ་བསྡུས་ཏེ་འཛིན་པའི་དོན་ཡིན། (བོད་སྐད་ཀྱི་མཚན་བྱང་བསྡུས་པ་འགའ་རེའི་ནང་འདིའི་དོན་ཐད་ཀར་མ་སྨོས་པའང་ཡོད།)",
        "གཞུང་འདིའི་མཛད་པ་པོ་སློབ་དཔོན་ཆེན་པོ་ཐུ་བོ་རཱ་ཛ་ཧ་ཏི་ནི་རྒྱ་གར་གྱི་གྲུབ་ཐོབ་སློབ་དཔོན་ཞིག་ཡིན། མཁས་པ་འདིའི་ལོ་རྒྱུས་ཞིབ་ཕྲ་དཔྱད་གཞི་གཞན་ལས་མཚོན་དགོས་ཀྱང་། གཞུང་འདིའི་མཇུག་བྱང་ལས་སློབ་དཔོན་ཆེན་པོ་ཞེས་བརྗོད་པ་ལས་མཁས་པ་གྲགས་ཅན་ཞིག་ཡིན་པར་མངོན། གཞུང་ནང་རྡོ་རྗེ་ཐེག་པའི་རྒྱུད་སྡེའི་གནད་དོན་ཟབ་མོ་དང་། དཀྱིལ་འཁོར་གྱི་ཆོ་ག །སྔགས་ཕྱག་རྒྱ་སོགས་ལ་མཁས་པའི་མཚན་གཞི་གསལ་པོར་མཚོན་ཐུབ་པས། རྒྱུད་སྡེའི་སློབ་དཔོན་ཆེན་པོ་ཞིག་ཡིན་པར་བརྩིའོ། །",
        "«བྱང་ཆུབ་ཀྱི་སེམས་བདེ་བ་ཆེན་པོའི་མན་ངག»ཞེས་པ་ནི་རྒྱ་གར་གྱི་མཁན་པོ་ཨ་ཏི་ཤས་མཛད་པའི་གསང་སྔགས་ཀྱི་མན་ངག་ཐུང་ངུ་ཞིག་ཡིན་ཞིང་། འཆི་ཁའི་དུས་སུ་རྣམ་ཤེས་འཕོ་བའི་ཉམས་ལེན་དང་། རྫོགས་པ་ཆེན་པོའི་ལྟ་སྒོམ་སྤྱོད་གསུམ་གྱི་མཐར་ཐུག་གི་དོན་བསྟན་པའི་གཞུང་ཞིག་ཡིན་ནོ། །གཞུང་འདི་སྤྱི་ལོ་བཅུ་གཅིག་པའི་དུས་རབས་སུ་བོད་དུ་བསྒྱུར་བ་ཡིན་ཞིང་། བོད་ཀྱི་རྫོགས་ཆེན་དང་འཕོ་བའི་གདམས་ངག་གི་བརྒྱུད་པར་ཤུགས་རྐྱེན་ཐེབས་པའི་གཞུང་གལ་ཆེན་ཞིག་ཡིན་ནོ། །",
        "སྟོན་པས་གསུངས་པའི་ལམ་འདི་ནི་སྡུག་བསྔལ་གྱི་རྒྱུ་སྤངས་ནས་ཐར་པ་ཐོབ་བྱེད་ཀྱི་ལམ་བཟང་པོ་ཞིག་ཡིན།",
        "བསམ་པ་ལས་བྱུང་བའི་ཤེས་རབ། ཐོས་པའི་དོན་དག་ལ་རིགས་པས་བརྟག་དཔྱད་བྱས་ཏེ། ཐེ་ཚོམ་བཅད་ནས་ངེས་ཤེས་བརྟན་པོ་རྙེད་པ་ལ་ཟེར།",
        "མཆོད་བརྗོད། གཞུང་གི་མགོར་དཔལ་ནག་པོ་ཆེན་པོ་ལ་ཕྱག་འཚལ་ཞིང་མཆོད་བརྗོད་བྱས་ཏེ། དྲན་པའི་སྐད་ཅིག་གིས་འགྲོ་བ་རྣམས་ཀྱི་འཇིགས་བྱེད་འདོད་ཆགས་སོགས་ཀྱི་བུད་ཤིང་སྲེག་པའི་ཡེ་ཤེས་ཀྱི་མེ་ཆེན་པོ་ལ་ཕྱག་འཚལ་བར་གསུངས་སོ། །དེ་ནས་གསལ་ལ་མ་ཚང་མེད་པར་བསྡུས་ཏེ་ཡང་དག་པའི་རིམ་བཞིན་སྦྱིན་སྲེག་གི་ཆོ་ག་འབྲི་བར་འདོད་པའི་དགོངས་པ་གསལ་བར་མཛད་དོ། །",
        "«སྡེ་བདུན་མདོ་དང་བཅས་པའི་དགོངས་པ་ཕྱིན་ཅི་མ་ལོག་པར་འགྲེལ་པ་ཚད་མ་རིགས་པའི་གཏེར་གྱི་དོན་གསལ་བར་བྱེད་པ་»ཞེས་པ་འདི་ནི་འགྲེལ་པ་ཞིག་ཡིན་ནོ༎ འདིའི་རྩ་བའི་གཞུང་ནི་འཇམ་མགོན་ས་སྐྱ་པཎྜི་ཏས་མཛད་པའི་«ཚད་མ་རིགས་པའི་གཏེར་»ཞེས་པ་དེ་ཡིན་ནོ༎",
        "དགེ་བ་ལ་སྤྲོ་བའི་བརྩོན་འགྲུས་བསྐྱེད་ཚུལ་བཤད་དོ།། བརྩོན་འགྲུས་ཀྱི་གེགས་ལེ་ལོ་དང་སྒྱིད་ལུག་པ་སོགས་སྤོང་ཚུལ་དང་། བརྩོན་འགྲུས་བསྐྱེད་པའི་རྒྱུ་སྟོབས་བཞི་སྟེ། མོས་པའི་སྟོབས་དང་། བརྟན་པའི་སྟོབས་དང་། དགའ་བའི་སྟོབས་དང་། དོར་བའི་སྟོབས་རྣམས་ཀྱི་སྒོ་ནས་བརྩོན་འགྲུས་ལ་འཇུག་ཚུལ་བསྟན་ཏོ།།",
        "གཞུང་འདིའི་ཁྱད་ཆོས་གཙོ་བོ་ནི། བསྐྱེད་རིམ་དང་རྫོགས་རིམ་གཉིས་ཀ་འདུས་པའི་སྒྲུབ་ཐབས་འཐུས་ཚང་ཞིག་ཡིན་པ་དང་། ལས་སྦྱོར་གྱི་ཆོ་ག་ཤིན་ཏུ་མང་བ། བསད་པ་དང་རིམས་ནས་བཟུང་། དབང་དུ་བྱ་བ་དང་སྲུང་བ་སོགས་ཀྱི་ལས་ཐམས་ཅད་ཀྱི་ཆོ་ག་ཁྱབ་པ། སྐུ་གཟུགས་དང་མཚན་མའི་རྣམ་པ་ཤིན་ཏུ་གསལ་བ། སྔགས་མང་པོ་འདུས་པ་བཅས་ཡིན་ནོ། །",
        "མཚན་བྱང་ཆ་ཚང་། སྒྲོན་མ་གསལ་བར་བྱེད་པའི་དཀའ་བ་བཏུས་པའི་འགྲེལ་བ།",
        "སློབ་དཔོན་དབྱུག་པ་ཅན་གྱིས་སྙན་ངག་པ་དག་གིས་སྤང་དགོས་པའི་སྐྱོན་བཅུ་བསྟན་པ་ནི།",
        "མོན་ཡུལ་དུ་སྤྱི་ལོ་དུས་རབས་བདུན་པ་ཙམ་ནས་ནང་ཆོས་དར་ཞིང་བག་ཆགས་ཟབ་མོ་བཞག་པས་མོན་མི་རིགས་ཀྱི་སྤྱི་ཚོགས་རིག་གཞུང་ཡོངས་ལ་ནང་ཆོས་ཀྱི་ཤུགས་རྐྱེན་ཆེན་པོ་ཐེབས་ཡོད།",
        "བཟང་ལྡན། ནི་སངས་རྒྱས་ཀྱི་སློབ་མ་རིགས་མཐོ་བའི་ནང་ནས་མཆོག་ཏུ་གྱུར་པ་དེ་ཡིན།",
        "དྷཱ་མེཀ་མཆོད་རྟེན་ནི་ཝཱ་རཱ་ཎ་སཱིའི་ས་ཁུལ་གྱི་སོ་ཕག་དམར་པོ་དང་རྡོ་ལས་གྲུབ་པའི་ཟླུམ་གཟུགས་ཀྱི་མཆོད་རྟེན་ཞིག་ཡིན། འདིའི་བཟོ་བཀོད་ཀྱི་གནས་ཚུལ་གཤམ་གསལ།",
        "| **ནད་འགོག་མ་ལག** | ཁོང་ཁྲོ་ལངས་སྐབས་ལུས་ནས་ \"ཀོར་ཊི་སོལ་\" (Cortisol) ཟེར་བའི་གཤེར་རྩི་མང་པོ་བཏོན་པས། ནད་འགོག་ནུས་པ་དམའ་རུ་གཏོང་གི་ཡོད།",
        "འོན་ཀྱང་། དེང་སང་དཔེ་དེབ་ལ་བཀག་སྡོམ་ (Censorship) བྱེད་པའི་དཀའ་ངལ་ཡང་འཕྲད་བཞིན་ཡོད། ལྷག་པར་དུ་ཨ་རི་ལྟ་བུའི་རྒྱལ་ཁབ་ཁག་ཏུ་ཆབ་སྲིད་དང་ཆོས་ལུགས་ཀྱི་རྒྱུ་མཚན་ལ་བརྟེན་ནས་དཔེ་ཆ་ཁ་ཤས་བཀག་སྡོམ་བྱེད་པའི་གྲངས་འབོར་འཕེལ་བཞིན་ཡོད།",
        "མཐའ་དྲུག་གི་དོན་རྟོགས་པ། རྒྱུད་ཀྱི་དོན་རྣམས་དྲང་དོན་དང་ངེས་དོན། སྒྲ་ཇི་བཞིན་པ་དང་ཇི་བཞིན་མ་ཡིན་པ་སོགས་ཀྱི་སྒོ་ནས་འཁྲུལ་མེད་དུ་རྟོགས་དགོས་པར་བསྟན།",
        "ཐེག་པ་ཆེན་པོ། (Mahayana) འདི་ནི་བྱང་ཆུབ་སེམས་དཔའི་ལམ་ལ་གཙོ་བོ་བྱེད་པ་དང་། རྒྱ་ནག་དང་། ཉི་ཧོང་། ཀོ་རི་ཡ་སོགས་ཤར་ཕྱོགས་རྒྱལ་ཁབ་ཁག་ཏུ་དར་ཁྱབ་ཆེ།",
        "༡. ལྷག་བཅས་མྱང་འདས།(Sopadhishesa Nirvana)",
        "གྲུབ་པའི་མཚན་མ་མཐོང་ནས་དངོས་གྲུབ་བསྒྲུབ་པའི་ཆོ་ག་བཤད། བགེགས་བྱུང་ན་བཟློག་པའི་ཐབས་དང་། བདུད་རྩི་འཁྱིལ་པའི་དཀྱིལ་འཁོར་བསྒྱུར་བའི་རིམ་པ་བཅས་བཤད།",
        "བརྗོད་བྱ། རྡོ་རྗེ་ཐེག་པའི་དབང་བསྐུར་གྱི་ཆོ་ག",
        "བརྗོད་བྱ། གསང་སྔགས་ཀྱི་ཆོ་ག དམིགས་བསལ་གཙུག་ལག་ཁང་སོགས་བརྩིགས་པའི་སྐབས་ཀྱི་ས་ཆོག་དང་རབ་གནས་ཀྱི་ཆོ་ག",
        "ཡོན་ཏན་ལ། བསྐལ་པ་མཐའ་ཡས་པར་འཚོ། སྲེད་མེད་ཀྱི་བུའི་སྟོབས། བརྩོན་འགྲུས། སྨོན་ལམ། མངོན་ཤེས་ལྔ་ཐོབ་པར་བཤད།",
        "ཕྱོགས་བཞིར་གཤིན་རྗེ་གཤེད་བཞི་བཤད་ཡོད་དེ། ཤར་དུ་གཏི་མུག་གཤིན་རྗེ་གཤེད་དཀར་པོ་ཟླ་བའི་གདན་ལ་བཞུགས་པ། ལྷོར་སེར་སྣ་རྡོ་རྗེ་གཤིན་རྗེ་གཤེད་གསེར་བཙོ་མ་ལྟ་བུའི་མདོག་ཅན། ནུབ་ཏུ་འདོད་ཆགས་རྡོ་རྗེ་གཤིན་རྗེ་གཤེད། བྱང་དུ་ཕྲག་དོག་རྡོ་རྗེ་གཤིན་རྗེ་གཤེད་རྣམས་བཤད། དེ་བཞིན་མེ་ཕྱོགས་ལ་སོགས་པའི་གྲྭ་བཞིར་ལྷ་མོ་བཞི་བཤད་ཡོད་དེ། འོད་ཟེར་ཅན་མ་དང་ཕག་མོ་དང་རྡོ་རྗེ་དབྱངས་ཅན་མ་དང་རྡོ་རྗེ་མཛོད་ལྡན་མ་བཅས་ཡིན། སྒོ་བཞིར་ཐོ་བ་གཤིན་རྗེ་གཤེད་དང་བེ་ཅོན་གཤིན་རྗེ་གཤེད་དང་པདྨ་གཤིན་རྗེ་གཤེད་དང་རལ་གྲི་གཤིན་རྗེ་གཤེད་བཅས་བཞི་བཤད། ལྷ་ཚོགས་འདི་རྣམས་ཀྱི་ས་བོན་གྱི་ཡི་གེ་དང་སྔགས་ཀྱི་རིམ་པ་ཡང་རྒྱས་པར་བཤད་ཡོད།",
        "བོད་མཐོ་སྒང་དུ་མིའི་རིགས་བྱུང་རབས་ཀྱི་ལོ་རྒྱུས་ནི་ཉེ་བའི་ལོ་ཤས་ནང་བསང་ཆུ་རྫོང་གི་བྲག་དཀར་བྲག་ཕུག་ (Baishiya Karst Cave) ནས་གསར་རྙེད་བྱུང་བའི་དཔང་རྟགས་ཁག་ལ་བརྟེན་ནས་གཞི་རྩའི་འགྱུར་ལྡོག་ཆེན་པོ་ཕྱིན་ཡོད། སྔོན་ཆད་བོད་མཐོ་སྒང་དུ་དེང་རབས་མིའི་རིགས་ (Homo sapiens) ལོ་ངོ་ ༣,༦༠༠ ནས་ ༥,༠༠༠ ཙམ་གྱི་སྔོན་ལ་མ་གཏོགས་སླེབས་མེད་པར་འདོད་ཀྱང་། ཌེ་ནི་སོ་ཝན་མིའི་རིགས་ནི་ལོ་ངོ་ ༡༦༠,༠༠༠ ལྷག་གི་སྔོན་ནས་བོད་མཐོ་སྒང་དུ་གཏན་སྡོད་བྱས་ཡོད་པ་ར་སྤྲོད་བྱུང་ཡོད།",
        "གཤིན་རྗེ་གཤེད་ནག་པོ་ནི་འཇམ་དཔལ་གྱི་ཁྲོ་བོའི་སྐུར་གྲགས་ཤིང་། འཆི་བདག་གཤིན་རྗེ་འདུལ་བའི་སྟོབས་ལྡན་པའི་ཡི་དམ་ལྷ་ཡིན། གཞུང་འདིས་དཀྱིལ་འཁོར་གྱི་གཙོ་བོ་དང་འཁོར་གྱི་ལྷ་ཚོགས་རྣམས་ཀྱི་སྐུ་གཟུགས་དང་མཚན་མ། ཡེ་ཤེས་དང་ཐབས་ཀྱི་ཆོས་དོན་བཅས་ལ་རྒྱས་པར་བཤད་དོ། །",
        "«དཔལ་རྡོ་རྗེ་འཇིགས་བྱེད་སྒྲུབ་པའི་ཐབས་དང་ལས་བྱ་བའི་ཆོ་ག་སེམས་དཔའ་བསྡུས་པ།» ཞེས་པ་ནི་སློབ་དཔོན་ཨཱ་ཙཱརྱ་དོན་ཡོད་རྡོ་རྗེས་མཛད་པའི་རྡོ་རྗེ་འཇིགས་བྱེད་ཀྱི་སྒྲུབ་ཐབས་དང་ལས་ཀྱི་ཆོ་ག་རྒྱས་པར་བཀོད་པའི་རྒྱུད་སྡེའི་བསྟན་བཅོས་ཤིག་ཡིན། གཞུང་འདིའི་ནང་དུ་རྡོ་རྗེ་འཇིགས་བྱེད་ཆེན་པོའི་བསྒོམ་བཟླས་ཀྱི་རིམ་པ་དང་། དཀྱིལ་འཁོར་གྱི་བཀོད་པ། འཁོར་ལོའི་ལྷ་ཚོགས། ལས་བཞིའི་སྦྱིན་སྲེག་དང་དྲག་པོའི་ལས་ཀྱི་ཆོ་ག་སོགས་ཚང་བར་བཀོད་ཡོད། གཞུང་འདི་རྒྱ་གར་གྱི་མཁན་པོ་མཉྫུ་ཤྲཱི་ཛྙཱ་ན་དང་བོད་ཀྱི་ལོ་ཙཱ་བ་རོང་ཟོམ་ཆོས་ཀྱི་བཟང་པོས་བསྒྱུར་ཞིང་། ཕྱིས་སུ་ཕྱུག་མཚམས་དབང་ཕྱུག་རྒྱལ་པོས་བསྒྱུར་ཞིབ་གནང་བའོ། །",
        "བར་ཆད་ཞི་བ། བསྟན་པ་འཛིན་པའི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་སྐུ་ཚེ་བརྟན་པ་དང་། བསྟན་པ་ལ་འཚེ་བའི་ཕྱི་ནང་གི་བར་ཆད་མཐའ་དག་ཞི་བའི་སྨོན་ལམ་བཏབ་ཡོད།",
        "སྒྲོལ་མ་བྱུང་བའི་ལོ་རྒྱུས་ལ་ཡོངས་གྲགས་སུ་བསྐལ་པ་སྔོན་གྱི་སྨོན་ལམ་དང་། སྤྱན་རས་གཟིགས་ཀྱི་སྤྱན་ཆབ་ལས་འཁྲུངས་པའི་གཏམ་རྒྱུད་གཉིས་ཡོད།",
        "དགེ་འདུན་དཀོན་མཆོག། འདི་ནི་ལམ་སྒྲུབ་པའི་གྲོགས་ཡིན། འདི་ལ་སྤྱིར་དགེ་འདུན་བཞི་སྡེ་ཡན་ཆད་དང་། བྱེ་བྲག་ཏུ་དོན་དམ་པའི་གནས་ལུགས་སྟོང་པ་ཉིད་མངོན་སུམ་དུ་རྟོགས་པའི་འཕགས་པའི་དགེ་འདུན་ལ་གོ། དགེ་འདུན་ནི་ནད་པ་ལ་སྨན་སྟེར་ཞིང་བདག་སྐྱོང་བྱེད་པའི་ནད་གཡོག་ལྟ་བུ་ཡིན།",
        "གསུང་སྐྱེས་ཞེས་པའི་སྒྲ་བཤད་ལ། གསུང་ཞེས་པ་ནི་ཐུབ་པའི་དབང་པོ་སངས་རྒྱས་ཀྱི་གསུང་རབ་ལ་གོ སྐྱེས་ཞེས་པ་ནི་དེའི་མཐུ་དང་དབང་གིས་འཁྲུངས་ཤིང་སྐྱེས་པ་ལ་གོ་ས་ཡིན་ཏེ། སྤྱིར་བཏང་ལས་སྐྱེས་ཤིང་རིགས་ལས་འཁྲུངས་པར་འཚལ་བ་ལ་སྐྱེས་ཞེས་ཐ་སྙད་གདགས་པའི་ཚུལ་བཞིན་ནོ། །གང་ཞིག་གི་གསུང་ལས་སྐྱེས་ན་དེའི་གསུང་སྐྱེས་སུ་འདོགས་པར་བྱེད་པའི་རྗེས་དཔག་ཚིག་ལས་བྱུང་བའི་སྡོམ་མིང་ཞིག་ཡིན་ནོ། །",
        "མདོ་ལུགས་ཀྱི་ཕྱག་ཆེན། ནི་«ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པའི་མདོ»དང་«ཏིང་ངེ་འཛིན་རྒྱལ་པོའི་མདོ»སོགས་ལ་ཁུངས་བཏུགས་ཏེ། སེམས་ཀྱི་གནས་ལུགས་སྟོང་པ་ཉིད་རིགས་པས་དཔྱད་ནས་གཏན་ལ་ཕབ་སྟེ་ཞི་ལྷག་གི་རྣལ་འབྱོར་ལ་བརྟེན་ནས་རིམ་གྱིས་སྒོམ་པའི་ལམ་སྲོལ་ཡིན།"
    ]
}
