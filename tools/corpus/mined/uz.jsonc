    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Montevideo subtropikada joylashgan; yoz oylarida harorat +30°C dan yuqori bo'lishi odatiy hol." },
        { "cell": "digit-run", "text": "Portugaliyaliklar uni vayron qillib, Kasa Branka nomi ostida qayta qurishdi, 1755-yildagi zilziladan keyingina uni tark etishdi." },
        { "cell": "digit-run", "text": "Dahshatga tushgan qirol Lyudovik XVI, qirolicha Mari Antuanetta, ularning ikki nafar yosh farzandi (11 yoshli Mari Tereza hamda to'rt yoshli Lui-Charlz) hamda qirolning singlisi, Yelizaveta xonim, 1789-yilning 6-oktyabrida bozorchi ayollar olomoni tomonidan Versaldan Parijga majburan qaytarilgan." },
        { "cell": "digit-run", "text": "Misol uchun, \"ta'lim\" va \"ijtimoiylashuv\" internetdan foydalanish uchun muhim motivatsiyalar sifatida taklif qilinadi (Jeyms va boshqalar, 1995)." },
        { "cell": "digit-run", "text": "Yaponiya (eng kattasi Xonshu bo'lgan) qariyb 7000 orolga ega, bu Yaponiyani dunyoning 7-eng yirik oroliga aylantiradi!" },
        { "cell": "digit-run", "text": "NSA xodimi sifatida u Karterga 1978-yildagi Kemp-Devid shartnomasi; 1970-yillarning oxirlarida AQSH-Xitoy aloqalarini normallashtirish; 1979-yilda Eron garovi inqiroziga sabab bo'lgan Eron inqilobi; va 1979-yildagi Sovet Ittifoqining Afg'onistondagi bosqini kabi xalqaro masalalarni diplomatik tarzda hal qilishda yordam berdi." },
        { "cell": "fractions", "text": "Uni kim yozganini hech kim aniq bilmasa-da, o'z hayotining boshida, katta pergament hujjat (uning o'lchami 29¾ duymga 24½ duym) saqlash uchun o'rab qo'yilgan." },
        { "cell": "fractions", "text": "Namuna yetarli darajada — 5 mm (1/5 duym) yoki undan ko'proq chuqur bo'lishi va material sovuq haroratlarda yetarlicha yumshoq bo'lishi kerak." },
        { "cell": "clock", "text": "Soat 10:00–11:00 (TK) MDT orasida hovlidagi mahbuslar yong'in keltirib chiqardi." },
        { "cell": "clock", "text": "Yong'indan qutqaruv guruhlari va nihoyat, tungi soat 11:35 da olovni o'chirishdi." },
        { "cell": "clock", "text": "Avtobuslar kun davomida (daryoning narigi tomonidagi) tumanlararo avtobus bekatidan jo'naydi, biroq aksariyati, ayniqsa, sharqqa va Jakar/Bumtangga borayotganlari 06:30 va 07:30 orasida yo'lga chiqadi." },
        { "cell": "clock", "text": "802.11n standarti 2,4 Gs va 5,0 Gs chastotalarining ikkalasida ham ishlaydi." },
        { "cell": "clock", "text": "Avtoulovning o'zi o'sha kuni hodisa joyidan taxminan soat 12:00 GMT da olib ketilgan." },
        { "cell": "signs", "text": "Shuningdek, u ko'p davlatlar uchun kupyuralar yaratish bilan shug'ullangan, Kanadaning yangi 5$ va 100$ lik kupyuralari old tomonidagi bosh vazir suratlari uning so'nggi ishlaridan namunalar sirasiga kiradi." },
        { "cell": "signs", "text": "Nadal birinchi uzatmada 76 ochko to'plagan holda musobaqada 88% sof ochkoni qo'lga kiritdi." },
        { "cell": "signs", "text": "Ular Yevropa Ittifoqi tomonidan Eron iqtisodiyoti 80% tashqi daromadini oladigan ishlov berilmagan neft eksportiga moliyaviy cheklovlar va taqiqlarni o'z ichiga oladi." },
        { "cell": "signs", "text": "Norozilik namoyishi mahalliy vaqt bilan taxminan 11:00 da (UTC+1) Bosh vazirning rasmiy qarorgohi – politsiya qo'riqlaydigan Dauning-stritga kirish ro'parasidagi Uaytxollda boshlandi." },
        { "cell": "signs", "text": "Dengiz osti optik tolali kabel orqali Yevropaga hamda keng polosali sputnikka ulanish sababli Grenlandiyaning internetga ulanganlik darajasi yaxshi – aholining 93%i ulangan." },
        { "cell": "dotted", "text": "Baba Shyamga 108 likop Chappan Bog (hinduizmda 56 turdagi yeguliklar, masalan, tangriga taklif etiluvchi shirinliklar, mevalar, yong'oqlar, ovqatlar va h.k.) berildi." },
        { "cell": "dotted", "text": "Efesdagi Artemida ibodatxonasi m.a. 356-yil 21-iyulda Gerostratning qasddan o't qo'yishi oqibatida vayron qilingan." },
        { "cell": "dotted", "text": "Zamonaviy Kasablanka shahriga m.a. 10-asrda Barbar baliqchilari tomonidan asos solingan hamda undan finikiyaliklar, rimliklar va merenidlar Anfa deb nomlangan strategik port sifatida foydalanganlar." },
        { "cell": "dotted", "text": "Chang'ichilik g'oyasi nihoyatda qadimiy — chang'ichilarni tasvirlovchi g'or suratlari m.a. 5000-yillarga borib taqaladi!" },
        { "cell": "dotted", "text": "Aleksandr shoh sifatida ibodatxonani qayta qurish uchun pul to'lashni taklif qildi, biroq uning taklifi rad etildi. Keyinchalik, Aleksandr vafotidan so'ng, m.a.323-yilda ibodatxona qayta barpo qilindi." },
        { "cell": "year", "text": "Uning 1000-markasi 2000-yilda David Klyoker Erenstrahl tomonidan yaratilgan, Dunyo rekordlari Ginnes kitobiga kiritilgan ulug'vor \"Shved shohlariningbuyuk ishlari\" bo'lgan edi." },
        { "cell": "year", "text": "Shimoliy qismda yoki Sentinel tizmasida 4892 metrli Vinson cho'qqisiga ega Antarktidaning eng baland tog'lari bo'lgan Vinson Massivi joylashgan." },
        { "cell": "year", "text": "2010-yilgi federal saylovga qadar o'tkazilgan so'rovnomalarda qatnashgan 1400 kishidan Avstraliyaning respublika bo'lishiga qarshi chiqqanlar soni 2008-yildan beri 8 foizga oshdi." },
        { "cell": "year", "text": "Vaqti kelib, yog'och g'ildiraklarning o'rnini temir g'ildiraklar egalladi. 1767-yilda dastlabki to'liq temir relslar ishlab chiqarildi." },
        { "cell": "year", "text": "Bloglardan to'g'ri foydalanish \"talabalarga yaxshiroq tahliliy va tanqidiy fikrlaydigan bo'lish imkonini beradi; Internet materiallarga faol javob berish orqali talabalar boshqalarning yozuvlari kontekstida o'z pozitsiyasini belgilashi, shuningdek, muayyan masalalar bo'yicha o'z nuqtayi nazarlarini bayon qilishi mumkin\". (Oravek, 2002)" },
        { "cell": "decimals", "text": "Sunami to'g'risida hech qanday ogohlantirish berilmagan hamda Jakarta geofizika agentligiga ko'ra, 6,5 ballik talabga mos kelmaganligi sababli sunami to'g'risida ogohlantirish berilmaydi." },
        { "cell": "decimals", "text": "Agar tayanch stansiyada qo'sh radio bo'lsa, bu uning 802.11a, 802.11b va 802.11g bilan orqaga qarab mos kelishiga imkon beradi." },
        { "cell": "decimals", "text": "Har yili oktyabr atrofida qariyb 1,5 million o'txo'r hayvonlar yomg'ir uchun shimoliy tepaliklardan Mara daryosini kechib o'tib, janubiy tekisliklar tomon safar qiladi." },
        { "cell": "decimals", "text": "Oaxudagi yo'lakda 6,34 duymga yetgan yog'ingarchilik miqdori \"foydali\" deb tavsiflandi." },
        { "cell": "decimals", "text": "U Quyosh atrofida aylanayotgan sayyoralar singari Borning soddalashtirilgan modeliga asosan elektron orbitasi bo'ylab harakatlanayongan markaziy yadrodan tashkil topgan juda murakkab obyektdir — 1.1-rasmga qarang." },
        { "cell": "units", "text": "Bog' 19 500 km² maydonni qamrab olgan hamda har biri turlicha yovvoyi tabiatni qo'llab-quvvatlovchi 14 ta ekohududga bo'lingan." },
        { "cell": "units", "text": "Qobiqning qalinligi Oyning Yerdan ko'rinadigan tomonida 70 km, orqa tomonida esa 100 km." },
        { "cell": "units", "text": "Sandarban sohildan Bangladesh va Hindistonning ichki qismigacha 80 km (50 mil) cho'zilgan dunyodagi eng yirik qirg'oq bo'yi mangrov kamardir." },
        { "cell": "units", "text": "Arxipelag yarim oroldan 120 km shimolda joylashgan. Eng yirigi Villa Las Estrellas aholi punkti joylashgan King George orolidir." },
        { "cell": "units", "text": "Masalan, dunyodagi eng keng suratga olish formati 35 mm bo'lib, bu analog fotoplyonkalar davri yakunida ustun bo'lgan fotoplyonka o'lchami bo'lgan." },
        { "cell": "ranges", "text": "Uyqu uzilishi — bu sizning odatdagi uyqu vaqtingizdan atay uyg'onish va qisqa vaqtdan keyin (10–60 daqiqa) uyquga ketish jarayonidir." },
        { "cell": "ranges", "text": "Ikkinchi setda Del Potro dastlabki ustunlikka ega edi, biroq hisob 6–6 ga yetgandan keyin tay-brek talab etdi." },
        { "cell": "ranges", "text": "Voqealar sodir bo'lgan vaqt umumiy holda Yuqori o'rta asrlar deb ataluvchi Yevropa tarixidagi 11, 12 va 13-asrlardir (m. 1000–1300 yillar)." },
        { "cell": "ranges", "text": "Mazkur dinga Guru Nanak (1469–1539) tomonidan 15-asrda asos solingan. So'ngra to'qqiz nafar guru ketma-ket ergashdi." },
        { "cell": "ranges", "text": "Nadalning kanadalikka qarshi birga-bir rekordi 7–2." },
        { "cell": "currency", "text": "Tadbir chiptalarining aksariyati 2500 ¥ va 130 000 ¥ oralig'ida, odatiy chiptalar narxi 7000 ¥ atrofida bo'lishi kutilyapti." },
        { "cell": "abbrev", "text": "Aslini olganda, Tibet buddizmi juda jo'n. U Kundalini yoga, meditatsiya va barcha narsani qamrovchi muhabbat yo'lidan iborat." },
        { "cell": "abbrev", "text": "Meksikalik Arli Velaskes erkaklar o'rtasidagi Super-G bellashuvida o'n beshinchi pog'onadan joy oldi. Erkaklar o'rtasidagi Super-G bellashuvini Yangi Zelandiyalik Adam Hall to'qqizinchi pog'onada yakunladi." },
        { "cell": "abbrev", "text": "Endilikda ilm-fan shuni ko'rsatib turibdiki, mazkur yirik uglerod iqtisodi biosferani o'zining oxirgi 2 mln. Yildan beri inson evolyutsiyasini qo'llab kelgan barqaror holatlarining biridan mahrum qilgan." },
        { "cell": "abbrev", "text": "Oklend ikkita portni aylanib o'tgani sababli ko'p sonli plyajlarga ega. Eng mashhurlari uchta hududda joylashgan." },
        { "cell": "abbrev", "text": "Iltimos, bu joyga u loyiq bo'lgan sharaf, jiddiylik va hurmat bilan munosabatda bo'ling. Xolokast yoki fashistlar haqida hazil qilmang." },
        { "cell": "latin-in-native", "text": "Vakillar palatasining sobiq spikeri Nyut Gingrich, Texas gubernatori Rik Perri hamda kongressmen Mishel Baxman mos ravishda to'rtinchi, beshinchi va oltinchi o'rinlarni egalladi." },
        { "cell": "latin-in-native", "text": "U WiFi eshik qo'ng'irog'ini yasadi, dedi u." },
        { "cell": "latin-in-native", "text": "Kruger Milliy parki (KMP) Janubiy Afrikaning shimoliy-sharqida joylashgan va sharqda Mozambik, shimolda Zimbabve bilan chegara chegaradosh, janubiy chegarasi esa Timsoh daryosidir." },
        { "cell": "latin-in-native", "text": "Ko'pchilik hollarda xorijdagi yillik kurslarga kirish mamlakatingizdagi oliy o'quv yurtlariga kirish imkoniyatlaringizni haqiqatda yaxshilashi mumkin." },
        { "cell": "latin-in-native", "text": "Tungi ko'rish qobiliyati yordamida ular qorong'ida juda yaxshi ko'ra oladi, ham tovush chiqarmasdan harakatlanadi. Oselotlar o'z o'ljasini ovlayotganda atrof-muhitga uygʻunlashadi, keyin esa o'z o'ljasini quvlab qo'lga kiritadi tushiradi." },
        { "cell": "percent", "text": "Turkiyaning Yevropa qismi (sharqiy Frakiya yoki Bolqon yarim orolidagi Rumeliya deb ham ataladi) mamlakatning 3% hududini qamrab olgan." },
        { "cell": "rate", "text": "Ko'rgazmadan besh daqiqa o'tib, shamol esa boshladi, taxminan bir daqiqadan so'ng, shamolning tezligi 70 km/s ga yetadi… undan keyin yomg'ir yog'ishni boshladi, shunaqangi qattiq va shiddatli yog'adiki, tanaga ignadek sanchiladi, shundan keyin osmondan do'l yog'iladi, odamlar vahimaga tushgan va qichqirib, bir-birining ustiga yugura boshladi." },
        { "cell": "rate", "text": "To'fon Xitoy tarafga taxminan 11 km/soat tezlikda harakatlanmoqda." },
        { "cell": "rate", "text": "\"Black Beauty\" avtomobilining past ekanligi tufayli Yangi Zelandiya politsiyasi janob Ridning qanchalik tez yurganligini aniqlash uchun o'zining tezlikni aniqlash radaridan foydalanishda muammoga duch keldi va politsiya faqat bir marta janob Rid tezlikni 160 km/soatga pasaytirganida uni qayd etishga muvaffaq bo'ldi." },
        { "cell": "rate", "text": "Bu dahshatli bo'ronlarda shamolning tezligi 480 km/soatgacha (133 m/s; 300 milya/soat) yetadi." },
        { "cell": "rate", "text": "Floridadagi Mayami shahridan taxminan 3000 mil uzoqlikdagi bo'ronning maksimal barqaror tezligi 40 mil/soat (64 km/s) ga teng." },
        { "cell": "roman", "text": "Mau harakati tomonidan tashkillashtirilgan mustaqillik uchun kurash vaqtida shahardagi tinch namoyish oliy yo'lboshchi Tupua Tamasese Lealofi III ning o'ldirilishiga olib keldi." },
        { "cell": "roman", "text": "Biroq birinchi haqiqiy teleskoplar Yevropada XVI asrning oxirlarida yaratildi." },
        { "cell": "roman", "text": "Vaqtincha Bosh vazir vazifasini bajarayotgan Juliya Gillard 2010-yilgi federal saylovlar kampaniyasi chog'ida Qirolicha Yelizaveta II hukmronligidan keyin Avstraliya respublika bo'lishi kerak, deb hisoblashini aytdi." },
        { "cell": "roman", "text": "7-oktabr havoga ko'tarilish vaqtida dvigatel ajralib ketdi, jarohatlar kuzatilmadi. Rossiya mazkur voqeadan so'ng II-76 samolyotlari parvozini qisqa muddatga taqiqlab qo'ydi." },
        { "cell": "roman", "text": "So'rovnomada ishtirok etganlarning 34 foizi qirolicha Yelizaveta II ning Avstraliyaning oxirgi monarxi bo'lishini xohlagan holda shu fikrni bildirgan." },
        { "cell": "initialism", "text": "NHK, shuningdek, Niigata prefekturasidagi Kashivazaki Kariva atom elektrostansiyasi odatdagi tarzda ishlayotganini xabar qildi." },
        { "cell": "initialism", "text": "Butun Amerika Qo'shma Shtatlari bo'ylab taxminan 400 000 ta parishonxotirlik sklerozi (MS) holatlari ma'lum bo'lib, bu yoshroq va o'rta yoshdagi kattalar orasida yetakchi nevrologik kasallik bo'lib qolmoqda." },
        { "cell": "initialism", "text": "Isroil shartnoma imzolanganidan keyin vodiyda o'n yil davomida harbiy qismlarini muntazam saqlab qolishni talab qilmoqda, PA esa bunday harbiy qismlarni faqat besh yil davomida qoldirishga rozi." },
        { "cell": "initialism", "text": "AI bo'yicha tadqiqotlar aqlli xatti-harakatlar talab etiluvchi vazifalarni avtomatlashtirish uchun mashinalar yaratishdan iborat." },
        { "cell": "initialism", "text": "AQSH imperalizmining Filippinni bosib olishdagi urush harajatlari Filippinliklarning o'zlari tomonidan to'langan." },
        { "cell": "grouped", "text": "1966-yildan beri Sandarban yovvoyi tabiat qo'riqxonasi bo'lib kelmoqda hamda mazkur hududda hozirda 400 ta qirollik Bengal yo'lbarslari va qariyb 30 000 tog' kiyiklari borligi taxmin qilinadi." },
        { "cell": "grouped", "text": "Lekin Sovet Ittifoqi qizil armiyasining 800 000 dan ortiq askarlari Riga tinchlik shartnomasi, Tajovuz qilmaslik to'g'risidagi Sovet-Polsha pakti hamda boshqa ikki tomonlama va ko'p tomonlama shartnomalarni buzgan holda Polshaning sharqiy hududlarini bosib olgandan so'ng Belorussiya va Ukrainaga kirishi hamda frontlar yaratganida mazkur rejalar deyarli bir kechaga eskirgandi." },
        { "cell": "grouped", "text": "Ammo sil kasalligi bilan xastalangan odamlarning butun guruhida XDR-TB ulushi hali ham past ko'rinadi; Janubiy Afrikada istalgan muayyan lahzada jami 330 000 kishidan 6000 nafari kasallangan." },
        { "cell": "grouped", "text": "Apia Samoaning poytaxtidir. Shahar Upolu orolida va 40 000 nafardan kamroq aholiga ega." },
        { "cell": "grouped", "text": "104 500 barell sig'imga ega baklar pastidagi boshqa ikkilamchi saqlash hududi hali sig'imiga qadar to'lmagan." },
        { "cell": "letter-name", "text": "U ayollar va erkaklarni kontrasepsiya vositalarini tibbiy ehtiyoj deb hisoblashga undovchi ko'pgina ijobiy fikrlar va rag'bat sababli shunday xulosa chiqargan." },
        { "cell": "letter-name", "text": "U eski radiolokatsiya texnologiyalaridan farqli ravishda, sputnikka asoslangan texnologiyadan foydalanib, havo harakati nazoratchilariga samolyotlarni yanada yaxshiroq aniqlash hamda uchuvchilarga yanada aniqroq ma'lumot berish imkonini taqdim qiladi." },
        { "cell": "letter-name", "text": "Polshalik ko'zi ojiz chang'ichi Masiey Krezel hamda yetaklovchi Anna Ogarzinska Super-G musobaqasini o'n uchinchi o'rinda yakunladi. Janubiy Koreyalik Jong Seork Park erkaklar o'rtasidagi Super-G musobaqasida yigirma to'rtinchi o'rindan joy oldi." },
        { "cell": "letter-name", "text": "Shuningdek, u suvga tushgan har qanday narsaga hamla qilgan; hattoki T. rex kabi bahaybat dinozavrlar ham unga bas kela olmagan." },
        { "cell": "letter-name", "text": "U dastlab Greyt-Yarmutdagi Jeyms Paget shifoxonasiga yotqizildi." },
        { "cell": "exponent", "text": "Bu 35 mm salbiy o'lcham (3136 mm² ga 864) dan ko'ra qariyb to'rt baravar yuqori o'lchamni beradi." },
        { "cell": "exponent", "text": "Sundarban taxminan uchdan bir qismi suv/botqoq hududlar bilan qoplangan 3850 km² maydonni qamrab olgan." },
        { "cell": "ampersand", "text": "Alal-oqibat, B&B lar asosan ikki asosiy narsa: yotoq va nonushta orqali raqobatlasha oladi." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Vakillar palatasining sobiq spikeri Nyut Gingrich, Texas gubernatori Rik Perri hamda kongressmen Mishel Baxman mos ravishda to'rtinchi, beshinchi va oltinchi o'rinlarni egalladi.",
        "Dekabr oyida Las-Kanitasdagi polo stadionlarida yilning eng katta musobaqasi o'tkaziladi.",
        "Doktor Mollning fikriga ko'ra, bir nechta bemorlar shifoxonada kasallikni yuqtirgan bo'lishlari mumkin va eng kamida ulardan ikkitasi shifoxonadagi sog'liqni saqlash xodimlari bo'lgan.",
        "Uning keng qamrovli qudrati shohdan tortib, oddiy insongacha ta'sir qildi.",
        "1940-yilning 15-avgustida Ittifoqchilar Janubiy Fransiyaga bostirib kirdi, bu bosqin \"Ajdar operatsiyasi\" deb atalgan.",
        "Rolando Mendoza M16 avtomatida sayohatchilarni o'qqa tutdi.",
        "Olimlar qora materiya boshqa qora materiyaga xuddi odatiy materiya ta'sir qilgani kabi ta'sir ko'rsatadi, degan xulosaga kelishdi.",
        "Finlandiya qayiqda suzishga borish uchun eng yaxshi manzil. \"Ming ko'l mamlakati\"ning ko'llarida va qirg'oqdagi arxipelaglarida ham minglab orollar bor.",
        "An'anaviyroq cherkovlar tez-tez Masihning qayta tirilishini nishonlashni buzish uchun yarim tunda jamoat bilan Pasxaning dam olish kunlari davomida shanba oqshomida Pasxa hushyorligini o'tkazadilar.",
        "Doim sayyohlar va savdogarlarning ovozini eshitishingiz odatiy hol. Ovoz va yorug'lik hikoyasi xuddi asarga o'xshaydi.",
