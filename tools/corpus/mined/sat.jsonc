    "hard": [
        { "cell": "degrees", "text": "ᱢᱟᱫᱽᱨᱤᱫᱽ ᱴᱚᱴᱷᱟ ᱫᱚ ᱱᱟᱥᱮ ᱨᱚᱦᱚᱲ ᱦᱚᱭᱦᱤᱥᱤᱫ ᱠᱟᱱᱟ ᱾ ᱦᱮᱢᱟᱞ ᱟᱨ ᱱᱤᱨᱚᱱ ᱨᱤᱛᱩ ᱨᱮ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱫᱟᱜ ᱧᱩᱨᱩᱜ-ᱟ ᱾ ᱨᱟᱵᱟᱝ ᱨᱤᱛᱩ ᱨᱮ ᱫᱚ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱜᱮ ᱨᱟᱵᱟᱝ ᱵᱩᱡᱷᱟᱹᱶᱜᱼᱟ, ᱪᱮᱫᱟᱜᱥᱮ ᱱᱚᱶᱟ ᱫᱚ ᱟᱹᱰᱤ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ ᱢᱤᱢᱤᱫ ᱫᱷᱟᱶ ᱫᱚ ᱠᱩᱲᱦᱟᱹ ᱟᱹᱰᱤ ᱧᱩᱨᱩᱜᱼᱟ ᱾ ᱥᱤᱛᱩᱝ ᱨᱤᱛᱩ ᱨᱮ ᱫᱚ ᱞᱚᱞᱚ ᱵᱩᱡᱷᱟᱹᱜᱼᱟ ᱾ ᱢᱤᱢᱤᱫ ᱫᱷᱟᱶ ᱞᱚᱞᱚᱥᱚᱝ ᱫᱚ ᱓᱐ °C ᱠᱷᱚᱱ ᱔᱐ °C ᱜᱟᱱ ᱥᱮᱴᱮᱨᱚᱜᱼᱟ ᱡᱩᱞᱟᱭ ᱪᱟᱸᱫᱚᱨᱮ ᱾ ᱧᱤᱫᱟᱹ ᱵᱮᱲᱟᱻᱫᱚ ᱟᱥᱮ ᱨᱮᱭᱟᱲ ᱧᱚᱜᱼᱟ ᱾" },
        { "cell": "degrees", "text": "ᱭᱩᱠᱨᱮᱱ ᱫᱚ ᱨᱟᱥᱤᱭᱟ ᱛᱟᱭᱚᱢ ᱭᱩᱨᱳᱯ ᱨᱮᱱᱟᱜ ᱫᱚᱥᱟᱨ ᱢᱟᱨᱟᱝ ᱫᱤᱥᱚᱢ]] ᱠᱟᱱᱟ, ᱟᱨ ᱜᱚᱴᱟ ᱯᱩᱨᱟᱹ ᱤᱣᱨᱳᱯ ᱨᱮ ᱢᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱔᱔° ᱟᱨ ᱕᱓° ᱠᱚᱧᱮ ᱚᱠᱷᱟᱝᱥᱚ ᱟᱨ ᱒᱒° ᱟᱨ ᱔᱑° ᱥᱟᱢᱟᱝ ᱫᱽᱨᱟᱜᱷᱤᱢᱟ ᱢᱩᱫᱽ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ, ᱱᱚᱣᱟ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱠᱟᱭᱛᱮ ᱥᱟᱢᱟᱝ ᱤᱣᱨᱳᱯ ᱨᱮᱱᱟᱜ ᱴᱟᱹᱱᱰᱤ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱭᱩᱠᱨᱮᱱ ᱛᱮ ᱯᱟᱥᱱᱟᱣ ᱟᱠᱟᱱᱟ, ᱟᱨ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱫᱚᱨᱭᱟ ᱫᱷᱟᱨᱮ ᱫᱚ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "degrees", "text": "ᱨᱟᱡᱽᱜᱟᱲ : ᱱᱟᱶᱟ ᱫᱤᱞᱞᱤ 77°12.5′E / 28.6133°N 77.2083°E" },
        { "cell": "degrees", "text": "ᱵᱟᱹᱲᱛᱤ ᱠᱟᱛᱮ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱱᱟᱜᱟᱨ ᱠᱚ ᱫᱚ ᱥᱤᱛᱩᱝ ᱟᱱ ᱜᱮᱭᱟ ᱾ ᱯᱟᱴᱱᱟ ᱨᱮᱱᱟᱜ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ ᱜᱚᱴᱟᱜᱩᱴᱤ ᱞᱚᱞᱥᱚᱝ ᱓᱑.᱓°C ᱞᱮᱠᱟ ᱵᱩᱡᱷᱟᱹᱣ ᱟ ᱟᱨ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱠᱚᱢ ᱢᱮᱱ ᱞᱮᱠᱷᱟᱱ ᱑᱙.᱖ o C ᱾ ᱱᱚᱸᱰᱮᱱᱟᱜ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ ᱡᱟᱹᱲᱤ ᱫᱚ ᱑᱒᱑᱓.᱓ mm/inch ᱾" },
        { "cell": "degrees", "text": "ᱥᱚᱠᱛᱚ ᱨᱩᱣᱟ., ᱨᱟᱵᱟᱝ ᱟᱨ ᱛᱷᱟᱨ ᱛᱷᱟᱨᱟᱣ ᱵᱩᱡᱷᱟ.ᱣᱜ ᱠᱷᱟᱱ ᱯᱟ.ᱨᱤ ᱨᱩᱣᱟ. ᱢᱮᱱᱛᱮ ᱵᱟᱰᱟᱭ ᱢᱟ ᱾ ᱨᱩᱣᱟ. ᱥᱟᱶ ᱩᱞᱟ. ᱟᱨ ᱵᱚᱦᱚᱜ ᱦᱚᱸ ᱦᱟ.ᱜᱥᱩᱣᱟ ᱾ ᱱᱚᱣᱟ ᱨᱩᱣᱟ. ᱫᱚ ᱑᱐᱔°F ᱠᱷᱚᱱ ᱑᱐᱕°F ᱫᱷᱟ.ᱵᱤᱡ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱱᱟᱥᱮ ᱜᱷᱟ.ᱲᱤᱠ ᱠᱷᱟᱱ ᱜᱮ ᱦᱚᱲᱢᱚ ᱠᱷᱚᱱ ᱩᱫᱽᱜᱟ.ᱨ ᱫᱟᱜ ᱚᱰᱚᱠᱚᱜ ᱛᱮ ᱨᱩᱣᱟ. ᱠᱚᱢᱚᱜᱼᱟ ᱟᱨ ᱨᱩᱜᱤᱭ ᱵᱮᱥ ᱜᱚᱫᱚᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱨᱩᱣᱟ. ᱫᱚ ᱢᱤᱼᱢᱤᱫ ᱫᱷᱟᱣ ᱵᱚᱦᱚᱜ ᱨᱮᱭ ᱦᱟᱢᱞᱟ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ Cerebral Malaria ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱛᱮᱫᱚ ᱨᱩᱜᱤ ᱜᱚᱡ ᱦᱚᱸᱭ ᱜᱚᱡ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾ ᱜᱷᱟᱱᱮ ᱱᱚᱣᱟ ᱨᱩᱣᱟ. ᱦᱩᱭᱩᱜ ᱠᱷᱟᱱ ᱯᱤᱞᱦᱤ ᱦᱟᱨᱟᱜᱼᱟ ᱟᱨ ᱢᱟᱭᱟᱢ ᱠᱚᱢᱚᱜᱼᱟ ᱾" },
        { "cell": "degrees", "text": "ᱢᱟᱠᱟᱡᱤ ᱢᱮᱜᱷᱯᱟᱨ ᱫᱚ 22.33°N 70.48°E ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱢᱚᱴᱟᱢᱩᱴᱤ ᱮᱞᱤᱵᱷᱮᱥᱚᱱ ᱫᱚ ᱕᱓ ᱢᱤᱴᱚᱨ ᱾ ᱱᱚᱶᱟ ᱟᱹᱛᱩ ᱫᱯ ᱫᱟᱢᱚᱰᱤ ᱜᱟᱰᱟ ᱟᱨ ᱩᱸᱰ ᱜᱟᱱᱰᱟ ᱥᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱟᱹᱛᱩ ᱫᱚ ᱒᱓ᱹ᱔᱔ ᱠᱤᱢᱤ² ᱮᱨᱤᱭᱮ ᱛᱮ ᱟᱴᱮᱫ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱥᱤᱧᱚᱛ ᱯᱚᱱᱚᱛ ᱜᱩᱡᱽᱨᱟᱴ ᱨᱮᱱᱟᱜ ᱥᱚᱩᱨᱟᱥᱴᱨᱚ ᱮᱞᱟᱠᱟ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱢᱮᱜᱷᱯᱟᱨ ᱫᱚ ᱢᱟᱠᱟᱡᱤ ᱢᱮᱜᱷᱯᱟᱨ ᱨᱮᱱᱟᱜ ᱦᱮᱰᱠᱩᱣᱟᱴᱚᱨ ᱠᱟᱱᱟ ᱾" },
        { "cell": "degrees", "text": "ᱱᱚᱶᱟ ᱵᱩᱨᱩ ᱨᱮᱱᱟᱜ ᱞᱚᱞᱚᱥᱚᱝ (Temperature) ᱫᱚ ᱑᱕ ᱠᱷᱚᱱ ᱒᱕ °C ᱜᱟᱱ ᱛᱟᱦᱮᱸᱱᱟ ᱟᱨ ᱚᱸᱰᱮ ᱠᱷᱚᱱ ᱑᱐ ᱟᱬᱜᱚᱱᱟ ᱧᱤᱫᱟᱹ ᱚᱠᱛᱚ ᱾" },
        { "cell": "degrees", "text": "ᱭᱟᱝᱜᱳᱱ ᱨᱮᱱᱟᱜ ᱦᱚᱭᱫᱟᱜ ᱫᱚ ᱱᱟᱥᱮ ᱚᱫᱟ ᱫᱷᱟᱨᱟ ᱜᱮᱭᱟ ᱾ ᱱᱚᱸᱰᱮ ᱡᱟᱹᱯᱩᱫ ᱚᱠᱛᱚ ᱫᱚ ᱱᱟᱥᱮ ᱡᱤᱞᱤᱧ ᱜᱮᱭᱟ, ᱢᱮᱱᱫᱚ ᱢᱮ ᱪᱟᱸᱫᱚ ᱠᱷᱚᱱ ᱚᱠᱴᱚᱵᱚᱨ ᱦᱟᱹᱵᱤᱡ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱠᱷᱚᱱ ᱮᱯᱨᱤᱞ ᱦᱟᱹᱵᱤᱡ ᱫᱚ ᱦᱚᱭᱦᱤᱥᱤᱫ ᱥᱟᱹᱠᱷᱤᱫ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱟᱨ ᱟᱹᱰᱤ ᱠᱚᱢ ᱜᱮ ᱫᱟᱜ ᱫᱚᱭ ᱡᱟᱹᱲᱤᱭᱟ ᱾ ᱱᱚᱸᱰᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱵᱟᱹᱛᱤ ᱞᱚᱞᱚᱥᱚᱝ ᱒᱙° ᱠᱷᱚᱱ ᱓᱖° ᱥᱮᱞᱥᱤᱭᱚᱥ ᱟᱨ ᱟᱹᱰᱤ ᱠᱚᱢ ᱨᱮ ᱑᱘° ᱠᱷᱚᱱ ᱒᱕° ᱥᱮᱞᱥᱤᱭᱚᱱ ᱦᱟᱹᱵᱤᱡ ᱛᱟᱦᱮᱸᱱᱟ ᱾" },
        { "cell": "digit-run", "text": "᱐ ᱨᱮᱭᱟᱜ ᱟᱯᱱᱟᱨ ᱫᱟᱲᱮ ᱫᱚ ᱵᱟᱹᱱᱩᱜ ᱟᱱᱟ ᱤᱠᱷᱟᱹᱱ ᱮᱴᱟᱜ ᱮᱞ ᱥᱟᱶ ᱛᱮᱫᱚ ᱟᱹᱰᱤ ᱫᱟᱲᱮᱭᱟᱱ ᱜᱮᱭᱟ ᱾ ᱡᱮᱢᱚᱱ ᱢᱤᱫ ᱴᱟᱝ ᱮᱞ ᱥᱚᱝ ᱚᱲᱟᱜ ᱨᱮᱫᱚ ᱐ ᱥᱩᱢᱟᱹᱫ ᱫᱟᱲᱮ ᱫᱚ ᱪᱮᱫ ᱦᱚᱸ ᱵᱟᱹᱱᱩᱜ ᱟᱹᱱᱤᱡ, ᱤᱠᱷᱟᱹᱱ ᱜᱮᱞ ᱥᱚᱝ ᱚᱲᱟᱜ ᱨᱮ ᱑ ᱮᱢ ᱫᱚᱲᱚᱢ ᱮ ᱠᱷᱟᱱ ᱑᱐ (ᱜᱮᱞ) ᱦᱩᱭ ᱮᱱᱟ ᱾ ᱚᱱᱠᱟ ᱜᱮ ᱒᱐, ᱓᱐, ᱕᱐, ᱑᱐᱐, ᱑᱐᱐᱐, ᱑᱐᱐᱐᱐ … ᱮᱢᱟᱱ ᱠᱚ ᱾" },
        { "cell": "digit-run", "text": "᱑᱘᱘᱕- ᱥᱤᱥᱤᱵᱷᱩᱥᱚᱬ ᱨᱚᱛᱷᱚ, ᱯᱩᱭᱞᱩ ᱳᱰᱤᱭᱟ ᱫᱤᱱᱟᱹᱢ ᱠᱷᱚᱵᱚᱨ ᱠᱟᱜᱚᱡᱽ ᱫᱤᱱᱟᱹᱢ ᱟᱥᱟ ᱨᱮᱱᱤᱡ ᱥᱟᱯᱲᱮᱛ (ᱜᱩᱨ: ᱑᱙ ᱢᱟᱨᱪ ᱑᱙᱔᱓)" },
        { "cell": "digit-run", "text": "᱑᱘᱖᱙ᱼ ᱢᱚᱦᱟᱛᱢᱟ ᱜᱟᱱᱫᱷᱤ, ᱵᱷᱟᱨᱚᱛ ᱨᱮᱱᱤᱡ ᱯᱷᱩᱨᱜᱟᱹᱞ ᱞᱟᱹᱲᱦᱟᱹᱭᱤᱭᱟᱹ (ᱜᱩᱨ: ᱓᱐ ᱡᱟᱱᱩᱣᱟᱨᱤ ᱑᱙᱔᱘)" },
        { "cell": "digit-run", "text": "᱑᱙᱐᱔ᱼ ᱵᱷᱟᱨᱚᱛ ᱨᱚᱛᱱᱚ ᱞᱟᱞ ᱵᱟᱦᱟᱫᱩᱨ ᱥᱟᱥᱛᱨᱤ, ᱵᱷᱟᱨᱚᱛ ᱨᱮᱱᱤᱡ ᱫᱚᱥᱟᱨ ᱢᱟᱨᱟᱝ ᱢᱚᱱᱛᱨᱤ (ᱜᱩᱨ: ᱑᱑ ᱡᱟᱱᱩᱣᱟᱨᱤ ᱑᱙᱖᱖)" },
        { "cell": "digit-run", "text": "᱑᱙᱕᱓ᱼ ᱡᱚᱱ ᱢᱟᱨᱤᱱ, ᱟᱢᱮᱨᱤᱠᱟ ᱨᱮᱱᱤᱡ ᱪᱤᱛᱟᱹᱨ ᱵᱟᱰᱚᱦᱤ (ᱡᱟᱱᱟᱢ: ᱑᱘᱗᱐)" },
        { "cell": "digit-run", "text": "᱒᱐᱐᱕ᱼ ᱚᱜᱚᱥᱴ ᱣᱤᱞᱥᱚᱱ, ᱟᱢᱮᱨᱤᱠᱟ ᱨᱮᱱᱤᱡ ᱟᱠᱴᱚᱨ ᱟᱨ ᱜᱟᱭᱱᱟᱦᱟᱹᱨᱤ (ᱡᱟᱱᱟᱢ: ᱑᱙᱔᱕)" },
        { "cell": "digit-run", "text": "ᱚᱜᱚᱥᱴᱚ ᱒᱔, ᱒᱐᱐᱖ ᱨᱮ ᱯᱞᱩᱴᱚ ᱮᱸᱜᱮᱞ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱠᱚ ᱚᱪᱚᱜ ᱠᱮᱫᱮ ᱛᱟᱭᱚᱢ ᱱᱤᱛ ᱱᱚᱶᱟ ᱚᱶᱟᱝ ᱨᱮᱫᱚ ᱘ ᱜᱚᱴᱟᱝ ᱮᱸᱜᱮᱞ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾" },
        { "cell": "digit-run", "text": "8 guys ᱫᱚ ᱒᱐᱐᱓ ᱥᱟᱞ ᱨᱮᱭᱟᱜ ᱠᱷᱟᱴᱚ ᱯᱷᱤᱞᱢ ᱠᱟᱱᱟ, ᱰᱟᱱᱮ ᱠᱩᱠ ᱚᱞ ᱟᱨ ᱫᱤᱥᱟᱹᱭ ᱩᱫᱩᱫ ᱟᱠᱟᱜᱼᱟ ᱾" },
        { "cell": "fractions", "text": "ᱚᱵᱷᱤᱰ (ᱚᱵᱷᱤᱰ; ᱒᱐ ᱢᱟᱨᱪ ᱔᱓ ᱵᱤᱥᱤ - ᱑᱗/᱑᱘ ) ᱨᱳᱢᱟᱱ ᱚᱱᱚᱬᱦᱤᱭᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱡᱟᱱᱟᱢ ᱫᱚ ᱚᱜᱚᱥᱛᱚᱥ ᱟᱜ ᱨᱟᱡᱽᱠᱟᱲ ᱨᱮ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱱᱩᱭᱟᱜ ᱯᱩᱨᱟᱹ ᱧᱩᱛᱩᱢ ᱫᱚ ᱚᱵᱷᱤᱰᱤᱭᱩᱥ ᱱᱟᱥᱳ (Publius Ovidius Naso) (Classical Latin: [ˈpʊ.blɪ.ʊs ɔˈwɪ.dɪ.ʊs ˈnaː.soː]) ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾" },
        { "cell": "fractions", "text": "ᱯᱨᱚᱡᱟᱛᱟᱱᱛᱨᱤᱠ ᱥᱟᱥᱚᱱ ᱵᱭᱚᱵᱚᱥᱛᱷᱟ ᱪᱤᱛᱟᱱ ᱟ.ᱱᱫᱳᱞᱚᱱ ᱨᱮ ᱨᱟᱠᱟᱵ ᱞᱤᱫᱟ ᱾ ᱱᱮᱯᱟᱞ ᱨᱤᱱᱟᱝ ᱒᱐᱖᱒/᱐᱖᱓ ᱨᱮ ᱯᱨᱚᱡᱟᱛᱟᱱᱛᱨᱤᱠ ᱥᱟᱥᱚᱱ ᱚᱜᱩ ᱠᱟᱛᱮ ᱨᱚᱡᱽᱛᱱᱛᱨᱚ ᱚᱪᱚᱠ ᱠᱟᱛᱮ ᱱᱮᱯᱟᱞ ᱨᱮ ᱚᱱᱛᱤᱢ ᱨᱟᱡᱟ ᱮ ᱵᱮᱱᱟᱣ ᱞᱤᱱᱟ ᱾" },
        { "cell": "fractions", "text": "ᱡᱟᱝ ᱨᱚᱦᱚᱭ ᱟᱠᱟᱱ ᱫᱟᱨᱮ ᱨᱮ ᱫᱚ ᱗/᱘ ᱥᱮᱨᱢᱟ ᱛᱟᱭᱚᱢ ᱮᱱᱟᱝ ᱡᱚ ᱧᱟᱢᱚᱜ-ᱟ ᱾ ᱢᱮᱱᱠᱷᱟᱱ ᱠᱩᱞᱢᱤ ᱟᱠᱟᱫ ᱫᱟᱨᱮ ᱫᱚ ᱕/᱖ ᱥᱮᱨᱢᱟ ᱠᱷᱟᱱ ᱜᱮ ᱡᱚ ᱧᱟᱢᱚᱜ-ᱟ ᱾ ᱢᱤᱫᱴᱟᱝ ᱫᱟᱨᱮ ᱨᱮ ᱑᱐᱐ ᱠᱤᱞᱚ ᱠᱷᱚᱱ ᱑᱐᱐᱐ ᱠᱤᱞᱚ ᱜᱟᱱ ᱡᱚ ᱧᱟᱢᱚᱜ-ᱟ ᱾" },
        { "cell": "fractions", "text": "ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱱᱟᱜ ᱤᱨᱟᱹᱞ ᱜᱚᱴᱟᱝ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱜᱟᱰᱟ ᱢᱮᱥᱟ ᱠᱟᱛᱮ ᱡᱟᱷᱟᱸ ᱛᱤᱱᱟᱹᱜ ᱫᱟᱜ ᱠᱚ ᱞᱤᱸᱡᱤᱭᱮᱫᱼᱟ ᱚᱱᱟ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱫᱟᱜ ᱟᱢᱟᱡᱚᱱ ᱜᱟᱰᱟ ᱛᱮ ᱞᱤᱸᱡᱤᱜ ᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱜᱟᱰᱟ ᱨᱮ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱫᱟᱜ ᱞᱤᱸᱡᱤᱭᱟᱜ ᱠᱟᱱᱠᱷᱟ (basin) ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱨᱮ ᱢᱚᱬᱮ ᱦᱟᱹᱴᱤᱧ (᱑/᱕) ᱜᱟᱰᱟ ᱫᱚ ᱱᱚᱶᱟ ᱪᱮᱛᱟᱱ ᱛᱮ ᱞᱤᱸᱡᱤᱜ ᱠᱟᱱᱟ ᱾ ᱡᱟᱹᱯᱩᱫ ᱨᱤᱛᱩ ᱨᱮ ᱫᱚ ᱛᱤᱢᱤᱱ ᱜᱟᱱ ᱴᱷᱟᱶ ᱠᱚᱨᱮ ᱟᱢᱟᱡᱚᱱ ᱫᱚ ᱑᱙᱐ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱚᱥᱟᱨ ᱜᱟᱱ ᱰᱷᱤᱯ ᱥᱮᱫ ᱪᱟᱯᱮ ᱚᱰᱚᱠᱚᱜᱼᱟ ᱾ ᱱᱟᱶᱟ ᱨᱮᱱᱟᱜ ᱚᱥᱟᱨᱼᱵᱤᱥᱟᱹᱨ ᱠᱷᱹᱛᱤᱨ ᱢᱤᱢᱤᱫ ᱫᱷᱟᱶ ᱱᱚᱶᱟ ᱫᱚ ᱥᱟᱹᱢᱩᱸᱫᱽ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱡᱤᱞᱤᱧ ᱜᱟᱰᱟ ᱫᱚ ᱵᱟᱝ ᱠᱟᱱᱟ ᱾ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱡᱤᱞᱤᱧ ᱜᱟᱰᱟ ᱫᱚ ᱱᱤᱞᱮ ᱜᱟᱰᱟ ᱠᱟᱱᱟ ᱟᱨ ᱟᱢᱟᱡᱚᱱ ᱫᱚ ᱫᱚᱥᱟᱨ ᱡᱤᱞᱤᱧ ᱜᱟᱰᱟ ᱠᱟᱱᱟ ᱾" },
        { "cell": "fractions", "text": "ᱚᱱᱠᱟ ᱧᱮᱞ ᱞᱮᱠᱷᱟᱱ ᱫᱚ ᱱᱚᱶᱟ ᱠᱷᱮᱞ ᱒᱐ ᱒᱐ ᱴᱤᱲᱤᱡ ᱨᱮᱭᱟᱜ ᱵᱟᱱᱟᱨ ᱯᱟᱦᱴᱟ ᱨᱮ ᱮᱱᱮᱡ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱡᱚᱛᱚ ᱦᱟᱹᱴᱤᱧ ᱨᱮᱜᱮ ᱜᱟᱫᱮᱞ ᱨᱮᱭᱟᱜ ᱟᱠᱷᱲᱟ ᱴᱷᱟᱶ ᱵᱚᱫᱚᱞ ᱟᱠᱟ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱟᱨ ᱱᱚᱶᱟ ᱞᱟᱹᱜᱤᱫ ᱩᱱᱠᱩ ᱕ ᱴᱤᱲᱤᱡ ᱞᱟᱹᱜᱤᱫ ᱚᱠᱛᱚ ᱠᱚ ᱧᱟᱢᱟ ᱾ ᱱᱚᱝᱠᱟ ᱦᱚᱸ ᱦᱩᱭ ᱫᱟᱲᱮᱭᱟᱜ-ᱟᱥᱟᱯᱲᱟᱣᱤᱭᱟᱹ ᱱᱚᱶᱟᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱦᱟᱹᱴᱤᱧ ᱨᱮᱭᱟᱜ ᱚᱠᱛᱚ ᱑᱐ ᱟᱨᱵᱟᱝ ᱑᱕ ᱴᱤᱲᱤᱡ ᱦᱚᱸᱭ ᱫᱚᱦᱚ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾ ᱡᱚᱛᱚ ᱜᱟᱫᱮᱞ ᱨᱮᱜᱮ ᱕/᱖ ᱥᱴᱟᱯᱚᱨ (ᱥᱟᱥᱟᱵ ᱨᱮ ᱯᱟᱹᱨᱩᱠᱷᱤᱭᱟᱹ ᱠᱷᱮᱞᱚᱸᱰᱤᱭᱟᱹ) ᱟᱨ ᱔/᱕ ᱨᱮᱰᱚᱨ (ᱡᱚᱴᱮᱫ ᱠᱟᱛᱮ ᱫᱟᱹᱲ ᱨᱮ ᱪᱩᱦᱩᱞ ᱠᱷᱮᱞᱚᱸᱰᱤᱭᱟᱹ) ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱢᱤᱫ ᱫᱷᱟᱣ ᱨᱮ ᱠᱷᱟᱹᱞᱤ ᱯᱩᱱ ᱦᱚᱲ ᱥᱴᱟᱯᱚᱨ ᱜᱮ ᱟᱠᱷᱲᱟ ᱛᱮ ᱟᱬᱜᱚᱱ ᱞᱟᱹᱜᱤᱫ ᱫᱟᱣ ᱠᱚ ᱮᱢᱟ ᱠᱚᱣᱟ ᱾ ᱡᱟᱦᱟᱸ ᱛᱤᱱ ᱨᱮᱜᱮ ᱥᱴᱟᱯᱚᱨ ᱡᱟᱦᱟᱸᱭ ᱨᱮᱰᱚᱨ ᱜᱮ ᱟᱡᱟᱜ ᱟᱠᱸᱧᱟ ᱠᱷᱚᱱ ᱵᱟᱦᱨᱮ ᱥᱮᱱᱚᱜ ᱨᱮᱭᱟᱜ ᱮ ᱟᱠᱚᱴ ᱮᱭᱟ, ᱩᱱᱤ ᱢᱤᱫ ᱮᱞ ᱮ ᱧᱟᱢᱟ ᱤᱠᱷᱟᱹᱱ ᱡᱩᱫᱤ ᱨᱮᱰᱚᱨ ᱩᱱᱤ ᱡᱚᱴᱮᱫ ᱠᱟᱛᱮ ᱫᱟᱹᱲ ᱡᱚᱝ ᱨᱮᱭ ᱡᱤᱛᱠᱟᱹᱨᱚᱜᱼᱟ ᱮᱱᱠᱷᱟᱱ ᱩᱱᱤᱨᱤᱱ ᱜᱟᱫᱮᱞ ᱮᱞᱮᱞ ᱠᱚ ᱧᱟᱢᱟ ᱾" },
        { "cell": "fractions", "text": "ᱡᱤᱥᱩ (c. 4 BC – c. 30 / 33 AD), ᱫᱚ ᱤᱥᱟᱹᱭ ᱫᱷᱚᱨᱚᱢᱨᱮᱱ ᱢᱩᱬᱩᱛ ᱦᱚᱲ ᱠᱟᱱᱟᱭ ᱡᱟᱸᱦᱟᱸᱭ ᱫᱚ Jesus of Nazareth and Jesus Christ ᱧᱤᱛᱩᱢ ᱛᱮᱦᱚᱸᱠᱩ ᱵᱟᱰᱟᱭᱮ ᱜᱮᱭᱟ᱾ ᱤᱥᱟᱹᱭ ᱦᱚᱲ ᱠᱩᱣᱟ ᱯᱟᱹᱛᱭᱟᱹᱣ ᱞᱮᱠᱟᱛᱮ ᱩᱱᱤ ᱫᱚ ᱫᱷᱟᱹᱨᱛᱤ ᱥᱤᱡᱚᱱᱤᱭᱟᱹᱨᱮᱱ ᱦᱚᱯᱚᱱ ᱠᱟᱱᱟᱭ᱾ ᱡᱤᱥᱩ ᱟᱜ ᱡᱤᱭᱚᱱ ᱨᱮᱭᱟᱜ ᱞᱮᱠᱷᱟ ᱜᱚᱥᱯᱮᱞ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ, ᱠᱷᱟᱥ ᱠᱟᱭᱛᱮ ᱯᱩᱱ ᱠᱮᱱᱚᱱᱤᱠᱟᱞ ᱜᱚᱥᱯᱮᱞ ᱱᱟᱶᱟ ᱱᱤᱛ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "fractions", "text": "ᱢᱟᱛᱠᱚᱢ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱴᱨᱚᱯᱤᱠᱟᱞ (tropical) ᱫᱟᱨᱮ ᱾ ᱳᱰᱤᱥᱟ, ᱡᱷᱟᱨᱠᱷᱚᱸᱰ, ᱠᱚᱧᱮ ᱯᱚᱱᱚᱛ, ᱵᱤᱦᱟᱨ, ᱠᱮᱨᱚᱲ ᱟᱨ ᱜᱩᱡᱽᱨᱟᱴ ᱯᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱵᱩᱨᱩ ᱠᱚᱨᱮ ᱢᱟᱛᱠᱚᱢ ᱫᱟᱨᱮ ᱫᱚ ᱟᱭᱢᱟ ᱧᱮᱞᱚᱜᱼᱟ ᱾ ᱯᱮ ᱥᱮᱨᱢᱟ ᱦᱩᱭ ᱞᱮᱱ ᱠᱷᱟᱱ ᱢᱟᱛᱠᱚᱢ ᱵᱟᱦᱟᱜ ᱮᱦᱚᱵᱚᱜᱼᱟ ᱟᱨ ᱜᱮᱞ ᱵᱚᱪᱷᱚᱨ ᱦᱩᱭ ᱞᱮᱱ ᱠᱷᱟᱱ ᱡᱚᱜᱼᱟ ᱾ ᱢᱟᱛᱠᱚᱢ ᱫᱟᱨᱮ ᱫᱚ ᱑᱐᱐ ᱠᱷᱚᱱ ᱑᱕᱐ ᱥᱮᱨᱢᱟ ᱦᱟᱹᱵᱤᱡ ᱵᱟᱧᱪᱟᱜᱼᱟ ᱾ ᱢᱤᱫᱴᱤᱡ ᱢᱟᱨᱟᱝ ᱫᱟᱨᱮ ᱠᱷᱚᱱᱟᱜ ᱗᱐ ᱠᱷᱚᱱ ᱗᱕ ᱠᱤᱞᱚ ᱦᱟᱹᱵᱤᱡ ᱢᱟᱛᱠᱚᱢ ᱧᱟᱢᱚᱜᱼᱟ ᱾ ᱵᱟᱦᱟᱜ ᱢᱟᱬᱟᱝ ᱨᱮ ᱵᱚᱪᱷᱚᱨ ᱯᱷᱮᱵᱽᱨᱩᱣᱟᱨᱤ ᱠᱷᱚᱱ ᱮᱯᱨᱤᱞ ᱵᱷᱤᱛᱤᱨ ᱨᱮ ᱢᱟᱨᱮ ᱥᱟᱠᱟᱢ ᱧᱩᱨᱩᱜᱼᱟ ᱟᱨ ᱮᱯᱨᱤᱞ ᱠᱷᱚᱱ ᱢᱮ ᱵᱷᱤᱛᱨᱤ ᱨᱮ ᱱᱟᱶᱟ ᱥᱟᱠᱟᱢ ᱥᱟᱜᱮᱱᱚᱜᱼᱟ ᱾ ᱢᱟᱛᱠᱚᱢ ᱵᱟᱦᱟ ᱫᱚ ᱢᱤᱫ ᱟᱨ ᱟᱫᱷᱟ ᱤᱧᱪ ᱦᱟᱹᱵᱤᱡ ᱦᱟᱨᱟᱜᱼᱟ ᱾ ᱡᱩᱱ ᱠᱷᱚᱱ ᱚᱜᱚᱥᱴ ᱵᱷᱤᱛᱨᱤ ᱨᱮ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱡᱚ ᱵᱤᱞᱤᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱡᱟᱝ ᱫᱚ ᱒/᱓ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱦᱟᱹᱵᱤᱡ ᱦᱩᱭᱩᱜᱼᱟ ᱟᱨ ᱥᱤᱢ ᱵᱤᱞᱤ ᱞᱮᱠᱟ ᱜᱩᱞᱟᱹᱭ ᱟᱨ ᱡᱤᱞᱤᱧᱟ ᱾" },
        { "cell": "fractions", "text": "ᱪᱷᱟᱱᱟᱝ ᱨᱮ ᱡᱩᱫᱤ ᱪᱮᱫ ᱫᱷᱩᱲᱤ ᱦᱚᱸ ᱢᱟᱨᱥᱟᱞ ᱵᱟᱫᱷᱟ ᱵᱟᱠᱚ ᱮᱢᱟᱭᱟ ᱮᱱᱠᱷᱟᱱ ᱢᱤᱫ ᱥᱮᱠᱮᱸᱰ ᱨᱮ ᱱᱚᱶᱟ ᱒᱙᱙,᱗᱙᱒,᱔᱕᱘ ᱢᱤᱴᱚᱨ ᱵᱟᱝ ᱢᱟ ᱑᱘᱖,᱒᱘᱒ ᱢᱟᱭᱤᱞ ᱮ ᱥᱮᱱ ᱠᱮᱭᱟ ᱾ ᱱᱚᱶᱟ ᱞᱮᱠᱟᱛᱮ ᱢᱟᱨᱥᱟᱞ ᱥᱤᱧ ᱪᱟᱸᱫᱚ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱫᱷᱟᱹᱨᱛᱤ ᱛᱮ ᱥᱮᱴᱮᱨᱚᱜ ᱞᱟᱹᱜᱤᱫ ᱘ ᱢᱤᱱᱤᱴ ᱚᱠᱛᱚᱭ ᱦᱟᱛᱟᱶᱟ ᱾ ᱠᱟᱸᱪ ᱨᱮᱫᱚ ᱢᱟᱨᱥᱟᱞᱟᱜ ᱜᱚᱛᱤ \"ᱵᱟᱨ ᱯᱮᱭᱟᱝ\"(᱒/᱓) ᱛᱮ ᱠᱚᱢᱚᱜᱼᱟ ᱾" },
        { "cell": "clock", "text": "ᱞᱚᱱᱰᱚᱱ ᱨᱤᱱ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱮᱞ ᱫᱚ ᱘.᱖᱓ ᱢᱤᱞᱤᱭᱚᱱ ᱾ ᱞᱚᱱᱰᱚᱱ ᱨᱮ ᱛᱟᱦᱮᱸᱱᱠᱟᱱ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲ ᱜᱮ ᱵᱨᱤᱴᱤᱥ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱱᱚᱸᱰᱮ ᱟᱨᱦᱚ ᱟᱭᱢᱟ ᱦᱚᱲ ᱮᱴᱟᱜ ᱫᱤᱥᱚᱢ ᱠᱚᱨᱮ ᱠᱷᱚᱱ ᱦᱮᱡ ᱠᱟᱛᱮ ᱠᱚ ᱛᱟᱦᱮᱸ ᱟᱠᱟᱱᱟ ᱾ ᱱᱩᱠᱩ ᱫᱚ ᱟᱭᱢᱟ ᱵᱷᱮᱯᱮᱫ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱨᱚᱲ ᱥᱟᱶᱛᱮ ᱫᱷᱚᱨᱚᱢ ᱟᱨ ᱞᱟᱠᱪᱟᱨ ᱦᱚᱸ ᱛᱟᱠᱚ ᱵᱷᱮᱯᱮᱫ ᱜᱮᱭᱟ ᱾ ᱟᱭᱢᱟ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱡᱟᱦᱟᱸᱭ ᱠᱚ ᱫᱚ ᱮᱴᱟᱜ ᱫᱤᱥᱚᱢ ᱠᱷᱚᱱ ᱦᱮᱡ ᱠᱟᱛᱮ ᱱᱚᱸᱰᱮ ᱵᱮᱯᱟᱨ ᱞᱟᱹᱜᱤᱫ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱾ ᱟᱭᱢᱟ ᱦᱚᱲ ᱧᱮᱞᱡᱚᱝ ᱞᱟᱹᱜᱤᱫ ᱞᱚᱱᱰᱚᱱ ᱫᱟᱬᱟᱱ ᱠᱚ ᱪᱟᱞᱟᱜ ᱜᱮᱭᱟ ᱾ ᱱᱩᱠᱩ ᱫᱚ ᱞᱚᱱᱰᱚᱱ ᱨᱮᱱᱟᱜ ᱧᱩᱛᱩᱢᱟᱱ ᱴᱷᱟᱶᱠᱚ ᱠᱚ ᱧᱮᱞᱟ ᱾" },
        { "cell": "clock", "text": "ᱦᱚᱲ ᱮᱞ ᱨᱮ ᱫᱚ ᱱᱚᱶᱟ ᱮᱥᱤᱭᱟ ᱛᱟᱭᱚᱢ ᱫᱚᱥᱟᱨ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ᱾ ᱡᱮᱜᱮᱛ ᱨᱮᱱ ᱑᱔.᱗᱒ ᱵᱷᱟᱜᱽ ᱦᱚᱲ ᱱᱚᱰᱮ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱱᱚᱰᱮᱱ ᱠᱚ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲᱟᱜ ᱨᱚᱝ ᱫᱚ ᱦᱮᱸᱫᱮ ᱜᱮᱭᱟ ᱾ ᱱᱚᱱᱰᱮᱱ ᱦᱚᱲ ᱱᱟᱦᱟᱜ ᱦᱚᱸ ᱡᱚᱢᱟᱜ ᱧᱩᱣᱟᱜ ᱦᱚᱨᱚᱜ ᱵᱟᱸᱫᱮ ᱛᱮ ᱦᱟᱨᱠᱮᱛ ᱟᱨ ᱟᱹᱠᱤᱞ ᱜᱮᱭᱟᱱ ᱛᱮ ᱦᱚᱸ ᱠᱚ ᱞᱤᱪᱟᱹᱲ ᱧᱚᱜ ᱜᱮᱭᱟ, ᱚᱱᱟᱛᱮ 'ᱧᱩᱛᱟᱹᱛ ᱢᱟᱦᱟᱫᱤᱥᱚᱢ' ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱟᱯᱷᱨᱤᱠᱟᱱ ᱤᱭᱩᱱᱤᱭᱚᱱ ᱫᱚ ᱢᱤᱫ ᱤᱱᱴᱟᱨᱱᱮᱥᱱᱟᱞ ᱚᱨᱜᱟᱱᱟᱭᱡᱮᱥᱚᱱ ᱠᱟᱱᱟ, ᱚᱠᱟ ᱫᱚ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱱᱟᱜ ᱕᱕ ᱜᱚᱴᱮᱡ ᱫᱤᱥᱚᱢ ᱠᱚ ᱢᱮᱥᱟ ᱛᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱦᱮᱰᱠᱚᱣᱟᱨᱴᱟᱨ ᱫᱚ ᱤᱛᱷᱤᱭᱳᱯᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱟᱫᱫᱤᱥ ᱟᱵᱟᱵᱟ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "clock", "text": "᱑᱐:᱓᱐ - ᱑᱑ : ᱜᱭᱟᱱᱚ, ᱥᱚᱭᱞᱮᱥ, ᱟᱱᱥᱩᱢᱟᱱᱟᱱᱫᱽ ᱥᱩᱵᱷᱟᱥᱤᱥ ᱦᱚᱛᱮᱛᱮ ᱣᱤᱠᱤᱯᱤᱰᱤᱭᱟ ᱥᱟᱯᱲᱟᱣ ᱨᱮᱭᱟᱜ ᱢᱩᱲ ᱠᱟᱛᱷᱟ ᱾" },
        { "cell": "clock", "text": "ᱚᱱᱠᱟ ᱧᱮᱞ ᱞᱮᱠᱷᱟᱱ ᱠᱨᱤᱠᱮᱴ ᱵᱚᱞ ᱨᱮᱭᱟᱜ ᱦᱟᱢᱞ ᱫᱚ ᱕᱕.᱙ ᱜᱨᱟᱢ ᱠᱷᱚᱱ ᱠᱟᱹᱡ ᱦᱩᱭᱩᱜ ᱫᱚ ᱵᱟᱝ ᱞᱟᱹᱠᱛᱤᱜ ᱠᱟᱱᱟ ᱾ ᱨᱤᱛ ᱞᱮᱠᱟᱛᱮ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱩᱡᱩᱱ ᱫᱚ ᱑.᱖᱓ ᱜᱨᱟᱢ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱦᱩᱭᱩᱜ ᱦᱚᱸ ᱵᱮᱥ ᱵᱟᱝᱟ ᱾ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱ ᱵᱚᱞ ᱨᱮᱭᱟᱜ ᱯᱚᱨᱤᱫᱷᱤ ᱫᱚ ᱒᱒.᱔ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱠᱷᱚᱱ ᱒᱒.᱙ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱵᱷᱤᱛᱨᱤ ᱨᱮ ᱛᱟᱦᱮᱸ ᱞᱟᱹᱠᱛᱤ ᱾ ᱠᱨᱤᱠᱮᱴ ᱵᱮᱴ ᱨᱮᱭᱟᱜ ᱡᱤᱞᱤᱧ ᱫᱚ ᱙᱖.᱕ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱫᱚ ᱵᱟᱝ ᱦᱩᱭᱩᱜ ᱞᱟᱹᱠᱛᱤ ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱚᱥᱟᱨ ᱫᱚ ᱡᱟᱦᱟᱸ ᱴᱷᱟᱶ ᱨᱮᱜᱮ ᱑᱐.᱘ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱫᱚ ᱵᱟᱹᱲᱤᱫ ᱜᱮᱭᱟ ᱾ ᱥᱴᱚᱢᱯ ᱨᱮᱭᱟᱜ ᱢᱟᱬᱟᱝ ᱯᱟᱦᱴᱟ ᱚᱛ ᱠᱷᱚᱱ ᱗᱑.᱑ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱪᱮᱛᱟᱱ ᱨᱮ ᱛᱟᱦᱮᱸ ᱞᱟᱹᱠᱛᱤ ᱾ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱ ᱵᱟᱨᱭᱟ ᱵᱮᱞ ᱑᱑.᱑ ᱥᱮᱱᱴᱤᱢᱤᱴᱚᱨ ᱡᱤᱞᱤᱧ ᱦᱩᱭᱩᱜ ᱞᱟᱹᱠᱛᱤ ᱾ ᱡᱚᱛᱚ ᱣᱤᱠᱮᱴ ᱨᱮᱭᱟᱜ ᱥᱚᱢᱟᱱ ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱯᱮᱭᱟ ᱥᱴᱟᱢᱯ ᱵᱤᱫ ᱠᱚᱜᱼᱟ ᱾" },
        { "cell": "clock", "text": "ᱢᱚᱝᱜᱚᱞᱭᱟᱱ (Mars Orbiter Mission: MOM) ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱯᱩᱭᱞᱩ ᱡᱚᱥ ᱵᱚᱸᱜᱟ ᱮᱸᱜᱮᱞ ᱪᱮᱛᱟᱱ ᱨᱮ ᱾ ᱒᱐᱑᱓ ᱥᱟᱞᱮ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱕ ᱢᱟᱹᱦᱤᱛ ᱨᱮ ᱛᱟᱨᱟᱥᱤᱧ ᱵᱮᱲᱟ ᱒:᱓᱘ ᱴᱟᱲᱟᱝ ᱨᱮ ᱥᱨᱤᱦᱚᱨᱤᱠᱚᱴᱟ ᱨᱮᱱᱟᱜ ᱥᱚᱛᱤᱥ ᱫᱷᱟᱣᱟᱱ ᱥᱟᱺᱜᱤᱧ ᱥᱮᱨᱢᱟ ᱥᱟᱬᱮᱥ ᱟᱠᱷᱲᱟ ᱠᱷᱚᱱ ᱯᱤ.ᱮᱥ.ᱮᱞ.ᱵᱷᱤ ᱥᱤ-᱒᱕ ᱫᱟᱨᱟᱭ ᱛᱮ ᱱᱚᱣᱟ ᱜᱟᱹᱰᱤ ᱫᱚ ᱠᱚ ᱛᱩᱧ ᱞᱮᱜᱼᱟ ᱾ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱱᱟᱜ ᱛᱟᱹᱨᱤ ᱨᱮ ᱢᱤᱫ ᱪᱟᱸᱫᱚ ᱫᱤᱱ ᱠᱷᱮᱢᱟᱣ ᱛᱟᱭᱚᱢ ᱓᱐ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱒᱐᱑᱓ ᱥᱟᱞᱮ ᱨᱮ ᱵᱚᱸᱜᱟ ᱮᱸᱜᱮᱞ ᱛᱟᱹᱨᱤ ᱛᱮᱭ ᱵᱚᱞᱚᱭᱮᱱᱟ ᱾ ᱒᱙᱘ ᱫᱤᱱ ᱛᱟᱭᱚᱢ ᱵᱚᱸᱜᱟ ᱮᱸᱜᱮᱞ ᱨᱮᱱᱟᱜ ᱟᱹᱪᱩᱨᱚᱜ ᱰᱟᱦᱟᱨ ᱨᱮᱭ ᱵᱚᱞᱚᱭᱮᱱᱟ ᱾ ᱡᱟᱹᱡᱟᱹᱛᱨᱤᱭᱟᱹ ᱢᱟᱹᱱ ᱚᱠᱛᱮ ᱞᱮᱠᱟ ᱛᱮ ᱢᱚᱝᱜᱚᱞᱭᱟᱱ ᱫᱚ ᱒᱐᱑᱓ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱕ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱴᱷᱤᱠ ᱛᱟᱨᱟ ᱥᱤᱧ ᱒:᱓᱘ ᱚᱠᱛᱮ ᱨᱮ ᱚᱱᱫᱷᱨᱚ ᱯᱨᱚᱫᱮᱥ ᱨᱮᱭᱟᱜ ᱥᱨᱤᱦᱚᱨᱤᱠᱚᱴᱟ ᱨᱮ ᱢᱮᱱᱟᱜ ᱥᱚᱛᱤᱥ ᱫᱷᱟᱣᱟᱱ ᱞᱟᱯᱷᱟᱝ ᱥᱮᱨᱢᱟ ᱛᱟᱞᱢᱟ ᱠᱷᱚᱱ PSLV C25 ᱨᱚᱠᱮᱴ ᱨᱮᱭᱟᱜ ᱜᱚᱲᱚ ᱛᱮ ᱛᱩᱧ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱱᱚᱣᱟ ᱨᱚᱠᱮᱴ ᱛᱩᱧ ᱨᱮᱭᱟᱜ ᱚᱠᱛᱮ ᱫᱚ ᱟᱢᱫᱟᱡᱽ ᱒᱐ ᱢᱟᱦᱟ ᱛᱟᱸᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱒᱐᱑᱓ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱒᱘ ᱚᱠᱴᱚᱵᱚᱨ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱱᱟ ᱾ ᱱᱤᱭᱟᱹ ᱜᱮ ᱥᱤᱧᱚᱛ ᱨᱮᱭᱟᱜ ᱯᱟᱹᱦᱤᱞ ᱵᱟᱦᱨᱮ ᱜᱚᱨᱦᱚ ᱡᱟᱨᱯᱟ ᱛᱟᱸᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱱᱤᱭᱟᱹ ᱱᱟᱭ ᱱᱟᱯᱟᱭ ᱛᱮ ᱯᱩᱨᱟᱹᱣᱮᱱ ᱛᱟᱭᱚᱢ ᱥᱚᱵᱷᱤᱭᱮᱴ ᱨᱟᱥᱤᱭᱟ, ᱱᱟᱥᱟ ᱟᱨ ᱤᱭᱩᱨᱚᱯᱤᱭᱟᱱ ᱜᱟᱶᱛᱟ ᱛᱟᱭᱚᱢ ᱥᱤᱧᱚᱛ ᱨᱮᱭᱟᱜ ᱧᱩᱛᱩᱢ ᱚᱱᱟ ᱛᱟᱹᱞᱠᱟᱹ ᱨᱮ ᱥᱮᱞᱮᱫ ᱮᱱᱟ ᱾" },
        { "cell": "clock", "text": "᱑᱗.᱑᱑.᱑᱙᱗᱙ ᱥᱟᱞᱮ ᱨᱮ ᱯᱩᱨᱩᱞᱤᱭᱟᱹ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱠᱮᱫᱽᱵᱚᱱᱟ ᱦᱟᱴ ᱨᱮ ᱜᱮᱥᱟᱭ ᱜᱮᱥᱟᱭ ᱦᱚᱲ ᱠᱚ ᱥᱟᱢᱟᱝ ᱨᱮ ᱜᱩᱨᱩ ᱜᱚᱢᱠᱮ ᱫᱚ ᱯᱩᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱥᱚᱨᱠᱟᱨ ᱥᱤᱨᱟᱹ ᱢᱚᱱᱛᱨᱤ ᱢᱟᱹᱱ ᱡᱭᱚᱛᱤ ᱵᱚᱥᱩ ᱚᱞ ᱪᱤᱠᱤ ᱡᱟᱱᱟᱢ ᱫᱟᱛᱟ ᱞᱮᱠᱟᱛᱮ ᱵᱷᱟᱹᱜᱤ ᱥᱟᱺᱦᱤᱡ ᱢᱟᱱᱟᱣ ᱵᱟᱛᱟᱣ ᱠᱟᱛᱮ ᱢᱤᱫ ᱛᱟᱸᱵᱟ ᱯᱟᱴᱟ ᱢᱟᱹᱱ ᱥᱟᱛᱞᱟᱜ ᱮ ᱪᱟᱞ ᱟᱫᱮᱭᱟ ᱾" },
        { "cell": "clock", "text": "᱑᱗.᱑᱑.᱑᱙᱗᱙ ᱨᱮ ᱵᱮᱝᱜᱚᱞ ᱥᱚᱨᱠᱟᱨ ᱢᱟᱹᱱ ᱡᱭᱚᱛᱤ ᱵᱚᱥᱩ ᱣᱟᱜ ᱛᱤᱛᱮ ᱚᱞ ᱪᱤᱠᱤ ᱡᱟᱱᱟᱢ ᱫᱟᱛᱟ ᱞᱮᱠᱟᱛᱮ ᱢᱟᱱᱟᱣ ᱠᱟᱛᱮ ᱢᱤᱫ ᱛᱟᱸᱵᱟ ᱯᱟᱴᱟ ᱪᱟᱞ ᱠᱟᱛᱮᱭ ᱢᱟᱹᱱ ᱥᱟᱨᱦᱟᱣ ᱞᱮᱫᱮᱭᱟ ᱾" },
        { "cell": "clock", "text": "ᱟᱹᱛᱩ ᱨᱮᱱᱟᱜ ᱞᱚᱲᱟ ᱯᱟᱲᱟᱣᱜ ᱡᱚᱦᱚᱜ ᱢᱟᱹᱡᱷᱤᱭᱟᱜ ᱟᱸᱫᱮᱛᱮ ᱟᱹᱛᱩ ᱨᱮ ᱡᱚᱜᱽ ᱢᱟᱹᱡᱷᱤ ᱟᱹᱛᱩ ᱦᱚᱲ ᱠᱚᱭ ᱡᱟᱣᱨᱟ ᱦᱚᱫᱚ ᱠᱚᱣᱟ ᱾ ᱚᱸᱰᱮ ᱢᱟᱹᱡᱷᱤ ᱟᱠᱷᱲᱟ ᱨᱮᱜᱮ ᱟᱪᱟᱨ ᱵᱤᱪᱟᱹᱨ, ᱯᱟᱨᱟᱵᱽ ᱯᱩᱱᱟᱹᱭ, ᱱᱮᱰᱟ ᱵᱟᱨᱛᱮ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱯᱟᱨᱟᱵᱽ ᱯᱩᱱᱟᱹᱭ ᱵᱚᱸᱜᱟ ᱵᱳᱨᱳ ᱑᱒ (ᱜᱮᱵᱟᱨ) ᱢᱟᱦᱟᱸ ᱢᱟᱬᱟᱝ ᱨᱮ ᱾ ᱮᱱ ᱮᱱᱟᱝ ᱟᱹᱛᱩᱨᱮ ᱱᱤᱴ ᱜᱚᱞᱟᱴ ᱟᱠᱟᱱ ᱫᱤᱱ ᱢᱟᱦᱟᱸᱨᱮ ᱯᱮᱲᱟ ᱯᱩᱨᱵᱷᱩ, ᱫᱮ-ᱵᱷᱟᱹᱜᱤᱱ ᱠᱚ ᱱᱮᱣᱛᱟ ᱵᱟᱨᱛᱮ ᱟᱹᱜᱩ ᱠᱚᱣᱟ ᱾ ᱡᱟᱦᱟᱸᱱᱟᱜ ᱫᱚᱨᱵᱟᱨ ᱦᱚᱪᱚᱭ ᱠᱷᱟᱱ ᱢᱟᱹᱡᱷᱤ ᱜᱚᱢᱠᱮ ᱴᱷᱮᱱ ᱢᱚᱬᱮ ᱥᱤᱠᱟᱹ (᱑. ᱒᱕) ᱯᱩᱭᱥᱟᱹ ᱟᱨᱫᱟᱥ ᱜᱚᱱᱚᱝ ᱞᱟᱜᱟᱣᱜᱼᱟ ᱾ ᱮᱱ ᱠᱟᱛᱮ ᱮᱱᱟᱝ ᱢᱟᱹᱡᱷᱤ ᱫᱚᱨᱵᱟᱨ ᱮ ᱦᱚᱦᱚ ᱚᱪᱚᱭᱟ ᱾ ᱟᱹᱛᱩᱨᱮ ᱢᱟᱹᱡᱷᱤ ᱚᱲᱟᱜ ᱠᱚ ᱱᱮᱭᱟᱣ ᱱᱤᱯᱥᱟᱹ ᱡᱚᱦᱚᱜ ᱩᱥᱟᱹᱫ ᱡᱤᱣᱤ ᱨᱟᱲᱮᱡ ᱠᱚ ᱥᱮᱱᱚᱜᱼᱟ ᱾ ᱩᱱᱠᱩ ᱱᱮᱭᱟᱣ ᱦᱚᱲ ᱠᱚ ᱜᱟᱞ ᱠᱟᱛᱷᱟ ᱛᱮ ᱵᱟᱨ ᱯᱮ ᱦᱚᱲ ᱚᱲᱟᱜ ᱛᱮ ᱤᱫᱤ ᱠᱟᱛᱮ ᱥᱚᱞᱦᱟ-ᱱᱟᱢᱟ ᱠᱟᱠᱚᱣᱟ ᱾ ᱵᱟᱠᱚ ᱨᱮᱵᱮᱱ ᱠᱷᱟᱱ ᱢᱟᱹᱡᱷᱤ ᱟᱡᱟᱜ ᱚᱲᱟᱜ ᱨᱮ ᱡᱚᱢ-ᱧᱩ ᱫᱚᱦᱚ ᱠᱟᱛᱮ ᱠᱩᱲᱤ ᱟᱯᱟᱵᱟᱨᱮ ᱚᱲᱟᱜ ᱛᱮ ᱢᱚᱬᱮ ᱦᱚᱲ ᱟᱛᱮ ᱤᱫᱤ ᱥᱮᱴᱮᱨ ᱦᱚᱴᱚ ᱠᱟᱭᱟ ᱠᱚ ᱾ ᱟᱨ ᱟᱯᱟᱵᱟᱨᱮᱛ ᱟᱛᱮ ᱠᱚ ᱟᱹᱜᱩ ᱦᱚᱴᱚ ᱠᱟᱭᱟ ᱾ ᱟᱨ ᱠᱚ ᱵᱤᱪᱟᱹᱨ ᱫᱚᱨᱵᱟᱨ ᱢᱟᱵᱽᱞᱟᱭᱟ ᱾" },
        { "cell": "signs", "text": "ᱡᱟᱦᱟᱱ ᱮᱞ ᱜᱮ ᱐ ᱥᱟᱶ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱠᱷᱟᱱ ᱤᱱᱟᱹ ᱜᱮ ᱛᱟᱦᱮᱱᱟ ᱡᱮᱢᱚᱱ ᱑ + ᱐ = ᱑, ᱒ + ᱐ = ᱒" },
        { "cell": "signs", "text": "ᱚᱱᱠᱟ ᱜᱮ ᱐ ᱥᱟᱶ ᱡᱟᱦᱟᱱ ᱮᱞ ᱥᱮᱞᱮᱫ ᱨᱮᱦᱚᱸ ᱤᱱᱟᱺᱜᱮ ᱛᱟᱦᱮᱱᱼᱟ ᱡᱮᱢᱳᱱ ᱐ + ᱑ = ᱑, ᱐ + ᱒ = ᱒" },
        { "cell": "signs", "text": "ᱥᱮᱞᱮᱫ ᱞᱮᱠᱟᱜᱮ ᱵᱷᱮᱜᱮᱫ ᱨᱮᱦᱚᱸ ᱐ ᱡᱟᱦᱟᱱᱟᱜ ᱵᱷᱮᱜᱮᱫ ᱵᱟᱝ ᱜᱟᱱᱚᱜᱼᱟ ᱡᱮᱢᱚᱱ ᱑ - ᱐ = ᱑, ᱒ - ᱐ = ᱒, ᱡᱟᱦᱟᱸ ᱛᱤᱱ ᱥᱮᱬᱟ ᱮᱞ ᱠᱷᱚᱱ ᱐ ᱮᱢ ᱵᱷᱮᱜᱮᱫ ᱜᱷᱟᱱ ᱤᱱᱟᱹᱜ ᱜᱮ ᱥᱟᱨᱮᱡ ᱨᱩᱣᱟᱲᱚᱜᱼᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱐ ᱜᱷᱚᱱ ᱡᱟᱦᱟᱱᱟᱜ ᱮᱢ ᱵᱷᱮᱜᱮᱫ ᱠᱷᱟᱱ ᱤᱱᱟᱹᱜ ᱵᱷᱮᱜᱮᱫ ᱥᱟᱨᱮᱡᱚᱜᱼᱟ ᱡᱮᱢᱚᱱ ᱐ - ᱑ = -᱑, ᱐ - ᱒ = -᱒ ᱹᱹᱹ ᱾" },
        { "cell": "signs", "text": "ᱜᱟᱵᱟᱬ ᱨᱮᱦᱚᱸ ᱐ ᱥᱟᱶ ᱡᱟᱦᱟᱸ ᱛᱤᱱ ᱥᱮᱬᱟ ᱮᱞ ᱮ ᱜᱟᱵᱟᱬ ᱮᱱ ᱨᱮᱦᱚᱸ ᱚᱨᱡᱚ ᱫᱚ ᱪᱮᱫ ᱦᱚᱸ ᱵᱟᱝ ᱧᱟᱢᱳᱜᱼᱟ ᱾ ᱡᱮᱢᱚᱱ ᱐ × ᱑ = ᱐ ᱐ × ᱒ = ᱐ ᱾ ᱚᱱᱠᱟ ᱜᱮ ᱡᱟᱦᱟᱸ ᱛᱤᱱ ᱥᱮᱬᱟ ᱮᱞ ᱐ ᱥᱟᱶ ᱮ ᱜᱟᱵᱟᱬᱚᱜ ᱨᱮᱦᱚᱸ ᱚᱨᱡᱚ ᱫᱚ ᱐ ᱜᱮ ᱴᱟᱦᱮᱱᱟ ᱡᱮᱢᱚᱱ ᱑ × ᱐ = ᱐, ᱒ × ᱐ = ᱐ ᱾" },
        { "cell": "signs", "text": "ᱦᱟᱴᱟᱬ ᱨᱮ ᱐ ᱡᱟᱦᱟᱱᱟᱜ ᱮᱞ ᱛᱮ ᱦᱟᱴᱟᱬ ᱞᱮᱠᱷᱟᱱ ᱦᱟᱬᱟ ᱫᱚ ᱐ ᱜᱮ ᱛᱟᱦᱮᱱᱟ ᱡᱮᱢᱚᱱ ᱐ ÷ ᱑ = ᱐, ᱐ ÷ ᱒ = ᱐ ᱾ ᱟᱨ ᱡᱟᱦᱟᱱᱜᱟ ᱮᱞ ᱐ ᱛᱮᱢ ᱦᱟᱴᱟᱬ ᱠᱷᱟᱱ ᱦᱟᱬᱟ ᱫᱚ ᱚᱦᱤᱥᱟᱹᱵ (infinity) ᱦᱩᱭᱩᱜᱼᱟ ᱡᱮᱢᱚᱱ ᱑ ÷ ᱐ = ∞, ᱒ ÷ ᱐ = ∞ ᱾" },
        { "cell": "signs", "text": "᱑ ᱥᱟᱶ ᱑ ᱜᱟᱵᱟᱬ ᱞᱮᱱᱠᱷᱟᱱ ᱑ ᱜᱮ ᱦᱩᱭᱩᱜᱼᱟ ᱡᱮᱞᱮᱠᱟ ᱑×᱑=᱑, ᱱᱚᱣᱟ ᱫᱚ ᱑ ᱨᱮᱱᱟᱜ ᱜᱟᱵᱟᱬ ᱩᱱᱩᱨᱩᱢ ᱵᱚᱱ ᱢᱮᱱ ᱮᱫᱟ , ᱑ ᱥᱟᱞᱟᱜ ᱡᱟᱦᱟᱸ ᱮᱞ ᱜᱮ ᱜᱟᱵᱟᱬ ᱞᱮᱱᱠᱷᱟᱸ ᱤᱱᱟᱹ ᱮᱞ ᱜᱮ ᱦᱩᱭ ᱨᱩᱣᱟᱹᱲᱣᱟ ᱾" },
        { "cell": "signs", "text": "ᱡᱮᱞᱮᱠᱟ: ᱒×᱒=᱔, ᱑×᱓=᱓, ᱑×᱔=᱔ , ᱚᱱᱟ ᱠᱷᱟᱹᱛᱤᱨ ᱑ ᱫᱚ ᱡᱷᱚᱛᱚ ᱮᱞ ᱨᱤᱱᱤᱡ ᱜᱟᱵᱟᱬᱦᱟ ᱠᱟᱱᱟᱭ ᱾" },
        { "cell": "signs", "text": "᱑ ᱨᱮ ᱑ ᱦᱟᱴᱟᱬ ᱞᱮᱱᱠᱷᱟᱱ ᱑ ᱜᱮ ᱦᱩᱭᱩᱜᱼᱟ ᱡᱮᱞᱮᱠᱟ ᱑÷᱑=᱑, ᱱᱚᱣᱟ ᱫᱚ ᱑ ᱨᱮᱱᱟᱜ ᱦᱟᱴᱟᱬ ᱩᱱᱩᱨᱩᱢ ᱵᱚᱱ ᱢᱮᱱ ᱮᱫᱟ" },
        { "cell": "dotted", "text": "ᱟᱵᱩᱞ ᱯᱚᱠᱤᱨ ᱡᱮᱣᱱᱩᱞᱚᱵᱫᱤᱱ ᱚᱵᱽᱫᱩᱞ ᱠᱚᱞᱟᱢ ᱵᱟᱹᱲᱛᱤ ᱫᱚ A. P. J. Abdul kalam ᱢᱮᱱᱛᱮ ᱠᱚ ᱵᱟᱰᱟᱭᱮᱭᱟ ᱾ ᱚᱵᱽᱫᱩᱞ ᱠᱚᱞᱟᱢ ᱫᱚ ᱵᱷᱟᱨᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱤᱱᱤᱡ ᱯᱟᱨᱥᱮᱛ ᱜᱚᱢᱠᱮ ᱞᱮᱠᱟᱛᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱒᱐᱐᱒ ᱠᱷᱚᱱ ᱒᱐᱐᱗ ᱥᱟᱞᱮ ᱫᱷᱟᱹᱵᱤᱡ ᱾ ᱛᱟᱢᱤᱞᱱᱟᱰᱩ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱨᱟᱢᱮᱥᱣᱚᱨᱚᱢ ᱨᱮ ᱡᱟᱱᱟᱢ ᱠᱟᱛᱮ ᱦᱟᱨᱟᱵᱩᱨᱩ ᱞᱮᱱᱟ ᱾ ᱩᱱᱩᱤ ᱛᱤᱨᱩᱪᱤᱨᱚᱯᱚᱞᱞᱤ ᱨᱮᱱᱟᱜ ᱥᱮᱱᱴ ᱡᱚᱥᱮᱯᱷ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱷᱚᱱ ᱯᱷᱤᱡᱤᱠᱟᱞ (physical science) ᱟᱨ ᱪᱮᱱᱱᱟᱭ ᱨᱮᱱᱟᱜ ᱢᱟᱫᱽᱨᱟᱥ ᱤᱱᱥᱴᱤᱪᱩᱴ ᱚᱯᱷ ᱴᱮᱠᱱᱚᱞᱚᱡᱤ ᱠᱷᱚᱱ ᱩᱰᱟᱹᱱ ᱤᱧᱡᱤᱱᱤᱭᱟᱹᱨ ᱥᱚᱱᱮᱨ ᱦᱟᱛᱟᱣᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱫᱤᱥᱚᱢ ᱨᱤᱱ ᱯᱟᱨᱥᱮᱛ ᱦᱣᱭᱩᱜ ᱢᱟᱬᱟᱝ ᱨᱮ ᱰᱤᱯᱷᱮᱱᱥ ᱨᱤᱥᱚᱨᱪ & ᱰᱮᱵᱷᱞᱚᱯᱢᱮᱱᱴ ᱚᱨᱜᱟᱱᱤᱡᱮᱥᱚᱱ (DRDO) ᱟᱨ ᱤᱥᱨᱚ ᱨᱮ ᱩᱰᱟᱹᱱ ᱤᱧᱡᱤᱱᱤᱭᱟᱹᱨ ᱞᱮᱠᱟᱛᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱟᱞᱤᱥᱴᱤᱠ ᱢᱤᱥᱟᱭᱤᱞ ᱟᱨ ᱞᱚᱧᱪ ᱵᱮᱦᱠᱤᱞ ᱨᱮᱱᱟᱜ ᱥᱟᱬᱮᱥ ᱜᱮᱭᱟᱱ ᱮ ᱥᱮᱸᱫᱽᱨᱟ ᱚᱰᱚᱠ ᱞᱮᱫ ᱠᱷᱟᱹᱛᱤᱨ ᱠᱚᱞᱟᱢ ᱫᱚ ᱵᱷᱟᱨᱚᱛ ᱨᱤᱱᱤᱡ ᱢᱤᱥᱟᱭᱤᱞ ᱢᱮᱱ ᱢᱟᱺᱱ ᱠᱚ ᱮᱢ ᱟᱠᱟᱣᱫᱮᱭᱟ ᱾ ᱥᱟᱺᱜᱤᱧ ᱥᱮᱨᱢᱟ ᱥᱟᱬᱮᱥ ᱟᱨ ᱰᱤᱯᱷᱮᱱᱥ ᱥᱟᱬᱮᱥ ᱨᱮ ᱟᱡᱟᱜ ᱢᱟᱨᱟᱝ ᱮᱱᱮᱢ ᱞᱟᱹᱜᱤᱫ ᱑᱙᱙᱗ ᱥᱟᱞᱮ ᱨᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱥᱤᱨᱯᱷᱟᱹ ᱵᱷᱟᱨᱚᱛ ᱨᱚᱛᱱᱚ ᱢᱟᱺᱱ ᱥᱟᱨᱦᱟᱣ ᱠᱚ ᱮᱢᱟᱫᱮᱭᱟ ᱾" },
        { "cell": "dotted", "text": "ᱜᱩᱜᱚᱞ ᱫᱚ ᱑᱙᱙᱘ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ ᱪᱟᱸᱫᱚ ᱨᱮ ᱞᱟᱨᱤ ᱯᱮᱡᱽ ᱟᱨ ᱥᱮᱨᱜᱮᱭ ᱵᱽᱨᱤᱱ ᱧᱩᱛᱩᱢᱟᱱ ᱵᱟᱨᱭᱟ ᱠᱚᱢᱯᱤᱭᱩᱴᱟᱨ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱨᱮᱱ Ph.D. ᱯᱟᱹᱴᱷᱩᱣᱟᱹ ᱠᱮᱞᱤᱯᱷᱳᱨᱱᱤᱭᱟ ᱨᱮᱱᱟᱜ Standford University ᱨᱮ ᱯᱟᱲᱦᱟᱜ ᱚᱠᱛᱮ ᱠᱤᱱ ᱛᱮᱭᱟᱨ ᱞᱮᱫᱟ ᱾ ᱟᱠᱤᱱ ᱵᱟᱱᱟᱦᱚᱲ ᱛᱮ ᱑᱔% ᱞᱮᱠᱟ ᱥᱮᱭᱟᱨ ᱠᱤᱱ ᱦᱟᱢᱮᱴ ᱞᱮᱫᱟ ᱟᱨ ᱕᱖% Stockholder ᱠᱚᱣᱟᱜ ᱫᱟᱲᱮ ᱠᱤᱱ ᱧᱟᱢ ᱞᱮᱫᱟ Supervoting Stock ᱛᱟᱞᱟᱛᱮ| California ᱠᱷᱚᱱ October ᱒᱒, ᱒᱐᱐᱒ ᱦᱤᱞᱳᱜ ᱫᱮᱞᱣᱟᱨᱮ(Delware) ᱨᱮ ᱱᱟᱣᱟ ᱠᱟᱛᱮᱫ ᱛᱷᱟᱯᱚᱱ ᱦᱳᱭ ᱞᱮᱱᱟ| ᱚᱱᱟ ᱛᱟᱭᱚᱢ August ᱑᱙, ᱒᱐᱐᱔ ᱥᱟᱞ ᱨᱮ ᱢᱤᱫᱴᱟᱝ IPO(Initial Public Offer) ᱧᱟᱢᱞᱮᱱᱛᱮ ᱜᱩᱜᱩᱞ(Google) ᱫᱚ California ᱨᱮᱱᱟᱜ Mountain View (ᱱᱤᱛᱟᱜ Headquarters Googleplex) ᱨᱮ ᱤᱪᱟᱹᱲ ᱞᱮᱱᱟ|" },
        { "cell": "dotted", "text": "ᱠᱟ.ᱱᱩᱱ ᱥᱟᱥᱚᱱ ᱨᱮᱭᱟᱜ ᱯᱩᱭᱞᱩ ᱴᱷᱟ.ᱣᱠᱟ.ᱱ ᱫᱚ ᱱᱚᱣᱟ ᱠᱟᱱᱟ - ᱠᱟ.ᱱᱩᱱ ᱥᱟᱢᱟᱝ ᱨᱮᱫᱚ ᱡᱚᱛᱚ ᱦᱚᱲ ᱜᱮ ᱢᱤᱫ ᱞᱮᱠᱟ ᱾ ᱵᱷᱟᱨᱚᱛ ᱨᱮ ᱱᱚᱣᱟ ᱫᱚ ᱚᱱᱟ ᱢᱮᱱᱮᱛ ᱞᱮᱠᱟ ᱛᱮᱭ ᱟᱯᱱᱟᱨᱟ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱱᱚᱣᱟ ᱫᱚ ᱤᱸᱜᱽᱞᱤᱥ ᱟᱢᱮᱨᱤᱠᱤᱭᱟ. ᱠᱟ.ᱱᱩᱱ ᱨᱮ ᱟᱯᱱᱟᱨ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ᱾ ᱵᱷᱟᱨᱚᱛᱤᱭᱟ. ᱴᱷᱟ.ᱣᱠᱟ. ᱟ.ᱱᱟ.ᱨᱤ ᱨᱮ ᱱᱚᱣᱟ ᱵᱤᱠᱱᱟ.ᱣ ᱟᱠᱟᱱᱟ ᱫᱚ ᱡᱚᱛᱚ ᱱᱟᱜᱟᱨᱤᱭᱟ. ᱠᱚ ᱞᱟ.ᱜᱤᱫ ᱜᱮ ᱢᱤᱫᱴᱟ.ᱝ ᱠᱟ.ᱱᱩᱱ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱡᱟᱦᱟᱸ ᱫᱚ ᱢᱤᱫ ᱞᱮᱠᱟ ᱜᱮ ᱞᱟᱜᱩ ᱛᱟᱦᱮᱸᱱᱟ ᱾" },
        { "cell": "dotted", "text": "ᱵᱤᱞᱟᱹᱛ ᱠᱷᱚᱱ ᱡᱚᱭᱯᱟᱞ ᱥᱤᱝ ᱮᱢ. ᱮ. ᱥᱟᱹᱛ ᱠᱟᱛᱮ ᱵᱤᱦᱟᱨ ᱯᱚᱱᱚᱛ ᱛᱮᱭ ᱨᱩᱣᱟᱹᱲ ᱦᱮᱡ ᱮᱱᱟ ᱾ ᱑᱙᱒᱘ ᱥᱟᱞᱧᱮ ᱡᱚᱭᱯᱟᱞ ᱥᱤᱝ ᱫᱚ ᱥᱤᱧᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱦᱚᱠᱤ ᱠᱷᱮᱞᱚᱸᱰ ᱨᱮ ᱢᱩᱲᱩᱛᱟᱱ ᱞᱮᱠᱟ ᱛᱮᱠᱚ ᱠᱷᱚᱸᱡᱟ ᱠᱟᱫᱮᱭᱟ ᱾ ᱢᱩᱲᱩᱛᱟᱱ ᱛᱟᱦᱮᱸ ᱠᱟᱱ ᱚᱠᱛᱚ ᱚᱢᱚᱥᱛᱚᱨ ᱰᱟᱞᱢ ᱚᱞᱤᱢᱯᱤᱠ ᱮᱱᱮᱡ ᱨᱮ ᱵᱷᱟᱨᱚᱛᱤᱭᱟᱹ ᱦᱚᱠᱤ ᱴᱤᱢ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱥᱚᱨᱮᱥ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱱ ᱾ ᱩᱱᱠᱷᱚᱱ ᱜᱮ ᱡᱚᱭᱯᱟᱞ ᱥᱤᱝ ᱫᱚ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮ ᱢᱤᱫ ᱢᱟᱨᱟᱝ ᱠᱷᱮᱞᱚᱸᱰᱤᱭᱟᱹ ᱞᱮᱠᱟᱛᱮᱭ ᱧᱩᱛᱩᱢ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱱ ᱾" },
        { "cell": "dotted", "text": "ᱡᱚᱵᱟᱦᱚᱨᱞᱟᱞ ᱱᱮᱦᱨᱩ (ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱑᱔, ᱑᱘᱘᱙ - ᱢᱮ ᱒᱗, ᱑᱙᱖᱔ ) ᱵᱷᱟᱨᱚᱛ ᱨᱤᱱᱤᱡ ᱯᱩᱭᱞᱩ ᱢᱟᱨᱟᱝᱢᱚᱸᱛᱨᱤᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱟᱨ ᱯᱷᱩᱨᱜᱟ.ᱞᱚᱜ ᱢᱟᱬᱟᱝ ᱟᱨ ᱛᱟᱭᱚᱢ ᱛᱮᱦᱚᱸ ᱵᱷᱟᱨᱚᱛᱤᱭᱟ. ᱨᱟᱡᱽᱟ.ᱨᱤ ᱨᱮ ᱛᱟᱞᱢᱟ ᱦᱚᱲ ᱜᱮᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱢᱚᱦᱟᱛᱢᱟ ᱜᱟᱺᱫᱷᱤᱭᱟᱜ ᱧᱮᱞ ᱡᱚᱛᱚᱱ ᱨᱮ ᱵᱷᱟᱨᱚᱛᱤᱭᱟ. ᱟ.ᱯᱱᱟ.ᱛ ᱦᱩᱞᱥᱟ.ᱭ ᱨᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱱᱮᱛᱟ ᱨᱩᱯᱨᱮ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱠᱮᱜᱼᱟ ᱟᱨ ᱩᱱᱠᱩ ᱫᱚ ᱑᱙᱔᱗ ᱨᱮ ᱵᱷᱟᱨᱚᱛ ᱫᱚ ᱢᱤᱫ ᱟ.ᱯᱱᱟ.ᱛ ᱨᱟᱥᱴᱨᱚ ᱞᱮᱠᱟᱛᱮ ᱛᱷᱟᱯᱚᱱ ᱠᱷᱚᱱ ᱮᱛᱚᱦᱚᱵ ᱠᱟᱛᱮ ᱑᱙᱖᱔ ᱟᱡᱟᱜ ᱜᱩᱡᱩᱜ ᱫᱷᱟ.ᱵᱤᱡ ᱵᱷᱟᱨᱚᱛ ᱮ ᱥᱟᱥᱚᱱ ᱠᱮᱜᱼᱟ ᱾ ᱡᱚᱵᱟᱦᱚᱨᱞᱟᱞ ᱱᱮᱦᱨᱩ ᱫᱚ ᱵᱷᱟᱨᱚᱛᱤᱭᱟ. ᱜᱤᱫᱽᱨᱟ. ᱠᱚᱫᱚ ᱪᱟᱪᱟ ᱱᱮᱦᱨᱩ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱭᱟ ᱾" },
        { "cell": "dotted", "text": "ᱨᱟᱫᱷᱟᱠᱨᱤᱥᱱᱚᱱ ᱫᱚ ᱑᱘᱘᱘ ᱥᱟᱞᱮ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ ᱕ ᱢᱟᱹᱦᱤᱛ ᱦᱤᱞᱚᱜ ᱢᱟᱫᱽᱨᱟᱥ ᱨᱮᱭᱟᱜ ᱛᱤᱨᱩᱛᱛᱟᱬᱤ ᱟᱹᱛᱩ ᱨᱮᱭ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟ ᱾ ᱟᱡᱤᱡ ᱡᱟᱱᱟᱢ ᱵᱟᱵᱟ ᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱵᱤᱨᱥᱣᱟᱢᱤ ᱯᱩᱨᱳᱦᱤᱛ ᱞᱮᱠᱟ ᱠᱟᱹᱢᱤ ᱠᱟᱛᱮ ᱡᱤᱭᱚᱱ ᱮ ᱪᱟᱞᱟᱣ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱨᱟᱫᱷᱟᱠᱨᱤᱥᱱᱚᱱ ᱫᱚ ᱵᱷᱮᱞᱞᱚᱨ ᱨᱮᱭᱟᱜ ᱵᱩᱨᱦᱤᱡᱽ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱷᱚᱱ ᱮᱱᱴᱨᱟᱱᱥ ᱟᱨ ᱮᱯ. ᱮ., ᱢᱟᱫᱽᱨᱟᱥ ᱨᱮᱭᱟᱜ ᱠᱮᱨᱮᱥᱛᱟᱱ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱷᱚᱱ ᱥᱟᱱᱟᱥ ᱨᱮ ᱚᱱᱚᱨᱥ ᱥᱟᱶᱛᱮ ᱯᱩᱭᱞᱩ ᱴᱷᱟᱶ ᱟᱢᱮᱴ ᱠᱟᱛᱮ ᱥᱚᱱᱮᱨ, ᱟᱨ ᱢᱟᱫᱽᱨᱟᱥ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱷᱚᱱ ᱥᱟᱱᱟᱥ ᱪᱮᱛᱟᱱ ᱨᱮ ᱯᱩᱭᱞᱩ ᱴᱷᱟᱶ ᱟᱢᱮᱴ ᱠᱟᱛᱮ ᱮᱢ. ᱮ. ᱦᱚᱸᱭ ᱥᱟᱹᱛ ᱞᱮᱫᱼᱟ ᱾ ᱯᱟᱲᱦᱟᱣ ᱛᱟᱭᱚᱢ ᱑᱙᱐᱙ ᱥᱟᱞᱮᱨᱮ ᱢᱟᱫᱽᱨᱟᱥ ᱨᱮ ᱯᱨᱮᱥᱤᱰᱮᱱᱥᱤ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮ ᱢᱟᱪᱮᱛ ᱞᱮᱠᱟᱛᱮ ᱪᱟᱹᱠᱨᱤ ᱡᱤᱭᱚᱱ ᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱫᱼᱟ ᱾ ᱤᱱᱟᱹ ᱛᱟᱭᱚᱢ ᱥᱮᱨᱱᱟ ᱥᱚᱭᱫᱟᱯᱮᱴ ᱨᱮ ᱢᱮᱱᱟᱜ ᱴᱤᱪᱟᱨᱥ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱷᱚᱱ ᱮᱞ. ᱴᱤ. ᱦᱚᱸᱭ ᱯᱩᱨᱟᱹᱣ ᱥᱟᱹᱛ ᱞᱮᱫᱼᱟ ᱾" },
        { "cell": "dotted", "text": "ᱠᱚᱢᱯᱩᱴᱚᱨ ᱥᱟᱬᱮᱥ ᱫᱚ ᱑᱙᱕᱐ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱢᱩᱪᱟᱹᱫ ᱥᱮᱨᱢᱟ ᱨᱮ ᱢᱤᱫ ᱱᱟᱣᱟ ᱟᱹᱨᱤᱪᱟᱹᱞᱤ ᱠᱟᱱᱟ ᱡᱟᱦᱟᱸ ᱫᱚ ᱠᱚᱢᱯᱩᱴᱚᱨ ᱵᱮᱵᱷᱟᱨᱤᱭᱟᱹ ᱠᱚ ᱛᱟᱞᱟ ᱨᱮ ᱚᱠᱛᱚ ᱦᱟᱹᱴᱤᱧ ᱟᱨ ᱛᱟᱭᱚᱢ ᱛᱮ ᱣᱮᱰ ᱮᱨᱤᱭᱟ ᱱᱮᱴᱣᱟᱨᱠ ᱨᱮ ᱱᱚᱣᱟ ᱦᱟᱛᱟᱣ ᱨᱮᱱᱟᱜ ᱫᱟᱲᱮᱭ ᱵᱟᱰᱟᱭ ᱮᱫᱟ ᱾ J. C. R. ᱞᱤᱠᱞᱟᱭᱰᱟᱨ ᱫᱚ ᱭᱩᱱᱟᱭᱴᱮᱰ ᱥᱴᱮᱴᱥ ᱰᱤᱯᱟᱨᱴᱢᱮᱱᱴ (DoD) ᱮᱰᱵᱷᱟᱱᱥ ᱨᱮᱥᱮᱪ ᱯᱨᱚᱡᱮᱠᱴ ᱮᱡᱮᱱᱥᱤ (ARPA) ᱨᱮ ᱤᱱᱯᱷᱚᱨᱢᱮᱥᱚᱱ ᱯᱨᱚᱥᱮᱥᱤᱝ ᱴᱮᱠᱱᱤᱠ ᱚᱯᱷᱤᱥ (IPTO) ᱨᱮ ᱡᱮᱜᱮᱛᱟᱹᱨᱤ ᱱᱮᱴᱣᱟᱨᱠ ᱨᱮᱱᱟᱜ ᱮᱱᱮᱡ ᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱫᱼᱟ ᱾ ᱑᱙᱖᱐ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱨᱮ ᱨᱟᱱᱰ ᱠᱚᱨᱯᱚᱨᱮᱥᱚᱱ ᱨᱮ ᱯᱳᱞ ᱵᱟᱨᱟᱱ ᱫᱚ ᱢᱮᱥᱮᱡᱽ ᱵᱞᱚᱠ ᱨᱮᱱ ᱰᱮᱴᱟ ᱨᱮ ᱵᱮᱵᱚᱥᱛᱟ ᱟᱠᱟᱱ ᱱᱮᱴᱣᱟᱨᱠ ᱨᱮᱱᱟᱜ ᱯᱨᱚᱯᱷᱮᱥᱚᱨ ᱮᱢ ᱞᱮᱫᱟ᱾ ᱟᱨ ᱰᱳᱱᱟᱞᱰ ᱰᱮᱵᱤᱡ ᱫᱚ ᱑᱙᱖᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱱᱮᱥᱱᱟᱞ ᱯᱷᱤᱡᱤᱠᱚᱞ ᱞᱮᱵᱚᱨᱴᱚᱨᱤ (ᱮᱱᱯᱤᱮᱞ) ᱨᱮ ᱯᱮᱠᱮᱴ ᱥᱩᱪᱤᱝ ᱨᱮᱱᱟᱜ ᱯᱨᱚᱯᱷᱮᱥᱚᱨ ᱮᱢ ᱞᱮᱫᱟ᱾" },
        { "cell": "dotted", "text": "ᱜᱟᱺᱵᱷᱟᱹᱨᱤᱭᱟᱹ ᱠᱷᱚᱱ ᱚᱞᱚᱜ ᱥᱟᱹᱛ ᱠᱟᱛᱮ ᱨᱚᱜᱷᱩ ᱟᱨ ᱥᱟᱶᱱᱟ ᱫᱚ ᱵᱚᱦᱚᱲᱫᱟ ᱚᱞᱚᱜ ᱟᱥᱲᱟ ᱠᱤᱱ ᱥᱮᱱ ᱮᱱᱟ ᱾ ᱑᱙᱒᱐ ᱥᱟᱞᱮᱨᱮ ᱵᱚᱦᱚᱲᱫᱟ ᱨᱮ ᱚᱞᱚᱜ ᱚᱠᱛᱚ ᱨᱚᱜᱷᱩᱱᱟᱛᱷ ᱟᱨ ᱥᱟᱶᱱᱟ ᱛᱤᱠᱤᱱ ᱫᱚ ᱵᱚᱦᱚᱲᱫᱟ ᱡᱟᱯᱟᱜ ᱵᱟᱱᱟ ᱰᱩᱸᱜᱽᱨᱤ ᱨᱮ ᱰᱮᱨᱟ ᱵᱟᱥᱟ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱟᱱᱟ ᱰᱩᱸᱜᱽᱨᱤ ᱰᱮᱨᱟ ᱵᱟᱥᱟ ᱫᱚ ᱪᱩᱱᱩ ᱰᱮᱨᱟ ᱢᱮᱱᱛᱮ ᱠᱚ ᱧᱩᱛᱩᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱯᱟᱲᱦᱟᱣ ᱚᱠᱛᱚ ᱨᱮᱦᱚᱸ ᱨᱚᱜᱷᱩᱱᱟᱛᱷ ᱟᱨ ᱥᱟᱶᱱᱟ ᱡᱟᱹᱛᱤ ᱥᱟᱶᱛᱟ ᱟᱨ ᱫᱷᱚᱨᱚᱢ ᱠᱟᱛᱷᱟ ᱠᱚ ᱜᱮ ᱠᱤᱱ ᱩᱭᱦᱟᱹᱨ ᱵᱟᱲᱟ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱞᱚᱜ ᱯᱟᱲᱦᱟᱣ ᱚᱠᱛᱚ ᱨᱮᱦᱚᱸ ᱡᱟᱹᱛᱤ ᱥᱟᱶᱛᱟ ᱜᱮ ᱟᱹᱨᱥᱤ ᱞᱮᱠᱟ ᱡᱷᱟᱞᱠᱟᱣ ᱟᱹᱠᱤᱱ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱨᱚᱜᱷᱩᱱᱟᱛᱷ ᱟᱡ ᱵᱟᱵᱟ ᱫᱚ ᱚᱡᱷᱟ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱮ ᱟᱸᱡᱚᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱨᱚᱜᱷᱩᱱᱟᱛᱷ ᱫᱚ ᱠᱟᱹᱯᱤ ᱵᱳᱨᱳ ᱵᱚᱸᱜᱟ ᱛᱷᱩᱢ ᱛᱮᱜᱮᱭ ᱚᱯᱮᱞ ᱟᱠᱟᱱᱟ ᱾ ᱚᱱᱟᱛᱮ ᱚᱞᱚᱜ ᱡᱚᱦᱚᱜ ᱦᱚᱸ ᱞᱮᱛᱟᱲ ᱜᱮ ᱚᱠᱚᱭ ᱪᱚᱭ ᱞᱟᱹᱭ ᱟᱭ ᱞᱮᱠᱟᱭ ᱵᱩᱡᱷᱟᱹᱣ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱵᱟᱱᱟ ᱰᱩᱸᱜᱽᱨᱤ ᱪᱩᱱᱩ ᱰᱮᱨᱟ ᱨᱮ ᱫᱤᱱᱟᱹᱢ ᱚᱞᱚᱜ ᱵᱮᱲᱟ ᱨᱮ ᱚᱠᱟ ᱞᱮᱠᱟᱱ ᱫᱟᱲᱮ ᱪᱚᱝ ᱟᱹᱭᱠᱟᱹᱣ ᱠᱟᱛᱮ ᱟᱡᱟᱜ ᱦᱚᱲᱢᱚ ᱠᱚ ᱦᱟᱢᱟᱞ ᱜᱮᱭ ᱵᱩᱡᱷᱟᱹᱣ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱫᱟᱲᱮ ᱫᱚ ᱵᱤᱫᱩ ᱪᱟᱸᱫᱟᱱ ᱚᱞ ᱵᱤᱨᱫᱟᱹ ᱜᱩᱱ ᱫᱟᱲᱮ ᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱱᱠᱟ ᱛᱮᱜᱮ ᱮᱢ.ᱤ. ᱚᱞᱚᱜ ᱫᱚ ᱑᱙᱒᱒ ᱥᱟᱞᱮ ᱨᱮᱭ ᱥᱟᱹᱛ ᱠᱮᱫᱼᱟ ᱾" },
        { "cell": "era-marker", "text": "ᱪᱟᱱᱚᱠᱠᱚ (IAST: Cāṇakya; pronunciation (help·info) ; fl. c. 4th century BCE ) ᱫᱚ ᱵᱷᱟᱨᱚᱛ ᱨᱮᱱ ᱟᱹᱰᱤ ᱢᱟᱨᱮ economist, ᱥᱟᱱᱟᱥᱤᱭᱟᱹ ᱮ ᱛᱟᱸᱦᱮᱸᱠᱟᱱᱟ᱾ ᱠᱟᱹᱣᱰᱤ ᱥᱟᱥᱛᱨᱚ ᱧᱩᱛᱩᱢᱟᱱ ᱨᱟᱡᱽᱟᱹᱨᱤ ᱥᱟᱬᱮᱥ ᱥᱟᱛᱟᱢ ᱪᱮᱛᱟᱱᱨᱮ ᱟᱹᱰᱤ ᱵᱷᱟᱜᱮ ᱯᱚᱛᱚᱵ ᱚᱱᱚᱞᱤᱭᱟᱹᱭ ᱛᱟᱸᱦᱮᱸᱠᱟᱱᱟ᱾ ᱩᱱᱤᱭᱟᱜ ᱟᱹᱠᱤᱞ ᱧᱮᱞᱛᱮ ᱩᱱᱤᱫᱚ ᱵᱷᱟᱨᱚᱛ ᱨᱮᱱ ᱢᱮᱠᱤᱭᱟᱵᱷᱮᱞᱤ ᱦᱚᱸᱠᱩ ᱧᱩᱛᱩᱢ ᱟᱠᱟᱫᱤᱭᱟ᱾ ᱵᱷᱟᱨᱚᱛ ᱨᱮᱱᱟᱜ economics ᱞᱟᱦᱟ ᱞᱟᱹᱜᱤᱛ ᱛᱮ ᱪᱟᱱᱚᱠᱠᱚᱣᱟᱜ ᱟᱹᱰᱤ ᱜᱚᱸᱲᱚᱸ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "era-marker", "text": "ᱡᱚᱠᱷᱚᱱ ᱨᱚᱢᱟᱱ ᱠᱚ ᱤᱵᱮᱨᱤᱭᱟᱱ ᱯᱮᱱᱤᱥᱩᱞᱟ ᱛᱮ ᱒᱑᱖ ᱡᱤᱥᱩᱢᱟᱹᱥᱤ ᱞᱟᱦᱟ ᱨᱮ ᱠᱚ ᱩᱱᱡᱠᱷᱟᱜ ᱩᱱᱠᱩ ᱞᱟᱴᱤᱱ ᱯᱟᱹᱨᱥᱤ ᱟᱠᱚ ᱥᱟᱶᱛᱮ ᱠᱚ ᱟᱹᱜᱩ ᱛᱟᱨᱟ ᱞᱨᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸ ᱤᱫᱤ ᱛᱮ ᱡᱚᱛᱚ ᱨᱚᱢᱟᱱ ᱯᱟᱹᱨᱥᱤ ᱯᱟᱥᱱᱟᱣᱮᱱᱟ ᱾ ᱨᱚᱢᱟᱱ ᱯᱷᱟᱹᱫ, ᱜᱤᱨᱟᱹᱵᱟᱹᱥ ᱦᱚᱲ ᱟᱨ ᱵᱮᱯᱟᱨᱤᱭᱟᱹ ᱠᱚ ᱫᱟᱨᱟᱭ ᱛᱮ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱯᱟᱥᱱᱟᱣ ᱤᱫᱤᱭᱮᱱᱟ ᱾ ᱔᱐᱙ A.D. ᱠᱷᱚᱱ ᱗᱑᱑ A.D. ᱛᱟᱞᱟ ᱨᱮ ᱨᱚᱢᱟᱱ ᱠᱚᱣᱟᱜ ᱥᱟᱢᱨᱟᱡᱽ ᱨᱟᱹᱯᱩᱫ ᱮᱱ ᱛᱮ ᱡᱚᱨᱢᱟᱱᱤᱭᱟᱹ ᱦᱚᱲ ᱠᱚ ᱥᱚᱲᱚ ᱦᱮᱡ ᱮᱱᱟ ᱾ ᱩᱱᱠᱩ ᱫᱚ ᱡᱚᱨᱢᱟᱱᱤᱠ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱨᱚᱲᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱟᱡ ᱴᱟᱴᱠᱟ ᱫᱷᱟᱨᱟ ᱞᱟᱴᱤᱱ ᱯᱟᱹᱨᱥᱤ ᱦᱚᱸ ᱵᱟᱝ ᱠᱚ ᱥᱟᱵ ᱫᱟᱲᱮᱭᱟᱫ ᱛᱟᱦᱮᱸᱫ, ᱚᱱᱠᱟ ᱛᱮ ᱛᱟᱨᱟ ᱞᱟᱴᱤᱱ ᱨᱚᱢᱟᱱ ᱛᱟᱨᱟ ᱯᱚᱨᱛᱩᱜᱤᱡ ᱢᱮᱥᱟ ᱢᱤᱥᱤ ᱠᱚ ᱨᱚᱲ ᱤᱫᱤ ᱠᱮᱫᱼᱟ ᱓᱐᱐ ᱥᱮᱨᱢᱟ ᱜᱟᱱ ᱦᱟᱹᱵᱤᱡ ᱟᱨ ᱚᱱᱟ ᱢᱮᱥᱟ ᱢᱤᱥᱤ ᱭᱟᱜ ᱜᱮ ᱚᱸᱰᱮᱱᱟᱜ ᱫᱚᱲᱦᱚ ᱯᱟᱹᱨᱥᱤ ᱢᱮᱱᱛᱮ ᱠᱚ ᱥᱟᱵ ᱠᱮᱫᱼᱟ ᱟᱨ ᱯᱚᱨᱛᱩᱜᱤᱡᱽ ᱯᱟᱹᱨᱥᱤ ᱢᱮᱱᱛᱮ ᱵᱤᱠᱟᱹᱶ ᱮᱱᱟ ᱾" },
        { "cell": "era-marker", "text": "ᱢᱚᱦᱟᱢᱮᱜᱷᱚᱵᱟᱦᱚᱱ ᱮᱭᱨᱚ ᱠᱷᱟᱨᱚᱵᱮᱲᱚ (IAST: Khārabeḷa) (᱑᱙᱓ ᱠ.ᱞ. - ᱑᱗᱐ ᱠ.ᱞ.) ᱫᱚ ᱢᱚᱦᱟᱢᱮᱜᱷᱚᱵᱟᱦᱚᱱ ᱥᱟᱢᱨᱟᱡᱽ ᱠᱚᱲᱤᱝᱜᱚ ᱨᱮᱱᱟᱜ ᱪᱮᱫᱤ ᱨᱟᱡᱽᱵᱚᱝᱥᱚ ᱨᱤᱱᱤᱡ ᱢᱤᱫ ᱨᱟᱡᱟ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾ ᱠᱷᱟᱨᱚᱵᱮᱲᱚ ᱣᱟᱜ ᱠᱟᱛᱷᱟ ᱠᱚ ᱱᱤᱛ ᱵᱷᱩᱵᱚᱱᱮᱥᱚᱨ ᱨᱮᱱᱟᱜ ᱩᱫᱚᱭᱜᱤᱨᱤ ᱨᱮ ᱢᱮᱱᱟᱜ ᱦᱟᱹᱛᱤ ᱜᱚᱝᱜᱷᱚᱨ ᱫᱷᱤᱨᱤ ᱚᱞ ᱨᱮ ᱧᱟᱢᱚᱜᱼᱟ ᱾" },
        { "cell": "era-marker", "text": "ᱵᱟᱞᱚᱪᱤᱥᱛᱟᱱ ᱨᱮᱭᱟᱜ ᱠᱚᱧᱮ ᱯᱩᱨᱩᱵᱽ ᱨᱮ ᱡᱷᱚᱵᱽ ᱟᱨ ᱥᱮᱨᱟᱱᱤ ᱦᱚᱱᱚᱛ ᱛᱮ ᱥᱤᱢ ᱵᱤᱞᱤ ᱞᱮᱠᱟ ᱟᱠᱟᱨ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱨᱮᱭᱟᱜ ᱡᱚᱛᱚ ᱯᱟᱦᱴᱟ ᱵᱩᱨᱩ ᱛᱮ ᱮᱥᱮᱫ ᱟᱠᱟᱱᱟ ᱾ ᱥᱩᱞᱮᱢᱟᱱ ᱵᱩᱨᱩ ᱨᱮᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱯᱩᱥᱛᱷᱩᱱ ᱡᱟᱹᱛ ᱨᱮᱱᱤᱡ ᱦᱟᱯᱲᱟᱢ ᱫᱚ ᱠᱣᱟᱭᱤᱥ ᱚᱵᱽᱫᱩᱞ ᱨᱚᱥᱤᱫᱽ (575-661 A.D.) ᱠᱟᱱᱟᱭ ᱢᱮᱱᱛᱮ ᱯᱟᱹᱛᱭᱟᱹᱣ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱱᱚᱰᱮᱱ ᱠᱚ ᱦᱚᱲ ᱩᱱᱤᱭᱟᱜ ᱛᱚᱯᱟ ᱴᱷᱟᱶ ᱫᱚ ᱫᱟ ᱠᱟᱥᱮ ᱜᱷᱚᱨ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜ-ᱟ ᱾" },
        { "cell": "era-marker", "text": "ᱚᱯᱩᱨᱵᱤ ᱥᱤᱝ ᱪᱟᱱᱰᱮᱞᱟ (ᱡᱟᱱᱟᱢ ᱔ ᱡᱟᱱᱩᱣᱟᱨᱤ ᱑᱙᱙᱓) ᱫᱚ ᱢᱤᱫ ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱥᱯᱳᱴ ᱥᱩᱴᱚᱨ ᱠᱟᱱᱟᱭ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱑᱐ ᱢᱤᱴᱟᱨ ᱮᱭᱟᱨ ᱨᱟᱭᱯᱷᱚᱞ ᱤᱵᱷᱮᱸᱴ ᱦᱚᱛᱮᱛᱮ ᱠᱷᱮᱞ ᱟᱭ ᱾ ᱱᱩᱭ ᱫᱚ ᱒᱐᱐᱙ ᱤ.ᱥ.ᱥ.ᱯᱷ. ᱣᱟᱨᱞᱰ ᱠᱚᱯ, ᱱᱟᱣᱟ ᱫᱤᱞᱞᱤ ᱨᱮ ᱥᱚᱱᱟ ᱢᱮᱰᱟᱞ ᱡᱤᱛᱠᱟ.ᱨ ᱞᱮᱱᱟᱭ ᱾" },
        { "cell": "era-marker", "text": "ᱥᱮᱫᱟᱭ ᱨᱤᱱᱤᱡ ᱱᱮᱥᱱᱟᱞ ᱪᱟᱢᱯᱤᱭᱟᱱ ᱨᱟᱠᱮᱥ ᱢᱚᱱᱯᱚᱛ ᱭᱤᱡ ᱢᱮᱱᱴᱚᱨ ᱞᱮᱠᱟᱛᱮᱭ ᱠᱟ.ᱢᱤ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱯᱩᱨᱵᱤ ᱒᱐᱑᱙ ᱤ.ᱥ.ᱥ.ᱯᱷ. ᱣᱟᱨᱞᱰ ᱠᱚᱯ,ᱱᱟᱣᱟ ᱫᱤᱞᱞᱤ ᱨᱮ ᱥᱚᱱᱟ ᱢᱮᱰᱟᱞ ᱮ ᱡᱤᱛᱠᱟᱹᱨ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "era-marker", "text": "ᱱᱚᱣᱟ ᱫᱚ ᱯᱷᱩᱞᱵᱟᱬᱤ ᱠᱷᱚᱱ ᱑᱐᱕ ᱠ.ᱢ.,ᱵᱟᱞᱞᱤᱜᱩᱰᱟ ᱠᱷᱚᱱ ᱔᱙ ᱠ.ᱢ. ᱟᱨ ᱨᱟᱭᱠᱤᱭᱟ ᱠᱷᱚᱱ ᱓᱐.᱕ ᱠ.ᱢ. ᱥᱟ.ᱜᱤᱧ ᱟ.ᱱᱤᱡ ᱾" },
        { "cell": "era-marker", "text": "ᱨᱩᱜᱲᱤᱰᱤ ᱟ.ᱛᱩ ᱠᱷᱚᱱᱟᱜ ᱑᱐ᱠ.ᱢ. ᱥᱟᱦᱟᱨᱮ ᱨᱮᱞ ᱨᱮᱱᱟᱝ ᱥᱩᱵᱤᱫᱷᱟ ᱵᱟ.ᱱᱩᱜ ᱟᱠᱟᱱᱟ ᱨᱩᱜᱲᱤᱰᱤ ᱥᱮᱴᱮᱨᱚᱜ ᱞᱟᱜᱟᱱ ᱛᱮ᱾" },
        { "cell": "year", "text": "8 mile ᱫᱚ ᱒᱐᱐᱒ ᱥᱟᱞ ᱨᱮᱭᱟᱜ ᱯᱷᱤᱞᱢ ᱠᱟᱱᱟ, ᱠᱩᱨᱴᱤᱥ ᱦᱟᱱᱥᱚᱱ ᱫᱤᱥᱟᱹᱭ ᱩᱫᱩᱜ ᱟᱠᱟᱜᱼᱟ ᱾" },
        { "cell": "year", "text": "ᱚᱝᱜᱩᱨ ᱪᱟᱥ ᱫᱚ ᱖᱐᱐᱐ ᱠᱷᱚᱱ ᱘᱐᱐᱐ ᱥᱮᱨᱢᱟ ᱢᱟᱬᱟᱝ ᱨᱮ ᱯᱟᱪᱮ ᱫᱤᱥᱚᱢ ᱨᱮ ᱮᱦᱚᱵ ᱞᱮᱱᱟ ᱾ ᱤᱥᱴᱚ ᱧᱩᱛᱩᱢᱟᱱ ᱢᱤᱫᱴᱟᱝ ᱚᱝᱜᱩᱨ ᱪᱚᱠᱟᱜ ᱨᱮ ᱦᱟᱨᱟᱜ-ᱟ ᱾ ᱱᱚᱣᱟ ᱧᱮᱞ ᱛᱮ ᱦᱟᱺᱰᱤ ᱡᱟᱹᱛᱤ ᱧᱩᱣᱟᱜ ᱵᱮᱱᱟᱣ ᱞᱮᱱᱟ ᱾ ᱡᱤᱥᱩ ᱡᱟᱱᱟᱢᱚᱜ ᱨᱮᱭᱟᱜ ᱔᱐᱐᱐ ᱥᱮᱨᱢᱟ ᱢᱟᱬᱟᱝ ᱨᱮ ᱟᱨᱢᱮᱱᱤᱭᱟ ᱨᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱥᱮᱫᱟᱭ ᱦᱟᱺᱰᱤ ᱵᱷᱟᱹᱴᱤ ᱥᱚᱢᱫᱟᱱ ᱧᱟᱢ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "year", "text": "ᱚᱥᱴᱨᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱱᱟᱜᱟᱢ ᱫᱚ ᱙᱗᱖ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱮᱦᱚᱵ ᱟᱠᱟᱱᱟ ᱾ ᱚᱱᱟ ᱥᱮᱨᱢᱟ ᱞᱮᱣᱯᱳᱞᱰ ᱯᱷᱚᱱ ᱵᱟᱵᱮᱱᱵᱮᱨᱜᱽ ᱫᱚ ᱱᱮᱛᱟᱨᱟᱜ ᱚᱥᱴᱨᱤᱭᱟ ᱥᱤᱢᱟᱱᱟᱹ ᱨᱮᱱᱤᱡ ᱨᱟᱡᱟᱭ ᱛᱟᱦᱮᱸ ᱞᱮᱱᱟ ᱾ ᱑᱒᱗᱖ ᱥᱮᱨᱢᱟ ᱨᱮ ᱦᱟᱵᱽᱥᱵᱩᱨᱜᱽ ᱵᱚᱝᱥᱚ ᱨᱮᱱ ᱨᱩᱰᱞᱚᱯᱷ ᱫᱚ ᱯᱩᱭᱞᱩ ᱨᱟᱡᱟᱭ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱩᱱᱠᱩ ᱫᱚ ᱗᱕᱐ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱟᱥᱴᱨᱤᱭᱟ ᱠᱚ ᱥᱟᱥᱚᱱ ᱠᱮᱫᱼᱟ ᱾ ᱫᱚᱥᱟᱨ ᱫᱷᱟᱹᱨᱛᱤ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱞᱟᱦᱟ ᱡᱚᱨᱢᱟᱱᱤ ᱚᱥᱴᱨᱤᱭᱟ ᱠᱚ ᱫᱚᱠᱷᱚᱞ ᱠᱮᱫᱼᱟ ᱾ ᱤᱱᱟᱹ ᱛᱟᱭᱚᱢ ᱑᱙᱓᱘ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱑᱙᱔᱕ ᱥᱮᱨᱢᱟ ᱫᱷᱟᱹᱵᱤᱡ ᱟᱭᱢᱟ ᱤᱦᱩᱫᱤ ᱠᱚ ᱜᱚᱡ ᱚᱪᱚᱭᱮᱱᱟ ᱾ ᱑᱙᱔᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱡᱚᱨᱢᱟᱱᱤ ᱫᱷᱟᱹᱨᱛᱤ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱨᱮ ᱦᱟᱨᱟᱣ ᱠᱟᱛᱮ ᱱᱟᱥᱮ ᱫᱤᱱ ᱛᱟᱭᱚᱢ ᱚᱥᱴᱨᱤᱭᱟ ᱫᱚ ᱯᱩᱨᱟᱹᱯᱩᱨᱤ ᱯᱷᱩᱨᱜᱟᱹᱞ ᱮᱱᱟ ᱾" },
        { "cell": "year", "text": "ᱚᱥᱴᱨᱮᱞᱤᱭᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱭᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱦᱩᱰᱤᱧ ᱢᱟᱦᱟᱫᱮᱥ ᱟᱨ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱫᱤᱯ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱫᱤᱯ ᱢᱟᱦᱟᱫᱮᱥ ᱦᱚᱸ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱗,᱖᱙᱒,᱐᱒᱔ ᱫᱚᱦᱲᱟ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱮᱨᱤᱭᱟ ᱢᱮᱱᱟᱜ ᱱᱚᱶᱟ ᱢᱟᱦᱟᱫᱮᱥ ᱨᱮᱭᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱫᱚ ᱠᱭᱟᱱᱵᱮᱨᱟ ᱠᱟᱱᱟ ᱾ ᱒᱐᱑᱖ ᱨᱮᱭᱟᱜ ᱞᱮᱠᱷᱟ ᱚᱝᱥᱟᱨ ᱱᱚᱰᱮ ᱫᱚ ᱒᱓,᱔᱐᱑,᱘᱙᱑ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱥᱤᱰᱱᱤ ᱫᱚ ᱱᱚᱰᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱵᱟᱡᱟᱨ ᱠᱟᱱᱟ ᱾ ᱱᱚᱰᱮᱱᱟᱜ ᱠᱟᱹᱣᱰᱤ ᱧᱩᱛᱩᱢ ᱫᱚ ᱚᱥᱴᱨᱮᱞᱤᱭᱟᱱ ᱰᱚᱞᱟᱨ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜ-ᱟ ᱾" },
        { "cell": "year", "text": "᱑᱙᱗᱑ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱒᱕ ᱢᱟᱨᱪ ᱛᱟᱞᱟ ᱧᱤᱫᱟᱹ ᱯᱩᱪᱷᱤᱢ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮᱱ ᱟᱨᱢᱤ ᱯᱩᱨᱩᱵᱽ ᱯᱟᱠᱤᱥᱛᱟᱱ (ᱱᱤᱛᱚᱜᱼᱟᱜ ᱵᱟᱝᱞᱟᱫᱮᱥ ) ᱨᱮᱱ ᱦᱚᱲ ᱠᱚ ᱜᱚᱡ ᱞᱮᱫ ᱠᱚ ᱚᱱᱟ ᱜᱮ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱚᱯᱟᱨᱮᱥᱚᱱ ᱥᱟᱨᱪ ᱞᱟᱭᱤᱴ ᱫᱚ ᱾ ᱚᱱᱟ ᱧᱤᱫᱟᱹ ᱟᱪᱠᱟ ᱜᱮ ᱵᱮᱦᱟᱛᱤᱭᱟᱹᱨᱟᱱ ᱟᱭᱢᱟ ᱦᱚᱲ ᱠᱚ ᱜᱚᱡ ᱚᱪᱚ ᱞᱮᱱᱟ ᱢᱤᱫ ᱧᱤᱫᱟᱹ ᱨᱮ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱜᱮ ᱵᱟᱝᱞᱟ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱯᱷᱩᱨᱜᱟᱹᱞ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱱᱟ ᱾ ᱟᱨ ᱑᱙᱗᱑ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱑᱖ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱙ ᱪᱟᱸᱫᱚ ᱢᱟᱭᱟᱢ ᱟᱹᱛᱩ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱠᱟᱛᱮᱫ ᱵᱟᱝᱞᱟᱫᱤᱥᱚᱢ ᱥᱮ ᱵᱟᱝᱞᱟᱫᱮᱥ ᱡᱟᱱᱟᱢ ᱮᱱᱟ ᱾" },
        { "cell": "year", "text": "ᱚᱴᱚ ᱵᱷᱚᱱ ᱵᱤᱥᱢᱟᱨᱠ ᱚᱴ ᱮᱰᱩᱣᱚᱨᱴ ᱞᱮᱳᱯᱟᱨᱰ ᱵᱤᱥᱢᱟᱨᱠ (᱑ ᱮᱯᱨᱤᱞ ᱑᱘᱑᱕ - ᱓᱐ ᱡᱩᱞᱟᱭ ᱑᱘᱙᱘) ᱡᱚᱨᱢᱟᱱ ᱥᱟᱢᱨᱟᱡᱽ ᱨᱤᱱᱤᱡ ᱯᱩᱭᱞᱩ ᱪᱟᱱᱥᱮᱞᱚᱨ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱱᱟ ᱥᱟᱶᱛᱮ ᱤᱱᱟ. ᱚᱠᱛᱚ ᱨᱤᱱᱤᱡ ᱭᱩᱨᱳᱯ ᱨᱤᱱᱤᱡ ᱰᱳᱢᱤᱱᱮᱸᱴ ᱨᱟᱡᱽᱱᱮᱛᱟ (statesman) ᱦᱚᱸᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱚᱴᱚ ᱵᱷᱚᱱ ᱵᱤᱥᱢᱟᱨᱠ ᱧᱩᱛᱩᱢ ᱛᱮ ᱵᱟ.ᱲᱛᱤ ᱩᱯᱨᱩᱢ ᱢᱮᱱᱟᱜ ᱛᱟᱭᱟ ᱾ ᱩᱱᱤ ᱟ.ᱰᱤᱜᱟᱱ ᱡᱚᱨᱢᱟᱱ ᱯᱟ.ᱨᱥᱤ ᱯᱚᱱᱚᱛ ᱥᱮᱞᱮᱫ ᱢᱤᱫ ᱠᱟᱛᱮ ᱢᱤᱫ ᱫᱟᱲᱮ ᱯᱮᱨᱮᱡ ᱥᱟᱢᱨᱟᱡᱽ ᱮ ᱛᱷᱟᱯᱚᱱ ᱞᱮᱜᱼᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱫᱚᱥᱟᱨ ᱡᱚᱨᱢᱟᱱ ᱥᱟᱢᱨᱟᱡᱽ ᱨᱤᱱᱤᱡ ᱯᱩᱭᱞᱩ ᱪᱟᱱᱥᱮᱞᱚᱨ ᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ 'ᱨᱤᱭᱚᱞᱯᱚᱞᱤᱴᱤᱠ' ᱨᱤᱛ ᱠᱷᱟ.ᱛᱤᱨ ᱵᱟ.ᱲᱛᱤ ᱧᱩᱛᱩᱢ ᱛᱟᱭ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱡᱟᱦᱟᱸ ᱠᱷᱟ.ᱛᱤᱨ ᱩᱱᱤ ᱫᱚ \"ᱢᱮᱬᱦᱮᱫ ᱪᱟᱱᱥᱮᱞᱚᱨ\" ᱪᱮᱛᱟᱱ ᱧᱩᱛᱩᱢ ᱛᱮ ᱩᱯᱨᱩᱢ ᱛᱟᱭ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "year", "text": "ᱵᱤᱥᱢᱟᱨᱠ ᱟᱜ ᱡᱟᱱᱟᱢ ᱥᱩᱱ ᱦᱚᱣᱥᱮᱱ ᱨᱮ ᱑ ᱮᱯᱨᱤᱞ ᱑᱘᱑᱕ ᱥᱟᱞᱮᱨᱮ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱜᱟᱴᱤᱝᱡᱮᱱ ᱟᱨ ᱵᱮᱨᱞᱤᱱ ᱨᱮ ᱠᱟᱱᱩᱱ ᱮ ᱯᱚᱲᱦᱚᱱ ᱮᱱᱟ ᱾ ᱛᱟᱭᱚᱢ ᱛᱮ ᱛᱤᱱᱟ.ᱜ ᱚᱠᱛᱚ ᱞᱟ.ᱜᱤᱫ ᱫᱚ ᱱᱟᱜᱟᱨᱤᱭᱟ. ᱟᱨᱵᱟᱝ ᱥᱮᱱᱟ ᱥᱮᱵᱟᱨᱮᱭ ᱥᱮᱞᱮᱫ ᱮᱱᱟ ᱾ ᱑᱘᱔᱗ ᱥᱟᱞᱮᱨᱮ ᱩᱱᱤ ᱫᱚ ᱮᱰᱢᱤᱱᱤᱥᱴᱨᱮᱥᱳᱱ ᱨᱮᱭᱟᱜ ᱵᱤᱫᱷᱟᱱ ᱥᱚᱵᱷᱟ ᱨᱤᱱᱤᱡ ᱥᱚᱦᱮᱛ ᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱑᱘᱔᱘ ᱼ ᱔᱙ ᱥᱟᱞᱮ ᱨᱮᱭᱟᱜ ᱦᱩᱞᱥᱟ.ᱭ ᱚᱠᱛᱚ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱨᱟᱡᱟᱭᱤᱡ \"ᱰᱤᱵᱷᱟᱭᱤᱱ ᱨᱟᱭᱤᱴ\" ᱨᱮ ᱟ.ᱰᱤ ᱡᱩᱨ ᱛᱮ ᱜᱚᱲᱚᱭ ᱮᱢ ᱠᱮᱜᱼᱟ ᱾ ᱑᱘᱕᱑ ᱥᱟᱞᱮᱨᱮ ᱯᱷᱨᱮᱸᱠᱯᱷᱚᱨᱰ ᱨᱤᱱᱤᱡ ᱯᱷᱮᱰᱮᱨᱟᱞ ᱟᱥᱮᱢᱵᱞᱤ ᱨᱮ ᱮᱰᱢᱤᱱᱤᱥᱴᱨᱮᱥᱳᱱ ᱨᱤᱱᱤᱡ ᱨᱤᱯᱨᱮᱸᱡᱮᱴᱮᱴᱤᱵ ᱵᱮᱱᱟᱣ ᱠᱟᱛᱮ ᱠᱚ ᱵᱷᱮᱡᱟ ᱠᱮᱫᱮᱭᱟ ᱾" },
        { "cell": "year", "text": "ᱚᱸᱰᱮ ᱩᱱᱤ ᱡᱚᱨᱢᱟᱱᱤ ᱨᱮ ᱚᱥᱴᱨᱤᱭᱟ ᱨᱮᱭᱟᱜ ᱥᱩᱯᱨᱤᱢᱮᱥᱤ ᱫᱚ ᱟ.ᱰᱤ ᱵᱟ.ᱲᱛᱤᱭ ᱵᱤᱨᱩᱫᱷ ᱠᱮᱜᱼᱟ ᱾ ᱟᱨ ᱮᱰᱢᱤᱱᱤᱥᱴᱨᱮᱥᱳᱱ ᱥᱚᱢᱟᱱ ᱚᱫᱷᱤᱠᱟᱨ ᱮᱢᱟᱦᱟᱜ ᱨᱮ ᱫᱟᱲᱮᱭ ᱮᱢ ᱠᱮᱜᱼᱟ ᱾ ᱘ ᱥᱮᱨᱢᱟ ᱯᱷᱨᱮᱸᱰᱯᱷᱚᱨᱴ ᱨᱮ ᱛᱟᱦᱮᱸ ᱮᱱ ᱛᱟᱭᱚᱢ ᱑᱘᱕᱙ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱨᱩᱥ ᱨᱮ ᱨᱟᱡᱽᱫᱩᱛ ᱞᱮᱠᱟᱛᱮᱭ ᱡᱩᱦᱲᱟ.ᱣ ᱮ ᱦᱟᱛᱟᱣ ᱠᱮᱜᱼᱟ ᱾ ᱑᱘᱖᱒ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱯᱮᱨᱤᱥ ᱨᱮ ᱨᱟᱡᱽᱫᱩᱛ ᱠᱚ ᱵᱮᱱᱟᱣ ᱠᱮᱫᱮᱭᱟ ᱟᱨ ᱤᱱᱟ. ᱥᱮᱨᱢᱟ ᱜᱮ ᱥᱮᱱᱟ ᱠᱚᱣᱟᱜ ᱵᱟᱰᱷᱟᱣ ᱨᱮᱭᱟᱜ ᱠᱩᱠᱞᱤ ᱪᱮᱛᱟᱱ ᱨᱮ ᱥᱚᱝᱥᱚᱫᱤᱭᱟ. ᱮᱴᱠᱮᱴᱚᱬᱮ ᱩᱰᱩᱠ ᱮᱱ ᱠᱷᱟᱱ External Affairs Minister ᱟᱨ ᱢᱟᱨᱟᱝ ᱢᱚᱱᱛᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱠᱚ ᱵᱷᱤᱥᱮᱞᱮᱫ ᱠᱚ ᱮᱢᱟ ᱫᱮᱭᱟ ᱾ ᱥᱮᱱᱟ ᱠᱚᱣᱟᱜ ᱫᱚᱦᱲᱟ ᱵᱮᱱᱟᱣ ᱨᱮᱭᱟᱜ ᱫᱟᱣ ᱧᱟᱢ ᱟᱨ ᱥᱟᱶᱛᱮ ᱵᱚᱡᱮᱴ ᱯᱟᱥ ᱞᱟ.ᱜᱤᱫ ᱛᱮ ᱛᱤᱱ ᱡᱚᱦᱚᱜ ᱩᱱᱤ ᱡᱤᱛᱠᱟ.ᱨ ᱵᱟᱭ ᱧᱟᱢ ᱞᱮᱜᱼᱟ ᱩᱱ ᱡᱚᱦᱚᱜ ᱩᱱᱤ ᱫᱚ ᱯᱟᱨᱞᱤᱭᱟᱢᱮᱸᱴ ᱴᱷᱮᱱ ᱵᱟᱝ ᱠᱩᱞᱤ ᱠᱟᱛᱮ ᱜᱮ ᱠᱟ.ᱢᱤ ᱛᱚᱨᱟᱣ ᱮ ᱮᱛᱚᱦᱚᱵ ᱠᱮᱜᱼᱟ ᱟᱨ ᱫᱤᱥᱣᱟ. ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱩᱱᱤ ᱫᱚ ᱠᱷᱟᱡᱽᱱᱟ ᱦᱚᱸ ᱟ.ᱫᱟ.ᱭ ᱟᱠᱟᱭ ᱛᱟᱦᱮᱸ ᱮᱱ ᱜᱮᱭᱟ ᱾ ᱱᱚᱣᱟ ᱦᱩᱞᱥᱟ.ᱭ ᱱᱤᱛᱚᱜ ᱪᱟ.ᱞᱩ ᱟᱠᱟᱱ ᱜᱮ ᱛᱟᱦᱮᱸᱫ ᱤᱠᱷᱟ.ᱱ ᱥᱞᱮᱡᱽᱣᱤᱜᱽ ᱦᱳᱞᱥᱚᱴᱤᱱ ᱟᱜ ᱠᱩᱠᱞᱤ ᱟᱨ ᱦᱚᱸ ᱵᱮᱨᱮᱫ ᱛᱤᱸᱜᱩ ᱨᱩᱣᱟ.ᱲ ᱮᱱᱟ ᱾ ᱡᱚᱨᱢᱟᱱᱤ ᱡᱟ.ᱛᱤᱭᱟ.ᱨᱤᱭᱟ. ᱨᱮᱭᱟᱜ ᱩᱭᱦᱟ.ᱨ ᱨᱮᱭᱟᱜ ᱞᱟᱵᱽ ᱦᱟᱛᱟᱣ ᱠᱟᱛᱮ ᱵᱤᱥᱢᱟᱨᱠ ᱫᱚ ᱚᱥᱴᱨᱤᱭᱟ ᱨᱮᱭᱟᱜ ᱜᱚᱲᱚ ᱥᱚᱦᱚᱫ ᱫᱟᱨᱟᱭ ᱛᱮ ᱰᱮᱱᱢᱟᱨᱠ ᱪᱮᱛᱟᱱ ᱨᱮᱭ ᱦᱟᱢᱞᱟ ᱠᱮᱜᱼᱟ ᱟᱨ ᱵᱟᱱᱟ ᱦᱚᱲ ᱢᱮᱥᱟ ᱠᱟᱛᱮ ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱫᱚ ᱟ.ᱠᱤᱱᱟᱜ ᱯᱚᱱᱚᱛ ᱨᱮᱠᱤᱱ ᱢᱮᱥᱟ ᱠᱮᱜᱼᱟ ᱑᱘᱖᱔ ᱥᱟᱞᱮᱨᱮ ᱾" },
        { "cell": "decimals", "text": "ᱚᱥᱴᱨᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 83,883&nbsp;km² (32,390&nbsp;sq&nbsp;mi) ᱾ ᱚᱥᱴᱨᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱮᱛᱚᱢ ᱥᱮᱫ ᱫᱚ ᱡᱚᱨᱢᱟᱱᱤ ᱟᱨ ᱪᱮᱠ ᱯᱨᱚᱡᱟᱛᱚᱱᱛᱨᱚ, ᱥᱟᱢᱟᱝ ᱥᱮᱫ ᱫᱚ ᱥᱞᱳᱵᱷᱟᱠᱤᱭᱟ ᱟᱨ ᱦᱟᱝᱜᱮᱨᱤ, ᱠᱚᱧᱮ ᱥᱮᱫ ᱫᱚ ᱥᱞᱳᱵᱷᱮᱱᱤᱭᱟ ᱟᱨ ᱤᱴᱟᱞᱤ, ᱯᱟᱪᱷᱮ ᱥᱮᱫ ᱫᱚ ᱥᱩᱭᱡᱟᱨᱞᱮᱸᱰ ᱟᱨ ᱞᱤᱥᱴᱮᱱᱮᱥᱴᱟᱭᱤᱱ ᱾ ᱚᱥᱴᱨᱤᱭᱟ ᱫᱚ ᱟᱞᱯᱚᱥ ᱵᱩᱨᱩᱢᱟᱞᱟ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱤᱥᱚᱢ ᱨᱮ ᱫᱚ ᱟᱭᱢᱟ ᱜᱟᱰᱟ ᱟᱨ ᱵᱤᱨ ᱵᱩᱨᱩ ᱠᱚ ᱦᱚᱸ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "decimals", "text": "ᱛᱟᱹᱨᱩᱵ ᱫᱚ ᱟᱹᱰᱤ ᱮᱴᱠᱮᱴᱚᱬᱮ ᱥᱟᱢᱟᱝ ᱡᱟᱱᱣᱟ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱟᱡᱟᱜ ᱛᱟᱦᱮᱸᱱ ᱴᱷᱟᱶ ᱠᱷᱤᱛᱤᱨ ᱨᱮᱭᱟᱜ ᱟᱨ ᱟᱹᱣᱲᱤ ᱦᱚᱲ ᱜᱮᱠᱚ ᱥᱮᱸᱫᱽᱨᱟ ᱠᱚ ᱨᱮᱭᱟᱜ ᱵᱚᱛᱚᱨ ᱱᱩᱠᱩ ᱞᱟᱹᱜᱤᱫ ᱫᱚ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤᱭᱟ ᱾ ᱯᱩᱨᱟᱹ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮ ᱛᱟᱹᱨᱩᱵᱟᱜ ᱮᱞ ᱖,᱐᱐᱐ ᱠᱷᱚᱱ ᱦᱚᱸ ᱠᱚᱢ ᱜᱮᱭᱟ ᱾ ᱱᱚᱶᱟ ᱵᱷᱤᱛᱨᱤ ᱠᱷᱚᱱ ᱔,᱐᱐᱐ ᱫᱚ ᱵᱷᱟᱨᱚᱛ ᱨᱮᱜᱮ ᱠᱚ ᱧᱟᱢᱚᱜᱼᱟ ᱾ ᱛᱟᱹᱨᱩᱵᱟᱜ ᱟᱨᱮ ᱡᱟᱹᱛᱤ ᱠᱷᱚᱱ ᱱᱤᱛᱚᱜ ᱯᱮ ᱨᱚᱠᱚᱢ ᱡᱟᱹᱛᱤ ᱫᱚᱠᱚ ᱟᱫ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ᱾ ᱤᱨᱟᱹᱞ ᱞᱮᱠᱟᱱ ᱡᱟᱹᱛᱤ ᱠᱷᱚᱱ ᱨᱚᱭᱟᱞ ᱵᱚᱸᱜᱟᱞ ᱴᱟᱭᱤᱜᱚᱨ ᱫᱚ ᱩᱛᱛᱚᱨ ᱯᱩᱨᱩᱵᱽ ᱴᱚᱴᱷᱟ ᱵᱟᱹᱜᱤ ᱠᱟᱛᱮ ᱯᱩᱨᱟᱹ ᱫᱤᱥᱚᱢ ᱨᱮᱠᱚ ᱧᱟᱢᱚᱜᱼᱟ ᱾ ᱡᱮᱞᱮᱠᱟ - ᱱᱮᱯᱟᱞ, ᱵᱷᱩᱴᱟᱱ ᱟᱨ ᱵᱟᱸᱜᱽᱞᱟᱫᱮᱥ ᱾" },
        { "cell": "decimals", "text": "ᱛᱟᱱᱡᱟᱱᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 947,303 km²(365,756 sq mi)᱾ ᱩᱛᱟᱹᱨ ᱱᱟᱠᱷᱟ ᱨᱮ ᱠᱮᱱᱤᱭᱟ ᱟᱨ ᱩᱜᱟᱱᱰᱟ, ᱯᱩᱨᱩᱵᱽ ᱱᱟᱠᱷᱟ ᱨᱮ ᱵᱷᱟᱨᱚᱛ ᱢᱚᱦᱟ ᱫᱚᱨᱮᱭᱟ, ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱫ ᱨᱮ ᱢᱳᱡᱟᱢᱵᱤᱠ, ᱢᱟᱞᱟᱩᱭ ᱟᱨ ᱡᱟᱢᱵᱤᱭᱟ, ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱫ ᱨᱮ ᱠᱚᱝᱜᱳ, ᱵᱩᱨᱩᱱᱰᱤ ᱟᱨ ᱨᱩᱣᱟᱱᱰᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "decimals", "text": "ᱛᱩᱨᱠᱤ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱗᱘᱓,᱓᱕᱖ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ᱒ (᱓᱐᱒,᱔᱕᱕ ᱜᱟᱺᱴ ᱢᱤᱞ) ᱾ ᱛᱩᱨᱠᱤ ᱫᱤᱥᱚᱢ ᱫᱚ ᱪᱟᱨᱠᱳᱱᱟ ᱜᱮᱭᱟ ᱾ ᱯᱟᱪᱮ ᱥᱮᱡ ᱮᱡᱤᱭᱳ ᱫᱚᱨᱮᱭᱟ ᱟᱨ ᱜᱨᱤᱥ, ᱠᱚᱧᱮ ᱥᱟᱢᱟᱝ ᱥᱮᱡ ᱡᱚᱨᱡᱤᱭᱟ, ᱟᱨᱢᱮᱱᱤᱭᱟ ᱟᱨ ᱟᱡᱟᱨᱵᱟᱭᱡᱟᱱ, ᱮᱛᱚᱢ ᱥᱮᱡ ᱤᱨᱟᱠ, ᱥᱤᱨᱤᱭᱟ ᱟᱨ ᱛᱟᱞᱟ ᱚᱛ ᱫᱚᱨᱮᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱛᱩᱨᱠᱤ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱦᱚᱸ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱜᱮᱭᱟ ᱾ ᱱᱚᱸᱰᱮ ᱫᱚ ᱪᱟᱥ ᱵᱟᱥ ᱟᱹᱰᱤ ᱵᱮᱥᱜᱮ ᱦᱩᱭᱩᱜ ᱜᱮᱭᱟ ᱾ ᱛᱚᱵᱮ ᱫᱚᱥᱟᱨ ᱫᱷᱟᱹᱨᱛᱤ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱛᱟᱭᱚᱢ ᱪᱟᱥ ᱵᱟᱥ ᱪᱷᱟᱲᱟᱣ ᱮᱴᱟᱜ ᱠᱚᱨᱮ ᱛᱩᱨᱠᱤ ᱞᱟᱦᱟ ᱪᱟᱞᱟᱣ ᱠᱟᱱᱟ ᱾ ᱛᱩᱨᱠᱤ ᱫᱚ ᱤᱣᱨᱳᱯ ᱟᱨ ᱮᱥᱤᱭᱟ ᱥᱟᱶᱛᱮ ᱡᱚᱜᱲᱟᱣ ᱜᱮᱭᱟ ᱾" },
        { "cell": "decimals", "text": "ᱛᱷᱟᱭᱞᱮᱱᱰ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 513,120 km²(198,120 sq mi) ᱾ ᱛᱷᱟᱭᱞᱮᱱᱰ ᱨᱮᱱᱟᱜ ᱛᱟᱞᱚ ᱦᱟᱥᱟ ᱥᱮᱡ ᱫᱚ ᱥᱚᱢᱟᱱ ᱜᱮᱭᱟ ᱾ ᱱᱚᱝᱠᱟ ᱛᱮᱜᱮ ᱛᱷᱚᱭᱞᱮᱱᱰ ᱨᱮᱱᱟᱜ ᱢᱩᱬᱩᱛ ᱜᱟᱰᱟ ᱪᱟᱣ ᱯᱷᱨᱟᱭᱟ ᱞᱤᱸᱜᱤᱱ ᱠᱟᱱᱟ ᱾ ᱥᱚᱢᱟᱱ ᱦᱟᱥᱟ ᱠᱷᱚᱡ ᱯᱟᱹᱪᱷᱤᱢ, ᱩᱛᱟᱹᱨ ᱟᱨ ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱫᱚ ᱩᱥᱩᱞ ᱪᱚᱯᱚᱛ ᱦᱟᱥᱟ ᱜᱮᱭᱟ ᱾" },
        { "cell": "decimals", "text": "ᱜᱩᱜᱩᱞ ᱫᱚ ᱮᱛᱚᱦᱚᱵ ᱨᱮ ᱮᱸᱰᱤ ᱵᱷᱮᱠᱴᱚᱞᱥᱦᱮᱭᱢ,[᱒] ᱥᱚᱱ ᱢᱟᱭᱠᱨᱚᱥᱤᱥᱴᱚᱢᱥ ᱨᱤᱱᱤᱡ ᱥᱟᱶ-ᱥᱚᱯᱚᱦᱚᱫᱤᱭᱟᱹ ᱠᱷᱚᱱ ᱑᱙᱙᱘ ᱥᱟᱞ ᱨᱮ ᱑᱐,᱐᱐᱐ ᱰᱚᱞᱟᱨ ᱨᱮᱱᱟᱜ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱸᱴ ᱛᱮ ᱯᱷᱚᱸᱰ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱮᱛᱚᱦᱚᱵ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱱᱴ ᱫᱚ ᱯᱷᱚᱱᱰ ᱠᱚ ᱵᱮᱵᱷᱟᱨ ᱫᱟᱲᱮᱭᱟᱜ ᱞᱟᱹᱜᱤᱫ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ ᱥᱮᱞᱮᱫᱚᱜ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱞᱟᱦᱟᱱᱛᱤ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱢᱤ ᱞᱮᱫᱼᱟ ᱾[ ᱓᱙] ᱯᱮᱡ ᱟᱨ ᱵᱽᱨᱤᱱ ᱫᱚ ᱯᱩᱭᱞᱩ ᱨᱮ ᱰᱮᱵᱤᱰ ᱪᱮᱨᱤᱛᱚᱱ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱜᱚᱲᱚᱭ ᱦᱟᱛᱟᱣ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱪᱮᱫᱟᱜ ᱥᱮ ᱩᱱᱤ ᱫᱚ ᱥᱴᱟᱱᱯᱷᱳᱨᱰ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱚᱯᱷᱤᱥ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱩᱱᱠᱩ ᱫᱚ ᱩᱱᱤ ᱨᱮᱱ ᱮᱥᱴᱟᱨᱴᱟᱯᱴ ᱮᱠᱥᱯᱨᱮᱥ ᱢᱮᱱᱟᱜ ᱛᱟᱭᱟ ᱢᱮᱱᱛᱮ ᱠᱚ ᱵᱟᱰᱟᱭ ᱛᱟᱦᱮᱸᱫ, ᱩᱱᱤ ᱫᱚ ᱱᱮᱛᱟᱨ ᱜᱮ ᱩᱱᱤ ᱥᱟᱶ ᱛᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱ ᱜᱨᱟᱱᱤᱴ ᱥᱤᱥᱴᱚᱢᱥ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱫᱚ ᱥᱤᱥᱠᱳ ᱴᱷᱮᱱ ᱒᱒᱐ ᱢᱤᱞᱤᱭᱚᱱ ᱰᱚᱞᱟᱨ ᱨᱮᱭ ᱞᱟᱜᱟᱣ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱰᱮᱵᱷᱤᱰ ᱫᱚ ᱯᱮᱡ ᱟᱨ ᱵᱨᱤᱱ ᱟᱨ ᱟᱡᱟᱜ ᱜᱨᱟᱱᱤᱴ ᱥᱟᱶ-ᱥᱚᱯᱚᱱᱟᱨ ᱮᱱᱰᱤ ᱵᱷᱮᱠᱴᱚᱞᱥᱦᱮᱭᱢ ᱥᱟᱶ ᱢᱤᱫ ᱜᱟᱶᱛᱟ ᱵᱮᱱᱟᱣ ᱞᱮᱫᱟ ᱾ ᱰᱮᱵᱤᱰ ᱟᱜ ᱚᱲᱟᱜ ᱯᱟᱞᱳ ᱟᱞᱴᱳ ᱨᱮ ᱢᱟᱲᱟᱝ ᱘ ᱴᱟᱲᱟᱝ ᱨᱮ ᱜᱟᱞᱢᱟᱨᱟᱣ ᱦᱩᱭ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱚᱱᱟ ᱫᱚ ᱠᱮᱴᱮᱡ ᱦᱩᱭᱩᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱪᱮᱫᱟᱜ ᱥᱮ ᱮᱱᱰᱤ ᱟᱜ ᱟᱨ ᱢᱤᱫ ᱜᱟᱞᱢᱟᱨᱟᱣ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱥᱤᱥᱠᱳ ᱨᱮ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱩᱱᱤ ᱱᱤᱛᱚᱜ ᱠᱟᱹᱢᱤ ᱦᱚᱨᱟ ᱛᱟᱭᱚᱢ, ᱙ ᱴᱟᱲᱟᱝ ᱨᱮ ᱾ ᱮᱱᱰᱤ ᱫᱚ ᱣᱮᱵᱽᱥᱟᱭᱤᱴ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱰᱮᱢᱳ ᱠᱩᱥᱤᱭᱟᱜᱼᱟ, ᱡᱟᱦᱟᱸᱭ ᱩᱱᱤ ᱧᱮᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱟᱨ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱪᱮᱠ ᱦᱟᱛᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱟᱡᱟᱜ ᱠᱟᱨ ᱨᱮᱭ ᱨᱩᱣᱟ. ᱰᱮᱵᱷᱤᱰ ᱪᱮᱨᱤᱴᱚᱱ ᱦᱚᱸ ᱒᱕᱐,᱐᱐᱐ ᱰᱚᱞᱟᱨ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱱᱴ ᱛᱮᱭ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟ ᱾[ 41][42]" },
        { "cell": "decimals", "text": "᱑᱙᱙᱘ ᱥᱟᱞᱮ ᱨᱮ ᱜᱩᱜᱚᱞ ᱫᱚ ᱵᱟᱨᱭᱟ ᱮᱝᱜᱮᱞ ᱤᱱᱥᱴᱚᱨᱥᱴ ᱠᱷᱚᱱ ᱥᱚᱦᱚᱫ ᱧᱟᱢ ᱞᱮᱫᱼᱟ ᱾ ᱡᱮᱢᱚᱱ ᱰᱟᱴ ᱠᱚᱢ ᱨᱤᱱᱤᱡ ᱯᱷᱩᱱᱩᱨᱜᱟᱹᱞᱤᱭᱟᱹ ᱡᱮᱯᱷ ᱵᱤᱡᱚᱥ ᱟᱨ ᱮᱱᱮᱡᱤᱭᱟᱹ ᱨᱟᱢ ᱥᱨᱤᱨᱟᱢ ᱾[ ᱔] ᱯᱮᱡ ᱟᱨ ᱵᱨᱤᱱ ᱫᱚ ᱯᱩᱭᱞᱩ ᱨᱮ ᱥᱨᱤᱨᱟᱢ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱢᱤᱫ ᱵᱷᱮᱱᱪᱩᱨ ᱠᱮᱯᱤᱴᱮᱞᱤᱥᱴ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱯᱷᱮᱱᱰᱤᱝ ᱟᱨ ᱠᱟᱣᱩᱱᱥᱤᱞ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱩᱱᱤ ᱥᱟᱞᱟᱜ ᱠᱚ ᱨᱚᱯᱚᱲ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱟᱨ ᱥᱨᱤᱨᱟᱢ ᱫᱚ ᱯᱷᱮᱵᱽᱨᱩᱣᱟᱨᱤ ᱑᱙᱙᱘ ᱨᱮ ᱜᱩᱜᱚᱞ ᱨᱮ ᱒᱕᱐,᱐᱐᱐ ᱰᱚᱞᱟᱨ ᱮ ᱥᱚᱫᱚᱨ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱥᱨᱤᱨᱟᱢ ᱫᱚ ᱵᱤᱡᱚᱥ ᱮ ᱵᱟᱰᱟᱭᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱪᱮᱫᱟᱜ ᱥᱮ ᱟᱢᱮᱢᱚᱥᱚᱱ ᱫᱚ ᱡᱚᱝᱜᱽᱞᱤ ᱠᱤᱱ ᱦᱟᱛᱟᱣ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱥᱨᱤᱨᱟᱢ ᱫᱚ ᱯᱨᱮᱥᱤᱰᱮᱱᱴ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱥᱨᱤᱨᱟᱢ ᱜᱮ ᱵᱮᱡᱚᱥ ᱴᱷᱮᱱ ᱜᱩᱜᱚᱞ ᱨᱮᱭᱟᱜ ᱠᱟᱛᱷᱟᱭ ᱥᱚᱫᱚᱨ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱵᱤᱡᱚᱥ ᱫᱚ ᱥᱨᱤᱨᱟᱢ ᱦᱟᱜ ᱜᱩᱜᱚᱞ ᱨᱤᱱᱤᱡ ᱯᱷᱚᱱᱰᱟᱨ ᱠᱚ ᱧᱮᱞ ᱞᱟᱹᱜᱤᱫ ᱮ ᱨᱟᱹᱥᱠᱟᱹ ᱞᱮᱫᱼᱟ ᱟᱨ ᱥᱨᱤᱨᱟᱢ ᱟᱡᱟᱜ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱸᱴ ᱮᱢ ᱛᱟᱭᱚᱢ ᱖ ᱪᱟᱸᱫᱚ ᱛᱟᱭᱚᱢ ᱩᱱᱠᱩ ᱫᱚ ᱵᱤᱡᱚᱥ ᱟᱨ ᱟᱡ ᱟᱭᱳ ᱵᱟᱵᱟ ᱫᱚ ᱵᱮᱭ ᱮᱨᱤᱭᱟ ᱨᱮ ᱵᱚᱠᱮᱥᱚᱱ ᱨᱮ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱜᱩᱜᱩᱞ ᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱯᱷᱟᱱᱰᱤᱝ ᱨᱚᱸᱰ ᱯᱟᱹᱦᱤᱞ ᱠᱷᱚᱱ ᱜᱮ ᱥᱚᱨᱠᱟᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱛᱷᱟᱯᱚᱱ ᱟᱠᱟᱱᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱟᱢᱮᱢᱟᱱ ᱨᱮᱱ CEO ᱞᱮᱠᱟᱛᱮ ᱵᱤᱡᱚᱥ ᱟᱜ ᱴᱷᱟᱶ ᱫᱚ ᱯᱮᱡᱽ ᱟᱨ ᱵᱨᱤᱱ ᱟᱜ ᱨᱚᱸᱰ ᱮ ᱵᱟᱹᱲᱛᱤ ᱞᱟᱹᱜᱤᱫ ᱟᱨ ᱩᱱᱤᱭᱟᱜ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱱᱴ ᱮ ᱯᱟᱨᱥᱟᱞ ᱞᱟᱹᱜᱤᱫ ᱛᱮᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾[ 44][45]" },
        { "cell": "decimals", "text": "᱑᱙᱙᱘ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱢᱩᱪᱟᱹᱫ ᱠᱷᱚᱱ ᱑᱙᱙᱙ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱫᱷᱟᱹᱵᱤᱡ ᱮᱴᱟᱜ ᱮᱴᱟᱜ ᱠᱚᱢ ᱮᱱᱮᱡ ᱮᱢ ᱛᱟᱭᱚᱢ, ᱗ ᱡᱩᱱ ᱑᱙᱙᱙ ᱨᱮ ᱒᱕ ᱢᱤᱞᱤᱭᱚᱱ ᱰᱚᱞᱟᱨ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱱᱟᱣᱟ ᱯᱷᱮᱱᱰᱤᱝ ᱨᱟᱣᱩᱱᱰ ᱨᱮᱱᱟᱜ ᱚᱱᱚᱞ ᱮ ᱥᱚᱫᱚᱨ ᱞᱮᱫᱼᱟ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱠᱞᱟᱭᱱᱚᱨ ᱯᱟᱨᱠᱤᱱᱥ ᱟᱨ ᱥᱤᱠᱣᱚᱭᱟ ᱠᱮᱯᱤᱴᱟᱞ ᱮᱢᱟᱱ ᱢᱟᱨᱟᱝ ᱤᱱᱵᱷᱮᱥᱴᱚᱨ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾[ [᱔᱐] ᱵᱟᱱᱟᱨ ᱯᱷᱚᱨᱢ ᱫᱚ ᱮᱛᱚᱦᱚᱵ ᱨᱮ ᱜᱩᱜᱚᱞ ᱨᱮ ᱡᱚᱸᱠᱷᱟ ᱛᱮ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱱᱴ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱨᱟᱹᱥᱠᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱪᱮᱫᱟᱜ ᱥᱮ ᱡᱚᱛᱚ ᱜᱮ ᱱᱤᱡᱮᱨᱟᱜ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ ᱢᱤᱫ ᱢᱟᱨᱟᱝ ᱯᱨᱚᱥᱮᱠᱴ ᱨᱮᱱᱟᱜ ᱠᱚᱱᱴᱨᱚᱞ ᱫᱚᱦᱚᱭ ᱞᱟᱹᱜᱤᱫ ᱠᱚ ᱠᱩᱥᱤᱭᱟᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱢᱮᱱᱠᱷᱟᱱ ᱞᱟᱨᱨᱤ ᱟᱨ ᱥᱚᱨᱜᱮ ᱫᱚ ᱵᱟᱱᱟᱨᱟᱜ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱱᱴ ᱠᱚ ᱦᱟᱛᱟᱣ ᱨᱮ ᱠᱩᱨᱩᱢᱩᱴᱩ ᱞᱮᱫᱟ ᱾ ᱵᱟᱱᱟᱨ ᱣᱮᱱᱪᱟᱨ ᱠᱚᱢᱯᱟᱱᱤ ᱜᱮ ᱜᱩᱜᱚᱞ ᱨᱮᱭᱟᱜ ᱢᱟᱨᱟᱝ ᱫᱟᱲᱮ ᱨᱮ ᱟᱠᱚᱣᱟᱜ ᱫᱟᱣ ᱦᱟᱛᱟᱣ ᱠᱟᱛᱮ ᱟᱨ ᱣᱮᱱᱪᱟᱨ ᱠᱚᱢᱯᱟᱱᱤ ᱨᱮ ᱠᱚᱱᱴᱟᱠᱴ ᱛᱟᱦᱮᱸ ᱠᱟᱱ ᱨᱳᱱ ᱠᱚᱱᱵᱮᱭ ᱟᱨ ᱨᱟᱢ ᱥᱨᱤᱨᱟᱢ ᱟᱜ ᱢᱤᱰᱤᱭᱟᱴᱤ ᱛᱮ ᱜᱩᱜᱚᱞ ᱨᱮ ᱑᱒.᱕ ᱢᱤᱞᱤᱭᱚᱱ ᱰᱚᱞᱟᱨ ᱤᱱᱵᱷᱮᱥᱴᱢᱮᱱᱴ ᱨᱮᱠᱚ ᱥᱮᱞᱮᱫ ᱞᱮᱫᱟ ᱾[ 50]" },
        { "cell": "ordinal-latin", "text": "ᱤᱭᱩᱨᱚᱯ ᱨᱮ ᱡᱩᱠᱛᱤ ᱫᱚ ᱯᱩᱭᱞᱩ ᱠᱟᱛᱮ ᱮᱨᱤᱥᱴᱚᱴᱚᱞ ᱮ ᱥᱮᱬᱟ ᱞᱮᱜ-ᱟ ᱾ ᱮᱨᱤᱥᱴᱚᱴᱚᱞᱟᱜ ᱡᱩᱠᱛᱤ ᱫᱚ ᱑᱙ ᱥᱟᱭᱟᱝ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱨᱮ ᱥᱟᱬᱮᱥ ᱟᱨ ᱮᱞᱠᱷᱟ ᱨᱮ ᱟᱹᱰᱤ ᱛᱮᱫ ᱜᱮ ᱦᱟᱛᱟᱶ ᱟᱟᱱᱟ ᱾ ᱛᱟᱞᱟ ᱡᱩᱜᱽ ᱨᱮᱫᱚ ᱫᱟᱨᱥᱚᱱᱤᱠ ᱠᱚᱶᱟᱜ ᱯᱷᱚᱠᱚᱥ ᱡᱩᱠᱛᱤ ᱪᱮᱛᱟᱱ ᱨᱮᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱷᱟᱨᱚᱛ ᱨᱮ ᱞᱚᱡᱤᱠ ᱨᱮᱭᱟᱜ ᱟᱥᱲᱟ ᱫᱚ ᱢᱮᱫᱷᱟᱛᱤᱛᱤ ᱜᱚᱶᱛᱚᱢ ᱮ ᱮᱦᱚᱵ ᱞᱮᱜ-ᱟ (c. 6th century BCE) ᱾ ᱵᱷᱟᱨᱚᱛ ᱨᱮᱭᱟᱜ ᱡᱩᱠᱛᱤ ᱫᱚ ᱮᱴᱟᱜ ᱫᱤᱥᱚᱢ ᱨᱮᱱ ᱟᱪᱮᱫ ᱠᱚᱦᱚᱸᱭ ᱚᱨ ᱟᱹᱜᱩ ᱟᱠᱟᱫ ᱠᱚᱶᱟ ᱾ ᱵᱷᱟᱨᱚᱛᱨᱮᱭᱟᱜ ᱡᱩᱠᱛᱤ ᱡᱟᱦᱟᱸᱭ ᱠᱚᱠᱚ ᱠᱩᱥᱤ ᱟᱠᱟᱶᱟᱫ ᱟ ᱩᱱᱠᱩ ᱢᱩᱫᱽ ᱠᱷᱚᱱ ᱢᱩᱬ ᱠᱚᱫᱚ ᱠᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ- ᱪᱟᱨᱞᱥ ᱵᱟᱵᱮᱡᱽ (Charles Babbage), ᱚᱜᱟᱥᱴᱟᱥ ᱰᱤ ᱢᱚᱨᱜᱟᱱ ( Augustus De Morgan) ᱟᱨ ᱡᱚᱨᱡᱽ ᱵᱩᱞᱮ ( George Boole) ᱮᱢᱟᱱ ᱾" },
        { "cell": "ordinal-latin", "text": "ᱢᱮᱠᱥᱤᱠᱳ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 1,972,550 km² (761,610 sq mi) (13th)᱾ ᱩᱛᱟᱹᱨ ᱟᱲᱮ ᱨᱮ ᱟᱢᱮᱨᱤᱠᱟ, ᱫᱟᱹᱠᱷᱤᱱ ᱟᱨ ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱡ ᱯᱨᱚᱥᱟᱱᱛᱚ ᱢᱚᱦᱟ ᱫᱚᱨᱮᱭᱟ, ᱫᱟᱹᱠᱷᱤᱱ ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱜᱩᱭᱮᱛᱮᱢᱟᱞᱟ, ᱵᱮᱨᱤᱡᱽ ᱟᱨ ᱠᱮᱨᱤᱵᱤᱭᱟᱱ ᱫᱚᱨᱮᱭᱟ, ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱫᱚ ᱢᱮᱠᱥᱤᱠᱳ ᱦᱩᱰᱤᱧ ᱫᱚᱨᱮᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "ordinal-latin", "text": "ᱤᱱᱫᱳᱱᱮᱥᱤᱭᱟ ᱨᱮ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱡᱤᱵᱽ ᱡᱤᱭᱟᱹᱞᱤ ᱟᱨ ᱚᱛ ᱦᱟᱥᱟ ᱦᱚᱸ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱜᱮᱭᱟ᱾ ᱤᱱᱫᱳᱱᱮᱥᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 1,904,569 km²(735,358 sq mi) (14th)᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱫᱚ ᱟᱭᱢᱟ ᱦᱩᱰᱤᱧ ᱦᱩᱰᱤᱧ ᱫᱤᱯ ᱛᱮ ᱯᱮᱨᱮᱡ ᱟᱠᱟᱱᱟ᱾" },
        { "cell": "ordinal-latin", "text": "ᱛᱷᱚᱠ:Languages attested from the 19th century" },
        { "cell": "ordinal-latin", "text": "ᱛᱷᱚᱠ:Populated places established in the 5th century BC" },
        { "cell": "ordinal-latin", "text": "ᱱᱮᱫᱟᱨᱞᱮᱱᱰᱥ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 41,543 km²(16,040 sq mi) (131st)᱾ ᱟᱫᱚ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱨᱮ ᱟᱹᱫᱤ ᱠᱟᱡᱟᱠ ᱰᱩᱵᱟᱹ ᱦᱩᱭᱩᱜ-ᱟ ᱪᱮᱫᱟᱜ ᱡᱮ ᱫᱚᱨᱮᱭᱟ ᱠᱷᱚᱡ ᱞᱟᱛᱟᱨ ᱨᱮ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱫᱚ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "ordinal-latin", "text": "ᱯᱞᱮᱹᱜᱽ ᱫᱚ ᱢᱤᱫᱴᱟ.ᱝ ᱟ.ᱰᱤ ᱢᱟᱨᱟᱝ ᱵᱚᱛᱚᱨᱟᱱ ᱟᱡᱟᱨ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱟᱡᱟᱨ ᱫᱚ Pasteurella Pestis ᱧᱩᱛᱩᱢᱟᱱ virus ᱠᱚ ᱦᱚᱛᱮᱛᱮ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱟᱡᱟᱨ ᱦᱚᱸ ᱯᱮ ᱞᱮᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱠᱚ ᱫᱚ 1. Bubunic Plague, 2. Pneumonic Plague, 3. Septicaemic Plague." },
        { "cell": "ordinal-latin", "text": "᱑. Bubonic Plague ᱛᱮᱫᱚ ᱨᱩᱣᱟ. ᱦᱟ.ᱡᱩᱜ ᱥᱟᱶ ᱥᱟᱶᱛᱮ Inguinal gland ᱠᱚ ᱯᱷᱩᱞᱟ.ᱣᱜ ᱛᱮ ᱦᱟ.ᱜᱥᱩᱣᱟ ᱾" },
        { "cell": "units", "text": "ᱟᱞᱡᱮᱹᱨᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 2,381,741 km(919,595 sq mi) ᱾ ᱟᱞᱡᱮᱹᱨᱤᱭᱟ ᱩᱛᱟᱹᱨ ᱥᱮᱡ ᱫᱚ ᱛᱟᱞᱟ ᱚᱛ ᱫᱚᱨᱮᱭᱟ, ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱛᱤᱣᱱᱤᱥᱤᱭᱟ ᱟᱨ ᱞᱤᱵᱤᱭᱟ, ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱡ ᱱᱟᱭᱡᱟᱨ, ᱢᱟᱞᱤ ᱟᱨ ᱢᱳᱨᱤᱛᱟᱱᱤᱭᱟ, ᱯᱟᱪᱷᱤᱢ ᱥᱮᱡ ᱢᱚᱨᱳᱠᱠᱳ ᱟᱨ ᱯᱟᱹᱪᱷᱤᱢ ᱥᱟᱦᱟᱨᱟ᱾ ᱜᱚᱴᱟ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱱᱟᱜ ᱜᱮᱞ ᱟᱜ ᱞᱟᱹᱴᱩ ᱫᱤᱥᱟᱹᱢ ᱠᱟᱱᱟ ᱟᱞᱡᱮᱹᱨᱤᱭᱟ ᱾ ᱱᱚᱶᱟ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱦᱚᱸ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱜᱮᱭᱟ ᱾ ᱵᱟᱹᱞᱤ ᱦᱟᱥᱟ, ᱵᱩᱨᱩ, ᱜᱟᱰᱟ ᱮᱢᱟᱱ ᱛᱮᱭᱟᱜ ᱡᱚᱛᱚ ᱜᱮ ᱱᱚᱸᱰᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "units", "text": "ᱟᱨᱡᱮᱱᱴᱤᱱᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 2,780,400 km²(1,073,500 sq mi)᱾ ᱮᱛᱚᱢ ᱟᱢᱮᱨᱤᱠᱟ ᱢᱚᱦᱟᱫᱮᱥ ᱨᱮᱱᱟᱜ ᱜᱚᱴᱟ ᱫᱟᱹᱠᱷᱤᱱ ᱯᱟᱦᱴᱟ ᱫᱷᱟᱨᱮ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱥᱤᱢᱟᱹᱱᱟ ᱾ ᱟᱱᱫᱮᱥ ᱵᱩᱨᱩᱢᱟᱞᱟ ᱯᱟᱪᱮ ᱥᱤᱢᱟᱹᱱᱟᱭ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱫᱟ ᱟᱨ ᱚᱱᱟ ᱩᱞᱴᱟᱹᱣ ᱥᱮᱡ ᱫᱚ ᱪᱤᱞᱤ ᱫᱤᱥᱟᱹᱢ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱮᱛᱚᱢ ᱥᱮᱫ ᱵᱚᱞᱤᱵᱷᱤᱭᱟ ᱟᱨ ᱯᱮᱨᱟᱜᱩᱣᱟᱭ, ᱥᱟᱢᱟᱝ-ᱮᱛᱚᱢ ᱥᱮᱫ ᱵᱨᱟᱡᱤᱞ, ᱥᱟᱢᱟᱝ ᱥᱮᱫ ᱠᱚᱧᱮ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱚᱦᱟᱫᱚᱨᱭᱟ ᱟᱨ ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱫ ᱰᱨᱮᱠ ᱱᱟᱞᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱟᱨᱡᱮᱱᱴᱤᱱᱟ ᱨᱮ ᱟᱭᱢᱟ ᱜᱟᱰᱟ, ᱠᱷᱟᱹᱲᱤ ᱠᱚ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "units", "text": "ᱮᱛᱚᱢ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 1,221,037 km² (471,445 sq mi)᱾ ᱟᱹᱰᱤ ᱠᱟᱡᱟᱠ ᱵᱤᱨ ᱜᱟᱡᱟᱲ ᱠᱩ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "units", "text": "ᱠᱚᱧᱮ ᱠᱳᱨᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 100,210 km² (38,690 sq mi)᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱮᱛᱚᱢ ᱥᱮᱡ ᱮᱛᱚᱢ ᱠᱳᱨᱤᱭᱟ, ᱥᱟᱢᱟᱝ ᱥᱮᱡ ᱡᱟᱯᱟᱱ ᱫᱚᱨᱮᱭᱟ, ᱠᱚᱧᱮ ᱟᱨ ᱠᱚᱧᱮ ᱥᱟᱢᱟᱝ ᱥᱮᱡ ᱠᱳᱨᱤᱭᱟ ᱱᱟᱞᱟ ᱟᱨ ᱯᱟᱪᱷᱮ ᱯᱤᱛ ᱫᱚᱨᱮᱭᱟ ᱢᱮᱱᱟᱜ-ᱟ᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱱᱟᱜ ᱓᱐ ᱵᱷᱟᱜᱽ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱪᱚᱯᱚᱛ ᱜᱮᱭᱟ᱾" },
        { "cell": "units", "text": "ᱠᱤᱣᱵᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 109,884 km (42,426 sq mi)᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱱᱟᱜ ᱩᱛᱟᱹᱨ ᱥᱮᱡ ᱟᱢᱮᱨᱤᱠᱟ ᱟᱨ ᱵᱟᱦᱟᱢᱟ ᱫᱤᱯ ᱢᱟᱞᱟ ᱢᱮᱱᱟᱜ-ᱟ, ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱴᱟᱨᱠᱥ, ᱠᱮᱭᱠᱳᱥ ᱫᱤᱯ ᱟᱨ ᱦᱟᱭᱛᱤ, ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱡ ᱢᱮᱠᱥᱤᱠᱳ, ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱡ ᱡᱮᱢᱟᱭᱠᱟ ᱟᱨ ᱠᱮᱭᱢᱮᱱ ᱫᱤᱯ ᱢᱟᱞᱟ᱾ ᱠᱤᱣᱵᱟ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱫᱚ ᱦᱟᱵᱷᱟᱱᱟ ᱠᱟᱱᱟ᱾ ᱠᱤᱣᱵᱟ ᱨᱮ ᱫᱚ ᱟᱭᱢᱟ ᱫᱤᱯ ᱠᱩ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "units", "text": "ᱤᱛᱷᱤᱭᱳᱯᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 1,104,300 km² (426,400 sq mi)᱾ ᱩᱛᱟᱹᱨ ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱤᱨᱤᱛᱨᱤᱭᱟ ᱟᱨ ᱡᱤᱵᱩᱛᱤ, ᱯᱩᱨᱩᱵᱽ ᱟᱨ ᱫᱟᱹᱠᱷᱤᱱ ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱥᱳᱢᱟᱞᱤᱭᱟ, ᱫᱟᱹᱠᱷᱤᱱ ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱡ ᱠᱮᱹᱱᱤᱭᱟ, ᱯᱟᱹᱪᱷᱤᱢ ᱟᱨ ᱩᱛᱟᱹᱨ ᱯᱟᱹᱪᱷᱤᱢ ᱨᱮ ᱥᱩᱫᱟᱱ᱾ ᱟᱫᱫᱤᱥ ᱟᱵᱤᱵᱟ ᱫᱚ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱠᱟᱱᱟ᱾" },
        { "cell": "units", "text": "ᱤᱡᱽᱨᱟᱭᱮᱞ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 20,770–22,072 km²(8,019–8,522 sq mi)᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱩᱛᱟᱹᱨ ᱨᱮ ᱞᱮᱵᱟᱱᱚᱱ, ᱩᱛᱟᱹᱨ ᱯᱩᱨᱩᱵᱽ ᱨᱮ ᱥᱤᱨᱤᱭᱟ, ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱡᱚᱨᱫᱟᱱ, ᱯᱟᱹᱪᱷᱤᱢ ᱨᱮ ᱯᱷᱤᱞᱤᱥᱛᱤᱱ ᱟᱨ ᱫᱟᱹᱠᱷᱤᱱ ᱯᱟᱹᱪᱷᱤᱢ ᱨᱮ ᱢᱤᱥᱚᱨ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "units", "text": "ᱥᱳᱣᱫᱤ ᱟᱨᱚᱵ ᱛᱟᱭᱚᱢ ᱤᱨᱟᱱ ᱜᱮ ᱫᱷᱟᱹᱨᱛᱤ ᱛᱟᱞᱟ ᱯᱩᱨᱩᱵ ᱨᱮᱱᱟᱜ ᱞᱟᱹᱴᱩ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ᱾ ᱤᱨᱟᱱ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 1,648,195 km² (636,372 sq mi)᱾ ᱤᱨᱟᱱ ᱨᱮᱱᱟᱜ ᱥᱤᱢᱟᱹᱱᱟ ᱫᱚ ᱩᱛᱟᱹᱨ ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱡ ᱛᱩᱨᱚᱥᱠᱚ ᱠᱷᱚᱡ ᱮᱛᱦᱚᱵ ᱠᱟᱛᱮ ᱫᱟᱹᱠᱷᱤᱱ ᱯᱩᱨᱩᱵ ᱥᱮᱡ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱥᱮᱡ ᱢᱩᱪᱟᱹᱫ ᱟᱠᱟᱱᱟ᱾" },
        { "cell": "ranges", "text": "ᱱᱩᱠᱩ ᱫᱚ ᱵᱤᱨ, ᱫᱩᱞᱠᱤ ᱟᱨ ᱛᱟᱥᱟᱫ ᱛᱮ ᱞᱟᱴᱟ ᱯᱮᱨᱮᱡ ᱴᱷᱟᱶ ᱠᱚᱨᱮ ᱛᱟᱦᱮᱸᱱ ᱠᱚ ᱠᱩᱥᱤᱜᱼᱟ ᱾ ᱱᱩᱠᱩᱣᱟᱜ ᱡᱚᱢ ᱫᱚ ᱵᱤᱨ ᱥᱩᱠᱨᱤ, ᱵᱤᱨ ᱥᱟᱹᱞ, ᱢᱟᱱᱣᱟ, ᱟᱹᱥᱩᱞ ᱡᱟᱱᱣᱟ ᱟᱨ ᱡᱮᱛᱮ ᱠᱟᱹᱴᱤᱡ ᱡᱤᱵᱽ ᱡᱟᱱᱣᱟ ᱠᱚ ᱾ ᱛᱟᱹᱨᱩᱵ ᱫᱚ ᱟᱸᱡᱚᱢ, ᱡᱤ, ᱟᱨ ᱧᱮᱞ ᱨᱮᱭᱟᱜ ᱫᱟᱲᱮ ᱦᱚᱸ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱜᱮ ᱛᱟᱠᱚᱣᱟ ᱾ ᱛᱟᱹᱨᱩᱵ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱯᱟᱹᱪᱷᱞᱟᱹ ᱠᱷᱚᱱ ᱠᱚ ᱡᱷᱟᱯᱴᱟᱣᱟ ᱾ ᱦᱚᱲᱢᱚ ᱨᱮᱭᱟᱜ ᱠᱟᱵᱽᱨᱟ ᱨᱚᱝ ᱠᱷᱟᱹᱛᱤᱨ ᱛᱟᱹᱨᱩᱵ ᱫᱟᱨᱮ ᱞᱟᱴᱟᱨᱮ ᱚᱱᱠᱟ ᱪᱚᱨᱚᱠ ᱠᱚ ᱩᱠᱩ ᱜᱟᱱ ᱜᱚᱫᱚᱜᱼᱟ, ᱠᱩᱫᱟᱹᱣ ᱟᱠᱟ ᱫᱮ ᱡᱟᱱᱣᱟ ᱫᱚ ᱴᱷᱤᱠᱟᱹ ᱦᱚᱸ ᱵᱟᱭ ᱴᱷᱤᱠᱟᱹ ᱡᱚᱝᱟ ᱾ ᱛᱟᱹᱨᱩᱵ ᱟᱹᱰᱤ ᱨᱤᱦᱤᱴ ᱠᱚ ᱫᱟᱹᱲ ᱫᱟᱲᱮᱭᱟᱜ ᱨᱮᱦᱚᱸ ᱟᱡᱟᱜ ᱦᱟᱢᱟᱞ ᱦᱚᱲᱢᱚ ᱠᱷᱟᱹᱛᱤᱨ ᱟᱹᱰᱤ ᱞᱚᱜᱚᱱ ᱠᱚ ᱞᱟᱸᱜᱟ ᱜᱚᱫᱚᱜᱼᱟ ᱾ ᱛᱟᱹᱨᱩᱵ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱮᱠᱞᱟ ᱜᱮ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱢᱤ-ᱢᱤᱫ ᱛᱟᱹᱨᱩᱵ ᱟᱠᱚᱣᱟᱜ ᱢᱤᱻᱢᱤᱫ ᱴᱷᱟᱹᱣᱠᱟᱹ ᱴᱷᱟᱶ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱜᱤᱫᱽᱨᱟᱹ ᱡᱟᱱᱟᱢ ᱚᱠᱛᱚ ᱠᱚᱨᱮ ᱠᱮ ᱠᱩᱲᱤ ᱠᱚᱲᱟ ᱛᱟᱹᱨᱩᱵ ᱢᱤᱫ ᱴᱷᱮᱱ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱚᱱᱠᱟ ᱫᱚ ᱯᱮ ᱪᱟᱸᱫᱚ ᱛᱟᱨᱟ ᱜᱟᱱ ᱜᱤᱫᱽᱨᱟᱹ ᱡᱟᱱᱟᱢ ᱚᱠᱛᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱟᱨ ᱢᱤᱫ ᱫᱷᱟᱣ ᱨᱮ ᱒-᱓ ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚ ᱡᱟᱱᱟᱢ ᱠᱚᱣᱟ ᱾ ᱮᱸᱜᱟᱛ ᱛᱟᱹᱨᱩᱵ ᱟᱡ ᱨᱤᱱ ᱜᱤᱫᱽᱨᱟᱹ ᱥᱟᱶ ᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱛᱟᱹᱨᱩᱵ ᱜᱤᱫᱽᱨᱟᱹ ᱥᱤᱠᱟᱨ ᱥᱟᱵ ᱡᱚᱝ ᱛᱚᱦᱚᱨ ᱫᱚ ᱟᱡ ᱟᱭᱳ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱠᱚ ᱪᱮᱢᱮᱫᱚᱜᱼᱟ ᱾ ᱵᱟᱨ ᱥᱮᱨᱢᱟ ᱛᱟᱨᱟ ᱛᱟᱭᱚᱢ ᱛᱟᱹᱨᱩᱵ ᱜᱤᱫᱽᱨᱟᱹ ᱮᱠᱞᱟ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱛᱟᱹᱨᱩᱵ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱑᱙ ᱥᱮᱨᱢᱟ ᱵᱚᱭᱚᱥ ᱛᱟᱦᱮᱸᱱ ᱛᱟᱠᱚᱣᱟ ᱾" },
        { "cell": "ranges", "text": "ᱟᱺᱰᱤᱭᱟᱹ ᱛᱟᱭᱟᱱ ᱫᱚ ᱔-᱕ ᱢᱤᱴᱚᱨ ᱜᱟᱱ ᱠᱚ ᱡᱤᱞᱤᱧᱟ ᱟᱨ ᱮᱸᱜᱟ ᱛᱟᱭᱟᱱ ᱫᱚ ᱩᱱᱠᱩ ᱠᱷᱚᱱ ᱠᱚ ᱠᱷᱟᱴᱚ ᱜᱮᱭᱟ ᱾ ᱰᱟᱺᱜᱽᱨᱤ ᱢᱚᱪᱟ ᱛᱟᱭᱟᱱᱟᱜ ᱫᱚ ᱡᱚᱛᱚ ᱛᱟᱭᱟᱱ ᱠᱚᱨᱮ ᱠᱷᱚᱱ ᱢᱚᱪᱟ ᱫᱚ ᱛᱟᱠᱚ ᱥᱮᱬᱟ ᱜᱮᱭᱟ, ᱰᱟᱺᱜᱽᱨᱤ ᱞᱮᱠᱟ ᱫᱷᱟᱨᱟ ᱜᱮ, ᱚᱱᱟᱛᱮ ᱧᱩᱛᱩᱢ ᱦᱚᱸ ᱚᱱᱠᱟ ᱜᱮ ᱠᱚ ᱫᱚᱦᱚ ᱟᱠᱟᱫᱟ ᱾ ᱱᱩᱠᱩᱣᱟᱜ ᱦᱟᱨᱛᱟ ᱫᱚ ᱢᱚᱴᱟ ᱜᱮ ᱵᱟᱠᱞᱟᱜ ᱯᱚᱥᱟᱜ ᱫᱟᱨᱮ ᱞᱮᱠᱟ ᱨᱟᱝᱜᱟ-ᱪᱚᱝᱜᱟ ᱾ ᱦᱚᱲᱢᱚ ᱨᱮᱱᱟᱜ ᱨᱚᱝ ᱫᱚ ᱦᱟᱹᱞᱠᱟᱹ ᱦᱮᱸᱫᱮ ᱟᱨ ᱛᱤᱢᱤᱱ ᱜᱟᱱ ᱠᱚᱣᱟᱜ ᱫᱚ ᱱᱟᱥᱮ ᱥᱟᱥᱟᱝ ᱾" },
        { "cell": "ranges", "text": "ᱜᱚᱣᱦᱟᱨ ᱡᱟᱱ ᱟᱡᱟᱜ ᱯᱩᱭᱞᱩ ᱠᱟᱹᱨᱫᱷᱟᱹᱱᱤᱭ ᱩᱫᱩᱜ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱫᱚᱨᱵᱷᱚᱸᱜᱟ ᱨᱟᱡᱽ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽ ᱫᱚᱨᱵᱟᱨ ᱨᱮ ᱟᱨ ᱫᱚᱨᱵᱟᱨ ᱨᱤᱱᱤᱡ ᱵᱟᱡᱚᱱᱤᱭᱟᱹ ᱞᱮᱠᱟᱛᱮ ᱠᱚ ᱵᱟᱦᱟᱞ ᱞᱮᱫᱮᱭᱟ, ᱵᱟᱱᱟᱨᱟᱥ ᱨᱮ ᱢᱤᱫ ᱯᱟᱹᱨᱩᱠᱷᱤᱭᱟᱹ ᱮᱱᱮᱡ ᱢᱟᱪᱮᱫ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱮᱱᱮᱡ ᱟᱨ ᱥᱮᱨᱮᱧ ᱨᱮᱱᱟᱜ ᱥᱮᱱᱮᱪᱮᱫ ᱮ ᱦᱟᱛᱟᱣ ᱠᱮᱫ ᱛᱟᱭᱚᱢ ᱾. ᱜᱚᱣᱦᱟᱨ ᱡᱟᱱ ᱠᱟᱹᱨᱫᱷᱟᱹᱤ ᱩᱫᱩᱜ ᱮ ᱮᱦᱚᱵ ᱠᱮᱫᱼᱟ ᱑᱘᱙᱖ ᱨᱮ ᱠᱚᱞᱠᱟᱛᱟ ᱨᱮ ᱟᱨ 'ᱯᱩᱭᱞᱩ ᱮᱱᱮᱡ ᱠᱩᱲᱤ' ᱠᱚ ᱢᱮᱛᱟᱭ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱩᱱᱤ ᱢᱤᱫ ᱜᱩᱡᱽᱨᱟᱴᱤ ᱯᱟᱨᱥᱤ ᱛᱷᱤᱭᱮᱴᱚᱨ ᱵᱟᱰᱚᱦᱤ ᱚᱢᱨᱤᱛ ᱠᱮᱥᱚᱵ ᱱᱟᱭᱚᱠ ᱥᱟᱶ ᱧᱟᱯᱟᱢ ᱦᱩᱭ ᱞᱮᱱ ᱛᱟᱭᱟ ᱑᱙᱐᱔-᱑᱙᱐᱕ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱨᱮ ᱟᱨ ᱩᱱᱤᱭᱟᱜ ᱴᱟᱴᱠᱟ ᱵᱚᱝᱜᱟ ᱛᱟᱞᱟ ᱑᱙᱐᱗ ᱥᱟᱞᱮ ᱢᱟᱬᱟᱝ ᱨᱮ ᱩᱱᱤ ᱥᱟᱶ ᱥᱟᱹᱜᱟᱹᱭ ᱛᱚᱯᱚᱞ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "ranges", "text": "ᱜᱟᱵᱽᱨᱤᱭᱮᱞ ᱜᱟᱨᱥᱤᱭᱟ ᱢᱟᱨᱠᱮᱡᱽ ᱜᱚᱴᱟ ᱧᱤᱛᱩᱢ ᱫᱚ ᱜᱟᱵᱽᱨᱤᱭᱮᱞ ᱡᱚᱥᱮ ᱰᱤ ᱞᱟ ᱠᱚᱱᱠᱚᱨᱰᱤᱭᱟ ᱝᱟᱨᱥᱤᱭᱟ ᱢᱟᱨᱠᱮᱥ ᱤᱝᱞᱤᱥ ᱛᱮ Gabriel José de la Concordia García Márque (᱖ ᱢᱟᱨᱪ ᱑᱙᱒᱗ – ᱑᱗ ᱮᱯᱨᱤᱞ ᱒᱐᱑᱔) ᱫᱚ ᱜᱟᱢᱟᱢᱤᱭᱟᱹ, ᱠᱟᱹᱴᱤᱡ ᱠᱟᱹᱦᱟᱹᱱᱤ ᱚᱱᱚᱞᱤᱭᱟᱹ, Screenwriter ᱟᱨ ᱥᱟᱝᱵᱟᱫᱤᱠᱮ ᱛᱟᱦᱮ ᱠᱟᱱᱟ᱾ ᱞᱮᱴᱤᱱ ᱟᱢᱮᱨᱤᱠᱟ ᱨᱮ Gabo ᱟᱨ ᱵᱟᱝᱠᱷᱟᱱ Gabito ᱧᱤᱛᱩᱢ ᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱭ ᱜᱮᱭᱟ᱾ ᱒᱐ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱨᱮᱱ ᱟᱹᱰᱤ ᱫᱟᱢᱟᱱ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱢᱮᱱᱛᱮᱭ ᱞᱮᱠᱷᱟᱜᱼᱟ᱾ ᱚᱱᱟ ᱥᱟᱶ ᱤᱥᱯᱮᱱᱤᱥ ᱯᱟᱹᱨᱥᱤ ᱨᱮᱱ ᱦᱚᱸ ᱟᱹᱰᱤ ᱪᱚᱲᱚᱠ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ᱾ ᱩᱱᱤ ᱫᱚ ᱑᱙᱗᱒ ᱥᱮᱨᱢᱟ ᱨᱮ Neustadt International Prize for Literature ᱟᱨ ᱑᱙᱘᱒ ᱥᱮᱨᱢᱟ ᱨᱮ ᱱᱳᱵᱮᱞ ᱥᱤᱨᱯᱷᱟᱹᱭ ᱧᱟᱢᱞᱮᱫᱟ᱾ ᱩᱱᱤ ᱫᱚ ᱠᱚᱞᱚᱢᱵᱚ ᱟᱨ foreign politics ᱨᱮᱱ critic ᱠᱟᱱᱟᱭ᱾" },
        { "cell": "ranges", "text": "ᱞᱤᱭᱚ ᱴᱚᱞᱥᱴᱚᱭ ᱤᱝᱞᱤᱥ ᱛᱮ (Leo Tolstoy) (Лев Николаевич Толстой) (᱒᱘ ᱟᱜᱚᱥᱴ ᱑᱘᱒᱘ – ᱒᱐ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱑᱙᱑᱐) ᱫᱚ ᱢᱤᱫᱴᱟᱹᱝ ᱨᱩᱥ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱾ ᱩᱱᱤ ᱫᱚ ᱨᱩᱥ ᱥᱟᱶᱦᱮᱫ ᱨᱮᱱ ᱢᱟᱨᱟᱝ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱚᱱᱟ ᱥᱟᱶ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱱ ᱦᱚᱸ ᱢᱟᱨᱟᱝ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱠᱚ ᱞᱮᱠᱷᱟ ᱮᱭᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱵᱟᱨᱭᱟ ᱟᱹᱰᱤ ᱧᱩᱛᱩᱢᱟᱱ ᱱᱚᱵᱷᱮᱞ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱚᱣᱟᱨ ᱮᱱᱫ ᱯᱤᱥ ᱟᱨ ᱟᱱᱱᱟ ᱠᱟᱨᱮᱱᱤᱱᱟ ᱾ ᱴᱚᱞᱥᱴᱚᱭ ᱟᱜ ᱡᱟᱱᱟᱢ ᱫᱚ ᱛᱩᱞᱟ ᱯᱨᱚᱫᱮᱥ ᱨᱮᱱᱟᱜ ᱤᱭᱟᱥᱱᱟᱭᱟ ᱯᱚᱞᱤᱭᱟᱱᱟ ᱧᱩᱛᱩᱢᱟᱱ ᱡᱟᱜᱟ ᱨᱮ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮᱱ ᱮᱠᱞᱟ ᱜᱤᱫᱽᱨᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱟᱞᱮ ᱩᱢᱤᱨ ᱨᱮ ᱜᱮ ᱟᱡ ᱵᱟᱵᱟ ᱜᱚᱜᱚ ᱛᱟᱠᱤᱱ ᱫᱚ ᱠᱤᱱ ᱵᱚᱸᱜᱟ ᱛᱟᱞᱟ ᱮᱱᱟ ᱟᱨ ᱯᱮᱲᱟ ᱠᱚ ᱜᱮ ᱠᱚ ᱦᱟᱨᱟ ᱟᱠᱟᱫᱮᱭᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱱᱚᱵᱷᱮᱞ ᱪᱷᱟᱰᱟ ᱦᱚᱸ ᱱᱟᱴᱚᱠ, ᱯᱨᱚᱵᱚᱱᱫᱷ ᱚᱞ ᱠᱟᱛᱮᱜ ᱦᱚᱸ ᱟᱹᱰᱤ ᱧᱩᱛᱩᱢ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱱᱤᱣᱢᱚᱱᱤᱭᱟ ᱨᱩᱣᱟᱹ ᱧᱟᱢ ᱠᱟᱛᱮᱜᱼᱮ ᱵᱚᱸᱜᱟ ᱛᱟᱞᱟ ᱮᱱᱟ ᱾ ᱑᱙᱑᱐ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟ ᱒᱐ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱨᱩᱥᱤᱭᱟᱹ ᱨᱮᱱᱟᱜ ᱟᱥᱛᱟᱯᱚᱵᱷᱟ ᱧᱩᱛᱩᱢᱟᱱ ᱢᱤᱫ ᱨᱮᱞ ᱮᱥᱴᱮᱥᱚᱱ ᱨᱮ ᱨᱩᱣᱟᱹ ᱧᱟᱢ ᱠᱮᱫᱮᱭᱟ ᱟᱨ ᱛᱟᱭᱚᱢ ᱛᱮ ᱵᱚᱸᱜᱟ ᱛᱟᱞᱟ ᱮᱱᱟ ᱾ ᱩᱱᱤ ᱜᱚᱡ ᱛᱟᱭᱚᱢ ᱑᱙᱒᱘ – ᱑᱙᱕᱘ ᱥᱮᱨᱢᱟ ᱨᱩᱥᱤᱭᱟ ᱨᱮ ᱩᱱᱤᱭᱟᱜ ᱚᱞ ᱠᱚ ᱙᱐ ᱦᱟᱹᱴᱤᱧ ᱨᱮ ᱩᱪᱷᱟᱹᱱ ᱮᱱᱟ ᱾" },
        { "cell": "ranges", "text": "ᱞᱩᱭᱤᱥ ᱯᱟᱥᱪᱚᱨ ᱟᱡᱟᱜ ᱦᱩᱰᱤᱧ ᱡᱚᱱᱛᱨᱚ ᱫᱟᱨᱟᱭ ᱛᱮ ᱯᱟ.ᱣᱨᱟ. ᱨᱮᱭᱟᱜ ᱥᱟ.ᱨᱤ ᱜᱩᱱ ᱛᱚᱞᱟᱥ ᱨᱮ ᱛᱤᱱᱟ.ᱜ ᱴᱟᱲᱟᱝ ᱮ ᱠᱷᱮᱢᱟᱣ ᱠᱮᱜ-ᱟ ᱾ ᱢᱩᱪᱟ.ᱫ ᱨᱮ ᱩᱱᱤᱭ ᱧᱟᱢ ᱠᱮᱜ-ᱟ ᱫᱚ ᱡᱤᱵᱟᱬᱩ ᱧᱩᱛᱩᱢᱟᱱ ᱢᱤᱫ ᱞᱮᱠᱟᱱ ᱡᱤᱵᱽ ᱯᱟ.ᱣᱨᱟ. ᱫᱚᱠᱚ ᱡᱚᱡᱚ ᱚᱪᱚᱭᱮᱜ-ᱟ ᱾ ᱱᱤᱛᱚᱜ ᱫᱚ ᱩᱱᱤ ᱱᱚᱣᱟᱭ ᱯᱟᱱᱛᱮ ᱧᱟᱢ ᱠᱮᱜ-ᱟ, ᱡᱩᱫᱤ ᱯᱟ.ᱣᱨᱟ. ᱒᱐-᱓᱐ ᱴᱤᱲᱤᱡ ᱫᱷᱟ.ᱵᱤᱡ ᱞᱚᱞᱚ ᱞᱮᱠᱷᱟᱱ ᱩᱱᱠᱩ ᱡᱤᱵᱟᱬᱩ/ᱛᱤᱡᱩ ᱫᱚᱠᱚ ᱜᱩᱡᱩᱜ-ᱟ ᱾ ᱞᱚᱞᱚ ᱫᱚ ᱦᱮᱰᱮᱡᱚᱜ ᱫᱷᱟ.ᱵᱤᱡ ᱵᱟᱝ ᱠᱟᱛᱮ ᱱᱟᱥᱮ ᱠᱚᱢ ᱾ ᱱᱚᱣᱟᱛᱮ ᱯᱟ.ᱣᱨᱟ. ᱨᱮᱭᱟᱜ ᱥᱟ.ᱨᱤ ᱥᱤᱵᱤᱞ ᱠᱮᱫᱚ ᱪᱮᱫ ᱮᱴᱠᱮᱴᱚᱬᱮ ᱦᱚᱸ ᱵᱟᱝ ᱦᱩᱭᱩᱜ-ᱟ ᱾ ᱤᱱᱟ. ᱛᱟᱭᱚᱢ ᱫᱚ ᱩᱱᱤ ᱛᱳᱣᱟ ᱦᱚᱸ ᱥᱤᱵᱤᱞ ᱟᱨ ᱱᱤᱨᱚᱲ ᱫᱚᱦᱚᱭ ᱞᱟ.ᱜᱤᱫ ᱱᱚᱣᱟ ᱛᱚᱦᱚᱨ ᱜᱮᱭ ᱟᱯᱱᱟᱨ ᱠᱮᱜ-ᱟ ᱾" },
        { "cell": "ranges", "text": "ᱟᱞᱵᱨᱮᱪᱴ‌ ᱰᱩᱨᱮᱨ - ᱡᱚᱨᱢᱟᱱ (᱒᱑ ᱢᱮ ᱑᱔᱗᱑ — ᱖ ᱮᱯᱨᱤᱞ ᱑᱕᱒᱘)- ᱫᱚ ᱢᱤᱫ ᱨᱚᱸᱜ ᱮᱢᱤᱡ, ᱪᱷᱟᱯᱟᱠᱟᱨ, ᱡᱚᱨᱢᱟᱱ ᱨᱤᱱᱟᱥᱟᱸ ᱨᱤᱱᱤᱡ ᱵᱩᱱᱤᱭᱟᱹᱫᱤᱭᱟᱹ ᱠᱤᱱ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱟᱡ ᱫᱚ ᱱᱭᱩᱨᱮᱢᱵᱚᱨᱜ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟᱭ ᱾ ᱡᱚᱜᱷᱚᱱ ᱟᱡ ᱒᱐ ᱥᱟᱞ ᱩᱢᱮᱨ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱠᱟᱴ ᱜᱮᱫ ᱠᱟᱛᱮᱫ ᱪᱤᱛᱟᱹᱨ ᱵᱮᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱯᱩᱨᱟᱹ ᱩᱭᱨᱳᱯ ᱨᱮ ᱟᱡᱟᱜ ᱧᱩᱛᱩᱢ ᱟᱨ ᱚᱨᱥᱚᱝ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱱᱟ ᱚᱠᱛᱚ ᱨᱤᱱ ᱨᱟᱯᱷᱮᱞ, ᱡᱤᱳᱵᱷᱟᱱᱤ ᱵᱮᱞᱤᱱᱤ, ᱞᱤᱭᱳᱱᱟᱨᱰᱳ ᱫᱟ ᱵᱷᱤᱱᱥᱤ ᱞᱮᱠᱟᱱ ᱟᱹᱰᱤᱜᱟᱱ ᱧᱚᱛᱩᱢᱟᱱ ᱟᱨᱴᱤᱥᱴ ᱠᱚ ᱥᱟᱞᱟᱜ ᱟᱡᱟᱜ ᱥᱟᱹᱜᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾" },
        { "cell": "ranges", "text": "ᱟᱢᱩᱱᱰᱥᱮᱱ ᱨᱚᱣᱟᱞᱰ (ᱨᱚᱣᱟᱞᱰ ᱟᱢᱩᱱᱰᱥᱮᱱ /᱑᱘᱗᱒ ᱼ ᱑᱙᱒᱘) ᱱᱚᱨᱣᱮ ᱨᱤᱱᱤᱡ ᱢᱤᱫ ᱥᱟᱦᱟᱥᱤᱭᱟᱹ Investigator ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱡᱟᱦᱟᱸᱭ ᱫᱚ polar ᱴᱚᱴᱷᱟ ᱠᱚ ᱟᱹᱰᱤ ᱥᱟᱦᱟᱥ ᱥᱟᱶᱛᱮᱭ ᱥᱟᱸᱜᱷᱟᱨ ᱞᱮᱜᱼᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱑᱙᱑᱐-᱑᱒ ᱨᱮ ᱫᱩᱠᱷᱤᱱ polar ᱨᱮᱭᱟᱜ ᱠᱷᱚᱸᱫᱽᱨᱚᱝ ᱟᱡᱟᱜ ᱛᱟᱹᱨᱤ ᱨᱮ ᱦᱩᱭ ᱮᱱᱟ ᱡᱟᱦᱟᱸᱛᱮ ᱑᱙᱑᱑ ᱥᱟᱞᱮᱨᱮ ᱯᱩᱨᱟᱹᱣ ᱥᱟᱹᱛ ᱮᱱᱟ ᱾ ᱑᱙᱒᱖ ᱥᱟᱞᱮᱨᱮ ᱩᱛᱚᱨ ᱯᱳᱞᱟᱨ ᱨᱮ ᱥᱮᱴᱮᱨᱚᱜ ᱨᱤᱱᱤᱡ ᱩᱱᱤ ᱫᱚ ᱯᱩᱭᱞᱩ ᱛᱚᱞᱟᱥ ᱥᱟᱸᱜᱷᱟᱨᱤᱭᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤ ᱜᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱬᱟᱝ ᱨᱮ ᱑᱙᱐᱓-᱐᱖ ᱨᱮ ᱩᱛᱚᱨ - ᱯᱩᱪᱷᱤᱢ ᱦᱚᱨ (Northwest passage) ᱮ ᱥᱟᱸᱜᱷᱟᱨ ᱞᱮᱜᱼᱟ ᱾" },
        { "cell": "currency", "text": "ᱢᱟᱨᱠ ᱡᱩᱠᱚᱨᱵᱚᱨᱜᱽ ᱢᱟᱨᱠ ᱤᱞᱤᱭᱚᱴ ᱡᱩᱠᱚᱨᱵᱚᱨᱜᱽ ᱫᱚ ᱢᱤᱫ ᱟᱢᱮᱨᱤᱠᱟᱱ ᱠᱚᱢᱯᱩᱴᱚᱨ ᱯᱨᱚ-ᱜᱨᱟᱢᱚᱨ ᱟᱨ ᱤᱱᱴᱚᱨᱱᱮᱴ ᱤᱱᱴᱟᱨᱯᱨᱤᱱᱚᱨ ᱩᱱᱤ ᱫᱚ ᱯᱷᱮᱥᱵᱩᱠᱨᱤᱱᱤᱡ ᱵᱩᱱᱤᱭᱟᱹᱫᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱯᱱᱤᱭᱟᱜ ᱱᱤᱛᱚᱜ ᱟᱨᱡᱟᱣ ᱫᱚ ᱭᱩ . ᱮᱥ $᱗᱔.᱒ ᱵᱤᱞᱤᱭᱚᱱ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱒᱐᱑᱗ ᱦᱟᱹᱵᱤᱡ ᱛᱮ ᱒᱐᱑᱖ ᱥᱟᱞᱟᱨᱮ ᱯᱷᱚᱨᱵᱮᱥ ᱫᱟᱨᱟᱭ ᱛᱮ ᱞᱤᱥᱴᱤ ᱞᱮᱱᱟᱭ ᱛᱩᱨᱩᱭᱟᱱᱤᱡ ᱠᱤᱥᱟ ᱦᱚᱲ ᱢᱮᱱ ᱛᱮ ᱡᱩᱠᱚᱨᱵᱚᱨᱜᱽ ᱯᱷᱮᱥᱵᱩᱠ ᱫᱚᱭ ᱛᱮᱭᱟᱨᱞᱮᱜᱟ ᱦᱟᱵᱷᱟᱨᱰ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱟᱨ ᱯᱷᱮᱵᱽᱨᱩᱣᱟᱨᱤ ᱒᱐᱐᱔ ᱥᱟᱞᱮ ᱨᱮ ᱱᱩᱭ ᱫᱚ ᱟᱡ ᱨᱤᱱ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱜᱟᱛᱮ ᱠᱚ ᱟᱨ ᱦᱟᱵᱷᱟᱨᱰ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱤᱱ ᱥᱟᱶᱛᱮᱱ ᱠᱚ ᱥᱟᱶ ᱯᱷᱮᱥᱵᱩᱠᱞᱟᱦᱟ ᱠᱚ ᱮᱦᱚᱵ ᱞᱮᱫ ᱛᱟᱦᱮᱸ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱱᱩᱠᱩ ᱫᱚᱞ ᱮᱴᱟᱜ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮᱦᱚᱸ ᱯᱷᱮᱥᱵᱩᱠ ᱠᱚ ᱮᱛᱚᱦᱚᱵ ᱠᱮᱫᱟ" },
        { "cell": "currency", "text": "᱒᱐᱑᱕ ᱫᱷᱟ.ᱵᱤᱡ ᱛᱮ ᱱᱚᱣᱟ ᱯᱷᱟᱣᱩᱱᱰᱮᱥᱟᱹᱱ ᱒᱘᱐ ᱠᱷᱚᱱ ᱡᱟ.ᱥᱛᱤ ᱦᱚᱲ ᱮ ᱵᱟᱦᱟᱞ ᱦᱟᱠᱟᱫ ᱠᱚᱣᱟ US$᱖᱕,00,00,000 ᱥᱮᱢᱟᱠᱤᱭᱟ. ᱨᱟᱡ-ᱟᱭ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ᱾ ᱒᱐᱑᱖ ᱠᱷᱚᱱ ᱠᱷᱤᱨᱥᱴᱚᱯᱚᱨ ᱦᱮᱱᱮᱨ ᱫᱚ ᱵᱳᱰ ᱨᱤᱱᱤᱡ ᱪᱟᱭᱨᱮᱛ ᱟᱨ ᱠᱟᱛᱷᱨᱮᱱ ᱢᱟᱦᱮᱨ ᱫᱚ ᱫᱤᱥᱟ. ᱩᱫᱩᱜ-ᱤᱡ ᱞᱮᱠᱟᱛᱮ ᱢᱮᱱᱟᱜᱠᱤᱱᱟ ᱾" },
        { "cell": "currency", "text": "ᱱᱚᱸᱰᱮ ᱠᱚᱭᱮᱱ ᱠᱚ ᱢᱮᱱᱟᱜᱼᱟ ᱑᱐ ᱥᱮᱸᱴᱥ ᱠᱷᱚᱱ ᱑᱐ ᱦᱚᱝᱠᱚᱝ ᱰᱚᱞᱟᱨ ᱫᱷᱟᱹᱵᱤᱡ ᱟᱨ ᱵᱮᱸᱠ ᱠᱟᱜᱚᱡᱽ ᱠᱟᱹᱣᱰᱤ $᱑᱐ ᱠᱷᱚᱱ $᱑᱐᱐᱐ ᱫᱷᱟᱹᱵᱤᱡ ᱾ ᱢᱤᱫ ᱟᱢᱮᱨᱤᱠᱟᱱ ᱰᱚᱞᱟᱨ ᱫᱚ $᱗.᱗᱕ ᱥᱟᱶ ᱵᱟᱨᱟᱵᱟᱹᱨᱤ ᱟ ᱦᱚᱝᱠᱚᱝ ᱨᱮ ᱫᱚ ᱾" },
        { "cell": "currency", "text": "ᱱᱮᱛᱟᱨ ᱦᱚᱸ ᱟᱹᱰᱤ ᱜᱟᱱ ᱥᱟᱢᱟᱱ ᱜᱮ ᱫᱚᱨᱭᱟ ᱦᱚᱨ ᱛᱮ ᱮᱴᱟᱜ ᱫᱤᱥᱚᱢ ᱥᱟᱶ ᱵᱹᱱᱤᱡᱽ ᱵᱮᱯᱟᱨ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ᱾ ᱥᱮᱨᱢᱟ ᱦᱚᱨ ᱛᱮᱫᱚ ᱢᱟᱨᱟᱝ ᱥᱟᱢᱟᱱ ᱤᱫᱤ ᱵᱤᱯᱚᱫᱽ ᱜᱮ ᱠᱷᱟᱹᱛᱤᱨ ᱵᱮᱯᱟᱨᱤᱭᱟᱹ ᱫᱟᱜ ᱦᱚᱨ ᱠᱚ ᱵᱮᱣᱦᱟᱨ ᱮᱫᱟ᱾ ᱱᱤᱛᱟᱝ ᱚᱠᱛᱚ ᱨᱮ ᱫᱟᱜ ᱦᱚᱨ ᱛᱮ ᱵᱚᱪᱷᱚᱨ ᱜᱮ $40 ᱦᱟᱡᱟᱨ ᱠᱚᱠᱚᱲ ᱴᱟᱠᱟ ᱨᱮᱭᱟᱜ ᱠᱟᱨᱵᱟᱨ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ᱾" },
        { "cell": "currency", "text": "ᱱᱚᱶᱟ ᱥᱤᱨᱯᱷᱟᱹ ᱨᱤᱱᱤᱡ ᱵᱩᱱᱤᱭᱟᱹᱫᱤᱭᱟᱹ ᱫᱚᱭ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱥᱩᱭᱰᱤᱥ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱢᱮᱱᱫᱚ ᱰᱤᱱᱟᱢᱟᱭᱤᱴ ᱥᱤᱨᱡᱚᱱᱤᱭᱟᱹ ᱰᱨ. ᱟᱞᱯᱷᱨᱮᱰ ᱱᱚᱵᱮᱞ ᱠᱟᱱᱟᱭ ᱾ ᱑᱙᱐᱑ ᱥᱟᱞᱮ ᱠᱷᱚᱱ ᱟᱞᱯᱷᱨᱮᱰ ᱱᱚᱵᱮᱞ ᱫᱟᱨᱟᱭ ᱛᱮ ᱜᱚᱱᱚᱴᱷᱚᱱ ᱟᱠᱟᱱ ᱱᱚᱵᱮᱱ ᱵᱩᱱᱤᱭᱟᱹᱫᱽ ᱡᱟᱣ ᱥᱮᱨᱢᱟ ᱜᱮ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱑᱐ ᱨᱮ ᱟᱡᱟᱜ ᱜᱩᱨ ᱢᱟᱹᱦᱤᱛ ᱦᱤᱞᱚᱜ ᱥᱤᱣᱰᱮᱱ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱥᱴᱚᱠᱦᱚᱢ ᱴᱷᱮᱱ ᱵᱮᱸᱠ ᱚᱯᱷ ᱥᱤᱣᱰᱮᱱ ᱯᱨᱟᱭᱤᱡᱽ ᱤᱱ ᱤᱠᱚᱱᱚᱢᱤᱠ ᱥᱟᱭᱤᱱᱥ ᱫᱟᱨᱟᱭ ᱛᱮ ᱥᱟᱯᱲᱟᱣᱜ ᱠᱟᱱ ᱯᱟᱨᱟᱵᱽ ᱨᱮ ᱱᱚᱶᱟ ᱫᱚ ᱠᱚ ᱮᱢᱟᱠᱚ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱥᱤᱨᱯᱷᱟᱹ ᱞᱮᱠᱟᱛᱮ ᱢᱤᱫ ᱥᱚᱱᱟ ᱢᱮᱰᱟᱞ, ᱠᱟᱹᱣᱰᱤ ᱟᱨ ᱢᱟᱹᱱ ᱥᱟᱠᱟᱢ ᱠᱚ ᱮᱢᱟᱠᱚ ᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱫᱚ ᱚᱱᱟ ᱵᱩᱱᱤᱭᱟᱹᱫ ᱜᱮ ᱴᱷᱟᱹᱣᱠᱟᱹᱭᱟᱭ ᱾ ᱒᱐᱑᱗ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱰᱤ ᱜᱚᱱᱚᱝ ᱫᱚ SEK ᱙,᱐᱐᱐,᱐᱐᱐ ᱟᱨᱵᱟᱝ US$᱑,᱑᱑᱐,᱐᱐᱐, €᱙᱔᱔᱔᱔,᱐᱐᱐, £᱘᱓᱖,᱐᱐᱐, INR ᱗᱒,᱖᱙᱓,᱙᱐᱐ ᱟᱨᱵᱟᱝ CNR ᱓᱗᱖,᱐᱐᱐ ᱜᱟᱱ ᱾ ᱟᱞᱯᱷᱨᱮᱰ ᱫᱚ ᱟᱡᱟᱜ ᱥᱟᱱᱟᱢ ᱫᱷᱚᱱ ᱥᱚᱢᱯᱩᱛᱤ ᱱᱚᱶᱟ ᱵᱩᱱᱤᱭᱟᱹᱫᱽ ᱨᱮᱜᱮᱭ ᱫᱟᱱ ᱟᱠᱟᱫᱟ, ᱡᱟᱦᱟᱸ ᱨᱮᱱᱟᱜ ᱜᱚᱱᱚᱝ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱠᱟᱹᱣᱰᱤ ᱞᱮᱠᱟᱛᱮ ᱑᱒ ᱠᱳᱴᱤ ᱔᱐ ᱞᱟᱠᱷ ᱾ ᱱᱚᱶᱟ ᱠᱟᱹᱣᱰᱤ ᱠᱷᱚᱱ ᱡᱟᱦᱟᱸ ᱥᱩᱫᱽ ᱧᱟᱢᱚᱜ-ᱟ ᱚᱱᱟ ᱫᱚ ᱱᱚᱵᱮᱞ ᱥᱤᱨᱯᱷᱟᱹ ᱵᱟᱵᱚᱫᱽ ᱠᱷᱚᱨᱚᱪᱚᱜ ᱨᱮᱱᱟᱜ ᱵᱮᱵᱚᱥᱛᱟ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ²" },
        { "cell": "currency", "text": "᱒᱐᱐᱑ ᱠᱷᱚᱱ ᱒᱐᱑᱑ ᱫᱷᱟᱹᱵᱤᱡ ᱭᱩᱱᱟᱴᱮᱰ ᱥᱴᱮᱴ ᱨᱮᱱᱟᱜ ᱡᱷᱚᱛᱚ ᱠᱷᱚᱱ ᱡᱟᱹᱥᱛᱤ ᱡᱚᱥ ᱨᱮ ᱛᱟᱦᱮᱸᱠᱟᱱᱟᱭ , ᱟᱡ ᱥᱟᱵ ᱦᱚᱪᱚ ᱞᱟᱹᱜᱤᱫ ᱮᱯᱷ ᱵᱤ ᱟᱭᱤ $25&nbsp;ᱢᱤᱞᱤᱭᱚᱱ ᱨᱮᱱᱟᱜ ᱜᱚᱱᱚᱝ ᱮ ᱦᱚᱦᱚ ᱞᱮᱫᱼᱟ . ᱒ ᱢᱮ ᱒᱐᱑᱑ ᱦᱤᱞᱚᱜ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮᱱᱟᱜ ᱟᱵᱚᱴᱟᱵᱟᱫ ᱨᱮᱱᱟᱜ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱚᱲᱟᱜ ᱨᱮ ᱡᱟᱦᱟᱸᱨᱮ ᱣᱟᱡᱚᱨᱤᱥᱛᱟᱱ ᱨᱤᱱ ᱜᱷᱟᱨᱚᱸᱡ ᱠᱚ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ,ᱟᱢᱮᱨᱤᱠᱟ ᱨᱤᱱ ᱥᱯᱮᱥᱟᱞ ᱱᱟᱵᱷᱟᱞ ᱜᱩᱭᱤᱱᱫᱟ ᱢᱤᱞᱤᱴᱟᱨᱤ ᱛᱮ ᱠᱚ ᱴᱩᱴᱤ ᱜᱚᱡ ᱠᱮᱫᱮᱭᱟ ᱠᱚ" },
        { "cell": "currency", "text": "ᱪᱟᱭᱱᱟᱼᱯᱟᱠᱤᱥᱛᱟᱱ ᱠᱟᱹᱣᱰᱤᱟᱹᱨᱤ ᱠᱳᱨᱤᱰᱳᱨ (Chinese: 中国-巴基斯坦经济走廊; Urdu: پاكستان-چین اقتصادی راہداری‬‎; )CPEC ᱞᱮᱠᱟᱛᱮ ᱦᱚᱸ ᱠᱚ ᱧᱩᱛᱩᱢ ᱜᱮᱭᱟ ᱾ᱱᱚᱣᱟ ᱫᱚᱨᱮ ᱥᱟᱯᱲᱟᱣ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮ ᱪᱟᱹᱞᱩ ᱦᱟᱠᱟᱱ ᱟᱹᱰᱤᱜᱟᱱ ᱢᱩᱛᱩᱞ ᱯᱨᱳᱡᱮᱠᱴ ᱨᱮᱱᱟᱜ ᱥᱟᱶ ᱠᱟᱱᱟ ᱾ . ᱢᱩᱲ ᱞᱮᱠᱟᱛᱮ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱫᱟᱢ $᱔᱖ ᱵᱤᱞᱤᱭᱚᱱ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ, ᱱᱤᱛᱚᱜ ᱒᱐᱑᱗ ᱛᱮ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱫᱟᱢ $62&nbsp;ᱵᱤᱞᱤᱭᱚᱱ ᱥᱮᱴᱮᱨ ᱦᱟᱠᱟᱱᱟ ᱾ ᱥᱤᱯᱤᱤᱥᱤ( CPEC ) ᱦᱟᱜ ᱡᱚᱥ ᱫᱚ ᱦᱚᱨ ᱰᱟᱦᱟᱨ ᱨᱮᱱᱟᱜ ᱠᱷᱚᱸᱡᱟ,ᱟᱹᱰᱤᱜᱟᱱ ᱫᱟᱲᱮ ᱨᱮᱱᱟᱜ ᱯᱨᱳᱡᱮᱠᱴ ᱟᱨ ᱟᱥᱚᱠᱟᱭ ᱠᱟᱹᱣᱰᱤ ᱴᱚᱴᱷᱟ ᱞᱟᱜᱮ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮᱱᱟᱜ ᱵᱩᱱᱤᱭᱟᱹᱫ ᱱᱟᱦᱟᱜ ᱡᱩᱜ ᱥᱟᱞᱟᱜ ᱯᱚᱨᱛᱟᱲ ᱠᱟᱛᱮᱫ ᱟᱡᱟᱜ ᱠᱟᱹᱣᱰᱤ ᱫᱟᱲᱮ ᱠᱮᱴᱮᱡ ᱢᱟᱭ ᱑᱓ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱒᱐᱑᱖ ᱨᱮ ᱡᱚᱠᱷᱚᱱ ᱪᱟᱭᱱᱤᱡ ᱠᱟᱨᱜᱳ ᱜᱣᱟᱰᱟᱨ ᱯᱳᱨᱴ ᱛᱮ ᱟᱯᱷᱨᱤᱠᱟ ᱟᱨ ᱯᱟᱪᱮ ᱟᱥᱤᱭᱟᱛᱮ ᱫᱟᱜ ᱡᱟᱦᱟᱡ ᱛᱮ ᱵᱷᱮᱡᱟ ᱞᱟᱹᱜᱤᱫ ᱱᱚᱣᱟ ᱰᱟᱦᱟᱨ ᱛᱮ ᱪᱟᱞᱟᱣ ᱮᱱᱟ ᱩᱱ ᱡᱚᱦᱚᱜ ᱱᱚᱣᱟ ᱠᱳᱨᱤᱰᱳᱨ ᱱᱟᱥᱮ ᱮᱛᱚᱦᱚᱵ ᱮᱱᱟ ᱾ ᱟᱨ ᱟᱫᱷᱟᱱ ᱵᱤᱡᱞᱤ ᱯᱨᱳᱡᱮᱠᱴ ᱠᱚᱫᱚ ᱒᱐᱑᱗᱗ ᱢᱩᱪᱟᱹᱫ ᱠᱚᱛᱮ ᱮᱛᱚᱦᱚᱵ ᱮᱱᱟ᱾" },
        { "cell": "currency", "text": "ᱯᱟᱠᱤᱥᱛᱟᱱ ᱮᱱᱟᱜ ᱵᱟᱹᱲᱤᱡ ᱦᱚᱨ ᱰᱟᱦᱟᱨ ᱠᱷᱟᱹᱛᱤᱨ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹᱡᱤᱰᱤᱯᱤᱨᱮᱱᱟᱜ ᱓ᱹ᱓᱕% ᱦᱟᱹᱦᱟᱹᱱ ᱠᱟᱱᱛᱟᱦᱮᱸᱫ ᱢᱮᱱᱛᱮᱫ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟ᱾ ᱥᱤᱯᱤᱥᱤ ᱦᱟᱜ ᱱᱟᱦᱟᱜ ᱦᱟᱹᱡᱩᱜ ᱥᱮᱱᱚᱜ ᱵᱮᱵᱚᱥᱛᱟ ᱜᱣᱟᱰᱟᱨ ᱯᱳᱨᱴ ᱠᱚᱨᱟᱪᱤ ᱫᱟᱜ ᱡᱟᱷᱟᱡ ᱜᱷᱟᱛ ᱥᱟᱶ ᱮᱛᱚᱢ ᱯᱟᱠᱤᱥᱛᱟᱱ , ᱯᱟᱪᱮ ᱯᱟᱠᱤᱥᱛᱟᱱ,ᱯᱟᱪᱮ ᱪᱟᱭᱱᱟ, ᱛᱟᱞᱟ ᱮᱥᱤᱭᱟ ᱮᱢᱟᱱ ᱠᱚ ᱥᱟᱞᱟᱜ ᱥᱟᱹᱜᱟᱹᱭ ᱡᱚᱲᱟᱣᱼᱟ ᱥᱤᱯᱤᱥᱤ ᱮᱱᱟᱜ ᱢᱤᱫ ᱵᱷᱟᱜ ᱞᱮᱠᱟᱛᱮ ᱠᱚᱨᱟᱪᱤ ᱠᱷᱚᱱ ᱞᱟᱦᱳᱨ ᱱᱟᱜᱟᱨ ᱫᱷᱟᱹᱵᱤᱡ ᱑,᱑᱐᱐ ᱠᱤᱹᱢᱤ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱢᱳᱴᱳᱨ ᱰᱟᱦᱟᱨ ᱵᱮᱨᱮᱫᱚᱜᱼᱟ ᱠᱟᱨᱟᱠᱳᱨᱳᱢ ᱰᱟᱦᱟᱨ ᱟᱨ ᱨᱟᱣᱟᱞᱯᱤᱱᱰᱤᱥᱟᱞᱟᱜ ᱟᱨ ᱪᱟᱭᱱᱤᱡᱥᱤᱢᱟ ᱥᱮᱫ ᱛᱮ ᱢᱮᱱᱟᱜ ᱰᱟᱦᱟᱨ ᱫᱚᱦᱲᱟ ᱵᱮᱱᱟᱣ ᱨᱩᱣᱟᱹᱲ ᱚᱜᱼᱟ ᱾ ᱾ ᱠᱚᱨᱟᱪᱤᱼᱯᱮᱥᱟᱣᱟᱨ ᱢᱩᱠᱷᱤᱭᱟᱹᱨᱮᱞᱰᱟᱦᱟᱨᱦᱚᱸ ᱒᱐᱑᱙ ᱰᱮᱥᱮᱢᱵᱚᱨᱛᱮ ᱑᱖᱐ᱠᱤᱹᱢᱤᱥᱟᱺᱜᱤᱧ ᱫᱷᱟᱹᱵᱤᱡ ᱡᱤᱞᱤᱧ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱿ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮᱞ ᱢᱩᱪᱟᱹᱫᱨᱮᱪᱟᱭᱱᱟ ᱨᱮᱞ ᱨᱮᱱᱟᱜ ᱠᱟᱥᱜᱷᱟᱨ ᱨᱮᱱᱟᱜ ᱠᱚᱸᱡᱮ ᱡᱤᱸᱜᱡᱤᱭᱟᱸᱜ ᱨᱮᱞᱣᱮ ᱥᱟᱞᱟᱜ ᱠᱚ ᱵᱷᱤᱲᱟᱹᱣᱼᱟ ᱾ ᱾ᱱᱟᱦᱟᱜ ᱦᱟᱹᱡᱩᱜ ᱥᱮᱱᱚᱜ ᱵᱮᱵᱚᱥᱛᱟ ᱞᱟᱹᱜᱤᱫ $᱑᱑ᱵᱤᱞᱤᱭᱚᱱᱞᱟᱹᱠᱛᱤᱼᱟ ᱢᱮᱱᱛᱮᱫ ᱦᱤᱥᱟᱹᱵ ᱦᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱠᱷᱚᱨᱪᱚ ᱥᱚᱵᱥᱤᱰᱤ ᱦᱟᱠᱟᱱ ᱥᱟᱥᱛᱟ ᱞᱩᱱ ᱛᱮ ᱠᱚᱨᱟᱣ ᱦᱩᱭᱩᱜ ᱼᱟ ᱢᱮᱱᱛᱮᱫ ᱴᱷᱟᱹᱣᱠᱟᱹ ᱦᱟᱠᱟᱱᱟ᱾" },
        { "cell": "abbrev", "text": "ᱚᱱᱚᱞ ᱚᱞ ᱢᱩᱬ ᱠᱟᱛᱮ ᱯᱮ ᱦᱚᱨᱟᱛᱮ ᱦᱩᱭᱩᱜᱼᱟ, ᱯᱩᱭᱞᱩᱛᱮ ᱮᱛᱚᱦᱚᱵᱽ, ᱫᱚᱥᱟᱨ ᱨᱮ ᱵᱚᱨᱱᱚᱱᱟ ᱟᱨ ᱛᱮᱥᱟᱨ ᱨᱮ ᱜᱩᱴᱚᱱᱚᱞ (Conclusion) ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱩᱪᱟ.ᱫ ᱠᱷᱚᱫᱽ ᱠᱟᱱᱟ, ᱱᱚᱶᱟ ᱨᱮ ᱚᱱᱚᱞᱤᱭᱟ., ᱜᱟᱢᱟᱢᱤ, ᱠᱟ.ᱦᱱᱤᱭᱟ. ᱠᱚᱣᱟᱜ ᱚᱱᱚᱞ ᱥᱟᱛᱟᱢ ᱤᱫᱤ ᱠᱟᱛᱮ ᱩᱫᱤᱥ/ᱥᱟᱱᱫᱮᱥ ᱵᱟᱰᱟᱭᱚᱜ-ᱟ ᱾ ᱥᱟᱶᱦᱮᱫ ᱥᱤᱨᱡᱚᱱ ᱨᱮᱭᱟᱜ ᱟᱭᱢᱟ ᱠᱷᱚᱫᱽ ᱠᱷᱚᱱ ᱚᱱᱚᱞ ᱜᱮ ᱥᱚᱨᱮᱥᱟᱜ ᱠᱷᱚᱫᱽ ᱾ ᱚᱱᱚᱞᱞᱤᱭᱟ. ᱟᱡᱟᱜ ᱚᱱᱚᱞ ᱨᱮ ᱡᱟᱦᱟ ᱠᱚᱭ ᱞᱟᱹᱭ ᱠᱟᱜᱼᱟ, ᱚᱱᱟ ᱠᱚᱜᱮ ᱱᱚᱸᱰᱮ ᱡᱷᱟᱞᱠᱟᱣᱜᱼᱟ ᱾ ᱚᱱᱟᱛᱮ ᱟᱫᱷᱟᱱ ᱦᱚᱲ ᱫᱚ ᱚᱱᱚᱞ ᱯᱩᱨᱟ. ᱵᱟᱝ ᱯᱟᱲᱦᱟᱣ ᱠᱟᱛᱮ ᱜᱩᱴᱚᱱᱚᱞ/ᱢᱩᱪᱟ.ᱫ ᱛᱮᱫ ᱯᱟᱲᱦᱟᱣ ᱠᱟᱛᱮ, ᱚᱱᱚᱞ ᱤᱫᱤ ᱠᱟᱛᱮ ᱩᱫᱤᱥ/ᱥᱟᱱᱫᱮᱥ ᱢᱟᱨᱠᱚᱛ ᱠᱚ ᱢᱮᱴᱟᱣ ᱛᱟᱠᱚᱣᱟ ᱾" },
        { "cell": "abbrev", "text": "ᱩᱱᱤ ᱫᱚ ᱟᱡᱟᱜ ᱡᱩᱜᱽ ᱨᱤᱱᱤᱡ ᱢᱤᱫ ᱢᱟᱦᱟᱱ ᱰᱤᱯᱞᱳᱢᱮᱴ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱟᱡᱟᱜ ᱰᱤᱯᱞᱳᱢᱮᱴᱤᱠ ᱵᱮᱵᱷᱟᱨ ᱠᱷᱟ.ᱛᱤᱨ ᱯᱷᱨᱟᱸᱥ ᱫᱚ ᱡᱚᱴᱟᱣ ᱠᱷᱚᱱ ᱪᱩᱰᱟ.ᱨ ᱠᱟᱛᱮ ᱡᱚᱨᱢᱟᱱᱤ ᱫᱚ ᱭᱩᱨᱳᱯ ᱨᱮᱭᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱯᱩᱭᱞᱩ ᱫᱟᱲᱮ ᱟᱱᱟᱜ ᱮ ᱵᱮᱱᱟᱣ ᱠᱮᱜᱼᱟ ᱾ ᱵᱤᱥᱢᱟᱨᱠ ᱫᱚ ᱢᱤᱫ ᱱᱟᱣᱟ ᱯᱳᱨᱮᱱ ᱯᱚᱞᱤᱥᱤᱭ ᱵᱮᱱᱟᱣ ᱠᱮᱜᱼᱟ ᱡᱟᱦᱟᱸ ᱦᱚᱛᱮᱛᱮ ᱱᱮᱢᱚᱥ ᱥᱟᱺᱦᱤᱡ ᱞᱟ.ᱰᱷᱟ.ᱭ ᱟᱠᱚᱴ ᱟᱨ ᱥᱟ.ᱱᱛᱤ ᱵᱮᱱᱟᱣ ᱫᱚᱦᱚᱭ ᱞᱟ.ᱜᱤᱫ ᱜᱟᱫᱮᱞ ᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱜᱼᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱱᱚᱣᱟ ᱡᱚᱱᱚᱲᱟᱣ ᱵᱤᱦᱤᱛ ᱜᱮ ᱯᱩᱨᱟ. ᱭᱩᱨᱳᱯ ᱫᱚ ᱵᱟᱨ ᱫᱟᱫᱮᱞ ᱨᱮᱭ ᱦᱟ.ᱴᱤᱧ ᱞᱮᱜᱼᱟ ᱾" },
        { "cell": "abbrev", "text": "ᱱᱚᱶᱟ ᱪᱤᱠᱤ ᱵᱮᱵᱷᱟᱨ ᱠᱟᱛᱮ ᱟᱭᱢᱟ ᱞᱮᱠᱟᱱ ᱟᱹᱲᱟ. ᱦᱮᱡ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ, ᱡᱮᱞᱮᱠᱟ ᱺ-" },
        { "cell": "abbrev", "text": "ᱮᱰᱤᱥᱚᱱ ᱫᱚ ᱴᱮᱞᱤᱜᱨᱟᱯᱷ ᱚᱯᱮᱨᱮᱴᱚᱨ ᱮᱱᱟᱭ ᱡᱚᱠᱷᱚᱱ, ᱫᱟᱹᱲᱟᱠᱟᱫ ᱴᱨᱮᱱ ᱠᱷᱚᱱᱮ ᱵᱟᱧᱪᱟᱣ ᱠᱮᱫᱮᱭᱟᱭ ᱢᱤᱫ ᱯᱮ ᱥᱮᱨᱢᱟ ᱜᱤᱫᱽᱨᱟᱹ ᱡᱮᱢᱤ ᱢᱮᱠᱮᱱᱡᱤ ᱾ ᱡᱮᱢᱤ ᱟᱡ ᱵᱟᱵᱟ ᱡᱮ.ᱭᱩ. ᱢᱮᱠᱮᱱᱡᱤ ᱫᱚ ᱢᱟᱶᱩᱴ ᱠᱞᱮᱢᱮᱱᱥ ᱨᱤᱱᱤᱡ ᱥᱴᱮᱥᱚᱱ ᱢᱟᱥᱴᱚᱨᱮ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ ᱾ ᱮᱰᱤᱥᱚᱱ ᱪᱮᱛᱟᱱ ᱨᱮ ᱨᱟᱹᱥᱠᱟᱹᱭᱮᱱ ᱛᱮ ᱴᱮᱞᱮᱜᱨᱟᱯᱷ ᱚᱯᱨᱮᱴᱚᱨ ᱞᱮᱠᱟᱛᱮᱭ ᱥᱮᱪᱮᱫ ᱚᱪᱚ ᱠᱮᱫᱮᱭᱟ ᱾ ᱚᱱᱟ ᱛᱮᱭᱚᱢ ᱴᱮᱞᱤᱜᱨᱟᱯᱷ ᱚᱯᱚᱨᱮᱴᱚᱨ ᱞᱮᱠᱟᱛᱮ ᱮᱛᱦᱚᱵ ᱫᱚ ᱥᱴᱟᱨᱰᱯᱷᱚᱨᱰ ᱡᱚᱝᱠᱥᱚᱱ ᱨᱮ ᱠᱟᱹᱢᱤᱭ ᱮᱦᱚᱵ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "abbrev", "text": "ᱱᱚᱣᱟ ᱟᱛᱨᱮ ᱫᱚ \" ᱜ ᱡ ᱫ ᱵ \" ᱱᱚᱣᱟ ᱠᱚ ᱛᱟ.ᱯᱩᱜ ᱠᱮᱪᱮᱫ ᱟᱲᱟᱝ ᱨᱮᱭᱟᱜ ᱟ.ᱲᱟ. ᱜᱟᱵᱟᱱ ᱥᱮᱲᱟᱭ ᱢᱮ I \" ᱜ \" ᱛᱮᱫᱚ ᱯᱩᱱ ᱞᱮᱠᱟᱱ ᱟᱲᱟᱝ ᱯᱷᱚᱴᱮᱞᱚᱜ ᱟ I ᱟᱨ ᱚᱱᱟ ᱞᱮᱠᱟ ᱛᱮ ᱟ.ᱲᱟ. ᱜᱟᱵᱟᱱᱚᱜ - ᱟ I (1) ᱜ ᱫᱚ ᱛᱟ.ᱯᱩᱜᱚᱜ ᱟ I ᱩᱱ ᱫᱚ \" ᱜ \" ᱟ.ᱲᱟ. ᱨᱮᱭᱟᱜ ᱛᱟᱞᱟ ᱟᱨ ᱢᱩᱪᱟ.ᱫ ᱨᱮ ᱞᱟᱜᱟᱛᱚᱜ ᱟ I ᱡᱟᱦᱟ ᱨᱮ ᱟᱲᱟᱝ ᱫᱚ ᱟᱪᱠᱟ ᱥᱚᱵᱚᱜ ᱞᱮᱠᱟ ᱠᱟᱱᱴᱟ ᱠᱷᱚᱱ ᱨᱚᱲᱟᱝ ᱚᱰᱳᱠᱚᱜ - ᱟ I ᱚᱰᱮᱜᱮ \" ᱜ \" ᱞᱟᱜᱟᱛᱚᱜ ᱟ I ᱡᱮᱞᱮᱠᱟ - ᱠᱚ'ᱜ , ᱞᱚᱜ , ᱢᱟᱜ , ᱫᱟᱜ ᱮᱢᱟᱱ ᱠᱚ I" },
        { "cell": "abbrev", "text": "(2) \" ᱜ \" ᱟᱲᱟᱝ ᱡᱟᱦᱟ ᱴᱷᱮᱱ ᱱᱟᱥᱮ ᱦᱚᱫ ᱥᱮ ᱛᱟ.ᱯᱩᱜ ᱦᱚ ᱵᱟᱝ ᱟᱨ ᱯᱷᱳᱴᱮᱞ ᱦᱚ ᱵᱟᱝ ᱚᱱᱟ ᱛᱟᱞᱟ ᱨᱮ ᱟᱲᱟᱝᱚᱜ - ᱟ , ᱚ.ᱰᱮ ᱫᱚ \" ᱜ \" ᱥᱟᱶ \" ᱚᱦᱚᱫ \" ᱡᱟᱯᱟᱜᱚᱜ ᱟ I ᱡᱟᱯᱟᱜ ᱛᱚᱭᱚᱢ ᱚᱱᱟ ᱫᱚ ᱛᱟᱞᱟ ᱟᱨ ᱢᱩᱪᱟ.ᱫ ᱨᱮ ᱟᱲᱟᱝᱚᱜ - ᱟ I ᱡᱮᱞᱮᱠᱟ - ᱨᱟᱜ+ᱚᱦᱚᱫ ᱫᱟ ᱟᱨ ᱩᱜ+ᱚᱦᱚᱫᱞᱤ ᱮᱢᱟᱱ ᱠᱚ I (3) ᱜ ᱟᱲᱟᱝ ᱛᱟᱭᱚᱢ ᱨᱟᱦᱟ ᱟᱲᱟᱝ ᱜᱟᱵᱟᱱ ᱞᱮᱱᱠᱷᱟᱱ ᱚᱱᱟ ᱫᱚ ᱵᱟᱝ ᱛᱟ.ᱯᱩᱜᱚᱜ ᱛᱮ ᱯᱩᱨᱟ. ᱯᱷᱚᱴᱮᱞᱚᱜ ᱟ I ᱚᱱᱟ ᱫᱚ ᱟ.ᱲᱟ. ᱨᱮᱭᱟᱜ ᱡᱷᱚᱛᱚ ᱴᱷᱮᱱ ᱞᱟᱜᱟᱛᱚᱜ I ᱡᱮᱞᱮᱠᱟ - ᱜᱚᱜᱚ , ᱜᱮᱰᱮ ᱟᱨ ᱜᱩᱜᱩ ᱮᱢᱟᱱ ᱠᱚ I (4) ᱜ ᱡᱟᱦᱟ ᱨᱮ ᱛᱟ.ᱯᱤᱥ ᱥᱮ ᱮ.ᱫᱨᱮ ᱦᱚᱪᱚᱭ ᱞᱟ.ᱜᱤᱫ ᱫᱚ \" ᱜ \" ᱥᱟᱶ \"ᱷ \" ᱟᱲᱟᱝ ᱢᱮᱥᱟ ᱦᱩᱭᱩᱜ ᱟ I \" ᱜᱷ \" ᱛᱮᱫᱚ ᱛᱟ.ᱯᱤᱥᱚᱜ ᱟ I ᱱᱚᱣᱟ ᱫᱚ ᱟ.ᱲᱟ. ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱟᱨ ᱛᱟᱞᱟ ᱨᱮ ᱞᱟᱜᱟᱛᱚᱜ ᱟ I ᱡᱮᱞᱮᱠᱟ - ᱜᱷᱟᱴ , ᱜᱷᱟ.ᱞ ᱟᱨ ᱟᱜᱷᱟᱲ ᱮᱢᱟᱱ ᱠᱚ I" },
        { "cell": "abbrev", "text": "ᱜᱚᱭᱮᱛᱷᱤ ᱭᱟᱜ ᱘᱒ ᱥᱮᱨᱢᱟ ᱡᱤᱞᱤᱧ ᱡᱤᱭᱚᱱᱠᱟᱞ ᱭᱩᱨᱳᱯᱤᱭᱟ. ᱱᱟᱜᱟᱢ ᱨᱮᱭᱟᱜ ᱱᱚᱝᱠᱟᱱ ᱡᱩᱜᱽ ᱥᱟᱶ ᱥᱟ.ᱜᱟ.ᱭ ᱢᱮᱱᱟᱜᱼᱟ ᱡᱟᱦᱟᱸ ᱢᱟᱨᱟᱝ ᱢᱟᱨᱟᱝ ᱦᱩᱞᱥᱟ.ᱭ ᱟᱨ ᱵᱚᱛᱚᱨᱟᱱ ᱫᱩᱞᱠᱟ. ᱫᱩᱞᱠᱤ ᱚᱠᱛᱚ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱟᱱᱟᱣ ᱵᱟᱛᱟᱣᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱡᱩᱣᱟ.ᱱ ᱚᱠᱛᱚ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱨᱮ ᱡᱚᱨᱢᱟᱱ ᱥᱟᱶᱦᱮᱫ ᱨᱮ ᱦᱩᱞ ᱯᱷᱩᱴᱟ.ᱜ ᱮᱱᱟ ᱾ ᱡᱟᱦᱟᱸ ᱨᱮᱭᱟᱜ ᱚᱨᱡᱚ ᱞᱮᱠᱟᱛᱮ ᱢᱟᱨᱮ ᱨᱤᱛ ᱵᱤᱦᱤᱛ ᱟᱨᱵᱟᱝ ᱥᱟᱶᱦᱮᱫᱤᱭᱟ. ᱥᱤᱫᱷᱟᱱᱛᱚ ᱨᱮᱭᱟᱜ ᱟ.ᱰᱤ ᱠᱟᱡᱟᱠ ᱛᱮ ᱵᱤᱨᱩᱫᱷ ᱦᱩᱭ ᱮᱱᱟ ᱾ ᱥᱟᱶᱛᱮ ᱚᱱᱚᱬᱦᱤᱭᱟ. ᱥᱟᱶᱛᱮ ᱵᱟᱰᱚᱦᱤᱭᱟ. ᱠᱚᱣᱟᱜ ᱯᱷᱩᱨᱜᱟᱞ ᱟᱨ ᱡᱮᱜᱮᱛᱟ.ᱨᱤ ᱥᱟᱶᱦᱮᱫ ᱨᱮᱭᱟᱜ ᱢᱟᱨᱮ ᱜᱚᱣᱨᱚᱵᱽ ᱨᱮᱭᱟᱜ ᱟᱨ ᱦᱚᱸ ᱵᱟᱧᱪᱟᱣ ᱨᱮᱭᱟᱜ ᱡᱩᱨᱥᱩᱨ ᱠᱚ ᱥᱚᱢᱚᱨᱛᱷᱚᱱ ᱠᱮᱜᱼᱟ ᱾ ᱱᱚᱶᱟ \"ᱛᱩᱯᱷᱟ.ᱱᱤᱭᱟ. ᱡᱩᱜᱽ\" ᱨᱮ ᱦᱩᱞᱥᱟ.ᱭ ᱨᱮᱭᱟᱜ ᱩᱭᱦᱟ.ᱨ ᱢᱤᱫ ᱛᱚᱲ ᱛᱩᱯᱷᱟ. ᱱ ᱥᱚᱢᱟᱱ ᱩᱰᱩᱠ ᱮᱱᱟ ᱾" },
        { "cell": "abbrev", "text": "ᱩᱱᱤᱭᱟᱜ ᱡᱤᱭᱚᱱ ᱨᱮᱭᱟᱜ ᱛᱟᱨᱟᱥᱤᱧ ᱚᱠᱛᱚ ᱨᱮ ᱯᱷᱨᱟᱱᱥ ᱨᱮᱭᱟᱜ ᱨᱟᱡᱽᱼᱟ.ᱨᱤ ᱦᱩᱞᱥᱟ.ᱭ ᱨᱮᱭᱟᱜ ᱦᱚᱭ ᱵᱟ.ᱨᱰᱩ ᱦᱮᱡ ᱮᱱᱟ ᱡᱟᱦᱟᱸᱛᱮ ᱢᱟᱨᱮ ᱵᱮᱵᱚᱥᱛᱟ ᱫᱚ ᱦᱤᱞᱟ.ᱣ ᱩᱛᱟ.ᱨ ᱮᱱᱟ ᱟᱨ ᱞᱟᱠᱷᱼᱞᱟᱠᱷ ᱦᱚᱲᱟᱜ ᱨᱤᱫᱟ.ᱭ ᱨᱮ ᱥᱚᱱᱟ ᱡᱩᱜᱽ ᱨᱮᱭᱟᱜ ᱪᱚᱨᱚᱠ ᱪᱤᱠᱟ.ᱬ ᱠᱩᱠᱢᱩ ᱨᱮᱭᱟᱜ ᱥᱤᱨᱡᱚᱱ ᱦᱩᱭ ᱮᱱᱟ ᱾ ᱡᱩᱫᱤ ᱦᱚᱸ ᱱᱚᱶᱟ ᱠᱩᱠᱢᱩ ᱫᱚ ᱫᱟᱜ ᱯᱷᱚᱴᱠᱟ ᱞᱮᱠᱟ ᱢᱤᱫ ᱰᱚᱸᱰᱮᱠ ᱞᱟ.ᱜᱤᱫ ᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱪᱮᱫᱟᱜ ᱥᱮ ᱱᱚᱣᱟ ᱨᱮᱭᱟᱜ ᱠᱩᱠᱷᱤ ᱠᱷᱚᱱ ᱱᱮᱯᱳᱞᱤᱭᱚᱱ ᱟᱜ ᱚᱯᱮᱞ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱡᱟᱦᱟᱸᱭᱟᱜ ᱨᱤᱦᱤᱴ ᱡᱤᱛᱠᱟ.ᱨ ᱥᱟᱜᱟᱲ ᱭᱩᱨᱳᱯ ᱨᱮ ᱟᱸᱥ ᱨᱮᱭᱟᱜ ᱴᱷᱟᱶ ᱨᱮ ᱯᱩᱨᱟ. ᱱᱤᱨᱟᱥ ᱨᱮᱭᱟᱜ ᱥᱟᱢᱨᱟᱡᱽᱡᱭᱚᱭ ᱛᱷᱟᱯᱚᱱ ᱠᱮᱜᱼᱟ ᱾ ᱢᱩᱪᱟ.ᱫ ᱨᱮ ᱟᱡᱟᱜ ᱡᱤᱭᱚᱱ ᱨᱮᱭᱟᱜ ᱟ.ᱭᱩᱵ ᱚᱠᱛᱚᱨᱮ ᱩᱱᱤ ᱫᱚ ᱤᱱᱰᱩᱥᱴᱨᱤᱭᱟᱞ ᱦᱩᱝᱥᱟ.ᱭ ᱨᱮᱭᱟᱜ ᱟᱴᱮᱫ ᱟᱠᱟᱱ ᱟ.ᱨᱩᱯᱷᱮᱨᱟᱣ ᱨᱮᱭᱟᱜ ᱯᱩᱨᱟ.ᱭ ᱟ.ᱭᱠᱟ.ᱣ ᱠᱮᱜᱼᱟ ᱟᱨ ᱚᱱᱟ ᱱᱟᱶᱟ ᱠᱟ.ᱣᱰᱤ ᱵᱮᱵᱚᱥᱛᱟ ᱨᱮᱭᱟᱜ ᱚᱯᱮᱞ ᱦᱚᱸᱭ ᱧᱮᱞ ᱠᱮᱜᱼᱟ ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱟᱶᱛᱟ ᱨᱮᱭᱟᱜ ᱢᱟᱨᱮ ᱫᱷᱟᱪᱟ ᱨᱟ.ᱯᱩᱫ ᱠᱟᱛᱮ ᱵᱟ.ᱭᱼᱵᱟ.ᱭ ᱛᱮ ᱱᱤᱥᱴᱟ.ᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "latin-in-native", "text": "ᱱᱚᱶᱟ ᱫᱚ ᱜᱟᱵᱟᱱᱟᱜ ᱛᱷᱤᱱᱤᱨ (Multiplicative identity) ᱠᱟᱱᱟ ᱾" },
        { "cell": "latin-in-native", "text": "ᱜᱨᱮᱜᱚᱨᱤ ᱯᱟᱺᱡᱤ (gregorian calendar) ᱞᱮᱠᱟᱛᱮ ᱑ ᱡᱟᱱᱩᱣᱟᱨᱤ ᱫᱚ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱯᱩᱭᱞᱩ ᱫᱤᱱ ᱠᱟᱱᱟ ᱾ ᱥᱮᱨᱢᱟ ᱪᱟᱵᱟᱜ ᱞᱟᱹᱜᱤᱫ ᱓᱖᱕ ᱫᱤᱱ ᱵᱟᱹᱠᱤ ᱢᱮᱱᱟᱜ-ᱟ (leap year ᱨᱮᱫᱚ ᱓᱖᱖ ᱫᱤᱱ) ᱾" },
        { "cell": "latin-in-native", "text": "ᱵᱟᱨ ᱫᱚ ᱡᱚᱲ ᱮᱞ ᱠᱟᱱᱟᱭ ᱾ ᱡᱚᱲ ᱮᱞ (en:even number) ᱠᱚᱫᱚ ᱩᱱᱠᱩ ᱵᱚᱱ ᱢᱮᱛᱟ ᱦᱟᱠᱚᱣᱟ ᱡᱟᱦᱟᱸ ᱮᱞ ᱠᱚ ᱒ ᱛᱮᱠᱚ ᱦᱟᱴᱟᱬᱚᱜᱼᱟ ᱾" },
        { "cell": "latin-in-native", "text": "ᱜᱨᱮᱜᱚᱨᱤ ᱯᱟᱺᱡᱤ (gregorian calendar) ᱞᱮᱠᱟᱛᱮ ᱒ ᱚᱠᱴᱚᱵᱚᱨ ᱫᱚ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱒᱗᱕ ᱟᱜ ᱫᱤᱱ ᱠᱟᱱᱟ (leap year ᱨᱮ ᱫᱚ ᱒᱗᱖ ᱫᱤᱱ) ᱾ ᱥᱮᱨᱢᱟ ᱪᱟᱵᱟᱜ ᱞᱟᱹᱜᱤᱫ ᱟᱨᱦᱚᱸ ᱙᱐ ᱫᱤᱱ ᱵᱟᱹᱠᱤ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "latin-in-native", "text": "ᱜᱚᱥᱟᱸᱭ ᱥᱤᱵᱚᱣᱟᱜ ᱢᱚᱬᱮ ᱫᱚᱴᱟᱝ ᱢᱮᱫᱦᱟᱶ ᱢᱮᱱᱟᱜ-ᱟ, ᱟᱡᱟᱜ ᱢᱟᱱᱛᱟᱨ ᱫᱚ ᱢᱚᱬᱮ ᱟᱹᱲᱟᱹᱣᱟᱱ ᱢᱟᱱᱛᱟᱨ (five worded mantra) ᱠᱚ ᱢᱮᱛᱟᱜ-ᱟ᱾" },
        { "cell": "latin-in-native", "text": "ᱱᱚᱶᱟ ᱚᱣᱟᱝ ᱨᱮ ᱢᱚᱬᱮ ᱜᱚᱴᱟᱜ ᱡᱤᱱᱤᱥ ᱢᱮᱱᱟᱜ-ᱟ᱾ ᱚᱱᱟ ᱠᱚᱫᱚ- ᱫᱷᱟ.ᱨᱛᱤ, ᱥᱮᱝᱜᱮᱞ, ᱫᱟᱜ, ᱦᱚᱭ ᱟᱨ ᱥᱮᱨᱢᱟ (Earth, Fire, Water, Air and Space respectively)" },
        { "cell": "latin-in-native", "text": "ᱥᱤᱠᱷ ᱫᱷᱚᱨᱚᱢ ᱜᱩᱨᱩ ᱜᱩᱨᱩ ᱜᱚᱵᱤᱱᱫᱚᱣᱟᱜ ᱞᱟᱹᱭ ᱞᱮᱠᱟᱛᱮ ᱟᱠᱚᱣᱟᱜ ᱢᱚᱬᱮ ᱜᱚᱴᱟᱝ ᱠᱮ (Panj kakars-Five Ks) ᱢᱮᱱᱟᱜ-ᱟ᱾ ᱚᱱᱟ ᱠᱚᱫᱚ ᱡᱚᱛᱚ ᱠᱮ ᱛᱮᱜᱮ ᱮᱦᱚᱵ ᱟᱠᱟᱱᱟ᱾ ᱚᱱᱟ ᱠᱚᱫᱚ- kesh (Unshorn hair), kangha (the comb), kara (the steel bracelet), kachhehra (the soldiers short) ᱟᱨ kirpan (the sword)᱾" },
        { "cell": "latin-in-native", "text": "ᱟᱞᱞᱟ ᱪᱮᱛᱟᱱ ᱨᱮ ᱯᱟᱹᱛᱭᱟᱹᱣ (Belief in Allah, The Only God)" },
        { "cell": "percent", "text": "᱗᱒ᱹ᱗% ᱦᱚᱲ ᱚᱥᱴᱨᱮᱞᱤᱭᱟᱱ ᱤᱝᱞᱤᱥ ᱛᱮᱠᱚ ᱨᱚᱲᱟ ᱾ ᱱᱚᱰᱮ ᱨᱚᱲᱚᱜ ᱠᱟᱱ ᱮᱴᱟᱜ ᱯᱟᱹᱨᱥᱤ ᱠᱚᱫᱚ ᱢᱟᱱᱰᱟᱨᱤᱱ ( ᱒ᱹ᱕%), ᱟᱨᱚᱵᱤᱠ (᱑ᱹ᱔%), ᱠᱟᱱᱴᱚᱱᱤᱡᱽ, ᱵᱷᱤᱭᱮᱛᱱᱟᱢᱤᱠ ᱟᱨ ᱤᱴᱟᱞᱤᱭᱟᱱ ᱑ᱹ᱒ ᱠᱟᱛᱮ ᱾" },
        { "cell": "percent", "text": "ᱵᱤᱱ ᱫᱷᱚᱨᱚᱢ ᱦᱚᱲ ᱠᱚᱦᱚᱸ ᱱᱚᱰᱮ ᱫᱚ ᱟᱹᱰᱤ ᱥᱟᱸᱜᱮ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱓᱐ᱹ᱑% ᱦᱚᱲ ᱫᱚ ᱚᱠᱟ ᱫᱷᱚᱨᱚᱢ ᱦᱚᱸ ᱵᱟᱠᱚ ᱢᱟᱱᱟᱣᱟ, ᱒᱒ᱹ᱖% ᱦᱚᱲ ᱫᱚ ᱨᱚᱢᱟᱱ ᱠᱟᱹᱛᱷᱞᱤᱠ, ᱑᱘ᱹ᱗% ᱦᱚᱲ ᱫᱚ ᱮᱴᱟᱜ ᱠᱤᱨᱤᱥᱛᱟᱱ, ᱑᱓ᱹ᱓% ᱦᱚᱲ ᱫᱚ ᱟᱝᱜᱽᱞᱤᱠᱟᱱ, ᱒ᱹ᱖% ᱤᱥᱞᱟᱢ, ᱒ᱹ᱕% ᱵᱩᱫᱷᱚ, ᱑ᱹ᱙% ᱦᱤᱱᱫᱩ ᱟᱨ ᱐ᱹ᱔% ᱦᱚᱲ ᱫᱚ ᱡᱚᱭᱱᱚ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱢᱟᱱᱟᱣᱟ ᱾" },
        { "cell": "percent", "text": "ᱮᱰᱵᱷᱮᱴᱟᱡᱽ ᱡᱮᱜᱮᱛ ᱨᱮ ᱜᱩᱜᱚᱞ ᱨᱶᱮᱱᱟᱜ ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱴᱷᱟᱶ ᱜᱮ ᱢᱮᱱᱟᱜᱼᱟ᱒᱐᱑᱑ ᱥᱟᱞᱮ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱟᱨᱡᱟᱣ ᱠᱷᱚᱱ ᱖᱙% ᱫᱚ ᱮᱰᱵᱷᱮᱴᱟᱡᱽ ᱠᱷᱚᱱ ᱜᱮ ᱦᱮᱡ ᱞᱮᱱᱟ ᱯᱟᱱᱛᱮ ᱥᱩᱵᱤᱫᱷᱟ ᱥᱟᱶᱛᱮ ᱜᱩᱜᱚᱞ ᱟᱡᱟᱜ ᱮᱰᱵᱷᱮᱴᱟᱡᱽ ᱥᱩᱵᱤᱫᱷᱟ ᱦᱚᱸᱭ ᱮᱦᱚᱵ ᱟᱠᱟᱫᱼᱟ ᱾ ᱡᱟᱦᱟᱸ ᱨᱮ ᱫᱚ ᱞᱤᱱᱠᱞᱤᱠᱦᱤᱥᱟᱹᱵᱛᱮ ᱦᱚᱲ ᱠᱟᱹᱣᱰᱤᱭ ᱧᱟᱢᱟᱜᱩᱜᱚᱞ ᱨᱮᱱᱟᱜ ᱱᱚᱶᱟ ᱮᱰᱵᱷᱮᱴᱟᱡᱽ ᱥᱩᱵᱤᱫᱷᱟ ᱫᱚ ᱚᱠᱛᱚᱵᱚᱭᱚᱥ ᱟᱨ ᱯᱚᱥᱚᱸᱫᱽ ᱞᱮᱠᱟᱛᱮᱭ ᱥᱮᱴᱮᱨᱟᱦᱚᱲ ᱴᱷᱮᱱ" },
        { "cell": "percent", "text": "ᱠᱟᱹᱢᱤᱭᱟᱹ ᱠᱚ ᱥᱟᱨᱦᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱜᱩᱜᱚᱞ ᱩᱱᱠᱩ ᱒᱐% ᱚᱠᱛᱚ ᱫᱚ ᱢᱚᱱ ᱠᱩᱥᱤᱠᱟᱹᱢᱤ ᱞᱟᱹᱜᱤᱫ ᱫᱟᱣᱮᱢᱟ ᱠᱚᱣᱟ" },
        { "cell": "percent", "text": "ᱞᱤᱢᱵᱩ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱢᱤᱫᱦᱩᱰᱤᱧ ᱫᱟᱨᱮ ᱡᱟᱦᱟᱸ ᱨᱮᱱᱟᱜ ᱥᱟᱠᱟᱢ ᱫᱚ ᱦᱟᱹᱨᱭᱟᱹᱲ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱨᱟᱵᱟᱝ ᱨᱤᱛᱩ ᱨᱮᱱᱟᱜ ᱢᱩᱪᱟᱹᱫ ᱥᱮᱫ ᱨᱮᱦᱚᱸ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱮᱥᱤᱭᱟ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱟᱨ ᱡᱚ ᱫᱚ ᱥᱤᱢᱵᱤᱞᱤ ᱞᱮᱠᱟ ᱜᱩᱞᱟᱹᱭ ᱜᱮᱭᱟ ᱟᱨ ᱵᱮᱨᱮᱞ ᱛᱮ ᱫᱚ ᱦᱟᱹᱨᱭᱟᱹᱲ ᱟᱨ ᱵᱤᱞᱤ ᱠᱟᱛᱮ ᱥᱟᱥᱟᱝ ᱜᱮ ᱧᱮᱞᱚᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱤᱥᱤᱱ ᱵᱟᱥᱟᱝ ᱨᱮ ᱞᱟᱜᱟᱛᱚᱜᱼᱟ ᱟᱨ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮ ᱵᱟᱹᱲᱛᱤ ᱫᱚ ᱡᱩᱥ ᱵᱮᱱᱟᱣ ᱨᱮ ᱠᱚ ᱞᱟᱜᱟᱣᱮᱜᱼᱟ ᱾ ᱞᱤᱢᱵᱩ ᱨᱮᱱᱟᱜ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱧᱩᱛᱩᱢ ᱫᱚ ᱥᱟᱭᱴᱨᱚᱥ ᱞᱤᱢᱚᱱ (Citrus limon) ᱾ ᱞᱤᱢᱵᱩ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱥᱟᱥᱟᱝ ᱥᱟᱭᱴᱨᱚᱥ ᱡᱚ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱥᱚᱱᱛᱚᱨᱟ ᱥᱟᱞᱟᱜ ᱢᱤᱫ ᱫᱷᱟᱨᱟ ᱜᱮᱭᱟ ᱾ ᱞᱤᱢᱵᱩ ᱡᱩᱥ ᱨᱮ ᱕% ᱥᱟᱭᱴᱨᱤᱠ ᱮᱥᱤᱰ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱟᱨ pH ᱒ ᱠᱷᱚᱱ ᱓ ᱜᱟᱱ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱾ ᱞᱤᱵᱩ ᱫᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱩᱥᱩᱞ ᱨᱮ ᱵᱷᱮᱯᱮᱫ ᱛᱟᱦᱮᱸᱱ ᱜᱮᱭᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱵᱟᱹᱲᱛᱤ ᱠᱟᱛᱮ ᱦᱩᱰᱤᱧ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱩᱥᱯᱞ ᱫᱚ ᱖ ᱢᱤᱴᱚᱨ ᱜᱟᱱ ᱦᱩᱭᱩᱜᱼᱟ ᱾" },
        { "cell": "percent", "text": "᱑᱙ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱥᱮᱫ ᱫᱚ ᱱᱚᱸᱰᱮ ᱨᱮᱞᱜᱟᱹᱰᱤ ᱨᱮᱱᱟᱜ ᱦᱚᱨ ᱦᱚᱸ ᱠᱚ ᱵᱮᱱᱟᱣ ᱠᱮᱫ-ᱟ ᱟᱨ ᱟᱱᱟᱜᱚᱱᱟ ᱟᱨ ᱵᱮᱯᱟᱨ ᱤᱫᱤ ᱟᱹᱜᱩ ᱨᱮ ᱟᱹᱰᱤ ᱡᱩᱨ ᱠᱚ ᱥᱩᱵᱤᱫᱷᱟ ᱮᱱᱟ ᱾ ᱮᱛᱚᱦᱚᱵ ᱨᱮᱞᱜᱟᱹᱰᱤ ᱫᱚ ᱑᱘᱓᱙ ᱥᱟᱞᱮ ᱨᱮ ᱟᱢᱥᱴᱚᱨᱰᱮᱢ ᱠᱷᱚᱱ ᱦᱟᱨᱞᱮᱢ ᱦᱟᱹᱵᱤᱡ ᱮ ᱫᱟᱹᱲ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱦᱚᱲ ᱦᱚᱸ ᱚᱱᱟ ᱱᱟᱜᱟᱨ ᱨᱮ ᱠᱚ ᱵᱟᱹᱲᱛᱤ ᱤᱫᱤ ᱮᱱᱟ , ᱑᱘᱕᱐ ᱨᱮ ᱫᱚ ᱒᱕᱐,᱐᱐᱐ ᱮᱞ ᱠᱚ ᱥᱮᱴᱮᱨ ᱮᱱᱟ ᱟᱨ ᱑᱙᱐᱐ ᱥᱟᱞᱮ ᱨᱮ ᱫᱚ ᱕᱐᱐,᱐᱐᱐ ᱠᱚ ᱥᱮᱴᱮᱨ ᱮᱱᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱢᱟᱨᱟᱝ ᱠᱟᱹᱨᱜᱟᱲ ᱱᱟᱜᱟᱨ ᱞᱮᱠᱟᱛᱮ ᱵᱮᱨᱮᱫ ᱮᱱᱟ ᱾ ᱒᱐᱒᱕ ᱥᱟᱞᱮ ᱥᱮᱫ ᱛᱮ ᱫᱚ ᱑᱒.᱖% ᱜᱟᱱ ᱦᱚᱲ ᱠᱚ ᱵᱟᱹᱲᱛᱤᱜ ᱢᱮᱱᱛᱮ ᱯᱟᱭᱛᱟᱨ ᱟᱠᱟᱱᱟ ᱾ ᱢᱮᱱ ᱫᱚ ᱙᱐᱐,᱐᱐᱐ ᱦᱚᱲ ᱱᱚᱣᱟ ᱱᱟᱜᱟᱨ ᱨᱮ ᱟᱨ ᱒.᱕ ᱢᱤᱞᱤᱭᱚᱱ ᱦᱚᱲ ᱱᱚᱣᱟ ᱱᱟᱜᱟᱨ ᱨᱮ ᱠᱚ ᱦᱩᱭᱩᱜ-ᱟ ᱢᱮᱱᱛᱮ ᱵᱟᱰᱟᱭ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "percent", "text": "ᱟᱯᱷᱨᱤᱠᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱭᱟᱜ ᱫᱚᱥᱟᱨ ᱢᱟᱨᱟᱝ ᱢᱟᱦᱟᱫᱮᱥ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱭᱟᱜ ᱖% ᱟᱨ ᱚᱛ ᱨᱮᱭᱟᱜ ᱒᱐.᱔% ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ ᱾" },
        { "cell": "percent", "text": "ᱟᱯᱷᱨᱤᱠᱟᱱ ᱦᱚᱲ ᱫᱚ ᱟᱹᱰᱤ ᱜᱟᱱ ᱫᱷᱚᱨᱚᱢ ᱨᱮ ᱯᱟᱹᱛᱤᱭᱟᱹᱣ ᱢᱮᱱᱟᱜ ᱛᱟᱠᱚᱣᱟ ᱾ ᱡᱮᱜᱮᱛ ᱯᱩᱛᱷᱤ ᱜᱮᱭᱟᱱ ᱠᱚᱥ (World Book Encyclopedia) ᱚᱝᱥᱟᱨ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮ ᱤᱥᱞᱟᱢ ᱦᱚᱲ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱡᱟᱹᱥᱛᱤ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱤᱱᱟᱹ ᱠᱷᱚᱱ ᱠᱚᱢ ᱫᱚ ᱠᱤᱨᱤᱥᱛᱟᱱ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱜᱮᱭᱟᱱ ᱠᱚᱥ ᱵᱨᱤᱴᱮᱱᱤᱭᱟ (Encyclopædia Britannica) ᱚᱝᱥᱟᱨ ᱫᱚ ᱔᱕% ᱠᱤᱨᱤᱥᱛᱟᱱ ᱦᱚᱲ, ᱔᱐% ᱢᱩᱥᱞᱤᱢ ᱦᱚᱲ ᱟᱨ ᱑᱐% ᱦᱚᱲ ᱫᱚ ᱥᱮᱰᱟᱭᱟᱜ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱢᱟᱱᱟᱣᱟ ᱾ ᱟᱯᱷᱨᱤᱠᱟ ᱦᱤᱱᱫᱩ, ᱵᱩᱫᱷᱚ ᱫᱷᱚᱨᱚᱢ ᱦᱚᱲ ᱫᱚ ᱟᱹᱰᱤ ᱠᱚᱢ ᱜᱮ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱪᱮᱫ ᱫᱷᱚᱨᱚᱢ ᱵᱟᱝ ᱢᱟᱱᱟᱣ ᱦᱚᱲ ᱢᱮᱱᱮᱛ ᱱᱟᱥᱛᱤᱠ ᱦᱚᱲ ᱫᱚ ᱟᱹᱫᱤ ᱠᱚᱢ ᱜᱮ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾" },
        { "cell": "rate", "text": "ᱵᱟᱹᱲᱛᱤ ᱠᱟᱛᱮ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱱᱟᱜᱟᱨ ᱠᱚ ᱫᱚ ᱥᱤᱛᱩᱝ ᱟᱱ ᱜᱮᱭᱟ ᱾ ᱯᱟᱴᱱᱟ ᱨᱮᱱᱟᱜ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ ᱜᱚᱴᱟᱜᱩᱴᱤ ᱞᱚᱞᱥᱚᱝ ᱓᱒.᱑ o C ᱞᱮᱠᱟ ᱵᱩᱡᱷᱟᱹᱣᱼᱟ ᱟᱨ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱠᱚᱢ ᱢᱮᱱ ᱞᱮᱠᱷᱟᱱ ᱒᱔.᱕ o C ᱾ ᱱᱚᱸᱰᱮᱱᱟᱜ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ ᱡᱟᱹᱲᱤ ᱫᱚ ᱑᱓᱕᱔.᱐ mm/inch ᱾" },
        { "cell": "rate", "text": "ᱱᱚᱰᱮ ᱫᱚ ᱟᱹᱰᱤ ᱜᱟᱱ ᱫᱷᱮᱨᱚᱢ ᱨᱮᱱ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱱᱚᱰᱮᱱ ᱠᱚ ᱗᱐% ᱦᱚᱲ ᱵᱩᱫᱫᱷᱚ ᱫᱷᱚᱨᱚᱢ ᱨᱮᱱ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱒ ᱥᱚᱛᱟᱵᱽᱫᱤ/ᱥᱟᱭᱟᱝ ᱨᱮ ᱱᱚᱰᱮ ᱵᱩᱫᱫᱷᱚ ᱫᱷᱚᱨᱚᱢ ᱫᱚ ᱮᱦᱚᱵ ᱞᱮᱱᱟ ᱾ ᱦᱤᱱᱫᱩ ᱫᱷᱚᱨᱚᱢ ᱱᱚᱰᱮᱱᱟᱜ ᱫᱚᱥᱟᱨ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲ ᱠᱚ ᱢᱟᱱᱟᱣᱮᱫ ᱫᱷᱚᱨᱚᱢ ᱠᱟᱱᱟ ᱾ ᱱᱚᱰᱮᱱ ᱠᱚ ᱦᱤᱱᱫᱩ ᱫᱷᱚᱨᱚᱢ ᱦᱚᱲ ᱫᱚ ᱛᱟᱢᱤᱞ ᱦᱚᱲ ᱠᱟᱱᱟ ᱠᱚ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱨᱮᱭᱟᱜ ᱫᱷᱚᱨᱚᱢ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱤᱥᱞᱟᱢ ᱫᱷᱚᱨᱚᱢ ᱾" },
        { "cell": "rate", "text": "ᱢᱟᱲᱚᱛᱤ ᱢᱩᱨᱢᱩ ᱫᱚ ᱯᱷᱟ.ᱜᱩᱱ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ ᱨᱤᱱᱤᱡ ᱥᱟᱯᱲᱮᱫ ᱠᱟᱱᱟᱭ ᱾ ᱯᱟ.ᱨᱥᱤ ᱥᱤᱧ ᱪᱟᱸᱫᱚ ᱜᱩᱨᱩ ᱜᱚᱢᱠᱮ ᱯᱚᱸᱰᱤᱛ ᱨᱟ.ᱜᱷᱤᱱᱟᱛ ᱢᱩᱨᱢᱩᱭ ᱥᱤᱨᱡᱚᱱ ᱟᱠᱟᱫ ᱚᱞᱪᱤᱠᱤᱛᱮ ᱥᱟᱱᱛᱟᱲᱤ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ ᱯᱟᱨᱥᱟᱞ ᱞᱟᱹᱜᱤᱫ ᱒᱐᱐᱘ ᱥᱟᱞᱮ ᱨᱮ ᱯᱷᱟᱹᱜᱩᱱ ᱵᱚᱝᱜᱟ ᱨᱮᱱᱟᱜ ᱠᱩᱱᱟᱹᱢᱤ ᱨᱮ ᱜᱚᱴᱟ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱟᱨ.ᱮᱱ.ᱟᱭ ᱱᱟᱶᱟ ᱫᱤᱞᱤ ᱠᱷᱚᱱ ᱪᱷᱟᱹᱴᱤᱭᱟᱨ ᱛᱩᱱᱠᱷᱤ ᱧᱟᱢ ᱛᱟᱭᱚᱢ ᱒᱐᱐᱘ ᱨᱮ ᱮᱯᱨᱤᱞ ᱠᱷᱚᱱ ᱯᱷᱟ.ᱜᱩᱱ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ ᱯᱟᱨᱥᱟᱞᱚᱜ ᱠᱟᱱᱟ ᱾ ᱟᱨ.ᱮᱱ.ᱟᱭ ᱨᱮ ᱨᱮᱡᱤᱥᱴᱟᱰ ᱦᱩᱭ ᱛᱟᱭᱚᱢ ᱰᱟᱠ ᱵᱤᱵᱷᱟᱹᱜᱽ ᱨᱮ ᱨᱮᱡᱤᱥᱴᱟᱨᱰ ᱦᱩᱭ ᱞᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ ᱫᱚ ᱪᱟᱸᱫᱚᱠᱤᱭᱟᱹ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ ᱠᱟᱱᱟ ᱾ ᱡᱚᱛᱚ ᱪᱟᱸᱫᱚ ᱨᱮᱱᱟᱜ ᱗ ᱠᱷᱚᱱ ᱙ ᱢᱟᱹᱦᱤᱛ ᱛᱮ ᱑᱖᱐᱐ ᱜᱚᱴᱟᱝ ᱯᱷᱟᱹᱜᱩᱱ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ ᱵᱷᱮᱡᱟ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱾ ᱯᱷᱟᱹᱜᱩᱱ ᱨᱮ ᱱᱤᱛᱚᱜ ᱫᱷᱟᱹᱵᱤᱡ ᱛᱮ ᱑᱓᱖ ᱦᱚᱲ ᱡᱤᱵᱚᱱᱵᱷᱩᱨ ᱥᱚᱦᱮᱫ ᱟᱨ ᱑᱔᱑᱒ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ/ᱵᱟᱨ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ ᱜᱚᱨᱦᱟᱠ ᱠᱚ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "rate", "text": "ᱟᱥᱚᱞ ᱰᱟᱹᱨ ᱥᱟᱺᱦᱤᱡ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱥᱟᱱᱟᱢ ᱯᱚᱱᱚᱛ/ᱥᱟᱸᱜᱷ ᱴᱚᱴᱷᱟ ᱨᱮ ᱵᱮᱸᱠ ᱨᱮᱱᱟᱜ ᱔᱘᱒᱘ ᱰᱟᱹᱨ ᱢᱮᱱᱟᱜ-ᱟ᱾ ᱱᱚᱶᱟ ᱰᱟᱹᱨ ᱨᱮᱱᱟᱜ ᱱᱤᱭᱚᱱᱛᱨᱚᱱ ᱕᱐ ᱟᱸᱪᱚᱞᱤᱠ ᱚᱯᱷᱤᱥ ᱠᱚ ᱦᱚᱛᱮᱛᱮ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ᱾ ᱣᱤᱫᱮᱥ ᱨᱮ ᱵᱮᱸᱠ ᱨᱮᱱᱟᱜ ᱕᱖ ᱰᱟᱹᱨ/ᱠᱟᱨᱭᱚᱞᱟᱭ ᱟᱨ ᱚᱱᱩᱥᱚᱸᱜᱤᱭᱟ ᱟᱨ ᱑ ᱩᱫᱽᱭᱚᱢ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "rate", "text": "(ᱤᱝᱞᱤᱥ ᱺSukhumi Babushara Airport) , ᱞᱟᱦᱟ ᱛᱮᱫᱚ ᱱᱚᱶᱟ ᱡᱟᱭᱜᱟ ᱫᱚ ᱥᱩᱠᱷᱩᱢᱤ ᱰᱟᱨᱟᱱᱰᱟ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱡᱟᱭᱜᱟ ᱛᱮ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱱᱟ, ᱟᱨ ᱣᱞᱟᱰᱤᱥᱞᱚᱣ ᱥᱚᱠᱷᱚᱢᱤ ᱡᱮᱜᱮᱛᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱧᱩᱛᱩᱢ ᱛᱮᱦᱚᱸ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟ᱾ , ᱱᱚᱶᱟ ᱫᱚ ᱟᱵᱽᱠᱷᱟᱡᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱨᱮᱦᱮᱫ ᱰᱟᱹᱨ ᱠᱟᱱᱟᱹ ᱱᱚᱶᱟ ᱫᱚ ᱵᱟᱵᱩᱥᱟᱨᱟ ᱟᱹᱛᱩ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱟᱨ ᱫᱚᱥᱟᱨ ᱫᱚ ᱰᱟᱨᱟᱱᱰᱟ ᱟᱹᱛᱩ ᱨᱮᱱᱟᱜ ᱢᱟᱨᱟᱝ ᱟᱹᱛᱩ ᱠᱟᱱᱟ ᱟᱨ ᱟᱫᱷᱟᱱ ᱫᱚ ᱥᱩᱠᱷᱩᱢᱤ ᱠᱷᱚᱱ ᱒᱐ ᱠᱢ/ᱢᱤ ᱥᱟᱺᱜᱤᱱ ᱚᱴᱚᱢᱚᱱᱟᱥ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱯᱚᱱᱚᱛ ᱠᱷᱚᱱ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "rate", "text": "ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮᱭᱟᱜ ᱑᱙᱙᱘ ᱥᱟᱞ ᱨᱮᱭᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱚᱝᱥᱟᱨ ᱜᱽᱣᱟᱫᱟᱨ ᱡᱤᱞᱟᱹ ᱨᱮᱭᱟᱜ ᱦᱚᱲ ᱮᱞ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱑᱘᱕,᱔᱙᱘ ᱡᱷᱚᱬ ᱾ ᱱᱚᱣᱟ ᱨᱮᱭᱟᱜ ᱮᱨᱤᱭᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 12,637&nbsp;km² ᱾ ᱱᱚᱰᱮᱱᱟᱜ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱯᱤᱪᱷᱤ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱨᱮᱭᱟᱜ ᱫᱟᱹᱨᱭᱟᱹ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 14.7 people/km² ᱾ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱤᱡ ᱪᱮᱭᱟᱨᱢᱮᱱ ᱫᱚᱭ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱵᱟᱵᱟᱚ ᱜᱩᱞᱟᱵᱽ ᱟᱨ ᱢᱩᱱᱤᱥᱤᱯᱟᱞ ᱠᱚᱢᱭᱩᱱᱤᱴᱤ ᱨᱮᱱᱤᱡ ᱪᱮᱭᱟᱨᱢᱮᱱ ᱮ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱟᱫᱤᱵᱽ ᱨᱮᱦᱮᱢ ᱥᱟᱨᱟᱵᱤ ᱾" },
        { "cell": "rate", "text": "ᱥᱟᱱᱛᱟᱲ ᱠᱚᱣᱟᱜ ᱯᱟᱹᱨᱤᱥ ᱡᱟᱹᱱᱤ ᱩᱯᱨᱩᱢ ᱟᱨ ᱠᱟᱹᱢᱤ-:ᱠᱷᱮᱨᱣᱟᱲ ᱵᱚᱝᱥᱚ ᱥᱟᱱᱛᱟᱲ ᱠᱚᱫᱚ ᱯᱟᱹᱨᱤᱥ ᱤᱫᱤ ᱠᱟᱛᱮ ᱵᱷᱤᱱᱟᱹᱛᱮ ᱩᱯᱩᱨᱩᱢ ᱧᱩᱛᱩᱢ ᱠᱚ ᱟᱢᱮᱴ ᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱚᱱᱟ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱢᱤ ᱦᱚᱸᱠᱚ ᱛᱚᱨᱟᱣ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱜᱮ ᱞᱟᱛᱟᱨ ᱨᱮ ᱮᱢ ᱮᱱᱟ ᱾ ᱑ᱼᱦᱟᱸᱥᱫᱟᱜᱼᱯᱩᱨᱩᱫᱷᱩᱞᱼᱟᱪᱟᱨ ᱵᱤᱪᱟᱹᱨ ᱒ᱼᱢᱩᱨᱢᱩᱼᱴᱷᱟᱹᱠᱩᱨ/ᱱᱟᱭᱠᱮᱼᱵᱚᱸᱜᱟ ᱵᱩᱨᱩ ᱓ᱼᱠᱤᱥᱠᱩᱼᱨᱟᱯᱟᱡᱽ/ᱨᱟᱡᱟ ᱔ᱼᱦᱮᱢᱵᱽᱨᱚᱢᱼᱠᱟᱹᱨᱡᱤᱼᱫᱮᱣᱟᱱ, ᱢᱚᱱᱛᱨᱤ ᱕ᱼᱢᱟᱺᱨᱰᱤᱼᱠᱤᱥᱟᱹᱬᱼᱢᱟᱦᱟᱡᱚᱱ,ᱥᱚᱨᱫᱟᱨ ᱖ᱼᱥᱚᱨᱮᱱᱼᱥᱤᱯᱟᱹᱦᱤᱼᱥᱮᱱᱟ,ᱯᱷᱟᱹᱫᱽ ᱗ᱼᱴᱩᱰᱩᱼᱨᱩᱥᱤᱠᱟᱼ ᱢᱟᱹᱫᱟᱹᱲᱤᱭᱟ,ᱢᱮᱬᱦᱮᱫ ᱠᱟᱹᱢᱤ ᱦᱚᱸᱠᱚ ᱠᱟᱹᱢᱤ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱘ᱼᱵᱟᱥᱠᱮᱼ ᱵᱮᱯᱟᱨᱨᱤᱭᱟᱹᱼ ᱵᱟᱹᱱᱤᱡ ᱵᱮᱯᱟᱨ,ᱠᱟᱨᱵᱟᱨ ᱙ᱼᱵᱮᱥᱨᱟᱼᱱᱟᱪᱚᱱᱤᱭᱟᱹᱼᱮᱱᱮᱡ ᱥᱮᱨᱮᱧ ᱠᱟᱹᱢᱤ ᱠᱚ ᱠᱟᱹᱢᱤ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱨ ᱟᱫᱚᱢ ᱠᱚᱫᱚ ᱪᱤᱞᱤ ᱪᱚᱠᱚ ᱩᱯᱩᱨᱩᱢ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱪᱤ ᱪᱮᱫ ᱠᱚᱠᱚ ᱠᱟᱹᱢᱤ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱚᱱᱟᱛ ᱩᱱᱠᱩ ᱯᱟᱹᱨᱤᱥ ᱠᱚᱣᱟᱦ ᱩᱯᱩᱨᱩᱢ ᱧᱩᱛᱩᱢ ᱟᱨ ᱠᱟᱹᱢᱤ ᱫᱚ ᱵᱟᱝ ᱵᱟᱰᱟᱭ ᱧᱟᱢᱚᱜ ᱠᱟᱱ ᱛᱮ ᱵᱟᱝ ᱚᱞ ᱥᱚᱫᱚᱨᱚᱜ ᱠᱟᱱᱟ ᱾ ᱛᱟᱭᱚᱢ ᱫᱟᱨᱟᱢ ᱯᱚᱨᱢᱟᱬ ᱧᱟᱢ ᱞᱮᱱ ᱠᱷᱟᱱ ᱫᱚᱲᱚᱢᱚᱜᱼᱟ ᱾" },
        { "cell": "rate", "text": "᱑᱙᱓᱙ ᱥᱟᱞᱨᱮ ᱥᱠᱟᱞᱤᱭᱟ ᱟᱡᱟᱜ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱥᱟᱶᱛᱮ ᱤᱞᱚᱢᱦᱚᱨᱴ (:en:Elmhurst) ᱥᱮᱠᱥᱳᱱ ᱨᱮᱭᱟᱜ ᱠᱤᱭᱤᱱᱥᱱᱭᱩᱨᱳᱨᱠ ᱛᱮᱠᱚ ᱩᱪᱟ.ᱲ ᱦᱮᱡ ᱞᱮᱱᱟ, ᱱᱚᱸᱰᱮ ᱠᱷᱚᱱᱜᱮ ᱯᱨᱟᱭᱢᱮᱨᱤ ᱥᱮᱪᱮᱫ ᱮᱦᱚᱵ ᱞᱮᱱ ᱛᱟ.ᱠᱤᱱᱟ ᱾ ᱥᱚᱨᱠᱟᱨᱤ ᱟᱥᱲᱟ ᱠᱷᱚᱱ ᱘ ᱪᱟᱱᱚᱪ/ᱜᱨᱮᱰ ᱥᱟ.ᱛ ᱞᱮᱫᱟᱭ ᱟᱨ ᱢᱚᱱᱦᱟᱛᱛᱚᱢ (:en:Manhattan) ᱨᱮᱭᱟᱜ ᱡᱟᱵᱷᱤᱭᱚᱨ ᱞᱟᱯᱷᱟᱝ ᱟᱥᱲᱟ (Xavier High School), ᱡᱮᱥᱩᱴ (Jesuit) ᱨᱮᱭᱟᱜ ᱢᱤᱞᱤᱴᱟᱨᱤ ᱟᱥᱲᱟ ᱠᱷᱚᱱ ᱚᱞᱚᱜ ᱞᱟ.ᱜᱤᱫ ᱥᱠᱳᱞᱟᱨᱥᱤᱯ ᱧᱟᱢ ᱞᱮᱫᱟᱭ ᱾ ᱱᱚᱸᱰᱮ ᱠᱷᱚᱱᱜᱮ ᱑᱙᱘᱓ ᱥᱟᱞᱨᱮ ᱯᱩᱭᱞᱩ ᱥᱚᱱᱮᱨ ᱰᱤᱜᱽᱨᱤ ᱥᱟ.ᱛ ᱞᱮᱫᱟᱭ ᱟᱨ ᱵᱷᱟᱞᱮᱰᱤᱠᱴᱳᱨᱤᱭᱟᱱ (valedictorian) ᱞᱮᱠᱟᱛᱮ ᱡᱤᱭᱚᱱ ᱠᱷᱟᱱᱰᱟᱣ ᱮᱦᱚᱵ ᱞᱮᱫᱟᱭ ᱾" },
        { "cell": "zero-width", "text": "ᱛᱟᱡᱽᱢᱚᱦᱚᱞ ᱵᱮᱱᱟᱣ ᱨᱮ ᱟᱨᱟᱜ ᱫᱷᱤᱨᱤ, ᱥᱟᱝᱠᱷᱟ ᱡᱤᱲᱤᱫ ᱫᱷᱤᱨᱤ ᱥᱟᱶᱛᱮ ᱒᱐ ᱜᱚᱴᱟᱝ ᱫᱟᱢᱟᱱ ᱫᱷᱤᱨᱤ ᱢᱮᱥᱟ ᱠᱟᱛᱮ ᱠᱚ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱫ-ᱟ ᱾ ᱢᱮᱱᱟᱚ ᱯᱷᱚᱛᱮᱯᱩᱨ ᱥᱤᱠᱨᱤ ᱠᱷᱚᱱ ᱥᱟᱭ ᱯᱩᱝᱜᱮ ᱥᱟᱥᱟᱭ ᱥᱟᱜᱟᱲ ᱛᱮ ᱟᱨᱟᱜ ᱫ‌ᱷᱤᱨᱤ ᱱᱚᱸᱰᱮ ᱠᱚ ᱟᱹᱜᱩ ᱞᱮᱫ-ᱟ ᱾ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱟᱭᱢᱟ ᱨᱟᱡᱟ ᱱᱟᱯᱟᱭ ᱱᱟᱯᱟᱭ ᱫᱷᱤᱨᱤ ᱠᱚ ᱠᱩᱞ ᱟᱫᱮ ᱛᱟᱦᱮᱸᱫ ᱥᱟᱶᱛᱮ ᱯᱚᱨᱡᱟ ᱠᱚ ᱦᱚᱸ ᱠᱷᱟᱡᱽᱱᱟ ᱴᱟᱠᱟ ᱵᱚᱫᱚᱞ ᱛᱮ ᱫᱷᱤᱨᱤ ᱮᱢ ᱠᱟᱛᱮ ᱨᱟᱡᱟ ᱠᱚ ᱨᱟᱹᱥᱠᱟᱹ ᱚᱸᱪᱚ ᱞᱮᱫᱮ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "zero-width", "text": "ᱵᱷᱤᱞᱮᱡᱽᱠᱩᱣᱮᱡᱽ, ᱰᱤᱭᱮᱜᱚ‌‌‍‌‍‌ (en:Velázquez, Diego)" },
        { "cell": "zero-width", "text": "ᱜᱨᱤᱥ ᱨᱮᱱᱟᱜ ᱥᱤᱨᱟᱠᱭᱩᱥ ᱨᱮ ᱟᱹᱠᱤᱱᱟᱜ ᱡᱟᱱᱟᱢ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱩᱱᱠᱤᱱ ᱫᱚ ᱢᱤᱫ ᱮᱞᱠᱷᱟ ᱯᱩᱨᱩᱫᱷᱩᱞ, ᱥᱟᱬᱮᱥᱤᱭᱟᱹ, ᱤᱧᱡᱤᱱᱤᱭᱟᱹᱨ ᱟᱨ ᱮᱝᱜᱮᱞ ᱥᱟᱬᱮᱥᱤᱭᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱥᱮᱫᱟᱭ ᱨᱤᱱ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱠᱚ ᱛᱟᱞᱟ ᱠᱷᱚᱱ ᱱᱩᱭ ᱦᱚᱸ ᱢᱤᱫ ᱵᱷᱩᱨᱠᱟᱹᱜ ᱤᱯᱤᱞ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱥᱮᱫᱟᱭ ᱚᱠᱛᱚ ᱨᱮ ᱞᱮᱯᱮᱨ ᱥᱟᱬᱮᱥ (hydrostatic) ᱨᱮᱱᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱫ ᱟᱭ ᱚᱱᱟ ᱥᱟᱶᱛᱮ ᱮᱞᱠᱷᱟ ᱨᱮ ᱦᱚᱸ ᱠᱟᱞᱠᱩᱞᱚᱥ ᱟᱨ ᱟᱱᱟᱞᱤᱥᱤᱥ ᱞᱮᱠᱟᱱ ᱮᱞᱠᱷᱟ ᱥᱩᱛᱩᱨ ᱡᱟᱦᱟᱸ ᱥᱩᱛᱩᱨ ᱛᱮ ᱟᱭᱢᱟ ᱟᱠᱟᱨ ᱜᱚᱲᱦᱚᱱ ᱚᱛᱚᱱ ᱠᱚ ᱢᱟᱯ ᱜᱟᱱᱚᱜ ᱠᱟᱱᱟ ᱚᱱᱟᱭ ᱵᱮᱱᱟᱣ ᱞᱮᱜᱼᱟ ᱾ ᱟᱨ ᱦᱚᱸ ᱞᱟᱸᱜᱟᱵ ᱦᱚᱨᱟ ᱵᱮᱵᱷᱟᱨ ᱠᱟᱛᱮ ᱯᱟᱨᱟᱵᱚᱞᱟ ᱨᱮᱱᱟᱜ ᱚᱛᱚᱱ ᱚᱰᱚᱠ, ᱚᱦᱤᱥᱟᱹᱵ ᱮᱞ ᱨᱮᱱᱟᱜ ᱥᱮᱞᱮᱫ ᱥᱟᱶᱛᱮ ‌‍‌π ᱨᱮᱱᱟᱜ ᱫᱟᱲᱮ ᱦᱚᱸᱭ ᱚᱰᱚᱠ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱩᱱᱤ ᱫᱚ ᱡᱩᱜᱽ ᱯᱩᱨᱩᱫᱩᱞ ᱮᱞᱠᱷᱟ ᱯᱟᱹᱨᱩᱠᱷᱤᱭᱟᱹ ᱢᱮᱱᱛᱮ ᱦᱚᱸᱭ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟ ᱾ ᱥᱤᱨᱚᱥ ᱫᱚᱠᱷᱚᱞ ᱚᱠᱛᱚ ᱨᱮ ᱩᱱᱤ ᱜᱚᱡ ᱨᱮᱱᱟᱜ ᱟᱫᱮᱥ ᱵᱟᱝ ᱛᱟᱦᱮᱸ ᱠᱟᱱ ᱨᱮᱦᱚᱸ, ᱢᱤᱫ ᱨᱚᱢᱟᱱ ᱯᱷᱟᱹᱫᱟᱜ ᱛᱤᱻ ᱛᱮ ᱟᱡᱟᱜ ᱜᱚᱡ ᱦᱩᱭ ᱞᱮᱱ ᱛᱟᱭᱟ ᱾" },
        { "cell": "zero-width", "text": "ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱛᱚᱛᱷᱽᱭᱚ (data) ᱟᱫᱷᱟᱨ ᱯᱟᱦᱟᱴᱟ ᱠᱷᱚᱱ ᱜᱮ ᱠᱚ ᱦᱟᱛᱟᱣ ᱫᱚᱦᱚᱭᱟ ᱾ ᱡᱟᱸᱦᱟᱸᱭ ᱫᱚ (UIDAI) unique identification authority of India ᱾᱒᱘ ᱡᱟᱱᱩᱣᱟᱨᱤ ᱒᱐᱐᱙ ᱥᱟᱞᱮ ᱨᱮ ᱵᱷᱟᱨᱚᱛ ᱥᱚᱨᱠᱟᱨ ᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱜ ᱟ ᱾ ᱟᱫᱷᱟᱨ ᱫᱚ ᱥᱤᱸ‌‍‌‌‌ᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱟᱨᱟᱝ biometric ID system ᱠᱟᱱᱟ ᱾ ᱡᱚᱛᱚ ᱞᱮᱠᱟᱱ ᱩᱯᱩᱨᱩᱡ ᱥᱟᱠᱟᱢ ᱠᱚ ᱯᱟᱞᱮ ᱱᱚᱠᱚᱞ ᱜᱚᱱᱚᱜ ᱟ ᱢᱮᱱᱠᱷᱟᱱ ᱟᱫᱷᱟᱨ ᱩᱯᱩᱨᱩᱢ ᱥᱟᱠᱟᱢ ᱫᱚ ᱵᱟᱝ ᱜᱟᱱᱚᱜ ᱟ ᱾" },
        { "cell": "zero-width", "text": "᱓- ᱠᱩᱢᱲᱩ ᱞᱮᱠᱟᱱ ᱠᱟᱹᱢᱤ ᱟᱨ ᱯᱷᱚᱨᱡᱚᱨᱤ ᱠᱚ ᱫᱟᱨᱟᱢ ᱜᱟᱱᱚᱜ ᱟ ‌‍‍‍᱾" },
        { "cell": "zero-width", "text": "ᱮᱛᱚᱢ ᱟᱯᱷᱨᱤᱠᱟ ᱫᱚ ᱟᱯᱷᱨᱤᱠᱟ ᱢᱚᱦᱟᱫᱤᱥᱚᱢ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱢ ᱢᱩᱪᱟᱹᱫ ᱨᱮ ᱢᱮᱱᱟᱜ ᱢᱤᱫ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ ᱾ ᱫᱤᱥᱚᱢ ᱨᱮᱭᱟᱜ ᱥᱚᱨᱠᱟᱨᱤ ᱧᱩᱛᱩᱢ ᱮᱛᱚᱢ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱱᱟᱜ ᱟᱹᱯᱱᱟᱹᱛ (Republic of South Africa) ᱾ ᱫᱤᱥᱚᱢ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱢ ᱥᱮᱫ ᱵᱷᱟᱨᱚᱛ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ ᱟᱨ ᱮᱛᱚᱢ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ; ᱮᱛᱚᱢ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱭᱟᱜ ᱠᱚᱸᱭᱮ ᱥᱤᱢᱟᱹ ᱨᱮ ᱱᱟᱢᱤᱵᱤᱭᱟ, ᱵᱳᱛᱥᱳᱣᱟᱱᱟ ᱟᱨ ᱡᱤᱢᱵᱟᱵᱩᱭᱮ ᱟᱨ ᱥᱟᱢᱟᱝ ᱟᱨ ᱥᱟᱢᱟᱝᱼᱠᱚᱸᱭᱮ ᱥᱤᱢᱟᱹ ᱨᱮ ᱢᱳᱡᱟᱢᱵᱤᱠ ᱟᱨ ᱮᱥᱣᱟᱛᱤᱱᱤ ᱫᱤᱥᱚᱢ ᱠᱚ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱚᱱᱟ ᱵᱮᱜᱚᱨ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱫᱚ ᱞᱮᱥᱳᱛᱷᱳ ᱫᱤᱥᱚᱢ ᱨᱮᱭᱟᱜ ᱵᱮᱨᱦᱟᱭ ᱛᱮ ᱵᱮᱨᱦᱟᱭ ᱟᱹᱪᱩᱨ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱑,᱒᱒᱑,᱐᱓᱗ ᱪᱟᱹᱣᱠᱟᱹ‌ ᱠᱤᱞᱳᱢᱤᱴᱟᱨ (᱔᱗᱑,᱔᱔᱕ ᱫᱟᱹᱭᱠᱟᱹ ᱢᱟᱭᱤᱞ) ᱛᱮ ᱯᱟᱥᱱᱟᱣ ᱢᱮᱱᱟᱜ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱨᱮ ᱕.᱙ ᱠᱳᱴᱤ ᱠᱷᱚᱱ ᱦᱚᱸ ᱡᱟᱹᱥᱛᱤ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱮᱛᱚᱢ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱭᱟᱜ ᱯᱮᱭᱟ ᱨᱟᱡᱽᱜᱟᱲ ᱢᱮᱱᱟᱜᱼᱟ, ᱯᱨᱤᱴᱳᱨᱤᱭᱟ ᱥᱚᱨᱠᱟᱨᱤ ᱠᱟᱹᱢᱤᱦᱚᱨᱟ ᱨᱟᱡᱽᱜᱟᱲ, ᱠᱮᱯ ᱴᱟᱣᱩᱱ ᱥᱚᱝᱥᱚᱫᱽ ᱨᱟᱡᱽᱜᱟᱲ ᱟᱨ ᱵᱞᱩᱢᱯᱷᱚᱱᱴᱮᱱ ᱟᱹᱱᱟᱹᱨᱤ ᱨᱟᱡᱽᱜᱟᱲ ᱠᱟᱱᱟ ᱾ ᱫᱤᱥᱚᱢ ᱨᱮᱭᱟᱜ ᱥᱟᱱᱟᱢ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱥᱚᱦᱚᱨ ᱫᱚ ᱡᱚᱦᱟᱱᱥᱵᱟᱨᱜᱽ ᱟᱨ ᱮᱴᱟᱜ ᱢᱟᱨᱟᱝ ᱥᱚᱦᱚᱨ ᱠᱚᱫᱚ ᱰᱟᱨᱵᱟᱱ ᱟᱨ ᱯᱳᱨᱴ ᱮᱞᱤᱡᱟᱵᱮᱛᱷ ᱠᱟᱱᱟ ᱾" },
        { "cell": "zero-width", "text": "ᱱᱮᱛᱟᱨ ᱨᱮᱭᱟᱜ ᱰᱤᱡᱤᱴᱟᱞ ᱡᱩᱜᱽ ᱨᱮ ᱤᱢᱚᱡᱤ ᱨᱮᱭᱟᱜ ᱟᱹᱰᱤ ᱢᱚᱦᱚᱛ ᱢᱮᱱᱟᱜᱼᱟ ᱾ 🙏 ᱤᱢᱚᱡᱤ, ᱡᱟᱦᱟᱸᱭ ᱨᱮ ᱵᱟᱨᱭᱟ ᱛᱤ ᱵᱷᱤᱲᱟᱹᱣ ᱠᱟᱛᱮ ᱜᱚᱲ ᱠᱚᱣᱟ ᱠᱚ ᱾ ᱚᱱᱟ ᱤᱢᱚᱡᱤ ᱫᱚ ᱥᱟᱱᱛᱟᱲᱤ ᱛᱮ ᱡᱚᱦᱟᱨ ‌ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾" },
        { "cell": "zero-width", "text": "​ᱭᱩᱠᱨᱮᱱ ᱫᱚ ᱥᱟᱢᱟᱝ ᱭᱩᱨᱳᱯ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱨᱟᱥᱤᱭᱟ ᱛᱟᱭᱚᱢ ᱭᱩᱨᱳᱯ ᱨᱮᱱᱟᱜ ᱫᱚᱥᱟᱨ ᱢᱟᱨᱟᱝ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱥᱟᱢᱟᱝ ᱟᱨ ᱠᱚᱭᱮ-ᱥᱟᱢᱟᱝ ᱨᱮ ᱡᱟᱯᱟᱜ ᱟᱠᱟᱱᱟ᱾ ᱭᱩᱠᱨᱮᱱ ᱨᱮᱱᱟᱜ ᱠᱚᱭᱮ ᱨᱮ ᱵᱮᱞᱟᱨᱩᱥ; ᱯᱟᱪᱮ ᱨᱮ ᱯᱳᱞᱮᱱᱰ ᱟᱨ ᱥᱞᱳᱵᱷᱟᱠᱤᱭᱟ; ᱮᱛᱚᱢ-ᱯᱟᱪᱮ ᱨᱮ ᱦᱟᱝᱜᱮᱨᱤ, ᱨᱳᱢᱟᱱᱤᱭᱟ ᱟᱨ ᱢᱳᱞᱫᱳᱵᱷᱟ ᱟᱨ ᱮᱛᱚᱢ ᱟᱨ ᱮᱛᱚᱢ-ᱥᱟᱢᱟᱝ ᱨᱮ ᱦᱮᱸᱫᱮ ᱫᱚᱨᱭᱟ ᱟᱨ ᱟᱡᱳᱵᱷ ᱫᱚᱨᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱠᱤᱭᱮᱵᱷ ᱫᱚ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱟᱨ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱱᱟᱜᱟᱨ ᱠᱟᱱᱟ, ᱱᱚᱣᱟ ᱛᱟᱭᱚᱢ ᱠᱷᱟᱨᱠᱤᱵᱷ, ᱳᱰᱮᱥᱟ, ᱟᱨ ᱫᱤᱱᱤᱯᱨᱳ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱭᱩᱠᱨᱮᱱ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱭᱩᱠᱨᱮᱱᱤᱭᱟᱱ ᱠᱟᱱᱟ᱾ ᱭᱩᱠᱨᱮᱱ ᱛᱮ ᱯᱟᱥᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱟᱨ ᱒᱐᱒᱖ ᱨᱮᱱᱟᱜ ᱟᱱᱫᱟᱡᱽ ᱞᱮᱠᱟᱛᱮ ᱱᱚᱸᱰᱮ ᱓᱒.᱓ ᱢᱤᱞᱤᱭᱚᱱ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ᱾" },
        { "cell": "roman", "text": "fertilization ᱚᱠᱛᱚ ᱨᱮ sperm cell X ᱠᱨᱚᱢᱚᱡᱚᱢ ᱤᱫᱤ ᱠᱟᱛᱮ ᱵᱤᱞᱤ ᱥᱟᱶᱮ ᱢᱮᱥᱟᱜ ᱠᱷᱟᱱ ᱠᱩᱲᱤ ᱜᱤᱫᱽᱨᱟᱹ (XX) ᱠᱚ ᱦᱩᱭᱩᱜ-ᱟ ᱾ ᱡᱩᱫᱤ sperm cell Y ᱠᱨᱚᱢᱚᱡᱚᱢ ᱤᱫᱤ ᱠᱟᱛᱮ ᱵᱤᱞᱤ ᱥᱟᱶᱮ ᱢᱮᱥᱟᱜ-ᱟ ᱮᱱᱠᱷᱟᱱ ᱠᱚᱲᱟ ᱜᱤᱫᱽᱨᱟᱹ (XY) ᱠᱚ ᱦᱩᱭᱩᱜ-ᱟ ᱾" },
        { "cell": "roman", "text": "ᱢᱟᱣᱩᱱᱴ ᱮᱵᱷᱟᱨᱮᱥᱴ ᱫᱚ ᱥᱚᱨᱵᱷᱮ ᱚᱯᱷ ᱤᱱᱰᱤᱭᱟ ᱨᱤᱱᱤᱡ ᱢᱟᱨᱮ ᱡᱮᱱᱮᱨᱟᱞ ᱡᱚᱨᱨᱡᱽ ᱮᱵᱷᱚᱨᱮᱥᱴ ᱟᱜ ᱧᱩᱛᱩᱢ ᱞᱮᱠᱟᱛᱮ ᱦᱮᱢᱟᱞᱵᱩᱨᱩ ᱢᱮᱱᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱩᱥᱩᱞ ᱩᱪᱩᱫ ᱫᱚ ᱧᱩᱛᱩᱢ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱧᱩᱢ ᱢᱟᱬᱟᱝ ᱛᱮ ᱛᱮ ᱱᱚᱶᱟ ᱫᱚ ᱑᱕ ᱩᱪᱩᱫ (Peak XV) ᱞᱮᱠᱟᱛᱮ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱴᱚᱴᱡᱷᱟ ᱨᱤᱱ ᱱᱮᱯᱟᱲᱤ ᱠᱚᱫᱚ ᱥᱟᱜᱚᱨᱢᱚᱛᱷᱟ ᱟᱨ ᱛᱤᱵᱽᱵᱚᱛᱤᱭᱚ ᱠᱚᱫᱚ ᱱᱚᱶᱟ ᱪᱚᱢᱩᱞᱟᱝᱢᱮ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾" },
        { "cell": "roman", "text": "ᱨᱩᱵᱮᱱᱥ ᱵᱟᱲᱛᱤᱠᱟᱭ ᱛᱮ ᱨᱟᱡᱟᱱ ᱜᱚᱨᱟᱠᱷ ᱞᱟᱜᱤᱫ ᱪᱤᱛᱟᱹᱨ ᱵᱮᱱᱟᱣ ᱠᱷᱟᱹᱛᱤᱨ ᱟᱡ \"the prince of painters and the painter of princes\" ᱧᱩᱛᱩᱢ ᱮ ᱧᱟᱢ ᱞᱮᱫᱼᱟ ᱾ ᱟᱡ ᱯᱷᱨᱟᱱᱥ ᱨᱤᱱᱤᱡ ᱞᱩᱭᱤᱥ XIII (᱑᱖᱒᱒-᱒᱕) ᱞᱟᱹᱜᱤᱫ ᱒᱑ ᱜᱚᱴᱟᱝ ᱥᱮᱬᱟ ᱠᱟᱱᱵᱷᱟᱥ ᱮ ᱡᱩᱛ ᱞᱮᱫᱼᱟ ᱡᱟᱦᱟᱸᱨᱮ ᱯᱷᱨᱟᱱᱥ ᱨᱤᱱᱤᱡ ᱢᱟᱨᱤ ᱫᱤ ᱢᱮᱫᱤᱥᱤ ᱦᱟᱜ ᱡᱮᱡᱮᱸᱜᱮᱫ ᱥᱟᱥᱚᱱ ᱟᱨ ᱡᱤᱭᱚᱱ ᱨᱮᱱᱟᱜ ᱠᱟᱹᱦᱱᱤ ᱯᱷᱚᱴᱮᱞ ᱞᱮᱱᱟ ᱾ ᱤᱝᱞᱚᱸᱰ ᱨᱤᱱᱤᱡᱱ ᱪᱟᱨᱞᱥ I (1᱖᱒᱙-᱓᱐) ᱞᱟᱹᱜᱤᱫ ᱦᱚᱸ \"Peace and War\" ᱧᱩᱛᱩᱢ ᱛᱮ ᱢᱤᱫ ᱡᱤᱭᱚᱱ ᱪᱤᱛᱟᱹᱨ ᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "roman", "text": "ᱨᱩᱸᱰᱟᱹ ᱫᱚ CITES Appendix II ᱨᱮᱠᱚ ᱞᱮᱠᱷᱟᱣ ᱠᱟᱱᱟ ᱾ ᱵᱟᱝᱞᱟᱫᱮᱥ, ᱪᱤᱱ, ᱵᱷᱟᱨᱚᱛ, ᱤᱥᱨᱟᱭᱮᱞ, ᱢᱟᱭᱟᱱᱢᱟᱨ, ᱯᱟᱠᱤᱥᱛᱟᱱ, ᱛᱟᱡᱤᱠᱤᱥᱛᱟᱱ, ᱛᱷᱟᱭᱞᱮᱱᱰ ᱟᱨ ᱛᱩᱨᱳᱥᱠᱳ ᱨᱮ ᱨᱩᱸᱰᱟᱹ ᱜᱚᱡ ᱫᱚ ᱢᱟᱱᱟ ᱜᱮᱭᱟ ᱾ ᱟᱨ ᱵᱷᱩᱴᱟᱱ, ᱡᱚᱨᱡᱤᱭᱟ, ᱞᱟᱭᱳᱥ, ᱞᱮᱵᱟᱱᱚᱱ, ᱱᱮᱯᱟᱞ, ᱥᱨᱤᱞᱚᱝᱠᱟ ᱨᱮ ᱫᱚ ᱠᱤᱪᱷᱩ ᱡᱟᱭᱜᱟ ᱨᱮ ᱨᱩᱸᱰᱟᱹ ᱜᱚᱡ ᱢᱟᱱᱟ ᱨᱮᱦᱚᱸ ᱜᱚᱴᱟ ᱴᱟᱺᱰᱤ ᱫᱚ ᱵᱟᱝ ᱢᱟᱱᱟᱣ ᱜᱮᱭᱟ ᱾" },
        { "cell": "roman", "text": "ᱱᱚᱣᱟ ᱵᱟᱰᱟᱭ ᱟᱱ ᱠᱟᱛᱷᱟ ᱠᱟᱱ ᱜᱮᱭᱟ ᱡᱮᱢᱚᱱ ᱟᱡ ᱴᱩᱥᱠᱟᱱ ᱚᱱᱦᱚᱬᱮ ᱟᱹᱰᱤ ᱜᱮ ᱠᱩᱥᱤ ᱦᱟᱠᱟᱫ ᱟᱭ ᱾ ᱟᱡ ᱵᱳᱞᱳᱜᱱᱮᱡ ᱚᱱᱦᱚᱬᱤᱭᱟᱹ ᱦᱩᱭᱤᱰᱳ ᱜᱩᱭᱤᱱᱤᱡᱮᱞᱤ ᱦᱟᱜ ᱚᱱᱦᱚᱬᱮ ᱟᱹᱰᱤ ᱜᱮ ᱠᱩᱥᱤ ᱦᱟᱫ ᱛᱟᱦᱮᱸᱫ ᱾ᱡᱟᱦᱟᱸᱛᱤᱨᱮ ᱥᱤᱠᱞᱤ ᱨᱮᱱᱟᱜ ᱥᱤᱞᱤᱠᱟᱱ ᱥᱠᱩᱞ ᱧᱩᱛᱩᱢ ᱢᱤᱫ ᱞᱟᱠᱪᱟᱨ ᱜᱟᱫᱮᱞ ᱴᱩᱥᱠᱟᱱᱤ ᱨᱮ ᱧᱩᱛᱩᱢ ᱯᱟᱥᱱᱟᱣ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱩᱱᱡᱚᱦᱚᱜ ᱰᱟᱱᱴᱮ ᱯᱩᱨᱜᱟᱴᱳᱨᱤᱭᱳ XXVI ᱨᱮ ᱜᱩᱭᱤᱰᱳ ᱫᱚ ᱟᱯᱟᱛ ᱢᱮᱱᱛᱮᱫ ᱮ ᱵᱟᱠᱷᱮᱬ ᱞᱮᱫᱮᱭᱟ ᱾ ᱟᱡᱟᱜ ᱨᱟᱹᱥᱠᱟᱹ ᱵᱷᱮᱜᱟᱨ ᱵᱷᱮᱜᱟᱨ ᱴᱚᱴᱷᱟ ᱨᱮᱱᱟᱜ ᱚᱱᱦᱚᱬᱮ ᱨᱮ ᱟᱡᱟᱜ ᱜᱚᱨᱚᱡ ᱛᱟᱦᱮᱸᱞᱮᱱ ᱠᱷᱟᱛᱤᱨ ᱟᱡ ᱴᱚᱴᱷᱟᱡᱟᱹᱱᱤᱡ ᱚᱱᱦᱚᱬᱮ ᱯᱟᱱᱛᱮ ᱨᱮ ᱛᱟᱦᱮᱸᱮᱱᱟᱭ ᱡᱮᱢᱚᱱ ᱴᱨᱳᱵᱟᱰᱳᱨᱥ ᱨᱮᱱᱟᱜ ᱚᱱᱦᱚᱬᱮ, ᱟᱨᱱᱚᱴ ᱰᱟᱱᱤᱭᱮᱞ , ᱞᱟᱴᱤᱱ ᱚᱱᱚᱞᱤᱭᱟ ᱥᱤᱥᱤᱨᱳ, ᱳᱵᱷᱤᱰ, ᱟᱥᱚᱠᱟᱭ ᱛᱮ ᱵᱷᱤᱨᱜᱤᱞ ᱮᱢᱟᱱ ᱠᱚᱣᱟ ᱚᱱᱦᱚᱬᱮ ᱯᱟᱸᱡᱟ ᱞᱮᱫᱼᱟᱭ ᱿" },
        { "cell": "roman", "text": "ᱚᱥᱟᱨᱵᱤᱥᱟᱹᱨ ᱔᱒.᱗ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ² ᱢᱮᱥᱟᱠᱟᱛᱮ ᱱᱟᱶᱟ ᱫᱤᱞᱞᱤ ᱫᱚ ᱫᱤᱞᱞᱤ ᱢᱟᱦᱟᱸ ᱱᱟᱜᱟᱨ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱠᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱱᱟᱜᱟᱨ ᱫᱚ ᱤᱱᱰᱚ-ᱜᱟᱝ ᱚᱛ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ, ᱜᱚᱴᱟ ᱵᱟᱡᱟᱨ ᱨᱮᱱᱟᱜ ᱚᱛ ᱫᱚ ᱩᱥᱩᱞ ᱨᱮ ᱵᱷᱮᱯᱮᱜᱮᱜ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱱᱟᱶᱟ ᱜᱤᱞᱞᱤ ᱟᱨ ᱚᱱᱟ ᱥᱩᱯᱩᱨ ᱴᱷᱟᱶ ᱠᱚ ᱫᱚ ᱟᱨᱟᱵᱚᱲᱤ ᱨᱮᱱᱟᱜ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱱᱟ ᱥᱩᱯᱩᱨ ᱵᱩᱨᱩ ᱠᱚ ᱫᱚ ᱫᱤᱞᱞᱤ ᱨᱤᱡᱽ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ , ᱡᱟᱦᱟᱸ ᱫᱚ ᱫᱤᱞᱞᱤ ᱨᱮᱱᱟᱜ Lungs ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱢᱤᱫ ᱫᱷᱟᱣ ᱡᱚᱢᱩᱱᱟ ᱜᱟᱰᱟ ᱨᱮᱱᱟᱜ ᱵᱟᱱ ᱞᱮᱱ ᱠᱷᱚᱱ ᱱᱚᱶᱟ ᱱᱟᱜᱟᱨ ᱫᱚ ᱜᱚᱴᱟ ᱯᱟᱲᱟ ᱜᱷᱮᱨᱟᱣ ᱮᱥᱮᱫ ᱩᱛᱟᱹᱨ ᱞᱮᱱᱟ ᱾ ᱜᱟᱰᱟ ᱨᱮᱱᱟᱜ ᱥᱟᱢᱟᱝ ᱥᱮᱦᱮᱫ ᱫᱚ ᱥᱚᱦᱚᱫᱚᱨᱟ ᱨᱮᱱᱟᱜ ᱱᱟᱜᱟᱨ ᱠᱟᱱᱟ ᱾ ᱱᱟᱶᱟ ᱫᱤᱞᱞᱤ ᱫᱚ ᱥᱮᱥᱢᱤᱠ ᱡᱚᱱ-IV ᱠᱟᱱᱟ, ᱢᱤᱢᱤᱫ ᱫᱷᱟᱣ ᱚᱛ ᱞᱟᱲᱟᱣ ᱦᱚᱸ ᱦᱩᱭ ᱵᱟᱲᱟᱜ ᱜᱮᱭᱟ ᱾" },
        { "cell": "roman", "text": "᱑᱘᱘᱒ ᱥᱟᱞᱮ ᱨᱮ ᱠᱚᱱᱴᱤᱱᱮᱱᱴᱟᱞ ᱮᱰᱤᱥᱚᱱ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ ᱠᱟᱹᱢᱤ ᱮᱦᱚᱵ ᱠᱮᱜᱼᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱑᱘᱘᱔ ᱨᱮ ᱛᱷᱚᱢᱟᱥ ᱮᱰᱤᱥᱚᱱᱟᱜ ᱮᱰᱤᱥᱚᱱ ᱢᱮᱥᱤᱱ ᱣᱟᱨᱠᱥ ᱨᱮ ᱥᱮᱞᱮᱫᱚᱜ ᱞᱟᱹᱜᱤᱫ ᱱᱤᱣ ᱭᱚᱨᱠ ᱛᱮ ᱥᱮᱱᱮᱱᱟᱭ ᱾ ᱮᱛᱚᱦᱚᱵ ᱫᱚ ᱦᱩᱰᱤᱧ ᱤᱧᱡᱤᱱᱤᱭᱟᱹᱨ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱢᱤ ᱮᱦᱚᱵ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱟᱨᱦᱚᱸ ᱥᱮᱬᱟ ᱠᱟᱹᱢᱤ ᱨᱮᱱᱟᱜ ᱟᱥᱟᱭ ᱫᱚᱦᱚ ᱠᱮᱜᱼᱟ ᱾ ᱮᱰᱤᱥᱚᱱ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ DC generator ᱱᱟᱶᱟ ᱛᱮ ᱛᱮᱭᱟᱨ ᱨᱮᱱᱟᱜ ᱵᱷᱟᱨᱟ ᱠᱚ ᱮᱢᱟᱫ ᱫᱮ ᱛᱟᱦᱮᱸᱫ ᱾ ᱱᱚᱶᱟ ᱠᱚ ᱠᱟᱹᱢᱤ ᱢᱚᱡᱽᱛᱮ ᱠᱚᱨᱟᱣ ᱞᱮᱠᱷᱟᱱ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱦᱚᱸ ᱞᱟᱦᱟᱜᱼᱟ ᱟᱨ ᱑᱐,᱐᱐᱐ ᱰᱚᱞᱟᱨ ᱥᱤᱥᱯᱷᱟᱹᱭ ᱮᱢᱟᱭᱟ ᱢᱮᱱᱛᱮᱭ ᱢᱮᱛᱟᱫ ᱫᱮ ᱛᱟᱦᱮᱸᱫ ᱾ ᱢᱮᱱᱠᱷᱟᱱ ᱮᱰᱤᱥᱚᱱ ᱫᱚ ᱠᱩᱲᱟᱹᱭ ᱮᱢᱚᱜ ᱨᱮ ᱫᱚ ᱠᱩᱧᱡᱩᱥ, ᱜᱮ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ ᱩᱱᱟᱹᱜ ᱴᱟᱠᱟ ᱜᱮ ᱵᱟᱭ ᱛᱟᱦᱸ ᱠᱟᱱᱟ ᱾ ᱛᱚᱵᱮ ᱛᱤᱢᱤᱱ ᱫᱤᱱ ᱨᱮᱱᱟᱜ ᱠᱮᱴᱮᱡ ᱠᱩᱨᱩᱢᱩ ᱛᱮ ᱡᱚᱛᱚ ᱢᱤᱥᱤᱱ ᱠᱚ ᱵᱩᱜᱤ ᱨᱩᱣᱟᱹᱲ ᱠᱮᱜᱼᱟ ᱟᱨ ᱚᱱᱟ ᱥᱤᱨᱯᱷᱟᱹ ᱵᱟᱵᱚᱫ ᱛᱮᱭ ᱢᱮᱛᱟᱫ ᱫᱮᱭᱟ ᱾ ᱟᱫᱚ ᱮᱰᱤᱥᱚᱱ ᱢᱮᱛᱟᱫ ᱫᱮᱭᱟᱭ ᱱᱚᱶᱟ ᱫᱚ ᱢᱤᱫ ᱛᱷᱩᱛᱤ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱥᱤᱨᱯᱷᱟᱹ ᱵᱟᱝ ᱮᱢ ᱠᱟᱛᱮ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱮᱰᱤᱥᱚᱱ ᱦᱟᱯᱛᱟ ᱨᱮᱱᱟᱜ ᱠᱩᱲᱟᱹᱭ ᱑᱘ ᱰᱚᱞᱟᱨ ᱠᱷᱚᱱ ᱑᱘ ᱰᱚᱞᱟᱨᱮ ᱨᱟᱠᱟᱵ ᱟᱭᱟ ᱢᱮᱱᱛᱮ ᱢᱮᱛᱟᱫ ᱫᱮᱭᱟ᱾ ᱛᱚᱵᱮ ᱴᱮᱥᱞᱟ ᱫᱚ ᱮᱫᱽᱨᱮ ᱛᱮ ᱚᱱᱟ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱠᱷᱚᱱᱮ ᱵᱷᱟᱜᱟᱣ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱿" },
        { "cell": "roman", "text": "ᱤᱧ ᱢᱟ ᱟᱴᱟᱵ ᱡᱟᱲᱟᱵ II (1) \" ᱵ \" ᱫᱚ ᱛᱟ.ᱯᱩᱜᱚᱜ ᱟ I ᱩᱱ ᱫᱚ ᱚᱱᱟ ᱛᱟᱞᱟ ᱟᱨ ᱢᱩᱪᱟ.ᱫ ᱨᱮ ᱞᱟᱜᱟᱛᱚᱜ ᱟ I ᱡᱟᱦᱟ ᱨᱮ ᱟᱲᱟᱝ ᱫᱚ ᱢᱚᱪᱟ ᱨᱮ ᱦᱚᱭ ᱠᱚᱯᱮᱫ ᱠᱟᱛᱮ ᱞᱩᱴᱤ ᱠᱤᱱ ᱥᱤᱠᱩᱵ ᱡᱚᱯᱚᱴᱮᱡ ᱠᱟᱛᱮ ᱜᱟᱲᱦᱟᱜ ᱟ I ᱚᱰᱮ ᱜᱮ \" ᱵ \" ᱞᱟᱜᱟᱛᱚᱜ ᱟ I ᱡᱮᱞᱮᱠᱟ - ᱮᱦᱚᱵ ᱟᱨ ᱥᱟᱯᱟᱵ ᱮᱢᱟᱱ ᱠᱚ I" },
        { "cell": "initialism", "text": "᱑᱕ ᱚᱠᱴᱚᱵᱚᱨ ᱑᱙᱓᱑ ᱥᱟᱞᱮᱨᱮ ᱛᱟᱢᱤᱞᱱᱟᱰᱩ ᱨᱮᱱᱟᱜ ᱨᱟᱢᱮᱥᱣᱚᱨᱚᱢ ᱟᱹᱛᱩ ᱨᱮ ᱢᱤᱫ ᱨᱮᱸᱜᱮᱡ ᱢᱩᱥᱞᱟᱹ ᱚᱲᱟᱜ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱜᱤᱫᱽᱨᱟᱹ ᱵᱮᱲᱟ ᱟᱡᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱟᱵᱩᱞ ᱯᱚᱠᱤᱨ ᱡᱮᱣᱱᱩᱞᱚᱵᱫᱤᱱ ᱚᱵᱽᱫᱩᱞ ᱠᱚᱞᱟᱞ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱟᱯᱟᱛ ᱧᱩᱛᱩᱢ ᱫᱚ ᱡᱮᱭᱱᱩᱞᱚᱵᱽᱫᱤᱱ ᱟᱨ ᱮᱸᱜᱟᱛ ᱫᱚ ᱚᱥᱤᱟᱢᱢᱟ ᱧᱩᱛᱩᱢᱟᱭ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱵᱫᱩᱞ ᱟᱡ ᱵᱟᱵᱟ ᱫᱚ ᱞᱟᱹᱣᱲᱤᱭᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱲᱟᱜ ᱨᱮᱱᱟᱜ ᱟᱨᱡᱟᱣ ᱨᱮ ᱥᱚᱯᱚᱦᱚᱫ ᱞᱟᱹᱜᱤᱫ ᱚᱵᱽᱫᱩᱞ ᱫᱚ ᱟᱥᱲᱟ ᱪᱟᱞᱟᱜ ᱵᱚᱭᱚᱥ ᱨᱮ ᱦᱚᱸᱭ ᱠᱟᱹᱢᱤ ᱛᱟᱦᱮᱸᱫ ᱾ ᱩᱱᱤ ᱫᱚ ᱵᱮᱣᱨᱟ ᱥᱟᱠᱟᱢ (newspaper) ᱚᱲᱟᱜ ᱚᱲᱟᱜ ᱪᱟᱞᱟᱣ ᱠᱟᱛᱮ ᱦᱟᱹᱴᱤᱧ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱨᱚᱢᱟᱱᱟᱛᱷᱯᱩᱨ ᱠᱷᱚᱱ ᱢᱮᱴᱨᱤᱠ ᱵᱤᱱᱤᱰ ᱯᱟᱥ ᱛᱟᱭᱚᱢ ᱛᱤᱨᱩᱪᱤᱨᱟᱯᱚᱞᱞᱤ ᱨᱮᱱᱟᱜ ᱥᱮᱱᱴ ᱡᱚᱥᱮᱯᱷ ᱵᱱᱨᱫᱟᱹᱜᱟᱲ ᱨᱮ ᱧᱩᱛᱩᱢᱮ ᱚᱞ ᱚᱪᱚᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱸᱰᱮ ᱠᱷᱚᱱ ᱯᱷᱤᱡᱤᱠᱟᱞ (physical) ᱥᱟᱬᱮᱥ ᱨᱮ ᱥᱚᱱᱮᱨ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱩᱱᱤ ᱫᱚ ᱑᱙᱕᱕ ᱥᱟᱞᱮᱨᱮ ᱢᱟᱰᱨᱟᱥᱮ ᱥᱮᱱᱮᱱᱟ ᱩᱰᱟᱹᱱ ᱤᱧᱡᱤᱱᱤᱭᱟᱹᱨ ᱯᱟᱲᱦᱟᱣᱜ ᱞᱟᱹᱜᱤᱫ ᱾ ᱢᱟᱰᱨᱟᱥ ᱤᱱᱥᱴᱤᱪᱩᱴ ᱚᱯ ᱴᱮᱨᱱᱚᱞᱚᱡᱤ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱥᱚᱱᱮᱨ ᱟᱢᱮᱴ ᱛᱟᱭᱚᱢ ᱑᱙᱖᱐ ᱥᱟᱞᱮᱨᱮ DRDO ᱨᱮ ᱢᱤᱫ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱞᱮᱠᱟᱛᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "initialism", "text": "ᱛᱷᱟᱭᱞᱮᱱᱰ (/ˈtaɪlænd/ TY-land), officially the Kingdom of Thailand ᱫᱚ ᱫᱟᱹᱠᱷᱤᱱ ᱯᱩᱨᱩᱵᱽ ᱮᱥᱤᱟ ᱨᱮᱱᱟᱜ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ ᱾ ᱛᱷᱟᱭᱞᱮᱱᱰ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱫᱚ ᱵᱮᱝᱠᱚᱠ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱑᱗᱘᱒ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱑᱙᱓᱒ ᱥᱮᱨᱢᱟ ᱫᱷᱟᱹᱵᱤᱡ ᱱᱚᱸᱰᱮ ᱫᱚ ᱨᱟᱡᱽᱛᱚᱱᱛᱨᱚ ᱪᱟᱹᱞᱩ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱑᱙᱓᱒ ᱥᱮᱨᱢᱟ ᱨᱮᱜᱮ ᱥᱟᱝᱵᱤᱫᱷᱟᱱᱤᱠ ᱨᱟᱡᱽᱛᱚᱱᱛᱨᱚ ᱮᱛᱦᱚᱵ ᱮᱱᱟ ᱾" },
        { "cell": "initialism", "text": "ᱜᱟᱞᱮᱱ ᱫᱚ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ AD 129 ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟ ᱢᱮᱱᱛᱮ On the affections of the mind ᱨᱮ ᱩᱪᱷᱟᱹᱱ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱡ ᱟᱯᱟᱛ ᱫᱚ ᱮᱞᱤᱭᱚᱥ ᱱᱩᱠᱚᱱ ᱧᱩᱛᱩᱢᱟᱭ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱯᱟᱛ ᱫᱚ ᱢᱤᱫ ᱠᱤᱥᱟᱹᱬ ᱫᱷᱟᱨᱟ ᱦᱚᱲᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱥᱟᱶ ᱟᱹᱰᱤ ᱫᱷᱤᱜᱮᱭᱟᱱᱟᱱ ᱦᱚᱲᱮ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ ᱮᱞᱠᱷᱟ, ᱥᱟᱱᱟᱥᱤ, ᱞᱚᱡᱤᱠ, ᱟᱥᱴᱨᱚᱱᱚᱢᱤ, ᱪᱟᱥᱵᱟᱥ ᱟᱨ ᱥᱟᱶᱦᱮᱸᱫ ᱨᱮᱦᱚᱸ ᱾ ᱟᱡ ᱟᱯᱟᱛ ᱫᱚ ᱟᱡᱤᱡ ᱜᱤᱫᱽᱨᱟᱹ (ᱜᱟᱞᱮᱱ) ᱫᱚ ᱢᱤᱫ ᱥᱟᱱᱟᱥᱩᱭᱟᱹ ᱵᱟᱝᱠᱷᱟᱱ ᱨᱟᱡᱽᱨᱮᱛᱟ ᱵᱮᱱᱟᱶ ᱚᱪᱚᱭᱮ ᱨᱮᱭᱟᱜ ᱟᱸᱥ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ ᱾ ᱟᱯᱟᱛᱟᱜ ᱚᱨᱥᱚᱝ ᱛᱮ ᱜᱟᱞᱮᱱ ᱦᱚᱸ ᱚᱱᱟ ᱠᱚ ᱦᱚᱨᱮ ᱯᱟᱸᱡᱟ ᱠᱮᱜᱼᱟ ᱟᱨ ᱟᱡ ᱞᱮᱠᱟ ᱜᱮ ᱜᱮᱭᱟᱱ ᱦᱚᱸᱭ ᱥᱮᱬᱟ ᱞᱮᱜᱼᱟ ᱾ AD 145 ᱨᱮ ᱜᱟᱞᱮᱱ ᱫᱚ ᱢᱮᱰᱤ ᱤᱱ ᱯᱟᱲᱦᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱠᱚ ᱠᱩᱞ ᱠᱮᱫᱮᱭᱟ, ᱩᱱ ᱫᱚ ᱟᱡᱟᱜ ᱑᱖ ᱵᱚᱪᱷᱚᱨ ᱵᱚᱭᱚᱥ ᱦᱩᱭ ᱟᱠᱟᱱ ᱛᱦᱮᱸᱫ ᱾ AD 148 ᱥᱟᱞᱮ ᱨᱮ ᱟᱯᱟᱛ ᱫᱚᱭ ᱵᱚᱝᱜᱟ ᱛᱟᱞᱟᱭᱮᱱ ᱛᱟᱭᱚᱱ ᱟᱡ ᱥᱩᱢᱩᱝ ᱟᱡ ᱠᱩᱥᱤ ᱡᱩᱭᱚᱱᱮ ᱠᱷᱟᱸᱰᱟᱣ ᱠᱮᱜᱼᱟ ᱾ AD 157 ᱥᱟᱞᱮ ᱨᱮ ᱯᱚᱨᱜᱟᱢᱚᱱ ᱛᱮ ᱦᱮᱡ ᱨᱩᱣᱟᱹᱲᱮᱱᱟ, ᱩᱱ ᱫᱚ ᱟᱡᱟᱜ ᱒᱘ ᱵᱚᱪᱷᱚᱨ ᱵᱚᱭᱚᱥ ᱦᱩᱭ ᱟᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "initialism", "text": "ᱢᱩᱨᱢᱩ ᱜᱚᱢᱠᱮ ᱮᱛᱚᱦᱚᱵ ᱥᱮᱪᱮᱫ ᱫᱚ ᱟᱹᱛᱩ ᱥᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜ ᱵᱷᱩᱨᱩᱰᱩᱵᱚᱬᱤ ᱮᱛᱚᱦᱚᱵ ᱟᱥᱲᱟ ᱠᱷᱚᱱ ᱮ ᱮᱦᱚᱵ ᱞᱮᱜ-ᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱵᱮᱛᱱᱚᱴᱤ ᱥᱚᱨᱚᱛ ᱪᱚᱱᱫᱽᱨᱚ ᱵᱤᱫᱽᱭᱟᱯᱤᱴᱷᱚ ᱟᱨ ᱵᱟᱨᱤᱯᱚᱫᱟ ᱨᱮ ᱢᱮᱱᱟᱜ ᱟᱨ ᱮᱢ ᱯᱤ ᱥᱤ ᱩᱥᱩᱞ ᱟᱥᱲᱟ ᱨᱮ ᱯᱟᱲᱦᱟᱣ ᱥᱟᱹᱛ ᱠᱟᱛᱮ ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱵᱷᱩᱵᱽᱱᱮᱥᱚᱨ ᱨᱮ ᱢᱮᱱᱟᱜ ᱩᱛᱠᱚᱲ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ (Utkal University) ᱠᱷᱚᱱ ᱨᱟᱡᱽᱟᱹᱨᱤ ᱥᱟᱬᱮᱥ (Political Science) ᱨᱮ ᱮᱢᱹᱮ (MA) ᱥᱟᱹᱛ ᱠᱮᱜᱼᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱡᱚᱵᱟᱦᱚᱨᱞᱟᱞ ᱱᱮᱦᱨᱩ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮ ᱚᱞᱚᱜ ᱥᱟᱶᱛᱮ ᱡᱩᱢᱤᱫᱽ ᱯᱚᱱᱚᱛ (United Kingdom) ᱨᱮᱱᱟᱜ ᱵᱚᱨᱢᱤᱝᱦᱟᱢ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ (University of Birmingham) ᱠᱷᱚᱱ ᱫᱤᱥᱩᱣᱟᱹ ᱥᱮᱵᱟ (Public Services) ᱥᱟᱛᱟᱢ ᱨᱮ ᱮᱢᱹᱵᱤᱹᱮ (MBA) ᱯᱟᱲᱦᱟᱣ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "initialism", "text": "ᱜᱩᱜᱚᱞ ᱨᱮᱱᱟᱜ ᱚᱞᱪᱤᱠᱤ ᱚᱲᱟᱜ ᱥᱟᱦᱴᱟ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱜᱮᱭᱟᱱ ᱰᱤᱡᱟᱭᱤᱱ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱪᱮᱫᱟᱜ ᱥᱮ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱤᱱᱤᱡ ᱢᱩᱥᱞᱟᱹ ᱠᱚᱣᱟᱜ ᱫᱚ HTML ᱨᱮ ᱟᱹᱰᱤ ᱠᱚᱢ ᱜᱮ ᱵᱟᱰᱟᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱣᱮᱵ ᱥᱟᱦᱴᱟ ᱠᱚ ᱰᱤᱡᱟᱭᱤᱱ ᱞᱟᱹᱜᱤᱫ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱ ᱢᱟᱨᱠᱮᱯ ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱᱟ ᱾[ 38]" },
        { "cell": "initialism", "text": "ᱞᱚᱥ ᱮᱧᱡᱮᱞᱥ (/lɒs ˈændʒələs/) ᱫᱚ ᱠᱚᱧᱮ ᱠᱟᱞᱤᱯᱷᱚᱨᱱᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱱᱟᱜᱟᱨ ᱠᱟᱱᱟ ᱾ ᱱᱚᱸᱰᱮ ᱓,᱘᱔᱗,᱔᱐᱐ ᱜᱟᱱ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱱᱟᱜᱟᱨ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱑᱘ ᱢᱤᱞᱤᱭᱚᱱ ᱜᱟᱱ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱾ ᱱᱟᱜᱟᱨ ᱫᱚ ᱑᱒᱐᱐᱒ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱜᱟᱱ ᱚᱥᱟᱨᱼᱵᱤᱥᱟᱹᱨ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱞᱚᱥ ᱮᱧᱡᱮᱞᱥ ᱫᱚ ᱡᱩᱢᱤᱫᱽ ᱯᱚᱱᱚᱛ (USA) ᱨᱮᱱᱟᱜ ᱫᱚᱥᱟᱨ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟᱜ ᱱᱟᱜᱟᱨ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱱᱤᱶ ᱭᱚᱨᱠ ᱠᱷᱚᱱ ᱯᱟᱹᱪᱷᱞᱟᱹ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱠᱟᱞᱤᱯᱷᱚᱨᱱᱤᱟ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱱᱟᱜᱟᱨ ᱦᱚᱸ ᱠᱟᱱᱟ ᱾" },
        { "cell": "initialism", "text": "ᱞᱚᱥ ᱮᱧᱡᱮᱞᱥ ᱧᱩᱛᱩᱢ ᱫᱚ ᱥᱯᱮᱱᱤᱥ ᱯᱟᱹᱨᱥᱤ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱚ \"ᱵᱳᱝᱜᱟ ᱠᱩᱲᱤ\" (The Angels) ᱾ ᱱᱚᱶᱟ ᱧᱩᱛᱩᱢ ᱫᱚ ᱚᱥᱚᱞ ᱴᱷᱟᱶ ᱧᱩᱛᱩᱢ ᱠᱷᱚᱱ ᱥᱤᱠᱩᱵ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱚᱥᱚᱞ ᱧᱩᱛᱩᱢ ᱫᱚ \"El Pueblo de Nuestra Señora la Reina de los Ángeles del Río Porciúncula\" ᱡᱟᱦᱟᱸ ᱨᱮᱱᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ \"ᱯᱚᱨᱥᱤᱭᱩᱠᱩᱞᱟ ᱜᱟᱰᱟ ᱨᱤᱱᱤᱡ ᱵᱚᱝᱜᱟ ᱠᱩᱲᱤ ᱠᱚᱭᱤᱡ ᱨᱟᱹᱱᱤ ᱟᱜ ᱱᱟᱜᱟᱨ\" ᱾ ᱞᱚᱥ ᱮᱧᱡᱮᱞᱥ ᱫᱚ ᱑᱗᱘᱑ ᱥᱟᱞᱮ ᱨᱮ ᱛᱷᱟᱯᱚᱱ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱹᱰᱤ ᱥᱮᱫᱟᱭ ᱨᱮᱱᱟᱜ ᱠᱟᱛᱷᱟ ᱪᱤ ᱱᱚᱶᱟ ᱮᱞᱚᱠᱟ ᱫᱚ ᱯᱷᱨᱟᱱᱥᱤᱥᱠᱟᱱ ᱨᱤᱱ ᱵᱟᱨᱭᱟ ᱱᱟᱭᱠᱮ ᱡᱩᱱᱤᱯᱮᱨᱚ ᱥᱮᱨᱟ ᱟᱨ ᱡᱩᱟᱱ ᱠᱨᱮᱥᱯᱤ ᱛᱤᱠᱤᱱ ᱠᱤᱱ ᱧᱟᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱩᱱ ᱚᱠᱛᱚ ᱫᱚ ᱥᱯᱮᱱ ᱥᱟᱶ ᱢᱮᱥᱟ ᱠᱟᱛᱮ ᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱮᱯᱨᱤᱞ ᱔, ᱑᱘᱕᱐ ᱥᱟᱞᱮᱨᱮ ᱠᱟᱞᱤᱯᱷᱚᱨᱱᱤᱭᱟ ᱫᱚ ᱡᱩᱢᱤᱫᱽ ᱯᱚᱱᱚᱛ ᱟᱢᱮᱨᱤᱠᱟ (USA) ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱯᱚᱱᱚᱛ ᱞᱮᱠᱟᱛᱮ ᱵᱮᱱᱟᱶ ᱮᱱᱟ ᱾ ᱞᱚᱥ ᱮᱧᱡᱮᱞᱥ ᱫᱚ ᱚᱞᱤᱢᱯᱤᱠ ᱨᱮᱱᱟᱜ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱞᱮᱠᱟᱛᱮ ᱑᱙᱓᱐ - ᱑᱙᱔᱘ ᱥᱟᱞᱮ ᱦᱟᱹᱵᱤᱡ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱫᱟᱨᱟᱭ ᱠᱟᱱᱟ ᱒᱐᱒᱘ ᱥᱟᱞᱮ ᱨᱮ ᱱᱚᱸᱰᱮ ᱜᱮ ᱚᱞᱤᱢᱯᱤᱠ ᱮᱱᱮᱡᱻᱮ ᱥᱟᱯᱲᱟᱣᱟ ᱱᱷᱟᱜ ᱾ ᱱᱚᱶᱟ ᱱᱟᱜᱟᱨ ᱫᱚ ᱯᱮ ᱫᱷᱟᱣ ᱨᱟᱹᱯᱩᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱫᱚᱝᱜᱟ ᱠᱷᱟᱹᱛᱤᱨ ᱛᱮ ᱑᱙᱔᱓, ᱑᱙᱖᱕ ᱟᱨ ᱑᱙᱙᱒ ᱥᱟᱞᱮ ᱨᱮ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱚᱸᱰᱮᱱ ᱠᱚ ᱟᱹᱫᱤᱵᱟᱹᱥᱤ ᱫᱟᱨᱟᱭ ᱛᱮ ᱥᱟᱞᱜᱟᱣ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱑᱙᱙᱔ ᱥᱟᱞᱮ ᱨᱮᱱᱟᱜ ᱚᱛ ᱞᱟᱲᱟᱣ ᱛᱮ ᱗᱒ ᱦᱚᱲ ᱠᱚ ᱜᱚᱡ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱟᱭᱢᱟ ᱚᱲᱟᱜ ᱠᱚ ᱨᱟᱹᱯᱩᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "initialism", "text": "ᱞᱚᱱᱰᱚᱱ ᱫᱚ ᱤᱝᱞᱚᱸᱰ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱤᱝᱞᱚᱸᱰ ᱟᱨ ᱥᱮᱞᱮᱫ ᱫᱤᱥᱟᱹᱢ (UK) ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱱᱟᱜᱟᱨ ᱠᱟᱱᱟ ᱾ ᱛᱷᱮᱢᱥ ᱜᱟᱰᱟ ᱫᱚ ᱱᱚᱶᱟ ᱱᱟᱜᱟᱨ ᱥᱮᱫ ᱛᱮ ᱞᱤᱸᱡᱤᱱ ᱠᱟᱱᱟ ᱾" },
        { "cell": "grouped", "text": "᱒᱐᱑᱖ ᱨᱮᱱᱟᱜ ᱞᱮᱠᱷᱟ ᱛᱮ ᱘᱓᱘,᱐᱐᱐ ᱜᱟᱱ ᱦᱚᱲ ᱟᱢᱥᱴᱚᱨᱰᱮᱢ ᱨᱮ ᱫᱚ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱾ ᱱᱚᱸᱰᱮ ᱵᱟᱨᱭᱟ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ ᱢᱤᱫ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱜᱷᱟᱴ (ᱥᱤᱯᱚᱞ ᱩᱰᱟᱹᱱ ᱜᱷᱟᱴ) ᱾ ᱒.᱒ ᱢᱤᱞᱤᱭᱚᱢ ᱜᱟᱢ ᱦᱚᱲ ᱫᱚ ᱢᱮᱴᱨᱚᱯᱚᱞᱤᱴᱤᱭᱟᱱ ᱱᱟᱜᱟᱨ ᱨᱮ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱱᱚᱣᱟ ᱱᱟᱜᱟᱨ ᱫᱚ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱞᱟᱠᱪᱟᱨ ᱛᱮ ᱜᱟᱵᱮ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱸᱰᱮ ᱑᱗᱕ ᱜᱚᱴᱟᱝ ᱫᱤᱥᱚᱢ ᱨᱤᱱ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱾ ᱮᱴᱟᱜ ᱱᱟᱜᱟᱨ ᱠᱚ ᱞᱮᱠᱟ ᱜᱮ ᱱᱚᱸᱰᱮ ᱦᱚᱸ ᱟᱭᱢᱟ ᱵᱟᱹᱲᱤᱡ ᱜᱷᱚᱴᱚᱱ ᱜᱚᱡ ᱜᱚᱯᱚᱡ ᱠᱚ ᱧᱮᱞ ᱵᱟᱲᱟᱜ ᱜᱮᱭᱟ ᱟᱹᱰᱤ ᱩᱥᱛᱟᱹᱭ ᱾" },
        { "cell": "grouped", "text": "ᱱᱚᱶᱟ ᱫᱚ ᱑᱔,᱐᱕᱖,᱐᱐ ᱫᱚᱦᱲᱟ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱡᱟᱜᱟᱭ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱟᱱᱴᱟᱨᱠᱚᱴᱤᱠᱟ ᱢᱟᱦᱟᱫᱮᱥ ᱤᱱᱟᱹᱜ ᱢᱟᱨᱟᱝ ᱜᱟᱱ ᱦᱩᱭᱩᱜᱼᱟ ᱾" },
        { "cell": "grouped", "text": "ᱟᱯᱷᱜᱟᱱᱤᱥᱛᱟᱱ ᱩᱛᱟᱹᱨ ᱥᱤᱢᱟᱹᱱᱟᱨᱮ ᱛᱩᱨᱠᱢᱮᱱᱤᱥᱛᱟᱱ, ᱩᱡᱽᱵᱮᱠᱤᱥᱛᱟᱱ ᱟᱨ ᱛᱟᱡᱤᱠᱤᱥᱛᱟᱱ, ᱥᱟᱢᱟᱝ ᱥᱮᱡ ᱫᱚ ᱪᱤᱱ ᱟᱨ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮᱱᱟᱜ ᱡᱚᱢᱢᱩ ᱟᱨ ᱠᱟᱹᱥᱢᱤᱨ, ᱮᱛᱚᱢ ᱥᱮᱡ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱟᱨ ᱯᱟᱪᱮ ᱥᱮᱡ ᱤᱨᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱟᱯᱷᱜᱟᱱᱤᱥᱛᱟᱱ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱖᱕᱒,᱐᱐᱐ ᱜᱟᱺᱴ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱒᱕᱒,᱐᱐᱐ ᱜᱟᱺᱴ ᱢᱤᱞ) ᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱡᱟᱹᱥᱛᱤ ᱵᱷᱟᱜᱽ ᱜᱮ ᱵᱩᱨᱩ ᱠᱟᱱᱟ ᱾ ᱟᱯᱷᱜᱟᱱᱤᱥᱛᱟᱱ ᱨᱮᱱᱟᱜ ᱟᱨᱫᱷᱮᱠ ᱚᱛ ᱦᱟᱥᱟᱜᱮ ᱫᱚᱨᱮᱭᱟ ᱠᱷᱚᱱ ᱒᱐᱐᱐ ᱢᱤᱴᱟᱨ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "grouped", "text": "ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱭᱟᱜ ᱫᱚᱥᱟᱨ ᱢᱟᱨᱟᱝ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱮᱨᱤᱭᱟ ᱫᱚ ᱑᱐᱖,᱔᱖᱐,᱐᱐᱐ ᱫᱚᱦᱲᱟ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱭᱟᱜ ᱒0% ᱟᱨ ᱫᱟᱜ ᱨᱮᱭᱟᱜ ᱒᱙% ᱡᱟᱜᱟᱭ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ ᱾ ᱵᱤᱥᱩᱵᱽ ᱨᱮᱠᱷᱟ ᱱᱚᱶᱟ ᱫᱚ ᱵᱟᱨ ᱴᱷᱮᱱ ᱮ ᱦᱟᱹᱴᱤᱧ ᱟᱠᱟᱜᱼᱟ ᱾ ᱮᱛᱚᱢ ᱥᱮᱫᱟᱜ ᱫᱚ ᱮᱛᱚᱢ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱟᱦᱟᱫᱤᱨᱭᱟ ᱟᱨ ᱠᱚᱧᱮ ᱥᱮᱫᱟᱜ ᱫᱚ ᱠᱚᱧᱮ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱤᱝᱞᱤᱥ ᱟᱠᱷᱚᱨ S ᱞᱮᱠᱟ ᱛᱮᱭᱟᱨ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱯᱩᱨᱩᱵᱽ ᱨᱮ ᱫᱚ ᱭᱩᱨᱮᱥᱤᱭᱟ ᱟᱨ ᱟᱯᱷᱨᱤᱠᱟ, ᱯᱟᱹᱪᱷᱤᱢ ᱨᱮ ᱫᱚ ᱟᱢᱮᱨᱤᱠᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "grouped", "text": "ᱵᱨᱟᱡᱤᱞ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱭᱟᱜ ᱜᱩᱲ ᱴᱩᱠᱩᱡ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱠᱟᱨᱚᱱ ᱱᱚᱶᱟ ᱒᱐᱑᱐ ᱥᱟᱞ ᱨᱮ ᱗᱑᱙,᱑᱕᱗,᱐᱐᱐ ᱴᱚᱱ ᱟᱸᱠ ᱟᱨᱡᱟᱣ ᱠᱟᱛᱮ ᱡᱮᱜᱮᱛ ᱨᱮ ᱨᱮᱠᱚᱰ ᱞᱮᱜᱼᱟ ᱾ ᱟᱸᱠ ᱟᱨᱡᱟᱣ ᱨᱮ ᱫᱚ ᱥᱤᱧᱚᱛ ᱡᱮᱜᱮᱛ ᱨᱮ ᱫᱚᱥᱟᱨ ᱟᱨ ᱪᱤᱱ ᱫᱚ ᱛᱮᱥᱟᱨ ᱴᱷᱟᱶᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ ᱾ ᱵᱷᱟᱨᱚᱛ ᱨᱮ ᱫᱚ ᱒᱗᱗,᱗᱕᱐,᱐᱐᱐ ᱴᱚᱱ ᱟᱨ ᱪᱤᱱ ᱨᱮ ᱫᱚ ᱑᱑᱑,᱔᱕᱔,᱐᱐᱐ ᱴᱚᱱ ᱟᱨᱡᱟᱣᱜ ᱠᱟᱱᱟ ᱾" },
        { "cell": "grouped", "text": "ᱠᱚᱸᱭᱮ ᱟᱢᱮᱨᱤᱠᱟ ᱫᱚ ᱢᱤᱫᱴᱟᱝ ᱢᱟᱦᱟᱫᱮᱥ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱭᱟᱜ ᱠᱚᱸᱭᱮ ᱱᱟᱠᱷᱟ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱯᱩᱨᱩᱵᱽ ᱨᱮᱫᱚ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ, ᱠᱚᱸᱭᱮ ᱨᱮᱫᱚ ᱟᱨᱠᱴᱤᱠ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ, ᱯᱩᱪᱷᱤᱢ ᱟᱨ ᱮᱛᱚᱢ ᱥᱮᱦᱮᱫ ᱨᱮᱫᱚ ᱯᱨᱚᱥᱟᱱᱛ ᱢᱟᱦᱟᱫᱚᱨᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱟᱭᱛᱟᱱ ᱚᱝᱥᱟᱨ ᱫᱚ ᱱᱚᱶᱟ ᱛᱮᱥᱟᱨ, ᱟᱨ ᱦᱚᱲ ᱮᱞ ᱚᱝᱥᱟᱨ ᱫᱚ ᱯᱩᱱᱟᱹᱜ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱮᱨᱤᱭᱟ ᱫᱚ ᱒᱔,᱗᱐᱙,᱐᱐᱐ ᱪᱟᱹᱣᱠᱟᱹ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱭᱟᱜ ᱔ᱹ᱘% ᱟᱨ ᱚᱛ ᱨᱮᱭᱟᱜ ᱫᱚ ᱑᱖ᱹ᱘% ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ ᱾" },
        { "cell": "grouped", "text": "ᱠᱟᱭᱨᱚ ᱨᱮ ᱫᱚ ᱗,᱙᱔᱗,᱑᱒᱑ ᱜᱟᱱ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱶᱟ ᱟᱨ ᱚᱱ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱟᱹᱛᱩ ᱨᱮᱶ ᱑᱗,᱒᱙᱐,᱐᱐᱐ ᱜᱟᱱ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱶᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱟᱨᱚᱵᱽ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱱᱟᱜᱟᱨᱻᱮ ᱵᱮᱱᱟᱶ ᱟᱠᱟᱫᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱟᱨᱦᱚᱸ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱱᱟᱜ ᱢᱟᱨᱟᱜ ᱟᱹᱛᱩ ᱮᱞᱟᱠᱟ ᱠᱟᱱᱟ ᱾" },
        { "cell": "grouped", "text": "᱑᱙᱙᱒ ᱥᱟᱞᱮ ᱨᱮ ᱚᱛᱼᱞᱟᱲᱟᱶ ᱛᱮ ᱠᱟᱹᱨᱩᱼᱡᱷᱟᱹᱨᱩ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸ ᱫᱤ ᱛᱮ ᱕᱔᱕ ᱦᱚᱲ ᱠᱚ ᱜᱚᱡ ᱞᱮᱱᱟ, ᱖,᱕᱑᱒ ᱦᱚᱲ ᱠᱚ ᱜᱷᱟᱹᱞ ᱞᱮᱱᱟ ᱟᱨ ᱕᱐,᱐᱐᱐ ᱦᱚᱲᱟᱜ ᱚᱲᱟᱜ ᱫᱚ ᱨᱟᱹᱯᱩᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "signed-number", "text": "ᱳᱰᱤᱥᱟ ᱨᱮ ᱫᱚ ᱫᱚᱥᱟᱨ ᱨᱟᱡᱽ ᱯᱟᱹᱨᱥᱤ ᱵᱟᱝ ᱦᱩᱭ ᱟᱠᱟᱱ ᱨᱮᱦᱚᱸ, +3,PG ᱯᱟᱲᱦᱟᱣᱜ ᱞᱟᱹᱜᱤᱫ ᱫᱟᱣᱮ ᱮᱢ ᱟᱠᱟᱫ ᱠᱚᱣᱟ ᱾ ᱟᱨ ᱚᱱᱟ ᱥᱟᱶ ᱛᱮ ᱚᱠᱟ ᱚᱠᱟ ᱴᱚᱴᱷᱟ ᱠᱚ ᱨᱮ ᱫᱚ ᱞᱟᱛᱟᱨ ᱪᱟᱱᱚᱪ ᱜᱤᱫᱽᱨᱟᱹ ᱦᱚᱸ ᱠᱚ ᱯᱟᱲᱦᱟᱣᱜ ᱠᱟᱱᱟ ᱾ ᱚᱱᱠᱟᱛᱮ" },
        { "cell": "signed-number", "text": "᱖᱐%-᱗᱐% ᱜᱟᱱ ᱫᱟᱜ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱫᱟᱜ ᱜᱮ ᱪᱩᱰᱩ ᱫᱟᱜᱼᱮ ᱛᱟᱭᱟᱨᱟ ᱾ ᱪᱩᱰᱩ ᱫᱟᱜ ᱫᱚ ᱦᱚᱧᱢᱚ ᱨᱮᱱᱟᱜ ᱵᱟᱹᱲᱤᱡᱟᱜ ᱠᱚᱜ ᱫᱟᱜ ᱟᱠᱟᱨ ᱛᱮ ᱚᱰᱚᱠ ᱜᱤᱰᱤᱭᱟᱭ ᱾ ᱩᱞᱤᱫᱟᱜ ᱫᱚ ᱡᱚᱢᱟᱜ ᱠᱚᱭ ᱦᱚᱡᱚᱢ ᱚᱪᱚᱭᱟ ᱾ ᱡᱚ ᱮᱢᱟᱱ ᱠᱚ ᱨᱮ ᱦᱚᱸ ᱫᱟᱜ ᱫᱚ ᱛᱟᱦᱮᱸᱱ ᱜᱮᱭᱟ ᱾ ᱫᱚᱨᱭᱟ ᱫᱟᱜ ᱫᱚ ᱠᱷᱟᱨᱟ ᱜᱮ ᱵᱩᱞᱩᱝ ᱜᱮ ᱵᱩᱡᱷᱟᱹᱣᱟ ᱾ ᱡᱷᱟᱨᱱᱟ, ᱢᱩᱰᱩ, ᱠᱩᱧ, ᱯᱩᱠᱷᱨᱤ ᱫᱟᱜ ᱫᱚ ᱥᱤᱵᱤᱞᱟ ᱾ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮ ᱓% ᱜᱮ ᱥᱤᱵᱤᱞ ᱫᱟᱜ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱡ ᱡᱚᱛᱚ ᱵᱩᱞᱩᱝ ᱫᱟᱜ" },
        { "cell": "signed-number", "text": "᱒᱐᱐᱑ ᱥᱟᱞᱮ ᱨᱮ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱞᱮᱨᱟᱛᱮ ᱯᱚᱱᱰᱤᱪᱮᱨᱤ ᱨᱮ ᱙᱔᱑᱒ ᱦᱚᱲ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱩᱱᱠᱩ ᱢᱩᱸᱫᱽ ᱠᱷᱚᱱ ᱕᱐.᱕᱔% ᱦᱚᱲ ᱫᱚ ᱠᱚᱲᱟ ᱠᱟᱱᱟ ᱠᱚ ᱟᱨ ᱔᱙.᱔᱖% ᱦᱚᱲ ᱫᱚ ᱠᱩᱲᱤ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱯᱚᱱᱰᱤᱪᱮᱨᱤ ᱨᱮ ᱥᱮᱪᱮᱫ ᱮᱞ ᱫᱚ ᱗᱑.᱗᱖% ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱡᱟᱦᱟᱸ ᱫᱚ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱛᱚᱲ ᱠᱷᱚᱱ -᱖.᱙᱒% ᱠᱚᱢ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱩᱱᱠᱩ ᱢᱩᱸᱫᱽ ᱠᱷᱚᱱ ᱓᱙.᱙᱑% ᱫᱚ ᱠᱚᱲᱟ ᱠᱟᱱᱟ ᱠᱚ ᱟᱨ ᱓᱑.᱘᱕ % ᱫᱚ ᱠᱩᱲᱤ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱑᱑.᱙᱓% ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱵᱚᱭᱚᱥ ᱫᱚ ᱛᱩᱨᱩᱭ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱠᱚᱢ ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "signed-number", "text": "ᱢᱟᱦᱯᱷᱩᱡᱽ ᱟᱡᱟᱜ ᱗᱐ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱡᱤᱭᱚᱱ ᱨᱮ ᱓᱔ ᱜᱚᱴᱟᱝ ᱱᱳᱵᱮᱞ, ᱓᱕᱐ ᱜᱚᱴᱟᱝ ᱠᱷᱟᱴᱚ ᱠᱟᱹᱦᱱᱤ, ᱰᱚᱡᱚᱱ ᱜᱟᱱ ᱯᱷᱤᱞᱢ ᱨᱚᱲ, ᱢᱚᱬᱮ ᱜᱚᱴᱟᱝ ᱠᱷᱮᱞᱚᱸᱰ ᱮ ᱚᱞ ᱞᱮᱫ-ᱟ᱾ ᱟᱡᱟᱜ ᱡᱷᱚᱛᱚᱠᱷᱳᱱ ᱧᱩᱴᱩᱢᱟᱱ ᱯᱚᱛᱚᱵ ᱫᱚ ᱠᱟᱭᱨᱳ ᱴᱨᱤᱞᱳᱡᱤ, ᱡᱟᱦᱟᱱᱨᱮ ᱯᱮᱭᱟ ᱯᱤᱰᱷᱤ ᱡᱮᱜᱮᱛ -᱑ ᱠᱷᱚᱱ ᱑᱙᱕᱒ ᱨᱮᱱᱟᱜ ᱢᱤᱞᱴᱟᱨᱤ ᱵᱤᱫᱨᱦᱚ ᱡᱟᱦᱟᱸᱨᱮ ᱯᱮ ᱨᱟᱡᱽ ᱯᱷᱟᱨᱩᱠ ᱜᱟᱹᱫᱤ ᱠᱷᱚᱱ ᱠᱚ ᱚᱪᱚᱜ ᱠᱮᱫᱮᱭᱟ ᱨᱮᱱᱟᱜ ᱠᱟᱹᱦᱱᱤ ᱵᱟᱠᱷᱮᱬ ᱞᱮᱱᱟ᱾ ᱟᱡ ᱫᱟᱨ-ᱮᱞ-ᱢᱟᱭᱨᱮᱯᱷ ᱨᱮ ᱯᱟᱨᱥᱟᱞ ᱥᱚᱦᱮᱫᱤᱭᱟᱭ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ, ᱟᱡᱟᱜ ᱱᱳᱵᱮᱞ ᱨᱮᱱᱟᱜ ᱟᱰᱤᱜᱟᱱ ᱠᱟᱹᱦᱱᱤ ᱟᱞ-ᱟᱦᱨᱟᱢ ᱨᱮᱱᱟᱜ ᱥᱮᱨᱤᱭᱮᱞ ᱨᱮ ᱥᱚᱫᱚᱨ ᱚᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ, \"ᱯᱚᱭᱮᱱᱴ ᱚᱯᱷ ᱵᱷᱤᱭᱩ\" ᱦᱥᱯᱛᱟ ᱠᱤᱭᱟᱹ ᱠᱚᱞᱚᱢ ᱨᱮᱦᱚᱸ ᱟᱡᱟᱜ ᱚᱞ ᱦᱟᱹᱡᱩᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ᱾ ᱱᱳᱵᱮᱞ ᱯᱨᱟᱤᱡ ᱧᱟᱢ ᱢᱟᱬᱟᱝ ᱨᱮ ᱯᱟᱪᱮ ᱫᱤᱥᱚᱢ ᱨᱮ ᱟᱹᱰᱤ ᱠᱚᱢ ᱠᱚ ᱵᱟᱰᱟᱭ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ᱾" },
        { "cell": "signed-number", "text": "ᱜᱚᱯᱤᱱᱟᱛᱷ ᱵᱚᱨᱫᱚᱞᱚᱭ (ᱤᱝᱨᱟ.ᱡᱤ: Gopinath Bordoloi, অসমীয়া : গোপীনাথ বৰদলৈ ) (6 ᱡᱩᱱ 1890 -5 ᱟᱜᱟᱥᱴ 1950) ᱫᱚ ᱯᱷᱩᱨᱜᱟ.ᱞ ᱵᱷᱟᱨᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱮᱭᱟᱜ ᱟᱥᱟᱢ ᱯᱚᱱᱚᱛ ᱨᱮᱱ ᱯᱟ.ᱦᱤᱞ ᱢᱩᱠᱷᱤᱭᱟ. ᱢᱟᱱᱛᱟᱨᱤ ᱟᱨ ᱵᱷᱟᱨᱚᱛ ᱯᱷᱩᱨᱜᱟ.ᱞ ᱞᱟᱲᱟᱣᱱᱟ ᱨᱮᱱ ᱡᱤᱭᱟ.ᱲ ᱠᱟ.ᱢᱭᱟ.ᱭ ᱛᱟᱦᱮ ᱠᱟᱱᱟ ।" },
        { "cell": "signed-number", "text": "ᱭᱟᱝᱜᱳᱱ ᱫᱚ ᱞᱟᱛᱟᱨ ᱨᱮ ᱭᱟᱝᱜᱳᱱ ᱟᱨ ᱵᱟᱜᱳ ᱜᱟᱰᱟ ᱨᱮᱱᱟᱜ ᱫᱩᱞᱢᱤᱫ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱢᱟᱨᱛᱟᱵᱟᱱ ᱥᱟᱹᱢᱩᱸᱫᱽ ᱠᱷᱚᱱ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱓᱐ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱜᱟᱱ ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱚᱠᱛᱚ ᱮᱞᱟᱠᱟ ᱦᱤᱲᱟᱹᱵ ᱛᱟᱞᱢᱟ GMT +6:30 ᱢᱮᱱᱟᱜᱼᱟ ᱾" },
        { "cell": "signed-number", "text": "ᱭᱮᱨᱮᱵᱷᱟᱱ ᱨᱮᱱᱟᱜ ᱦᱚᱭ ᱦᱚᱭ ᱦᱤᱥᱤᱫ ᱫᱚ ᱨᱚᱦᱚᱲ, ᱞᱚᱞᱚ ᱥᱤᱛᱩᱝ ᱨᱤᱛᱩ, ᱨᱮᱭᱟᱲ ᱟᱨ ᱠᱷᱟᱴᱚ ᱨᱟᱵᱟᱝ ᱨᱤᱛᱩ ᱥᱟᱶ ᱡᱚᱲᱟᱣᱟᱱᱟ ᱾ ᱚᱜᱚᱥᱴ ᱪᱟᱸᱫᱚ ᱨᱮ ᱫᱚ ᱞᱚᱞᱚᱥᱚᱝ ᱔᱐°C ᱜᱟᱱ ᱨᱟᱠᱟᱵᱼᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱡᱟᱱᱩᱣᱟᱨᱤ ᱪᱟᱸᱫᱚ ᱨᱮ ᱱᱚᱶᱟ ᱫᱚ -᱑᱕ °C (᱕ °F) ᱜᱟᱱ ᱟᱬᱜᱚᱱᱟ ᱾ ᱫᱟᱜ ᱡᱟᱹᱯᱩᱫ ᱠᱚ ᱫᱚ ᱠᱚᱢ ᱫᱦᱟᱨᱟ ᱜᱮ ᱦᱩᱭᱩᱜᱼᱟ, ᱜᱚᱴᱟ ᱜᱩᱴᱤ ᱡᱟᱦᱟᱸᱫᱚ ᱥᱮᱨᱢᱟ ᱨᱮ ᱓᱕᱐ ᱢᱤᱞᱤᱢᱤᱴᱚᱨ ᱜᱟᱱ ᱦᱩᱭᱩᱜᱼᱟ ᱾" },
        { "cell": "signed-number", "text": "ᱚᱞᱪᱚᱠᱤ ᱪᱷᱟᱨᱟᱣ ᱯᱟᱥᱱᱟᱣ ᱟᱨ ᱟᱨ ᱚᱞᱪᱤᱠᱤ ᱛᱮ ᱦᱚᱲᱟᱜ ᱥᱩᱦᱤ ᱵᱟᱹᱲᱛᱤ ᱞᱟᱹᱜᱤᱫ ᱥᱟᱱᱛᱟᱲᱤ ᱮᱠᱟᱰᱮᱢᱤ ᱫᱚ ᱵᱮᱨᱮᱫ ᱟᱠᱟᱱᱟ ᱾ ᱵᱚᱪᱷᱚᱨ ᱜᱮ ᱱᱚᱣᱟ ᱜᱟᱶᱛᱟ ᱫᱚ ᱥᱤᱛᱩᱝ ᱨᱤᱛᱩ ᱨᱮ ᱥᱟᱱᱛᱟᱲᱤ ᱚᱞᱪᱤᱠᱤ ᱛᱮ ᱥᱮᱨᱢᱟᱠᱤᱭᱟᱹ ᱵᱤᱱᱤᱰ ᱮ ᱛᱚᱨᱟᱣᱮᱜ-ᱟ ᱾ ᱱᱤᱶᱟ ᱵᱤᱱᱤᱰ ᱨᱮ ᱢᱚᱬᱮ ᱪᱟᱱᱚᱪ, ᱮᱭᱟᱭ ᱪᱟᱱᱚᱪ ᱟᱨ ᱪᱟᱱᱚᱪ ᱞᱟᱹᱜᱤᱫ ᱵᱤᱱᱤᱰ ᱵᱤᱱᱤᱰᱭᱟᱹ ᱠᱚᱠᱚ ᱮᱢᱮᱜ ᱥᱟᱶᱛᱮ +᱒ ᱟᱨ +᱓ ᱵᱤᱱᱤᱰ ᱠᱚᱦᱚᱸ ᱛᱚᱨᱟᱵ ᱠᱟᱱᱟ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱫ ᱢᱩᱬᱩᱛ ᱟᱹᱯᱤᱥ ᱫᱚ ᱪᱚᱱᱫᱚᱱᱯᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ ᱟᱨ ᱠᱟᱹᱢᱤ ᱟᱹᱯᱤᱥ ᱫᱚ ᱵᱟᱹᱨᱯᱟᱫᱟ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ ᱾" },
        { "cell": "letter-name", "text": "ᱚᱵᱽᱫᱩᱞ ᱨᱚᱦᱤᱢ ᱠᱷᱟᱱ (Abdul Rahim Khan-I-Khana)" },
        { "cell": "letter-name", "text": "ᱱᱚᱶᱟ ᱫᱚ ᱡᱤᱶᱤᱫ ᱢᱮᱱᱟᱜ ᱤᱱᱰᱚ-ᱤᱭᱩᱨᱚᱯᱤᱭᱟᱱ ᱯᱟᱹᱨᱥᱤ ᱢᱩᱸᱫᱽ ᱠᱚᱨᱮ ᱠᱷᱚᱱ ᱜᱨᱤᱠ ᱯᱟᱹᱨᱥᱤ ᱨᱮᱱᱟᱜ ᱫᱚ ᱡᱤᱞᱤᱧ ᱜᱟᱛᱷᱟ ᱱᱟᱜᱟᱢ ᱢᱮᱱᱟᱜᱼᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱚᱞ-ᱛᱚᱞ ᱛᱮ ᱓᱔᱐᱐ ᱥᱮᱨᱢᱟ ᱢᱟᱲᱟᱝ ᱢᱟᱬᱟᱝ ᱠᱷᱚᱱ ᱛᱚᱝᱜᱮ ᱟᱹᱜᱩ ᱟᱠᱟᱱᱟ ᱾ ᱱᱩᱠᱩᱶᱟᱞ ᱚᱱᱚᱞ ᱠᱚ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱠᱟᱛᱮ ᱜᱨᱤᱠ ᱪᱤᱠᱤ ᱛᱮ ᱚᱞ ᱟᱠᱟᱱᱟ ᱚᱱᱟ ᱥᱟᱶᱛᱮ ᱞᱤᱱᱤᱭᱟᱨ ᱵᱤ (Linear B) ᱟᱨ ᱥᱤᱯᱨᱤᱭᱚᱴ ᱥᱤᱞᱟᱵᱚᱨᱤ (Cypriot syllabary) ᱪᱤᱠᱤ ᱦᱚᱸ ᱢᱟᱲᱟᱝ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "letter-name", "text": "ᱜᱨᱤᱠ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱯᱟᱹᱦᱤᱞ ᱯᱮ ᱜᱚᱴᱟᱝ ᱦᱚᱨᱚᱯ ᱛᱮ ᱠᱚ ᱚᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱡᱮᱢᱚᱱ ᱞᱤᱱᱤᱭᱟᱨ ᱵᱤ (Linear B), ᱥᱤᱯᱨᱤᱭᱚᱴ ᱥᱤᱞᱟᱵᱚᱨᱤ (Cypriot syllabary) ᱟᱨ ᱜᱨᱤᱠ ᱪᱤᱠᱤ, ᱢᱮᱠᱷᱟᱱ ᱱᱤᱛ ᱫᱚ ᱜᱨᱤᱠ ᱪᱤᱠᱤ ᱜᱮ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱᱟ ᱾" },
        { "cell": "letter-name", "text": "ᱯᱷᱨᱟᱝᱠᱞᱤᱱ ᱰᱮᱞᱟᱱᱚ ᱨᱩᱡᱽᱵᱷᱮᱞᱴ (Roosevelt, Franklin D.)" },
        { "cell": "letter-name", "text": "ᱟᱞᱵᱚᱨᱴ ᱟᱭᱤᱱᱥᱴᱟᱭᱤᱱ ᱫᱚ ᱡᱚᱨᱢᱟᱱ ᱨᱤᱱᱤᱡ ᱱᱚᱵᱮᱞ ᱥᱤᱨᱯᱷᱟᱹ ᱟᱢᱮᱴᱤᱭᱟᱹ, ᱡᱟᱭ ᱥᱟᱬᱮᱥᱤᱭᱟᱹ (physicist) ᱠᱟᱱᱟᱭ ᱾ ᱡᱟᱦᱟᱸᱭ ᱟᱡᱟᱜ ᱡᱟᱭ ᱥᱟᱬᱮᱥ ᱨᱮᱱᱟᱜ ᱥᱤᱨᱤᱡᱽ ᱥᱩᱛᱩᱨ ᱛᱮ ᱡᱟᱭ ᱥᱟᱬᱮᱥ ᱨᱮ ᱢᱤᱫ ᱚᱠᱛᱚ ᱦᱩᱞᱜᱩᱞᱟᱹᱱᱮ ᱵᱮᱱᱟᱣᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱞᱟᱹᱜᱤᱫ ᱟᱡ ᱫᱚ ᱡᱟᱭ ᱥᱟᱬᱮᱥ ᱨᱤᱱᱤᱡ ᱟᱯᱟᱛ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱭ ᱠᱟᱱᱟ ᱾ ᱟᱡᱟᱜ ᱥᱤᱨᱤᱡᱽ ᱠᱚ ᱢᱩᱸᱫᱽ ᱨᱮ, ᱦᱟᱢᱟᱞ ᱫᱟᱲᱮ ᱨᱮᱱᱟᱜ ᱥᱩᱛᱩᱨ E=mc² ᱫᱚ ᱟᱹᱰᱤ ᱵᱟᱰᱟᱭᱟᱱ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱟᱹᱲᱛᱤᱠᱟᱭ ᱛᱮ ᱟᱨᱥᱟᱞ-ᱵᱤᱡᱽᱞᱤ ᱯᱟᱥᱱᱟᱣ ᱯᱟᱱᱛᱮ ᱧᱟᱢ ᱞᱮᱫ ᱠᱷᱟᱹᱛᱤᱨ ᱑᱙᱒᱑ ᱥᱟᱞᱮ ᱨᱮ ᱱᱚᱵᱮᱞ ᱥᱤᱨᱯᱷᱟᱹᱭ ᱧᱟᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱱᱚᱝᱠᱟ ᱜᱮ ᱟᱡᱟᱜ ᱮᱱᱮᱢ ᱡᱟᱭ ᱥᱟᱬᱮᱥ ᱨᱮ ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱴᱷᱟᱹᱶ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱜᱼᱟ ᱾ ᱟᱭᱤᱱᱥᱴᱟᱭᱤᱱ ᱫᱚ ᱑᱘ ᱮᱯᱨᱤᱞ ᱑᱙᱕᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱜᱩᱨ ᱟᱠᱟᱱᱟᱭ ᱾" },
        { "cell": "letter-name", "text": "᱑᱕᱑᱒ ᱥᱟᱞ ᱨᱮ ᱟᱞᱵᱨᱮᱪᱴ ᱢᱟᱠᱥᱤᱢᱤᱞᱤᱟᱱ-᱑ ᱟᱜ ᱥᱟᱥᱚᱱ ᱨᱮ ᱨᱟᱡᱽ ᱥᱚᱦᱮᱫ ᱮ ᱧᱟᱢ ᱠᱮᱫᱼᱟ ᱾ ᱰᱩᱨᱮᱨ ᱫᱚ ᱵᱟᱱᱟᱨ ᱞᱩᱛᱷᱮᱨᱟᱱ ᱟᱨ ᱮᱯᱤᱥᱠᱳᱯᱟᱞ ᱪᱚᱨᱪ ᱠᱷᱚᱱ ᱥᱟᱨᱦᱟᱣ ᱮ ᱧᱟᱢ ᱞᱮᱫᱼᱟ ᱾ ᱰᱩᱨᱮᱨᱼᱟᱜ ᱡᱟᱥᱛᱤ ᱠᱟᱹᱢᱤ ᱨᱮ ᱠᱷᱩᱫᱟᱹᱭ(ᱞᱟᱜ ᱪᱤᱛᱟᱹᱨ), ᱢᱩᱴᱷᱟᱱ, ᱫᱟᱜ ᱨᱚᱝᱜ, ᱯᱚᱛᱚᱵ ᱵᱮᱱᱟᱣ ᱠᱚ ᱥᱮᱞᱮᱫ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ Apocalypse series (1498) ᱨᱮ ᱢᱮᱱᱟᱜ ᱠᱟᱴᱷ ᱨᱮ ᱞᱟᱜ ᱟᱠᱟᱱ ᱟᱡᱟᱜ ᱮᱴᱟᱜ ᱠᱟᱹᱢᱤ ᱠᱷᱚᱱ ᱟᱹᱰᱤ ᱥᱚᱨᱮᱥ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱞᱟᱜ ᱪᱤᱛᱟᱹᱨ ᱫᱚ ᱜᱳᱛᱷᱤᱠ ᱜᱩᱬ ᱟᱱᱟ ᱾ ᱟᱡᱟᱜ ᱟᱨ ᱧᱩᱛᱩᱢᱟᱱ ᱞᱟᱜ ᱪᱤᱛᱟᱹᱨ ᱠᱚ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ Knight, Death ᱟᱨ Devil (1513) ᱾ Saint Jerome (1514) and Melencolia I (1514), ᱱᱚᱶᱟ ᱵᱟᱨᱭᱟ ᱞᱟᱜ ᱪᱤᱛᱟᱹᱨ ᱫᱚ ᱴᱷᱟᱹᱣᱠᱟᱹ ᱥᱟᱞᱟ ᱛᱩᱢᱟᱹᱞ ᱯᱟᱲᱦᱦᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱥᱟᱛᱟᱢ ᱞᱮᱠᱟᱛᱮ ᱵᱟᱪᱷᱚᱱ ᱟᱠᱟᱱᱟ ᱾ ᱟᱡᱟᱜ ᱫᱟᱜ ᱨᱚᱝ ᱠᱟᱹᱢᱤ ᱦᱚᱸ ᱞᱟᱸᱰᱥᱠᱮᱯ ᱪᱤᱛᱟᱹᱨ ᱦᱤᱥᱟᱹᱣᱵ ᱛᱮ ᱯᱩᱭᱞᱩ ᱭᱩᱨᱳᱯ ᱨᱤᱱ ᱪᱤᱛᱟᱹᱨᱤᱭᱟᱹ ᱞᱮᱠᱟᱛᱮ ᱩᱯᱨᱩᱢ ᱮ ᱧᱟᱢ ᱟᱠᱟᱫᱼᱟ ᱟᱨ ᱟᱡᱟᱜ ᱟᱹᱰᱤ ᱩᱭᱦᱟᱹᱨ ᱟᱱ ᱠᱟᱴ ᱞᱟᱜ ᱠᱟᱹᱢᱤ ᱦᱚᱸ ᱚᱱᱟ ᱨᱮᱱᱟᱜ ᱦᱩᱲ ᱫᱟᱲᱮ ᱥᱟᱞᱜᱟᱣ ᱞᱮᱫᱼᱟᱭ ᱾" },
        { "cell": "letter-name", "text": "ᱟᱡᱟᱜ ᱟᱹᱰᱤ ᱟᱬᱜᱟᱛ ᱵᱚᱸᱜᱟ ᱠᱩᱲᱤ ᱠᱟᱹᱦᱟᱱᱤ \"The Tallow Candle\" (Danish: Tællelyset) ᱡᱟᱦᱟᱸ ᱑᱘᱒᱐ ᱨᱮ ᱚᱞ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱚᱠᱴᱳᱵᱚᱨ ᱒᱐᱑᱒ ᱨᱮ ᱢᱤᱫ ᱰᱟᱱᱤᱥ ᱟᱨᱠᱟᱭᱤᱵ ᱨᱮ ᱧᱟᱢ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱠᱟᱹᱦᱱᱤ ᱨᱮ ᱢᱤᱫ ᱢᱚᱦᱚᱢ ᱵᱟᱹᱛᱤ ᱤᱫᱤ ᱠᱟᱛᱮᱫ ᱚᱞ ᱞᱮᱱᱟ ᱚᱱᱟᱨᱮ ᱚᱱᱟ ᱵᱟᱹᱛᱤ ᱵᱷᱟᱹᱵᱤᱛᱳᱜ ᱠᱟᱱᱟᱭ ᱥᱟᱨᱦᱟᱣ ᱵᱟᱭ ᱧᱟᱢ ᱮᱫᱼᱟ ᱾ ᱱᱤᱭᱟᱹ ᱚᱠᱛᱚ ᱫᱚ ᱟᱱᱰᱤᱨᱥᱮᱱ ᱤᱥᱠᱩᱞ ᱨᱮ ᱜᱮ ᱚᱞᱚᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱑᱘᱒᱙ ᱨᱮ ᱟᱱᱰᱤᱨᱥᱮᱱ ᱟᱹᱰᱤᱜᱟᱱ ᱟᱡᱟᱜ ᱠᱷᱟᱴᱚ ᱠᱟᱹᱦᱱᱤ \"A Journey on Foot from Holmen's Canal to the East Point of Amager\" ᱟᱹᱰᱤᱜᱟᱱ ᱧᱩᱛᱩᱢ ᱮ ᱟᱢᱮᱴ ᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "letter-name", "text": "ᱮᱴᱟᱜ ᱢᱟᱢᱟᱞ (mammals) ᱞᱮᱠᱟ ᱜᱮ ᱠᱚᱲᱟ ᱫᱚ ᱟᱡ ᱟᱭᱳ ᱠᱷᱚᱱᱟᱜ X ᱠᱨᱚᱢᱚᱡᱚᱢ ᱟᱨ ᱟᱡ ᱵᱟᱵᱟ ᱠᱷᱚᱱᱟᱜ Y ᱠᱨᱚᱢᱚᱡᱚᱢ ᱮ ᱟᱜᱩᱭᱟ ᱾" },
        { "cell": "exponent", "text": "ᱤᱴᱟᱞᱤ ᱨᱮᱱᱟᱜ ᱩᱛᱟᱹᱨ ᱥᱤᱢᱟᱹᱱᱟ ᱨᱮ ᱟᱞᱯᱟᱥ ᱵᱩᱨᱩ ᱢᱟᱞᱟ ᱟᱲᱮ ᱯᱷᱨᱟᱱᱥ, ᱥᱩᱭᱡᱟᱨᱞᱮᱱᱰ, ᱚᱥᱴᱨᱤᱭᱟ ᱟᱨ ᱥᱞᱳᱵᱷᱮᱱᱤᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱡ ᱛᱟᱞᱟ ᱚᱛ ᱫᱚᱨᱮᱭᱟ ᱟᱲᱮ ᱵᱟᱨᱮᱭᱟ ᱫᱤᱯ ᱥᱤᱥᱤᱞᱤ ᱟᱨ ᱥᱟᱨᱫᱤᱱᱤᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱤᱴᱟᱞᱤ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 301,338 km² (116,347 sq mi)᱾ ᱫᱷᱟᱹᱨᱛᱤ ᱵᱷᱤᱛᱨᱤᱨᱮ ᱤᱴᱟᱞᱤ ᱫᱚ ᱒᱓ ᱟᱜ ᱥᱟᱸᱜᱮ ᱦᱚᱲ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ᱾ ᱤᱴᱟᱞᱤ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱚᱲ ᱫᱚ ᱨᱳᱢ ᱠᱟᱱᱟ᱾" },
        { "cell": "exponent", "text": "ᱱᱚᱶᱟ ᱵᱟᱜᱟᱱ ᱫᱚ 845²km ᱚᱥᱟᱨ-ᱵᱤᱥᱟᱹᱨ ᱛᱮ ᱟᱴᱮᱫ ᱟᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱛᱟᱞᱟᱨᱮ ᱟᱹᱰᱤ ᱪᱮᱨᱦᱟ ᱫᱟᱜ ᱧᱩᱨ ᱟᱬᱜᱚᱜ ᱠᱟᱱ ᱴᱷᱟᱶ ᱢᱮᱱᱟᱜᱼᱟ, ᱡᱮᱢᱚᱱ ᱡᱚᱨᱚᱱᱫᱟ ᱟᱨ ᱵᱚᱨᱮᱭᱯᱟᱬᱤ (ᱵᱨᱚᱭᱯᱟᱹᱬᱤ) ᱾ ᱥᱤᱢᱲᱤᱯᱟᱲ ᱨᱮ ᱙᱙ ᱜᱚᱴᱟᱝ ᱨᱚᱭᱟᱞ ᱵᱮᱸᱜᱚᱞ ᱠᱩᱞ ᱟᱨ ᱔᱓᱒ ᱜᱚᱴᱟᱝ ᱵᱤᱨ ᱦᱟᱹᱛᱤ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾" },
        { "cell": "exponent", "text": "ᱥᱩᱭᱡᱟᱨᱞᱮᱱᱰ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 41,285 km² (15,940 sq mi)᱾ ᱱᱤᱭᱟᱹ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱱᱟᱜ ᱟᱵᱽᱦᱟᱣᱟ ᱫᱚ ᱟᱹᱰᱤᱜᱮ ᱱᱟᱯᱟᱭᱟ᱾ ᱱᱚᱸᱰᱮ ᱫᱚ ᱨᱮᱭᱟᱲ ᱜᱮ ᱡᱟᱹᱥᱛᱤ ᱛᱟᱸᱦᱮᱸᱱᱟ᱾ ᱫᱤᱥᱟᱹᱢ ᱫᱟᱲᱟᱱ ᱦᱚᱲᱠᱩ ᱞᱟᱹᱜᱤᱛ ᱥᱩᱭᱡᱟᱨᱞᱮᱱᱰ ᱫᱚ ᱟᱹᱰᱤᱜᱮ ᱵᱷᱟᱜᱮᱭᱟ᱾ ᱟᱞᱯᱚᱥ ᱵᱩᱨᱩᱢᱟᱞᱟ ᱟᱨ ᱜᱟᱰᱟ ᱱᱟᱹᱲᱤ ᱠᱩ ᱛᱟᱸᱦᱮᱸᱱ ᱠᱷᱟᱹᱛᱤᱨ ᱱᱤᱭᱟᱹ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱭᱟᱜ ᱪᱮᱦᱨᱟ ᱟᱹᱰᱤᱜᱮ ᱥᱤᱵᱤᱞᱟ ᱥᱮ ᱢᱚᱡᱟ᱾" },
        { "cell": "exponent", "text": "ᱵᱨᱤᱴᱮᱱ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 242,495 km² (93,628 sq mi)᱾ ᱱᱚᱣᱟ ᱥᱮᱞᱮᱫ ᱫᱤᱥᱟᱹᱢ ᱫᱚ ᱟᱭᱢᱟ ᱫᱤᱯ ᱱᱤᱭᱮᱛᱮ ᱛᱮᱭᱟᱨ ᱟᱠᱟᱱᱟ᱾ ᱱᱚᱣᱟ ᱵᱷᱤᱛᱨᱤ ᱨᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱡ ᱞᱟᱹᱴᱩ ᱫᱤᱯ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱜᱨᱮᱴ ᱵᱨᱤᱴᱮᱱ᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱨᱮᱫᱚ ᱨᱟᱵᱟᱝ ᱡᱟᱹᱥᱛᱤ ᱜᱮᱭᱟ᱾ ᱚᱱᱟ ᱠᱟᱨᱚᱱᱛᱮ ᱱᱚᱸᱰᱮ ᱫᱚ ᱜᱷᱟᱸᱥ ᱦᱚᱸ ᱡᱟᱹᱥᱛᱤ ᱜᱮᱭᱟ᱾ ᱠᱟᱹᱴᱤᱡ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱦᱚᱸ ᱱᱚᱸᱰᱮ ᱫᱚ ᱟᱭᱢᱟ ᱦᱚᱲᱠᱩ ᱛᱟᱸᱦᱮᱸᱱᱟ᱾ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱱ ᱟᱭᱢᱟ ᱡᱟᱜᱟ ᱨᱮᱱ ᱦᱚᱲ ᱱᱚᱸᱰᱮᱠᱩ ᱵᱟᱥᱟᱣ ᱟᱠᱟᱱᱟ᱾ ᱤᱭᱩᱨᱳᱯ ᱵᱷᱤᱛᱨᱤᱨᱮ ᱱᱚᱣᱟ ᱫᱤᱥᱚᱢ ᱫᱚ ᱠᱤᱥᱟᱸᱲ ᱢᱮᱱᱛᱮᱠᱩ ᱞᱮᱠᱷᱟᱜᱼᱟ᱾" },
        { "cell": "exponent", "text": "ᱥᱮᱞᱮᱫ ᱯᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 3,796,742 sq mi (9,833,520 km²)᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱩᱛᱟᱹᱨ ᱨᱮ ᱫᱚ ᱠᱟᱱᱟᱰᱟ, ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱡ ᱫᱚ ᱥᱮᱞᱮᱫ ᱟᱠᱟᱱᱟ ᱢᱮᱠᱥᱤᱠᱟᱱ ᱫᱤᱥᱟᱹᱢᱠᱩ ᱢᱮᱱᱟᱜᱼᱟ, ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱚᱦᱟᱫᱚᱨᱮᱭᱟ ᱟᱨ ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱡ ᱯᱨᱚᱥᱟᱱᱛᱚ ᱢᱚᱦᱟᱫᱚᱨᱮᱭᱟ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "exponent", "text": "ᱥᱳᱣᱫᱤ ᱟᱨᱚᱵᱽ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 2,149,690 km²(830,000 sq mi)᱾ ᱱᱚᱣᱟ ᱫᱤᱥᱟᱹᱢ ᱩᱛᱟᱹᱨ ᱥᱮᱡ ᱡᱚᱨᱫᱟᱱ ᱟᱨ ᱤᱨᱟᱠ, ᱩᱛᱟᱹᱨ ᱯᱩᱨᱩᱵᱽ ᱨᱮ ᱠᱩᱭᱮᱛ, ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱠᱟᱛᱟᱨ, ᱵᱟᱦᱨᱟᱭᱤᱱ ᱟᱨ ᱟᱨᱚᱵᱽ ᱟᱢᱤᱨᱟᱛ, ᱫᱟᱹᱠᱷᱤᱱ ᱯᱩᱨᱩᱵᱽ ᱥᱮᱡ ᱳᱢᱟᱱ ᱟᱨ ᱫᱟᱹᱠᱷᱤᱱ ᱥᱮᱡ ᱤᱭᱮᱢᱮᱱ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "exponent", "text": "ᱮᱥᱯᱮᱱ ᱫᱚ ᱤᱣᱨᱳᱯ ᱨᱮᱱᱟᱜ ᱯᱩᱱᱟᱜ ᱞᱟᱹᱴᱩ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ᱾ ᱮᱥᱯᱮᱱ ᱨᱮᱱᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ 505,990 km² (195,360 sq mi)᱾ ᱮᱥᱯᱮᱱ ᱨᱮᱱᱟᱜ ᱯᱟᱹᱪᱷᱤᱢ ᱥᱮᱡ ᱯᱳᱨᱛᱩᱜᱟᱞ, ᱩᱛᱟᱹᱨ ᱯᱩᱨᱩᱵ ᱥᱮᱡ ᱯᱷᱨᱟᱱᱥ ᱟᱨ ᱮᱱᱰᱳᱨᱟ ᱥᱟᱶᱛᱮ ᱡᱚᱝᱲᱟᱣ ᱢᱮᱱᱟᱜᱼᱟ᱾" },
        { "cell": "exponent", "text": "᱾ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱚᱥᱟᱨ-ᱵᱤᱥᱟᱹᱨ ᱫᱚ ᱑᱐᱕ km² ᱟᱨ ᱥᱩᱨᱥᱩᱨᱩᱨ ᱒.᱑᱕ ᱢᱤᱞᱤᱭᱚᱱ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ ᱾ ᱚᱱᱟ ᱥᱩᱯᱩᱨ ᱴᱚᱠᱷᱟ ᱦᱚᱲ ᱠᱚ ᱞᱮᱠᱷᱟ ᱥᱮᱞᱮᱫ ᱞᱮᱠᱚ ᱠᱷᱟᱱ ᱯᱮᱨᱤᱥ ᱨᱤᱱ ᱦᱚᱲ ᱠᱚᱣᱟ ᱮᱞ ᱫᱚ ᱑᱒ ᱢᱤᱞᱤᱭᱚᱱ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤᱜ-ᱟ ᱾" },
        { "cell": "arithmetic", "text": "ᱡᱮ ᱞᱮᱠᱟᱺ ᱒÷᱑=᱒, ᱓÷᱑=᱓, ᱔÷᱑=᱔ ᱿ ᱚᱱᱟ ᱠᱷᱟᱹᱛᱤᱨ ᱑ ᱫᱚ ᱡᱷᱚᱛᱚ ᱮᱞ ᱨᱤᱱᱤᱡ ᱦᱟᱬᱟ ᱠᱟᱱᱟᱭ ᱾" },
        { "cell": "arithmetic", "text": "᱒ ᱫᱚ ᱢᱤᱫ ᱟᱨ ᱯᱮ ᱛᱟᱞᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱮᱞ ᱠᱟᱱᱟ: ᱑<᱒<᱓" },
        { "cell": "arithmetic", "text": "ᱡᱮᱞᱮᱠ: ᱓÷᱓=᱑, ᱓÷᱑=᱓ ᱱᱚᱣᱟ ᱵᱟᱱᱟᱨ ᱦᱟᱴᱟᱬ ᱨᱮ ᱦᱟᱴᱟᱬ ᱥᱟᱨᱮᱡ ᱫᱚ ᱐ ᱠᱟᱱᱟ ᱾" },
        { "cell": "arithmetic", "text": "᱓ ᱫᱚ ᱵᱟᱨ (᱒) ᱟᱨ ᱯᱩᱱ (᱔) ᱛᱟᱞᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱮᱞ ᱠᱟᱱᱟ: ᱒<᱓<᱔" },
        { "cell": "arithmetic", "text": "᱔ ᱫᱚ ᱯᱮ (᱓) ᱟᱨ ᱢᱚᱬᱮ (᱕) ᱛᱟᱞᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱮᱞ ᱠᱟᱱᱟ: ᱓<᱔<᱕" },
        { "cell": "arithmetic", "text": "᱑ ᱥᱮᱨᱢᱟ = ᱑᱒ ᱪᱟᱸᱫᱚ= ᱓᱖᱕ ᱢᱟᱦᱟᱸ (leap year ᱨᱮᱫᱚ ᱓᱖᱖ ᱢᱟᱦᱟᱸ)" },
        { "cell": "arithmetic", "text": "ᱡᱚᱠᱷᱚᱱ ᱦᱚᱨᱚᱯ ᱫᱚ ᱮᱞ ᱞᱮᱠᱟᱛᱮ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱᱟ, ᱪᱤᱠᱤ أ ᱫᱚ ᱑ ᱠᱟᱱᱟᱭ, ب ᱫᱚ ᱒, ج ᱫᱚ ᱓ ᱮᱢᱟᱱ ᱮᱢᱟᱱ ᱚᱞᱚᱜᱼᱟ ᱾ ᱚᱱᱠᱟ ᱜᱮ ي yāʼ = 10, ك kāf = 20, ل lām = 30, …, ر rāʼ = 200, …, غ ġayn = 1000 ᱮᱢᱟᱱ ᱞᱮᱠᱟ ᱦᱩᱭᱩᱜᱼᱟ ᱾" },
        { "cell": "arithmetic", "text": "ᱦᱟᱴᱟᱜ = ᱱᱟᱭᱠᱮ ᱾ ᱱᱚᱝᱠᱟ ᱟᱨ ᱱᱩᱠᱩ ᱟᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱟᱹᱛᱩ ᱾ ᱢᱤᱫ ᱞᱮᱠᱟᱱ ᱟᱹᱛᱩ ᱨᱮ ᱛᱟᱦᱮᱱ ᱜᱮ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱟᱹᱛᱩ ᱾" },
        { "cell": "ampersand", "text": "ᱯᱤᱪᱟᱭ ᱥᱩᱱᱫᱚᱨᱨᱟᱡᱚᱱ ᱫᱚ ᱛᱟᱢᱤᱞᱱᱟᱰᱩ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱪᱮᱱᱱᱟᱭ ᱥᱟᱦᱟᱨ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱡ ᱟᱯᱟᱛ ᱨᱚᱜᱷᱩᱱᱟᱛᱷ ᱯᱤᱪᱟᱭ ᱢᱤᱫ ᱤᱞᱮᱠᱴᱨᱤᱠᱟᱞ ᱤᱸᱡᱤᱱᱤᱭᱟᱹᱨ ᱞᱮᱠᱟᱛᱮ British conglomerate GEC ᱨᱮ ᱠᱟᱹᱢᱤ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱮᱸᱜᱟᱛ ᱫᱚ ᱩᱫᱩᱜᱪᱤᱱ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱠᱤᱱ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱟᱡᱤᱡ ᱟᱨ ᱢᱤᱫ ᱵᱚᱭᱦᱟᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱥᱩᱱᱫᱚᱨᱨᱟᱡᱚᱱ ᱫᱚ ᱟᱡᱟᱜ ᱟᱥᱲᱟ ᱥᱮᱪᱮᱫ Padma Seshadri Bala Bhavan ᱟᱨ ᱚᱱᱟ ᱛᱟᱭᱚᱢ Indian Institute of Technology in Kharagpur ᱨᱮ ᱧᱩᱛᱩᱢ ᱚᱞ ᱞᱟᱹᱜᱤᱫ ᱫᱟᱣ ᱮ ᱧᱟᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱟᱨᱟᱝ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱟᱡᱟᱜ B.Tech in Metallurgical ᱤᱸᱡᱤᱱᱤᱭᱟᱹᱨ ᱯᱩᱨᱟᱹᱣ ᱠᱟᱛᱮ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ M.S in physics Stanford University ᱨᱮ ᱥᱮᱪᱮᱫᱚᱜ ᱞᱟᱹᱜᱤᱫ ᱫᱟᱣ ᱮ ᱧᱟᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱟᱨ ᱚᱸᱰᱮ ᱠᱷᱚᱱ ᱥᱚᱱᱮᱨ ᱮ ᱥᱤᱫ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ Silicon Valley semiconductor maker ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ ᱤᱸᱡᱤᱱᱩᱭᱟᱹᱨ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱢᱤ ᱮᱦᱚᱵ ᱞᱮᱫᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ Wharton School of the University of Pennsylvania ᱠᱷᱚᱱ ᱟᱡᱟᱜ MBA ᱥᱤᱫ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱒᱐᱐᱒ ᱥᱟᱞᱮ ᱨᱮ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ McKinsey & Company ᱨᱮ MANAGEMENT CONSULTAN ᱞᱮᱠᱟᱛᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱒᱐᱐᱔ ᱥᱟᱞᱮ ᱨᱮ ᱜᱩᱜᱳᱞ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱨᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱟᱨ ᱱᱤᱛᱚᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱩᱥᱩᱞ ᱛᱷᱚᱠ ᱠᱟᱹᱢᱤᱭᱟᱹ ᱞᱮᱠᱟᱛᱮ ᱢᱮᱱᱟᱭᱟ ᱾" },
        { "cell": "ampersand", "text": "ᱯᱤᱪᱟᱭ ᱒᱐᱐᱔ ᱥᱟᱞᱮ ᱨᱮ ᱜᱩᱜᱳᱞ ᱨᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱡᱟᱦᱟᱸᱨᱮ ᱟᱡ Product Management & innovation ᱴᱷᱟᱶ ᱨᱮ ᱛᱷᱚᱠ ᱨᱮ ᱠᱟᱹᱢᱤᱭᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸ ᱠᱷᱚᱱ ᱜᱩᱜᱳᱞ ᱠᱨᱚᱢ ᱟᱨ ᱠᱨᱚᱢ ᱚᱯᱮᱨᱮᱴᱤᱝ ᱥᱤᱥᱴᱚᱢ ᱨᱮ ᱟᱡᱟᱜ ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱮᱱᱮᱢ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱚᱱᱟ ᱥᱟᱶᱛᱮ ᱜᱩᱜᱳᱞ ᱰᱨᱟᱭᱤᱵᱽ ᱨᱮ ᱦᱚᱸ ᱟᱡᱟᱜ ᱮᱱᱮᱢ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱑᱙ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱒᱐᱐᱙ ᱥᱟᱞᱮ ᱨᱮ ᱠᱨᱚᱢ ᱚᱯᱮᱨᱮᱴᱤᱧ ᱥᱤᱥᱴᱚᱢ ᱟᱨ ᱠᱨᱚᱢ ᱵᱩᱠ ᱵᱟᱵᱚᱫᱽ ᱛᱮ ᱫᱷᱟᱹᱨᱛᱤ ᱢᱟᱱᱣᱟ ᱠᱚᱭ ᱵᱟᱰᱟᱭ ᱚᱪᱚ ᱞᱮᱫ ᱠᱚ ᱛᱟᱦᱮᱸᱫ ᱾ ᱑᱓ ᱢᱟᱨᱪ ᱒᱐᱑᱓ ᱥᱟᱞᱮᱨᱮ ᱟᱡᱟᱜ ᱠᱟᱹᱢᱤᱭᱟᱹ ᱡᱤᱭᱚᱱ ᱨᱮ ᱜᱮ ᱟᱱᱰᱨᱚᱭᱮᱰ ᱦᱮᱡ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱑᱐ ᱚᱜᱚᱥᱴ ᱒᱐᱑᱕ ᱥᱟᱞᱮᱨᱮ ᱟᱡ ᱫᱚ ᱜᱩᱜᱚᱞ ᱨᱤᱱᱤᱡ ᱥᱤ.ᱤ.ᱳ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱢᱤᱭ ᱛᱚᱨᱟᱣ ᱟᱹᱜᱩᱭᱮᱜ-ᱟ ᱾" },
        { "cell": "ampersand", "text": "* ** ᱥᱮᱨᱮᱧ ᱨᱮᱱᱟᱜ ᱛᱷᱚᱠ:** ᱫᱚᱝ ᱥᱮᱨᱮᱧ ᱨᱮ ᱫᱚ ᱠᱩᱠᱞᱤ- ᱨᱩᱣᱟᱹᱲ (Question & Answer), ᱞᱟᱸᱫᱟ- ᱨᱟᱹᱥᱠᱟᱹ, ᱢᱟᱱ- traditional, ᱟᱨ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱡᱤᱭᱚᱱ ᱨᱮᱱᱟᱜ ᱠᱟᱹᱦᱱᱤ ᱠᱚ ᱥᱚᱫᱚᱨᱚᱜ-ᱟ᱾" },
        { "cell": "ampersand", "text": "ᱢᱟᱣᱩᱱᱴ ᱯᱷᱩᱡᱤ ᱫᱚ ᱦᱳᱸᱥᱩ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱿ ᱡᱟᱯᱟᱸ ᱨᱮᱸᱟᱜ ᱡᱷᱚᱛᱚ ᱠᱷᱚᱱ ᱥᱮᱬᱟ ᱵᱩᱨᱩ ᱠᱟᱱᱟ 3,776.24&nbsp;m (12,389&nbsp;ft), ᱮᱥᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱫᱳᱨᱭᱟ ᱛᱟᱞᱟ ᱫᱤᱥᱚᱢ (Volcanic) ᱢᱩᱫ ᱨᱮ ᱫᱚᱥᱟᱨ ᱥᱮᱬᱟ ᱪᱚᱴᱟᱛ ᱠᱟᱱᱟ, ᱟᱨ ᱫᱷᱟᱹᱨᱛᱤ ᱨᱮᱱᱟᱜ ᱗ᱟᱱᱟᱝ ᱪᱚᱴᱟᱛ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱦᱟᱯᱤᱫ ᱦᱟᱠᱟᱱ ᱥᱴᱨᱟᱴᱟ ᱵᱷᱳᱞᱠᱟᱱᱚ ᱠᱟᱱᱟ ᱢᱩᱪᱟᱹᱫ ᱫᱷᱟᱣ ᱑᱗᱐᱗ᱼ᱑᱗᱐᱘ ᱨᱮ ᱱᱚᱣᱟ ᱵᱷᱤᱲᱠᱟᱹᱣ ᱡᱩᱞ ᱞᱮᱱᱟ ᱾ ᱯᱷᱩᱡᱤ ᱵᱩᱨᱩ ᱴᱚᱠᱭᱳ ᱨᱮᱱᱟᱜ ᱮᱛᱚᱢ ᱼᱯᱟᱪᱮ ᱨᱮᱱᱟᱜ ᱑᱐᱐ ᱠᱤ ᱢᱤ ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ |" },
        { "cell": "ampersand", "text": "ᱢᱩᱜᱚᱞ ᱨᱟᱡᱽ ᱠᱩᱢᱟᱨ ᱡᱟᱦᱟᱝᱜᱤᱨ ᱟᱜ ᱴᱷᱟᱶ ᱮ ᱛᱚᱨᱟᱣ ᱞᱮᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱯᱷᱤᱞᱤᱢ ᱫᱚ ᱢᱟᱬᱟᱝ ᱦᱮᱸᱫᱮᱼᱯᱩᱸᱰ (Black & White) ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱛᱟᱭᱚᱢ ᱛᱮ ᱚᱱᱟ ᱫᱚ ᱨᱚᱝᱜᱤᱱ ᱠᱚ ᱵᱮᱱᱟᱣ ᱠᱮᱜᱼᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱑᱙᱖᱑ ᱥᱟᱞᱮᱨᱮ ᱜᱚᱝᱜᱟ ᱡᱚᱢᱩᱱᱟ ᱯᱷᱤᱞᱤᱢ ᱦᱚᱸᱭ ᱵᱮᱱᱟᱣ ᱠᱮᱜᱼᱟ ᱡᱟᱦᱟᱸᱨᱮ ᱟᱡ ᱥᱟᱶ ᱟᱡ ᱠᱷᱚᱱ ᱦᱩᱰᱤᱧ ᱤᱡ ᱠᱚᱲᱟ ᱵᱚᱭᱦᱟ ᱱᱟᱥᱤᱨ ᱠᱷᱟᱱ ᱮ ᱠᱟ.ᱢᱤ ᱞᱮᱜᱼᱟ ᱾" },
        { "cell": "ampersand", "text": "ᱠᱟ.ᱱᱟ.ᱭᱞᱟᱞ ᱴᱩᱰᱩ ᱜᱚᱢᱠᱮ ᱫᱚ ᱑᱙᱖᱔ ᱥᱟᱞᱮ ᱨᱮᱭ ᱵᱟᱯᱞᱟ ᱮᱱᱟ ᱾ ᱟᱡᱤᱡ ᱮᱨᱟ ᱟᱜ ᱧᱩᱛᱩᱢ ᱜᱚ ᱟᱥᱟᱯᱮᱨᱮᱡ, ᱢᱤᱫ ᱯᱨᱟᱭᱢᱟᱨᱤ ᱟᱥᱲᱟ ᱢᱟᱪᱮᱛ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱠᱟ.ᱱᱟ.ᱭᱞᱟᱞ ᱜᱚᱢᱠᱮ ᱫᱚ Post & Telegraph department ᱨᱮ postal Assistant ᱞᱮᱠᱟᱛᱮᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱑᱙᱖᱗ ᱥᱟᱞᱮᱨᱮ ᱾ ᱛᱟᱭᱚᱢ ᱛᱮ ᱑᱙᱖᱙ ᱥᱟᱞᱮ ᱨᱮ ᱠᱳᱞᱠᱟᱛᱟᱭ ᱥᱮᱱ ᱞᱮᱱ ᱚᱠᱛᱚ ᱨᱮ Adivasi Socio-Educational & Cultural Association of West Bangal ᱥᱟᱶ ᱡᱚᱲᱟᱣ ᱨᱮᱭ ᱦᱮᱡ ᱮᱱᱟ ᱾ ᱚᱱᱟ ᱨᱮᱭᱟᱜ ᱵᱩᱫᱷᱤ ᱫᱤᱥᱟ. ᱟᱨ ᱠᱟ.ᱢᱤᱦᱚᱨᱟ ᱠᱚ ᱧᱮᱞ ᱠᱟᱛᱮ ᱩᱱᱤ ᱫᱚ ASECA ᱨᱮ ᱥᱮᱞᱮᱫ ᱮ ᱦᱟᱛᱟᱣ ᱠᱮᱫ-ᱟ ᱾" },
        { "cell": "ampersand", "text": "ᱥᱤᱞᱵᱷᱚᱨᱤᱱ ᱥᱣᱮᱨ (᱑᱙᱑᱐&#x2013;᱒᱐᱑᱔), ᱠᱚᱝᱜ ᱥᱤᱞ (ᱠᱷᱟᱥᱤ ᱯᱟᱹᱨᱥᱤ ᱛᱮ ᱠᱚᱝ ᱨᱮᱱᱟᱜ ᱱᱮᱵᱮᱛ ᱫᱚ ᱫᱟᱹᱭ) ᱢᱮᱱᱛᱮᱫ ᱦᱚᱸ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲ ᱠᱚ ᱵᱟᱰᱟᱭ ᱦᱟᱠᱟᱫᱮᱭᱟ ᱾ ᱞᱟᱭᱚᱝᱟᱱ/ᱥᱟᱪᱟᱨᱮᱦ,ᱥᱮᱪᱮᱫ ᱟᱨ ᱫᱤᱥᱩᱣᱟᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱦᱩᱞᱟᱜᱟᱨᱤᱭᱟᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾ ᱢᱮᱜᱷᱟᱞᱚᱭ, ᱥᱚᱨᱠᱟᱨᱼᱟ ᱞᱟᱹᱴᱩ ᱢᱟᱪᱤ ᱨᱮ ᱫᱩᱲᱩᱵ ᱦᱟᱠᱟᱱ ᱯᱩᱭᱞᱩ ᱟᱹᱫᱤᱵᱟᱥᱤ ᱠᱟᱱᱟ ᱠᱤᱱ ᱵᱷᱟᱨᱚᱛ ᱥᱠᱟᱩᱴ ᱟᱨ ᱜᱟᱭᱤᱰᱥ ᱨᱮᱱᱟᱜ ᱥᱤᱞᱵᱷᱚᱨ ᱮᱞᱮᱯᱷᱟᱱᱴ ᱢᱮᱰᱟᱞ ᱟᱨ ᱠᱟᱭᱥᱟᱨ ᱼᱤᱼᱦᱤᱱᱫ ᱢᱮᱰᱟᱞ ᱟᱢᱮᱴᱤᱭᱟ ᱠᱟᱱᱟᱭ ᱾ ᱑᱙᱙᱐ ᱥᱟᱞ ᱨᱮ ᱥᱤᱧᱚᱛ ᱨᱤᱱᱤᱡ ᱥᱚᱨᱠᱟᱨ ᱯᱚᱫᱬᱚᱥ ᱯᱚᱫᱽᱢᱚᱥᱷᱨᱤ ᱢᱟᱱ ᱥᱟᱨᱦᱟᱣ ᱠᱤᱱ ᱪᱟᱞ ᱦᱟᱫᱮ ᱛᱟᱦᱮᱸᱫ ᱾ ᱢᱮᱜᱷᱟᱞᱚᱭ. ᱜᱷᱚᱱ ᱱᱚᱣᱟ ᱢᱟᱱ ᱟᱡ ᱜᱮ ᱯᱩᱭᱞᱩᱛᱮ ᱧᱟᱢ ᱦᱟᱠᱟᱫ ᱟᱭ ᱾" },
        { "cell": "ampersand", "text": "ᱠᱤᱞᱤ ᱢᱟᱱᱡᱟᱨᱳ ᱵᱩᱨᱩ- ᱠᱚᱧᱮ ᱟᱯᱷᱨᱤᱠᱟ ᱨᱮᱱᱟᱜ ᱡᱷᱚᱛᱚᱠᱷᱚᱱ ᱩᱥᱩᱞ ᱛᱟᱱᱡᱟᱱᱤᱭᱟ ᱨᱮᱸᱡ 5,895&nbsp;m ᱙ ᱚᱠᱴᱳᱵᱚᱨ ᱒᱐᱑᱔ ᱵᱤᱱᱟᱹ ᱚᱠᱥᱤᱡᱮᱱ ᱛᱮ ᱥᱟᱹᱛ ᱠᱮᱫᱼᱟ ᱾" },
        { "cell": "sports-time", "text": "ᱱᱤᱞ ᱟᱞᱰᱮᱱ ᱟᱨᱢᱥᱴᱨᱚᱝ ᱫᱚ ᱢᱤᱫ ᱟᱢᱮᱨᱤᱠᱤᱭᱟᱹ ᱢᱚᱦᱟᱠᱟᱥᱪᱟᱨᱤ, ᱴᱮᱥᱴ ᱯᱟᱭᱞᱚᱴ, ᱮᱨᱚᱱᱮᱴᱤᱠᱥ ᱤᱧᱡᱤᱱᱤᱭᱟᱹᱨ, ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱤᱱᱤᱡ ᱢᱟᱪᱮᱫ ᱥᱟᱶᱛᱮ ᱪᱚᱱᱫᱽᱨᱚ ᱨᱮ ᱡᱟᱸᱜᱟ ᱮᱢᱤᱡ ᱯᱩᱭᱞᱩ ᱢᱟᱹᱱᱢᱤ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾ ᱢᱚᱦᱟᱠᱟᱥᱪᱟᱨᱤ ᱦᱩᱭᱩᱜ ᱢᱟᱬᱟᱝᱨᱮ ᱟᱢᱮᱨᱤᱠᱟ ᱨᱤᱱᱤᱡ ᱯᱷᱟᱹᱫᱽ ᱞᱮᱠᱟᱛᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱛᱮ ᱠᱚᱨᱤᱭᱟ ᱞᱟᱹᱲᱦᱟᱹᱭ (᱒᱕ ᱡᱩᱱ ᱑᱙᱕᱐ - ᱒᱗ ᱡᱩᱞᱟᱭ ᱑᱙᱕᱓) ᱨᱮ ᱥᱮᱞᱮᱫ ᱮ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ ᱾ ᱒᱐ ᱡᱩᱞᱟᱭ ᱑᱙᱖᱙ ᱦᱤᱞᱚᱜ ᱒᱐:᱑᱗:᱓᱙ ᱭᱩ.ᱴᱤ.ᱥᱤ ᱚᱠᱛᱚ ᱨᱮ ᱵᱚᱡᱽ ᱟᱞᱰᱨᱤᱱ ᱥᱟᱶ ᱱᱤᱞ ᱟᱨᱢᱥᱨᱚᱝ ᱟᱯᱚᱞᱚ-᱑᱑ ᱛᱮ ᱪᱚᱱᱫᱨᱚ ᱨᱮᱭ ᱟᱬᱜᱚ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱡᱟᱜ ᱡᱤᱭᱚᱱ ᱨᱮ ᱜᱩᱴ ᱨᱮ ᱘ ᱫᱤᱱ, ᱑᱔ ᱴᱟᱬᱟᱝ, ᱑᱒ ᱴᱤᱬᱤᱡ, ᱓᱑ ᱴᱤᱯᱤᱡ ᱥᱟᱹᱜᱤᱧ ᱥᱮᱨᱢᱟ ᱨᱮᱭ ᱛᱟᱦᱮᱸᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "sports-time", "text": "ᱥᱟᱱᱛᱷᱤ-ᱭᱟᱜ ᱱᱮᱥᱱᱟᱞ ᱛᱤᱨᱞᱟ. ᱨᱮᱠᱚᱰ ᱓000 ᱢᱤᱴᱚᱨ ᱥᱴᱮᱯᱚᱞ ᱪᱮᱡ ᱨᱮ ᱑0:᱔᱔.᱖᱕ ᱥᱮᱠᱮᱸᱰ ᱨᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱭᱟ ᱾ ᱡᱤᱞᱟᱭ ᱒᱐᱐᱕ ᱵᱟᱝᱜᱟᱞᱳᱨ ᱨᱮ ᱥᱟᱱᱛᱷᱤ ᱘00 ᱢ., ᱑,᱕00 ᱢ. ᱟᱨ ᱓000 ᱢ. ᱠᱚᱭ ᱫᱟᱲᱮ ᱠᱟᱱᱟ ᱾ ᱥᱟᱣᱳᱛᱷ ᱠᱳᱨᱤᱭᱟ ᱤᱱᱪᱤᱭᱳᱱ ᱨᱮᱭᱟᱜ ᱒00᱕ ᱮᱟᱤᱭᱟᱱ ᱪᱟᱢᱯᱤᱭᱟᱱᱥᱤᱯ ᱨᱮ ᱘00 ᱢ. ᱫᱟ.ᱲ ᱨᱮ ᱨᱩᱯᱟ. ᱢᱮᱰᱟᱞ ᱫᱟᱲᱮ ᱠᱟᱱᱟᱭ ᱾" },
        { "cell": "sports-time", "text": "᱑᱙᱘᱔ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱑:᱐᱖.᱑᱙ ᱴᱤᱯᱤᱡ ᱨᱮᱱᱟᱜ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱑᱐᱐ ᱢᱤᱴᱚᱨ ᱵᱚᱴᱚᱨᱯᱷᱞᱟᱭ ᱨᱮᱠᱳᱨᱰ ᱮ ᱵᱮᱱᱟᱣ ᱠᱮᱫᱼᱟ ᱾ ᱑᱙᱘᱖ ᱨᱮ ᱥᱤᱭᱳᱞ ᱮᱥᱤᱭᱟᱰ ᱠᱷᱮᱞ ᱚᱠᱛᱚ ᱨᱮ, ᱩᱱᱤ ᱫᱚ ᱑᱐᱐ ᱢᱤᱴᱚᱨ ᱵᱚᱴᱚᱨᱯᱷᱞᱟᱭ ᱨᱮ ᱑:᱐᱕.᱒᱗ ᱴᱤᱯᱤᱡ ᱟᱨ ᱒᱐᱐ ᱢᱤᱴᱚᱨ ᱵᱚᱴᱚᱨᱯᱷᱞᱟᱭ ᱨᱮ ᱒:᱑᱙.᱖᱐ᱴᱤᱯᱤᱡ ᱨᱮᱱᱟᱜ ᱫᱚᱥᱟᱨ ᱨᱮᱠᱳᱨᱰ ᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱫᱼᱟ ᱾ ᱪᱚᱣᱫᱷᱚᱨᱤ ᱫᱚ ᱑᱙᱘᱙ ᱨᱮ ᱡᱤᱞᱤᱧ ᱥᱟᱺᱜᱤᱧ ᱨᱮᱱᱟᱜ ᱯᱟᱭᱨᱟᱜ ᱮ ᱮᱛᱚᱦᱚᱵ ᱠᱮᱫᱼᱟ ᱾ ᱟᱨ ᱚᱱᱟ ᱥᱮᱨᱢᱟ ᱜᱮ ᱤᱝᱞᱤᱥ ᱪᱟᱱᱮᱞ ᱦᱚᱸᱭ ᱯᱟᱨᱚᱢ ᱠᱮᱫᱼᱟ ᱾ ᱤᱱᱟᱹ ᱛᱛᱟᱭᱚᱢ ᱩᱱᱤ ᱫᱚ ᱑᱙᱙᱖ ᱨᱮ ᱘᱑ ᱠᱤ.ᱢᱤ. (᱕᱐ - ᱢᱤᱞ) ᱢᱩᱨᱥᱤᱫᱟᱵᱟᱫᱽ ᱡᱤᱞᱤᱧ ᱥᱟᱺᱜᱤᱧ ᱨᱮᱱᱟᱜ ᱯᱟᱭᱨᱟᱜ ᱮ ᱡᱤᱛᱠᱟᱹᱨ ᱮᱱᱟ ᱟᱨ ᱑᱙᱙᱙ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱫᱚᱦᱲᱟ ᱛᱮ ᱤᱝᱞᱤᱥ ᱪᱟᱱᱮᱞ ᱮ ᱯᱟᱨᱚᱢ ᱠᱮᱫᱼᱟ ᱾ ᱚᱜᱚᱥᱴ ᱒᱐᱐᱔ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱥᱩᱨ ᱥᱩᱯᱩᱨ ᱑᱔ ᱜᱷᱚᱱᱴᱟ ᱨᱮ ᱥᱨᱤᱞᱚᱝᱠᱟ ᱨᱮᱱᱟᱜ ᱛᱚᱞᱟᱭᱤᱢᱚᱱᱱᱟᱨ ᱠᱷᱚᱱ ᱛᱟᱢᱤᱞᱱᱟᱰᱩ ᱨᱮᱱᱟᱜ ᱫᱷᱚᱱᱩᱥᱠᱳᱰᱤ ᱫᱷᱟᱹᱵᱤᱡ ᱯᱟᱠ ᱥᱴᱨᱮᱴᱥ ᱨᱮ ᱯᱟᱭᱨᱟ ᱠᱟᱛᱮ ᱱᱚᱶᱟ ᱨᱮᱠᱳᱰ ᱫᱚᱭ ᱵᱮᱱᱟᱣ ᱞᱮᱫᱼᱟ ᱾" },
        { "cell": "sports-time", "text": "ᱥᱟᱸᱜᱮ ᱥᱟᱯᱟᱣ ᱚᱠᱛᱚ ᱑᱕ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ 00:00 AM ᱠᱷᱚᱱ ᱒᱐ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ 11:59:59 PM ᱫᱷᱟᱹᱵᱤᱡ ।" },
        { "cell": "sports-time", "text": "᱒᱐᱒᱒ ᱠᱚᱢᱚᱱᱣᱮᱞᱛᱷ ᱠᱷᱮᱞ ᱨᱮ ᱨᱟᱣᱛ ᱫᱚ ᱔᱐᱐ ᱢᱤᱴᱚᱨ ᱯᱷᱨᱤ ᱥᱴᱟᱭᱤᱞ ᱨᱮ ᱓.᱕᱗.᱔᱕ ᱚᱠᱛᱚ ᱛᱮ ᱯᱩᱨᱩᱱ ᱟᱱᱟᱜ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫᱼᱟ ᱾ ᱤᱱᱟᱹ ᱛᱟᱭᱚᱢ ᱫᱤᱱ ᱨᱮ ᱒᱐᱐ ᱢᱤᱴᱚᱨ ᱯᱷᱨᱤ ᱥᱴᱟᱭᱤᱞ ᱨᱮ, ᱩᱱᱤ ᱫᱚ ᱑.᱕᱔.᱕᱖ ᱴᱟᱲᱟᱝ ᱚᱠᱛᱚ ᱛᱮ ᱯᱮᱭᱟ ᱦᱤᱴ ᱨᱮ ᱘ ᱟᱱᱟᱜ ᱟᱨ ᱡᱚᱛᱚ ᱛᱮ ᱒᱕ ᱟᱱᱟᱜ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫᱼᱟ ᱾ ᱯᱮ ᱫᱤᱱ ᱛᱟᱭᱚᱢ, ᱩᱱᱤ ᱫᱚ ᱑᱕᱐᱗.᱗᱗ ᱢᱤᱴᱚᱨ ᱚᱠᱛᱚ ᱨᱮ ᱑᱕᱐᱗.᱗᱗ ᱢᱤᱴᱚᱨ ᱯᱷᱨᱤᱥᱴᱟᱭᱤᱞ ᱨᱮ ᱘ ᱟᱱᱟᱜ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫᱼᱟ ᱟᱨ ᱯᱷᱤᱱᱮᱞ ᱞᱟᱹᱜᱤᱫ ᱠᱣᱟᱞᱤᱯᱷᱟᱭ ᱞᱮᱫᱼᱟ ᱾ ᱑᱕:᱔᱒.᱖᱗ ᱚᱠᱛᱚ ᱨᱮ ᱢᱩᱪᱟᱹᱫ ᱠᱟᱛᱮ ᱩᱱᱤ ᱫᱚ ᱜᱮᱞ ᱟᱱᱟᱜ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫ-ᱟ ᱾" },
        { "cell": "sports-time", "text": "᱒᱐᱑᱖ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱡᱩᱞᱟᱭ ᱪᱟᱸᱫᱚ ᱨᱮ ᱟᱱᱚᱥ ᱫᱚ ᱥᱴᱮᱴᱤᱝ ᱴᱤᱢ ᱨᱮᱱ ᱢᱤᱫ ᱦᱚᱲ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱵᱮᱸᱜᱽᱞᱳᱨ ᱨᱮ ᱔×᱔᱐᱐ ᱢᱤᱴᱚᱨ ᱨᱮ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱨᱮᱠᱚᱨᱰ ᱮ ᱵᱚᱫᱚᱞ ᱞᱮᱫᱼᱟ ᱟᱨ ᱨᱤᱭᱳ ᱚᱞᱤᱢᱯᱤᱠ ᱞᱟᱹᱜᱤᱫ ᱠᱣᱟᱞᱤᱯᱷᱟᱭ ᱞᱮᱫᱼᱟ ᱾ ᱟᱱᱚᱥ, ᱠᱩᱸᱦᱩ ᱢᱩᱦᱟᱢᱢᱚᱫᱽ, ᱟᱭᱚᱥᱟᱢᱤ ᱫᱷᱟᱨᱚᱱ ᱟᱨ ᱟᱨᱚᱠᱤᱭᱟ ᱨᱟᱡᱤᱵᱽ ᱠᱚᱣᱟᱜ ᱠᱩᱣᱟᱨᱴᱮᱴ ᱫᱚ ᱓:᱐᱐:᱙᱑ ᱚᱠᱛᱚ ᱦᱟᱛᱟᱣ ᱞᱮᱫᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱛᱩᱨᱠᱤ ᱨᱮ ᱯᱩᱱ ᱦᱟᱯᱛᱟ ᱢᱟᱬᱟᱝ ᱨᱮ ᱮᱢ ᱟᱠᱟᱱ ᱓:᱐᱒:᱑᱗ ᱚᱠᱛᱚ ᱨᱮ ᱟᱡᱟᱜ ᱨᱤᱠᱚᱨᱰ ᱠᱚ ᱵᱷᱮᱡᱟᱨ ᱞᱮᱫᱟ ᱾ ᱱᱚᱶᱟ ᱦᱤᱥᱟᱹᱵᱽ ᱛᱮ ᱱᱩᱠᱩ ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮ ᱑᱓ ᱟᱱᱟᱜ ᱴᱷᱟᱶᱮ ᱦᱟᱢᱮᱴ ᱟᱠᱟᱫᱟ ᱾" },
        { "cell": "sports-time", "text": "ᱚᱵᱤᱱᱟᱥ ᱢᱩᱠᱩᱸᱫᱽ ᱥᱟᱵᱽᱞᱮ (ᱡᱟᱱᱟᱢ ᱑᱓ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ ᱑᱙᱙᱔) ᱫᱚ ᱢᱤᱫ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱴᱨᱟᱠ ᱮᱱᱰ ᱯᱷᱤᱞᱰ ᱟᱛᱷᱞᱮᱴ ᱠᱟᱱᱟᱭ ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱓᱐᱐᱐ ᱢᱤᱴᱚᱨ ᱥᱴᱤᱯᱞᱮᱪᱮᱥ ᱨᱮ ᱡᱤᱛᱠᱟᱹᱨᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱾ ᱩᱱᱤ ᱫᱚ ᱘:᱑᱑.᱒᱐ ᱨᱮᱱᱟᱜ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱨᱤᱠᱚᱨᱰ ᱮ ᱫᱚᱦᱚ ᱟᱠᱟᱫᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱒᱐᱒᱒ ᱠᱚᱢᱚᱱᱣᱮᱞᱛᱷ ᱠᱷᱮᱞᱚᱸᱰ ᱨᱮ ᱥᱤᱞᱵᱷᱚᱨ ᱢᱮᱰᱟᱞ ᱮ ᱡᱤᱛᱠᱟᱹᱨ ᱟᱠᱟᱫᱟ ᱾ ᱱᱩᱭ ᱫᱚ ᱛᱩᱨᱩᱭ ᱫᱷᱟᱣ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱨᱤᱠᱚᱨᱰ ᱮ ᱵᱮᱱᱟᱣ ᱠᱮᱜᱼᱟ ᱾" },
        { "cell": "sports-time", "text": "᱒᱐᱑᱗ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱡᱩᱞᱟᱭ ᱪᱟᱸᱫᱚ ᱨᱮ ᱮᱥᱤᱭᱟᱱ ᱟᱛᱷᱞᱮᱴᱤᱠᱥ ᱪᱟᱢᱯᱤᱭᱟᱱᱥᱤᱯ ᱨᱮ ᱔×᱔᱐᱐ ᱢᱤᱴᱚᱨ ᱨᱮᱞᱮ ᱴᱤᱢ ᱨᱮ ᱥᱤᱧᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱤᱱᱤᱡ ᱥᱚᱱᱟ ᱢᱮᱰᱟᱞ ᱡᱤᱛᱠᱟ.ᱨ ᱡᱮᱠᱳᱵᱽ, ᱠᱩᱱᱦᱩ ᱢᱚᱦᱚᱢᱚᱫᱽ, ᱟᱨᱳᱠᱤᱭᱟ ᱨᱟᱡᱤᱵᱽ ᱟᱨ ᱢᱚᱦᱚᱢᱚᱫᱽ ᱟᱱᱟᱥ ᱟᱜ ᱴᱤᱢ ᱫᱚ ᱮᱥᱤᱭᱟ ᱨᱮ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱱᱟᱯᱟᱭ ᱚᱠᱛᱚ ᱓:᱐᱒.᱙᱒ ᱨᱮ ᱦᱟᱛᱟᱣ ᱞᱮᱫᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱤᱣᱩᱞ ᱑᱙᱗᱕ ᱠᱷᱚᱱ ᱥᱤᱧᱚᱛ ᱨᱮ ᱯᱩᱭᱞᱩ ᱥᱚᱱᱟ ᱮ ᱮᱢᱟᱫᱟ ᱾ ᱱᱚᱶᱟ ᱦᱮᱯᱨᱟᱣ ᱥᱟᱶᱛᱮ ᱒᱐᱑᱗ ᱥᱮᱨᱢᱟ ᱨᱮᱱᱟᱜ ᱚᱜᱚᱥᱴᱚ ᱨᱮ ᱟᱛᱷᱞᱮᱴᱤᱠᱥ ᱡᱮᱜᱮᱛ ᱪᱟᱢᱯᱤᱭᱟᱱᱥᱤᱯ ᱨᱮ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱖ ᱟᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱱᱟᱯᱟᱭ ᱚᱠᱛᱚ ᱥᱟᱶᱛᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟᱭ ᱾ ᱩᱱᱤ ᱫᱚ ᱒᱐᱒᱐ ᱴᱳᱠᱤᱭᱳ ᱚᱞᱤᱢᱯᱤᱠ ᱨᱮ ᱠᱚᱲᱟ ᱔x᱔᱐᱐ ᱢᱤᱴᱚᱨ ᱨᱮᱞᱮ ᱦᱮᱯᱨᱟᱣ ᱨᱮ ᱠᱚ ᱦᱮᱯᱨᱟᱣ ᱞᱮᱫᱼᱟ ᱡᱟᱦᱟᱸ ᱨᱮ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱴᱤᱢ ᱮᱥᱤᱭᱟᱱ ᱟᱨ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱨᱮᱠᱳᱨᱰ ᱠᱚ ᱵᱚᱫᱚᱞ ᱞᱮᱫᱼᱟ ᱟᱨ ᱓.᱐᱐.᱒᱕ ᱚᱠᱛᱚ ᱠᱚ ᱦᱟᱛᱟᱣ ᱞᱮᱫᱼᱟ ᱾" },
        { "cell": "version-dot", "text": "ᱡᱟᱹᱢᱢᱩ ᱫᱚ ᱡᱟᱹᱢᱢᱩ ᱟᱨ ᱠᱟᱹᱥᱢᱤᱨ ᱨᱮᱭᱟᱜ ᱨᱟᱵᱟᱝ ᱨᱟᱡᱽᱜᱟᱲ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱛᱟᱞᱢᱟ ᱥᱟᱥᱚᱱᱮᱫ ᱮᱞᱟᱠᱟ ᱨᱮᱭᱟᱜ ᱡᱟᱹᱢᱢᱩ ᱦᱚᱱᱚᱛ ᱨᱟᱭᱟᱜ ᱦᱮᱰᱠᱩᱣᱟᱴᱚᱨ ᱟᱨ ᱢᱟᱨᱟᱝ ᱥᱚᱦᱚᱨ ᱠᱟᱱᱟ ᱾ ᱛᱟᱣᱤ ᱜᱟᱰᱟ ᱫᱷᱟᱨᱮ ᱨᱮ ᱢᱮᱱᱟᱜ ᱱᱚᱣᱟ ᱥᱚᱦᱚᱨ ᱨᱮᱭᱟᱜ ᱮᱨᱤᱭᱟ ᱫᱚ ᱒᱖.᱖᱔km² ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱠᱚᱧᱮ ᱨᱮᱫᱚ ᱦᱮᱢᱟᱞ ᱵᱩᱨᱩ ᱟᱨ ᱮᱛᱚᱢ ᱨᱮᱫᱚ ᱥᱚᱢᱟᱱ ᱚᱛ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱡᱟᱹᱢᱢᱩ ᱨᱮᱫᱚ ᱡᱟᱹᱢᱢᱩ ᱠᱟᱹᱥᱢᱤᱨ ᱮᱞᱟᱠᱟ ᱨᱮᱱᱟᱜ ᱫᱚᱥᱟᱨ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱦᱤᱱᱫᱩ ᱫᱷᱚᱨᱚᱢ ᱨᱮᱭᱟᱜ ᱯᱩᱱᱟᱹᱭ ᱛᱷᱟᱱ ᱱᱚᱰᱮ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱢᱮᱱᱟᱜ ᱠᱷᱟᱹᱛᱤᱨ ᱟᱹᱰᱤ ᱦᱚᱲ ᱱᱚᱣᱟ ᱵᱟᱡᱟᱨ ᱫᱚᱠᱚ ᱦᱤᱨᱤᱭᱟ ᱾ ᱱᱚᱣᱟ ᱦᱚᱱᱚᱛ ᱫᱚ ᱥᱟᱢᱵᱟ ᱦᱚᱱᱚᱛ ᱥᱟᱶ ᱵᱷᱤᱲᱟᱹᱣ ᱜᱮᱭᱟ ᱾" },
        { "cell": "version-dot", "text": "ᱱᱤᱭᱟᱹ ᱠᱳᱦᱞᱟᱯᱩᱨ ᱦᱚᱱᱚᱛ ᱨᱮ ᱥᱟᱭ ᱠᱟᱲᱟ ᱘᱗.᱒% ᱦᱤᱸᱥ ᱛᱟᱸᱦᱟᱸ ᱓,᱓᱗᱙,᱙᱐᱖ ᱦᱚᱲ ᱫᱚ ᱦᱤᱱᱫᱩ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱯᱟᱧᱡᱟᱭᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱗.᱓᱙ᱦᱤᱸᱦ ᱛᱟᱸᱦᱟᱸ ᱒᱘᱔,᱕᱕᱘ ᱦᱚᱲ ᱫᱚ ᱤᱥᱞᱟᱢ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱯᱟᱧᱡᱟᱭᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱔% ᱦᱤᱸᱥ ᱛᱟᱦᱟᱸ ᱑᱕᱔,᱘᱘᱒ ᱦᱚᱲ ᱫᱚ ᱡᱚᱭᱱ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱯᱟᱧᱡᱟᱭᱣᱮᱝᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱐.᱗᱗ ᱦᱤᱸᱥ ᱛᱟᱸᱦᱟᱸ ᱦᱚᱲ ᱫᱚ ᱒᱙,᱗᱖᱖ ᱦᱚᱲ ᱫᱚ ᱵᱚᱣᱫᱷ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱯᱟᱧᱡᱟᱭᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱐.᱔% ᱦᱤᱸᱥ ᱛᱟᱦᱮᱸ ᱑᱕,᱕᱗᱓ ᱦᱚᱲ ᱫᱚ ᱠᱨᱤᱥᱴᱟᱱ ᱫᱷᱤᱨᱚᱢ ᱠᱚ ᱯᱟᱧᱡᱟᱭᱮᱫᱟ," },
        { "cell": "version-dot", "text": "ᱥᱤᱧᱚᱛ ᱨᱮ ᱚᱫᱷᱤᱠᱚᱨᱤᱠ ᱟᱢᱫᱟᱡᱽ ᱞᱮᱠᱟᱛᱮ, ᱒᱖ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱒᱐᱐᱔ ᱦᱤᱞᱚᱜ ᱠᱚᱧᱮ ᱟᱲᱮ ᱨᱮ ᱤᱱᱰᱚᱱᱮᱥ ᱤᱱᱰᱚᱱᱮᱥᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱥᱩᱢᱟᱛᱨᱟ ᱫᱽᱣᱤᱯ ᱥᱩᱨ ᱨᱮ ᱒᱐᱐᱔ ᱥᱤᱧᱚᱛ ᱢᱚᱦᱟᱥᱟᱜᱚᱨ ᱨᱮ ᱦᱮᱡ ᱞᱮᱱ ᱚᱛ ᱦᱤᱞᱟᱹᱣᱜ ᱠᱷᱚᱱ ᱥᱩᱱᱟᱢᱤ ᱠᱟᱨᱚᱱ ᱛᱮ ᱑᱐,᱑᱓᱖ ᱦᱚᱲ ᱠᱚ ᱜᱚᱡ ᱞᱮᱱᱟ ᱟᱨ ᱥᱟᱭ ᱦᱚᱲ ᱠᱚ ᱵᱷᱮᱜᱟᱨ ᱞᱮᱱᱟ ᱾ ᱫᱷᱟᱹᱨᱛᱤ ᱦᱤᱞᱟᱹᱣᱜ ᱨᱮᱱᱟᱜ ᱥᱚᱫᱚᱨ ᱙.᱑ᱼ᱙.᱓ Mw ᱢᱮᱱᱟᱜ ᱟ ᱟᱨ ᱥᱟᱱᱟᱢ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱢᱚᱬᱮ ᱥᱟᱛᱟᱵᱟᱫᱤ (five decad) ᱠᱷᱚᱱ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "version-dot", "text": "ᱢᱚᱥᱚᱡᱤᱫ ᱨᱟᱪᱟ ᱨᱮ ᱵᱚᱞᱚᱜ ᱡᱠᱷᱟᱣ ᱟ.ᱰᱤ ᱱᱟᱯᱟᱭ ᱰᱟᱦᱟᱨ ᱢᱮᱱᱟᱜ-ᱟ᱾ ᱵᱟᱨᱦᱮ ᱥᱮ ᱯᱟᱛᱷᱚᱨ ᱛᱮ ᱯᱚᱴᱚᱢ ᱟᱨ ᱒.᱔ᱢᱤᱴᱟᱨ ᱪᱚᱣᱲᱟ ᱟᱨ ᱩᱥᱩᱞ ᱗.᱖ ᱢᱤᱴᱟᱨ᱾ᱛᱳᱨᱚᱱ ᱯᱩᱨᱵ ᱥᱮ ᱵᱟᱨᱟᱭᱟ ᱛᱚᱯᱟ ᱢᱮᱱᱟᱜ-ᱟ᱾ᱛᱵᱮ ᱚᱱᱟ ᱛᱚᱯᱟ ᱚᱠᱚᱭᱟ ᱠᱟᱱᱟ ᱵᱟᱝ ᱵᱟᱰᱟᱭ ᱠᱟᱱᱟ᱾" },
        { "cell": "version-dot", "text": "ᱱᱚᱣᱟ ᱵᱤᱦᱟᱨ ᱨᱮᱱᱟᱜ ᱯᱩᱨᱵ ᱯᱟᱪᱷᱤᱢ ᱥᱮ ᱖᱕.᱒᱓ ᱢᱤᱴᱟᱨ ᱟᱨ ᱩᱛᱟᱨ ᱫᱟᱠᱷᱤᱱᱚ ᱥᱮ ᱖᱔.᱑᱑ᱢᱤᱴᱟᱨ ᱾ᱵᱤᱦᱟᱨ ᱨᱮᱱᱟᱜ ᱩᱛᱟᱹᱨ ᱫᱟᱠᱷᱤᱱᱚ ᱥᱮ ᱫᱚ ᱞᱟᱴᱩ ᱜᱤᱭᱟ᱾ ᱵᱷᱤᱛᱨᱤ ᱥᱮ ᱵᱟᱞᱟᱝ ᱞᱟᱜᱤᱛ ᱛᱮ ᱟ.ᱰᱤ ᱱᱟᱯᱟᱭ ᱫᱩᱣᱟᱹᱨ ᱢᱮᱱᱟᱜ-ᱟ᱾ ᱯᱩᱨᱵ ᱥᱮ ᱩᱛᱟᱹᱨ ᱥᱮᱱᱟ ᱫᱮᱣᱟᱞ ᱥᱮ ᱢᱤᱫᱴᱟᱝ ᱵᱚᱞᱚᱜ ᱫᱩᱣᱟᱹᱨ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "version-dot", "text": "ᱵᱤᱦᱟᱨ ᱨᱮ ᱔᱑ ᱴᱤ ᱚᱲᱟᱜ, ᱩᱛᱟᱹᱨ ᱫᱚ ᱘ᱴᱤ,ᱟᱨ ᱮᱴᱟᱜ ᱥᱮ ᱑᱑ ᱴᱤ ᱚᱲᱟᱜ ᱢᱮᱱᱟᱜ-ᱟ᱾ᱚᱱᱟ ᱚᱲᱟᱜ ᱠᱚ (᱓.᱖᱖ ᱢᱤᱴᱟᱨ×᱓.᱓᱕ᱢᱤᱴᱟᱨ)᱾ᱚᱱᱟ ᱚᱲᱟᱜ ᱨᱮᱱᱟᱜ ᱛᱟᱭᱱᱚᱢ ᱫᱮᱣᱟᱞ ᱥᱮ ᱠᱩᱞᱩᱝᱜᱤ ᱛᱟᱦᱮᱠᱟᱱᱟ ᱟᱨ ᱚᱱᱟ ᱟᱢᱟᱜ ᱠᱚ ᱫᱮᱣᱟᱞ ᱛᱮ ᱵᱷᱟᱜ ᱛᱟᱦᱮᱠᱟᱱᱟ᱾ᱫᱮᱣᱟᱞ ᱢᱳᱴᱟ ᱛᱟᱦᱮᱠᱟᱱᱟ ᱙.᱑ ᱢᱤᱴᱟᱨ ᱠᱷᱚᱱ ᱑.᱒᱒ ᱢᱤᱴᱟᱨ ᱟᱨ ᱛᱟᱭᱱᱚᱢ ᱫᱮᱣᱟᱞ ᱒.᱕᱙ ᱢᱤᱴᱟᱨ᱾ᱛᱵᱮ ᱞᱟᱦᱟ ᱨᱮᱱᱟᱜ ᱫᱮᱣᱟᱞ ᱢᱳᱴᱟ ᱛᱟᱦᱮᱠᱟᱱᱟ ᱑.᱐᱗ ᱢᱤᱴᱟᱨ᱾" },
        { "cell": "version-dot", "text": "ᱠᱟᱴᱳᱣᱟ ᱨᱮᱭᱟᱜ ᱴᱷᱟᱹᱣᱠᱟᱹ ᱫᱚ ᱒᱓.᱖᱕°N ᱘᱘.᱑᱓E᱾ ᱫᱟᱲᱮᱭᱟ ᱟᱴᱮᱫ ᱠᱷᱚᱱ ᱱᱚᱰᱮ ᱱᱟᱜ ᱜᱚᱲᱯᱚᱲᱛᱟ ᱩᱥᱩᱞ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱒᱑ ᱢᱤᱴᱟᱨ (᱖᱙ ᱯᱷᱩᱴ)᱾ ᱠᱟᱴᱳᱣᱟ ᱥᱟᱦᱟᱨ ᱦᱩᱜᱽᱞᱤ ᱜᱟᱰᱟ ᱟᱨ ᱚᱡᱚᱭ ᱜᱟᱰᱟ ᱢᱮᱥᱟᱞ ᱴᱷᱮᱱ ᱢᱮᱱᱟᱜ ᱟᱠᱟᱫ ᱛᱮ ᱥᱟᱦᱟᱨ ᱨᱮᱭᱟᱜ ᱥᱟᱢᱟᱝ, ᱯᱟᱪᱮ ᱟᱨ ᱮᱛᱚᱢ ᱥᱮᱫ ᱫᱟᱜ ᱛᱮ ᱮᱥᱮᱫ ᱢᱮᱱᱟᱜ-ᱟ᱾" },
        { "cell": "version-dot", "text": "ᱱᱟᱱᱩᱨ ᱨᱮᱭᱟᱜ ᱞᱳᱠᱮᱥᱟᱱ ᱫᱚ ᱒᱓.᱗᱐°N ᱘᱗.᱘᱖E᱾ ᱫᱚᱨᱭᱟ ᱟᱴᱮᱫ ᱠᱷᱚᱱ ᱱᱚᱰᱮᱱᱟᱜ ᱩᱥᱩᱞ ᱒᱔ ᱢᱤᱴᱟᱨ (᱗᱙ ᱯᱷᱩᱴ)᱾" },
        { "cell": "quote-letter", "text": "ᱯᱮ ᱜᱮᱞ ᱜᱚᱴᱟᱝ ᱪᱤᱠᱤ ᱠᱚ ᱢᱩᱹᱫᱽ ᱨᱮ \"ᱚ\" ᱫᱚ ᱯᱩᱭᱞᱩ ᱪᱤᱠᱤ ᱠᱟᱱᱟ ᱟᱨ ᱯᱩᱭᱞᱩ ᱨᱟᱦᱟ ᱟᱲᱟᱝ ᱪᱤᱠᱤ ᱦᱚᱸ ᱠᱟᱱᱟ ᱾ ᱚ ᱞᱮᱠᱟ ᱟᱲᱟᱝ ᱚᱜ ᱟᱹᱲᱟᱹ ᱠᱚᱫᱚ ᱚᱱᱟᱨᱮ 'ᱚ' ᱨᱮᱭᱟᱜ ᱡᱟᱯᱟᱜ ᱵᱮᱜᱚᱨ ᱚᱦᱚ ᱜᱮ ᱟᱲᱟᱝ ᱜᱟᱱ ᱠᱚᱜᱼᱟ ᱾" },
        { "cell": "quote-letter", "text": "᱑᱔ ᱵᱤᱥᱤ ᱨᱮ ᱱᱩᱭᱟᱜ ᱯᱩᱭᱞᱩ ᱜᱟᱞᱟᱝ ᱜᱟᱵᱟᱱ ᱫᱚ \"ᱚᱢᱳᱨᱮᱥ\" ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱱᱚᱣᱟᱨᱮ ᱫᱚ ᱩᱱᱤ ᱢᱤᱫ ᱢᱚᱱ ᱜᱟᱵᱟᱱ ᱫᱩᱞᱟᱹᱲᱤᱭᱟᱹ ᱠᱳᱨᱤᱱᱱ ᱞᱟᱹᱜᱤᱫ ᱟᱡᱟᱜ ᱨᱤᱫᱟᱹᱭ ᱨᱮᱭᱟᱜ ᱫᱩᱞᱟᱹᱲ ᱦᱩᱫᱤᱥ ᱚᱱᱚᱬᱦᱮ ᱨᱮᱭᱟᱜ ᱨᱩᱯ ᱮ ᱪᱟᱞ ᱟᱠᱟᱣᱟᱫᱼᱟ ᱾ ᱯᱩᱭᱞᱩ ᱫᱚ ᱱᱚᱣᱟ ᱨᱮᱭᱟᱜ ᱢᱚᱬᱮ ᱦᱟᱹᱴᱤᱧ ᱯᱚᱛᱚᱵ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱫᱩᱥᱨᱟᱹ ᱫᱷᱟᱣ ᱫᱚ ᱯᱚᱛᱚᱵ ᱨᱮᱭᱟᱜ ᱦᱟᱹᱴᱤᱧ ᱠᱷᱟᱴᱚ ᱠᱟᱛᱮ ᱯᱮᱭᱟ ᱨᱮ ᱫᱚᱦᱚ ᱦᱩᱭ ᱮᱱᱟ ᱾ ᱵᱮᱱᱟᱣ ᱛᱟᱭᱚᱢ ᱠᱷᱚᱱ ᱜᱮ ᱱᱚᱣᱟ ᱯᱚᱛᱚᱵ ᱨᱤᱱᱤᱡ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱦᱟᱜ ᱧᱩᱛᱩᱢ ᱯᱩᱨᱟᱹ ᱨᱳᱢ ᱨᱮ ᱯᱟᱥᱱᱟᱣ ᱮᱱᱟ ᱾ ᱱᱚᱣᱟ ᱚᱠᱛᱚ ᱨᱮᱭᱟᱜ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱨᱮᱜᱮ \"ᱢᱤᱰᱤᱭᱟ\" ᱧᱩᱛᱩᱢᱟᱱ ᱴᱨᱮᱡᱮᱰᱤ ᱦᱚᱸᱭ ᱜᱟᱞᱟᱝ ᱜᱟᱵᱟᱱ ᱠᱮᱜᱼᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱛᱮᱦᱮᱧ ᱜᱟᱯᱟ ᱱᱚᱣᱟ ᱜᱟᱭᱟᱱ ᱨᱮᱭᱟᱜ ᱫᱚ ᱛᱤᱱᱟᱹᱝ ᱜᱟᱱ ᱥᱟᱦᱴᱟ ᱜᱮ ᱧᱮᱞ ᱧᱟᱢᱚᱜ ᱠᱟᱱᱟ ᱾ ᱤᱱᱟᱹ ᱛᱟᱭᱚᱢ ᱩᱱᱤ ᱵᱤᱨᱟᱝᱜᱳᱱᱟᱳ ᱠᱚᱣᱟᱜ ᱫᱩᱞᱟᱹᱲ ᱥᱟᱠᱟᱢ ᱮ ᱚᱞ-ᱛᱚᱞ ᱠᱮᱜᱼᱟ ᱡᱟᱦᱟᱸ ᱨᱮᱭᱟᱜ ᱯᱟᱨᱥᱟᱞ ᱫᱚ \"ᱦᱟᱨᱟᱭᱤᱫᱮᱥ\" ᱧᱩᱛᱩᱢ ᱛᱮ ᱩᱪᱷᱟᱹᱱ ᱮᱱᱟ ᱾ ᱡᱚᱛᱚ ᱥᱟᱠᱟᱢ ᱨᱮᱭᱟᱜ ᱜᱩᱸᱴ ᱫᱚ ᱒᱑ ᱜᱟᱴᱟᱝᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱢᱩᱬ ᱞᱮᱠᱟ ᱛᱮᱫᱚ ᱱᱚᱣᱟ ᱥᱟᱠᱟᱢ ᱨᱮᱭᱟᱜ ᱮᱞᱮᱞ ᱫᱚ ᱱᱚᱣᱟ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱚᱸᱜᱤᱭ ᱚᱱᱚᱬᱦᱤᱭᱟᱹ ᱢᱟᱭᱠᱮᱞ ᱢᱚᱫᱷᱩᱥᱩᱫᱚᱱ ᱫᱚᱛ ᱫᱚ ᱱᱚᱣᱟ ᱜᱟᱞᱟᱝ ᱜᱟᱵᱟᱱ ᱧᱮᱞ ᱠᱟᱛᱮ ᱵᱤᱨᱟᱝᱜᱚᱱᱟ ᱧᱩᱛᱩᱢᱟᱱ ᱯᱩᱛᱷᱤᱭ ᱚᱞ-ᱛᱚᱞ ᱠᱮᱜᱼᱟ ᱾ ᱚᱵᱷᱤᱰ ᱤᱡ ᱡᱚᱴᱟᱣ ᱟᱣᱞᱩᱥ ᱥᱟᱵᱤᱱᱩᱥ ᱫᱚ ᱱᱚᱣᱟ ᱥᱟᱠᱟᱢ ᱨᱮᱭᱟᱜ ᱞᱟᱹᱱᱟᱹᱭ ᱚᱞ ᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱜᱼᱟ ᱾ᱥᱟᱵᱤᱱᱩᱥ ᱟᱜ ᱦᱚᱸ ᱯᱮᱭᱟ ᱥᱟᱠᱟᱢ ᱧᱟᱢᱚᱜᱼᱟ ᱾ ᱒ ᱵᱤᱥᱤ ᱨᱮ ᱚᱵᱷᱤᱰ ᱟᱜ ᱫᱩᱞᱟᱹᱲ ᱥᱟᱹᱜᱟᱹᱭ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱱᱟᱯᱟᱭ ᱜᱟᱞᱟᱝ ᱜᱟᱵᱟᱱ 'ᱟᱨᱥ ᱚᱢᱟᱛᱳᱨᱤᱭᱟ' (ᱫᱩᱞᱟᱹᱲ ᱨᱤᱱᱤᱡ ᱵᱟᱰᱚᱦᱤ) ᱠᱟᱱᱟ ᱾" },
        { "cell": "quote-letter", "text": "'ᱛᱳᱢᱤᱥ' ᱨᱮ ᱚᱱᱚᱬᱦᱤᱭᱟᱹ ᱦᱟᱜ ᱡᱤᱭᱚᱱ ᱟᱹᱰᱤ ᱫᱩᱠᱷᱟᱹᱞᱤ ᱜᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱸᱰᱮ ᱩᱱᱤ ᱡᱟᱦᱟᱸ ᱚᱱᱚᱬᱦᱮ ᱥᱟᱦᱴᱟᱭ ᱚᱞ ᱠᱮᱜᱼᱟ, ᱚᱱᱟᱨᱮ ᱟᱡᱟᱜ ᱫᱮᱥ ᱵᱟᱦᱮᱨ ᱛᱷᱩᱠᱟᱹᱢ ᱞᱟᱹᱜᱤᱫ ᱱᱮᱦᱚᱨ ᱵᱟᱝ ᱞᱟᱹᱞᱩᱜᱼᱟ ᱛᱤᱱᱟᱹ ᱜ ᱞᱟᱪᱷᱟ ᱨᱮ ᱛᱤᱱᱟᱹᱜ ᱫᱷᱟᱣ ᱟᱨ ᱛᱤᱱᱟᱹᱜ ᱨᱚᱠᱚᱢ ᱛᱮᱭ ᱚᱞ ᱞᱮᱜᱼᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱚᱱᱟ ᱨᱮᱭᱟᱜ ᱚᱨᱡᱚ ᱪᱮᱫ ᱦᱚᱸ ᱵᱟᱝ ᱚᱰᱚᱠ ᱞᱮᱱᱟ ᱾ ᱚᱜᱚᱥᱛᱤ ᱛᱟᱭᱚᱢ ᱴᱤᱵᱚᱨᱤᱳᱥ ᱥᱚᱢᱨᱟᱴ ᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱤᱠᱷᱟᱹᱱ ᱩᱱᱤ ᱦᱚᱸ ᱚᱵᱷᱤᱰ ᱟᱜ ᱢᱤᱫ ᱠᱟᱛᱷᱟ ᱦᱚᱸ ᱵᱟᱭ ᱟᱸᱡᱚᱢ ᱞᱮᱜᱼᱟ ᱾ ᱢᱩᱪᱟᱹᱫ ᱨᱮ ᱚᱸᱰᱮ ᱜᱮ ᱑᱗ ᱵᱟᱝ ᱑᱘ ᱵᱤᱥᱤ ᱨᱮ ᱟᱡᱟᱜ ᱡᱤᱭᱚᱱ ᱵᱟᱹᱛᱤ ᱦᱚᱸ ᱤᱬᱤᱡ ᱮᱱᱟ ᱾ ᱛᱳᱢᱤᱥ ᱠᱷᱚᱱ ᱩᱱᱤ ᱡᱟᱦᱟᱸ ᱚᱱᱚᱬᱦᱮ ᱞᱟᱪᱷᱟ ᱮ ᱚᱞ ᱞᱮᱜᱼᱟ ᱚᱱᱟ ᱨᱮᱭᱟᱜ ᱛᱩᱢᱟᱹᱞ ᱫᱚ \"ᱛᱤᱥᱛᱤᱭᱟ\" ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱚᱵᱷᱤᱰ ᱟᱜ ᱦᱟᱯᱲᱟᱜ \"ᱢᱮᱜᱷᱫᱩᱛ\" ᱢᱮᱱᱛᱮ ᱦᱚᱸ ᱢᱮᱱ ᱜᱟᱱᱚᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱞᱟᱪᱷᱟ ᱨᱮᱫᱚ ᱚᱱᱚᱬᱦᱤᱭᱟᱹ ᱦᱟᱜ ᱦᱟᱨᱠᱮᱛ ᱜᱟᱞᱟᱝ ᱜᱟᱵᱟᱱ ᱠᱟᱛᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱡᱟᱦᱟᱸ ᱞᱟᱪᱷᱟ ᱩᱱᱤ ᱟᱡ ᱨᱤᱱ ᱮᱨᱟ ᱟᱨ ᱜᱤᱫᱽᱨᱟᱹ ᱞᱟᱹᱜᱤᱫ ᱮ ᱚᱞ ᱟᱠᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱫᱟᱭᱟ ᱫᱩᱞᱟᱹᱲ ᱛᱮ ᱯᱮᱨᱮᱡ ᱥᱟᱨᱮᱲ ᱟᱠᱟᱱᱟ ᱾ ᱟᱨ ᱢᱤᱫ ᱞᱟᱪᱷᱟ ᱛᱩᱢᱟᱹᱞ ᱫᱚ 'Epistula Ax Potato' ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ ᱾ ᱞᱟᱸᱜᱟ ᱚᱱᱚᱬᱦᱤᱭᱟᱹ ᱫᱚ \"ᱤᱵᱤᱥ\" ᱧᱩᱛᱩᱢᱟᱱ ᱢᱤᱫ ᱚᱵᱷᱤᱥᱟᱯ ᱦᱚᱸᱭ ᱚᱞ ᱟᱠᱟᱜᱼᱟ ᱾ ᱡᱟᱦᱟᱸᱨᱮ ᱩᱱᱤ ᱢᱤᱫ ᱵᱟᱝ ᱧᱩᱛᱩᱢ ᱵᱟᱹᱭᱨᱤ ᱚᱵᱷᱤᱥᱟᱯ ᱮ ᱮᱢᱟ ᱠᱟᱣᱟ ᱫᱮᱭᱟ ᱾ ᱱᱚᱣᱟ ᱥᱟᱶᱼᱥᱟᱶᱛᱮ ᱩᱱᱤ ᱟᱨ ᱵᱟᱨᱭᱟ ᱠᱷᱟᱴᱚ ᱯᱩᱛᱷᱤ ᱦᱟᱹᱠᱩ ᱟᱨ ᱚᱠᱷᱨᱳᱴ ᱪᱮᱛᱟᱱ ᱨᱮ Haliyutika 'and' Nook ᱧᱩᱛᱩᱢ ᱛᱮᱭ ᱚᱞ ᱞᱮᱜᱼᱟ ᱾ ᱚᱵᱷᱤᱰ ᱟᱜ ᱟᱹᱰᱤᱜᱟᱱ ᱚᱞᱼᱵᱮᱞ ᱫᱚ ᱛᱮᱦᱮᱧ ᱜᱟᱯᱟ ᱢᱟᱞᱚᱴ ᱩᱛᱟᱹᱨ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "quote-letter", "text": "ᱛ () ᱫᱚ ᱚᱞ ᱪᱤᱠᱤ ᱨᱮᱭᱟᱜ ᱫᱚᱥᱟᱨ ᱟᱠᱷᱚᱨ ᱟᱨᱵᱟᱝ ᱪᱤᱠᱤ ᱠᱟᱱᱟ ᱟᱨ ᱯᱩᱭᱞᱩ ᱠᱮᱪᱮᱫ ᱟᱲᱟᱝ (en:consonant) ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱥᱟᱰᱮ ᱟᱡ ᱥᱩᱢᱩᱝ ᱫᱚ ᱵᱟᱝ ᱨᱟᱠᱟᱵᱼᱟ, ᱟᱡᱟᱜ ᱥᱟᱰᱮ ᱨᱟᱠᱟᱵ ᱚᱪᱚᱭ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱠᱷᱟᱱ ᱢᱟᱬᱟᱝ ᱨᱮ ᱚ ᱞᱟᱜᱟᱣ ᱠᱟᱛᱮ ᱞᱟᱹᱭ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱚ ᱚᱪᱚᱜ ᱠᱟᱛᱮ ᱡᱟᱦᱟᱸ ᱥᱟᱨᱮᱡᱚᱜ ᱠᱟᱱᱟ ᱚᱱᱟ ᱜᱮ ᱟᱡᱟᱜ ᱢᱩᱬ ᱨᱩᱯ ᱫᱚ ᱾ 'ᱚᱛ' ᱨᱮᱭᱟᱜ ᱜᱩᱞᱟᱹᱭ ᱨᱩᱯ ᱠᱷᱚᱱ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱨᱩᱯ ᱫᱚ ᱟᱹᱜᱩ ᱟᱠᱟᱱᱟ ᱾" },
        { "cell": "quote-letter", "text": "ᱜᱩᱞᱟᱹᱯ ᱵᱟᱦᱟ ᱫᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱩᱥᱩᱞ ᱫᱚ ᱱᱟᱯ ᱟᱹᱰᱤ ᱢᱩᱥᱠᱤᱞ ᱜᱮᱭᱟ ᱾ ᱦᱩᱰᱤᱧ ᱠᱷᱚᱱ ᱮᱦᱚᱵ ᱠᱟᱛᱮ ᱮᱭᱟᱭ ᱯᱷᱩᱴ ᱩᱥᱩᱞ ᱦᱟᱹᱵᱤᱡ ᱫᱟᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱫᱟᱨᱮᱱᱟᱹᱬᱤ ᱥᱟᱬᱮᱥ ᱨᱮ ᱜᱩᱞᱟᱹᱯ ᱫᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱨᱩᱯ ᱮᱢᱟᱱ ᱠᱟᱛᱷᱟ ᱟᱭᱢᱟ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱜᱩᱞᱟᱹᱯ ᱫᱟᱨᱮ ᱨᱮᱱᱟᱜ ᱥᱟᱠᱟᱢ ᱫᱚ ᱕ ᱠᱷᱚᱱ ᱑᱕ ᱥᱮᱢᱤ ᱜᱟᱱ ᱡᱤᱞᱤᱧ ᱦᱩᱭᱩᱜ-ᱟ ᱾ ᱜᱩᱞᱟᱹᱯ ᱵᱟᱦᱟ ᱜᱟᱨᱮ ᱨᱮᱢᱟᱜ ᱥᱟᱠᱟᱢ ᱫᱚ ᱴᱷᱟᱰᱜᱟᱜ ᱜᱮᱭᱟ ᱾ ᱡᱚᱛᱚ ᱜᱩᱞᱟᱹᱯ ᱵᱟᱦᱟ ᱨᱮᱱᱟᱜ ᱤᱞ (petal) ᱫᱚ ᱢᱚᱬᱮ ᱜᱚᱴᱟᱝ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ, ᱢᱮᱱᱠᱷᱟᱱ 'ᱨᱚᱡᱟ ᱥᱮᱨᱤᱥᱤᱭᱟ' ᱡᱟᱹᱛ ᱨᱮᱱᱟᱜ ᱵᱟᱦᱟ ᱨᱮ ᱫᱚ ᱔ ᱜᱚᱴᱟᱝ ᱜᱮ ᱤᱞ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱜᱩᱞᱟᱹᱯ ᱵᱟᱦᱟ ᱨᱮᱱᱟᱜ ᱡᱚ ᱫᱚ ᱫᱟᱨᱮᱱᱟᱹᱬᱤ ᱥᱟᱬᱮᱥ ᱞᱮᱠᱟᱛᱮ \"ᱨᱚᱡᱽ ᱦᱤᱯ\" ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱡᱚᱛᱚ ᱨᱚᱡᱽ ᱦᱤᱯ ᱨᱮᱱᱟᱜ ᱵᱷᱤᱛᱟᱹᱨ ᱯᱟᱦᱴᱟ ᱨᱮ ᱫᱟᱹᱨᱭᱟᱹ ᱡᱤᱞ ᱟᱴᱮᱫ ᱠᱚᱜ-ᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱦᱤᱯᱟᱛᱷᱤᱭᱚᱢ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱜᱩᱞᱟᱹᱯ ᱫᱟᱨᱮ ᱫᱚ ᱡᱟᱹᱱᱩᱢ ᱡᱟᱹᱱᱩᱢ ᱜᱮᱭᱟ ᱟᱨ ᱚᱱᱟ ᱡᱟᱹᱱᱩᱢ ᱠᱚ ᱫᱚ ᱜᱚᱡᱟᱜ ᱟᱨ ᱡᱤᱞᱤᱧ ᱡᱤᱞᱤᱧ ᱜᱮᱭᱟ ᱾ ᱰᱟᱺᱜᱽᱨᱤ ᱢᱮᱨᱚᱢ ᱠᱷᱚᱱ ᱚᱱᱟᱛᱮ ᱱᱚᱣᱟ ᱫᱚ ᱵᱟᱧᱪᱟᱣ ᱨᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾" },
        { "cell": "quote-letter", "text": "ᱛᱟᱞᱟ ᱨᱮ 'ᱫᱤᱞᱞᱤ' ᱵᱟ.ᱨᱛᱟ ᱦᱩᱤᱞᱤᱱᱟ ᱾ ᱥᱚ•ᱭᱩᱛᱛᱚ (Unity) ᱡᱚᱱᱚ-ᱟ.ᱱᱫᱚᱞᱚᱱ ᱠᱷᱚᱱ ᱜᱤ 'ᱨᱟᱡᱟ ᱜᱭᱟ.ᱱᱮᱫᱨᱚ ᱥᱟᱦ' ᱟᱭᱟ" },
        { "cell": "quote-letter", "text": "ᱜᱚᱴᱷᱚᱱ ᱥᱚ•ᱥᱚᱫ ᱨᱮ 'ᱥᱚ•ᱵᱤᱫᱷᱚᱱ-ᱥᱚᱵᱷᱟ' ᱵᱮᱱᱟ ᱞᱟᱦᱟ ᱜᱤ ᱜᱚᱬᱚᱛᱚᱱᱛᱨᱚ ᱛᱟᱦᱮᱠᱟᱱᱟ ᱟᱨ ᱯᱩᱭᱞᱩ 'ᱚᱱᱩᱢᱳᱫᱚᱱ'" },
        { "cell": "quote-letter", "text": "ᱞᱟᱴᱤᱱ ᱯᱟᱹᱨᱥᱤ (ᱞᱟᱴᱤᱱ: lingua latīna;) ᱫᱚ ᱢᱤᱫ ᱤᱴᱟᱞᱤᱭᱟᱹ ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱫᱚ 'ᱞᱟᱴᱤᱭᱚᱢ' ᱟᱨ 'ᱢᱟᱨᱮ ᱨᱳᱢ' ᱨᱮ ᱠᱚ ᱨᱚᱲ ᱠᱟᱱᱟᱜ ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱮᱴᱟᱜ ᱤᱭᱩᱨᱚᱯᱤᱭᱟᱹ ᱯᱟᱹᱨᱥᱤ ᱞᱮᱠᱟ ᱜᱮ, ᱢᱟᱨᱮ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ-ᱤᱭᱩᱨᱚᱯᱤᱭᱟᱹ ᱯᱟᱹᱨᱥᱤ ᱠᱷᱚᱱ ᱡᱟᱱᱟᱢ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱡᱟᱱᱟᱢ ᱫᱚ ᱤᱴᱟᱞᱤᱭᱟᱹ ᱯᱮᱱᱤᱱᱥᱩᱞᱟ ᱨᱮ ᱦᱩᱭ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱱᱚᱶᱟ ᱱᱤᱛ ᱜᱩᱨ ᱟᱠᱟᱱ ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱ ᱨᱮᱦᱚᱸ, ᱱᱮᱛᱟᱨ ᱦᱚᱸ ᱟᱭᱢᱟ ᱟᱪᱮᱛ, ᱯᱟᱹᱨᱥᱤ ᱯᱟᱹᱨᱩᱠᱷᱤᱭᱟᱹ ᱟᱨ ᱠᱤᱨᱤᱥᱛᱟᱱ ᱯᱟᱫᱽᱨᱤ ᱱᱟᱯᱟᱴ ᱛᱮ ᱜᱮ ᱠᱚ ᱨᱚᱲ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾ ᱱᱤᱛ ᱦᱚᱸ ᱟᱭᱢᱟ ᱟᱥᱲᱟ ᱟᱨ ᱩᱥᱩᱞ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮ ᱱᱚᱶᱟ ᱫᱚ ᱠᱚ ᱯᱟᱲᱦᱟᱜ ᱠᱟᱱ ᱜᱮᱭᱟ ᱾ ᱞᱟᱴᱤᱱ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱱᱟᱶᱟ ᱟᱹᱲᱟᱹ ᱥᱤᱨᱤᱡᱽ ᱞᱟᱹᱜᱤᱫ ᱠᱚ ᱵᱮᱵᱷᱟᱨᱮᱫᱼᱟ ᱾ ᱞᱟᱴᱤᱱ ᱵᱮᱜᱚᱨ ᱮᱴᱟᱜ ᱤᱴᱟᱞᱤᱭᱟᱹ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱯᱟᱹᱨᱥᱤ ᱢᱮᱴᱟᱣ ᱪᱟᱵᱟᱭᱮᱱᱟ ᱾" },
        { "cell": "scaled-currency", "text": "ᱱᱚᱣᱟ ᱨᱮ $᱔᱖ ᱵᱤᱞᱤᱭᱚᱱ ᱨᱮᱱᱟᱜ ᱯᱨᱳᱡᱮᱠᱴ ᱥᱟᱵᱟᱚᱜ ᱠᱷᱟᱱ ᱑᱙᱗᱐ ᱥᱟᱞ ᱠᱷᱚᱱ ᱯᱟᱠᱤᱥᱛᱟᱱ ᱨᱮ ᱠᱷᱟᱴᱟᱣ ᱦᱟᱠᱟᱱ ᱵᱟᱦᱨᱮ ᱫᱤᱥᱚᱢ ᱥᱚᱡᱷᱮ ᱯᱩᱸᱡᱤ ᱥᱟᱞᱟᱜ ᱵᱟᱨᱟᱵ ᱵᱟᱹᱨᱤᱼᱟ ᱾ ᱟᱨ ᱒᱐᱑᱕ ᱟᱭᱟᱢ ᱚᱲᱟᱜ ᱟᱨᱡᱟᱣ ᱨᱮᱱᱟᱜ ᱑᱗% ᱥᱟᱞᱟᱜ ᱵᱟᱨᱟᱵᱟᱹᱨᱤᱼᱟ ᱿ ᱥᱤᱯᱤᱥᱤ ᱫᱚ ᱪᱟᱭᱱᱤᱡ ᱯᱟᱨᱥᱮᱛ ᱜᱚᱢᱠᱮ ᱥᱤ ᱡᱤᱱᱯᱤᱝ ᱟ ᱩᱭᱦᱟᱹᱨ ᱠᱟᱱᱟ ᱾" },
        { "cell": "scaled-currency", "text": "ᱱᱚᱣᱟ ᱵᱟᱱᱨᱮᱱᱟᱜ ᱚᱨᱥᱚᱝ ᱡᱟᱠᱟᱨᱛᱟ ᱥᱩᱨ ᱥᱩᱯᱩᱨ ᱘᱐ᱜᱚᱴᱟᱝ ᱵᱷᱮᱜᱟᱨ ᱵᱷᱮᱜᱟᱨ ᱴᱷᱟᱶ ᱨᱮᱱᱟᱝ ᱗᱐,᱐᱐᱐ ᱚᱲᱟᱨ ᱨᱮ ᱯᱟᱲᱟᱣ ᱞᱮᱱᱟ, ᱱᱚᱣᱟ ᱗᱐᱐᱐᱐ ᱚᱲᱟᱜ ᱵᱟᱱ ᱜᱤᱰᱤ ᱞᱮᱫᱟᱭ ᱡᱟᱦᱟᱸᱠᱷᱟᱹᱛᱤᱨ ᱕᱐᱐᱐᱐᱐ ᱦᱚᱲ ᱟᱠᱚᱣᱟᱜ ᱚᱛ ᱦᱟᱥᱟ ᱠᱷᱚᱱ ᱠᱚ ᱩᱪᱟᱹᱲ ᱞᱮᱱᱟ ᱿ ᱵᱟᱱ ᱠᱷᱟᱹᱛᱤᱨ ᱨᱩᱣᱟ ᱵᱮᱢᱟᱨ ᱟᱡᱟᱨ ᱠᱚᱦᱚᱸ ᱟᱨᱡᱟᱣ ᱮᱱᱟ , ᱑᱐᱖᱖ ᱨᱩᱜᱤ ᱰᱟᱭᱨᱤᱭᱟ ᱟᱨ ᱓᱒᱙ ᱨᱩᱜᱤ ᱰᱮᱸᱜᱩ ᱵᱮᱢᱟᱨ ᱠᱷᱟᱹᱛᱤᱨ ᱰᱟᱠᱛᱚᱨᱠᱷᱟᱱᱟ ᱨᱮ ᱠᱚ ᱵᱷᱩᱨᱛᱤ ᱞᱮᱫ ᱠᱚᱣᱟ ᱾ ᱑᱙᱐᱐᱐᱐ ᱦᱚᱲ ᱵᱟᱱ ᱨᱮᱱᱟᱜ ᱚᱨᱥᱚᱝ ᱛᱮ ᱟᱨ ᱮᱴᱟᱜ ᱵᱮᱢᱟᱨ ᱟᱡᱟᱨ ᱨᱮᱠᱚ ᱯᱟᱲᱟᱣ ᱞᱮᱱᱟ ᱾ ᱵᱟᱱ ᱠᱷᱟᱹᱛᱤᱨ Rp ᱘ ᱴᱨᱤᱞᱤᱳᱱ (US$879.12 ᱢᱤᱞᱤᱭᱚᱱ)ᱨᱮᱱᱟᱜ ᱦᱟᱹᱱ ᱦᱩᱭ ᱞᱮᱱᱟ ᱾ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱵᱟᱹᱲᱤᱡ ᱚᱨᱥᱚᱝ ᱜᱟᱰᱟ ᱟᱲᱮ ᱥᱩᱨ ᱨᱮ ᱵᱟᱥᱟ ᱞᱮᱱ ᱨᱮᱱᱜᱮᱡ ᱩᱨᱤᱡ ᱦᱚᱲ ᱪᱮᱛᱟᱱ ᱨᱮ ᱯᱟᱲᱟᱣ ᱞᱮᱱᱟ ᱡᱟᱦᱟᱱᱭ ᱠᱚ ᱠᱟᱴ ᱛᱮ ᱚᱲᱟᱜ ᱵᱮᱱᱟᱣ ᱠᱟᱛᱮᱫ ᱠᱚ ᱛᱟᱦᱮᱱ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "scaled-currency", "text": "ᱦᱳᱯ ᱣᱟᱨᱞᱰ ᱣᱟᱭᱤᱰ ᱕ ᱢᱮᱴᱨᱤᱠ ᱴᱚᱱ (᱑᱑,᱐᱐᱐ lb) ᱡᱚᱢᱟᱜ, ᱫᱟᱜ, ᱨᱟᱱ, ᱯᱷᱟᱨᱪᱟᱜ ᱠᱤᱴ ᱑᱐,᱐᱐᱐ ᱦᱚᱲ ᱞᱟᱹᱜᱤᱫ ᱮ ᱡᱚᱜᱟᱣ ᱞᱮᱫᱼᱟ᱾ ᱢᱟᱨᱪ ᱗ ᱛᱮ ᱟᱨ ᱕ ᱢᱮᱴᱨᱤᱠ ᱴᱚᱱ ᱦᱟᱹᱴᱤᱧᱚᱜ ᱞᱟᱹᱜᱤᱫ ᱥᱮᱴᱮᱨ ᱞᱮᱱᱟ᱾ ᱡᱷᱚᱛᱚ ᱠᱚᱛᱮ ᱕᱕ ᱦᱟᱡᱟᱨ ᱦᱚᱲ ᱩᱯᱠᱟᱹᱨᱚᱜ ᱞᱮᱱᱟ ᱟᱱᱩᱢᱟᱱ $᱒᱓᱙,᱕᱕᱖ ᱨᱮᱱᱟᱜ ᱥᱚᱦᱚᱫ ᱥᱮᱴᱮᱨᱞᱮᱱᱟ ᱾ ᱱᱚᱣᱟ ᱠᱷᱚᱱ ᱑᱐% ᱥᱚᱦᱚᱫ ᱢᱟᱠ ᱰᱳᱸᱟᱞᱰ, ᱦᱟᱨᱴ ᱴᱩ ᱦᱟᱨᱴ ᱤᱱᱴᱮᱨᱱᱟᱥᱱᱟᱞ,ᱟᱨ ᱟᱭᱤ ᱳ ᱮᱢ ᱞᱮᱠᱟᱱ ᱥᱚᱸᱥᱛᱟ ᱛᱮ ᱜᱚᱲᱚ ᱥᱚᱦᱚᱫ ᱧᱟᱢ ᱞᱮᱱᱟ ᱿" },
        { "cell": "scaled-currency", "text": "᱑ ᱚᱠᱴᱳᱵᱚᱨ ᱒᱐᱐᱑ ᱥᱟᱞ ᱨᱮ ᱨᱮ ᱦᱚᱝᱠᱚᱝ ᱨᱮ ᱢᱮᱱᱟᱜ ᱵᱮᱸᱠ ᱚᱯᱷ ᱪᱟᱭᱱᱟ ᱨᱮᱱᱟᱜ ᱑᱒ ᱜᱚᱴᱟᱜ ᱥᱚᱦᱮᱫᱤᱭᱟᱹ ᱠᱚ ᱢᱮᱥᱟ ᱠᱟᱛᱮᱫ ᱵᱮᱸᱠ ᱚᱯᱷ ᱪᱟᱭᱱᱟ ᱦᱚᱝᱠᱚᱝ ᱵᱮᱨᱮᱫ ᱮᱱᱟ, ᱟᱨ ᱚᱠᱴᱳᱵᱚᱨ ᱒᱐᱐᱒ ᱦᱚᱝ ᱠᱚᱝ ᱥᱴᱚᱠ ᱮᱠᱥᱪᱮᱸᱡ ᱨᱮ ᱛᱟᱹᱞᱠᱟᱹ ᱮᱱᱟ ᱾᱒᱐᱑᱖ ᱢᱩᱪᱟᱹᱫ ᱨᱮ ᱦᱝᱠᱚᱝ ᱵᱮᱸᱠᱼᱟᱜ HK$᱓᱒᱗ ᱵᱤᱞᱤᱭᱚᱱ ᱥᱚᱢᱯᱚᱛᱤ ᱟᱨ HK$᱒᱙ ᱵᱤᱞᱤᱭᱚᱱ ᱞᱟᱵᱷ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱢᱩᱠᱷᱭᱟᱹ ᱟᱹᱢᱟᱹᱞᱤ ᱫᱚ ᱥᱮᱱᱴᱨᱟᱞ ᱦᱚᱝ ᱠᱚᱝ ᱨᱮᱱᱟᱜ ᱵᱭᱟᱸᱠ ᱚᱯᱷ ᱪᱟᱭᱱᱟ ᱴᱟᱣᱟᱨ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱢᱩᱠᱷᱭᱟᱹ ᱟᱹᱢᱟᱹᱞᱤ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱦᱚᱝᱠᱚᱝ ᱪᱟᱱᱜᱟ ᱥᱟᱞᱟᱜ ᱦᱟᱹᱴᱤᱧ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱑᱙᱘᱘ ᱥᱟᱞ ᱨᱮ ᱱᱚᱣᱟ ᱵᱮᱱᱟᱣ ᱯᱩᱨᱟᱹᱣ ᱦᱟᱠᱟᱱᱟ, ᱮᱛᱚᱢ ᱟᱢᱮᱨᱤᱠᱟ ᱵᱟᱦᱨᱮ ᱨᱮ ᱯᱩᱭᱞᱩ ᱫᱳᱞᱟᱱ ᱠᱟᱱᱟ ᱡᱟᱦᱟᱸ ᱑᱐᱐᱐ ᱯᱷᱤᱴ ᱪᱮᱛᱟᱱ ᱮ ᱯᱟᱨᱚᱢ ᱦᱟᱠᱟᱫᱼᱟ ᱾" },
        { "cell": "scaled-currency", "text": "ᱱᱚᱣᱟ ᱫᱤᱱᱤᱥᱟ. ᱫᱚ ᱫᱤᱥᱣᱟ. ᱠᱚᱣᱟᱜ ᱱᱤᱡᱟ. ᱮᱯᱮᱢ-ᱪᱟᱯᱟᱞ ᱛᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ, ᱚᱠᱟ ᱰᱷᱮᱨ ᱦᱤ'ᱥ ᱜᱮ ᱜᱩᱡᱨᱟᱛ ᱥᱚᱨᱠᱟᱨ ᱟᱜ ᱠᱟᱱ | ᱜᱩᱡᱨᱟᱛ ᱥᱚᱨᱠᱟᱨ ᱫᱚ ᱒᱐᱑᱒-᱑᱓ ᱵᱟᱡᱮᱴ ᱚᱠᱛᱮ ₹᱑᱐᱐ ᱠᱳᱴᱤ ᱛᱟ'ᱦᱟ' ᱒᱐᱑᱔-᱑᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ₹᱕᱐᱐ ᱠᱳᱴᱤ ᱴᱟᱠᱟ ᱮᱢᱚᱜ ᱨᱮᱭᱟᱜ ᱠᱚ ᱧᱩᱢ ᱵᱮᱜᱟᱨ ᱞᱮᱫᱟ | ᱒᱐᱑᱔-᱑᱕ ᱨᱮ ᱥᱤᱧᱩᱛ ᱥᱚᱨᱠᱟᱨ ᱟᱜ ᱵᱟᱡᱮᱴ ᱨᱮ ᱢᱩᱨᱛᱤ ᱵᱮᱱᱟᱣ ᱞᱟ.ᱜᱤᱫ ₹᱒ ᱟᱨᱚᱵᱽ ᱠᱳᱴᱤ ᱴᱟᱠᱟ ᱮᱢᱚᱜ ᱨᱮᱭᱟᱜ ᱧᱩᱢ ᱵᱮᱜᱟᱨ ᱞᱮᱱᱟ |" },
        { "cell": "scaled-currency", "text": "ᱚᱨᱩᱱᱫᱷᱚᱛᱤ ᱫᱚ ᱑᱙᱙᱗ ᱥᱟᱞᱮ ᱨᱮ The God of Small Things ᱠᱟᱹᱦᱱᱤ ᱯᱩᱛᱷᱤ ᱞᱟᱹᱜᱤᱫ ᱥᱤᱨᱯᱷᱟᱹᱭ ᱧᱟᱢ ᱞᱮᱫ-ᱟ ᱾ ᱥᱤᱨᱯᱷᱟᱹ ᱞᱮᱠᱟᱛᱮ US$᱓᱐,᱐᱐᱐ ᱜᱟᱱ ᱠᱟᱹᱣᱰᱤᱭ ᱧᱟᱢ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱨᱚᱭ ᱫᱚ ᱧᱟᱢ ᱞᱮᱫ ᱥᱟᱱᱟᱢ ᱠᱟᱹᱣᱰᱤ ᱫᱤᱥᱣᱟᱹ ᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱮ ᱮᱢ ᱪᱟᱞ ᱞᱮᱫᱼᱟ ᱟᱨ ᱚᱱᱟ ᱯᱩᱛᱷᱤ ᱨᱮᱱᱟᱜ ᱟᱹᱭᱫᱟᱹᱨ ᱦᱚᱸᱭ ᱫᱤᱥᱣᱟᱹ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾" },
        { "cell": "scaled-currency", "text": "ᱪᱟᱥ ᱟᱵᱟᱫᱽ ᱨᱮ ᱜᱮ ᱵᱟᱜᱚᱞᱠᱚᱴ ᱨᱮᱭᱟᱜ ᱠᱟᱹᱣᱰᱤ ᱟᱹᱨᱤ ᱫᱚ ᱴᱮᱦᱟᱱᱰ ᱟᱠᱟᱱᱟ, ᱟᱢᱫᱟᱡᱽ ᱥᱟᱭ ᱠᱟᱲᱟ ᱖᱕% ᱦᱤᱥ ᱵᱟᱜᱚᱞᱠᱚᱴ ᱨᱮᱱ ᱦᱚᱲ ᱜᱮ ᱪᱟᱥ ᱟᱵᱟᱫᱽ ᱨᱮ ᱞᱟᱹᱜᱽᱭᱟᱹ ᱯᱟᱲᱟᱣ ᱟᱠᱟᱱ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱟᱢᱫᱟᱦᱽ ᱥᱟᱭ ᱠᱟᱲᱟ ᱘᱐% ᱦᱤᱥ ᱜᱮ ᱦᱮᱨᱮᱠ ᱦᱚᱲ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱠᱚᱭᱮ ᱠᱟᱨᱱᱟᱴᱟᱠ ᱨᱮᱭᱟᱜ ᱮᱴᱟᱜ ᱦᱚᱱᱚᱛ ᱠᱚ ᱞᱮᱠᱟ ᱜᱮ ᱵᱟᱜᱚᱞᱠᱚᱴ ᱦᱚᱱᱚᱛ ᱦᱚ ᱵᱮᱱᱫᱮ ᱦᱟᱥᱟ ᱛᱮ ᱯᱮᱨᱮᱡ ᱯᱩᱨᱚᱱ ᱜᱮᱭᱟ, ᱱᱤᱭᱟᱹ ᱦᱮᱱᱫᱮ ᱦᱟᱥᱟ ᱨᱮ ᱜᱮ ᱠᱟᱥᱠᱚᱢ ᱪᱟᱥ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱤ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱵᱟᱜᱚᱞᱠᱚᱴ ᱨᱮᱭᱟᱜ ᱠᱟᱹᱣᱰᱤ ᱟᱹᱨᱤ ᱫᱚ $5.6 ᱵᱤᱞᱤᱭᱚᱱ ᱟᱢᱮᱨᱩᱠᱟᱱ ᱰᱚᱞᱟᱨ ᱠᱟᱱᱟ, ᱚᱠᱟ ᱫᱚ ᱠᱟᱨᱱᱟᱴᱟᱠ ᱯᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱑᱒ ᱮᱞᱟᱱ ᱦᱚᱱᱚᱛ ᱨᱮ ᱢᱮᱱᱟᱜ ᱟᱠᱟᱫ ᱾ ᱱᱤᱭᱟᱹ ᱦᱚᱱᱚᱛ ᱨᱮᱱ ᱢᱤᱫ ᱦᱚᱲᱟᱜ ᱯᱟᱨ ᱠᱮᱯᱤᱴᱟ ᱟᱨᱡᱟᱣ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ $360 ᱟᱢᱮᱨᱤᱠᱟᱱ ᱰᱚᱞᱟᱨ ᱾ ᱱᱚᱣᱟ ᱦᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱟᱨ ᱮᱴᱟᱜ ᱥᱮᱬᱟ ᱪᱟᱥ ᱠᱚᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ, ᱨᱟ.ᱵᱤ, ᱡᱟᱣ, ᱵᱟᱫᱟᱢ, ᱠᱟᱥᱠᱚᱢ, ᱡᱚᱱᱰᱨᱟ, ᱜᱩᱦᱩᱢ, ᱟᱸᱠ ᱟᱨ ᱛᱷᱟᱢᱟᱠᱩᱨ ᱾ ᱡᱟᱣ ᱪᱟᱥ ᱫᱚ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱦᱩᱭᱩᱜᱼᱟ, ᱪᱮᱫᱟᱜ ᱥᱮ ᱱᱚᱣᱟ ᱫᱚ ᱡᱟᱹᱯᱩᱫ ᱚᱠᱛᱮ ᱟᱨ ᱱᱤᱨᱚᱱ ᱚᱠᱛᱮ ᱨᱮᱦᱚ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱫᱟ.ᱞ ᱱᱤᱭᱟᱹ ᱴᱚᱴᱷᱟ ᱨᱮ ᱦᱩᱭᱩᱜ ᱜᱮᱭᱟ, ᱟᱥᱠᱟᱭ ᱛᱮ ᱢᱟᱹᱥᱨᱤ, ᱢᱚᱜᱽ, ᱜᱨᱟᱢ, ᱠᱩᱞᱤᱛᱷ, ᱛᱤᱞᱢᱤᱧ ᱮᱢᱟᱱ ᱾" },
        { "cell": "scaled-currency", "text": "ᱱᱚᱣᱟ ᱫᱷᱩᱢ ᱥᱤᱨᱤᱡ ᱨᱮᱱᱟᱜᱫᱷᱩᱢ ᱓ ᱡᱮᱜᱮᱛ ᱡᱟᱠ ᱨᱮ ₹᱕᱕᱐ ᱠᱚᱨᱳᱰ ᱴᱟᱠᱟᱭ ᱵᱮᱯᱟᱨ ᱟᱠᱟᱫᱼᱟ ᱾ ᱱᱚᱝᱠᱟᱛᱮ ᱦᱤᱱᱫᱤ ᱥᱤᱱᱮᱢᱟᱦᱟᱜ ᱱᱟᱜᱟᱢ ᱨᱮ ᱯᱩᱱᱟᱝ ᱥᱮᱬᱟ ᱵᱮᱯᱟᱨ ᱟᱠᱟᱫ ᱯᱷᱤᱞᱤᱢ ᱠᱟᱱᱟ ᱾ ᱒᱐᱑᱖ ᱫᱷᱟᱵᱤᱡ ᱛᱮ ᱫᱷᱩᱢ ᱫᱚ ᱯᱷᱨᱟᱱᱪᱷᱟᱭᱤᱡ ᱟᱨ ᱯᱷᱤᱞᱤᱢ ᱥᱤᱨᱤᱡ ᱨᱮᱱᱟᱜ ᱥᱮᱬᱟ ᱵᱮᱯᱟᱨ ᱟᱠᱟᱫ ᱛᱷᱚᱠ ᱨᱮ ᱢᱚᱬᱮᱟᱱ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫᱟ᱿" },
        { "cell": "ordinal-caps", "text": "ᱱᱚᱣᱟ ᱫᱚ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱢᱟᱹᱧᱡᱩᱨ ᱠᱚᱢᱤᱥᱚᱱ (ᱭᱩ.ᱡᱤ.ᱥᱤ) ᱚᱫᱷᱤᱱᱤᱭᱚᱢ ᱑᱙᱕᱖ ᱨᱮᱭᱟᱜ ᱫᱷᱟᱨᱟ ᱒ (ᱮᱯᱷ) ᱨᱮᱭᱟᱜ ᱟᱹᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱥᱚᱨᱠᱟᱨ ᱟᱜ ᱟᱹᱨᱤ (ᱥᱚᱨᱠᱟᱨᱤ ᱜᱮᱡᱮᱴ ᱱᱚᱴᱤᱯᱷᱤᱠᱮᱥᱚᱱ ᱮᱞ.: ᱑᱔᱒-Edn (U) ᱢᱟᱹᱦᱤᱛ ᱓᱑/᱐᱑/᱒᱐᱑᱓) ᱦᱚᱛᱮᱛᱮ ᱛᱷᱟᱯᱚᱱ ᱟᱠᱟᱱᱟ᱾ ᱟᱨ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱵᱤᱫᱷᱟᱱᱥᱚᱵᱷᱟ ᱦᱚᱛᱮᱛᱮ ᱥᱮᱠᱚᱢ ᱥᱠᱤᱞ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱚᱫᱷᱤᱱᱤᱭᱚᱢ ᱒᱐᱑᱔ ᱞᱮᱠᱟᱛᱮ ᱯᱟᱥ ᱟᱠᱟᱱᱟ (᱒᱐᱑᱔ ᱨᱮᱭᱟᱜ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱚᱫᱷᱤᱱᱤᱭᱚᱢ VI), ᱡᱟᱦᱟᱸ ᱫᱚ ᱑᱑ ᱮᱯᱨᱤᱞ ᱒᱐᱑᱔ ᱨᱮ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱨᱮᱱ ᱯᱚᱱᱚᱛ ᱜᱚᱢᱠᱮ ᱴᱷᱮᱱᱠᱷᱚᱱ ᱢᱟᱹᱡᱩᱨᱤ ᱮ ᱧᱟᱢ ᱞᱮᱫᱟ (ᱥᱚᱨᱠᱟᱨᱤ ᱜᱮᱡᱮᱴ ᱱᱚᱴᱤᱯᱷᱤᱠᱮᱥᱚᱱ ᱮᱞ. ᱓᱙᱖-Edn(U)/OM-᱑᱕᱕L/᱒᱐᱑᱒)᱾" },
        { "cell": "ordinal-caps", "text": "ᱪᱳᱭ ᱥᱟᱭ ᱣᱩ ᱯᱟᱨᱠ ᱫᱚ ᱒,᱔᱐᱐ ᱥᱠᱚᱭᱟᱨ ᱢᱤᱴᱚᱨ ᱡᱟᱭᱜᱟ ᱛᱮ ᱴᱚᱯᱟᱨ ᱮᱥᱮᱫ ᱟᱠᱟᱱ ᱢᱤᱫ ᱡᱟᱜᱟ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱟᱹᱰᱤ ᱜᱟᱱ ᱦᱟᱣᱩᱥ ᱮᱥᱴᱮᱴ ᱟᱨ ᱟᱥᱲᱟ ᱠᱚ ᱛᱟᱞᱟ ᱨᱮ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱱᱟᱥᱮ ᱱᱟᱥᱮ ᱡᱟᱜᱟ ᱮᱢᱚᱜ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱨᱮ ᱟᱹᱰᱤ ᱜᱟᱱ ᱟᱥᱲᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ ᱧᱩᱛᱩᱢᱟᱱ ᱱᱟᱣᱟ ᱚᱲᱟᱜ ᱵᱮᱱᱟᱣ ᱨᱮᱱᱟᱜ ᱥᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ, ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱨᱮ ᱢᱤᱫ ᱨᱟᱹᱥᱠᱟᱹ ᱡᱟᱭᱜᱟ ᱞᱮᱠᱟᱛᱮ ᱜᱟᱶᱛᱟ ᱨᱮᱱᱟᱜ ᱠᱟᱹᱢᱤ ᱠᱟᱱᱟ ᱾ ᱯᱟᱨᱠ ᱨᱮ ᱵᱟᱨᱭᱟ ᱞᱟᱹᱴᱩ ᱵᱟᱥᱠᱮᱴᱵᱚᱞ ᱠᱳᱨᱴ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱜᱟᱨᱰᱮᱱ ᱴᱚᱴᱷᱟ ᱫᱚ ᱪᱳᱭ ᱥᱟᱭ ᱣᱩ ᱯᱟᱨᱠ ᱨᱮᱭᱟᱜ ᱞᱟᱛᱟᱨ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱱᱚᱣᱟ ᱴᱩᱴᱚᱨ ᱴᱟᱭᱢ ᱨᱮᱭᱟᱜ ᱠᱟᱨ ᱯᱟᱨᱠᱤᱝ ᱨᱮᱭᱟᱜ ᱥᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱢᱩᱬᱩᱛ ᱠᱟᱛᱮ ᱵᱟᱢᱵᱩ ᱛᱮ ᱪᱟᱥᱵᱟᱥ ᱦᱩᱭᱩᱜ-ᱟ ᱾ ᱯᱟᱨᱠ ᱨᱮᱱᱟᱜ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱤᱫ ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚᱣᱟᱜ ᱠᱷᱮᱞᱚᱸᱰ ᱴᱚᱴᱷᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱠᱷᱮᱞᱚᱸᱰ ᱡᱟᱭᱜᱟ ᱥᱩᱨ ᱨᱮ ᱢᱤᱫ ᱯᱚᱜᱚᱰᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱴᱚᱴᱷᱟ ᱨᱮ ᱟᱹᱰᱤ ᱜᱟᱱ ᱵᱮᱵᱚᱥᱛᱟ ᱢᱮᱱᱟᱜᱼᱟ, ᱡᱮᱞᱮᱠᱟ ᱨᱮᱥᱴᱚᱨᱟᱱᱴ ᱥᱮ ᱪᱟ ᱪᱟ ᱴᱮᱱᱜ, ᱣᱟᱱ ᱠᱤᱝ, ᱴᱩᱴᱚᱨ ᱴᱟᱭᱤᱢ ᱟᱨ 7-Eleven ᱟᱣᱩᱴᱞᱤᱥ ᱾" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "ᱚᱱᱚᱞ ᱚᱞ ᱢᱩᱬ ᱠᱟᱛᱮ ᱯᱮ ᱦᱚᱨᱟᱛᱮ ᱦᱩᱭᱩᱜᱼᱟ, ᱯᱩᱭᱞᱩᱛᱮ ᱮᱛᱚᱦᱚᱵᱽ, ᱫᱚᱥᱟᱨ ᱨᱮ ᱵᱚᱨᱱᱚᱱᱟ ᱟᱨ ᱛᱮᱥᱟᱨ ᱨᱮ ᱜᱩᱴᱚᱱᱚᱞ (Conclusion) ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱩᱪᱟ.ᱫ ᱠᱷᱚᱫᱽ ᱠᱟᱱᱟ, ᱱᱚᱶᱟ ᱨᱮ ᱚᱱᱚᱞᱤᱭᱟ., ᱜᱟᱢᱟᱢᱤ, ᱠᱟ.ᱦᱱᱤᱭᱟ. ᱠᱚᱣᱟᱜ ᱚᱱᱚᱞ ᱥᱟᱛᱟᱢ ᱤᱫᱤ ᱠᱟᱛᱮ ᱩᱫᱤᱥ/ᱥᱟᱱᱫᱮᱥ ᱵᱟᱰᱟᱭᱚᱜ-ᱟ ᱾ ᱥᱟᱶᱦᱮᱫ ᱥᱤᱨᱡᱚᱱ ᱨᱮᱭᱟᱜ ᱟᱭᱢᱟ ᱠᱷᱚᱫᱽ ᱠᱷᱚᱱ ᱚᱱᱚᱞ ᱜᱮ ᱥᱚᱨᱮᱥᱟᱜ ᱠᱷᱚᱫᱽ ᱾ ᱚᱱᱚᱞᱞᱤᱭᱟ. ᱟᱡᱟᱜ ᱚᱱᱚᱞ ᱨᱮ ᱡᱟᱦᱟ ᱠᱚᱭ ᱞᱟᱹᱭ ᱠᱟᱜᱼᱟ, ᱚᱱᱟ ᱠᱚᱜᱮ ᱱᱚᱸᱰᱮ ᱡᱷᱟᱞᱠᱟᱣᱜᱼᱟ ᱾ ᱚᱱᱟᱛᱮ ᱟᱫᱷᱟᱱ ᱦᱚᱲ ᱫᱚ ᱚᱱᱚᱞ ᱯᱩᱨᱟ. ᱵᱟᱝ ᱯᱟᱲᱦᱟᱣ ᱠᱟᱛᱮ ᱜᱩᱴᱚᱱᱚᱞ/ᱢᱩᱪᱟ.ᱫ ᱛᱮᱫ ᱯᱟᱲᱦᱟᱣ ᱠᱟᱛᱮ, ᱚᱱᱚᱞ ᱤᱫᱤ ᱠᱟᱛᱮ ᱩᱫᱤᱥ/ᱥᱟᱱᱫᱮᱥ ᱢᱟᱨᱠᱚᱛ ᱠᱚ ᱢᱮᱴᱟᱣ ᱛᱟᱠᱚᱣᱟ ᱾",
        "ᱜᱷᱟᱱᱴᱟᱲ ᱫᱚ ᱞᱚᱞᱚ ᱢᱟᱸᱰᱣᱟ ᱨᱮᱱᱟᱜ ᱪᱟᱥ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱩᱨᱜᱩᱢ ᱟᱨ ᱦᱟᱣᱮᱫ ᱦᱚᱭ ᱦᱤᱥᱤᱫ ᱨᱮ ᱱᱟᱯᱟᱭ ᱦᱩᱭᱩᱜ-ᱟ ᱾ ᱥᱟᱹᱢᱩᱸᱫᱽ ᱛᱩᱬᱩᱝ ᱠᱷᱚᱱ ᱑᱕᱐᱐ ᱢᱤᱴᱚᱨ ᱩᱥᱩᱞ ᱦᱟᱹᱵᱤᱡ ᱪᱟᱥ ᱦᱩᱭ ᱫᱟᱲᱮᱭᱟᱜ-ᱟ ᱾ ᱢᱮᱱᱠᱷᱟᱱ ᱑᱒᱐᱐ ᱢᱤᱴᱚᱨ ᱠᱷᱚᱱ ᱪᱮᱛᱟᱱ ᱨᱮ ᱫᱚ ᱠᱚᱢ ᱜᱮ ᱡᱚ ᱟ ᱾ ᱱᱚᱣᱟ ᱫᱟᱨᱮ ᱫᱟᱜ ᱧᱩᱨᱩᱜ ᱴᱷᱟᱶᱨᱮ ᱵᱷᱟᱹᱜᱤ ᱦᱟᱨᱟᱜ ᱨᱮᱦᱚᱸ ᱱᱚᱣᱟ ᱨᱱᱟᱜ ᱢᱩᱬ ᱨᱮ ᱫᱟᱜ ᱛᱚᱢᱵᱟ ᱛᱟᱦᱮᱸ ᱞᱮᱱᱠᱷᱟᱱ ᱵᱟᱭ ᱥᱟᱦᱟᱣ ᱫᱟᱲᱮᱭᱟᱜ-ᱟ ᱾",
        "ᱟᱸᱯᱟᱸᱲᱤ ᱫᱚ ᱢᱤᱫᱴᱟᱹᱝ ᱢᱮᱲᱦᱮᱫ ᱯᱷᱟᱹᱞ, ᱥᱚᱡᱷᱮ ᱢᱟᱫ ᱥᱤᱴᱠᱟᱹ ᱟᱨ ᱪᱮᱸᱲᱮᱼᱤᱞ ᱛᱮ ᱜᱟᱞᱟᱝ ᱠᱟᱛᱮ ᱵᱮᱱᱟᱣ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱯᱟᱠᱚᱲ ᱢᱟᱫ ᱥᱤᱴᱠᱟᱹ ᱥᱤᱛᱩᱝ ᱨᱮ ᱛᱟᱥᱮ ᱨᱚᱦᱚᱲ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱛᱟᱥᱮ ᱨᱚᱦᱚᱲ ᱞᱮᱠᱷᱟᱱ ᱱᱚᱣᱟ ᱟᱸᱯᱟᱸᱲᱤ ᱥᱮ ᱥᱟᱨ ᱫᱚ ᱟᱰᱤ ᱨᱟᱣᱟᱞ ᱟᱨ ᱥᱚᱡᱷᱮ ᱪᱟᱞᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱥᱟᱨ ᱵᱟᱝ ᱠᱷᱚᱱ ᱮᱠᱷᱮᱱ ᱟᱜ ᱫᱚ ᱚᱪᱚᱞ ᱜᱮᱭᱟ ᱾ ᱱᱚᱣᱟ ᱥᱟᱨ ᱛᱮᱜᱮ ᱡᱟᱦᱟᱱ ᱡᱟᱱᱩᱣᱟᱨ ᱥᱮ ᱵᱟᱹᱭᱨᱤ ᱠᱚ ᱫᱚᱠᱚ ᱛᱩᱧ ᱠᱚᱣᱟ ᱾",
        "ᱡᱟᱯᱟᱱᱤᱡᱽ ᱯᱟᱹᱨᱥᱤ ᱛᱤᱥ ᱠᱷᱚᱱ ᱮᱦᱚᱵ ᱮᱱᱟ ᱚᱱᱟ ᱨᱮᱱᱟᱜ ᱡᱟᱦᱟᱸᱱ ᱡᱚᱛᱷᱟᱛ ᱥᱟᱹᱠᱷᱤ ᱵᱟᱝ ᱛᱮ ᱴᱷᱟᱶᱠᱟᱹ ᱞᱟᱹᱭ ᱵᱟᱝ ᱜᱟᱱᱚᱜᱼᱟ ᱾ ᱛᱮᱥᱟᱨ ᱥᱟᱭᱟᱝ ᱥᱮᱨᱢᱟ ᱨᱮ ᱚᱞ ᱞᱮᱱ ᱢᱤᱫ ᱪᱤᱱᱤ ᱯᱚᱛᱚᱵ ᱨᱮ ᱡᱟᱯᱟᱱ ᱨᱮᱱᱟ ᱛᱤᱢᱤᱱ ᱜᱟᱱ ᱴᱷᱟᱶ ᱟᱨ ᱦᱚᱲᱟᱜ ᱧᱩᱛᱩᱢ ᱧᱟᱢᱚᱜ ᱠᱟᱱᱟ, ᱚᱸᱰᱮ ᱠᱷᱚᱱ ᱜᱮ ᱯᱟᱭᱛᱟᱨ ᱦᱩᱭ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱪᱤ ᱩᱱ ᱚᱠᱛᱚ ᱨᱮ ᱡᱟᱯᱟᱱᱤᱡᱽ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱦᱟᱨᱟᱵᱩᱨᱩ ᱦᱩᱭ ᱥᱟᱹᱛ ᱟᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱗-᱘ ᱥᱟᱭᱟᱝ ᱨᱮ ᱡᱟᱯᱟᱱᱤᱡᱽ ᱦᱚᱲ ᱪᱟᱭᱱᱟ ᱟᱹᱨᱥᱤ ᱟᱨ ᱦᱚᱨᱚᱯ ᱠᱚ ᱪᱮᱫ ᱮᱱᱟ, ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱪᱟᱭᱱᱟ ᱯᱟᱹᱨᱥᱤ ᱛᱮ ᱱᱟᱜᱟᱢ, ᱚᱛᱱᱚ ᱮᱢᱟᱱ ᱠᱚ ᱚᱞ ᱠᱮᱫᱼᱟ ᱾ ᱵᱟᱹᱭ ᱵᱟᱹᱭ ᱛᱮ ᱪᱤᱱᱤ ᱦᱚᱨᱚᱯ ᱛᱮ ᱡᱟᱯᱟᱱᱤᱡᱽ ᱯᱟᱹᱨᱥᱤ ᱚᱞ ᱨᱮᱱᱟᱜ ᱦᱚᱨᱟ ᱠᱚ ᱯᱟᱱᱛᱮ ᱧᱟᱢ ᱠᱮᱫᱼᱟ ᱾",
        "ᱟᱨᱵᱤ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱢᱤᱥᱚᱨ ᱨᱮᱱᱟᱜ ᱥᱚᱨᱠᱟᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱᱟ᱾ ᱡᱟᱹᱥᱛᱤ ᱵᱷᱟᱜᱽ ᱦᱚᱲ ᱜᱮ ᱟᱨᱵᱤ ᱛᱮᱠᱩ ᱨᱚᱲᱟ᱾ ᱢᱤᱥᱚᱨ ᱨᱮᱱ ᱡᱤᱯᱥᱤ ᱦᱚᱲ ᱠᱩᱫᱚ ᱫᱳᱢᱟᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱛᱮᱠᱩ ᱨᱚᱲᱟ᱾ ᱤᱥᱞᱟᱢ ᱫᱷᱚᱨᱚᱢ ᱨᱮᱱ ᱦᱚᱲ ᱵᱟᱫᱽ ᱠᱟᱛᱮ ᱦᱚᱸ ᱢᱤᱥᱚᱨ ᱨᱮ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱟᱹᱨᱤᱪᱟᱹᱞᱤ ᱨᱮᱱ ᱦᱚᱲ ᱠᱩ ᱢᱮᱱᱟᱜ ᱠᱩᱣᱟ᱾",
        "ᱵᱟᱨᱵᱟᱰᱚᱥ ( / b ɑr ˈ b eɪ d ɒ s / ᱟᱨᱵᱟᱝ / b ɑr ˈ b eɪ d oʊ s / ) ᱫᱚ ᱞᱮᱥᱚᱨ ᱟᱱᱴᱤᱞᱮᱥ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱟᱹᱱᱟᱹᱛᱟᱱ ᱰᱷᱤᱯ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱡᱤᱞᱤᱧ ᱓᱔ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱒᱑ ᱟᱨ ᱚᱥᱟᱨ ᱫᱚ ᱒᱓ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱜᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱮᱛᱚᱢ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱨᱮᱱᱟᱜ ᱯᱟᱪᱮ ᱥᱮᱦᱮᱫ ᱨᱮ ᱟᱨ ᱠᱟᱨᱵᱤᱭᱟᱱ ᱥᱟᱜᱚᱨ ᱟᱨ ᱩᱣᱤᱸᱰᱣᱟᱨᱰ ᱯᱩᱧᱡᱤ ᱰᱷᱤᱯᱩ ᱨᱮᱱᱟᱜ ᱥᱟᱢᱟᱝ ᱥᱮᱦᱮᱫ ᱨᱮ ᱫᱚᱱᱚᱲᱚᱢ ᱟᱠᱟᱱᱟ ᱾ ᱥᱮᱸᱴ ᱵᱷᱤᱱᱥᱮᱸᱴ ᱟᱨ ᱜᱨᱮᱱᱟᱰᱤᱱᱥ ᱨᱮᱱᱱᱟᱜ ᱑᱖᱘ ᱠᱤᱞᱚᱢᱤᱴᱚᱨᱥᱟᱢᱟᱝ ᱥᱮᱦᱮᱫ ᱨᱮ ᱟᱨ ᱛᱨᱤᱱᱟᱰᱽ ᱟᱨ ᱴᱚᱵᱟᱜᱚᱨ ᱠᱷᱚᱱ ᱔᱐᱐ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱮᱛᱚᱢ-ᱥᱟᱢᱟᱝ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ᱵᱟᱨᱵᱟᱰᱚᱥ ᱫᱚ ᱢᱩᱲ ᱟᱴᱞᱟᱱᱴᱤᱠ ᱢᱮᱠᱷᱲᱟᱨ ᱠᱷᱚᱱ ᱵᱟᱨᱦᱮ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "Planipolis: a portal on education plans and policies",
        "Souls for Sale (মার্চ ২৭, ১৯২৩) (ক্যামিও: himself, celebrity director)",
        "Metropolitan Museum of Art (New York City)",
        "Globis University Graduate School of Management",
        "ᱥᱚᱦᱨᱟᱭ ᱨᱮ ᱫᱚ ᱜᱚᱴ ᱵᱚᱝᱜᱟ, ᱜᱚᱲᱟ ᱵᱚᱝᱜᱟ ᱠᱚ ᱯᱮᱨᱮᱡ ᱩᱢᱟᱬᱚᱜᱼᱟ ᱾ ᱜᱚᱴ ᱨᱮ ᱫᱚ ᱢᱟᱨᱟᱝ ᱵᱳᱨᱳ, ᱡᱟᱦᱮᱨ ᱟᱭᱳ, ᱢᱚᱬᱮ ᱠᱚ, ᱛᱩᱨᱩᱭ ᱠᱚ ᱾ ᱜᱚᱲᱟ ᱨᱮ ᱫᱚ ᱯᱟᱹᱨᱤᱥ ᱡᱟᱹᱱᱤᱡ ᱟᱯᱟᱱ ᱟᱹᱯᱤᱱ ᱜᱮᱭᱟ ᱾ ᱠᱷᱩᱱᱴᱟᱹᱣ ᱴᱟᱺᱰᱤ ᱨᱮ ᱫᱚ ᱢᱟᱨᱟᱝ ᱵᱳᱨᱳ, ᱦᱟᱯᱲᱟᱢ ᱠᱚ, ᱟᱯᱟᱱ ᱟᱹᱯᱤᱱ ᱨᱤᱱ ᱾",
        "᱒ ᱢᱟᱨᱪ ᱒᱐᱐᱕ ᱨᱮ, ᱟᱹᱰᱤ ᱜᱟᱱ ᱨᱟᱡᱟᱹᱨᱤ ᱫᱚᱞᱟᱞᱤ ᱟᱨ ᱠᱩᱭᱤᱰ ᱯᱨᱚ ᱠᱳ ᱛᱟᱭᱚᱢ ᱩᱱᱤ ᱫᱚ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱤᱱᱤᱡ ᱨᱟᱡᱽᱭᱚᱯᱟᱞ ᱫᱟᱨᱟᱭ ᱛᱮ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮ ᱥᱚᱨᱠᱟᱨ ᱵᱮᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱠᱚ ᱱᱮᱣᱛᱟ ᱞᱮᱫᱮᱭᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱵᱟᱨᱜᱮᱞ ᱢᱟᱦᱟᱸ ᱛᱟᱭᱚᱢ ᱑᱑ ᱢᱟᱨᱪ ᱨᱮ ᱵᱤᱫᱷᱟᱱᱥᱚᱵᱷᱟ ᱨᱮ ᱯᱟᱹᱛᱭᱟᱹᱣ ᱵᱷᱳᱴ ᱮ ᱧᱟᱢ ᱵᱟᱝ ᱫᱟᱲᱮᱭᱟᱫ ᱠᱷᱟᱹᱛᱤᱨ ᱢᱩੱਖᱭᱚ ᱢᱚᱱᱛᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱨᱤᱡᱟᱭᱤᱱ ᱠᱮᱫ-ᱟ ᱾",
        "ᱢᱟᱬᱜᱷᱟ.ᱴᱤ ᱫᱚ ᱟ.ᱛᱩ ᱨᱤᱱ ᱜᱚᱡ ᱜᱩᱨ ᱦᱚᱲ ᱠᱚ ᱵᱟᱝᱢᱟ ᱢᱟᱬᱟ ᱛᱚᱯᱟ ᱞᱟ.ᱜᱤᱫ ᱢᱤᱫ ᱨᱟᱠᱷᱟ ᱫᱚᱦᱚ ᱡᱟᱭᱜᱟ ᱠᱟᱱᱟ ᱾ ᱡᱚᱛᱚ ᱟ.ᱛᱩ ᱥᱤᱢᱟ.ᱵᱷᱤᱛᱨᱤ ᱨᱮᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱢᱟᱬᱜᱷᱟ.ᱴᱤ ᱡᱟᱦᱟᱸᱭ ᱦᱚᱲ ᱚᱦᱚᱭ ᱪᱟᱠᱷᱨᱟᱣ ᱠᱮᱭᱟ ᱾ ᱢᱟᱬᱜᱷᱟ.ᱴᱤ ᱨᱮᱱᱟᱝ ᱚᱛ ᱦᱟᱥᱟ ᱨᱮᱦᱚᱸ ᱥᱚᱨᱠᱟᱨᱟᱜ ᱡᱟᱦᱟᱸᱱ ᱦᱚᱠ ᱟ.ᱭᱫᱟ.ᱨᱤ ᱫᱚ ᱵᱟ.ᱱᱩᱜ ᱟᱱᱟ ᱾",
        "ᱱᱚᱣᱟ ᱨᱮ ᱥᱮᱞᱮᱫ ᱦᱟᱠᱟᱱ ᱑᱖ ᱜᱚᱴᱟᱝ ᱫᱚᱲ ᱯᱩᱱᱭᱟᱹ ᱜᱩᱴ ᱨᱮ ᱦᱟᱹᱴᱤᱧ ᱦᱩᱭ ᱦᱟᱠᱟᱱᱟ ᱾ ᱡᱷᱚᱛᱚ ᱫᱚᱲ ᱟᱠᱚ ᱜᱩᱴ ᱨᱮ ᱢᱮᱱᱟᱜ ᱦᱟᱠᱟᱱ ᱫᱚᱲ ᱠᱚ ᱥᱟᱞᱟᱜ ᱢᱤ-ᱢᱤᱫ ᱫᱷᱟᱣ ᱠᱚ ᱮᱱᱮᱡᱼᱟ ᱾ ᱡᱷᱚᱛᱚ ᱜᱩᱴ ᱨᱮ ᱯᱩᱭᱞᱩ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱦᱟᱠᱟᱫ ᱫᱚᱲ ᱠᱚᱫᱚ ᱠᱣᱟᱴᱚᱨ ᱯᱷᱟᱭᱱᱟᱞ ᱠᱚ ᱪᱟᱞᱟᱜᱼᱟ ᱾ ᱟᱨ ᱫᱚᱥᱟᱨ ᱟᱨ ᱛᱮᱥᱟᱨ ᱴᱷᱟᱶ ᱟᱢᱮᱴ ᱦᱟᱠᱟᱫ ᱫᱚᱲ ᱠᱚᱫᱚ ᱠᱨᱚᱥ ᱚᱵᱷᱚᱨ ᱠᱚ ᱮᱱᱮᱡᱼᱟ, ᱡᱟᱦᱟᱸᱨᱮ ᱢᱤᱫ ᱫᱷᱟᱣ ᱮᱢ ᱦᱟᱨᱟᱣ ᱮᱱ ᱠᱷᱟᱱ ᱡᱮᱜᱮᱛ ᱠᱚᱯ ᱠᱷᱚᱱ ᱮᱢ ᱩᱰᱩᱠᱚᱜᱼᱟ ᱾ ᱡᱮᱜᱮᱛ ᱦᱚᱠᱤ ᱨᱤᱱ ᱑᱖ ᱜᱚᱴᱟᱝ ᱫᱤᱥᱚᱢ ᱤᱫᱤ ᱠᱟᱛᱮᱫ ᱑᱙ ᱫᱤᱱ ᱫᱷᱟᱹᱵᱤᱡ ᱪᱟᱞᱟᱣᱠᱟᱱ ᱦᱮᱯᱨᱟᱣ ᱨᱮ ᱓᱖ ᱜᱚᱴᱟᱝ ᱢᱮᱪ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱒᱘ ᱠᱷᱚᱱ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱙ ᱫᱷᱟᱹᱵᱤᱡ ᱒᱔ ᱜᱚᱴᱟᱜ ᱞᱤᱜ ᱢᱮᱪ ᱾ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱑᱐ ᱟᱨ ᱑᱑ ᱨᱮ ᱔ᱭᱟᱹ ᱠᱨᱚᱥ ᱚᱵᱷᱚᱨ ᱢᱮᱪ ᱮᱱᱮᱡᱚᱜᱼᱟ ᱑᱒ ᱟᱨ ᱑᱓ ᱨᱮ ᱠᱣᱟᱴᱚᱨ ᱯᱷᱟᱭᱱᱟᱞ ᱢᱮᱪ ᱮᱱᱮᱡᱚᱜᱼᱟ ᱾ ᱑᱕ ᱨᱮ ᱵᱟᱨᱭᱟ ᱥᱮᱢᱤ ᱯᱷᱟᱭᱱᱟᱞ ᱟᱨ ᱑᱖ ᱨᱮ ᱛᱮᱥᱟᱨ ᱴᱷᱟᱶ ᱟᱨ ᱯᱷᱟᱹᱭᱱᱟᱞ ᱢᱮᱪ ᱮᱱᱮᱡᱚᱜᱼᱟ ᱾",
        "ᱥᱟᱨᱡᱚᱢ ᱵᱟᱦᱟ ᱫᱚ ᱵᱚᱝᱜᱟ ᱠᱟᱛᱮ ᱮᱱᱟᱝ ᱠᱚ ᱵᱟᱦᱟᱭᱟ ᱾",
        "ᱱᱤᱡᱮ ᱵᱟᱪᱷᱟᱣᱟᱜ ᱥᱚᱨᱮᱥ ᱠᱟᱹᱡᱦᱱᱤ, ସ୍ୱନିର୍ବାଚିତ ଶ୍ରେଷ୍ଠ ଗଳ୍ପ, ୧୯୯୪",
        "ᱦᱚᱨᱤᱭᱟᱬᱟ ᱫᱚ ᱠᱚᱧᱮ ᱥᱤᱧᱚᱛ ᱨᱮ ᱢᱮᱱᱟᱜ ᱞᱮᱸᱰᱞᱚᱠ ᱯᱚᱱᱚᱛ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱟᱴᱮᱫ ᱒᱗°᱓᱙' ᱮᱛᱚᱢ ᱠᱷᱚᱱ ᱓᱐°᱓᱕' ᱮᱛᱚᱢ ᱦᱟᱹᱵᱤᱡ ᱨᱮᱱᱟᱜ ᱟᱠᱷᱭᱟᱸᱥᱚ ᱦᱟᱹᱵᱤᱡ, ᱟᱨ ᱗᱔°᱒᱘' ᱥᱟᱢᱟᱝ ᱠᱷᱚᱱ ᱗᱗°᱓᱖' ᱥᱟᱢᱟᱝ ᱦᱟᱹᱵᱤᱡ ᱢᱮᱱᱜᱼᱟ ᱾ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱥᱤᱢᱟᱹ ᱠᱚᱧᱮ ᱨᱮ ᱦᱤᱢᱟᱪᱚᱞ ᱯᱨᱚᱫᱮᱥ ᱦᱟᱹᱵᱤᱡ, ᱮᱛᱚᱢ ᱟᱨ ᱯᱟᱪᱮ ᱨᱮ ᱨᱟᱡᱚᱥᱛᱷᱟᱱ ᱥᱟᱶ ᱵᱷᱤᱲᱟᱹᱣ ᱟᱠᱟᱱᱟ ᱾ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱮᱨᱤᱭᱟ ᱫᱚ ᱔᱔,᱒᱑᱒ ᱜᱟᱺᱴ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱢᱮᱱᱟᱜᱼᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱞᱮᱠᱷᱟ ᱜᱩᱴ ᱮᱨᱤᱭᱟ ᱨᱮᱱᱟᱜ ᱑ᱹ᱔ ᱥᱟᱭᱠᱚᱨᱟ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱮᱨᱤᱭᱟ ᱞᱮᱠᱟᱛᱮ ᱱᱚᱶᱟ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱒᱑ ᱟᱱᱟᱜ ᱢᱟᱨᱟᱝ ᱯᱚᱱᱚᱛ ᱠᱟᱱᱟ ᱾ ᱥᱟᱹᱢᱩᱫᱽ ᱚᱛ ᱠᱷᱚᱱ ᱦᱚᱨᱤᱭᱟᱬᱟ ᱫᱚ ᱗᱐᱐ ᱢᱤᱴᱚᱨ ᱠᱷᱚᱱ ᱓᱖᱐᱐ ᱯᱷᱩᱴ ᱩᱥᱩᱞ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "List of One Day International cricket records",
        "ᱚᱲᱟᱜ ᱵᱷᱤᱛᱤᱨ ᱥᱴᱟᱰᱤᱭᱚᱢ ᱺ ᱱᱚᱰᱮ ᱢᱤᱫ ᱚᱲᱟᱜ ᱵᱷᱤᱛᱤᱨ ᱵᱮᱰᱢᱤᱱᱴᱚᱱ ᱟᱨ ᱴᱮᱵᱩᱞ ᱴᱮᱱᱤᱥ ᱥᱴᱟᱰᱤᱭᱤᱢ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱱᱚᱰᱮ ᱱᱟᱦᱟᱜ ᱯᱷᱮᱥᱤᱞᱤᱴᱤ ᱢᱮᱱᱟᱜ-ᱟ ᱾",
        "ᱯᱷᱩᱞᱮᱥᱚᱨᱤ ᱫᱚ ᱟᱦᱳᱢ ᱨᱟᱡᱟ ᱥᱤᱣ ᱥᱤᱝᱦᱚ ᱨᱮᱱ ᱢᱟᱨᱟᱝ ᱨᱟ.ᱱᱤ ᱛᱟᱦᱮ ᱠᱟᱱᱟ। ᱟᱦᱳᱢ ᱨᱟᱡᱚᱥᱴᱤᱭᱮ ᱥᱟᱥᱚᱱ ᱞᱮᱫ ᱩᱱᱤ ᱯᱟ.ᱦᱤᱞ ᱢᱟᱭᱡᱤᱣᱮ ᱛᱟᱦᱮ ᱠᱟᱱᱟ। ᱯᱟ.ᱦᱤᱞ ᱩᱱᱤ ᱫᱚ ᱫᱮᱨᱜᱟᱶ ᱨᱮ ᱱᱟᱪᱚᱱᱤᱭᱟ.ᱭ ᱛᱟᱦᱮ ᱠᱟᱱᱟ। ᱟᱥᱚᱞ ᱧᱩᱛᱩᱢ ᱫᱚ ᱛᱟᱦᱮ ᱠᱟᱱ ᱛᱟᱭᱟ ᱯᱷᱩᱞᱢᱩᱛᱤ। ᱥᱤᱣ ᱥᱤᱝᱦᱚ ᱩᱱᱤ ᱨᱮ ᱠᱟᱛᱮ ᱵᱟᱯᱞᱟ ᱞᱮᱫᱮᱭᱟᱭ। ᱛᱟᱭᱚᱢ ᱛᱮ ᱡᱚᱛᱤᱥ ᱠᱚᱣᱟᱜ ᱵᱷᱚᱵᱤᱥᱚ ᱵᱟᱱᱤ ᱛᱮ ᱵᱚᱛᱚᱨ ᱠᱟᱛᱮ ᱥᱤᱣ ᱥᱤᱝᱦᱚ ᱫᱚ ᱡᱚᱛᱚ ᱥᱟᱥᱚᱱ ᱫᱟᱭᱤᱠ ᱯᱷᱩᱞᱮᱥᱚᱨᱤ ᱡᱤᱢᱟ. ᱠᱟᱫᱟ। ᱠᱟᱲᱟ ᱥᱟᱠᱛᱚ ᱫᱷᱚᱨᱚᱢ ᱟᱱ ᱯᱷᱩᱞᱮᱥᱚᱨᱤ ᱥᱟᱠᱛᱚ ᱫᱷᱚᱨᱚᱢ ᱨᱟᱡᱚᱥᱴᱤ ᱨᱮᱭᱟᱜ ᱢᱟᱨᱟᱝ ᱦᱩᱭ ᱚᱪᱚᱭ ᱨᱮᱭᱟᱜ-ᱮ ᱠᱩᱨᱩᱢᱩᱴᱩ ᱞᱮᱫᱟ ᱟᱨ ᱱᱚᱣᱟ ᱞᱟ.ᱜᱤᱫ ᱠᱩᱲᱯᱟᱲ ᱞᱮᱫ ᱤᱭᱟ.ᱛᱮ ᱵᱚᱭᱥᱱᱚᱵᱽ - ᱢᱚᱣᱟᱢᱚᱨᱤᱭᱟ ᱠᱚᱫᱚ ᱵᱟᱠᱚ ᱠᱩᱥᱤ ᱞᱮᱱᱟ। ᱱᱚᱣᱟ ᱯᱟᱥᱮᱡ ᱛᱟᱭᱚᱢ ᱫᱟᱨᱟᱢ ᱢᱚᱣᱟᱢᱚᱨᱤᱭᱟ ᱦᱩᱭ ᱥᱮᱝᱜᱮᱞᱮ ᱥᱟᱞᱜᱟᱣ ᱞᱮᱫᱟ।",
        "ᱰᱤᱵᱽᱨᱩ- ᱥᱯᱭᱠᱷᱚᱣᱟ ᱡᱟ.ᱛᱤᱭᱟ.ᱨᱤ ᱵᱟᱜᱽᱣᱟᱱ ᱫᱚ ᱰᱤᱵᱽᱨᱩᱜᱚᱲ ᱟᱨ ᱛᱤᱱᱤᱥᱩᱠᱤᱭᱟ ᱦᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱓᱔᱐ ᱪᱟ.ᱣᱠᱟ. ᱠᱤᱞᱚ ᱢᱤᱴᱟᱨ ᱡᱟᱭᱜᱟ ᱛᱮ ᱴᱚᱯᱟᱨ ᱮᱥᱮᱫ ᱟᱠᱟᱱᱟ।",
        "ᱵᱟᱱᱚ ᱟᱨ ᱨᱟᱹᱣᱩᱞᱠᱮᱞᱟ ᱨᱮᱞ ᱥᱴᱮᱥᱚᱱ ᱥᱩᱨ ᱨᱮ ᱥᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱨᱟᱺᱪᱤ ᱠᱷᱚᱱ ᱥᱤᱢᱰᱮᱜᱟ ᱫᱷᱟᱵᱤᱡ ᱞᱚᱦᱟᱨᱫᱟᱜᱟ ᱟᱨ ᱜᱩᱢᱞᱟ ᱠᱷᱚᱱ ᱢᱤᱫᱴᱟᱝ ᱱᱟᱣᱟ ᱴᱷᱟᱯᱚᱱ ᱟᱠᱟᱱᱟ ᱨᱮᱞ ᱰᱟᱦᱟᱨ ᱥᱚᱦᱚᱨ ᱞᱮᱠᱟᱛᱮ ᱥᱮᱱᱚᱜᱼᱟ",
        "ᱛᱟᱞᱤ ᱠᱟᱴᱷ ᱛᱮ ᱚᱲᱟᱜ ᱨᱮᱱᱟᱜ ᱟᱹᱰᱤ ᱵᱷᱟᱜᱮ ᱵᱚᱨᱜᱟ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱟᱫᱚ ᱛᱟᱞᱤ ᱫᱟᱨᱮ ᱫᱚ ᱟᱹᱰᱤ ᱟᱥᱛᱮ ᱟᱥᱛᱮ ᱦᱟᱨᱟᱜᱼᱟ ᱾ ᱦᱤᱥᱤ ᱪᱮᱬᱮ ᱫᱚ ᱛᱟᱞᱤ ᱫᱟᱨᱮ ᱨᱮ ᱜᱮ ᱡᱟᱹᱥᱛᱤ ᱠᱚ ᱛᱩᱠᱟᱹᱭᱟ ᱾ ᱛᱟᱞᱤ ᱫᱟᱨᱮ ᱫᱚ ᱟᱹᱰᱤᱜᱮ ᱠᱮᱴᱮᱡᱼᱟ ᱾ ᱚᱱᱟᱛᱮ ᱟᱹᱰᱤ ᱠᱟᱡᱟᱠ ᱦᱚᱭ ᱫᱟᱜ ᱨᱮ ᱦᱚᱸ ᱵᱟᱝ ᱵᱷᱤᱸᱫᱟᱹᱲᱚᱜᱼᱟ ᱾",
        "ᱨᱟᱡᱽᱦᱚᱨᱟ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮ ᱯᱟᱞᱟᱢᱩ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱱᱚᱜᱚᱨ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱟᱡᱟᱜ ᱛᱟᱞᱩᱠᱟ (ᱟᱯᱚᱫᱽᱣᱟ ᱵᱚᱱᱚᱛ) ᱦᱮᱰᱠᱩᱣᱟᱴᱚᱨ ᱠᱷᱚᱱ ᱓ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱥᱟᱸᱜᱤᱧ ᱨᱮ ᱟᱨ ᱦᱚᱱᱚᱛ ᱦᱮᱰᱠᱩᱣᱟᱴᱚᱨ ᱢᱮᱫᱤᱱᱤᱱᱚᱜᱚᱨ ᱠᱷᱚᱱ ᱑᱘ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱥᱟᱸᱜᱤᱧ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱴᱷᱟᱶ ᱫᱚ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱨᱟᱡᱽᱰᱟᱦᱟᱨ ᱑᱓᱙ (ᱥᱤᱧᱚᱛ) ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱯᱷᱮᱢᱚᱥ ᱟᱠᱟᱱᱟ ᱾ ᱡᱚᱵᱽᱡᱤ ᱧᱩᱛᱩᱢᱟᱜ ᱜᱟᱰᱟ ᱫᱷᱟᱨᱮ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱢᱟᱱᱚᱵᱮᱱᱫᱨᱚ ᱱᱟᱨᱟᱭᱚᱱ ᱞᱟᱨᱢᱟ (ᱡᱟᱱᱟᱢ:᱑᱕ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ ᱑᱙᱓᱙-ᱵᱚᱸᱜᱟ ᱛᱟᱞᱟ:᱑᱐ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱑᱙᱘᱓) ᱫᱚ ᱵᱟᱝᱞᱟᱫᱮᱥ ᱨᱮᱱ ᱟᱹᱫᱤᱵᱟᱹᱥᱤ ᱱᱮᱛᱟ ᱟᱨ ᱨᱟᱡᱟᱨᱤ ᱛᱟᱸᱦᱮᱸᱠᱟᱱᱟ᱾",
        "᱒᱐᱑᱓ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱫᱷᱩᱢ ᱼ᱓ ᱯᱷᱤᱞᱢ ᱚᱨᱥᱚᱝ ᱛᱮ ᱫᱷᱩᱢᱼ᱓ ᱧᱩᱛᱩᱢ ᱛᱮᱜᱮ ᱢᱤᱫ ᱟᱱᱰᱨᱳᱭᱮᱰ ᱜᱮᱢ ᱡᱟᱦᱟᱸ ᱥᱮᱨᱢᱟ ᱯᱷᱤᱞᱤᱢ ᱨᱤᱞᱤᱡ ᱞᱮᱱᱟ ᱵᱟᱡᱟᱨ ᱛᱮ ᱚᱱᱟ ᱥᱮᱨᱢᱟ ᱚᱱᱟ ᱟᱱᱰᱨᱳᱭᱮᱰ ᱜᱮᱢ ᱦᱚᱸ ᱦᱮᱡ ᱞᱮᱱᱟ .",
        "ᱱᱚᱣᱟ ᱫᱚ ᱦᱮᱢᱟᱞ ᱵᱩᱨᱩ ᱨᱮᱭᱟᱜ ᱨᱮᱭᱤᱝ ᱠᱷᱚᱱ ᱥᱩᱨ ᱥᱩᱯᱩᱨ ᱕᱖ ᱠᱤᱞᱚ ᱢᱤᱴᱚᱨ ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱢᱮᱱᱟᱜ-ᱟ ᱾ ᱥᱟᱸᱜᱷᱟᱨᱤᱭᱟᱹ ᱠᱚ ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱫᱚ ᱟᱹᱰᱤ ᱠᱚ ᱠᱩᱥᱤᱭᱟᱜ-ᱟ ᱪᱮᱫᱟᱜ ᱥᱮ ᱱᱚᱣᱟ ᱨᱮᱭᱟᱜ ᱥᱟᱺᱜᱤᱧ ᱫᱷᱟᱹᱵᱤᱡ ᱯᱟᱥᱱᱟᱣ ᱟᱠᱟᱱ ᱛᱟᱥᱟᱫ ᱨᱮᱭᱟᱜ ᱢᱟᱴ ᱥᱟᱸᱜᱷᱟᱨᱤᱭᱟᱹ ᱠᱚᱣᱟᱜ ᱢᱚᱱᱮᱭ ᱢᱩᱦᱤᱛ ᱩᱛᱟᱹᱨᱟ ᱾ ᱨᱟᱵᱟᱝ ᱫᱤᱱ ᱫᱚ ᱱᱚᱰᱮ ᱵᱚᱨᱚᱯᱷᱡᱟᱹᱲᱤ ᱨᱮᱭᱟᱜ ᱨᱟᱹᱥᱠᱟᱹ ᱦᱚᱸ ᱦᱟᱛᱟᱣ ᱜᱟᱱᱚᱜ-ᱟ ᱾ ᱰᱤᱥᱮᱢᱵᱚᱨ-ᱢᱟᱨᱪ ᱨᱮ ᱱᱚᱰᱮ ᱫᱚ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱵᱚᱨᱚᱯᱷᱡᱟᱹᱲᱤ ᱦᱩᱭᱩᱜ-ᱟ ᱾ ᱚᱱᱟ ᱚᱠᱛᱚᱨᱮ ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱫᱚ ᱫᱤᱱ ᱥᱟᱨᱟ ᱥᱟᱹᱱᱛᱤ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱵᱚᱨᱚᱯᱷᱡᱟᱹᱲᱤ ᱚᱠᱛᱚ ᱨᱮ ᱱᱚᱰᱮᱱᱟᱜ ᱪᱮᱦᱨᱟᱱ ᱧᱮᱞ ᱡᱚᱝ ᱞᱟᱭᱚᱠ ᱛᱟᱦᱮᱸᱱᱟ ᱾ ᱨᱮᱭᱤᱝ ᱠᱷᱚᱱ ᱱᱚᱰᱮ ᱫᱷᱟᱹᱵᱤᱡ ᱫᱚ ᱥᱩᱢᱩᱝ ᱟᱫᱷᱟ ᱜᱷᱚᱱᱴᱟ ᱨᱮᱜᱮ ᱥᱮᱴᱮᱨ ᱜᱟᱱᱚᱜ-ᱟ ᱾ ᱥᱟᱸᱜᱷᱟᱨᱤᱭᱟᱹ ᱠᱚ ᱡᱤᱨᱟᱹᱣᱜ ᱞᱟᱹᱜᱤᱫ ᱱᱚᱰᱮ ᱫᱚ ᱟᱹᱰᱤᱜᱟᱱ ᱜᱮᱥᱴ ᱦᱟᱣᱩᱥ ᱦᱚᱸ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱜᱮᱥᱴ ᱦᱟᱣᱩᱥ ᱠᱷᱚᱱ ᱱᱟᱥᱮ ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱥᱟᱸᱜᱷᱟᱨᱤᱭᱟᱹ ᱠᱚ ᱵᱟᱱᱟ, ᱵᱤᱨ ᱢᱮᱨᱚᱢ ᱟᱨ ᱩᱰᱟᱹᱣᱜ ᱠᱟᱱ ᱛᱩᱲ ᱦᱚᱸᱠᱚ ᱧᱮᱞ ᱫᱟᱲᱮᱭᱟ ᱠᱚᱣᱟ ᱾",
        "Little help matters. Intention counts. Attitude counts.",
        "᱒᱐᱑᱑ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱥᱤᱧᱚᱛ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟ ᱛᱮ, ᱱᱚᱶᱟ ᱦᱚᱱᱚᱛ ᱨᱮ ᱥᱟᱭ ᱠᱟᱲᱟ ᱕᱓.᱐᱘% ᱦᱚᱲ ᱫᱚ ᱢᱟᱨᱟᱴᱷᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱒᱑.᱙᱖% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱦᱤᱱᱫᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱗.᱖᱘% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱩᱲᱫᱩ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱔.᱖᱕% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱜᱩᱡᱽᱨᱟᱛᱤ ᱯᱟᱹᱨᱥᱤ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱒.᱓᱕% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱵᱷᱤᱞ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱒.᱑᱑% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱥᱤᱱᱫᱷᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱑.᱓᱓% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱛᱮᱞᱩᱜᱩ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱑.᱒᱙% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱢᱟᱞᱟᱭᱟᱞᱟᱢ ᱑.᱒᱘% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱠᱟᱱᱱᱟᱰᱟ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ ᱑.᱐᱓% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱵᱮᱸᱜᱟᱞᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ 0.᱙᱗% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱛᱟᱢᱤᱞ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱥᱟᱭ ᱠᱟᱲᱟ 0.᱕0% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱯᱟᱸᱡᱟᱵᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ, ᱟᱨ ᱥᱟᱨᱮᱡ 0.᱔᱑% ᱦᱤᱸᱥ ᱦᱚᱲ ᱫᱚ ᱛᱩᱞᱩ ᱯᱟᱹᱨᱥᱤ ᱟᱠᱚᱣᱟᱜ ᱜᱚᱜᱚ ᱯᱟᱹᱨᱥᱤ ᱢᱮᱱ ᱛᱮ ᱠᱚ ᱞᱟᱲᱪᱟᱲ ᱮᱫᱟ ᱾",
        "Baur, Susan (1997), The Intimate Hour: Love and Sex in Psychotherapy. Boston: Houghton-Mifflin Co. viii, 309 p.",
        "ᱢᱩᱣᱤ ᱢᱚᱥᱟᱞᱟ - ᱦᱤᱸᱫᱤ ᱯᱷᱤᱞᱢ ᱠᱚᱨᱮ ᱥᱮ ᱵᱚᱞᱤᱣᱩᱰ ᱠᱷᱚᱱ ᱥᱟᱹᱜᱟᱹᱭ ᱯᱨᱚᱜᱨᱟᱢ᱾",
        "ᱡᱷᱩᱞᱚᱬ ᱜᱳᱥᱣᱟᱢᱤ, ᱠᱨᱤᱠᱮᱴ - ᱞᱟ.ᱜᱤᱱ ᱚᱨᱡᱩᱱ ᱟᱣᱟᱰ ᱧᱟᱢ ᱞᱮᱟᱭ ᱾",
        "ᱱᱚᱣᱟ ᱜᱚᱝᱜᱷᱚᱨ ᱫᱚ ᱪᱟᱭᱱᱤᱡᱽ ᱛᱮ ᱦᱟᱡᱟᱨ ᱵᱩᱫᱷᱚᱣᱟᱜ ᱜᱚᱝᱜᱷᱚᱨ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱱᱚᱰᱮ ᱟᱹᱰᱤ ᱜᱟᱱ ᱵᱩᱫᱷᱚ ᱢᱩᱨᱛᱤ ᱢᱮᱱᱟᱜ ᱠᱷᱟᱹᱛᱤᱨ ᱟᱨ ᱠᱟᱸᱛ ᱨᱮᱦᱚᱸ ᱟᱹᱰᱤ ᱜᱟᱱ ᱵᱩᱫᱷᱚᱣᱟᱜ ᱪᱤᱛᱟᱹᱨ ᱢᱮᱱᱟᱜ ᱠᱷᱟᱹᱛᱤᱨ ᱱᱚᱣᱟ ᱫᱚ ᱦᱟᱡᱟᱨ ᱵᱩᱫᱷᱚᱣᱟᱜ ᱜᱚᱝᱜᱷᱚᱨ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱢᱟᱜᱟᱣ ᱜᱚᱝᱜᱷᱚᱨ ᱧᱩᱛᱩᱢ ᱫᱳ ᱛᱟᱝ ᱨᱟᱡᱽᱵᱤᱝᱥᱚ ᱨᱮᱠᱚ ᱵᱮᱵᱷᱟᱨᱟ ᱾ ᱚᱱᱰᱮ ᱢᱟᱜᱟᱣ () ᱨᱮᱭᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱚ ᱥᱟᱥᱚᱱ ᱦᱚᱱᱚᱛ ᱢᱮᱱᱛᱮ ᱵᱩᱡᱷᱟᱹᱜ-ᱟ ᱾ ᱢᱟᱜᱟᱣ ᱨᱮᱭᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱳ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱚᱛᱩᱲᱚᱱᱤᱭᱚ ᱵᱟᱝᱢᱟ ᱡᱟᱦᱟᱸ ᱨᱮᱭᱟᱜ ᱛᱩᱞᱟᱹ ᱫᱚ ᱚᱠᱟ ᱥᱟᱶ ᱦᱚᱸ ᱵᱟᱝ ᱦᱩᱭ ᱡᱠᱮᱭᱟ ᱾ \"ᱢᱚ\" ᱨᱮᱭᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ \"ᱚᱠᱟ ᱦᱚᱸ ᱵᱟᱝ\" ᱟᱨ \"ᱜᱟᱣ\" ᱨᱮᱭᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ \"ᱩᱥᱩᱞ\" ᱾ ᱮᱴᱟᱜ ᱞᱮᱠᱮ ᱧᱮᱞ ᱞᱮᱠᱷᱟᱱ \"ᱵᱟᱹᱞᱤ ᱚᱛ ᱨᱮ ᱩᱥᱩᱞ\" ᱢᱮᱱᱛᱮ ᱵᱩᱡᱷᱟᱹᱜ-ᱟ ᱠᱟᱨᱚᱱ \"ᱢᱚ\" ᱨᱮᱭᱟᱜ ᱪᱟᱭᱱᱤᱡᱽ ᱢᱮᱱᱮᱛ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱵᱟᱹᱞᱤ ᱚᱛ ᱾ ᱢᱟᱜᱟᱣ ᱧᱩᱛᱩᱢ ᱦᱚᱸ ᱫᱩᱱᱦᱩᱣᱟᱝ ᱵᱟᱡᱟᱨ ᱨᱮᱱ ᱦᱚᱲ ᱫᱚ ᱱᱟᱦᱟᱜ ᱵᱟᱡᱟᱨ ᱞᱟᱹᱜᱤᱫ ᱠᱚ ᱵᱮᱵᱷᱟᱨᱟ ᱾ (). ᱫᱩᱱᱦᱩᱣᱟᱝ ᱨᱮᱭᱟᱜ ᱜᱚᱝᱜᱷᱚᱨ ᱠᱚᱦᱚᱸ ᱢᱟᱜᱟᱣ ᱜᱤᱝᱜᱷᱚᱨ ᱜᱨᱠᱚ ᱢᱮᱛᱟᱜ-ᱟ ᱾ ᱱᱚᱰᱮ ᱢᱟᱜᱟᱣ ᱜᱚᱝᱜᱷᱚᱨ ᱨᱮᱭᱟᱜ ᱢᱮᱱᱮᱛ ᱫᱩ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ \"ᱡᱷᱟᱞᱠᱟᱜ ᱠᱟᱱ ᱫᱤᱯ\" ᱾ ᱱᱚᱰᱮᱱ ᱠᱚ ᱱᱟᱢᱟᱫᱤᱠ ᱟᱹᱫᱤᱵᱟᱹᱥᱤ ᱫᱚ ᱵᱟᱹᱭᱨᱤ ᱠᱷᱚᱱ ᱥᱚᱱᱛᱚᱨ ᱛᱟᱦᱮᱸᱱ ᱞᱟᱹᱜᱤᱫ ᱥᱟᱢᱟᱝ ᱨᱮ ᱱᱚᱣᱟ ᱫᱤᱯ ᱠᱚ ᱡᱩᱞ ᱠᱟᱜ-ᱟ ᱾ ᱫᱩᱱᱦᱩᱣᱟᱝ ᱜᱚᱝᱜᱷᱚᱨ ᱢᱮᱱ ᱞᱮᱠᱷᱟᱱ ᱫᱩᱱᱦᱩᱣᱟᱝ ᱤᱞᱟᱹᱠᱟ ᱨᱮ ᱢᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱜᱚᱝᱜᱷᱚᱨ ᱵᱩᱡᱷᱟᱹᱜ-ᱟ ᱾",
        "ᱟᱡ ᱢᱟᱢᱚ ᱦᱟᱲᱟᱢ ᱵᱮᱫ ᱯᱨᱚᱠᱟᱥ ᱥᱟᱱᱤ ᱫᱚ ᱢᱤᱫ ᱟᱛᱷᱽᱞᱮᱴᱥ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱤᱱᱰᱤᱭᱟ ᱞᱟ.ᱜᱤᱫ ᱠᱚ ᱠᱷᱮᱞ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱛᱚᱵᱮ ᱱᱩᱭ ᱫᱚ ᱠᱨᱤᱠᱮᱴ ᱠᱚᱢᱮᱱᱴᱮᱴᱚᱨ ᱦᱚᱸ ᱠᱟᱢᱤ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾",
        "ᱱᱚᱶᱟ ᱵᱟᱡᱟᱨ ᱨᱮᱫᱚ ᱚᱱᱚᱲᱦᱤᱭᱟᱹ ᱜᱳᱯᱟᱞ ᱥᱤᱝ ᱱᱮᱯᱟᱲᱤᱭᱟᱜ ᱡᱟᱱᱟᱢ ᱫᱤᱥᱚᱢ ᱠᱟᱱᱟ᱾ᱫᱤᱥᱚᱢ ᱜᱚᱢᱠᱮ ᱨᱟᱡᱮᱱᱫᱨᱚ ᱯᱨᱚᱥᱟᱫ,ᱚᱱᱩᱜᱨᱚᱦᱚ ᱱᱟᱨᱟᱭᱚᱬ ᱥᱤᱱᱦᱟᱸ,ᱟᱨ ᱵᱨᱚᱡᱚᱠᱤᱥᱚᱨ ᱯᱨᱚᱥᱟᱫ ᱥᱟᱶ ᱜᱟᱺᱫᱷᱤ ᱵᱟᱵᱟ ᱤᱥᱟᱞ ᱑᱙᱑᱗ ᱨᱮ ᱱᱚᱸᱰᱮ ᱪᱚᱢᱯᱟᱨᱚᱱ ᱥᱚᱛᱭᱟᱜᱨᱚᱦᱚ ᱟᱱᱫᱚᱞᱚᱱ ᱥᱮ ᱦᱩᱞ ᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱫᱟ᱾",
        "᱒᱐᱑᱑ ᱥᱮᱨᱢᱟ ᱨᱮᱭᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟ ᱛᱮ ᱡᱷᱟᱨᱠᱷᱟᱱᱰ ᱯᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱜᱮᱞ ᱯᱚᱱ ᱜᱚᱴᱟᱝ ᱯᱚᱱᱚᱛ ᱨᱮ ᱱᱟᱱᱛᱟᱞᱤ ᱯᱟ.ᱨᱥᱤ ᱨᱚᱨᱚᱲ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱫᱚ ᱱᱚᱝᱠᱟ ᱞᱮᱠᱟ -",
        "ᱚᱭᱥᱟᱬᱮᱥᱣᱚᱨ ᱥᱤᱵᱚ ᱡᱩᱸᱫᱽᱨᱤ ᱫᱚ ᱑᱓ ᱜᱚᱴᱟᱝ ᱟᱜ ᱥᱟᱭᱚᱛ ᱨᱮᱭᱟᱜ ᱦᱤᱱᱫᱩ ᱢᱩᱸᱫᱽᱨᱤ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱵᱷᱚᱜᱽᱵᱟᱱ ᱥᱤᱵᱚ ᱠᱚ ᱵᱚᱝᱜᱟᱻᱟᱭ ᱠᱟᱱᱟ ᱾ ᱚᱭᱥᱟᱬᱮᱥᱣᱚᱨ ᱥᱤᱵᱚ ᱡᱩᱸᱫᱽᱨᱤ ᱫᱚ ᱳᱰᱤᱥᱟ ᱨᱮᱭᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱵᱷᱩᱵᱽᱱᱮᱥᱚᱨ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱢᱩᱸᱫᱽᱨᱤ ᱫᱚ ᱢᱩᱱᱤᱥᱤᱯᱟᱞ ᱠᱚᱨᱯᱳᱨᱮᱥᱚᱱ ᱦᱚᱥᱯᱤᱴᱟᱞ,ᱥᱨᱤ ᱱᱚᱜᱚᱨ,ᱳᱞᱰ ᱴᱚᱣᱩᱱ ᱵᱟᱲᱜᱮ ᱵᱷᱤᱛᱤᱨ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱞᱤᱝᱜᱚᱨᱟᱡᱽ ᱢᱩᱸᱫᱽᱨᱤ ᱫᱷᱟᱨᱮ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱥᱚᱢᱤ ᱟᱨ ᱯᱟᱱᱽᱱᱟ ᱠᱟᱭᱥᱟᱨ᱒᱐᱐᱙,᱑᱙ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱾ the daily star",
        "ᱯᱨᱮᱨᱚᱬᱟ ᱫᱮᱥᱯᱟᱱᱰᱮ (ᱤᱝᱞᱤᱥ Prerana Deshpande) ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱤᱱᱤᱡ ᱧᱩᱛᱩᱢᱟᱱ ᱠᱚᱛᱷᱚᱱ ᱱᱟᱪᱚᱱᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱾ ᱯᱨᱮᱨᱚᱬᱟ ᱫᱚ ᱮᱭᱟᱭ ᱵᱚᱪᱷᱚᱨ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱜᱮ ᱥᱚᱨᱚᱫᱤᱱᱤ ᱜᱚᱞᱮ ᱭᱟᱜ ᱟ/ᱝᱜᱤᱵᱷᱟᱨ ᱛᱮ ᱠᱚᱛᱷᱚᱠ ᱮᱱᱮᱡ ᱪᱮᱫᱚᱜ ᱮ ᱮᱦᱚᱵ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱜᱮᱞ ᱢᱚᱬᱮ ᱥᱮᱨᱢᱟᱭ ᱦᱩᱭᱮᱱ ᱛᱟᱭᱚᱢ ᱯᱩᱭᱞᱩ ᱫᱷᱟᱣ ᱢᱟᱸᱰᱣᱟ ᱨᱮ ᱮᱱᱮᱡ ᱮ ᱥᱚᱫᱚᱨ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱜᱩᱨᱩ ᱪᱮᱞᱟ ᱦᱟᱜ ᱯᱟᱹᱨᱛᱩᱲ ᱞᱮᱠᱟᱛᱮ ᱨᱚᱦᱤᱬᱤ ᱵᱷᱟᱴᱮ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱠᱚᱛᱷᱚᱠ ᱮᱱᱮᱡ , ᱞᱚᱠᱷᱱᱚ ᱟᱨ ᱡᱚᱭᱯᱩᱨ ᱜᱷᱚᱨᱟᱱᱟ ᱠᱷᱚᱱ ᱒᱒ ᱥᱮᱨᱢᱟ ᱦᱟᱹᱵᱤᱡ ᱮ ᱥᱮᱪᱮᱫ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱡᱟᱜ ᱥᱚᱨᱮᱥ ᱮᱱᱮᱡ ᱥᱚᱫᱚᱨ ᱠᱷᱟᱹᱛᱤᱨ ᱩᱯᱨᱩᱢ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱛᱟᱭᱟ ᱟᱨ ᱠᱷᱮᱞᱚᱸᱰ ᱞᱮᱠᱟᱱ ᱟᱭᱢᱟ ᱠᱚᱛᱷᱚᱠ ᱜᱩᱱ ᱨᱮ ᱯᱟᱹᱨᱩᱠᱷᱤᱭᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "The Hindu : Metro Plus Tiruchirapalli / Personality : Art for peace",
        "ᱭᱟᱢᱤᱱᱤ ᱠᱨᱤᱥᱱᱟᱢᱩᱨᱛᱤ ᱫᱚ ᱑᱙᱕᱗ ᱨᱮ ᱢᱟᱰᱨᱟᱥ ᱨᱮᱭ ᱰᱮᱵᱽᱭᱩ ᱠᱮᱫ-ᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱛᱤᱨᱩᱢᱟᱞᱟ ᱛᱤᱨᱩᱯᱚᱛᱤ ᱫᱮᱵᱚᱥᱛᱷᱟᱱᱚᱢ ᱨᱤᱱᱤᱡ ᱚᱥᱛᱷᱟᱱᱟ ᱱᱟᱪᱚᱱᱤᱭᱟᱹ (ᱚᱸᱰᱮᱱᱤᱡ ᱱᱟᱪᱚᱱᱤᱭᱟᱹ) ᱞᱮᱠᱟᱛᱮ ᱢᱟᱹᱱ ᱮ ᱟᱢᱮᱴ ᱟᱠᱟᱫ-ᱟ ᱾ ᱛᱤᱱᱟᱹᱝ ᱜᱟᱞᱚᱪᱤᱭᱟᱹ ᱫᱚ ᱱᱚᱶᱟ ᱠᱚ ᱧᱮᱞ ᱟᱠᱟᱫ-ᱟ ᱡᱮ ᱭᱟᱢᱤᱱᱤᱭᱟᱜ ᱮᱱᱮᱡ ᱫᱚ ᱨᱤᱫᱚᱢᱤᱠ ᱯᱷᱤᱜᱚᱨ ᱮ ᱩᱫᱩᱜ ᱥᱚᱫᱚᱨᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱠᱩᱪᱤᱯᱩᱰᱤ ᱮᱱᱮᱡ ᱨᱤᱱᱤᱡ ᱴᱚᱪ ᱵᱤᱭᱮᱨᱚᱨ ᱢᱮᱱᱛᱮ ᱦᱚᱸ ᱵᱷᱟᱹᱜᱤ ᱩᱯᱨᱩᱢ ᱢᱮᱱᱟᱜ ᱛᱟᱭ ᱛᱟᱦᱮᱸᱫ ᱾",
        "ᱱᱚᱢᱨᱚᱛᱟ ᱨᱟᱭ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟ. ᱠᱚᱛᱷᱚᱠ ᱠᱞᱟᱥᱤᱠᱟᱞ ᱰᱮᱱᱥᱚᱨ ᱟᱨ ᱠᱳᱨᱤᱭᱳᱜᱨᱟᱯᱷᱚᱨ ᱠᱟᱱᱟᱭ ᱾ ᱟᱡ ᱫᱚ ᱜᱩᱨ ᱟᱠᱟᱱ ᱰᱨ. ᱢᱚᱫᱷᱩᱠᱚᱨ ᱟᱱᱚᱱᱫ (Dr. Madhukar Anand) ᱟᱨ ᱯᱚᱸᱰᱤᱛ ᱩᱫᱚᱭ ᱢᱚᱡᱩᱢᱫᱟᱨ (Pt. Udai Mazumdar) ᱣᱤᱡ ᱪᱮᱞᱟ ᱠᱟᱱᱟᱭ ᱾",
        "ᱠᱩᱲᱤ ᱵᱚᱝᱜᱟ ᱡᱟᱱᱟᱝ ᱟᱜ ᱦᱤᱱᱫᱩ ᱫᱷᱚᱨᱚᱢ ᱴᱟᱞᱟ ᱨᱮ ᱟᱹᱰᱤ ᱜᱮ ᱠᱮᱴᱮᱡ ᱯᱟᱹᱛᱭᱟᱹᱣ ᱛᱟᱦᱮᱸ ᱢᱮᱱᱟᱜ-ᱟ ,ᱥᱮᱫᱟᱭ ᱠᱦᱚᱱ ᱱᱟᱦᱟᱜ ᱫᱹᱟᱵᱤᱚᱡ ᱡᱚᱛᱚ ᱨᱮᱱᱟᱜ ᱛᱟᱞᱢᱟ ᱨᱮ ᱵᱚᱝᱜᱟ ᱠᱩᱲᱤ ᱜᱮᱢᱱᱟᱜ-ᱟ ᱾",
        "ᱱᱟᱯᱟᱭ ᱵᱟᱞᱚᱠ ᱠᱚᱲᱟᱠᱟᱨ - ᱑᱙᱙᱔ (᱔᱑ ᱜᱚᱴᱟᱝᱼᱟᱜ ᱡᱟ.ᱛᱤᱭᱟ.ᱨᱤ ᱪᱚᱞᱚᱱ ᱪᱤᱛᱟ.ᱨ ᱥᱤᱨᱯᱷᱟ.)",
        "ᱥᱤᱧᱚᱛ ᱨᱮᱭᱟᱜ ᱥᱚᱝᱵᱤᱫᱷᱟᱱ ᱞᱮᱠᱟᱛᱮ ᱥᱤᱧᱚᱛ ᱥᱚᱨᱠᱟᱨᱟᱜ ᱥᱚᱨᱠᱟᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱫᱮᱵᱽᱱᱟᱜᱽᱨᱤ ᱪᱤᱠᱤ ᱛᱮ ᱦᱤᱱᱫᱤ ᱟᱨ ᱨᱳᱢᱟᱱ ᱪᱤᱠᱤ ᱛᱮ ᱤᱝᱞᱤᱥ᱾ ᱥᱚᱝᱵᱤᱫᱷᱟᱱ ᱨᱮ ᱫᱚ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱵᱟᱹᱱᱩᱜᱼᱟ᱾ ᱦᱤᱱᱫᱤ ᱟᱨ ᱤᱝᱞᱤᱥ ᱫᱚ ᱥᱚᱨᱠᱟᱨᱤ ᱱᱟᱱᱟ ᱦᱩᱱᱟᱹᱨ ᱠᱟᱹᱢᱤ ᱨᱮ ᱵᱮᱵᱦᱟᱨ ᱦᱩᱭᱩᱜᱼᱟ, ᱪᱮᱫ ᱞᱮᱠᱟ; ᱥᱚᱝᱥᱚᱫ ᱨᱮ, ᱟᱭᱤᱱ-ᱟᱫᱟᱞᱚᱫ ᱨᱮ ᱯᱚᱱᱚᱛ ᱟᱨ ᱛᱚᱞᱢᱟ ᱥᱚᱨᱠᱟᱨᱟᱜ ᱠᱟᱛᱷᱟ ᱦᱟᱹᱴᱤᱝ ᱨᱮ᱾ ᱯᱚᱱᱚᱛ ᱠᱚ ᱟᱠᱚᱣᱟᱜ ᱥᱚᱨᱠᱟᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱵᱟᱪᱷᱟᱣ ᱨᱮᱭᱟᱜ ᱯᱷᱩᱱᱩᱨᱜᱟᱹᱞ ᱢᱮᱱᱟᱜᱟ᱾ ᱥᱚᱝᱵᱤᱫᱷᱟᱱ ᱨᱮᱭᱟᱜ ᱱᱚᱶᱟ ᱫᱷᱟᱨᱟ ᱞᱮᱠᱟᱛᱮ ᱯᱚᱱᱚᱛ ᱠᱚ ᱛᱚᱞᱢᱟ ᱥᱚᱨᱠᱟᱨᱟᱜ ᱱᱟᱱᱟᱦᱩᱱᱟᱹᱲ ᱠᱟᱹᱢᱤ ᱥᱟᱶ ᱯᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱥᱚᱨᱠᱟᱨᱤ ᱠᱟᱹᱢᱤ ᱨᱮ ᱦᱚ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱵᱮᱵᱦᱟᱨ ᱫᱟᱨᱮᱭᱟᱜ-ᱟ᱾",
        "ᱯᱮᱨᱩ ᱥᱮᱫᱟᱭ ᱫᱚ ᱤᱱᱠᱟ ᱥᱟᱵᱨᱟᱡᱽᱭᱚ ᱨᱮᱭᱟᱜ ᱯᱟᱦᱟᱴᱟ ᱛᱟᱦᱮ ᱠᱟᱱᱟ᱾ ᱑᱖ ᱥᱟᱭ ᱨᱮ ᱤᱱᱠᱟ ᱥᱟᱵᱨᱟᱡᱽᱭᱚ ᱥᱯᱮᱱᱤᱥ ᱴᱷᱮᱱ ᱦᱤᱨᱟᱹᱣ ᱛᱟᱭᱟᱢ ᱱᱚᱶᱟ ᱫᱚ ᱥᱯᱮᱱᱤᱥ ᱩᱯᱚᱱᱤᱵᱮᱥ ᱨᱮ ᱥᱤᱞᱮᱫ ᱞᱮᱱᱟ᱾ ᱟᱱᱫᱮᱥ ᱨᱮᱱᱟᱜ ᱥᱳᱱᱟ ᱟᱨ ᱨᱩᱯᱟᱹ ᱠᱷᱟᱫᱟᱱ ᱧᱮᱞ ᱛᱮ ᱥᱯᱮᱱᱤᱥ ᱱᱚᱶᱟ ᱫᱚ ᱠᱚᱧᱮ ᱟᱢᱮᱨᱤᱠᱟ ᱨᱮᱭᱟᱜ ᱥᱚᱢᱯᱚᱫ ᱟᱨ ᱫᱟᱲᱮ(Energy) ᱨᱮᱭᱟᱜ ᱛᱟᱞᱢᱟ ᱞᱮᱠᱟᱛᱮ ᱠᱚ ᱵᱮᱱᱟᱣ ᱠᱮᱫᱟ᱾ ᱑᱙ ᱥᱟᱭ ᱨᱮᱱᱟᱜ ᱑᱘᱒᱑ ᱥᱮᱨᱢᱟ ᱨᱮ ᱯᱮᱨᱩ ᱮᱥᱯᱮᱱ ᱠᱷᱚᱱ ᱯᱷᱩᱱᱩᱨᱜᱟᱹᱞ ᱞᱮᱫᱟ᱾",
        "ᱯᱨᱚᱫᱷᱟᱱ ᱟᱜ ᱡᱟᱱᱟᱢ ᱫᱚ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮᱱᱟᱜ ᱨᱟᱺᱪᱤ ᱠᱷᱚᱱ ᱖᱐ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱥᱟᱺᱜᱤᱧ ᱟᱹᱫᱤᱵᱟᱹᱥᱤ ᱜᱟᱲ ᱨᱮ ᱠᱷᱩᱸᱴᱤ ᱨᱮᱱᱟᱜ ᱦᱮᱥᱚᱞ ᱟᱹᱛᱩ ᱨᱮ ᱘ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱑᱙᱙᱓ ᱥᱟᱞ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟᱭ ᱾ ᱱᱤᱠᱠᱤ ᱯᱨᱚᱫᱷᱟᱱ ᱫᱚ ᱥᱚᱢᱟ ᱯᱨᱚᱫᱷᱟᱱ (ᱵᱟᱵᱟ) ᱟᱨ ᱡᱤᱛᱚᱱ ᱫᱮᱵᱤ (ᱟᱭᱳ) ᱛᱤᱠᱤᱱᱤᱡ ᱛᱮᱥᱟᱨ ᱵᱤᱴᱤ ᱠᱟᱱᱟᱭ ᱾",
        "ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱚᱥᱟᱨ ᱵᱮᱥᱟᱨ ᱑᱐,᱔᱕᱕ ᱫᱚᱨᱦᱟ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱢᱮᱱᱟᱜᱼᱟ, ᱟᱨ ᱒᱙,᱐᱙,᱕᱑᱖ (᱒᱐᱐᱑ ᱨᱮᱱᱟᱜ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ) ᱨᱤᱱ ᱦᱚᱲ ᱮᱞ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ, ᱱᱚᱣᱟ ᱑᱙᱙᱑ ᱠᱷᱚᱱ ᱒᱐᱐᱑ ᱫᱷᱟᱵᱤᱡ ᱒᱖ᱹ᱑᱔% ᱵᱟᱲᱦᱟᱣ ᱮᱱᱟ ᱠᱚ ᱾ ᱟᱡᱟᱜ ᱞᱩᱜᱽᱲᱤ ᱟᱨ ᱢᱟᱭᱱᱤᱡᱽ ᱤᱱᱰᱟᱥᱴᱨᱤ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱯᱷᱮᱢᱚᱥ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱮᱛᱚᱢ ᱨᱮ ᱟᱡᱽᱢᱮᱨ ᱦᱚᱱᱚᱛ, ᱥᱟᱢᱟᱝ ᱨᱮ ᱵᱩᱱᱫᱤ ᱦᱚᱱᱚᱛ, ᱮᱛᱚᱢ ᱨᱮ ᱪᱤᱛᱛᱚᱨᱜᱚᱲ ᱦᱚᱱᱚᱛ ᱟᱨ ᱯᱟᱪᱮ ᱨᱮ ᱨᱟᱡᱽᱥᱚᱢᱚᱸᱫᱽ ᱦᱚᱱᱚᱛ ᱞᱮᱠᱟᱛᱮ ᱮᱥᱮᱫ ᱟᱠᱟᱱᱟ ᱾ ᱯᱚᱱᱚᱛ ᱨᱟᱡᱽᱰᱟᱦᱟᱨ (ᱡᱚᱭᱯᱩᱨᱼᱩᱫᱚᱭᱯᱩᱨ) ᱦᱚᱱᱚᱛ ᱞᱮᱠᱟᱛᱮ ᱥᱮᱱᱚᱜᱼᱟ, ᱡᱮᱞᱮᱠᱟ ᱘᱔ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱱᱟᱱᱟᱯᱟᱜ ᱢᱤᱫ ᱡᱤᱞᱤᱧ ᱚᱥᱟᱨ ᱜᱮᱡᱽ ᱨᱮᱞᱣᱮ ᱞᱟᱭᱤᱱ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ ᱢᱚᱫᱷᱭᱚ ᱯᱨᱚᱫᱮᱥ ᱨᱣ ᱟᱡᱽᱢᱮᱨ ᱫᱚ ᱠᱷᱚᱸᱰᱣᱟ ᱥᱟᱞᱟᱜ ᱡᱚᱲᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱥᱩᱨ ᱨᱮᱱᱟᱜ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱩᱫᱚᱭᱯᱩᱨ (᱑᱗᱑ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ) ᱨᱣ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱚᱱᱤᱡᱽ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱭᱟᱜ ᱜᱟᱞᱚᱪ ᱥᱴᱮᱡᱽ ᱢᱮᱰᱮᱠᱥ(TEDx) ᱨᱮ ᱜᱟᱞᱚᱪ ᱟᱠᱟᱫᱟ ᱾",
        "ᱯᱷᱤᱞᱢ ᱩᱲᱛᱟ ᱯᱟᱱᱡᱟᱵ (᱒᱐᱑᱖) ᱨᱮᱭᱟᱜ ᱥᱮᱨᱮᱧ \"ᱫᱟ ᱫᱟ ᱫᱟᱥᱥᱮ\" ᱫᱚ ᱩᱱᱤ ᱟ.ᱰᱤ ᱥᱚᱨᱮᱥ silhouette ᱥᱮᱨᱮᱧᱤᱭᱟᱹ ᱨᱮᱱᱟᱜ ᱥᱤᱨᱯᱷᱟᱹ ᱟᱨ ᱱᱟᱢᱟᱸᱠᱟᱱ ᱮ ᱧᱟᱢ ᱠᱮᱫᱟ - ᱤᱱᱟ ᱯᱚᱨᱮ ᱛᱮ ᱩᱱᱤ ᱫᱚ\"ᱵᱮᱤᱢᱟᱱ ᱞᱟᱣ (᱒᱐᱑᱖) ᱨᱮᱱᱟᱜ ᱦᱟᱜ ᱢᱤ ,ᱞᱩᱤᱥ ᱞᱮᱴᱴᱚᱨ ᱥᱮᱨᱮᱧ ᱥᱮᱨᱮᱧ ᱮ ᱥᱮᱨᱮᱧ ᱞᱮᱫ ᱛᱟᱦᱮᱱ᱾ ᱯᱷᱤᱞᱢ ᱫᱟ ᱞᱤᱡᱮᱸᱰ ᱚᱯᱷ ᱢᱟ.ᱭᱠᱟᱞ ᱢᱤᱥᱨᱟ (᱒᱐᱑᱖) ᱟᱨ ᱯᱷᱤᱞᱢ ᱮ ᱯᱷᱞᱟᱭᱤᱝ ᱡᱚᱴᱴ (᱒0᱑᱖) ᱠᱷᱚᱱ\"ᱵᱤᱴ ᱯᱮ ᱵᱩᱴᱤ\", ᱡᱟᱦᱟᱸ ᱫᱚ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱥᱚᱨᱮᱥ ᱟᱨ ᱱᱟᱯᱟᱭ ᱠᱟ.ᱢᱤ ᱨᱮ ᱞᱟᱦᱟ ᱟᱨ (Successful) ᱢᱮᱱᱟᱜ ᱟᱠᱟᱫᱮᱭᱟ᱾ᱢᱟᱨᱪ ᱒0᱒᱐ ᱨᱮ, ᱞᱟᱸᱫᱟᱱ ᱠᱷᱚᱱ ᱨᱩᱣᱟᱹᱲ ᱛᱟᱭᱚᱢ, ᱩᱱᱤ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱠᱷᱤᱞᱟᱯᱷ ᱨᱮ ᱦᱚᱴᱟᱞ ᱛᱟᱡ, ᱞᱟᱠᱷᱱᱟᱣ ᱨᱮ ᱥᱤᱧᱚᱛᱭᱟ ᱨᱟᱡᱽᱱᱮᱛᱟ ᱠᱚ ᱥᱟᱛᱞᱟᱜ ᱟᱨ ᱣᱤᱟᱤᱯᱤ ᱠᱚ ᱥᱟᱶᱛᱮ ᱠᱤᱪᱷᱩ ᱜᱟᱱ ᱫᱚᱞ ᱥᱟᱶᱛᱮ ᱥᱮᱞᱮᱫ ᱮᱱᱟᱭ, ᱡᱚᱠᱷᱚᱱ ᱩᱱ ᱚᱠᱛᱚ ᱠᱚᱨᱚᱱᱟ ᱟᱡᱟᱨ ᱨᱮᱭᱟᱜ reluctant ᱛᱟᱞᱟ ᱛᱮ Ministry of health ᱨᱮᱱ Domestic quarantine adviser ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ᱾ ᱤᱱᱟ ᱯᱚᱨᱮ ᱛᱮ, ᱩᱱᱤ ᱠᱚᱣᱤᱰ -᱑᱙ ᱞᱟ.ᱜᱤᱫ ᱛᱮ Positive test ᱮ ᱠᱚᱨᱟᱣ ᱟᱠᱟᱫᱟ᱾ ᱢᱤᱫ ᱰᱳᱢᱤᱱᱳ ᱯᱨᱟᱵᱷᱟᱣ (Domino effect) ᱥᱤᱧᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱮᱱ (president) ᱨᱟᱴᱨᱚᱯᱚᱛᱤ ᱫᱚ ᱟᱡᱟᱜ ᱯᱨᱚᱡᱮᱠᱴ ᱠᱚ ᱠᱮᱱᱥᱤᱞ ᱞᱟ.ᱜᱤᱫ ᱟᱨ (indefinitely) ᱞᱟ.ᱜᱤᱫ ᱛᱮ concomitant ᱥᱟᱸᱜᱞᱟᱱ ᱞᱟ.ᱜᱤᱫ ᱛᱮ management ᱮᱫᱟᱭ᱾ ᱩᱱᱤᱭᱟᱜ ᱞᱟᱯᱟᱨᱣᱟᱦᱤ ᱨᱮᱭᱟᱜ ᱩᱱᱤᱭᱟᱜ ᱠᱷᱤᱞᱟᱯᱷ ᱨᱮ Lodging complaint ᱮ ᱠᱚᱨᱟᱣ ᱠᱮᱫᱟ᱾",
        "ᱵᱟᱹᱲᱤᱡᱼᱵᱚᱝᱜᱟ ᱵᱟᱠᱚ ᱥᱟᱦᱟᱣᱟ ᱾ ᱚᱱᱟ ᱛᱮᱠᱚ ᱪᱟᱣᱰᱟᱞ ᱠᱚᱣᱟ ᱾",
        "ᱢᱩᱨᱩᱢᱰᱤᱦᱤ (Murumdihi) ᱵᱟᱝᱢᱟ ᱢᱩᱨᱩᱢᱰᱤ ᱫᱚ ᱢᱤᱫ ᱟᱹᱛᱩ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱠᱩᱥᱩᱢᱤ (ᱵᱟᱫᱟᱢᱯᱟᱦᱟᱰ) ᱵᱚᱱᱚᱛ (block), ᱢᱚᱭᱩᱨᱵᱷᱚᱸᱡᱽ ᱦᱚᱱᱚᱛ, ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱥᱤᱧᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱒᱐᱑᱑ ᱥᱟᱹᱦᱤᱛ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ ᱱᱚᱸᱰᱮ ᱒᱒᱙ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱱᱚᱸᱰᱮ ᱑᱑᱗᱖ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱚᱱᱟ ᱢᱟᱹᱫᱽ ᱠᱷᱚᱱ ᱕᱔᱙ ᱜᱚᱴᱟᱝ ᱠᱚᱲᱟ ᱟᱨ ᱖᱒᱗ ᱜᱚᱴᱟᱝ ᱠᱩᱲᱤ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱩᱡᱽᱡᱮᱱ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱦᱚᱸ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱵᱟᱱᱩᱜᱼᱟ, ᱱᱚᱣᱟ ᱫᱮᱵᱟᱥ ᱰᱟᱦᱟᱨ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱩᱰᱟᱹᱱ ᱯᱟᱴᱴᱤ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱒᱐᱑᱓ ᱨᱮ, ᱢᱚᱫᱷᱭᱚ ᱯᱨᱚᱫᱮᱥ ᱥᱚᱨᱠᱟᱨ ᱫᱚ ᱵᱮᱸᱪᱩᱨᱟ ᱮᱭᱟᱨᱠᱚᱱᱮᱠᱴ ᱥᱟᱶ ᱢᱤᱫ ᱡᱩᱢᱤᱫᱽ ᱵᱮᱯᱟᱨ ᱞᱮᱠᱟᱛᱮ ᱩᱡᱽᱡᱮᱱᱼᱵᱷᱚᱯᱟᱞ ᱩᱰᱟᱹᱱ ᱥᱮᱵᱟ ᱮᱦᱚᱵ ᱟᱠᱟᱱᱟ ᱾ ᱥᱩᱨ ᱨᱮᱱᱟᱜ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱤᱱᱫᱚᱨ ᱨᱮ ᱫᱮᱵᱤ ᱟᱦᱤᱞᱭᱟᱵᱟᱭ ᱦᱚᱞᱠᱟᱨ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ (᱕᱗ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ) ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱦᱚᱱᱚᱛ ᱨᱮ ᱦᱤᱡᱩᱜ ᱥᱮᱱᱚᱜ ᱜᱟᱹᱰᱤ ᱵᱮᱵᱚᱥᱛᱟ ᱱᱟᱯᱟᱭ ᱛᱮ ᱩᱛᱷᱱᱟᱹᱣ ᱟᱠᱟᱱᱟ ᱟᱨ ᱦᱚᱱᱚᱛ ᱨᱮ ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱥᱚᱲᱚᱠ ᱰᱟᱦᱟᱨ ᱟᱨ ᱨᱮᱞ ᱰᱟᱦᱟᱨ ᱛᱮ ᱱᱟᱯᱟᱭ ᱛᱮ ᱡᱚᱲᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱦᱚᱱᱚᱛ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱢᱩᱬ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ, ᱤᱨᱳᱰ ᱡᱚᱸᱠᱥᱚᱱ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱩᱬᱩᱛ ᱥᱴᱮᱥᱚᱱ ᱠᱷᱚᱱ ᱫᱚ ᱢᱤᱫᱴᱟᱹᱝ ᱠᱟᱱᱟ ᱟᱨ ᱑᱖᱕ ᱜᱚᱴᱟᱝ ᱴᱨᱮᱱ ᱠᱚ ᱪᱟᱞᱟᱜ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱨᱮ ᱢᱤᱫ ᱰᱤᱡᱮᱞ ᱞᱳᱠᱳᱢᱳᱴᱤᱵᱽ ᱥᱮᱰ ᱟᱨ ᱢᱤᱫ ᱤᱞᱮᱠᱴᱨᱤᱠ ᱞᱳᱠᱳ ᱥᱮᱰ ᱡᱩᱲᱟᱹᱣ ᱟᱠᱟᱱᱟ ᱾",
        "᱒᱐᱑᱑ ᱥᱟᱹᱦᱤᱛ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ, ᱦᱟᱵᱽᱨᱟ ᱨᱤᱱ ᱜᱩᱴ ᱦᱚᱲ ᱮᱞ ᱑᱔᱗,᱒᱒᱑ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱚᱱᱰᱮ ᱠᱷᱚᱱ ᱗᱔,᱕᱙᱒ (᱕᱑%) ᱠᱚᱲᱟ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱗᱒,᱖᱒᱙ (᱔᱙%) ᱛᱤᱨᱞᱟᱹ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱖ ᱵᱚᱪᱷᱚᱨ ᱠᱷᱚᱱ ᱞᱟᱛᱟᱨ ᱨᱤᱱ ᱦᱚᱲ ᱮᱞ ᱑᱑,᱖᱙᱖ ᱜᱟᱱ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱦᱟᱵᱽᱨᱟ ᱨᱮ ᱥᱮᱪᱮᱫ ᱫᱚᱨ ᱨᱮᱱᱟᱜ ᱜᱩᱴ ᱮᱞ ᱑᱒᱑,᱙᱕᱒ (᱖ ᱵᱚᱪᱷᱚᱨ ᱠᱷᱚᱱ ᱰᱮᱦᱮᱨ ᱦᱚᱲ ᱮᱞ ᱟᱜ ᱘᱙.᱙᱘%) ᱜᱟᱱ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "᱑᱘᱒᱕ ᱨᱮ ᱩᱱᱤ ᱡᱚᱦᱱ ᱯᱮᱞᱞᱭ ᱟᱹᱴᱠᱤᱱᱥ ᱥᱟᱞᱟᱜ ᱮ ᱵᱟᱯᱞᱟᱭᱮᱱᱟ ᱾ ᱡᱚᱦᱱ ᱯᱮᱞᱞᱭ ᱫᱚ ᱞᱚᱱᱰᱚᱱ ᱯᱟᱪᱮ ᱥᱤᱧᱚᱛ ᱵᱮᱯᱟᱨᱤ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾ ᱩᱱᱠᱤᱱ ᱯᱚᱨᱮ ᱦᱟᱞᱥᱴᱮᱰ ᱯᱮᱞᱮᱥ ᱛᱮ ᱩᱪᱟᱹᱰ ᱮᱱᱟ ᱠᱤᱱ ᱾ ᱟᱹᱴᱠᱤᱱᱥ ᱨᱮᱭᱟᱜ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱫᱚ ᱠᱮᱸᱴ ᱨᱮᱭᱟᱜ ᱥᱮᱣᱮᱱᱚᱟᱠᱥ ᱨᱮᱭᱟᱜ ᱦᱟᱞᱥᱴᱮᱰ ᱨᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱠᱤᱱ ᱨᱮᱱ ᱚᱠᱚᱭ ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚ ᱦᱚᱸ ᱵᱟᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱟᱹᱴᱠᱤᱱᱥ ᱫᱚ ᱟᱡᱟᱜ ᱯᱚᱥᱚᱸᱫᱽ ᱠᱟᱹᱢᱤ ᱫᱟᱨᱮ ᱡᱚᱻ ᱦᱚᱛᱮᱛᱮ ᱟᱡ ᱫᱟᱨᱮ ᱠᱚ ᱢᱤᱫ ᱴᱷᱮᱱ ᱟᱹᱜᱩ ᱡᱟᱣᱨᱟᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱚᱱᱟ ᱠᱷᱚᱱ ᱩᱱᱤ ᱪᱤᱛᱟᱹᱨ ᱠᱚ ᱮᱢᱟᱱ ᱮ ᱛᱮᱭᱟᱨ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱩᱱᱤ ᱑᱘᱓᱙ ᱨᱮ ᱞᱚᱱᱰᱚᱱ ᱡᱤᱣ ᱡᱟᱱ ᱥᱚᱥᱟᱭᱴᱤ ᱨᱤᱱᱤᱡ ᱨᱟᱹᱥᱤᱭᱟᱹ ᱠᱚ ᱵᱟᱪᱷᱟᱣ ᱞᱮᱱᱟᱭ ᱾",
        "ᱥᱟᱨᱟᱣᱱᱤ ᱠᱷᱩᱨᱫᱽ (Sarawani Khurd) ᱫᱚ ᱢᱤᱫ ᱛᱟᱞᱟᱱᱟ ᱟᱹᱛᱩ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱦᱟᱡᱟᱨᱤᱵᱟᱜᱽ, ᱥᱚᱫᱚᱨ ᱵᱚᱱᱚᱛ (block), ᱦᱟᱡᱟᱨᱤᱵᱟᱜᱽ ᱦᱚᱱᱚᱛ, ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱯᱚᱱᱚᱛ ᱥᱤᱧᱚᱛ ᱫᱤᱥᱚᱢ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱒᱐᱑᱑ ᱥᱟᱹᱦᱤᱛ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ ᱱᱚᱸᱰᱮ ᱓᱘ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱱᱚᱸᱰᱮ ᱔᱓᱕ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱚᱱᱟ ᱢᱟᱹᱫᱽ ᱠᱷᱚᱱ ᱒᱑᱕ ᱜᱚᱴᱟᱝ ᱠᱚᱲᱟ ᱟᱨ ᱒᱒᱐ ᱜᱚᱴᱟᱝ ᱠᱩᱲᱤ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱱᱚᱶᱟ ᱟᱹᱛᱩ ᱨᱮ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱫᱚᱨ ᱫᱚ ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱫᱚᱨ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱜᱮᱭᱟ ᱾ ᱒᱐᱑᱑ ᱥᱟᱹᱦᱤᱛ ᱨᱮ ᱥᱤᱠᱷᱟᱱᱟᱹᱛ ᱫᱚᱨ ᱫᱚ ᱘᱒ᱹ᱖᱑ % ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱚᱱᱟ ᱢᱟᱹᱫᱽ ᱨᱮ ᱠᱚᱲᱟ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱫᱚᱨ ᱫᱚ ᱙᱑ᱹ᱘᱕ %, ᱢᱮᱱᱠᱷᱟᱱ ᱠᱩᱲᱤ ᱠᱚᱣᱟᱜ ᱫᱚ ᱗᱑ᱹ᱙᱕ % ᱾",
        "ᱥᱩᱨ ᱨᱮᱱᱟᱜ ᱨᱮᱞᱣᱮ ᱟᱨᱟᱨᱤᱭᱟ ᱠᱚᱨᱴ ᱟᱨ ᱟᱨᱟᱨᱤᱭᱟ (R S) ᱠᱟᱱᱟ ᱾ ᱟᱨᱟᱨᱤᱭᱟ ᱠᱚᱨᱴ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱠᱟᱴᱤᱦᱟᱨᱼᱡᱚᱜᱽᱵᱚᱱᱤ ᱵᱨᱟᱝᱪ ᱞᱟᱭᱤᱱ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱡᱚᱜᱽᱵᱚᱱᱤ, ᱯᱩᱨᱱᱤᱭᱟ, ᱠᱟᱴᱤᱦᱟᱨ, ᱠᱚᱞᱠᱟᱛᱟ, ᱵᱮᱜᱩᱥᱚᱨᱟᱭ, ᱯᱟᱴᱞᱤᱯᱩᱛᱨᱟ ᱡᱚᱸᱠᱥᱚᱱ, ᱟᱞᱞᱟᱦᱟᱵᱟᱫᱽ, ᱠᱟᱱᱯᱩᱨ, ᱫᱤᱞᱞᱤ ᱞᱟᱹᱜᱤᱫ ᱫᱤᱱᱟᱹᱢ ᱦᱤᱞᱚᱜ ᱟᱨ ᱦᱟᱯᱨᱟ ᱯᱤᱪᱷᱤ ᱴᱨᱮᱱ ᱵᱮᱵᱚᱥᱛᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱜᱩᱨᱤᱡ ᱠᱤᱥᱱᱤ (ᱟᱥᱟᱢᱤᱥᱺ গাং শালিকা; ᱤᱝᱨᱟᱹᱡᱤ: Bank Myna , ᱥᱟᱬᱮᱥᱤᱭᱟᱹ ᱧᱩᱛᱩᱢ- Acridotheres ginginianus) ᱫᱚ ᱮᱛᱚᱢ ᱮᱥᱤᱭᱟ ᱨᱮᱠᱚ ᱧᱟᱢᱚᱜ ᱢᱤᱫ ᱠᱤᱥᱱᱤ ᱡᱟᱹᱛ ᱨᱮᱱ ᱪᱮᱬᱮ ᱠᱟᱱᱟ ᱠᱚ| ᱱᱩᱠᱩ ᱫᱚ ᱟᱹᱛᱩ ᱠᱤᱥᱱᱤ ᱞᱮᱠᱟ ᱜᱮ ᱮᱱᱨᱮᱸ ᱦᱚᱸ ᱦᱚᱲᱢᱚ ᱱᱟᱥᱟᱱᱟᱜ ᱦᱩᱰᱤᱧ ᱧᱚᱜ ᱜᱮ ᱛᱟᱠᱚᱣᱟ| ᱚᱱᱟ ᱵᱮᱜᱚᱨ ᱦᱦᱚᱸ ᱱᱩᱠᱩᱣᱟᱜ ᱢᱮᱫ ᱞᱟᱛᱟᱨ ᱨᱮ ᱱᱟᱥᱮ ᱥᱟᱥᱟᱟᱝ ᱨᱨᱚᱝ ᱧᱮᱞᱚᱜ-ᱟ| ᱛᱟᱞᱢᱟ ᱟᱨ ᱠᱚᱸᱭᱮᱸ ᱥᱤᱧᱚᱛ ᱨᱮ ᱱᱩᱠᱩ ᱪᱮᱬᱮ ᱫᱚ ᱟᱹᱰᱤ ᱵᱟᱹᱲᱛᱤ ᱠᱚ ᱧᱟᱢᱚᱜ-ᱟ| ᱱᱩᱠᱩ ᱪᱮᱬᱮ ᱫᱚ ᱮᱛᱚᱢ ᱥᱤᱧᱚᱛ ᱥᱮᱡ ᱦᱚᱸ ᱦᱟᱹᱴᱤᱧ ᱟᱠᱟᱱ ᱟᱠᱟᱱ ᱨᱮᱭᱟᱜ ᱰᱚᱜᱚᱨ ᱦᱚᱸ ᱧᱟᱢᱚᱜ ᱠᱟᱱᱟ| ᱜᱟᱰᱟᱟ ᱯᱟᱨᱚᱢ ᱨᱮ ᱵᱷᱩᱜᱟᱹᱜ ᱠᱟᱛᱮ ᱜᱟᱛᱟᱠ ᱨᱮ ᱛᱩᱠᱟᱹ ᱠᱚ ᱵᱮᱱᱟᱣ ᱛᱮ ᱤᱝᱨᱟᱹᱡᱤ ᱛᱮ ᱫᱚ ᱠᱚ ᱢᱮᱛᱟᱣ ᱠᱚᱣᱟ \"Bank Myna\"৷",
        "– Euskaltzaindia (The Royal Academy of the Basque Language)",
        "ᱢᱚᱦᱟ ᱵᱷᱟᱨᱚᱛ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱠᱟᱹᱞᱤ ᱨᱮ ᱠᱟᱱᱣᱟ ᱢᱩᱱᱤᱭᱮ ᱢᱮᱱᱮᱫᱟ-",
        "ᱩᱱᱤ ᱢᱮᱱ ᱠᱮᱫᱟᱭ ᱡᱮ ᱲᱩᱠ ᱢᱳᱵᱟᱭᱤᱞ ᱨᱮ ᱤᱱᱣᱮᱥᱴ ᱨᱮᱱᱟᱜ ᱠᱟᱱᱟ᱾ ᱱᱚᱣᱟ ᱠᱷᱚᱱ ᱦᱚᱸ ᱵᱷᱮᱜᱟᱨ ᱟᱨ ᱮᱴᱟᱜ ᱟᱜ ᱠᱟᱛᱷᱟ ᱠᱚ ᱢᱱᱤᱭᱟ ᱜᱮ ᱢᱮᱱ ᱠᱮᱫᱟᱭ ᱡᱮ ᱞᱮᱱᱳᱣᱳ ᱠᱳᱢᱯᱟᱱᱤ ᱟᱜ ᱠᱷᱚᱱ ᱛᱟᱭᱚᱢ ᱨᱮ ᱥᱟᱦᱟᱭᱟᱠ ᱵᱨᱟᱱᱰ ᱠᱷᱚᱱ ᱵᱷᱮᱜᱟᱨ ᱢᱤᱫᱴᱟᱝ ᱯᱷᱨᱤᱰᱳᱢ ᱵᱽᱨᱟᱱᱰ ᱠᱟᱱᱟ᱾",
        "Bishnupur page in Government of India website",
        "ᱣᱟᱞᱩᱱ ᱯᱟᱹᱨᱥᱤ (; ᱡᱟᱱᱟᱢ ᱟᱲᱟᱝ : ) ᱫᱚ ᱢᱤᱫ ᱨᱳᱢᱟᱱᱥ ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱᱟ, ᱱᱚᱶᱟ ᱫᱚ ᱵᱮᱞᱡᱤᱭᱟᱢ ᱨᱮᱱᱟᱜ ᱣᱟᱞᱳᱱᱤᱭᱟ ᱴᱚᱴᱷᱟ ᱨᱮᱠᱚ ᱨᱚᱲᱼᱟ ᱾ ᱟᱨ ᱮᱛᱚᱢ ᱯᱷᱨᱟᱱᱥ ᱨᱮᱱᱟᱜ ᱟᱫᱚᱢ ᱟᱫᱚᱢ ᱟᱛᱳ ᱨᱮᱦᱚᱸ ᱠᱚ ᱨᱚᱲ ᱜᱮᱭᱟ ᱾ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱛᱮ ᱖ ᱞᱟᱠᱷ ᱜᱟᱱ ᱦᱚᱲ ᱠᱚ ᱨᱚᱲᱼᱟ ᱾ ᱣᱟᱞᱩᱱ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱞᱟᱛᱤᱱ ᱦᱚᱨᱚᱯ ᱛᱮᱠᱚ ᱚᱞᱟ ᱾",
        "Antoninu Rubattu's site . In addition to vocabularies of each Sardinian variety of the language and non-Sardinian languages, the site provides the reader also with some basic grammar guides and etymology dictionaries as well.",
        "Lyver Pysadow Kemyn (1980) Portions of the Book of Common Prayer in Cornish",
        "᱒᱐᱑᱑:ᱯᱚᱫᱢᱚ ᱵᱷᱩᱥᱚᱱ ᱑᱙᱙᱘ᱼ᱑᱙᱙᱙: ᱠᱟᱞᱤᱫᱟᱥ ᱥᱚᱢᱟᱱ, ᱵᱷᱚᱯᱟᱞ ᱑᱙᱙᱑: ᱯᱟᱹᱨᱤᱥᱚᱫ ᱥᱚᱢᱟᱱ, ᱥᱟᱦᱤᱛᱭᱚ ᱠᱚᱲᱟ ᱯᱚᱨᱤᱥᱚᱫ, ᱱᱟᱶᱟ ᱫᱤᱞᱤ ᱾",
        "Preservation and Advancement of the Aramaic Language in the Internet Age by Paul D. Younan",
        "ᱱᱚᱣᱟ ᱦᱚᱱᱚᱛ ᱫᱚ ᱠᱚᱭᱮᱢᱵᱟᱴᱩᱨ ᱨᱮ ᱠᱚᱭᱮᱢᱵᱟᱴᱩᱨ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱷᱚᱱ ᱥᱮᱵᱟ ᱦᱟᱠᱟᱱᱟ ᱾ ᱠᱚᱭᱮᱢᱵᱟᱴᱩᱨ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱫᱚ ᱪᱮᱱᱱᱟᱭ, ᱢᱩᱢᱵᱟᱭ, ᱵᱮᱝᱜᱟᱞᱩᱨᱩ, ᱫᱤᱞᱞᱤ, ᱦᱟᱭᱫᱨᱟᱵᱟᱫᱽ, ᱠᱚᱞᱠᱟᱛᱟ, ᱚᱦᱢᱚᱫᱟᱵᱟᱫᱽ ᱮᱢᱟᱱ ᱢᱩᱬᱩᱛ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱥᱚᱦᱚᱨ ᱞᱟᱹᱜᱤᱫ ᱚᱲᱟᱜ ᱨᱮᱱᱟᱜ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱟᱨ ᱥᱟᱨᱡᱟ, ᱥᱨᱤᱞᱚᱝᱠᱟ ᱟᱨ ᱥᱤᱝᱜᱟᱯᱩᱨ ᱞᱟᱹᱜᱤᱫ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱮᱢᱚᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱨᱟᱱᱣᱮ ᱫᱚ ᱙,᱗᱖᱐ ᱯᱷᱩᱴ (᱒,᱙᱗᱐ ᱢᱤᱴᱚᱨ) ᱡᱤᱞᱤᱧᱟ ᱟᱨ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱞᱟᱹᱜᱤᱫ ᱵᱮᱵᱷᱟᱨᱚᱜ ᱠᱟᱱ ᱢᱚᱬᱮ ᱜᱚᱴᱟᱝ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱚ ᱦᱟᱛᱟᱣ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾ ᱥᱩᱞᱩᱨ ᱩᱰᱟᱹᱱ ᱯᱷᱩᱨᱜᱟᱹᱞ ᱥᱴᱮᱥᱚᱱ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱩᱰᱟᱹᱱ ᱯᱷᱟᱹᱫᱽ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱟᱱᱟ ᱾",
        "ᱯᱟᱪᱮ ᱮᱥᱤᱭᱟ ᱟᱨᱵᱟᱝ ᱮᱛᱚᱢ ᱯᱟᱪᱮ ᱮᱥᱤᱭᱟ ᱫᱚ ᱮᱥᱤᱭᱟ ᱢᱟᱦᱟᱫᱤᱯ ᱨᱮᱱᱟᱜ ᱟᱹᱰᱤ ᱯᱟᱪᱮ ᱡᱚᱜᱚᱼᱴᱚᱴᱷᱟ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱜᱚᱴᱟ ᱯᱟᱲᱟ ᱥᱮᱦᱮᱫ ᱠᱷᱚᱱ ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱛᱟᱞᱢᱟ ᱥᱟᱢᱟᱝ ᱨᱮᱱᱟᱜ ᱴᱷᱟᱶ ᱠᱟᱱᱟ, ᱟᱨ ᱱᱚᱸᱰᱮ ᱚᱱᱟᱛᱚᱞᱤᱭᱟ, ᱟᱨᱚᱵᱽ ᱯᱨᱟᱭᱫᱤᱯ, ᱤᱨᱟᱱ, ᱢᱮᱥᱚᱯᱚᱴᱟᱢᱤᱭᱟ, ᱞᱮᱣᱮᱸᱴ, ᱥᱟᱭᱯᱨᱟᱥ ᱫᱤᱯ, ᱥᱤᱱᱟᱭ ᱯᱨᱟᱭᱫᱤᱯ ᱟᱨ ᱟᱝᱥᱤᱠ ᱞᱮᱠᱟᱛᱮ ᱴᱨᱟᱝᱥᱠᱮᱥᱤᱭᱟ ᱥᱮᱞᱮᱫ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱫᱚ ᱢᱤᱥᱚᱨ ᱨᱮ ᱥᱩᱣᱮᱡᱽ ᱨᱮᱱᱟᱜ ᱤᱥᱛᱚᱢᱩᱥ ᱤᱫᱤ ᱛᱮ ᱟᱯᱷᱨᱤᱠᱟ ᱥᱟᱞᱟᱜ ᱵᱷᱮᱡᱟᱨ ᱠᱚ ᱢᱟᱱᱟᱣᱟ, ᱟᱨ ᱛᱩᱨᱠᱤ ᱤᱥᱴᱨᱟᱱᱴ ᱨᱮᱱᱟᱜ ᱫᱟᱜ ᱰᱟᱦᱟᱨ ᱟᱨ ᱜᱨᱮᱴᱟᱨ ᱠᱟᱠᱮᱥᱚᱥ ᱨᱮᱱᱟᱜ ᱫᱟᱜ ᱰᱟᱦᱟᱨ ᱤᱫᱤ ᱛᱮ ᱤᱭᱩᱨᱳᱯ ᱠᱷᱚᱱ ᱵᱷᱮᱡᱟᱨᱟ ᱾ ᱛᱟᱞᱢᱟ ᱮᱥᱤᱭᱟ ᱫᱚ ᱱᱚᱣᱟ ᱠᱚᱧᱮ ᱥᱟᱢᱟᱝ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ, ᱱᱤᱛᱚᱜ ᱱᱚᱣᱟ ᱮᱛᱚᱢ ᱮᱥᱤᱭᱟ ᱫᱚ ᱱᱚᱣᱟ ᱥᱟᱢᱟᱝ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱤᱨᱟᱹᱞ ᱜᱚᱴᱟᱝ ᱫᱚᱨᱭᱟ ᱱᱚᱣᱟ ᱴᱚᱴᱷᱟ ᱜᱷᱮᱨᱟᱣᱟ : ᱮᱡᱤᱭᱚᱱ ᱫᱚᱨᱭᱟ, ᱦᱮᱸᱫᱮ ᱫᱚᱨᱭᱟ, ᱠᱮᱥᱯᱤᱭᱚᱱ ᱫᱚᱨᱭᱟ, ᱯᱷᱟᱨᱚᱥ ᱠᱚᱪᱟ ᱫᱚᱨᱭᱟ, ᱟᱨᱟᱜ ᱫᱚᱨᱭᱟ ᱟᱨ ᱚᱛᱮᱛ ᱫᱚᱨᱭᱟ ᱾",
        "ᱵᱷᱟᱭᱨᱟᱥ ᱫᱚ ᱢᱤᱫ ᱞᱟᱛᱤᱱ ᱟᱹᱲᱟᱹ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱾ ᱡᱟᱦᱟᱸ ᱨᱮᱭᱟᱜ ᱢᱮᱱᱮᱫ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱵᱤᱥ ᱾ ᱥᱮᱫᱟᱭ ᱫᱚ ᱨᱩᱣᱟᱹ ᱥᱤᱨᱡᱚᱱᱮᱫ ᱥᱟᱱᱟᱢ ᱞᱮᱠᱟᱱ ᱵᱤᱥᱼᱟᱱ ᱫᱩᱨᱤᱵᱽ ᱜᱮ ᱵᱷᱟᱭᱨᱟᱥ ᱠᱚ ᱢᱮᱱᱟᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱱᱟ ᱾ ᱱᱟᱦᱟᱜ ᱫᱚ ᱵᱷᱟᱭᱨᱟᱥ ᱢᱮᱱᱛᱮ ᱢᱤᱫ ᱞᱮᱠᱟᱱ ᱟᱹᱰᱤ ᱦᱩᱰᱤᱝ ᱟᱹᱱᱩᱵᱤᱠᱠᱷᱳᱱᱤᱠ ᱚᱠᱳᱥ ᱨᱩᱣᱟᱹ ᱥᱟᱨᱥᱟᱣ ᱫᱩᱨᱤᱵᱽ ᱵᱩᱡᱷᱟᱹᱜᱼᱟ ᱾ ᱡᱤᱵᱽ ᱡᱤᱭᱟᱹᱞᱤ ᱟᱨ ᱫᱟᱨᱮ ᱨᱮᱭᱟᱜ ᱟᱭᱢᱟ ᱞᱮᱠᱟᱱ ᱨᱩᱣᱟᱹ ᱨᱮᱭᱟᱜ ᱢᱩᱬᱩᱛ ᱠᱟᱨᱚᱱ ᱜᱮ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱱᱚᱣᱟ ᱵᱷᱟᱭᱨᱟᱥ ᱾",
        "History of the Coat of Arms of Vienna and all (former) districts and municipalities",
        "ᱱᱚᱰᱮ ᱫᱤᱥᱟᱹ ᱫᱚᱦᱚ ᱡᱟ.ᱨᱩᱲᱟ ᱡᱮ ᱫᱩᱬᱩᱡ ᱟᱹᱲᱟᱹ ᱨᱮᱭᱟᱜ ᱢᱩᱪᱟ.ᱫ ᱨᱮ ᱡ ᱥᱮ ᱫ ᱜᱟᱵᱟᱱ ᱡᱚᱛᱷᱟᱛ ᱟ , ᱚᱱᱟ ᱫᱚ ᱟᱸᱯᱲᱮ ᱛᱮᱜᱮ ᱵᱤᱪᱟᱹᱨ ᱜᱟᱱᱚᱜᱼᱟ ᱾ ᱥᱟᱱᱛᱟᱲᱤ ᱫᱚ ᱟᱢᱫᱟ ᱟᱹᱲᱟᱹ ᱜᱮ ᱚᱜ ᱡᱮᱞᱮᱫ ᱠᱟᱛᱮ ᱠᱟᱱᱣᱟ ᱨᱮ ᱩᱪᱟᱹᱲ ᱦᱩᱭᱩᱜᱼᱟ ᱾ ᱡᱮᱞᱮᱠᱟ - ᱫᱩᱬᱩᱡ + ᱚᱜ = ᱫᱩᱬᱩᱡᱚᱜ ᱾ ᱚᱱᱠᱟ ᱜᱮ ᱥᱟᱵ , ᱫᱟᱵ ᱨᱮᱭᱟᱜ ᱢᱩᱪᱟᱹᱫ ᱨᱮ ᱵ ᱜᱮ ᱦᱩᱭᱩᱜ ᱟ ᱯ ᱫᱚ ᱜᱟᱵᱟᱱ ᱵᱟᱝ ᱦᱩᱭᱩᱜᱼᱟ᱾",
        "ᱩᱱᱤ ᱫᱚ ᱒᱐᱐᱘ ᱥᱮᱨᱢᱟ ᱨᱮ ᱟᱨᱮ ᱟᱜ ᱱᱤᱨᱵᱟᱪᱚᱱ ᱨᱮ ᱠᱩᱲᱤᱜᱨᱟᱢ-᱔ ᱟᱥᱚᱱ ᱠᱷᱚᱱᱮ ᱡᱤᱛᱟᱹᱣ ᱟᱠᱟᱱᱟ᱾ ᱤᱱᱟᱹ ᱛᱟᱭᱚᱢ ᱒᱐᱑᱘ ᱥᱮᱨᱢᱟ ᱨᱮ ᱚᱱᱟ ᱚᱥᱚᱱ ᱠᱷᱚᱱ ᱜᱮ ᱫᱚᱥᱟᱨ ᱫᱷᱟᱣ ᱞᱮᱠᱟᱛᱮ ᱥᱚᱝᱥᱚᱫ ᱥᱚᱦᱮᱫᱮ ᱦᱩᱭ ᱟᱠᱟᱱᱟ᱾",
        "ᱯᱟᱨᱥᱮᱛ, ᱵᱷᱟᱨᱚᱛ ᱡᱟᱠᱟᱛ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱯᱟᱨᱴᱤ ᱑᱙᱖᱘ᱼ᱗᱙; ᱥᱚᱦᱮᱫ, ᱠᱟᱹᱢᱤᱭᱟᱹ ᱠᱩᱢᱩᱴ, ᱡᱚᱱᱚᱛᱟ ᱯᱟᱨᱴᱤ, ᱵᱤᱦᱟᱨ, ᱑᱙᱗᱙ᱼᱢᱟᱨᱪ ᱑᱙᱘᱐; ᱟᱨ ᱠᱟᱹᱢᱤᱭᱟᱹ ᱠᱩᱢᱩᱴ, ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱡᱚᱱᱚᱛᱟ ᱯᱟᱨᱴᱤ, ᱵᱤᱦᱟᱨ",
        "ᱥᱟᱱᱛᱟᱲᱤ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱠᱚᱢᱚᱱ ᱵᱷᱚᱭᱮᱥ ᱨᱮ ᱒ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱒᱐᱒᱑ ᱨᱮ ᱠᱚ ᱥᱮᱞᱮᱫ ᱞᱮᱜᱼᱟ᱾ ᱚᱱᱟ ᱣᱮᱵᱽᱥᱟᱭᱴ ᱫᱚ ᱥᱟᱱᱛᱟᱲᱤ ᱯᱟᱹᱨᱥᱤ ᱛᱮ ᱛᱚᱨᱡᱚᱢᱟ ᱦᱩᱭ ᱠᱟᱱᱟ᱾",
        "ᱮᱯᱟᱹᱨᱴᱤᱭᱟᱹᱢᱟᱜ ᱵᱤᱴᱟ ᱣᱮᱵᱽᱥᱟᱭᱴ (beta.apertium.org) ᱨᱮ ᱪᱟᱞᱟᱣ ᱠᱟᱛᱮ ᱞᱮᱝᱜᱟ ᱛᱤ ᱯᱟᱦᱴᱟ ᱨᱮ ᱥᱟᱱᱛᱟᱲᱤ ᱟᱨ ᱡᱚᱡᱚᱢ ᱛᱤ ᱯᱟᱦᱴᱟ ᱨᱮ ᱤᱝᱨᱟᱡᱤ ᱵᱟᱪᱷᱟᱣ ᱠᱟᱛᱮ ᱛᱚᱨᱡᱚᱢᱟᱭ ᱯᱮ᱾",
        "ᱠᱮᱨᱚᱞ, ᱛᱟᱢᱤᱞᱱᱟᱰᱩ ᱟᱨ ᱠᱚᱨᱱᱟᱴᱚᱠ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱥᱚᱦᱚᱨ ᱠᱷᱚᱱ ᱥᱚᱲᱚᱠ ᱰᱟᱦᱟᱨ ᱛᱮ ᱟᱞᱜᱟ ᱛᱮ ᱢᱟᱞᱟᱯᱯᱩᱨᱚᱢ ᱠᱚ ᱥᱮᱴᱮᱨ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱠᱚ ᱾ ᱯᱚᱱᱚᱛ ᱥᱟᱜᱟᱲᱚᱢ ᱱᱤᱜᱟᱢᱟᱜ ᱟᱹᱰᱤ ᱜᱟᱱ ᱵᱟᱥ ᱱᱤᱭᱟᱹ ᱮᱴᱟᱜ ᱥᱚᱦᱚᱨ ᱥᱟᱞᱟᱜ ᱡᱚᱲᱟᱣ ᱟᱠᱟᱱᱟ ᱾",
        "ᱢᱚᱦᱟᱨᱟᱡᱟᱫᱷᱤᱨᱟᱡᱽ ᱩᱫᱚᱭ ᱪᱟᱸᱫᱽ ᱳᱢᱮᱱᱥ ᱠᱚᱞᱮᱡᱽ, ᱮᱢ.ᱭᱩ.ᱥᱤ. ᱳᱢᱮᱱᱥ ᱠᱚᱞᱮᱡᱽ ᱧᱩᱛᱩᱢ ᱛᱮᱦᱚᱸ ᱵᱟᱲᱟᱭᱚᱜᱼᱟ, ᱫᱚ ᱒᱘ ᱡᱩᱞᱟᱭ ᱑᱙᱕᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱛᱷᱟᱯᱚᱱ ᱟᱠᱟᱱ ᱵᱚᱨᱫᱷᱚᱢᱟᱱ ᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱛᱤᱨᱞᱟᱹ ᱠᱚᱞᱮᱡᱽ ᱠᱟᱱᱟ᱾ ᱱᱚᱸᱰᱮ ᱫᱚ ᱟᱨᱴᱥ ᱟᱨ ᱥᱟᱬᱮᱥ ᱥᱟᱛᱟᱢ ᱪᱮᱛᱟᱱ ᱨᱮ ᱟᱱᱰᱟᱨᱜᱽᱨᱮᱡᱩᱭᱮᱴ ᱟᱨ ᱤᱝᱞᱤᱥ ᱥᱟᱛᱟᱢ ᱪᱮᱛᱟᱱ ᱨᱮ ᱯᱳᱥᱴ ᱜᱨᱮᱡᱩᱭᱮᱴ ᱠᱳᱨᱥ ᱪᱟᱞ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱯᱩᱭᱞᱩ ᱠᱚᱞᱠᱟᱛᱟ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱥᱟᱶ ᱡᱚᱯᱲᱟᱣ ᱛᱟᱦᱮ ᱠᱟᱱᱟ᱾ ᱑᱙᱖᱐ ᱥᱮᱨᱢᱟ ᱨᱮ ᱡᱚᱠᱷᱚᱱ ᱵᱚᱨᱫᱷᱚᱢᱟᱱ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱛᱷᱟᱯᱚᱱ ᱮᱱᱟ, ᱩᱱ ᱡᱚᱠᱷᱮᱡᱽ ᱱᱚᱣᱟ ᱠᱚᱞᱮᱡᱽ ᱫᱚ ᱱᱟᱣᱟ ᱜᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱥᱟᱶ ᱡᱚᱯᱲᱟᱣ ᱮᱱᱟ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ, ᱒᱐᱐᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱡᱚᱠᱷᱚᱱ ᱱᱚᱣᱟ ᱠᱚᱞᱮᱡᱽ ᱨᱮ ᱤᱝᱞᱤᱥ ᱨᱮ ᱯᱤ.ᱡᱤ ᱠᱳᱨᱥ ᱪᱟᱹᱞᱩ ᱮᱱᱟ, ᱱᱚᱣᱟ ᱠᱚᱞᱮᱡᱽ ᱫᱚ ᱵᱚᱨᱫᱷᱚᱢᱟᱱ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱢᱩᱬᱩᱛ ᱠᱚᱞᱮᱡᱽ ᱞᱮᱠᱟᱛᱮ ᱴᱷᱟᱶ ᱮ ᱧᱟᱢ ᱠᱮᱫᱟ᱾",
        "ᱵᱟᱨ ᱛᱚᱞᱟ ᱨᱮᱭᱟᱜ ᱥᱴᱤᱞ ᱟᱨ ᱠᱚᱝᱠᱨᱤᱴ ᱛᱮ ᱵᱮᱱᱟᱣ ᱴᱨᱟᱥᱴ ᱨᱮᱭᱟᱜ ᱱᱚᱣᱟ ᱥᱟᱠᱳ ᱨᱮᱭᱟᱜ ᱪᱮᱛᱟᱱ ᱨᱮᱫᱚ ᱯᱩᱱ ᱞᱮᱱ ᱨᱮᱭᱟᱜ ᱥᱚᱲᱚᱠ ᱟᱨ ᱞᱟᱛᱟᱨ ᱛᱚᱞᱟ ᱨᱮᱫᱚ ᱢᱤᱫ ᱞᱟᱭᱤᱱ ᱨᱮᱭᱟᱜ ᱨᱮᱞ ᱰᱟᱦᱟᱨ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱥᱟᱠᱳ ᱫᱚ ᱯᱚᱫᱽᱫᱟ ᱜᱟᱰᱟ ᱪᱮᱛᱟᱱ ᱔᱒ ᱜᱚᱴᱟᱱ ᱯᱤᱞᱟᱨ ᱟᱨ ᱑᱕᱐ ᱢᱤᱴᱟᱨ ᱞᱤᱡᱤᱧ ᱔᱑ ᱜᱚᱴᱟᱱ ᱥᱯᱮᱱ ᱛᱮ ᱜᱩᱴ ᱖.᱑᱕᱐ ᱠᱤᱢᱤ (᱓.᱘᱒᱑ ᱢᱟᱭᱤᱞ) ᱡᱤᱞᱤᱧ ᱟᱨ ᱒᱒.᱕ ᱢᱤᱴᱟᱨ (᱗᱔ ᱯᱷᱩᱴ) ᱚᱥᱟᱨᱟ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱵᱟᱝᱞᱟᱫᱮᱥ ᱟᱨ ᱜᱟᱝᱱᱟᱹᱭ ᱪᱮᱛᱟᱱ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱ ᱥᱟᱱᱟᱢ ᱠᱷᱚᱱ ᱡᱤᱞᱤᱧ ᱥᱟᱠᱳ ᱠᱟᱱᱟ᱾",
        "ᱦᱩᱞᱥᱟᱹᱭ ᱛᱟᱦᱮᱫ ᱠᱚ । ᱵᱤᱥᱤᱨ ᱵᱷᱟᱠ ᱠᱷᱮᱛᱨᱚ ᱨᱮ ᱡᱚᱢᱵᱤ ᱠᱚᱢᱯᱤᱭᱩᱴᱟᱨ ᱨᱮᱱᱟᱜ ᱱᱤᱡᱮ ᱜᱮ ᱥᱟᱲᱟ ᱥᱚᱵᱫᱚ ᱵᱟᱭ ᱧᱟᱢᱟ ᱩᱱᱤᱦᱟᱜ ᱥᱤᱥᱴᱮᱢ ᱡᱚᱢᱵᱤ ᱦᱤᱥᱟᱹᱵ ᱛᱮ ᱠᱟᱹᱢᱤ ᱛᱟᱦᱮᱫ। ᱡᱮᱦᱮᱛᱩ ᱢᱟᱞᱤᱠ ᱟᱜ ᱵᱟᱝ ᱜᱮᱭᱟᱱ ᱛᱮ ᱦᱩᱭᱩᱜᱼᱟ, ᱚᱱᱟ ᱠᱷᱟᱛᱤᱨ ᱨᱩᱯᱚᱠ ᱢᱮᱱᱮᱠ ᱢᱤᱫ ᱡᱚᱢᱵᱤ ᱥᱟᱶ ᱛᱩᱞᱟᱹ ᱡᱚᱠᱷᱟ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ।",
        "ᱦᱩᱞᱩᱫᱽᱯᱩᱠᱷᱩᱨ (ᱚᱠᱚᱭ ᱫᱚ ᱦᱩᱞᱫᱤᱯᱩᱠᱷᱩᱨ ᱦᱚᱸᱠᱚ ᱢᱮᱱᱟ) ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮ ᱥᱟᱢᱟᱝ ᱥᱤᱝᱵᱷᱩᱢ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱫᱷᱟᱱᱵᱷᱩᱢ ᱡᱚᱜᱚ ᱠᱷᱚᱸᱰ ᱨᱮ ᱯᱚᱴᱠᱟ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱨᱮ ᱢᱤᱫ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱥᱚᱦᱚᱨ ᱠᱟᱱᱟ ᱾",
        "ᱥᱚᱱᱟᱦᱟᱛᱩ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱯᱚᱱᱚᱛ ᱨᱮ ᱨᱟᱺᱪᱤ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱵᱩᱱᱰᱩ ᱦᱩᱰᱤᱧ ᱦᱟᱹᱴᱤᱧ ᱨᱮ ᱥᱚᱱᱟᱦᱟᱛᱩ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱟᱹᱛᱩ ᱠᱟᱱᱟ ᱾",
        "ᱛᱤᱱ ᱯᱟᱦᱟᱲ ᱫᱚ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱯᱚᱱᱚᱛ ᱥᱟᱦᱮᱵᱽᱜᱚᱸᱡᱽ ᱦᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱥᱟᱦᱮᱵᱽᱜᱚᱸᱡᱽ ᱪᱟᱸᱜᱟ ᱠᱷᱚᱸᱰ ᱨᱮᱭᱟᱜ ᱨᱟᱡᱽᱢᱚᱦᱚᱞ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱥᱚᱦᱚᱨ ᱠᱟᱱᱟ᱾",
        "ᱤᱥᱯᱟᱛ ᱱᱚᱜᱚᱨ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱫᱚ ᱟᱫᱽᱨᱟ-ᱵᱚᱠᱟᱨᱚ ᱥᱴᱤᱞ ᱥᱤᱴᱤ ᱪᱟᱸᱜᱟ ᱞᱟᱭᱤᱱ ᱨᱮ ᱨᱟᱹᱱᱤ ᱯᱩᱠᱷᱩᱨ ᱟᱹᱛᱩ, ᱵᱚᱠᱟᱨᱚ ᱦᱚᱱᱚᱛ, ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮᱱᱟᱜ ᱢᱤᱫᱴᱟᱹᱝ ᱦᱩᱰᱤᱧ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱠᱟᱱᱟ ᱾ ᱱᱚᱸᱰᱮᱱᱟᱜ ᱠᱳᱰ ᱫᱚ IPTN ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱵᱚᱠᱟᱨᱚ ᱤᱥᱴᱤᱞ ᱥᱤᱴᱤ ᱨᱮ ᱠᱟᱹᱢᱤᱭᱟ ᱾ ᱯᱞᱮᱴᱯᱷᱚᱨᱢ ᱵᱟᱧᱪᱟᱣ ᱴᱷᱤᱠ ᱵᱟᱹᱱᱩᱜᱼᱟ ᱾ ᱱᱚᱸᱰᱮ ᱫᱚ ᱫᱟᱜ ᱟᱨ ᱯᱷᱩᱨᱪᱟᱹ ᱥᱟᱶᱛᱮ ᱟᱹᱰᱤ ᱜᱟᱱ ᱥᱩᱵᱤᱫᱷᱟ ᱨᱮᱱᱟᱜ ᱚᱵᱷᱟᱵᱽ ᱜᱮᱭᱟ ᱾ ᱱᱤᱛᱚᱜ ᱱᱚᱣᱟ ᱥᱴᱮᱥᱚᱱ ᱨᱮ ᱚᱠᱟ ᱴᱨᱮᱱ ᱦᱚᱸ ᱵᱟᱭ ᱛᱤᱸᱜᱩᱭᱟ ᱾",
        "᱑᱙᱘᱔: ᱠᱚᱢᱞᱟ ᱠᱩᱢᱟᱨᱤ, ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱠᱚᱝᱜᱽᱨᱮᱥ",
        "᱒᱐᱑᱑ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ, ᱡᱚᱞᱰᱮᱜᱟ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱩᱛᱷᱱᱟᱹᱣ ᱨᱮ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱦᱚᱲᱟᱜ ᱜᱩᱴ ᱮᱞ ᱫᱚ ᱓᱔,᱘᱗᱕ ᱜᱚᱴᱟᱝ (᱖᱔.᱘᱙%) ᱥᱤᱠᱷᱱᱟᱹᱛ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱚᱸᱰᱮ ᱠᱷᱚᱱ ᱠᱚᱲᱟ ᱫᱚ ᱑᱙,᱘᱐᱖ (᱗᱓.᱗᱑%) ᱟᱨ ᱛᱤᱨᱞᱟᱹ ᱫᱚ ᱑᱕,᱐᱖᱙ (᱕᱖.᱐᱗%) ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱡᱟᱱᱟᱝ ᱵᱷᱮᱜᱟᱨ (ᱛᱤᱨᱞᱟᱹ ᱟᱨ ᱠᱚᱲᱟ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱫᱚᱨ ᱛᱟᱞᱟ ᱨᱮ ᱵᱷᱮᱜᱟᱨ) ᱫᱚ ᱑᱗.᱖᱔% ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱠᱷᱚᱨᱠᱷᱚᱨᱤ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮ ᱫᱷᱟᱱᱵᱟᱫᱽ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱫᱷᱟᱱᱵᱟᱫᱽ ᱥᱚᱫᱚᱨ ᱪᱟᱸᱜᱟ ᱠᱷᱚᱸᱰ ᱨᱮ ᱵᱟᱜᱷᱢᱟᱨᱟ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱥᱚᱦᱚᱨ ᱠᱟᱱᱟ ᱾",
        "ᱳᱰᱤᱥᱟ ᱥᱴᱮᱴ ᱚᱯᱮᱱ ᱭᱩᱱᱤᱵᱷᱟᱨᱥᱤᱴᱤ (OSOU) ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱥᱚᱢᱵᱚᱞᱯᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜ ᱢᱤᱫᱴᱟᱝ ᱰᱤᱥᱴᱟᱱᱥ ᱛᱮ ᱥᱮᱪᱮᱫᱚᱜ ᱯᱚᱱᱚᱛ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱟᱱᱟ ᱾ ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱥᱚᱝᱥᱚᱫᱽ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱮᱠᱴ ᱛᱮ ᱒᱐᱑᱕ ᱨᱮ ᱱᱚᱶᱟ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱫᱚ ᱵᱮᱱᱟᱣ ᱞᱮᱱᱟ ᱾ ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱴᱚᱴᱷᱟ ᱨᱮ ᱱᱚᱶᱟ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮᱱᱟᱜ ᱛᱟᱞᱢᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱤᱱᱰᱤᱜᱚᱯᱮᱨᱟ ᱴᱤᱱᱠᱴᱚᱨᱤᱭᱟ , ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱟᱹᱨᱤ ᱤᱱᱰᱤᱜᱚ ᱦᱚᱸ ᱠᱚ ᱢᱮᱛᱟᱜᱼᱟ, ᱫᱚ ᱢᱚᱴᱚᱨ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱯᱨᱚᱠᱟᱨᱟᱜ ᱡᱟᱹᱛ ᱠᱟᱱᱟ ᱡᱟᱦᱟᱸ ᱫᱚ ᱤᱱᱰᱤᱜᱚ ᱨᱚᱝ ᱨᱮᱱᱟᱜ ᱢᱤᱫᱴᱟᱹᱝ ᱢᱩᱬᱩᱛ ᱥᱨᱚᱛ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱨᱤᱡᱟᱨᱵᱽ ᱵᱮᱸᱠ ᱱᱚᱴ ᱢᱩᱫᱽᱨᱟᱱ ᱯᱨᱟᱭᱵᱷᱮᱴ ᱞᱤᱢᱤᱴᱮᱰ, ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱨᱤᱡᱟᱨᱵᱽ ᱵᱮᱸᱠ ᱟᱜ ᱯᱩᱨᱟᱹ ᱫᱚᱠᱷᱚᱞᱤᱡ ᱜᱚᱲᱚ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱠᱟᱱᱟᱭ, ᱡᱟᱦᱟᱸᱭ ᱴᱷᱮᱱ ᱥᱟᱞᱵᱚᱱᱤ ᱟᱨ ᱢᱟᱭᱥᱩᱨ ᱨᱮ ᱥᱟᱞ ᱠᱮ ᱥᱟᱞ ᱑᱖ ᱵᱤᱞᱤᱭᱚᱱ ᱱᱚᱴ ᱟᱜ ᱠᱮᱯᱟᱥᱤᱴᱤ ᱭᱟᱜ ᱵᱮᱸᱠᱱᱚᱴ ᱯᱨᱤᱱᱴᱤᱝ ᱯᱨᱮᱥ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱯᱟᱲᱟ ᱫᱚ ᱢᱤᱫ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱠᱟᱱᱟ ᱱᱚᱣᱟ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱨᱮ ᱯᱩᱨᱩᱞᱤᱭᱟᱹ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱨᱚᱜᱷᱩᱱᱟᱛᱷᱯᱩᱨ ᱡᱚᱜᱚ ᱠᱷᱚᱸᱰ ᱨᱮ ᱢᱤᱫ ᱥᱟᱥᱚᱱ ᱪᱟᱪᱞᱟᱣ ᱠᱷᱚᱸᱰᱮ ᱵᱮᱱᱟᱣᱟ ᱾",
        "᱒᱐᱑᱑ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ, ᱪᱚᱸᱫᱽᱨᱚᱠᱳᱱᱟ ᱒ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱨᱮ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱦᱚᱲᱟᱜ ᱜᱩᱴ ᱮᱞ ᱫᱚ ᱘᱓,᱑᱔᱕ ᱜᱚᱴᱟᱝ (᱗᱖.᱙᱖%) ᱥᱤᱠᱷᱱᱟᱹᱛ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱚᱸᱰᱮ ᱠᱷᱚᱱ ᱔᱖,᱐᱘᱖ (᱘᱓.᱐᱙%) ᱠᱚᱲᱟ ᱟᱨ ᱓᱗,᱐᱕᱙ (᱗᱐.᱔᱙%) ᱛᱤᱨᱞᱟᱹ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱡᱟᱱᱟᱝ ᱵᱷᱮᱜᱟᱨ (ᱛᱤᱨᱞᱟᱹ ᱟᱨ ᱠᱚᱲᱟ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱫᱚᱨ ᱛᱟᱞᱟ ᱨᱮ ᱵᱷᱮᱜᱟᱨ) ᱫᱚ ᱑᱒.᱖᱐% ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱠᱷᱟᱨᱤᱯᱩᱠᱩᱨᱤᱭᱟᱹ ᱵᱚᱱᱚᱛ ᱯᱨᱟᱭᱢᱟᱨᱤ ᱦᱮᱞᱛᱷ ᱛᱟᱞᱢᱟ, ᱠᱷᱟᱨᱤᱯᱩᱠᱩᱨᱤᱭᱟᱹ, ᱯᱤᱳ ᱱᱛᱪᱤᱱᱫᱟ ᱵᱟᱡᱟᱨ (᱑᱐ ᱵᱮᱰ ᱟᱜ) ᱫᱚ ᱠᱳᱸᱴᱟᱭ ᱓ ᱥᱟᱶᱛᱟ ᱩᱛᱷᱱᱟᱹᱣ ᱵᱚᱱᱚᱛ ᱨᱮ ᱢᱩᱬ ᱢᱮᱰᱤᱠᱟᱞ ᱥᱩᱵᱤᱫᱷᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱵᱚᱱᱢᱟᱞᱤᱪᱟᱴᱴᱟ (᱑᱐ ᱵᱮᱰ ᱟᱜ), ᱵᱷᱤᱛᱜᱚᱲ (? ᱵᱮᱰ ᱟᱜ) ᱟᱨ ᱫᱮᱣᱩᱞᱵᱟᱲ (ᱵᱟᱨᱭᱟ ᱵᱮᱰ ᱟᱜ) ᱨᱮ ᱯᱨᱟᱭᱢᱟᱨᱤ ᱦᱮᱞᱛᱷ ᱛᱟᱞᱢᱟ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱱᱚᱶᱟ ᱯᱨᱚᱡᱮᱠᱴ ᱨᱮᱱᱟᱜ ᱥᱟᱹᱠᱷᱭᱟᱹᱛ ᱨᱮ, ᱤᱥᱨᱳ ᱨᱤᱱᱤᱡ ᱯᱟᱨᱥᱮᱛ ᱠᱮ. ᱥᱤᱵᱚᱱ ᱫᱚ ᱢᱮᱱ ᱞᱮᱫᱟ ᱡᱮ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱫᱚ ₹᱖᱑᱕ ᱠᱳᱴᱤ ᱴᱟᱠᱟ ᱦᱩᱭᱩᱜᱼᱟ (᱒᱐᱒᱓ ᱨᱮ ₹᱗᱒᱑ ᱠᱳᱴᱤ ᱴᱟᱠᱟ ᱥᱮ ᱙᱐ ᱢᱤᱞᱤᱭᱚᱱ ᱭᱩ.ᱮᱥ.ᱰᱚᱞᱟᱨ ᱥᱚᱢᱟᱱ)᱾",
        "ᱢᱟᱭᱠᱷᱮᱞᱥ ᱫᱚ ᱢᱤᱫ ᱱᱩᱱᱰ ᱢᱚᱰᱮᱞ ᱞᱮᱠᱟᱛᱮ ᱦᱚᱲ ᱟᱱ ᱠᱟᱹᱨᱤ ᱨᱮ ᱮᱦᱚᱵ ᱞᱮᱱᱟ ᱾ ᱯᱳᱨᱱ ᱪᱤᱛᱟᱹᱨ ᱨᱮ ᱠᱟᱞᱚᱠ ᱠᱚᱲᱟ ᱠᱚᱣᱟᱜ ᱪᱤᱛᱟᱹᱨ ᱨᱮ ᱵᱟᱝ ᱠᱚ ᱚᱥᱟᱣᱛᱟ ᱠᱟᱛᱮ ᱩᱱᱤ ᱑᱙᱘᱙ ᱥᱟᱹᱦᱤᱛ ᱨᱮ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱪᱚᱞᱚᱛ ᱪᱤᱛᱟᱹᱨ ᱨᱮᱭ ᱯᱟᱴᱷ ᱞᱮᱫᱟ᱾ ᱩᱱᱤ ᱫᱚ ᱟᱡ ᱨᱮᱱ ᱥᱚᱨᱮᱥ ᱵᱟᱨᱭᱟ ᱦᱚᱲ ᱠᱷᱚᱱ ᱧᱩᱛᱩᱢ ᱥᱮᱞᱮᱫ ᱠᱟᱛᱮ ᱟᱡᱟᱜ ᱯᱳᱨᱱ ᱧᱩᱛᱩᱢ ᱮ ᱦᱟᱛᱟᱣ ᱞᱮᱫᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱢᱩᱪᱟᱹᱫ ᱧᱩᱛᱩᱢ ᱫᱚ ᱢᱟᱭᱠᱮᱞ ᱡᱳᱨᱰᱚᱱ ᱟᱨ \" ᱥᱤᱱᱚ \" ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱥᱤᱱ ᱠᱳᱱᱟᱨᱤ (ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱢᱤᱫᱴᱟᱝ ᱵᱤᱵᱮᱶᱨᱮ ᱢᱟᱭᱠᱮᱞᱥ ᱫᱚ \" ᱠᱮᱢᱮᱨᱟ ᱨᱮ ᱟᱨ ᱵᱮ ᱨᱮ ᱢᱤᱫ ᱦᱚᱲ ᱨᱮᱱ ᱦᱚᱲ \" ᱞᱮᱠᱟᱛᱮ ᱵᱚᱨᱱᱚᱱ ᱟᱠᱟᱱᱟ ᱾ ᱑᱙᱙᱐ ᱥᱟᱹᱦᱤᱛ ᱨᱮ ᱡᱚᱱ ᱞᱮᱥᱞᱤ ᱟᱜ ' ᱳᱭᱟᱭᱟᱴ ᱮ ᱱᱟᱭᱤᱴ ' ᱪᱤᱛᱟᱹᱨ ᱨᱮ ᱯᱟᱴᱷ ᱛᱟᱭᱚᱢ ᱢᱟᱭᱠᱟᱮᱞᱥ ᱩᱯᱨᱩᱢᱮ ᱧᱟᱢ ᱞᱮᱫᱟ ᱾ ᱑᱙᱙᱖ ᱥᱟᱹᱦᱤᱛ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱥᱟᱱ ᱢᱟᱭᱠᱮᱞᱥ ᱯᱨᱚᱰᱟᱠᱥᱚᱱ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱫᱟᱭ , ᱡᱟᱦᱟᱸ ᱛᱟᱭᱚᱢ ᱥᱮᱨᱢᱟ ᱥᱟᱱ ᱢᱟᱭᱠᱮᱞᱚᱥ ᱤᱱᱴᱟᱨᱱᱮᱥᱱᱮᱞ ᱨᱮ ᱵᱚᱫᱚᱞ ᱦᱩᱭ ᱞᱮᱱᱟ , ᱡᱚᱠᱷᱚᱱ ᱮᱱᱟᱵᱳᱞᱤᱠ ᱵᱷᱤᱰᱤᱣ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱦᱟᱹᱴᱤᱧ ᱮ ᱮᱦᱚᱵ ᱞᱮᱫᱟ ᱾",
        "Booty Talk ᱑᱘ ᱒᱐᱐᱐ ᱣᱮᱥᱴ ᱠᱚᱥᱴ ᱯᱨᱚᱰᱚᱠᱥᱟᱱ ᱒ O",
        "ᱪᱷᱟᱯᱨᱟ ᱥᱤᱰᱤ ᱵᱚᱱᱚᱛ ᱨᱮ ᱢᱟᱨᱟᱝ ᱟᱹᱛᱩ ᱠᱚ (᱔,᱐᱐᱐+ ᱦᱚᱲ ᱮᱞ ᱟᱜ) ᱢᱮᱱᱟᱜᱼᱟ (᱒᱐᱑᱑ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ): ᱦᱟᱛᱤᱥᱚᱞᱟ (᱗,᱕᱔᱗), ᱢᱚᱦᱮᱥᱯᱩᱨ (᱕,᱙᱘᱕), ᱵᱟᱲᱟ ᱟᱱᱰᱩᱞᱤᱭᱟ (᱑᱕,᱐᱑᱒), ᱥᱚᱱᱯᱩᱠᱩᱨ (᱔,᱘᱗᱔), ᱦᱨᱤᱫᱚᱭᱯᱩᱨ (᱖,᱐᱖᱑), ᱵᱮᱛᱵᱚᱨᱤᱭᱟ (᱖,᱖᱘᱕), ᱦᱚᱴᱨᱟ (᱗,᱐᱘᱗), ᱪᱷᱳᱴᱟ ᱟᱱᱰᱩᱞᱤᱭᱟ (᱔,᱔᱗᱗), ᱵᱷᱚᱴᱜᱟᱪᱷᱤ (᱔,᱑᱘᱙), ᱦᱚᱛᱠᱷᱳᱞᱟ (᱗,᱑᱖᱔), ᱥᱤᱠᱨᱟ (᱖,᱓᱕᱙), ᱰᱚᱢᱯᱩᱠᱩᱨ (᱗,᱑᱐᱑), ᱞᱚᱠᱷᱢᱤᱜᱟᱪᱷᱟ (᱖,᱔᱘᱐), ᱵᱨᱤᱴᱤᱦᱩᱰᱟ (᱗,᱓᱓᱖), ᱜᱚᱠᱷᱩᱨᱟᱯᱚᱴᱟ (᱔,᱖᱕᱖), ᱯᱤᱛᱟᱢᱵᱚᱨᱯᱩᱨ (᱔,᱕᱙᱑), ᱫᱣᱤᱯᱪᱚᱸᱫᱽᱨᱚᱯᱩᱨ (᱔,᱗᱖᱙), ᱵᱮᱝᱜᱚᱞᱡᱷᱤ (᱑᱕,᱔᱔᱘), ᱵᱟᱞᱤᱰᱟᱝᱜᱟ (᱔,᱒᱑᱒), ᱟᱨᱚᱝᱥᱚᱨᱤᱥᱟ (᱔,᱖᱒᱓), ᱵᱚᱰᱮᱞᱚᱸᱜᱤ ᱯᱚᱫᱽᱢᱚᱢᱟᱞᱟ (᱙,᱐᱖᱖) ᱟᱨ ᱞᱚᱠᱷᱢᱤᱯᱩᱨ (᱔,᱔᱙᱒) ᱾",
        "ᱱᱤᱥᱤ ᱥᱟᱶ ᱤᱧ ᱯᱷᱤᱞᱢ ᱠᱚᱨᱟᱣ ᱟᱠᱟᱫ-ᱟ ᱟᱨ ᱱᱤᱥᱤ ᱫᱚ ᱤᱧᱟᱜ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮᱱᱤᱡ ᱧᱩᱛᱩᱢᱟᱱ ᱠᱷᱮᱞᱚᱸᱰᱟ. ᱩᱱᱤ ᱜᱮ ᱰᱟᱭᱨᱮᱠᱴᱚᱨ ᱠᱚᱣᱟᱜ ᱠᱩᱥᱤᱭᱟᱱ ᱠᱟᱱᱟᱭ ᱾ ᱰᱤ ᱫᱤᱱ ᱦᱟ.ᱵᱤᱡ, ᱟᱯᱟᱛ-ᱟᱯᱟᱛ ᱛᱟᱞᱟᱨᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱛᱮᱜ ᱜᱮ ᱟᱵᱚ ᱫᱚ ᱟᱭᱢᱟ ᱡᱤᱱᱤᱥ ᱠᱚ ᱧᱟᱢ ᱞᱮᱫ-ᱟ ᱾ ᱱᱚᱶᱟ ᱤᱱᱰᱟᱥᱴᱨᱤ ᱨᱮ ᱟᱹᱰᱤ ᱠᱚᱢ ᱜᱮᱠᱚ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱟᱨ ᱚᱞ ᱪᱤᱠᱤ ᱨᱮ ᱥᱟᱶᱛᱮ ᱠᱟᱹᱢᱤ ᱠᱟᱱ ᱦᱚᱲ ᱫᱚ ᱟᱨᱦᱚᱸ ᱠᱚᱢ ᱜᱮᱠᱚ ᱛᱟᱦᱮᱸᱱᱟ ᱾",
        "ᱛᱷᱚᱠ:ᱮᱰᱟᱞᱴ ᱯᱷᱨᱮᱧᱪ ᱯᱟᱯᱟᱴᱤᱭᱟᱹ ᱠᱚᱣᱟᱜ ᱛᱟᱞᱠᱟᱹ",
        "ᱨᱟᱭᱯᱩᱨ ᱥᱚᱨᱠᱟᱨᱤ ᱯᱚᱞᱤᱴᱮᱠᱱᱤᱠ ᱫᱚ ᱨᱟᱭᱯᱩᱨ ᱵᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱤᱫᱴᱟᱹᱝ ᱯᱚᱞᱤᱴᱮᱠᱱᱤᱠ ᱠᱚᱞᱮᱡᱽ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱒᱐᱑᱖ ᱥᱟᱞ ᱨᱮ ᱨᱟᱭᱯᱩᱨ ᱥᱩᱨ ᱥᱤᱨᱳᱢᱚᱱᱤᱯᱩᱨ ᱨᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱱᱟ ᱾",
        "᱑᱙᱒᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱ ᱢᱤᱫ ᱧᱩᱛᱩᱢᱟᱱ ᱯᱟᱨᱳᱴᱟ ᱰᱨᱟᱢᱟᱴᱤᱠ ᱠᱞᱚᱵᱽ www.parotadramaticclub.org ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱵᱮᱝᱜᱚᱞ ᱨᱮᱱ ᱦᱩᱞᱜᱟᱹᱨᱤᱭᱟᱹ ᱠᱟᱹᱢᱤᱦᱚᱨᱟ ᱥᱟᱶ ᱡᱚᱲᱟᱣ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ᱾ ᱱᱤᱛ ᱱᱚᱶᱟ ᱫᱚ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱸᱜᱽᱞᱟ ᱥᱳᱥᱟᱭᱴᱤ ᱨᱮᱡᱤᱥᱴᱨᱮᱥᱚᱱ ᱮᱠᱴ ᱒᱐᱖᱑ ᱨᱮ ᱨᱮᱡᱤᱥᱴᱨᱮᱥᱚᱱ ᱢᱮᱱᱟᱜᱼᱟ, ᱨᱮᱡᱤᱥᱴᱟᱨ ᱱᱟᱢᱵᱟᱨ - ᱮᱥ/ᱟᱭᱮᱞ/᱒᱐᱒᱕᱐ ᱥᱟᱶ ᱨᱮᱡᱤᱥᱴᱨᱮᱥᱚᱱ ᱟᱠᱟᱱᱟ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱟᱯᱱᱟᱨ ᱵᱤᱞᱰᱤᱝ, ᱠᱷᱮᱞᱚᱸᱰ ᱡᱟᱭᱜᱟ, ᱚᱯᱷᱤᱥ ᱮᱢᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ᱾",
        "ᱵᱽᱞᱩ ᱵᱮ ᱨᱮᱭᱟᱜ ᱢᱚᱭᱤᱢᱤ ᱥᱟᱦᱟᱨ ᱨᱮ , ᱥᱟᱫᱷᱟᱹ ᱠᱮᱞᱞᱤ ᱵᱷᱮᱱ ᱨᱟᱭᱮᱱ ᱟᱡᱟᱜ ᱦᱟᱭᱥᱠᱩᱞ ᱨᱮᱱ ᱜᱚᱭᱤᱱᱮᱥᱚᱱ ᱠᱟᱣᱥᱚᱱᱞᱟᱨ ᱥᱮᱢ ᱞᱟᱢᱵᱟᱨᱰᱳ ᱪᱮᱛᱟᱱ ᱩᱱᱤ ᱫᱚ ᱜᱟᱹᱨᱰᱩ ᱨᱮᱭᱟᱜ ᱞᱟᱹᱞᱤᱥ ᱮ ᱥᱚᱫᱚᱨ ᱞᱮᱫᱟ ᱾ ᱱᱚᱶᱟ ᱞᱟᱹᱞᱤᱥ ᱛᱟᱭᱚᱢ , ᱟᱡ ᱨᱮᱱ ᱚᱵᱷᱟᱵ ᱟᱠᱟᱱ ᱥᱮᱪᱮᱫ ᱜᱟᱛᱮ ᱥᱩᱡᱤ ᱴᱳᱞᱟᱨ , ᱡᱟᱦᱟᱸᱭ ᱮᱵᱷᱟᱨᱜᱞᱟᱰᱮᱥ ᱨᱮᱭᱟᱜ ᱢᱤᱫᱴᱟᱝ ᱠᱷᱚᱛᱤᱲ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ , ᱦᱚᱸ ᱢᱤᱫ ᱞᱮᱠᱟᱱ ᱞᱟᱹᱞᱤᱥ ᱮ ᱥᱚᱫᱚᱨ ᱟᱠᱟᱫᱟ ᱾ ᱥᱮᱢ ᱟᱡ ᱨᱮᱱ ᱨᱩᱠᱷᱟᱹᱭᱟᱹ ᱞᱟᱹᱜᱤᱫ ᱮᱴᱨᱤᱱᱤ ᱠᱮᱱᱮᱛ ᱵᱳᱰᱮᱱ ᱮ ᱵᱟᱦᱟᱞ ᱞᱮᱫᱮᱭᱟ ᱾ ᱞᱟᱹᱞᱤᱥᱨᱮ ᱥᱩᱡᱤ ᱠᱨᱚᱥᱼᱡᱤᱢᱟᱱ ᱚᱠᱛᱚ ᱫᱟᱵᱽ ᱨᱮ ᱠᱚ ᱜᱚᱡ ᱞᱮᱱᱟ ᱟᱨ ᱥᱤᱱᱟᱹᱥ ᱥᱩᱡᱤ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱤᱫᱴᱟᱝ ᱦᱩᱰᱤᱧ ᱰᱨᱟᱜᱽᱥ ᱨᱮᱭᱟᱜ ᱞᱟᱹᱞᱤᱥ ᱛᱮ ᱡᱮᱦᱚᱞ ᱠᱷᱚᱱ ᱵᱟᱞᱤᱭ ᱧᱟᱢ ᱨᱮ ᱵᱟᱝ ᱥᱤᱱᱟᱹᱞ ᱞᱟᱹᱜᱤᱫ ᱩᱱᱤ ᱟᱨ ᱠᱮᱞᱤ ᱫᱚ ᱥᱮᱢᱼ ᱥᱩᱡᱤ ᱪᱮᱛᱟᱱ ᱟᱨ ᱩᱱᱤ ᱟᱡ ᱟᱭᱳ ᱨᱤᱭᱮᱞ ᱮᱥᱴᱮᱴ ᱵᱤᱨᱟᱹᱫᱟᱹᱞᱤ ᱥᱟᱱᱫᱨᱟ ᱵᱷᱮᱱ ᱨᱟᱭᱮᱱ ᱥᱟᱶᱛᱮ ᱟᱭᱟᱜ ᱟᱠᱷᱟᱲᱟ ᱞᱟᱹᱜᱤᱫ ᱩᱱᱤ ᱫᱚ ᱟᱨ ᱠᱮᱞᱤ ᱫᱚ ᱥᱤᱢᱼ ᱥᱩᱡᱤᱭᱟᱜ ᱪᱮᱛᱟᱱ ᱨᱮ ᱵᱷᱟᱞᱮ ᱦᱟᱛᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱞᱟᱹᱞᱤᱥ ᱠᱚ ᱵᱮᱱᱟᱣ ᱞᱮᱫᱟ ᱾ ᱥᱮᱢ ᱟᱨ ᱠᱮᱱᱮᱛ ᱫᱚ ᱢᱟᱱᱦᱟᱹᱞ ᱞᱟᱹᱜᱤᱫ 85,00,000 ᱰᱚᱞᱟᱨ ᱨᱮᱭᱟᱜ ᱢᱤᱫᱴᱟᱝ ᱵᱟᱹᱛᱤᱞ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱠᱟᱛᱷᱟᱼᱵᱩᱫᱤᱥ ᱞᱮᱫᱟ , ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱮᱱᱫᱨᱟ ᱢᱤᱫᱴᱟᱝ ᱴᱨᱟᱥᱴ ᱠᱷᱚᱱ ᱠᱟᱹᱣᱰᱤ ᱵᱮᱣᱦᱟᱨ ᱠᱟᱛᱮ ᱮᱢ ᱞᱮᱫᱟᱭ , ᱡᱟᱦᱟᱸ ᱫᱚ ᱠᱮᱞᱞᱤ ᱫᱚ ᱥᱮᱱᱫᱨᱟ ᱟᱜ ᱜᱚᱡ ᱛᱟᱭᱚᱢᱮ ᱧᱟᱢᱼᱟ ᱾ ᱠᱟᱹᱣᱰᱤ ᱮᱢᱚᱜ ᱛᱟᱭᱚᱢ ᱵᱟᱰᱟᱭ ᱧᱟᱢᱚᱜᱼᱟ ᱡᱮ ᱥᱮᱢ ᱟᱨ ᱵᱟᱨᱭᱟ ᱠᱩᱲᱤ ᱜᱤᱫᱽᱨᱟᱹ ᱥᱟᱱᱫᱨᱟ ᱴᱷᱮᱱ ᱠᱷᱚᱱ ᱠᱟᱹᱣᱰᱤ ᱠᱚ ᱦᱟᱛᱟᱶ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱞᱟᱹᱞᱤᱥ ᱫᱚ ᱵᱮᱣᱦᱟᱨ ᱠᱟᱛᱮ ᱠᱚ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟ ᱾",
        "ᱠᱩᱨᱥᱤᱭᱟᱝ (Bengali pronunciation: [ˈkaɾʃi̯aŋ], [ˈkhʌrsaŋ]) ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱨᱮ ᱫᱟᱨᱡᱤᱞᱤᱝ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱥᱚᱦᱚᱨ ᱟᱨ ᱢᱤᱫ ᱱᱚᱜᱚᱨ ᱯᱟᱞᱤᱠᱟ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱠᱩᱨᱥᱤᱭᱟᱝ ᱥᱟᱵᱰᱤᱵᱷᱤᱥᱟᱱ ᱨᱮᱱᱟᱜ ᱦᱮᱰᱠᱩᱣᱟᱴᱚᱨ ᱠᱟᱱᱟ ᱾",
        "Pat Benco (Pat Manning) as Second Reader",
        "ᱩᱱᱚᱠᱛᱮ ᱥᱮᱪᱮᱫᱤᱭᱟᱹ ᱠᱟᱢᱤ ᱫᱚ ᱢᱤᱫᱴᱟᱝ ᱦᱟᱥᱯᱟᱛᱟᱞ ᱨᱮ ᱤᱫᱤ ᱠᱟᱛᱮ ᱟᱨ ᱵᱮᱴᱤ ᱚᱲᱟᱜ ᱮ ᱪᱟᱞᱟᱣ ᱮᱱᱟ ᱾ ᱰᱮᱱᱤᱥ ᱛᱟᱭᱚᱢ ᱨᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱾ (\" ᱤᱧ ᱡᱩᱫᱤ ᱦᱚᱨᱟᱨ ᱪᱚᱞᱚᱛ ᱪᱤᱛᱟᱹᱨ ᱠᱷᱚᱱ ᱠᱤᱪᱷᱩᱢ ᱥᱮᱪᱚᱜᱼᱟ \") ᱱᱚᱣᱟ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱡᱮ , ᱢᱚᱱᱳᱡᱟᱹᱭᱟᱱ ᱦᱚᱨᱟᱨ ᱵᱷᱤᱞᱮᱱ ᱫᱚ ᱡᱚᱠᱷᱚᱱ ᱩᱱᱤ ᱢᱤᱫᱞᱮ ᱟᱨ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱵᱟᱝ ᱠᱚ ᱵᱟᱝ ᱠᱚ ᱥᱮᱱᱼᱟ ᱩᱱᱚᱠᱛᱮ ᱩᱱᱤ ᱫᱚ ᱵᱟᱝ ᱮ ᱥᱮᱱᱚᱜᱼᱟ ᱟᱨ ᱵᱟᱝ ᱮ ᱥᱮᱱ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱢᱟᱨᱮᱱ ᱯᱚᱛᱚᱵ ᱰᱮᱱᱤᱥ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱ ᱥᱮᱨᱮᱧ ᱠᱚ ᱵᱟᱰᱟᱭ ᱧᱟᱢ ᱠᱟᱛᱮ ᱯᱚᱛᱚᱵ ᱫᱚ ᱯᱷᱚᱞᱤᱯ ᱠᱟᱛᱮ ᱟᱡ ᱟᱨ ᱥᱮᱪᱮᱫᱤᱭᱟᱹ ᱫᱚ ᱚᱱᱟ ᱠᱚ ᱢᱩᱫᱨᱮ ᱡᱳᱜᱳᱜ ᱠᱚᱨᱟᱣ ᱧᱮᱞ ᱞᱮᱱᱟ ᱾ ᱰᱮᱱᱤᱥ ᱫᱚ ᱯᱚᱛᱚᱵ ᱨᱮ ᱤᱫᱤ ᱠᱟᱛᱮ ᱟᱨ ᱩᱱᱤ ᱟᱨ ᱥᱮᱪᱮᱫᱤᱭᱟᱹ ᱫᱚ ᱡᱚᱠᱷᱚᱱ ᱵᱮᱼᱵᱟᱹᱨᱥᱤ ᱠᱟᱹᱢᱤ ᱢᱩᱪᱟᱹᱫ ᱠᱮᱫᱟ ᱩᱱᱫᱚ ᱥᱮᱪᱮᱫᱤᱭᱟᱹ ᱯᱷᱨᱮᱰᱤᱭ ᱨᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱟᱨ ᱩᱱᱤ ᱰᱮᱱᱤᱥ ᱮ ᱠᱳᱢᱟ ᱨᱮ ᱫᱚᱦᱚ ᱠᱮᱫᱟ ᱾",
        "ᱵᱷᱚᱸᱡᱽᱯᱩᱨ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱳᱰᱤᱥᱟ ᱯᱚᱱᱚᱛ ᱨᱮ ᱮᱛᱚᱢ ᱥᱟᱢᱟᱝ ᱨᱮᱞᱣᱮ ᱨᱮᱱᱟᱜ ᱢᱤᱫᱴᱟᱹᱝ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱵᱟᱨᱤᱯᱚᱫᱟ ᱥᱚᱦᱚᱨ ᱨᱮᱭ ᱠᱟᱹᱢᱤ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱠᱳᱰ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ VZR ᱾ ᱱᱚᱣᱟ ᱨᱮ ᱵᱟᱨᱭᱟ ᱯᱞᱮᱴᱯᱷᱚᱨᱢ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱯᱟᱥᱮᱱᱡᱚᱨ, ᱮᱠᱥᱯᱨᱮᱥ ᱟᱨ ᱥᱩᱯᱚᱨᱯᱷᱟᱥᱴ ᱴᱨᱮᱱ ᱫᱚ ᱵᱷᱚᱸᱡᱽᱯᱩᱨ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱨᱮ ᱛᱤᱸᱜᱩᱭᱟ ᱾",
        "ᱠᱷᱳᱣᱟᱨ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱵᱚᱫᱟᱠᱷᱥᱟᱱ ᱨᱮᱭᱟᱜ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱱᱤᱭᱟᱱ ᱯᱟᱹᱨᱥᱤ ᱥᱟᱶ ᱟᱹᱰᱤ ᱜᱟᱱ ᱢᱳᱨᱯᱷᱚᱞᱚᱡᱤᱠᱟᱞ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱩᱛᱚᱨ ᱪᱤᱛᱨᱟᱞ ᱨᱮ ᱯᱨᱳᱴᱳ-ᱠᱷᱳᱣᱟᱨ ᱯᱟᱹᱨᱥᱤ ᱨᱮᱭᱟᱜ ᱟᱹᱰᱤ ᱢᱟᱲᱟᱝ ᱚᱵᱚᱫᱷᱤ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱜᱟᱱᱫᱷᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱥᱟᱶ ᱱᱚᱣᱟ ᱨᱮᱭᱟᱜ ᱡᱚᱲᱟᱣ ᱠᱷᱚᱱ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟ ᱡᱮ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱤ.ᱥᱤ. ᱯᱩᱭᱞᱩ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟᱯᱟᱲᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟ ᱤᱨᱟᱹᱞ ᱥᱮᱨᱢᱟ ᱜᱚᱴᱟ",
        "ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱨᱚᱲ ᱦᱚᱲ ᱠᱚ ᱑᱐ ᱟᱨ ᱑᱓ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱨᱮ ᱠᱚᱧᱮᱼᱥᱟᱢᱟᱝ ᱤᱣᱨᱳᱯ ᱨᱮ ᱟᱹᱰᱤ ᱢᱟᱨᱟᱝ ᱴᱚᱴᱷᱟ ᱠᱚᱨᱮ ᱠᱚ ᱵᱟᱥᱟ ᱞᱮᱱᱟ ᱾ ᱑᱔ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱛᱟᱞᱢᱟ ᱟᱨ ᱯᱟᱪᱮ ᱤᱣᱨᱳᱯ ᱨᱮᱦᱚᱸ ᱯᱟᱥᱱᱟᱣ ᱮᱱᱟ ᱾ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱨᱚᱲᱼᱮᱫ ᱠᱟᱱ ᱟᱹᱭᱫᱟᱹᱨᱤᱭᱟᱹ ᱠᱚᱣᱟᱜ ᱨᱩᱯ ᱫᱚ ᱦᱩᱰᱤᱧ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱠᱚ ᱨᱚᱲᱼᱮᱫ ᱠᱟᱱ ᱟᱹᱰᱤ ᱜᱟᱱ ᱦᱚᱲ ᱜᱮ ᱡᱤᱯᱥᱤ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱᱟ ᱾ ᱤᱱᱟᱹ ᱛᱟᱭᱚᱢ ᱮᱴᱟᱜ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱥᱟᱶ ᱥᱚᱢᱵᱷᱚᱸᱫᱷ ᱠᱟᱛᱮ ᱱᱚᱶᱟ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱥᱤᱧᱚᱛ ᱩᱯᱚᱡᱮᱞᱟ ᱠᱷᱚᱱ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱢᱮᱱᱛᱮ ᱵᱟᱰᱟᱭ ᱧᱟᱢ ᱮᱱᱟ ᱾",
        "᱒᱐᱑᱙: ᱩᱱᱤ ᱫᱚ ᱯᱩᱱᱮ ᱨᱮ ᱠᱷᱮᱞᱚ ᱤᱱᱰᱤᱭᱟ ᱭᱩᱴᱷ ᱠᱷᱮᱞ ᱨᱮ ᱑᱕᱐᱐ ᱟᱨ ᱕᱐᱐᱐ ᱨᱮ ᱥᱚᱱᱟᱭ ᱟᱢᱮᱴ ᱞᱮᱫᱼᱟ ᱾",
        "ᱥᱮᱱᱴᱟᱨ ᱯᱷᱚᱨ ᱳᱣᱟᱞᱰ ᱤᱭᱩᱱᱤᱵᱷᱤᱥᱴᱟᱨᱤ ᱨᱮᱱᱠᱤᱝᱥ (ᱥᱤᱹᱰᱞᱤᱭᱩ ᱹᱣᱤᱭᱩ ᱹᱟᱨ) ᱒᱐᱒᱒ ᱨᱮᱭᱟᱜ ᱨᱮᱝᱠᱤᱝ \" ᱡᱟᱦᱟᱸ ᱫᱚ ᱢᱤᱫᱴᱟᱝ ᱥᱩᱢᱩᱝ ᱡᱮᱜᱮᱫ ᱡᱮᱜᱮᱫ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮᱭᱟᱜ ᱨᱮᱝᱠᱝ ᱩᱪᱷᱟᱹᱱ ᱟᱠᱟᱫᱟ ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱮᱪᱮᱫ ᱟᱨ ᱥᱮᱪᱮᱫ ᱨᱮᱭᱟᱜ ᱢᱟᱱᱫᱟᱹᱨᱤ ᱥᱟᱶᱼᱥᱟᱶᱛᱮ ᱥᱟᱨᱵᱷᱮ ᱟᱨ ᱡᱮᱜᱮᱫ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮᱭᱟᱜ ᱛᱚᱛᱛᱟ ᱥᱟᱵᱩᱫ ᱨᱮᱭᱟᱜ ᱪᱮᱛᱟᱱ ᱴᱮᱦᱟᱴ ᱵᱟᱝ ᱠᱟᱛᱮ ᱥᱮᱪᱮᱫᱤᱭᱟᱹ ᱠᱚᱣᱟᱜ ᱢᱟᱹᱱ ᱟᱨ ᱩᱱᱠᱩᱭᱟᱜ ᱛᱚᱞᱟᱥ ᱨᱮᱭᱟᱜ ᱢᱟᱱᱫᱩᱠ ᱠᱚ ᱵᱤᱰᱟᱹᱣᱼᱟ \" , ᱤᱭᱤᱭᱤᱭᱳ ᱫᱚ ᱡᱮᱜᱮᱫ ᱡᱟᱠᱟᱛ 99 ᱟᱱᱟᱜ ᱴᱷᱟᱶᱮ ᱦᱟᱢᱮᱴ ᱟᱠᱟᱫᱟ ᱾",
        "ᱫᱷᱟᱱᱣᱟᱨ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱨᱟᱡᱽᱫᱷᱟᱱᱣᱟᱨ ᱧᱩᱛᱩᱢ ᱛᱮᱦᱚᱸ ᱵᱟᱰᱟᱭᱚᱜᱼᱟ, ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮ ᱜᱤᱨᱤᱰᱤᱦ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱠᱷᱳᱨᱤ ᱢᱚᱦᱩᱣᱟ ᱥᱟᱵᱽᱰᱤᱵᱤᱡᱚᱱ ᱨᱮ ᱫᱷᱟᱱᱣᱟᱨ ᱥᱤᱰᱤ ᱵᱚᱱᱚᱛ ᱨᱮ ᱢᱤᱫ ᱞᱮᱠᱷᱟᱥᱤᱫ ᱥᱚᱦᱚᱨ ᱠᱟᱱᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱜᱤᱨᱤᱰᱤᱦ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱵᱮᱯᱟᱨᱤ ᱴᱷᱟᱶ ᱠᱟᱱᱟ ᱾",
        "᱒᱐᱑᱙ ᱨᱮ ᱟᱡ ᱫᱚᱥᱟᱨ ᱫᱷᱟᱣ ᱡᱮᱜᱮᱛ ᱯᱟᱨᱟ ᱟᱛᱷᱞᱮᱴᱤᱠᱥ ᱪᱟᱢᱯᱤᱭᱟᱱᱥᱤᱯ ᱨᱮ ᱡᱤᱛᱠᱟᱹᱨ ᱞᱮᱱᱟᱭ ᱟᱨ ᱒᱐᱑᱙ ᱨᱮ ᱫᱩᱵᱟᱭ ᱨᱮ ᱡᱮᱜᱮᱛ ᱯᱟᱨᱟ ᱟᱛᱷᱞᱮᱴᱤᱠᱥ ᱪᱟᱢᱯᱤᱭᱟᱱᱥᱤᱯ ᱚᱠᱛᱚ ᱨᱮ ᱠᱩᱲᱤ ᱯᱟᱨᱟ ᱟᱛᱷᱞᱮᱴᱤᱠᱥ ᱛᱷᱚᱠ ᱨᱮ ᱴᱳᱠᱤᱭᱳ ᱒᱐᱒᱐ ᱞᱟᱹᱜᱤᱫ ᱯᱟᱨᱟᱞᱤᱢᱯᱤᱠ ᱠᱳᱴᱟ ᱡᱤᱛᱠᱟᱹᱨ ᱞᱮᱱᱟᱭ ᱾",
        "᱑᱙᱗᱕ ᱠᱷᱚᱱ ᱑᱙᱗᱙ ᱫᱷᱟᱹᱵᱤᱡ, ᱠᱦᱮᱢᱟᱨ ᱨᱩᱡᱽ ᱫᱚ ᱟᱭᱢᱟ ᱯᱚᱛᱚᱵ ᱟᱨ ᱯᱚᱛᱚᱵ ᱪᱤᱛᱟᱹᱨ ᱠᱚ ᱵᱷᱮᱡᱟ ᱠᱮᱫᱼᱟ ᱾ ᱱᱚᱶᱟ ᱨᱮᱱᱟᱜ ᱖᱕,᱐᱐᱐ ᱠᱷᱚᱱ ᱒᱐% ᱦᱟᱹᱴᱤᱧ ᱫᱚᱦᱚ ᱦᱩᱭ ᱟᱠᱟᱱᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱥᱟᱹᱨᱤ ᱮᱞ ᱫᱚ ᱵᱟᱰᱟᱭ ᱵᱟᱝ ᱧᱟᱢ ᱟᱠᱟᱱᱟ ᱾",
        "ᱜᱚᱝᱜᱟ ᱱᱟᱨᱟᱭᱚᱱ ᱥᱤᱝ (᱒᱕ ᱮᱯᱨᱤᱞ ᱑᱗᱙᱐ - ᱗ ᱯᱷᱮᱵᱽᱨᱩᱣᱟᱨᱤ ᱑᱘᱓᱓) ᱫᱚ ᱡᱚᱝᱜᱚᱞ ᱢᱚᱦᱚᱞ ᱨᱮᱱ ᱢᱤᱫ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱨᱟᱡᱽᱟᱹᱨᱤ ᱠᱟᱱᱟᱭ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱵᱷᱩᱢᱤᱡᱽ ᱨᱟᱡᱽᱟᱹᱨᱤ ᱨᱮᱱ ᱢᱩᱲᱩᱛ ᱦᱚᱲ ᱞᱮᱠᱟᱛᱮ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟᱭ᱾ ᱩᱱᱤ ᱫᱚ ᱑᱘᱓᱒-᱑᱘᱓᱓ ᱨᱮ ᱤᱥᱴ ᱤᱱᱰᱤᱭᱟ ᱠᱚᱢᱯᱟᱱᱤ ᱨᱤᱱᱤᱡ ᱨᱟᱡᱽᱜᱟᱲᱤᱭᱟᱹ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱨᱤᱴᱤᱥ ᱱᱚᱶᱟ ᱫᱚ \"ᱜᱚᱝᱜᱟ ᱱᱟᱨᱟᱭᱤᱱ ᱨᱮᱭᱟᱜ ᱦᱟᱝᱜᱟᱢᱟ\" ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ, ᱢᱮᱱᱠᱷᱟᱱ ᱱᱟᱜᱟᱢᱤᱭᱟᱹ ᱠᱚ ᱱᱚᱶᱟ ᱫᱚ ᱪᱩᱣᱟ.ᱲ ᱞᱟ.ᱲᱦᱟ.ᱭ ᱠᱚ ᱢᱮᱛᱟᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾",
        "ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱥᱩᱨ ᱥᱚᱦᱚᱨ: ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱵᱟᱜᱟᱱ ᱨᱮ ᱟᱹᱰᱤ ᱜᱟᱱ ᱟᱹᱛᱩ ᱟᱨ ᱜᱚᱢᱯᱟ (ᱢᱚᱱᱫᱤᱨ) ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱦᱟᱢᱤᱨᱟ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱫᱚ ᱠᱚᱧᱮ ᱨᱮᱞᱣᱮ ᱴᱚᱴᱷᱟ ᱨᱮᱱᱟᱜ ᱯᱷᱤᱨᱚᱡᱽᱯᱩᱨ ᱨᱮᱞᱣᱮ ᱰᱤᱵᱤᱡᱚᱱ ᱨᱮᱱᱟᱜ ᱟᱢᱵᱟᱞᱟ-ᱟᱴᱟᱨᱤ ᱞᱟᱭᱤᱱ ᱨᱮ ᱢᱤᱫ ᱨᱮᱞᱣᱮ ᱥᱴᱮᱥᱚᱱ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱯᱚᱧᱡᱟᱵᱽ ᱨᱮ ᱠᱟᱯᱩᱨᱛᱷᱟᱞᱟ ᱦᱚᱱᱚᱛ ᱨᱮ ᱦᱟᱢᱤᱨᱟ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱢᱤᱫᱴᱟᱝ ᱵᱩᱛᱟ ᱠᱳᱞᱟ ᱥᱮ ᱫᱟᱭᱵᱷᱟ ᱱᱟᱢ ᱨᱮ ᱟᱠᱷᱲᱟ ᱩᱫᱩᱜ ᱨᱮ ᱥᱮᱨᱮᱧ, ᱮᱱᱮᱡ, ᱥᱮᱨᱮᱧ ᱟᱨ ᱯᱟᱥᱱᱟᱣ ᱟᱱᱟᱜ ᱦᱚᱨᱚᱜᱼᱵᱩᱴᱟᱹ ᱥᱮᱞᱮᱫ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱢᱟᱨᱮᱱ ᱛᱩᱞᱩ ᱨᱮ ᱥᱮᱨᱮᱧ ᱨᱮ ᱵᱚᱸᱜᱟᱭᱟᱜ ᱡᱟᱱᱟᱢ ᱨᱮᱭᱟᱜ ᱠᱟᱛᱷᱟ ᱞᱟᱹᱭ ᱟᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱶᱟ ᱫᱚ ᱱᱟᱦᱟᱜ ᱴᱷᱟᱶ ᱨᱮ ᱪᱮᱫ ᱞᱮᱠᱟᱛᱮ ᱦᱮᱡ ᱟᱠᱟᱱᱟ ᱚᱱᱟ ᱨᱮᱭᱟᱜ ᱠᱟᱛᱷᱟ ᱞᱟᱹᱭ ᱦᱩᱭ ᱟᱠᱟᱱᱟ ᱾",
        "ᱥᱩᱪᱤᱛᱛᱨᱟ 1975 ᱥᱟᱹᱦᱤᱛ ᱨᱮᱭᱟᱜ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱢᱚᱦᱟᱨᱟᱥᱴᱨᱚ ᱨᱮᱭᱟᱜ ᱢᱩᱢᱵᱟᱭ ᱢᱤᱫᱴᱟᱝ ᱛᱮᱞᱮᱜᱩ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟ, ᱟᱡ ᱵᱟᱵᱟ ᱵᱷᱤ ᱠᱨᱤᱥᱱᱟᱢᱩᱨᱛᱷᱤ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ ᱟᱭ ᱠᱚᱨ ᱨᱮᱱ ᱢᱟᱨᱮᱱ ᱠᱚᱢᱤᱥᱚᱱᱟᱨ ᱟᱨ ᱟᱡ ᱟᱭᱳ ᱫᱚ ᱛᱟᱦᱮᱸᱠᱟᱱᱟᱭ ᱰᱚᱠᱛᱟᱨ ᱥᱚᱞᱳᱪᱚᱱ ᱠᱨᱤᱥᱱᱟᱢᱩᱨᱛᱤ ᱢᱤᱫ ᱱᱟᱜᱟᱢᱤᱭᱟᱹ ᱟᱨ ᱢᱤᱫ ᱦᱚᱲ ᱥᱮᱪᱮᱫᱤᱭᱟᱹ ᱾ ᱥᱩᱪᱤᱛᱛᱨᱟ ᱪᱚᱞᱚᱛ ᱪᱤᱛᱟᱹᱨ ᱵᱮᱱᱟᱣᱤᱡ ᱥᱮᱠᱷᱚᱨ ᱠᱟᱯᱩᱨ ᱥᱟᱶᱛᱮ ᱵᱟᱯᱞᱟ ᱞᱮᱱᱟᱭ, ᱢᱮᱱᱠᱷᱟᱱ ᱩᱱᱠᱩ ᱢᱩᱫᱨᱮ ᱰᱟᱣᱩᱱᱞᱳᱰ ᱦᱳᱭ ᱞᱮᱱᱟ ᱾ ᱠᱟᱵᱮᱨᱤ ᱠᱟᱯᱩᱨ ᱧᱩᱛᱩᱢ ᱛᱮ ᱩᱱᱠᱩᱣᱟᱜ ᱢᱤᱫ ᱦᱚᱯᱚᱱ ᱮᱨᱟ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾",
        "᱒᱐᱑᱔- ᱱᱤᱭᱩ ᱭᱚᱨᱠ ᱤᱱᱰᱤᱭᱟᱱ ᱯᱷᱤᱞᱢ ᱯᱷᱮᱥᱴᱤᱵᱷᱟᱞ - ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱱᱟᱯᱟᱭ ᱟᱠᱴᱨᱮᱥ ᱥᱤᱨᱯᱷᱟᱹ",
        "ᱚᱣᱥᱴ ᱮᱝᱞᱮᱥᱤ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟ ᱟᱨ ᱠᱮᱢᱵᱨᱤᱡᱽ ᱡᱮᱜᱮᱫ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱨᱮ ᱵᱮᱱᱟᱣ ᱠᱟᱹᱨᱤ ᱨᱮ ᱯᱟᱲᱦᱟᱣ ᱞᱮᱫᱟᱭ ᱾ ᱩᱱᱤ ᱫᱚ ᱵᱟᱨᱞᱤᱱ ᱨᱮᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ 2007 ᱠᱷᱚᱱ 2017 ᱥᱟᱹᱦᱤᱛ ᱢᱩᱫᱨᱮ ᱡᱟᱨᱢᱟᱱ ᱠᱟᱹᱨᱤᱜᱚᱞ ᱵᱮᱧᱡᱟᱢᱤᱱ ᱳᱣᱟᱞᱛᱷᱮᱨ ᱥᱟᱶ ᱮ ᱠᱟᱹᱢᱤ ᱟᱠᱟᱫᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱠᱟᱹᱨᱤ ᱡᱤᱭᱚᱱ ᱵᱮᱜᱚᱨ, ᱚᱥᱴ ᱫᱚ ᱥᱮᱨᱮᱧ ᱮ ᱚᱞ ᱞᱮᱫᱟ ᱾",
        "ᱥᱚᱨᱜᱚᱢ ᱫᱚ ᱢᱚᱦᱟᱨᱟᱥᱴᱨᱚ ᱨᱮᱱᱟᱜ ᱨᱚᱛᱱᱚᱜᱤᱨᱤ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱫᱟᱵᱳᱞ ᱥᱚᱦᱚᱨ ᱨᱮ ᱢᱤᱫ ᱢᱟᱨᱟᱴᱷᱤ ᱥᱮᱨᱮᱧ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟᱭ ᱾ ᱟᱡ ᱟᱭᱳ ᱱᱤᱞᱟ ᱜᱷᱟᱱᱮᱠᱚᱨ ᱫᱚ ᱢᱤᱫ ᱥᱚᱥᱛᱨᱤᱭᱚ ᱥᱮᱨᱮᱧᱤᱭᱟᱹ ᱟᱨ ᱥᱮᱨᱮᱧ ᱥᱮᱪᱮᱫᱤᱭᱟᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾ ᱩᱱᱤ ᱫᱚ ᱟᱨᱮᱱᱡᱚᱨ-ᱥᱮᱨᱮᱧᱤᱭᱟᱹ ᱚᱱᱤᱞ ᱢᱳᱦᱤᱞᱮ ᱠᱚ ᱵᱟᱰᱟᱭᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱠᱟᱞᱭᱟᱱᱡᱤ-ᱟᱱᱚᱱᱫᱽᱡᱤ ᱞᱟᱹᱜᱤᱫ ᱥᱮᱨᱮᱧ ᱨᱮᱱᱟᱜ ᱵᱮᱵᱚᱥᱛᱟ ᱟᱠᱟᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱩᱱᱤ ᱫᱚ ᱥᱚᱨᱜᱚᱢ ᱮ ᱵᱟᱰᱟᱭ ᱦᱚᱪᱚ ᱠᱮᱜᱼᱟ ᱟᱨ ᱩᱱᱤ ᱫᱚ ᱡᱤ.ᱯᱤ. ᱥᱤᱯᱯᱤ ᱭᱟᱜ ᱛᱨᱤᱥᱱᱟ (᱑᱙᱗᱘) ᱨᱮ ᱠᱤᱥᱳᱨ ᱠᱩᱢᱟᱨ ᱦᱚᱛᱮᱛᱮ ᱥᱮᱨᱮᱧ ᱟᱠᱟᱱ \"ᱯᱚᱢ ᱯᱚᱨᱟᱢᱯᱚᱢ, ᱵᱳᱞᱮ ᱡᱤᱣᱟᱱ ᱠᱤ ᱥᱚᱨᱜᱚᱢ\" ᱨᱮ ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚᱣᱟᱜ ᱠᱚᱨᱥ ᱨᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾ ᱥᱚᱨᱜᱚᱢ ᱫᱚ ᱔ ᱥᱮᱨᱢᱟ ᱩᱢᱮᱨ ᱨᱮ ᱥᱮᱨᱮᱧ ᱯᱷᱮᱥᱴᱤᱵᱷᱟᱞ ᱥᱣᱟᱭ ᱜᱚᱸᱫᱷᱚᱨᱵᱟ ᱨᱮ ᱮᱱᱮᱡ ᱞᱮᱫᱼᱟ ᱾",
        "2014 ᱼ ᱡᱤᱛᱠᱟᱹᱨ ᱞᱮᱱᱟᱼᱥᱤᱱᱟᱹᱱ ᱯᱟᱴᱷᱚᱠᱤᱭᱟᱹ ᱞᱟᱹᱜᱤᱫ ᱡᱤ ᱥᱤᱱᱮ ᱥᱤᱨᱯᱟᱹᱭ ᱦᱟᱢᱮᱴ ᱞᱮᱫᱟ ᱾ ᱛᱤᱨᱞᱟᱹᱼᱵᱷᱟᱜ ᱢᱤᱞᱠᱷᱟ ᱵᱷᱟᱜᱽᱵᱷᱟᱜᱽ ᱢᱤᱞᱠᱷᱟ ᱵᱷᱟᱜᱽ",
        "᱑᱙᱙᱖ ᱥᱟᱹᱦᱤᱛ ᱵᱟᱞᱪᱚᱱᱫᱨᱚ ᱢᱮᱱᱚᱱ ᱢᱟᱞᱚᱭᱟᱞᱚᱢ ᱪᱚᱞᱚᱛ ᱪᱤᱛᱟᱹᱨ 19 ᱮᱯᱨᱤᱞ ᱥᱚᱫᱚᱨᱚᱜ ᱞᱟᱦᱟ ᱱᱚᱱᱫᱤᱱᱤ ᱫᱚ ᱢᱤᱫᱴᱟᱝ ᱢᱳᱫᱟᱞᱤᱝ ᱠᱟᱹᱢᱤ ᱡᱤᱭᱚᱱᱮ ᱦᱟᱛᱟᱣ ᱞᱮᱫᱟ ᱾ ᱛᱟᱭᱚᱢ ᱥᱮᱨᱢᱟ ᱩᱱᱤ ᱫᱚ ᱟᱡᱟᱜ ᱯᱟᱹᱦᱤᱞ ᱛᱟᱢᱤᱞ ᱪᱚᱞᱚᱛᱪᱤᱛᱟᱹᱨ ᱠᱟᱞᱟᱢᱮᱞᱞᱟᱢ ᱠᱟᱫᱷᱚᱞ ᱵᱷᱟᱡᱜᱟᱨᱮ (1997) ᱢᱩᱨᱟᱞᱤ ᱥᱟᱞᱟᱜ ᱮ ᱧᱮᱞ ᱞᱮᱱᱟ ᱟᱨ ᱛᱟᱢᱤᱞ ᱨᱮ ᱟᱭᱢᱟ ᱜᱟᱱ ᱥᱤᱜᱤᱞ ᱪᱚᱞᱚᱛᱪᱤᱛᱟᱹᱨ ᱨᱮ ᱯᱟᱴᱷ ᱞᱮᱫᱟᱭ ᱡᱮᱞᱮᱠᱟ ᱱᱮᱨᱤᱠᱩᱠᱩ ᱱᱟᱨᱮ (1997) ᱼᱯᱨᱤᱭᱟᱢᱩᱫᱚᱱ (1998) ᱥᱳᱞᱟᱢᱟᱞ (1998) ᱼᱯᱩᱵᱷᱮᱞᱤ (1998) -ᱵᱟᱱᱛᱷᱟᱭᱯᱳᱯᱳᱞᱟ (2000) ᱼ ᱟᱨ ᱠᱳᱴᱤ (2001) ᱼᱨᱮ ᱾",
        "ᱟᱡ ᱵᱟᱵᱟ ᱥᱩᱡᱤᱛ ᱢᱚᱫᱚᱱ ᱫᱚ ᱢᱤᱫ ᱵᱮᱯᱟᱨᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱟᱨ ᱟᱡ ᱟᱭᱳ ᱱᱤᱨᱩ ᱢᱚᱫᱚᱱ ᱫᱚ ᱢᱤᱫ ᱪᱤᱛᱟᱹᱨᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱾ ᱩᱱᱤᱭᱤᱡ ᱢᱤᱫ ᱢᱟᱨᱟᱝ ᱵᱚᱭᱦᱟ ᱢᱮᱱᱟᱭᱟ, ᱡᱟᱦᱟᱸᱭᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱚᱨᱡᱩᱱ ᱢᱚᱫᱚᱱ ᱠᱟᱱᱟ ᱾ ᱢᱚᱫᱚᱱ ᱟᱡᱟᱜ ᱟᱥᱲᱟ ᱥᱮᱪᱮᱫ ᱫᱚ ᱫᱤᱞᱞᱤ ᱯᱚᱵᱽᱞᱤᱠ ᱥᱠᱩᱞ, ᱢᱚᱛᱷᱩᱨᱟ ᱨᱳᱰ, ᱱᱟᱶᱟ ᱫᱤᱞᱞᱤ ᱠᱷᱚᱱ ᱯᱩᱨᱟᱹᱣ ᱞᱮᱫᱼᱟ ᱟᱨ ᱡᱤᱥᱩᱥ ᱮᱱᱰ ᱢᱮᱨᱤ ᱠᱚᱞᱮᱡᱽ, ᱫᱤᱞᱞᱤ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ, ᱱᱟᱶᱟ ᱫᱤᱞᱞᱤ ᱠᱷᱚᱱ ᱠᱚᱢᱚᱨᱥ ᱨᱮ ᱟᱡᱟᱜ ᱯᱟᱲᱦᱟᱣ ᱯᱩᱨᱟᱹᱣ ᱞᱮᱫᱼᱟ ᱾",
        "ᱡᱚᱢᱩᱱᱟ ᱫᱚ ᱯᱩᱭᱞᱩ ᱫᱷᱟᱣ ᱢᱚᱦᱟᱵᱟᱛ ᱠᱤ ᱠᱟᱥᱚᱣᱛᱤ (᱑᱙᱓᱔-ᱦᱤᱱᱫᱤ) ᱟᱨ ᱨᱩᱯᱞᱮᱠᱷᱟ (ᱵᱮᱝᱜᱚᱞᱤ) ᱨᱮ ᱦᱩᱰᱤᱧ ᱢᱤᱫ ᱯᱟᱴ ᱞᱮᱠᱟᱛᱮ ᱠᱟᱹᱢᱤ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱯᱤᱹᱥᱤᱹ ᱵᱟᱨᱩᱣᱟ ᱦᱟᱜ ᱫᱤᱥᱟᱹᱫᱩᱜ ᱛᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱱᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱡᱚᱢᱩᱱᱟ ᱟᱨ ᱯᱤᱹᱥᱤ ᱭᱟᱜ ᱫᱩᱞᱟᱹᱲ ᱥᱟᱹᱜᱟᱹᱭ ᱛᱚᱯᱚᱞ ᱞᱮᱱᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱡᱚᱢᱩᱱᱟ ᱚᱱᱟ ᱞᱟᱦᱟ ᱵᱟᱨ ᱴᱷᱮᱱ ᱮ ᱡᱟᱶᱟᱭ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ ᱾ ᱢᱤᱫ ᱮᱠᱴᱨᱮᱥ ᱞᱮᱠᱟᱛᱮ ᱯᱩᱭᱞᱩ ᱫᱷᱟᱣ ᱯᱤᱹᱥᱤᱹ ᱵᱟᱨᱩᱣᱟ ᱦᱟᱜ ᱫᱮᱵᱽᱫᱟᱥ (᱑᱙᱓᱕) ᱯᱷᱤᱞᱢ ᱨᱮ ᱫᱟᱣ ᱮ ᱧᱟᱢ ᱠᱮᱫᱼᱟ ᱾ ᱞᱟᱹᱭ ᱟᱠᱚ ᱵᱟᱝᱢᱟ ᱚᱱᱟ ᱯᱷᱤᱞᱢ ᱥᱩᱴᱤᱝ ᱮᱦᱚᱵ ᱦᱤᱞᱚᱜ ᱫᱚ ᱡᱚᱢᱩᱱᱟ ᱥᱴᱩᱰᱤᱭᱳ ᱵᱟᱭ ᱪᱟᱞᱟᱣ ᱞᱮᱱᱟ, ᱩᱱ ᱚᱠᱛᱚ ᱫᱚ ᱯᱤᱹ ᱥᱤᱹ ᱥᱟᱶ ᱜᱮ ᱟᱡᱟᱜ ᱵᱟᱥᱟ ᱨᱮ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ, ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱵᱤᱱ ᱥᱟᱯᱲᱟᱣ ᱛᱮᱜᱮ ᱠᱟᱹᱢᱤ ᱨᱮ ᱟᱬᱜᱚᱱ ᱢᱮᱱ ᱛᱮ ᱠᱚ ᱢᱮᱛᱟᱫ ᱮ ᱛᱟᱦᱮᱸᱫ ᱾",
        "ᱱᱟᱦᱟᱜ ᱨᱮ (᱒᱐᱒᱐) ᱥᱩᱫᱮᱯᱩᱨ ᱴᱚᱴᱷᱟ ᱨᱮᱭᱟᱜ ᱟᱶᱛᱟ ᱨᱮ ᱤᱥᱴᱚᱨ ᱠᱳᱞᱯᱷᱤᱞᱰᱥ ᱞᱤᱢᱤᱴᱮᱰ ᱨᱮᱭᱟᱜ ᱵᱟᱨᱭᱟ ᱠᱩᱭᱞᱟᱹ ᱠᱷᱟᱫᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ, ᱱᱟᱴᱩᱨᱤᱭᱟ ᱥᱤᱰᱤ ᱵᱚᱞᱚᱠ ᱨᱮ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱯᱟᱨᱵᱮᱞᱤᱭᱟ ᱟᱨ ᱰᱩᱵᱮᱥᱥᱚᱨᱤ ᱾ ᱵᱟᱨᱰ ᱮᱱᱰ ᱠᱳᱼ ᱨᱮᱭᱟᱜ ᱫᱤᱱ ᱠᱷᱚᱱ ᱟᱭᱢᱟ ᱥᱮᱨᱢᱟ ᱫᱷᱟᱹᱵᱤᱡ ᱥᱟᱞᱛᱳᱲ ᱠᱩᱭᱞᱟᱹ ᱠᱟᱹᱢᱤ ᱟᱠᱟᱱᱭ ᱾",
        "᱒᱐᱒᱔ ᱵᱟᱪᱷᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ, ᱙᱖᱘ ᱢᱤᱞᱤᱭᱚᱱ ᱦᱚᱲ ᱵᱟᱪᱷᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱞᱟᱹᱠᱛᱤᱭᱟᱱ ᱠᱟᱱᱟ ᱠᱚ, ᱒᱐᱑᱙ ᱵᱟᱪᱷᱱᱟᱣ ᱠᱷᱚᱱ ᱑᱕᱐ ᱢᱤᱞᱤᱭᱚᱱ ᱦᱚᱲᱟᱜ ᱰᱷᱮᱨ ᱾ ᱚᱨᱩᱬᱟᱪᱚᱞ ᱯᱨᱚᱫᱮᱥ ᱨᱮ, ᱢᱟᱞᱳᱜᱟᱢ ᱟᱹᱛᱩ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱵᱟᱪᱷᱱᱟᱣ ᱴᱷᱟᱶ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱵᱟᱪᱷᱱᱟᱣ ᱴᱷᱟᱶ ᱵᱮᱱᱟᱣ ᱦᱩᱭᱩᱜᱼᱟ, ᱪᱮᱫᱟᱜ ᱥᱮ ᱵᱟᱪᱷᱱᱟᱣ ᱟᱹᱨᱤ ᱡᱚᱛᱚ ᱛᱟᱦᱮᱱ ᱴᱷᱟᱶ ᱠᱷᱚᱱ ᱵᱟᱨ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ ᱥᱟᱸᱜᱤᱧ ᱨᱮ ᱵᱟᱪᱷᱱᱟᱣ ᱴᱷᱟᱶ ᱠᱚ ᱫᱚᱦᱚ ᱞᱟᱹᱠᱛᱤ ᱠᱟᱱᱟ ᱾ ᱠᱮᱨᱟᱞᱟ ᱨᱮ ᱡᱤᱞ ᱡᱤᱵᱽ ᱡᱤᱭᱟᱹᱞᱤ ᱨᱟᱠᱷᱟᱵᱤᱨ ᱨᱮ ᱟᱨ ᱜᱩᱡᱽᱨᱟᱴ ᱨᱮ ᱢᱤᱫ ᱥᱯᱤᱝ ᱠᱚᱱᱴᱮᱱᱚᱨ ᱨᱮ ᱦᱚᱸ ᱵᱷᱳᱴᱤᱝ ᱤᱥᱴᱮᱥᱚᱱ ᱠᱚ ᱵᱮᱱᱟᱣ ᱦᱩᱭᱩᱜᱼᱟ ᱾",
        "ᱯᱷᱟᱛᱮᱦᱯᱩᱨ ᱥᱮᱠᱷᱟᱣᱟᱴᱤ ᱫᱚ ᱪᱩᱨᱩ-ᱥᱤᱠᱟᱨ-ᱡᱚᱭᱯᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜ ᱠᱚᱧᱮ ᱯᱟᱪᱮ ᱨᱮᱞᱣᱮ ᱴᱚᱴᱷᱟ ᱨᱮ ᱦᱤᱡᱩᱜᱼᱟ ᱾",
        "᱒᱐᱑᱗ ᱥᱮᱨᱢᱟ ᱨᱮ, ᱯᱚᱪᱷᱤᱢ ᱵᱟᱝᱞᱟ ᱨᱤᱱᱤᱡ ᱨᱟᱡᱽᱯᱟᱞ",
        "ᱢᱚᱫᱷᱩᱯᱩᱨ-ᱜᱤᱨᱤᱰᱤᱦ-ᱠᱳᱰᱟᱨᱢᱟ ᱞᱟᱭᱤᱱ ᱫᱚ ᱑᱓᱘ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱘᱖ ᱢᱤᱞ) ᱡᱤᱞᱤᱧ ᱢᱤᱫᱴᱟᱹᱝ ᱕ ᱯᱷᱩᱴ ᱖ ᱤᱸᱪ (᱑,᱖᱗᱖ ᱢᱤᱞᱤᱢᱤᱴᱚᱨ) ᱵᱨᱚᱰᱜᱮᱡᱽ ᱴᱨᱮᱠ ᱠᱟᱱᱟ ᱾ ᱡᱟᱦᱟᱸ ᱫᱚ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱯᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱜᱤᱨᱤᱰᱤᱦ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱜᱤᱨᱤᱰᱤᱦ ᱥᱚᱦᱚᱨ ᱞᱮᱠᱟᱛᱮ ᱫᱮᱣᱜᱷᱚᱨ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱚᱫᱷᱩᱯᱩᱨ ᱥᱚᱦᱚᱨ ᱠᱷᱚᱱ ᱠᱚᱰᱟᱨᱢᱟ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱠᱚᱰᱟᱨᱢᱟ ᱥᱚᱦᱚᱨ ᱫᱷᱟᱹᱨᱤᱡ ᱥᱮᱱᱚᱜᱼᱟ ᱾ ᱱᱚᱣᱟ ᱫᱚ ᱢᱚᱫᱷᱩᱯᱩᱨ-ᱜᱤᱨᱤᱰᱤᱦ ᱨᱮᱞᱣᱮ ᱞᱟᱭᱤᱱ ᱨᱮᱱᱟᱜ ᱢᱤᱫᱴᱟᱹᱝ ᱦᱟᱹᱴᱤᱧ ᱠᱟᱱᱟ ᱾ ᱠᱳᱰᱟᱨᱢᱟ-ᱢᱚᱦᱮᱥᱢᱩᱸᱰᱟ ᱦᱟᱹᱴᱤᱧ ᱫᱚ ᱥᱟᱢᱟᱝ ᱛᱟᱞᱢᱟ ᱨᱮᱞᱣᱮ ᱨᱮᱱᱟᱜ ᱫᱷᱟᱱᱵᱟᱫᱽ ᱦᱚᱱᱚᱛ ᱟᱨ ᱜᱤᱨᱤᱰᱤᱦ-ᱢᱚᱫᱷᱩᱯᱩᱨ ᱦᱟᱹᱴᱤᱧ ᱫᱚ ᱥᱟᱢᱟᱝ ᱨᱮᱞᱣᱮ ᱨᱮᱱᱟᱜ ᱟᱥᱟᱱᱥᱳᱞ ᱰᱤᱵᱤᱡᱚᱱ ᱛᱟᱞᱟ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱠᱳᱰᱟᱨᱢᱟ ᱠᱷᱚᱱ ᱢᱚᱦᱮᱥᱢᱩᱸᱰᱟ ᱫᱷᱟᱹᱨᱤᱡ ᱑᱑᱐ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱖᱘ ᱢᱤᱞ) ᱨᱮᱞ ᱞᱟᱭᱤᱱ ᱥᱟᱢᱟᱝ ᱛᱟᱞᱢᱟ ᱨᱮᱞᱣᱮ ᱨᱮᱱᱟᱜ ᱫᱷᱟᱱᱵᱟᱫᱽ ᱰᱤᱵᱤᱡᱚᱱ ᱨᱮᱱᱟᱜ ᱛᱟᱞᱢᱟ ᱨᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱾",
        "᱑᱙᱐᱔ ᱥᱮᱨᱢᱟ ᱨᱮ ᱵᱨᱚᱰ-ᱜᱮᱡᱽ ᱟᱜᱽᱨᱟ-ᱫᱤᱞᱞᱤ ᱠᱳᱨᱰ ᱮᱦᱚᱵ ᱞᱮᱱᱟ ᱾ ᱱᱟᱶᱟ ᱫᱤᱞᱞᱤ ᱨᱮᱱᱟᱜ ᱵᱮᱱᱟᱣ (᱑᱙᱒᱗-᱒᱘ ᱥᱮᱨᱢᱟ ᱨᱮ) ᱚᱠᱛᱚ ᱨᱮ ᱱᱚᱣᱟ ᱨᱮᱱᱟᱜ ᱛᱤᱱᱟᱹᱜ ᱜᱟᱱ ᱦᱟᱹᱴᱤᱧ ᱠᱚ ᱫᱚᱦᱲᱟ ᱵᱮᱱᱟᱣ ᱨᱩᱣᱟᱹᱲ ᱟᱠᱟᱱᱟ ᱾",
        "᱒᱐᱐᱖ ᱥᱮᱨᱢᱟ ᱦᱟᱹᱵᱤᱡ ᱥᱨᱤ ᱥᱟᱛᱷᱭᱟ ᱥᱟᱭ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱢᱩᱢᱵᱟᱭ ᱟᱨ ᱪᱮᱱᱱᱟᱭ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱞᱟᱹᱜᱤᱫ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱦᱚᱛᱮᱛᱮ ᱠᱟᱹᱢᱤ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱒᱐᱐᱖ ᱠᱷᱚᱱ ᱒᱐᱐᱘ ᱫᱷᱟᱹᱵᱤᱡ, ᱤᱱᱰᱤᱭᱟᱱ ᱮᱭᱟᱨᱞᱟᱭᱤᱱᱥ ᱟᱡᱟᱜ ᱦᱟᱭᱫᱨᱟᱵᱟᱫᱽᱼᱵᱤᱥᱟᱠᱷᱟᱯᱟᱴᱱᱟᱢ ᱥᱮᱵᱟ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱯᱩᱴᱟᱯᱟᱨᱛᱷᱤ ᱨᱮ ᱢᱤᱫ ᱥᱴᱚᱯᱚᱣᱟᱨ ᱞᱮᱠᱟᱛᱮ ᱩᱰᱟᱹᱱ ᱞᱮᱱᱟ ᱛᱟᱦᱮᱸᱫ ᱾ ᱤᱱᱰᱤᱭᱟᱱ ᱮᱭᱟᱨᱞᱟᱭᱤᱱᱥ ᱦᱚᱸ ᱒᱐᱐᱕ ᱥᱟᱞᱮ ᱨᱮ ᱵᱚᱝᱜᱟᱞᱳᱨ ᱠᱷᱚᱱ ᱥᱮᱨᱢᱟ ᱨᱮ ᱯᱮ ᱫᱷᱟᱣ ᱩᱰᱟᱹᱣ ᱮᱫᱟ ᱾ ᱑᱒ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱒᱐᱐᱕ ᱦᱤᱞᱚᱜ, ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱞᱚᱵᱽ ᱠᱚᱥᱴ ᱠᱟᱨᱭᱟᱨ ᱮᱭᱟᱨ ᱰᱮᱠᱟᱱ ᱫᱚ ᱦᱟᱭᱫᱨᱟᱵᱟᱫᱽ ᱟᱨ ᱪᱮᱱᱱᱟᱭ ᱠᱷᱚᱱ ᱫᱤᱱ ᱨᱮ ᱵᱟᱨ ᱫᱷᱟᱣ ᱥᱮᱵᱟ ᱮᱦᱚᱵ ᱞᱮᱫᱼᱟ ᱾ ᱒᱐᱐᱗ ᱥᱮᱨᱢᱟ ᱨᱮ ᱫᱤᱞᱞᱤ ᱨᱮ ᱢᱮᱱᱟᱜ ᱡᱚᱜᱥᱚᱱ ᱮᱭᱟᱨᱞᱟᱭᱤᱱᱥ ᱦᱚᱸ ᱪᱮᱱᱱᱟᱭ ᱠᱷᱚᱱ ᱯᱩᱴᱟᱯᱟᱨᱛᱷᱤ ᱞᱟᱹᱜᱤᱫ ᱥᱮᱵᱟ ᱮᱦᱚᱵ ᱞᱮᱫᱟ, ᱒᱐᱐᱘ ᱥᱮᱨᱢᱟ ᱨᱮ ᱱᱚᱣᱟ ᱠᱚ ᱵᱚᱫᱚᱞ ᱞᱮᱫᱟ᱾ ᱠᱤᱝᱯᱷᱤᱥᱟᱨ ᱮᱭᱟᱨᱞᱟᱭᱤᱱᱥ ᱒᱐᱐᱗ ᱠᱷᱚᱱ ᱒᱐᱐᱘ ᱦᱟᱹᱵᱤᱡ ᱦᱟᱭᱫᱽᱨᱟᱵᱟᱫᱽ ᱟᱨ ᱵᱮᱝᱜᱟᱞᱩᱨᱩ ᱠᱷᱚᱱ ᱯᱩᱴᱟᱯᱟᱨᱛᱷᱤ ᱥᱮᱵᱟ ᱞᱮᱫ ᱛᱟᱦᱮᱸᱫ, ᱡᱚᱠᱷᱚᱱ ᱯᱩᱴᱟᱯᱟᱨᱛᱷᱤ ᱞᱟᱹᱜᱤᱫ ᱡᱚᱛᱚ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱚ ᱵᱚᱫᱚᱞ ᱠᱮᱫᱼᱟ ᱾ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱥᱨᱤ ᱥᱟᱛᱷᱭᱟ ᱥᱟᱭ ᱤᱱᱥᱴᱤᱴᱭᱩᱴ ᱚᱯᱷ ᱦᱟᱭᱡᱟᱨ ᱢᱮᱰᱤᱠᱟᱞ ᱥᱟᱭᱤᱱᱥ, ᱯᱩᱴᱴᱟᱯᱟᱨᱴᱤ ᱨᱮ ᱞᱟᱹᱠᱛᱤᱭᱟᱱ ᱠᱟᱹᱢᱤ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱥᱮᱵᱟ ᱮᱦᱚᱵᱟ ᱟᱨ ᱯᱨᱚᱥᱟᱱᱛᱤ ᱱᱤᱞᱟᱭᱟᱢ ᱟᱨ ᱚᱱᱟ ᱥᱩᱨᱥᱩᱯᱩᱨ ᱴᱚᱴᱷᱟ ᱨᱮ ᱥᱮᱴᱮᱨᱚᱜ ᱠᱟᱱ ᱢᱟᱹᱱᱢᱤ ᱠᱚᱣᱟᱜ ᱜᱚᱲᱚ ᱮᱢᱚᱜᱼᱟ ᱾",
        "ᱛᱤᱨᱩᱣᱚᱱᱚᱱᱛᱯᱩᱨᱚᱢ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ , ᱢᱤᱫ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱠᱮᱨᱟᱞᱟ ᱨᱮᱱᱟᱜ ᱨᱟᱡᱽᱜᱟᱲ ᱛᱤᱨᱩᱣᱚᱱᱚᱱᱛᱯᱩᱨᱚᱢ ᱨᱮ ᱥᱮᱵᱟ ᱮᱫᱼᱟ ᱾ ᱑᱙᱓᱒ ᱥᱮᱨᱢᱟ ᱨᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱ ᱱᱚᱣᱟ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱫᱚ ᱠᱮᱨᱟᱞᱟ ᱯᱚᱱᱚᱛ ᱨᱮ ᱯᱩᱭᱞᱩ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱟᱱᱟ ᱟᱨ ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱢᱚᱬᱮ ᱟᱱᱟᱜ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱑᱙᱙᱑ ᱥᱮᱨᱢᱟ ᱨᱮ ᱥᱚᱨᱠᱟᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱩᱪᱷᱟᱹᱱ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱮᱭᱟᱨ ᱤᱱᱰᱤᱭᱟ, ᱮᱭᱟᱨ ᱤᱱᱰᱤᱭᱟ ᱮᱠᱥᱯᱨᱮᱥ, ᱤᱱᱰᱤᱜᱳ ᱟᱨ ᱥᱯᱟᱭᱤᱥ ᱡᱮᱴ ᱨᱮᱱᱟᱜ ᱠᱟᱹᱢᱤ ᱦᱚᱨᱟ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱫᱚ ᱘᱐᱐ ᱮᱠᱚᱨ (᱓᱒᱐ ᱦᱮᱠᱴᱟᱨ) ᱴᱚᱴᱷᱟ ᱨᱮ ᱯᱟᱥᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱫᱚ ᱥᱚᱦᱚᱨ ᱛᱟᱞᱢᱟ ᱟᱨ ᱯᱚᱫᱽᱢᱚᱱᱟᱵᱷᱚᱥᱣᱟᱢᱤ ᱢᱚᱱᱫᱤᱨ ᱠᱷᱚᱱ ᱓.᱗ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱒.᱓ ᱢᱟᱭᱤᱞ) ᱯᱟᱪᱮ ᱥᱮᱫ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱠᱳᱵᱟᱞᱟᱢ ᱵᱤᱪ ᱠᱷᱚᱱ ᱑᱖ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱙.᱙ ᱢᱟᱭᱤᱞ), ᱴᱮᱠᱱᱳᱯᱟᱨᱠ ᱠᱷᱚᱱ ᱑᱓ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱘.᱑ ᱢᱟᱭᱤᱞ) ᱟᱨ ᱵᱤᱡᱷᱤᱱᱡᱟᱢ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱡᱟᱦᱟᱡᱽ ᱜᱷᱟᱴ ᱠᱷᱚᱱ ᱒᱑ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱑᱓ ᱢᱟᱭᱤᱞ) ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱥᱟᱱᱠᱩᱢᱩᱜᱷᱟᱢ ᱵᱤᱪ ᱥᱟᱶ ᱥᱟᱹᱜᱟᱹᱭ ᱢᱮᱱᱟᱜᱼᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮ ᱟᱨᱚᱵᱽ ᱫᱚᱨᱭᱟ ᱨᱮᱱᱟᱜ ᱥᱩᱨ ᱨᱮ ᱢᱮᱱᱟᱜ ᱩᱰᱟᱹᱱ ᱰᱟᱹᱦᱤ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱫᱚᱨᱭᱟ ᱠᱷᱚᱱ ᱐.᱖ ᱢᱟᱭᱤᱞ (ᱜᱟᱺᱴ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ) ᱥᱟᱺᱜᱤᱧ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱩᱱᱤᱭᱟᱜ ᱟᱹᱭᱩᱨ ᱛᱮ ᱴᱤ.ᱥᱤ.ᱮᱥ. ᱫᱚ ᱒᱐᱑᱕-᱑᱖ ᱨᱮ ᱑᱖.᱕ ᱵᱤᱞᱤᱭᱚᱱ ᱟᱢᱮᱨᱤᱠᱟ ᱰᱚᱞᱟᱨ ᱨᱮᱱᱟᱜ ᱥᱟᱱᱟᱢ ᱠᱷᱚᱱ ᱡᱟᱹᱥᱛᱤ ᱴᱷᱟᱶ ᱮ ᱟᱢᱮᱴ ᱞᱮᱫᱼᱟ ᱾ ᱕᱕᱖,᱐᱐᱐ ᱠᱷᱚᱱ ᱰᱮᱦᱮᱨ ᱠᱟᱹᱢᱤᱭᱟᱹ ᱥᱟᱶᱛᱮ, ᱴᱤ.ᱥᱤ.ᱮᱥ. ᱫᱚ ᱥᱤᱧᱚᱛ ᱨᱮ ᱯᱨᱟᱭᱵᱷᱮᱴ ᱥᱮᱠᱴᱚᱨ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱠᱟᱹᱢᱤᱭᱟᱹ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ ᱾ ᱒᱐᱑᱕-᱑᱖ ᱨᱮᱱᱟᱜ ᱢᱩᱪᱟᱹᱫ ᱫᱷᱟᱹᱨᱤᱡ ᱴᱤ.ᱥᱤ.ᱮᱥ. ᱗᱐ ᱵᱤᱞᱤᱭᱚᱱ ᱟᱢᱮᱨᱤᱠᱟ ᱰᱚᱞᱟᱨ ᱠᱷᱚᱱ ᱰᱮᱦᱮᱨ ᱨᱮᱱᱟᱜ ᱵᱮᱵᱚᱥᱛᱟ ᱠᱮᱯᱤᱴᱚᱞ ᱥᱟᱶᱛᱮ ᱥᱤᱧᱚᱛ ᱨᱤᱱᱤᱡ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱫᱟᱢ ᱟᱱᱤᱡ ᱠᱚᱢᱯᱟᱹᱱᱤ ᱞᱮᱠᱟᱛᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱒᱐᱑᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱴᱤ.ᱥᱤ.ᱮᱥ. ᱫᱚ ᱟᱭᱤ.ᱴᱤ. ᱥᱮᱵᱟ ᱨᱮ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱟᱹᱰᱤ ᱫᱟᱲᱮᱭᱟᱱ ᱵᱨᱟᱱᱰ ᱞᱮᱠᱟᱛᱮ ᱵᱟᱪᱷᱚᱱ ᱞᱮᱱᱟ ᱟᱨ ᱒᱔ ᱜᱚᱴᱟᱝ ᱫᱤᱥᱚᱢ ᱨᱮ ᱴᱤ.ᱥᱤ.ᱮᱥ. ᱫᱚ ᱡᱮᱜᱮᱛ ᱨᱮᱱᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱠᱟᱹᱢᱤᱭᱟᱹ ᱞᱮᱠᱟᱛᱮ ᱢᱟᱹᱱ ᱮ ᱧᱟᱢ ᱞᱮᱫᱼᱟ ᱾",
        "ᱵᱟᱹᱲᱛᱤ ᱥᱟᱨᱪᱚᱯᱥ ᱠᱚ ᱫᱚ ᱵᱚᱱ ᱨᱮᱭᱟᱜ ᱠᱤᱪᱷᱩ ᱛᱮᱛᱮᱫ ᱠᱚ ᱥᱟᱶᱛᱮ ᱛᱤᱵᱮᱛᱟᱱ ᱵᱩᱫᱽᱫᱷᱩ ᱫᱷᱚᱨᱚᱢ ᱠᱚ ᱯᱟᱧᱡᱟᱭᱟ, ᱡᱩᱫᱤ ᱦᱚᱸ ᱰᱩᱣᱟᱨᱥ ᱨᱮ ᱛᱟᱦᱮᱱ ᱠᱟᱱ ᱠᱚ ᱫᱚ ᱮᱱᱤᱢᱤᱡᱥᱟᱢ (Animism)ᱠᱚ ᱯᱟᱧᱡᱟᱭᱟ᱾",
        "Zhob District at www.balochistanpolice.gov.pk",
        "ᱩᱱᱤ ᱫᱚ ᱑᱙᱗᱗ ᱥᱟᱞ ᱨᱮ ᱨᱟᱡᱽᱟᱹᱨᱤ ᱨᱮᱭ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟ ᱾ ᱑᱙᱗᱘ ᱥᱟᱞ ᱨᱮ, ᱡᱤᱦᱚᱞ ᱵᱷᱟᱨᱳ ᱟᱱᱫᱚᱞᱟᱱ ᱚᱠᱛᱚ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱡᱤᱦᱚᱞ ᱨᱮᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱡᱩᱱ ᱒᱐᱐᱙ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱨᱟᱡᱽ ᱥᱚᱵᱷᱟ ᱞᱟᱹᱜᱤᱫ ᱮ ᱵᱟᱪᱷᱚᱱ ᱞᱮᱱᱟ ᱟᱨ ᱡᱩᱞᱟᱭ ᱒᱐᱑᱐ ᱨᱮ ᱫᱚᱦᱲᱟ ᱨᱟᱡᱽ ᱥᱚᱵᱷᱟ ᱞᱟᱹᱜᱤᱫ ᱮ ᱵᱟᱪᱷᱚᱱ ᱞᱮᱱᱟ ᱾",
        "᱒᱐᱐᱓ ᱢᱩᱬ ᱯᱨᱮᱢ ᱠᱤ ᱫᱤᱣᱟᱱᱤ ᱦᱩᱱ ᱟᱡᱟᱜ ᱴᱷᱟᱶ ᱨᱮ",
        "᱑᱒ ᱡᱩᱞᱟᱭ ᱒᱐᱑᱗ ᱦᱤᱞᱚᱜ, 'ᱥᱚᱱᱤᱠᱟ ᱪᱚᱣᱦᱟᱱ ᱒᱗ ᱯᱷᱚᱸᱰᱮᱥᱚᱱ' ᱫᱚ ᱟᱡᱟᱜ ᱡᱟᱱᱟᱢ ᱢᱟᱦᱟᱸ ᱨᱮ ᱥᱚᱱᱤᱠᱟ ᱪᱚᱣᱦᱟᱱ ᱞᱟᱹᱜᱤᱫ ᱢᱤᱫ ᱫᱟᱠᱟ ᱟᱨ ᱮᱱᱮᱢ ᱞᱮᱠᱟᱛᱮ ᱟᱡᱟᱜ ᱟᱭᱳ-ᱵᱟᱵᱟ ᱴᱳᱞᱞᱤᱜᱩᱸᱡᱽ ᱠᱞᱟᱵᱽ ᱨᱮ ᱮᱦᱚᱵ ᱞᱮᱱᱟ ᱾ 'ᱥᱳᱱᱤᱠᱟ ᱪᱚᱣᱦᱟᱱ ᱒᱗ ᱯᱷᱚᱸᱰᱮᱥᱚᱱ' ᱫᱚ ᱥᱚᱱᱟᱤᱠᱟ ᱥᱤᱢᱳᱱᱤ ᱥᱤᱝ ᱪᱚᱣᱦᱟᱱ ᱟᱜ ᱱᱟᱜᱟᱢ ᱯᱟᱨᱚᱢ ᱠᱟᱛᱮ ᱡᱚᱛᱚ ᱦᱚᱲᱟᱜ ᱡᱤᱭᱚᱱ ᱨᱮ ᱫᱩᱞᱟᱹᱲ ᱠᱟᱛᱮ ᱡᱟᱹᱛᱤ, ᱫᱷᱚᱨᱚᱢ ᱟᱨ ᱡᱟᱹᱛ ᱨᱮᱱᱟᱜ ᱵᱷᱮᱜᱟᱨ ᱵᱷᱮᱜᱟᱨ ᱵᱟᱝ ᱧᱮᱞ ᱠᱟᱛᱮ ᱠᱚ ᱢᱟᱱᱟᱣᱟ ᱾",
        "ᱮᱠᱵᱳᱴᱮ ᱫᱚ ᱟᱭᱢᱟ ᱜᱟᱱ ᱢᱟᱨᱟᱴᱷᱤ ᱮᱱᱮᱡ ᱠᱚᱨᱮ ᱠᱟ.ᱢᱤ ᱟᱠᱟᱫᱟ ᱟᱨ ᱟᱭᱢᱟ ᱴᱚᱴᱷᱟᱠᱤᱭᱟ. ᱯᱟᱹᱨᱥᱤ ᱛᱮ ᱮᱱᱮᱡ ᱥᱮᱨᱮᱧ ᱨᱮᱭ ᱠᱟ.ᱢᱤ ᱟᱠᱟᱫᱟ । ᱒᱐᱐᱑ ᱥᱟᱞᱮ ᱨᱮ ᱟᱠᱞᱮᱪᱮ ᱠᱟᱱᱰᱮ ᱯᱷᱤᱞᱢ ᱨᱮ ᱠᱟ.ᱢᱤ ᱠᱟᱛᱮ ᱟᱡᱟᱜ ᱯᱩᱭᱞᱩ ᱥᱤᱱᱮᱢᱟ ᱨᱮ ᱠᱟ.ᱢᱤ ᱞᱮᱫᱟᱭ ᱟᱨ ᱫᱩᱢᱠᱟᱴᱟ (᱒᱐᱐᱗) ᱟᱨ ᱵᱟᱵᱚᱨᱮ ᱯᱨᱮᱢ ᱦᱮ (᱒᱐᱑᱔) ᱨᱮ ᱠᱟ.ᱢᱤ ᱞᱮᱫᱟᱭ ᱾ [ᱥᱟᱹᱠᱭᱟᱹᱛ ᱞᱟᱹᱠᱛᱤ ᱠᱟᱱᱟ] ᱟᱥᱣᱤᱱᱤ ᱫᱚ ᱠᱩᱲᱤ ᱠᱚᱣᱟᱜ ᱥᱩᱥᱟᱹᱨ ᱟᱨ ᱡᱤᱣᱤᱵᱟᱫᱤ ᱠᱤᱥᱟᱹᱬ ᱨᱮᱦᱚᱸ ᱠᱟᱹᱢᱤ ᱨᱮᱭ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱰᱮᱱᱥ ᱴᱨᱮᱱᱤᱝ ᱠᱞᱟᱥ ᱠᱚ ᱪᱟᱞ ᱟᱫᱮᱭᱟ ᱟᱨ ᱟᱭᱢᱟ ᱫᱷᱟᱣ ᱜᱮ ᱯᱷᱨᱟᱭ ᱥᱠᱩᱞ ᱠᱚᱭ ᱪᱟᱞ ᱟᱫᱮᱭᱟ ᱾ [citation needed]",
        "ᱨᱟᱢ ᱴᱟᱦᱟᱞ ᱪᱚᱣᱫᱷᱨᱤ ᱫᱚ ᱵᱤᱞᱚᱢ ᱫᱚᱥᱨᱚᱛᱷ ᱪᱚᱣᱫᱷᱩᱨᱤ ᱭᱤᱡ ᱜᱤᱫᱽᱨᱟᱹ ᱠᱟᱱᱟᱭ ᱾ ᱱᱩᱭ ᱫᱚ ᱨᱟᱺᱪᱤ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱚᱨᱢᱟᱡᱷᱤ ᱵᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱠᱩᱪᱪᱩ ᱟᱹᱛᱩ ᱨᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟᱭ ᱾ ᱟᱡ ᱵᱟᱵᱟᱦᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱫᱚᱥᱨᱚᱛᱷ ᱪᱚᱣᱫᱷᱨᱤ ᱟᱨ ᱟᱡ ᱟᱭᱳᱣᱟᱜ ᱧᱩᱛᱩᱢ ᱫᱚ ᱡᱟᱱᱠᱤ ᱫᱮᱵᱤ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱥᱟᱣᱤᱛᱨᱤ ᱫᱮᱵᱤ ᱥᱟᱶᱮ ᱵᱟᱯᱞᱟ ᱞᱮᱱᱟ ᱟᱨ ᱩᱱᱤ ᱨᱤᱱ ᱵᱟᱨᱭᱟ ᱠᱚᱲᱟ ᱜᱤᱫᱽᱨᱟᱹ ᱟᱨ ᱵᱟᱨᱭᱟ ᱠᱩᱲᱤ ᱜᱤᱫᱽᱨᱟᱹ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱫᱷᱚᱨᱚᱢ ᱛᱮ ᱦᱤᱱᱫᱩ ᱟᱨ ᱡᱟᱹᱛᱤ ᱛᱮ ᱠᱩᱰᱢᱤ ᱢᱟᱦᱟᱛᱳ ᱠᱟᱱᱟ ᱾",
        "ᱩᱥᱟ ᱫᱚ ᱢᱟᱨᱟᱴᱷᱤ ᱨᱚᱲ ᱦᱚᱲ ᱜᱷᱟᱨᱚᱸᱡᱽ ᱨᱮ ᱩᱥᱟ ᱵᱟᱞᱠᱨᱤᱥᱱᱟ ᱢᱟᱨᱟᱛᱷᱮ ᱞᱮᱠᱟᱛᱮ ᱡᱟᱱᱟᱢ ᱞᱮᱱᱟᱭ, ᱵᱟᱞᱠᱨᱤᱥᱱᱟ ᱵᱤᱥᱱᱩ ᱢᱟᱨᱟᱛᱷᱮ ᱟᱨ ᱟᱡᱤᱡ ᱮᱨᱟ ᱨᱟᱫᱷᱟᱵᱟᱭ ᱢᱟᱨᱟᱛᱷᱮ ᱨᱮᱱ ᱠᱩᱲᱤ ᱞᱮᱠᱟᱛᱮ ᱾ ᱩᱱᱤ ᱫᱚ ᱢᱚᱬᱮ ᱜᱚᱴᱟᱝ ᱠᱩᱲᱤ ᱢᱩᱫᱽ ᱨᱮ ᱫᱚᱥᱟᱨ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤ ᱰᱨ. ᱢᱚᱱᱳᱦᱟᱨ ᱠᱷᱮᱨ ᱥᱟᱶ ᱵᱟᱯᱞᱟ ᱞᱮᱱᱟᱭ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱢᱩᱢᱵᱟᱭ ᱨᱮ ᱥᱤᱭᱚᱱ ᱦᱚᱥᱯᱤᱴᱟᱞ ᱨᱮᱱ ᱰᱤᱱ ᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱱᱩᱠᱩ ᱫᱚ ᱵᱟᱨᱭᱟ ᱜᱤᱫᱽᱨᱟᱹ ᱨᱮᱱ ᱟᱭᱳ-ᱵᱟᱵᱟ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱢᱤᱫ ᱠᱚᱲᱟ, ᱚᱫᱽᱣᱟᱭᱤᱛ ᱠᱷᱮᱨ ᱟᱨ ᱢᱤᱫ ᱠᱩᱲᱤ, ᱛᱟᱱᱵᱷᱤ ᱟᱡᱽᱢᱤ ᱾ ᱩᱥᱟ ᱠᱤᱨᱚᱱ ᱨᱮᱱ ᱠᱚᱲᱟ ᱚᱫᱽᱣᱟᱭᱤᱛ ᱫᱚ ᱢᱤᱫ ᱢᱟᱨᱮ ᱢᱚᱰᱮᱞ ᱠᱟᱱᱟᱭ, ᱱᱤᱛᱚᱜ ᱟᱡᱤᱡ ᱮᱨᱟ ᱩᱛᱛᱟᱨᱟ (ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱑᱙᱘᱒ ᱨᱮᱱ ᱯᱷᱮᱢᱤᱱᱟ ᱢᱤᱥ ᱤᱱᱰᱤᱭᱟ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ) ᱟᱨ ᱟᱡ ᱨᱮᱱ ᱵᱟᱨᱭᱟ ᱠᱩᱲᱤ ᱥᱚᱣᱱᱥᱠᱨᱩᱛᱤ ᱠᱷᱮᱨ ᱟᱨ ᱥᱟᱭᱭᱟᱢᱤ ᱠᱷᱮᱨ ᱥᱟᱶ ᱱᱟᱥᱤᱠ ᱨᱮᱭ ᱵᱚᱥᱚᱛ ᱟᱠᱟᱱᱟ ᱾ ᱩᱥᱟ ᱠᱤᱨᱚᱱ ᱨᱮᱱ ᱠᱩᱲᱤ ᱛᱟᱱᱵᱷᱤ ᱟᱡᱽᱢᱤ ᱢᱤᱫ ᱱᱟᱯᱟᱭ ᱵᱟᱰᱟᱭ ᱴᱮᱞᱤᱵᱷᱤᱡᱚᱱ ᱟᱨ ᱯᱷᱤᱞᱢ ᱮᱠᱴᱨᱮᱥ ᱠᱟᱱᱟᱭ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱥᱟᱵᱟᱱᱟ ᱟᱡᱽᱢᱤ ᱨᱮᱱ ᱵᱚᱭᱦᱟ ᱥᱤᱱᱮᱢᱟᱴᱳᱜᱨᱟᱯᱷᱟᱨ ᱵᱟᱵᱟ ᱟᱡᱽᱢᱤ ᱥᱟᱶ ᱵᱟᱯᱞᱟ ᱟᱠᱟᱱᱟᱭ ᱾",
        "ᱡᱳᱣᱟ ᱢᱳᱨᱟᱱᱤ (ᱡᱟᱱᱟᱢ ᱒᱙ ᱢᱟᱨᱪ ᱑᱙᱘᱘) ᱫᱚ ᱢᱤᱫ ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱢᱚᱰᱮᱞ ᱟᱨ ᱮᱠᱴᱨᱮᱥ ᱠᱟᱱᱟᱭ ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱵᱚᱞᱤᱣᱩᱰ ᱯᱷᱤᱞᱢ ᱨᱮ ᱧᱮᱞᱚᱜᱼᱟ᱾ ᱩᱱᱤ ᱫᱚ ᱯᱷᱤᱞᱢ ᱟᱨ ᱣᱮᱵᱽ ᱥᱤᱨᱤᱡᱽ ᱨᱮ ᱧᱮᱞ ᱟᱠᱟᱱᱟ ᱡᱟᱦᱟᱸ ᱨᱮ ᱟᱡᱟᱜ ᱧᱩᱛᱩᱢᱟᱱ ᱠᱟᱹᱢᱤ ᱫᱚ ᱚᱞᱣᱮᱡᱽ ᱠᱟᱵᱷᱤ ᱠᱟᱵᱷᱤ (᱒᱐᱑᱑), ᱵᱷᱟᱜᱽ ᱡᱚᱱᱤ (᱒᱐᱑᱕), ᱛᱟᱭᱤᱥ (᱒᱐᱒᱐) ᱟᱨ ᱴᱩᱡᱽᱰᱮᱥ ᱮᱸᱰ ᱯᱷᱨᱟᱭᱤᱰᱮᱥ (᱒᱐᱒᱑) ᱠᱟᱱᱟ᱾",
        "ᱯᱟᱴᱤᱞ ᱫᱚ ᱙ᱮᱠᱥ ᱡᱷᱟᱠᱟᱥ ᱪᱮᱱᱮᱞ ᱦᱚᱛᱮᱛᱮ ᱚᱨᱜᱟᱱᱟᱭᱤᱡ ᱟᱠᱟᱱ ᱢᱤᱫ ᱵᱤᱭᱩᱴᱤ ᱯᱮᱡᱮᱱᱴ ᱨᱮ ᱵᱷᱟᱜ ᱞᱮᱫᱟ᱾ ᱯᱟᱴᱤᱞ ᱫᱚ ᱨᱚᱱᱟᱨ-ᱟᱯ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱚᱱᱟ ᱞᱮᱠᱟᱛᱮ ᱟᱫᱤᱛᱭᱚ ᱥᱟᱨᱯᱚᱛᱫᱟᱨ ᱟᱜ ᱢᱟᱞᱴᱤ-ᱥᱴᱟᱨᱟᱨ ᱠᱞᱟᱥᱢᱮᱴᱥ ᱨᱮ ᱟᱱᱠᱩᱥ ᱪᱚᱣᱫᱷᱟᱨᱤ, ᱥᱟᱭ ᱛᱟᱢᱦᱟᱱᱠᱟᱨ, ᱟᱨ ᱥᱳᱱᱟᱞᱤ ᱠᱩᱞᱠᱟᱨᱱᱤ ᱥᱟᱶ 'ᱦᱤᱱᱟ' ᱨᱮᱱᱟᱜ ᱨᱳᱞ ᱮ ᱧᱟᱢ ᱠᱮᱫᱟ᱾ ᱠᱞᱟᱥᱢᱮᱴᱥ ᱨᱮ ᱟᱡᱟᱜ ᱯᱟᱨᱯᱷᱚᱨᱢᱮᱱᱥ ᱫᱚ ᱰᱤᱨᱮᱠᱴᱚᱨ ᱥᱟᱝᱠᱷ ᱨᱟᱡᱟᱫᱷᱭᱚᱠᱥᱟ ᱟᱜ ᱢᱟᱨᱟᱴᱷᱤ ᱥᱟᱥᱯᱮᱱᱥ ᱛᱷᱨᱤᱞᱟᱨ ᱗᱐᱒ ᱰᱤᱠᱥᱤᱛᱥ ᱨᱮ ᱦᱮᱡ ᱞᱟᱹᱜᱤᱫ ᱨᱳᱞ ᱮ ᱧᱟᱢ ᱠᱮᱫᱟ᱾ ᱯᱟᱴᱤᱞ ᱫᱚ ᱚᱵᱷᱤᱱᱟᱭ ᱫᱮᱣ ᱟᱜ ᱦᱤᱱᱫᱤ ᱴᱤᱵᱷᱤ ᱥᱤᱨᱤᱡ ᱒᱔ ᱨᱮᱦᱚᱸ ᱧᱮᱞ ᱞᱮᱱᱟ, ᱡᱟᱦᱟᱸᱨᱮ ᱟᱱᱤᱞ ᱠᱟᱯᱩᱨ ᱥᱴᱟᱨ ᱞᱮᱱᱟ, ᱚᱸᱰᱮ ᱩᱱᱤ ᱢᱤᱛᱟᱞᱤ ᱟᱜ ᱪᱟᱨᱤᱛ ᱮ ᱩᱫᱩᱜ ᱞᱮᱫᱟ᱾ ᱒᱐᱑᱗ ᱨᱮ, ᱯᱟᱞᱞᱟᱵᱷᱤ ᱫᱚ ᱟᱥᱳᱠ ᱥᱟᱨᱟᱯᱷ, ᱨᱟᱜᱷᱩᱵᱤᱨ ᱭᱟᱫᱚᱵ ᱟᱨ ᱯᱩᱥᱠᱟᱨ ᱥᱨᱳᱛᱨᱤ ᱥᱟᱶ ᱢᱟᱨᱟᱴᱷᱤ ᱠᱚᱢᱮᱰᱤ ᱯᱷᱤᱞᱢ ᱥᱮᱱᱴᱤᱢᱮᱱᱴᱟᱞ ᱨᱮ ᱥᱴᱟᱨ ᱞᱮᱱᱟ᱾",
        "ᱨᱟᱭ ᱒᱐᱐᱖ ᱥᱟᱞ ᱨᱮ ᱴᱮᱞᱤᱵᱤᱡᱚᱱ ᱥᱳ ᱠᱭᱩᱠᱤ ᱥᱟᱟᱥ ᱵᱷᱤ ᱠᱟᱵᱷᱤ ᱵᱟᱦᱩ ᱛᱷᱤ ᱥᱟᱶ ᱟᱡᱟᱜ ᱮᱠᱴᱤᱝ ᱠᱟᱹᱢᱤ ᱮᱛᱚᱦᱚᱵ ᱠᱮᱫᱟ᱾ ᱛᱚᱵᱮ ᱩᱱᱤ ᱫᱮᱣᱚᱱ ᱠᱮ ᱫᱮᱣ ... ᱢᱟᱦᱟᱫᱮᱵᱽ ᱨᱮ ᱥᱚᱛᱤ ᱟᱨ ᱡᱩᱱᱩᱱ - ᱟᱟᱥᱤ ᱱᱟᱯᱷᱟᱨᱟᱛ ᱛᱳ ᱠᱮᱥᱟ ᱟᱟᱭᱤᱥᱠ ᱨᱮ ᱢᱤᱨᱟ ᱮ ᱯᱳᱨᱴᱨᱮᱭ ᱠᱮᱫᱟ᱾ ᱨᱟᱭ ᱯᱟᱸᱡᱟᱵᱤ ᱨᱳᱢᱟᱱᱴᱤᱠ ᱯᱷᱤᱞᱢ ᱦᱤᱨᱳ ᱦᱤᱴᱞᱟᱨ ᱤᱱ ᱞᱟᱵᱷ (᱒᱐᱑᱑) ᱥᱟᱶ ᱟᱡᱟᱜ ᱯᱷᱤᱞᱢ ᱰᱮᱵᱭᱩᱴ ᱮ ᱵᱮᱱᱟᱣ ᱠᱮᱫᱟ᱾ ᱩᱱᱤ ᱒᱐᱑᱘ ᱨᱮᱭᱟᱜ ᱯᱤᱨᱤᱭᱚᱰ ᱥᱯᱳᱨᱴ ᱯᱷᱤᱞᱢ, ᱜᱳᱞᱰ, ᱥᱟᱶ ᱟᱡᱟᱜ ᱦᱤᱱᱫᱤ ᱯᱷᱤᱞᱢ ᱰᱮᱵᱭᱩᱴ ᱮ ᱵᱮᱱᱟᱣ ᱠᱮᱫᱟ, ᱯᱷᱤᱞᱢᱯᱷᱮᱭᱟᱨ ᱟᱣᱟᱨᱰ ᱯᱷᱳᱨ ᱵᱮᱥᱴ ᱯᱷᱤᱢᱮᱞ ᱰᱮᱵᱭᱩᱴ ᱞᱟᱹᱜᱤᱫ ᱧᱩᱛᱩᱢ ᱧᱟᱢ ᱠᱟᱛᱮ᱾ ᱒᱐᱒᱒ ᱥᱟᱞ ᱨᱮ, ᱨᱟᱭ ᱯᱷᱮᱱᱴᱮᱥᱤ ᱯᱷᱤᱞᱢ ᱵᱨᱟᱦᱢᱟᱟᱥᱛᱨᱟ: ᱯᱟᱟᱨᱴ ᱣᱟᱱ - ᱥᱤᱵᱷᱟ ᱞᱟᱹᱜᱤᱫ ᱥᱟᱨᱦᱟᱣ ᱮ ᱧᱟᱢ ᱠᱮᱫᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱩᱱᱤ ᱵᱮᱥᱴ ᱥᱚᱯᱳᱨᱴᱤᱝ ᱮᱠᱴᱨᱮᱥ ᱞᱟᱹᱜᱤᱫ ᱟᱤᱟᱤᱮᱯᱷᱮ ᱟᱣᱟᱨᱰ ᱮ ᱟᱨᱡᱟᱣ ᱠᱮᱫᱟ ᱟᱨ ᱵᱮᱥᱴ ᱥᱚᱯᱳᱨᱴᱤᱝ ᱮᱠᱴᱨᱮᱥ ᱞᱟᱹᱜᱤᱫ ᱯᱷᱤᱞᱢᱯᱷᱮᱭᱟᱨ ᱟᱣᱟᱨᱰ ᱞᱟᱹᱜᱤᱫ ᱢᱤᱫ ᱱᱟᱢᱟᱝᱠᱟᱱ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ᱾",
        "ᱢᱩᱬ ᱞᱮᱠᱟᱛᱮ ᱦᱤᱢᱟᱪᱚᱞ ᱯᱨᱚᱫᱮᱥ ᱠᱷᱚᱱ, ᱥᱚᱨᱢᱟ ᱒᱐᱑᱕ ᱨᱮ ᱢᱤᱥ ᱫᱤᱣᱟ ᱨᱮᱭᱟᱜ ᱛᱮᱥᱟᱨ ᱮᱰᱤᱥᱚᱱ ᱨᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟ ᱟᱨ ᱢᱤᱫ ᱯᱷᱟᱭᱱᱟᱞᱤᱥᱴ ᱞᱮᱠᱟᱛᱮ ᱵᱟᱪᱷᱟᱣ ᱞᱮᱱᱟᱭ᱾ ᱒᱐᱑᱖ ᱨᱮ, ᱩᱱᱤ ᱥᱮᱱᱳᱨᱤᱴᱟ ᱤᱱᱰᱤᱭᱟ ᱯᱮᱡᱮᱱᱴ ᱨᱮ ᱥᱮᱞᱮᱫ ᱞᱮᱱᱟᱭ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱩᱱᱤ ᱢᱤᱥ ᱤᱱᱴᱟᱨᱠᱳᱱᱴᱤᱱᱮᱱᱴᱟᱞ ᱤᱱᱰᱤᱭᱟ ᱨᱮᱭᱟᱜ ᱴᱟᱭᱤᱴᱮᱞ ᱮ ᱡᱤᱛᱠᱟᱹᱨ ᱞᱮᱱᱟ᱾ ᱩᱱᱤ ᱠᱳᱞᱳᱢᱵᱳ, ᱥᱨᱤᱞᱚᱝᱠᱟ ᱨᱮ ᱦᱩᱭ ᱞᱮᱱ ᱢᱤᱥ ᱤᱱᱴᱟᱨᱠᱳᱱᱴᱤᱱᱮᱱᱴᱟᱞ ᱒᱐᱑᱖ ᱨᱮ ᱵᱷᱟᱨᱚᱛ ᱮ ᱨᱮᱯᱨᱮᱡᱮᱱᱴ ᱞᱮᱫᱟ᱾ ᱒᱐᱑᱗ ᱮᱛᱚᱦᱚᱵ ᱠᱷᱚᱱ ᱩᱱᱤ ᱟᱭᱢᱟ ᱯᱟᱧᱡᱟᱵᱤ ᱢᱭᱩᱡᱤᱠ ᱵᱷᱤᱰᱤᱭᱳ ᱨᱮ ᱧᱮᱞ ᱟᱠᱟᱱᱟ᱾",
        "ᱥᱳᱱᱟᱢ ᱠᱷᱟᱱ (ᱡᱟᱱᱟᱢ ᱵᱚᱠᱷᱛᱟᱵᱚᱨ ᱠᱷᱟᱱ; ᱒ ᱥᱮᱯᱴᱮᱢᱵᱚᱨ ᱑᱙᱗᱒) ᱫᱚ ᱢᱤᱫ ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱮᱠᱴᱨᱮᱥ ᱠᱟᱱᱟᱭ ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱦᱤᱱᱫᱤ ᱥᱟᱶᱛᱮ ᱛᱮᱞᱩᱜᱩ ᱯᱷᱤᱞᱢ ᱨᱮ ᱟᱡᱟᱜ ᱠᱟᱹᱢᱤ ᱞᱟᱹᱜᱤᱫ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟᱭ᱾ ᱮᱠᱴᱚᱨ ᱢᱩᱨᱟᱫ ᱤᱡ ᱜᱚᱲᱚᱢ ᱠᱩᱲᱤ, ᱩᱱᱤ ᱑᱙᱘᱗ ᱨᱮ ᱛᱮᱞᱩᱜᱩ ᱯᱷᱤᱞᱢ ᱥᱚᱢᱨᱟᱴ ᱥᱟᱶ ᱟᱡᱟᱜ ᱠᱮᱨᱤᱭᱚᱨ ᱮ ᱮᱛᱚᱦᱚᱵ ᱠᱮᱫᱟ᱾ ᱩᱱᱤ ᱑᱙᱘᱘ ᱨᱮ ᱟᱡᱟᱜ ᱰᱟᱭᱨᱮᱠᱴᱚᱨᱤᱭᱟᱞ ᱵᱤᱡᱚᱭ ᱨᱮ ᱭᱟᱥ ᱪᱳᱯᱲᱟ ᱦᱚᱛᱮᱛᱮ ᱦᱤᱱᱫᱤ ᱥᱤᱱᱮᱢᱟ ᱨᱮ ᱞᱚᱸᱪ ᱦᱩᱭ ᱞᱮᱱ ᱛᱟᱦᱮᱸᱫ᱾",
        "ᱩᱨᱵᱚᱥᱤ ᱫᱚ ᱯᱟᱧᱡᱟᱵᱤ ᱥᱮᱨᱮᱧ \"ᱯᱟᱭᱟᱞ\" ᱥᱟᱶ ᱮᱠᱴᱤᱝ ᱮ ᱮᱛᱚᱦᱚᱵ ᱠᱮᱫᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱧᱩᱛᱩᱢᱟᱱ ᱪᱚᱸᱰᱤᱜᱚᱲ ᱣᱟᱭᱤᱴ ᱦᱤᱞᱥ ᱢᱭᱩᱡᱤᱠ ᱯᱟᱭᱟᱞ ᱫᱟᱨᱟᱭ ᱛᱮ ᱯᱨᱳᱰᱭᱩᱥ ᱦᱩᱭ ᱞᱮᱱᱟ᱾ ᱥᱮᱨᱮᱧ ᱫᱚ ᱟᱠᱨᱤᱛᱤ ᱠᱟᱠᱠᱟᱨ ᱟᱨ ᱥᱤᱵᱚᱢ ᱜᱨᱚᱵᱚᱨ ᱯᱷᱤᱪᱟᱨ ᱞᱮᱫᱟ᱾",
        "ᱡᱟᱱᱩᱣᱟᱨᱤ ᱒᱐᱑᱖ ᱨᱮ, ᱩᱱᱤ ᱫᱚ ᱵᱷᱟᱨᱚᱛ ᱫᱚ ᱚᱥᱴᱨᱮᱞᱤᱭᱟ ᱨᱮ ᱥᱤᱨᱤᱡᱽ ᱮ ᱡᱤᱛᱠᱟᱹᱨ ᱨᱮ ᱜᱚᱲᱚ ᱮᱢᱟᱫᱮᱭᱟ ᱥᱟᱶᱛᱮ ᱴᱤ᱒᱐ ᱤᱱᱴᱟᱨᱱᱮᱥᱱᱟᱞ ᱨᱮ ᱵᱷᱟᱨᱚᱛ ᱟᱜ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱪᱮᱛᱟᱱ ᱪᱮᱡ ᱨᱮ ᱢᱤᱫ ᱓᱑-ᱵᱳᱞ ᱔᱖ ᱨᱚᱱ ᱮ ᱥᱠᱳᱨ ᱞᱮᱫᱟ᱾ ᱩᱱᱤ ᱫᱚ ᱒᱐᱑᱖ ᱟᱭᱤᱥᱤᱥᱤ ᱛᱤᱨᱞᱟᱹ ᱣᱟᱨᱞᱰ ᱴᱣᱮᱱᱴᱤ᱒᱐ ᱨᱮ ᱟᱡᱟᱜ ᱯᱷᱳᱨᱢ ᱮ ᱪᱟᱞᱟᱣ ᱫᱚᱦᱚ ᱠᱮᱫᱟ ᱡᱟᱦᱟᱸ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱘᱙ ᱨᱚᱱ ᱮ ᱥᱠᱳᱨ ᱞᱮᱫᱟ ᱟᱨ ᱯᱩᱱᱭᱟ ᱢᱮᱪ ᱨᱮ ᱮᱭᱟᱭ ᱣᱤᱠᱮᱴ ᱮ ᱦᱟᱛᱟᱣ ᱞᱮᱫᱟ᱾",
        "ᱫᱤᱯᱟᱠ ᱫᱚ ᱩᱱᱤᱭᱟᱜ ᱦᱚᱲᱢᱚ ᱨᱮᱭᱟᱜ ᱔᱐% ᱪᱮᱛᱟᱱ ᱨᱮ ᱟᱹᱰᱤ ᱵᱚᱛᱚᱨᱟᱱ ᱟᱛᱟᱥ ᱮ ᱥᱟᱦᱟᱣ ᱞᱮᱫᱟ ᱟᱨ ᱑᱐ ᱫᱤᱱ ᱛᱟᱭᱚᱢ ᱦᱟᱥᱯᱟᱛᱟᱞ ᱨᱮ ᱵᱚᱛᱚᱨᱟᱱ ᱟᱛᱟᱥ ᱟᱨ ᱛᱟᱭᱚᱢ ᱛᱮ ᱥᱮᱯᱥᱤᱥ ᱦᱩᱭ ᱠᱷᱟᱹᱛᱤᱨ ᱮ ᱜᱩᱨ ᱮᱱᱟ᱾ ᱠᱤᱨᱟᱱᱡᱤᱛ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱚᱱᱟ ᱚᱠᱛᱮ ᱨᱮ ᱨᱟᱹᱯᱩᱫ ᱤᱝᱞᱤᱥ ᱜᱮᱭ ᱨᱚᱲ ᱫᱟᱲᱮᱭᱟᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱱᱟ, ᱠᱚ ᱮᱨᱮᱥᱴ ᱠᱮᱫᱮᱭᱟ ᱟᱨ ᱢᱩᱪᱟᱹᱫ ᱨᱮ ᱜᱚᱡ ᱨᱮᱭᱟᱜ ᱫᱳᱥ ᱠᱚ ᱞᱟᱫᱮ ᱠᱮᱫᱮᱭᱟ᱾",
        "ᱨᱳᱦᱛᱟᱠ, ᱦᱟᱨᱭᱟᱱᱟ ᱠᱷᱚᱱ ᱮ ᱦᱮᱡ ᱟᱠᱟᱱ ᱩᱱᱱᱟᱛᱤ ᱫᱚ ᱯᱩᱭᱞᱩ ᱫᱷᱟᱣ ᱵᱮᱰᱢᱤᱱᱴᱚᱱ ᱮᱱᱮᱡ ᱫᱚ ᱮᱭᱟᱭ ᱥᱮᱨᱢᱟ ᱩᱢᱮᱨ ᱨᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱫᱟ᱾ ᱟᱡ ᱵᱟᱵᱟ, ᱩᱯᱠᱟᱨ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱵᱮᱰᱢᱤᱱᱴᱚᱱ ᱤᱫᱤ ᱠᱟᱛᱮᱫ ᱜᱚᱨᱚᱡᱽ ᱛᱟᱦᱮᱸ ᱠᱟᱱ ᱛᱟᱭᱟ, ᱩᱱᱤ ᱫᱚ ᱪᱷᱚᱛᱩ ᱨᱟᱢ ᱥᱴᱮᱰᱤᱭᱟᱢ ᱨᱮ ᱢᱤᱫ ᱵᱮᱰᱢᱤᱱᱴᱚᱱ ᱮᱠᱟᱰᱮᱢᱤ ᱨᱮ ᱧᱩᱛᱩᱢ ᱮ ᱚᱞ ᱚᱪᱚ ᱠᱮᱫᱮᱭᱟ᱾",
        "᱒᱐᱐᱗ ᱥᱟᱞᱮ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱴᱮᱴᱨᱟ ᱯᱮᱠ ᱦᱚᱛᱮᱛᱮ ᱟᱡᱟᱜ ᱠᱟᱹᱦᱱᱤ ᱞᱟᱹᱜᱤᱫ ᱜᱨᱤᱱ ᱢᱤᱰᱤᱭᱟ ᱥᱤᱨᱯᱷᱟᱹ ᱠᱚ ᱮᱢᱟᱫᱮᱭᱟ ᱡᱮ ᱪᱮᱫ ᱞᱮᱠᱟᱛᱮ ᱨᱮᱰᱤᱭᱳᱮᱠᱴᱤᱵᱷ ᱵᱮᱥᱴ ᱰᱚᱢᱯ ᱨᱮᱱᱟᱜ ᱞᱤᱠ ᱠᱷᱟᱹᱛᱤᱨ ᱥᱩᱨ ᱨᱤᱱ ᱟᱹᱛᱩ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱦᱚᱲᱢᱚ ᱥᱟᱶᱟᱨ ᱪᱮᱛᱟᱱ ᱨᱮ ᱚᱥᱚᱨ ᱮ ᱧᱩᱨ ᱮᱫᱟ ᱟᱨ ᱥᱚᱨᱠᱟᱨ ᱱᱚᱣᱟ ᱢᱩᱫᱽᱫᱟᱹ ᱪᱮᱛᱟᱱ ᱨᱮ ᱵᱟᱭ ᱢᱚᱱ ᱮᱫᱟ ᱾",
        "ᱟᱨᱛᱷ ᱫᱚ ᱥᱤᱧᱚᱛ ᱯᱟᱦᱴᱟ ᱠᱷᱚᱱ ᱮᱠᱟᱰᱮᱢᱤ ᱟᱣᱟᱨᱰ ᱯᱷᱚᱨ ᱵᱮᱥᱴ ᱯᱷᱚᱨᱮᱱ ᱞᱟᱝᱜᱩᱣᱮᱡᱽ ᱯᱷᱤᱞᱢ ᱞᱟᱹᱜᱤᱫ ᱚᱯᱷᱤᱥᱤᱭᱟᱞ ᱮᱱᱴᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱵᱷᱮᱡᱟ ᱞᱮᱱᱟ, ᱟᱨ ᱣᱟᱴᱟᱨ ᱫᱚ ᱠᱟᱱᱟᱰᱟ ᱯᱟᱦᱴᱟ ᱠᱷᱚᱱ ᱮᱠᱟᱰᱮᱢᱤ ᱟᱣᱟᱨᱰ ᱯᱷᱚᱨ ᱵᱮᱥᱴ ᱯᱷᱚᱨᱮᱱ ᱞᱟᱝᱜᱩᱣᱮᱡᱽ ᱯᱷᱤᱞᱢ ᱞᱟᱹᱜᱤᱫ ᱚᱯᱷᱤᱥᱤᱭᱟᱞ ᱮᱱᱴᱨᱤ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱱᱚᱶᱟ ᱫᱚ ᱮᱴᱤᱞᱟ ᱵᱮᱨᱴᱟᱞᱟᱱᱟᱜ ᱑᱙᱙᱐ ᱨᱮᱱᱟᱜ ᱵᱮᱱᱟᱣ ᱯᱟᱹᱨᱥᱤ ᱯᱷᱤᱞᱢ ᱮ ᱵᱩᱞᱮᱴ ᱴᱩ ᱫᱟ ᱦᱮᱰ ᱟᱨ ᱡᱟᱠᱟᱨᱤᱭᱟᱥ ᱠᱩᱱᱩᱠᱟᱜ ᱒᱐᱐᱑ ᱨᱮᱱᱟᱜ ᱤᱱᱩᱠᱴᱤᱴᱩᱴ ᱯᱟᱹᱨᱥᱤ ᱯᱷᱤᱞᱢ ᱟᱴᱟᱱᱟᱨᱡᱩᱣᱟᱴ: ᱫᱟ ᱯᱷᱟᱥᱴ ᱨᱚᱱᱟᱨ ᱛᱟᱭᱚᱢ ᱚᱱᱟ ᱛᱷᱚᱠ ᱨᱮ ᱵᱷᱮᱡᱟ ᱟᱠᱟᱱ ᱛᱮᱥᱟᱨ ᱵᱟᱝ-ᱯᱷᱨᱮᱸᱪ-ᱯᱟᱹᱨᱥᱤ ᱠᱟᱱᱟᱰᱤᱭᱟᱱ ᱯᱷᱤᱞᱢ ᱵᱮᱱᱟᱣ ᱮᱱᱟ᱾",
        "ᱤᱥᱨᱟᱛ ᱟᱯᱷᱨᱤᱱ (ᱵᱟᱝ ᱢᱤᱫ ᱞᱮᱠᱟ ᱚᱞ ᱦᱚᱨᱟ: ᱤᱥᱨᱟᱛ ᱟᱯᱷᱨᱤᱱ; ᱡᱟᱱᱟᱢ ᱒᱕ ᱰᱤᱥᱮᱢᱵᱚᱨ ᱑᱙᱕᱖) ᱢᱤᱫ ᱩᱨᱫᱩ ᱚᱱᱚᱬᱦᱮᱭᱟᱹ ᱠᱟᱱᱟᱭ᱾ ᱟᱡᱟᱜ ᱠᱟᱹᱢᱤ ᱠᱚ ᱟᱭᱢᱟ ᱯᱟᱹᱨᱥᱤ ᱛᱮ ᱛᱚᱨᱡᱚᱢᱟ ᱟᱠᱟᱱᱟ ᱡᱮᱞᱮᱠᱟ ᱤᱝᱞᱤᱥ, ᱡᱟᱯᱟᱱᱤᱥ, ᱥᱟᱝᱥᱠᱨᱤᱛ ᱟᱨ ᱦᱤᱱᱫᱤ᱾ ᱜᱷᱟᱡᱟᱞ ᱥᱮᱨᱮᱧᱤᱭᱟᱹ ᱡᱟᱜᱡᱤᱛ ᱥᱤᱝ ᱟᱨ ᱪᱤᱛᱨᱟ ᱥᱤᱝ ᱦᱚᱸ ᱟᱡᱟᱜ ᱚᱱᱚᱬᱦᱮᱸ ᱠᱚ ᱟᱠᱚᱣᱟᱜ ᱮᱱᱛᱷᱚᱞᱚᱡᱤ, ᱵᱤᱭᱚᱱᱰ ᱴᱟᱭᱤᱢ (᱑᱙᱘᱗) ᱨᱮ ᱠᱤᱱ ᱩᱫᱩᱜ ᱥᱚᱫᱚᱨ ᱟᱠᱟᱫᱟ᱾ ᱡᱤᱭᱟ ᱢᱚᱦᱤᱭᱮᱫᱫᱤᱱ ᱦᱚᱸ ᱟᱡᱟᱜ ᱱᱟᱡᱢ ᱠᱚ ᱟᱡᱟᱜ ᱑᱗ ᱟᱨ ᱒᱐ ᱵᱷᱚᱞᱩᱢ ᱨᱮ ᱚᱱᱟ ᱥᱟᱶᱛᱮ ᱟᱡᱟᱜ ᱪᱟᱞᱟᱜ ᱠᱟᱱ ᱠᱚᱱᱥᱚᱨᱴ ᱨᱮ ᱦᱚᱸᱭ ᱨᱚᱲ ᱟᱸᱡᱚᱢᱟ᱾",
        "᱒᱐᱑᱙ ᱥᱟᱞᱮ ᱨᱮᱱᱟᱜ ᱱᱚᱵᱷᱮᱢᱵᱚᱨ ᱪᱟᱸᱫᱚ ᱨᱮ, ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱰᱟᱠ ᱵᱤᱵᱷᱟᱜᱽ ᱫᱚ ᱪᱤᱱᱟᱢᱢᱟ ᱦᱚᱛᱮᱛᱮ ᱮᱛᱚᱦᱚᱵ ᱟᱠᱟᱱ SMSS ᱦᱤᱱᱫᱩ ᱢᱟᱦᱤᱞᱟ ᱢᱚᱱᱫᱤᱨᱟᱢ ᱨᱮᱱᱟᱜ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱯᱩᱨᱟᱹᱣ ᱨᱮᱱᱟᱜ ᱩᱭᱦᱟᱹᱨ ᱨᱮ ᱢᱤᱫ ᱥᱯᱮᱥᱤᱭᱟᱞ ᱠᱚᱵᱷᱚᱨ ᱮ ᱩᱪᱷᱟᱹᱱ ᱞᱮᱫᱼᱟ ᱾ ᱱᱚᱣᱟ ᱠᱚᱵᱷᱚᱨ ᱨᱮ ᱠᱮ. ᱪᱤᱱᱟᱢᱢᱟ ᱟᱜ ᱪᱤᱛᱟᱹᱨ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱟᱨ ᱱᱚᱣᱟ ᱨᱮ ᱢᱤᱫ ᱥᱯᱮᱥᱤᱭᱟᱞ ᱥᱴᱟᱢᱯ ᱦᱚᱸ ᱞᱟᱜᱟᱣ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱥᱤᱛᱷᱟᱨᱟ ᱫᱚ ᱠᱮᱨᱟᱞᱟ ᱨᱮᱱᱟᱜ ᱠᱟᱥᱟᱨᱟᱜᱚᱲ ᱦᱚᱱᱚᱛ ᱨᱮᱭ ᱡᱟᱱᱟᱢ ᱟᱨ ᱦᱟᱨᱟ ᱵᱩᱨᱩ ᱟᱠᱟᱱᱟ᱾ ᱩᱱᱤ ᱤᱝᱞᱤᱥ ᱥᱟᱶᱦᱮᱫ ᱟᱨ ᱡᱚᱨᱱᱟᱞᱤᱥᱚᱢ ᱨᱮ ᱰᱤᱯᱞᱳᱢᱟ ᱨᱮ ᱟᱡᱟᱜ ᱯᱳᱥᱴᱼᱜᱨᱮᱡᱩᱭᱮᱥᱚᱱ ᱰᱤᱜᱽᱨᱤ ᱠᱮᱞᱤᱠᱚᱴ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱠᱷᱚᱱ ᱮ ᱧᱟᱢ ᱟᱠᱟᱫᱟ᱾ ᱮᱛᱚᱦᱚᱵ ᱩᱢᱮᱨ ᱨᱮ ᱩᱱᱤ ᱡᱤᱭᱚᱱ ᱜᱷᱟᱛᱚᱠ ᱠᱮᱸᱥᱟᱨ ᱨᱩᱣᱟᱹ ᱧᱟᱢ ᱞᱮᱫᱟ᱾ ᱩᱱᱤ ᱟᱡᱟᱜ ᱯᱷᱟᱭᱟᱨᱵᱨᱟᱸᱰ ᱥᱟᱶᱦᱮᱫ ᱥᱴᱟᱭᱤᱞ ᱡᱤᱭᱚᱱ ᱵᱷᱩᱨ ᱠᱮᱸᱥᱟᱨ ᱟᱨ ᱥᱟᱶᱛᱟᱨᱤ ᱥᱴᱤᱜᱽᱢᱟ ᱵᱤᱨᱩᱫᱷ ᱨᱮ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱞᱟᱹᱜᱤᱫ ᱮ ᱢᱟᱱᱟᱣᱟ᱾",
        "᱒᱐᱐᱗ ᱥᱟᱞᱮ ᱨᱮ ᱜᱤᱫᱽᱨᱟᱹ ᱦᱚᱠ ᱢᱩᱫᱽᱫᱟᱹ ᱪᱮᱛᱟᱱ ᱨᱮ ᱢᱤᱫ ᱫᱚᱥᱚᱠ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱠᱟᱹᱢᱤ ᱞᱟᱹᱜᱤᱫ ᱥᱤᱧᱚᱛ ᱥᱚᱨᱠᱟᱨ ᱨᱮᱱᱟᱜ ᱛᱤᱨᱞᱟᱹ ᱟᱨ ᱜᱤᱫᱽᱨᱟᱹ ᱩᱛᱱᱟᱹᱣ ᱢᱚᱱᱛᱨᱤ ᱦᱚᱛᱮᱛᱮ ᱨᱟᱡᱤᱵ ᱜᱟᱱᱫᱷᱤ ᱢᱟᱱᱟᱵ ᱥᱮᱵᱟ ᱥᱤᱨᱯᱷᱟᱹ ᱾",
        "ᱠᱩᱛᱷᱵᱟᱯᱚᱞᱞᱤ ᱫᱚ ᱯᱚᱱᱰᱤᱪᱮᱨᱤ ᱨᱮᱭᱟᱜ ᱯᱩᱭᱞᱩ ᱢᱚᱥᱡᱤᱫᱽ ᱠᱟᱱᱟ ᱢᱮᱱᱛᱮ ᱠᱚ ᱫᱟᱹᱵᱤᱭᱟᱹ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱯᱩᱭᱞᱩ ᱫᱷᱟᱣ ᱣᱟᱭᱤᱴ ᱴᱟᱣᱩᱱ ᱨᱮ ᱵᱮᱱᱟᱣ ᱞᱮᱱᱟ᱾ ᱑᱖᱙᱓ ᱥᱟᱞᱮ ᱨᱮ ᱯᱚᱱᱰᱤᱪᱮᱨᱤ ᱠᱤᱞᱟᱹ ᱨᱮᱭᱟᱜ ᱰᱚᱪ ᱢᱮᱯ ᱞᱮᱠᱟᱛᱮ ᱵᱟᱰᱟᱭᱚᱜᱼᱟ ᱡᱮ ᱚᱸᱰᱮ ᱵᱟᱨᱭᱟ ᱢᱚᱥᱡᱤᱫᱽ ᱢᱮᱱᱟᱜ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ ᱠᱤᱞᱟᱹ ᱵᱷᱤᱛᱨᱤ ᱨᱮ᱾ ᱢᱤᱫᱴᱟᱹᱝ ᱫᱚ ᱠᱩᱛᱷᱵᱟᱯᱚᱞᱞᱤ ᱟᱨ ᱫᱚᱥᱟᱨ ᱫᱚ ᱢᱤᱨᱟᱯᱚᱞᱞᱤ ᱢᱮᱱᱛᱮ ᱠᱚ ᱯᱟᱹᱛᱭᱟᱹᱣᱟ᱾ ᱑᱘ ᱥᱟᱭᱟᱱᱟᱜ ᱨᱮᱭᱟᱜ ᱯᱩᱭᱞᱩ ᱚᱨᱫᱷᱮ ᱨᱮ ᱢᱤᱨᱟᱯᱚᱞᱞᱤ ᱫᱚ ᱱᱤᱛᱚᱜ ᱡᱟᱦᱟᱸ ᱡᱟᱭᱜᱟ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱚᱸᱰᱮ ᱠᱚ ᱩᱪᱟᱹᱲ ᱠᱮᱫᱮᱭᱟ, ᱮᱱᱠᱷᱟᱱ ᱠᱩᱛᱷᱵᱟᱯᱚᱞᱞᱤ ᱫᱚ ᱣᱟᱭᱤᱴ ᱴᱟᱣᱩᱱ ᱨᱮᱭᱟᱜ ᱯᱟᱪᱮ ᱱᱟᱠᱷᱟ ᱨᱮ ᱑᱗᱖᱑ ᱥᱟᱞᱮ ᱨᱮ ᱤᱝᱨᱟᱹᱡᱽ ᱠᱚ ᱣᱟᱭᱤᱴ ᱴᱟᱣᱩᱱ ᱵᱟᱹᱨᱵᱟᱹᱫᱽ ᱠᱮᱫ ᱫᱷᱟᱹᱵᱤᱡ ᱛᱟᱦᱮᱸ ᱮᱱᱟ᱾ ᱱᱤᱛᱚᱜᱟᱜ ᱵᱮᱱᱟᱣ ᱫᱚ ᱑᱘ ᱥᱟᱭᱟᱱᱟᱜ ᱨᱮ ᱦᱩᱭ ᱞᱮᱱᱟ᱾",
        "᱑᱖ ᱡᱩᱱ ᱒᱐᱒᱐ ᱨᱮ, ᱡᱟᱨᱢᱟᱱ ᱠᱞᱚᱵᱽ ᱵᱳᱨᱩᱥᱤᱭᱟ ᱰᱳᱴᱢᱩᱱᱰ ᱫᱚ ᱜᱨᱩᱯ ᱨᱮ ᱩᱛᱷᱱᱟᱹᱣ ᱞᱟᱹᱜᱤᱫ ᱠᱞᱚᱵᱽ ᱥᱟᱶ ᱥᱟᱹᱜᱟᱹᱭ ᱵᱮᱱᱟᱣ ᱞᱮᱫᱼᱟ ᱾ ᱦᱟᱭᱫᱨᱟᱵᱟᱫᱽ ᱫᱚ ᱟᱡᱟᱜ ᱚᱲᱟᱜ ᱠᱷᱮᱞ ᱫᱚ ᱦᱟᱭᱫᱨᱟᱵᱟᱫᱽ ᱨᱮᱱᱟᱜ ᱥᱚᱦᱚᱨ ᱜᱟᱪᱤᱵᱳᱵᱷᱞᱤ ᱨᱮ ᱡᱤ.ᱮᱢ.ᱥᱤ. ᱵᱟᱞᱚᱭᱳᱜᱤ ᱟᱛᱷᱞᱮᱴᱤᱠ ᱥᱴᱮᱰᱤᱭᱟᱢ ᱨᱮ ᱠᱷᱮᱞ ᱟᱭᱟ ᱾ ᱱᱚᱶᱟ ᱥᱴᱮᱰᱤᱭᱟᱢ ᱨᱮ ᱫᱚ ᱑᱘,᱐᱐᱐ ᱜᱟᱱ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ ᱾",
        "ᱛᱷᱚᱠ:᱑᱙᱕᱖ ᱨᱮ ᱢᱟᱫᱽᱨᱟᱥ ᱯᱚᱱᱚᱛ ᱨᱮ ᱛᱷᱟᱯᱚᱱ ᱟᱠᱟᱱ",
        "᱒᱐᱑᱙ ᱨᱮᱱᱟᱜ ᱵᱟᱪᱷᱱᱟᱣ ᱨᱮ ᱵᱤᱡᱩ ᱡᱚᱱᱛᱟ ᱫᱚᱞ ᱨᱤᱱᱤᱡ ᱠᱚᱱᱰᱤᱰᱮᱴ ᱱᱟᱵᱟ ᱠᱤᱥᱳᱨ ᱫᱟᱥ ᱫᱚ ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱡᱚᱱᱛᱟ ᱯᱟᱨᱴᱤ ᱨᱤᱱᱤᱡ ᱠᱚᱱᱰᱤᱰᱮᱴ ᱫᱤᱱᱮᱥ ᱠᱩᱢᱟᱨ ᱡᱮᱭᱱ ᱔᱕,᱖᱙᱙ ᱵᱷᱳᱴ ᱛᱮᱭ ᱦᱟᱨᱟᱣ ᱠᱮᱫᱮᱭᱟ ᱾",
        "᱑᱙᱙᱙ ᱨᱮ, ᱯᱨᱚᱢᱚᱫᱽ ᱢᱚᱦᱟᱡᱚᱱ ᱥᱟᱶ ᱜᱟᱺᱦᱤᱨ ᱢᱚᱱᱵᱤᱵᱟᱹᱫᱽ ᱦᱩᱭ ᱮᱱ ᱛᱟᱭᱚᱢ, ᱩᱱᱤ ᱫᱚ ᱵᱷᱟᱨᱚᱛᱤᱭᱚ ᱡᱚᱱᱚᱛᱟ ᱯᱟᱨᱴᱤ ᱵᱟᱹᱜᱤ ᱠᱟᱛᱮ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱡᱟᱹᱛᱭᱟᱹᱨᱤ ᱠᱚᱸᱜᱽᱨᱮᱥ ᱟᱜ ᱛᱤᱭ ᱥᱟᱵ ᱠᱮᱫ-ᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱑᱙᱙᱙ ᱨᱮ ᱨᱟᱢᱴᱮᱠ ᱠᱷᱚᱱ ᱞᱳᱠᱥᱚᱵᱷᱟ ᱵᱟᱪᱷᱚᱱ ᱮ ᱞᱟᱹᱰᱷᱟᱹᱭ ᱮᱱᱟ, ᱤᱠᱷᱟᱹᱱ ᱮ ᱦᱟᱨᱟᱣ ᱮᱱᱟ ᱾",
        "ᱡᱟᱰᱮᱡᱟ ᱫᱚ ᱒᱐᱐᱖-᱐᱗ ᱨᱮ ᱫᱟᱞᱤᱯ ᱴᱨᱚᱯᱷᱤ ᱨᱮ ᱯᱩᱭᱞᱩ ᱛᱷᱚᱠ ᱠᱨᱤᱠᱮᱴ ᱨᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱫᱼᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱫᱟᱞᱤᱯ ᱴᱨᱚᱯᱷᱤ ᱨᱮ ᱯᱟᱪᱮ ᱴᱚᱴᱷᱟ ᱟᱨ ᱨᱟᱱᱡᱤ ᱴᱨᱚᱯᱷᱤ ᱨᱮ ᱥᱳᱣᱨᱟᱥᱴᱨᱚ ᱞᱟᱹᱜᱤᱫ ᱮ ᱠᱷᱮᱞ ᱞᱮᱫᱼᱟ ᱾",
        "ᱰᱮᱵᱷ ᱟᱜ ᱳᱞᱰ ᱯᱳᱨᱱ سیزن ᱒ ᱮᱯᱤᱥᱳᱰ ᱔ ᱟᱨᱴᱤ ᱞᱮᱝ, ᱵᱷᱮᱱᱮᱥᱟ ᱰᱮᱞ ᱨᱤᱣᱳ ᱟᱡ ᱞᱮᱠᱟᱛᱮ (᱒᱐᱑᱒)",
        "᱑᱐᱗ ᱠᱤᱞᱚᱢᱤᱴᱚᱨ (᱖᱖ ᱢᱤᱞ) ᱡᱤᱞᱤᱧ ᱕ ᱯᱷᱩᱴ ᱖ ᱤᱸᱪ (᱑,᱖᱗᱖ ᱢᱤᱞᱤᱢᱤᱴᱚᱨ) ᱵᱨᱚᱰᱜᱮᱡᱽ ᱟᱢᱨᱤᱛᱥᱚᱨ-ᱯᱟᱴᱷᱟᱱᱠᱳᱴ ᱞᱟᱭᱤᱱ ᱫᱚ ᱑᱘᱘᱔ ᱥᱟᱞᱮ ᱨᱮ ᱮᱛᱚᱦᱚᱵ ᱞᱮᱱᱟ ᱾",
        "ᱥᱚᱱᱡᱤᱣᱟᱱ ᱞᱟᱞ - ᱫᱤᱥᱟᱹ ᱩᱫᱩᱜᱤᱜ ᱟᱨ ᱚᱱᱚᱞᱤᱭᱟᱹ, ᱡᱟᱢᱥᱮᱫᱽᱯᱩᱨ ᱨᱮ ᱡᱟᱱᱟᱢ ᱟᱠᱟᱱ",
        "ᱩᱱᱤ ᱫᱚ ᱜᱳᱨᱠᱷᱟ ᱨᱮᱱᱟᱜ ᱞᱩᱭᱮᱱᱴᱮᱞ ᱨᱮ ᱢᱮᱱᱟᱜ ᱚᱢᱚᱨ ᱡᱭᱳᱛᱤ ᱦᱟᱭ ᱥᱠᱩᱞ ᱠᱷᱚᱱ ᱟᱡᱟᱜ ᱫᱚᱥᱟᱨ ᱥᱮᱪᱮᱫ ᱯᱩᱨᱟᱹᱣ ᱞᱮᱫᱼᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱩᱯᱮᱱᱫᱨᱚ ᱫᱮᱵᱽᱠᱚᱴᱟ ᱭᱤᱡ ᱜᱟᱛᱮᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱟᱢᱨᱤᱛ ᱥᱟᱬᱮᱥ ᱠᱚᱞᱮᱡᱽ ᱠᱷᱚᱱ ᱦᱟᱭ ᱥᱠᱩᱞ ᱯᱟᱲᱦᱟᱣ ᱞᱮᱱᱟᱭ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱠᱚᱞᱚᱢᱵᱳ ᱡᱚᱡᱚᱱᱟ ᱥᱤᱠᱷᱱᱟᱹᱛ ᱨᱮ ᱩᱱᱤ ᱫᱚ ᱑᱙᱗᱗ ᱥᱟᱞ ᱨᱮ ᱪᱚᱱᱰᱤᱜᱚᱰ ᱠᱷᱚᱱ ᱟᱨᱠᱤᱴᱮᱠᱪᱟᱨ ᱨᱮ ᱯᱟᱲᱦᱟᱣ ᱞᱮᱱᱟᱭ ᱾ ᱠᱚᱞᱮᱡᱽ ᱨᱤᱱᱤᱡ ᱯᱨᱤᱱᱥᱤᱯᱟᱞ, ᱞᱮᱯᱷᱴᱤᱱᱮᱱᱴ ᱠᱚᱨᱱᱚᱞ (Retd.) ᱵᱷᱚᱠᱥᱤ ᱫᱚ ᱢᱮᱱ ᱠᱮᱫᱟ, \"ᱩᱱᱤ ᱫᱚ ᱢᱤᱫ ᱧᱩᱛᱩᱢᱟᱱ ᱥᱮᱪᱮᱫᱤᱭᱟ.\" ᱱᱚᱣᱟ ᱚᱠᱛᱚ ᱨᱮᱜᱮ ᱩᱱᱤ ᱫᱚ ᱚᱞ ᱤᱱᱰᱤᱭᱟ ᱱᱮᱯᱟᱞᱤ ᱥᱴᱩᱰᱮᱸᱴᱥ ᱤᱥᱚᱸᱜᱷᱚ ᱨᱤᱱᱤᱡ ᱛᱷᱟᱯᱱᱟᱣᱤᱭᱟᱹ ᱯᱟᱨᱥᱮᱛ ᱮ ᱵᱮᱱᱟᱣ ᱮᱱᱟ ᱾ ᱱᱚᱣᱟ ᱜᱟᱶᱛᱟ ᱫᱚ ᱟᱨᱠᱤᱴᱮᱠᱪᱟᱨ ᱵᱟᱦᱨᱮ ᱨᱮ ᱟᱡᱟᱜ ᱥᱮᱪᱮᱫ ᱦᱚᱨᱟ ᱯᱟᱥᱱᱟᱣ ᱨᱮ ᱟᱡᱟᱜ ᱯᱩᱭᱞᱩ ᱫᱷᱟᱣ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱱᱚᱶᱟ ᱢᱩᱴ ᱫᱚ ᱘ ᱞᱟᱹᱴᱩ ᱠᱷᱚᱱ ᱦᱚᱸ ᱵᱟᱹᱲᱛᱤ ᱦᱩᱭᱩᱜᱼᱟ ᱡᱩᱫᱤ ᱛᱟᱭᱣᱟᱱ ᱨᱮ ᱯᱷᱟᱭᱤᱞ ᱨᱮᱱ ᱥᱚᱫᱮᱥᱤ ᱦᱚᱲ ᱠᱚ ᱥᱮᱞᱮᱫ ᱠᱚᱜ-ᱟ, ᱟᱜᱟᱢ ᱨᱮ ᱟᱹᱭᱫᱟᱹᱨᱤ ᱯᱟᱹᱛᱤᱭᱟᱹᱣ ᱛᱟᱺᱜᱤ ᱛᱮ᱾ ᱢᱮᱥᱟ ᱵᱚᱥᱛᱟ ᱨᱮᱱ ᱠᱚ ᱥᱮᱞᱮᱫ ᱠᱚᱜ ᱠᱷᱟᱱ, ᱱᱚᱝᱠᱟᱱ ᱮᱞ ᱫᱚ ᱢᱤᱫ ᱵᱟᱲᱟᱭ ᱜᱟᱱ ᱠᱷᱚᱱ ᱦᱚᱸ ᱵᱟᱹᱲᱛᱤ ᱦᱩᱭ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ᱾ ᱥᱮᱪᱮᱫ ᱠᱷᱚᱱ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟ ᱡᱮ ᱩᱱᱠᱩ ᱨᱮᱱ ᱜᱚᱲᱚᱢ ᱦᱟᱲᱟᱢ ᱑᱕,᱐᱐᱐ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱛᱟᱭᱣᱟᱱ ᱨᱮᱠᱚ ᱛᱟᱦᱮᱱ ᱠᱟᱱᱟ᱾ ᱟᱹᱰᱤ ᱜᱟᱱ ᱥᱟᱹᱵᱩᱫᱽ ᱛᱮ ᱵᱟᱰᱟᱭᱚᱜ ᱠᱟᱱᱟ ᱡᱮ ᱛᱟᱭᱣᱟᱱ ᱨᱮᱱ ᱥᱚᱫᱮᱥᱤ ᱦᱚᱲ ᱠᱚ ᱑᱗ ᱥᱟᱭ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱦᱟᱱ ᱪᱟᱭᱱᱤᱡᱽ ᱱᱤᱭᱟᱹ ᱴᱟᱹᱯᱩ ᱨᱮ ᱵᱟᱥᱟ ᱞᱟᱦᱟᱨᱮ ᱫᱟᱠᱷᱤᱱ ᱯᱩᱨᱩᱵ ᱮᱥᱤᱭᱟ ᱨᱮᱭᱟᱜ ᱟᱭᱢᱟ ᱴᱚᱴᱷᱟ ᱞᱟᱠᱪᱟᱨ ᱠᱚ ᱥᱟᱶᱛᱮ ᱞᱮᱛᱟᱲ ᱵᱮᱯᱟᱨ ᱡᱚᱲᱟᱣ ᱠᱚ ᱫᱚᱦᱚ ᱞᱮᱫᱟ᱾",
        "Official The Amazing Race website recapping the show's visit to Terelj",
        "ᱥᱟᱭᱤᱴ ᱑ (Site 1): ᱱᱚᱶᱟ ᱫᱚ ᱥᱟᱱᱟᱢ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱟᱨ ᱥᱩᱨ ᱴᱷᱟᱶ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱓᱓᱔ ᱠᱷᱚᱱ ᱵᱟᱹᱲᱛᱤ ᱡᱟᱨ ᱢᱮᱱᱟᱜᱼᱟ᱾ ᱱᱚᱸᱰᱮ ᱢᱤᱫ ᱥᱟᱪᱟᱨᱦᱮ ᱜᱩᱯᱷᱟ ᱦᱚᱸ ᱢᱮᱱᱟᱜᱼᱟ᱾",
        "‘’’ᱜᱚᱧᱡᱚ ᱯᱳᱨᱱᱳᱜᱽᱨᱟᱯᱷᱤ ᱮᱰᱮᱟᱞᱴ ᱯᱷᱤᱞᱢ ᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱥᱮᱭᱞᱤ ᱠᱟᱱᱟ ᱚᱠᱟ ᱫᱚ ᱧᱮᱧᱮᱞᱤᱭᱟᱹᱠᱳ ᱫᱚ ᱥᱚᱡᱷᱮ ᱧᱮᱞ ᱞᱮᱠᱟᱛᱮ ᱫᱚᱦᱚ ᱨᱮᱭᱟᱜᱼᱮ ᱨᱤᱠᱟᱹ ᱮᱫᱟ᱾ ᱢᱟᱱᱟᱜ ᱠᱟᱱᱟ ᱡᱮ ᱡᱮᱢᱤ ᱜᱤᱞᱤᱥ ᱫᱚ ᱟᱡᱼᱟᱜ ᱳᱱ ᱫᱟ ᱯᱳᱞ ᱥᱨᱤᱝᱠᱷᱞᱟ ᱨᱮᱭᱟᱜ ᱯᱷᱤᱞᱢᱠᱳ ᱨᱮ ᱠᱷᱚᱱ ᱜᱚᱧᱡᱚ ᱯᱳᱨᱱᱳᱜᱽᱨᱟᱯᱷᱤ ᱥᱮᱭᱞᱤ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱛᱟᱦᱮᱸᱠᱟᱱᱟ᱾",
        "ᱱᱚᱣᱟ ᱯᱟᱛᱷᱟᱢ ᱫᱚ ᱑᱙᱖᱓ ᱥᱟᱞ ᱠᱷᱚᱱ ᱩᱪᱷᱟᱹᱱ ᱮᱦᱚᱵ ᱞᱮᱱᱟ᱾ ᱮᱛᱚᱦᱚᱵ ᱨᱮ ᱒᱔ ᱯᱟᱨᱜᱟᱱᱟ ᱨᱮᱱᱟᱜ ᱠᱮᱱᱤᱝ ᱴᱟᱣᱩᱱ ᱨᱮ ᱢᱮᱱᱟᱜ 'ᱥᱩᱱᱫᱚᱨᱵᱚᱱ ᱦᱟᱡᱤ ᱫᱮᱥᱟᱨᱚᱛ ᱠᱚᱞᱮᱡᱽ' ᱨᱮ ᱵᱷᱤᱛ ᱯᱟᱛᱷᱟᱢ (Wall Magazine) ᱞᱮᱠᱟᱛᱮ ᱱᱚᱣᱟ ᱫᱚ ᱯᱩᱭᱞᱩ ᱩᱪᱷᱟᱹᱱ ᱞᱮᱱᱟ᱾ ᱩᱱ ᱚᱠᱛᱚ ᱨᱮ ᱱᱚᱣᱟ ᱯᱟᱛᱷᱟᱢ ᱫᱚ ᱵᱟᱨ-ᱯᱟᱹᱨᱥᱤ ᱛᱮ (Bilingual) ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ᱾ ᱚᱱᱟ ᱠᱚᱞᱮᱡᱽ ᱨᱤᱱᱤᱡ ᱯᱨᱤᱱᱥᱤᱯᱟᱞᱟᱜ ᱫᱤᱥ-ᱦᱩᱫᱤᱥ ᱞᱮᱠᱟᱛᱮ ᱰᱨ. ᱵᱷᱳᱣᱢᱤᱠ ᱫᱚ ᱠᱚᱞᱮᱡᱽ ᱨᱤᱱ ᱜᱮ ᱛᱤᱱᱟᱹᱜ ᱜᱟᱱ ᱥᱟᱱᱛᱟᱲ ᱯᱟᱹᱴᱷᱩᱣᱟᱹ ᱠᱚ ᱥᱟᱶ ᱢᱮᱥᱟ ᱠᱟᱛᱮ 'ᱵᱷᱤᱛ ᱯᱟᱛᱷᱟᱢ' ᱠᱷᱚᱱ 'ᱦᱟᱹᱨᱭᱟᱹᱲ ᱥᱟᱠᱟᱢ' ᱯᱟᱛᱷᱟᱢ ᱞᱮᱠᱟᱛᱮᱭ ᱩᱪᱷᱟᱹᱱ ᱠᱮᱫᱼᱟ᱾",
        "ᱢᱟᱭᱛᱷᱚᱱ ᱫᱚ ᱥᱤᱧᱚᱛᱤᱭᱟᱹ ᱯᱚᱱᱚᱛ ᱡᱷᱟᱨᱠᱷᱚᱸᱰ ᱨᱮᱱᱟᱜ ᱫᱷᱟᱱᱵᱟᱫᱽ ᱦᱚᱱᱚᱛ ᱨᱮᱱᱟᱜ ᱫᱷᱟᱱᱵᱟᱫᱽ ᱥᱚᱫᱚᱨ ᱥᱟᱵᱽᱰᱤᱵᱤᱡᱚᱱ ᱨᱮ ᱱᱤᱨᱥᱟ ᱥᱤᱰᱤ ᱵᱞᱚᱠ ᱨᱮ ᱢᱤᱫ ᱦᱚᱲᱞᱮᱠᱷᱟ ᱥᱚᱦᱚᱨ ᱠᱟᱱᱟ ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱵᱟᱨᱟᱠᱟᱨ ᱜᱟᱰᱟ ᱫᱷᱟᱨᱮ ᱨᱮ ᱢᱮᱱᱟᱜᱼᱟ ᱾",
        "ᱵᱮᱵᱤ ᱱᱟᱡᱱᱤᱱ ᱫᱚ ᱵᱟᱝᱞᱟᱫᱤᱥᱟᱹᱢ ᱨᱮᱱ ᱢᱤᱫ ᱨᱩᱭᱟᱹᱲ ᱥᱮᱨᱤᱧ ᱥᱤᱞᱯᱤ ᱥᱟᱶ ᱢᱤᱫ ᱨᱟᱡᱽᱱᱤᱛᱤ-ᱵᱤᱫ ᱦᱚᱸ ᱠᱟᱱᱵᱟᱭ᱾ ᱱᱩᱭ ᱫᱚᱹᱲ ᱵᱤ-ᱮᱱ-ᱯᱤ ᱪᱮᱨᱯᱟᱨᱥᱚᱱ ᱨᱮᱱ ᱛᱟᱦᱮᱠᱟᱱ ᱯᱨᱚᱫᱷᱟᱱ ᱢᱚᱱᱛᱨᱤ ᱵᱮᱜᱚᱢ ᱠᱷᱟᱞᱮᱫᱟ ᱠᱤᱭᱟ ᱨᱮᱱ ᱩᱯᱚᱫᱮᱥᱴᱟ ᱠᱟᱱᱟᱭ᱾ ᱩᱱᱤ ᱫᱚ ᱫᱤᱥᱟᱹᱢ ᱨᱮᱱᱟᱜ ᱑᱑ᱼᱟᱱᱟᱝ ᱥᱚᱝᱥᱚᱫ ᱱᱤᱨᱵᱟᱪᱚᱱ ᱨᱮ ᱵᱤ-ᱮᱱ-ᱯᱤ ᱠᱷᱚᱱ ᱢᱚᱱᱚᱱᱚᱭᱚᱱ ᱮ ᱧᱟᱢ ᱞᱮᱫᱟ᱾ ᱑᱙᱗᱖ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱩᱱᱤ ᱫᱚ ᱟᱹᱰᱤ ᱜᱟᱱ ᱛᱮᱭ ᱥᱮᱨᱤᱧ ᱟᱠᱟᱫᱟ᱾ ᱚᱱᱟ ᱵᱮᱜᱚᱨ ᱦᱚᱸ ᱒᱐᱐᱓ ᱥᱮᱨᱢᱟ ᱨᱮ ᱨᱩᱭᱟᱹᱲ ᱥᱮᱨᱤᱧ ᱥᱤᱞᱯᱤᱧ ᱞᱮᱠᱟᱛᱮ ᱡᱮᱜᱮᱛᱟᱹᱨᱤ ᱪᱤᱱᱮᱢᱟ ᱠᱷᱚᱱ ᱵᱮᱥᱤ ᱛᱤᱨᱞᱟᱹ ᱯᱩᱨᱩᱥᱠᱟᱨ ᱮ ᱦᱟᱢᱮᱴ ᱟᱠᱟᱫᱟ᱾",
        "ᱦᱚᱲ ᱮᱞ (Population): ᱦᱚᱲ ᱮᱞ ᱵᱟᱹᱲᱛᱤ ᱞᱮᱠᱷᱟᱱ ᱫᱤᱥᱚᱢ ᱨᱮ ᱵᱮᱵᱷᱟᱨ ᱦᱚᱸ ᱵᱟᱹᱲᱛᱤᱜᱼᱟ ᱾",
        "ᱩᱱᱤ ᱫᱚ ᱴᱤᱵᱷᱤ ᱥᱤᱨᱤᱭᱟᱹᱞ \"ᱢᱩᱠᱷᱛᱟ\" (Muktha) ᱞᱟᱹᱜᱤᱫ ᱦᱚᱸ ᱦᱚᱲ ᱠᱚ ᱛᱟᱞᱟ ᱨᱮ ᱟᱹᱰᱤ ᱵᱟᱰᱟᱭ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟᱭ ᱾",
        "ᱟᱡ ᱨᱤᱱ ᱢᱤᱥᱨᱟ ᱜᱤᱛᱟ ᱯᱷᱳᱜᱟᱴ ᱟᱨ ᱵᱚᱵᱤᱛᱟ ᱠᱩᱢᱟᱨᱤ ᱥᱟᱶᱛᱮ ᱟᱡ ᱦᱚᱯᱚᱱ ᱵᱟ ᱨᱤᱱ ᱦᱚᱯᱚᱱ ᱮᱨᱟ ᱵᱤᱱᱮᱥ ᱯᱷᱳᱜᱟᱴ ᱛᱮᱠᱚ ᱡᱚᱛᱚ ᱜᱮ ᱠᱚᱢᱚᱱᱣᱮᱞᱛᱷ ᱜᱮᱢᱥ ᱨᱮ ᱠᱩᱥᱛᱤ ᱨᱮ ᱥᱚᱱᱟ ᱢᱮᱰᱟᱞ ᱡᱤᱛᱠᱟᱹᱨᱤᱭᱟᱹ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱟᱡ ᱨᱤᱱ ᱟᱨ ᱢᱤᱫ ᱦᱚᱯᱚᱱ ᱵᱟ ᱨᱤᱱ ᱦᱚᱯᱚᱱ ᱮᱨᱟ ᱯᱨᱤᱭᱚᱝᱠᱟ ᱯᱷᱳᱜᱟᱴ ᱦᱚᱸ ᱡᱮᱜᱮᱛᱟᱹᱨᱤ ᱛᱷᱚᱠ ᱨᱤᱱᱤᱡ ᱠᱩᱥᱛᱤ ᱠᱷᱮᱞᱚᱸᱰᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ ᱾",
        "ᱢᱟᱱᱫᱷᱟᱛᱟ ᱨᱤᱱᱤᱡ ᱵᱷᱤᱞᱟᱞᱟ ᱨᱟᱣ ᱫᱚ ᱚᱢᱠᱟᱨᱮᱥᱣᱚᱨ ᱥᱤᱵᱽ ᱢᱚᱱᱫᱤᱨ ᱨᱤᱱᱤᱡ ᱦᱮᱨᱮᱰᱤᱴᱟᱨᱤ ᱜᱟᱨᱰᱤᱭᱟᱱ (hereditary custodian) ᱠᱟᱱᱟᱭ ᱾ ᱩᱱᱠᱩᱣᱟᱜ ᱠᱟᱛᱷᱟ ᱞᱮᱠᱟᱛᱮ, ᱩᱱᱠᱩ ᱨᱤᱱ ᱦᱟᱯᱲᱟᱢ ᱵᱷᱟᱨᱚᱛ ᱥᱤᱝ (ᱢᱤᱫ ᱪᱚᱣᱦᱟᱱ ᱨᱟᱡᱽᱯᱩᱛ) ᱑᱑᱖᱕ ᱥᱮᱨᱢᱟ ᱨᱮ ᱱᱟᱛᱷᱩ ᱵᱷᱤᱞ ᱦᱟᱨᱟᱣ ᱠᱟᱛᱮ ᱢᱟᱱᱫᱷᱟᱛᱟ ᱫᱚᱭ ᱡᱤᱛᱠᱟᱹᱨ ᱞᱮᱫᱟ ᱾",
        "ᱥᱮᱨᱢᱟ ᱨᱮᱱ ᱟᱛᱢᱟ ᱠᱚᱫᱚ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱫᱟᱲᱮᱭᱟᱱ ᱟᱛᱢᱟ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱟᱱᱟᱣ ᱠᱚᱣᱟ, ᱟᱨ ᱚᱱᱟ ᱥᱟᱶᱛᱮ ᱵᱚᱝᱥᱚ-ᱠᱟᱹᱯᱤ ᱨᱮᱭᱟᱜ ᱧᱩᱛᱩᱢ ᱥᱟᱶ ᱡᱚᱲᱟᱣ ᱟᱛᱢᱟ ᱠᱚ ᱦᱚᱸ ᱢᱮᱱᱟᱜ ᱠᱚᱣᱟ, ᱡᱮᱞᱮᱠᱟ 'ᱣᱤᱣ' (WiW), ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱞᱟᱹᱲᱦᱟᱹᱭ ᱨᱮᱱ ᱵᱚᱸᱜᱟ ᱠᱟᱱᱟᱭ ᱟᱨ ᱪᱮᱴᱮᱨ ᱥᱟᱶ ᱡᱚᱲᱟᱣ ᱢᱮᱱᱟᱭᱟ ᱾ ᱱᱩᱭᱮᱨ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱯᱟᱹᱛᱭᱟᱹᱣ ᱢᱮᱱᱟᱜᱼᱟ ᱡᱮ ᱡᱚᱠᱷᱚᱱ ᱢᱤᱫ ᱦᱚᱲ ᱮ ᱜᱩᱡᱩᱜᱼᱟ, ᱩᱱᱤᱭᱟᱜ ᱦᱚᱲᱢᱚ, ᱡᱤᱣᱤ ᱟᱨ ᱟᱛᱢᱟ ᱫᱚ ᱵᱷᱮᱜᱟᱨ ᱵᱷᱮᱜᱟᱨ ᱜᱚᱫᱚᱜᱼᱟ ᱾ ᱦᱚᱲᱢᱚ ᱫᱚ ᱦᱟᱥᱟ ᱨᱮ ᱢᱮᱥᱟᱜᱼᱟ, ᱡᱤᱣᱤ ᱫᱚ ᱵᱚᱝᱜᱟ ᱴᱷᱮᱱ ᱨᱩᱣᱟᱹᱲᱚᱜᱼᱟ, ᱟᱨ ᱟᱛᱢᱟ ᱫᱚ ᱢᱤᱫ ᱩᱢᱩᱞ ᱞᱮᱠᱟ ᱛᱟᱦᱮᱸᱱᱟ ᱟᱨ ᱫᱟᱬᱮ ᱟᱠᱟᱱ ᱰᱟᱝᱜᱽᱨᱟ ᱥᱟᱶᱛᱮ ᱵᱷᱩᱛ ᱠᱚᱣᱟᱜ ᱴᱷᱟᱶ ᱛᱮ ᱪᱟᱞᱟᱜᱼᱟ ᱾",
        "ᱠᱚᱣᱥᱤᱠᱚ ᱫᱚ ᱡᱮᱭᱱ ᱥᱚᱢᱟᱡᱽ ᱨᱤᱱᱤᱡ ᱮ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱥᱚᱢᱟᱡᱽ ᱫᱚ ᱠᱤᱥᱟᱹᱬ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱢᱮᱱᱠᱷᱟᱱ ᱮᱴᱟᱜ ᱦᱚᱲ ᱠᱚ ᱩᱱᱠᱩ ᱵᱟᱝ ᱠᱚ ᱠᱩᱥᱤᱭᱟᱠᱚ ᱛᱟᱦᱮᱸᱫ ᱾ ᱟᱠᱠᱟ ᱫᱚ ᱠᱤᱥᱟᱹᱬ ᱡᱤᱭᱚᱱ ᱵᱟᱹᱜᱤ ᱠᱟᱛᱮ ᱢᱤᱫ ᱫᱟᱬᱟᱱ ᱥᱟᱹᱫᱷᱩ ᱞᱮᱠᱟᱛᱮ ᱥᱤᱵᱽ ᱟᱜ ᱥᱮᱨᱮᱧ ᱮ ᱥᱮᱨᱮᱧ ᱮᱫ ᱛᱟᱦᱮᱸᱫ ᱾ ᱩᱱᱤ ᱫᱚ ᱟᱡ ᱞᱮᱠᱟᱱ ᱵᱷᱚᱠᱛᱚ ᱠᱚ ᱯᱟᱱᱛᱮ ᱞᱟᱹᱜᱤᱫ ᱮ ᱚᱰᱚᱠ ᱞᱮᱱᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱵᱤᱫᱚᱨ ᱡᱤᱞᱞᱟᱹ ᱨᱮᱱᱟᱜ ᱵᱟᱥᱟᱵᱷᱟᱠᱚᱞᱭᱟᱬᱟ ᱨᱮ ᱚᱱᱠᱟᱱ ᱦᱚᱲ ᱠᱚᱭ ᱧᱟᱢ ᱞᱮᱫ ᱠᱚᱣᱟ ᱟᱨ ᱩᱱᱠᱩ ᱞᱟᱹᱜᱤᱫ ᱟᱭᱢᱟ ᱵᱚᱪᱚᱱ ᱮ ᱚᱞ ᱞᱮᱫᱟ ᱾ ᱩᱱᱤᱭᱟᱜ ᱵᱷᱮᱜᱟᱨ ᱵᱷᱮᱜᱟᱨ ᱰᱟᱦᱟᱨ ᱠᱷᱟᱹᱛᱤᱨ ᱩᱱ ᱡᱚᱦᱚᱜᱟᱜ ᱥᱚᱢᱟᱡᱽ ᱨᱮ ᱟᱹᱰᱤ ᱜᱟᱱ ᱮᱴᱠᱮᱴᱚᱬᱮ ᱦᱩᱭ ᱞᱮᱱᱟ, ᱱᱚᱛᱮ ᱟᱡᱤᱡ ᱜᱩᱨᱩ ᱟᱞᱞᱟᱢᱟ ᱯᱨᱚᱵᱷᱩ ᱦᱚᱸ ᱩᱱᱤ ᱟᱱᱩᱵᱷᱚᱵᱚ ᱢᱚᱱᱴᱟᱯᱟ ᱨᱮ ᱥᱮᱞᱮᱫ ᱞᱟᱹᱜᱤᱫ ᱟᱹᱰᱤ ᱮᱴᱠᱮᱴᱚᱬᱮᱭ ᱥᱟᱢᱟᱝ ᱞᱮᱫᱟ ᱾",
        "ᱪᱤᱱ ᱥᱚᱨᱠᱟᱨ ᱦᱚᱛᱮᱛᱮ ᱟᱠᱷᱟ ᱦᱚᱲ ᱫᱚ ᱵᱟᱹᱲᱛᱤ ᱠᱟᱭᱛᱮ ᱦᱟᱱᱤ ᱡᱟᱹᱛᱤ ᱨᱮᱱ ᱢᱤᱫ ᱦᱟᱹᱴᱤᱧ ᱞᱮᱠᱟᱛᱮ ᱠᱚ ᱞᱮᱠᱷᱟᱣᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱢᱤᱫ ᱥᱚᱨᱠᱟᱨᱤ ᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱟᱹᱫᱤᱵᱟᱹᱥᱤ ᱠᱟᱱᱟ ᱠᱚ ᱾ ᱟᱠᱷᱟ ᱦᱚᱲ ᱫᱚ ᱦᱟᱱᱤ ᱥᱟᱶ ᱟᱹᱰᱤ ᱥᱟᱹᱜᱟᱹᱭ ᱢᱮᱱᱟᱜ ᱨᱮᱦᱚᱸ, ᱩᱱᱠᱩ ᱫᱚ ᱟᱠᱚ ᱛᱮ ᱢᱤᱫ ᱵᱷᱮᱜᱟᱨ ᱜᱟᱫᱮᱞ ᱢᱮᱱᱛᱮ ᱠᱚ ᱢᱟᱱᱟᱣᱟ ᱾ ᱛᱷᱟᱭᱞᱮᱱᱰ ᱨᱮ, ᱩᱱᱠᱩ ᱫᱚ ᱛᱩᱨᱩᱭ ᱜᱚᱴᱟᱝ ᱵᱩᱨᱩ ᱟᱹᱫᱤᱵᱟᱹᱥᱤ ᱢᱩᱫᱽ ᱨᱮ ᱠᱚ ᱞᱮᱠᱷᱟᱣᱟ ᱾ ᱛᱷᱟᱭᱞᱮᱱᱰ ᱨᱮ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱ ᱟᱹᱰᱤ ᱠᱚᱢ ᱟᱠᱷᱟ ᱦᱚᱲ ᱴᱷᱮᱱ ᱜᱮ ᱚᱱᱟ ᱫᱤᱥᱚᱢ ᱨᱮᱱᱟᱜ ᱱᱟᱹᱜᱟᱹᱨᱤᱭᱟᱹ ᱥᱟᱠᱟᱢ ᱢᱮᱱᱟᱜᱼᱟ, ᱵᱟᱹᱲᱛᱤ ᱫᱚ ᱵᱟᱦᱨᱮ ᱦᱚᱲ ᱞᱮᱠᱟᱛᱮ ᱠᱚ ᱨᱮᱡᱤᱥᱴᱟᱨ ᱟᱠᱟᱱᱟ ᱾",
        "ᱯᱷᱮᱰᱮᱨᱟᱞ ᱟᱹᱭᱫᱟᱹᱨ ᱧᱟᱢ ᱛᱟᱭᱚᱢ ᱦᱚᱸ, ᱠᱤᱪᱷᱩ ᱯᱚᱱᱚᱛ ᱨᱮ ᱛᱤᱨᱞᱟᱹ ᱠᱚ ᱟᱠᱚᱣᱟᱜ ᱞᱳᱠᱟᱞ ᱵᱟᱪᱷᱱᱟᱣ ᱞᱟᱹᱜᱤᱫ ᱛᱟᱭᱚᱢ ᱛᱮ ᱟᱹᱭᱫᱟᱹᱨ ᱠᱚ ᱧᱟᱢ ᱞᱮᱫᱼᱟ:",
        "ᱨᱮᱱᱟᱜ ᱵᱩᱥᱮᱦᱨ, ᱟᱛᱮᱭᱵᱮᱦ ᱟᱹᱛᱩ ᱨᱮ ᱡᱷᱟᱹᱶ ᱫᱟᱨᱮ]]",
        "ᱛᱷᱚᱠ:ᱭᱩᱠᱨᱮᱱ ᱨᱮᱱᱟᱜ ᱵᱟᱝ ᱡᱚᱴᱮᱫ ᱟᱱ ᱞᱟᱠᱪᱟᱨ ᱵᱤᱨᱟᱹᱫᱽ",
        "ᱵᱟᱝᱞᱟ ᱯᱟᱹᱨᱥᱤ ᱫᱚ ᱱᱚᱶᱟ ᱥᱚᱦᱚᱨ ᱨᱮ ᱡᱟᱹᱥᱛᱤ ᱠᱚ ᱨᱚᱲᱼᱟ ᱾ ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱦᱤᱱᱫᱤ, ᱵᱷᱳᱡᱽᱯᱩᱨᱤ, ᱱᱮᱯᱟᱞᱤ ᱟᱨ ᱥᱟᱫᱽᱨᱤ ᱯᱟᱹᱨᱥᱤ ᱠᱚ ᱨᱚᱲᱼᱟ ᱾",
        "ᱮᱡᱽᱡᱟᱛ ᱤᱵᱽᱨᱟᱦᱤᱢ-ᱱᱮᱡᱟᱫᱽ (ᱟᱨᱦᱚᱸ ᱮᱡᱽᱡᱟᱛ ᱤᱵᱽᱨᱟᱦᱤᱢᱱᱮᱡᱟᱫᱽ) ᱫᱚ ᱢᱤᱫ ᱤᱨᱟᱱᱤ ᱯᱟᱹᱴᱷᱩᱣᱟᱹ, ᱚᱱᱚᱬᱦᱤᱭᱟᱹ ᱟᱨ ᱦᱩᱞᱜᱟᱹᱨᱤᱭᱟᱹᱭ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱥᱤᱠᱤᱣᱨᱤᱴᱤ ᱯᱷᱳᱨᱥ ᱦᱚᱛᱮᱛᱮ ᱛᱮᱦᱨᱟᱱ ᱡᱮᱜᱮᱛ ᱵᱤᱨᱫᱟᱹᱜᱟᱲ ᱰᱚᱨᱢᱤᱴᱚᱨᱤ ᱨᱮ ᱟᱠᱨᱚᱢᱚᱬ ᱚᱠᱛᱚ ᱜᱩᱞᱤ ᱛᱮᱠᱚ ᱜᱚᱡ ᱞᱮᱫᱮᱭᱟ, ᱡᱟᱦᱟᱸ ᱫᱚ ᱤᱨᱟᱱ ᱨᱮ ᱡᱩᱞᱟᱭ ᱑᱙᱙᱙ ᱨᱮᱭᱟᱜ ᱯᱟᱹᱴᱷᱩᱣᱟᱹ ᱦᱩᱞᱥᱟᱹᱭ ᱮ ᱥᱤᱨᱡᱟᱹᱣ ᱞᱮᱫᱟ ᱾",
        "ᱩᱱᱤ ᱫᱚ ᱒᱐᱑᱘ ᱞᱟᱹᱜᱤᱫ ᱵᱤᱵᱤᱥᱤ ᱭᱟᱜ ᱡᱮᱜᱮᱛ ᱨᱤᱱ ᱑᱐᱐ ᱩᱫᱽᱜᱟᱹᱣᱟᱱ ᱟᱨ ᱚᱨᱥᱚᱝᱟᱱ ᱛᱤᱨᱞᱟᱹ ᱠᱚᱣᱟᱜ ᱛᱟᱹᱞᱠᱟᱹ ᱨᱮᱠᱚ ᱥᱮᱞᱮᱫ ᱞᱮᱫᱮᱭᱟ ᱾",
        "ᱛᱷᱚᱠ:ᱢᱩᱵᱷᱢᱮᱱᱴ ᱚᱯᱷ ᱢᱤᱞᱤᱴᱟᱱᱴ ᱢᱩᱥᱞᱤᱢᱥ ᱨᱟᱡᱽᱟᱹᱨᱤᱭᱟᱹ ᱠᱚ",
        "ᱯᱚᱝᱜᱟᱪᱷᱤᱭᱟᱹ, ᱢᱟᱡᱤᱭᱟᱨᱟ, ᱵᱷᱟᱱᱳᱣᱟᱨᱟ, ᱫᱳᱢᱳᱦᱟᱱᱤ, ᱪᱚᱨᱚᱱᱯᱩᱨ (ᱳᱡᱤ), ᱨᱚᱛᱤᱵᱟᱛᱤ ᱟᱨ ᱪᱮᱞᱟᱫᱽ ᱫᱚ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱥᱚᱦᱚᱨ ᱨᱮᱱᱟᱜ ᱢᱤᱫ ᱜᱩᱴ ᱠᱟᱱᱟ ᱟᱨ ᱟᱥᱟᱱᱥᱳᱞ ᱨᱮᱱᱟᱜ ᱠᱚᱧᱮ ᱟᱨ ᱥᱟᱢᱟᱝ ᱫᱷᱟᱨᱮ ᱨᱮ ᱢᱤᱫᱴᱟᱹᱝ ᱴᱷᱟᱶ ᱠᱟᱱᱟ ᱾",
        "ᱥᱤᱧᱚᱛ ᱨᱮᱱᱟᱜ ᱒᱐᱑᱑ ᱥᱟᱞ ᱨᱮᱱᱟᱜ ᱦᱚᱲ ᱞᱮᱠᱷᱟ ᱡᱚᱠᱷᱟ ᱞᱮᱠᱟᱛᱮ, ᱵᱚᱱᱚᱜᱨᱟᱢ ᱨᱮ ᱕,᱖᱓᱕ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱚᱱᱟ ᱢᱩᱸᱫᱽ ᱠᱷᱚᱱ ᱒,᱙᱓᱘ (᱕᱒%) ᱠᱚᱲᱟ ᱟᱨ ᱒,᱖᱙᱗ (᱔᱘%) ᱛᱤᱨᱞᱟᱹ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱐ ᱠᱷᱚᱱ ᱖ ᱥᱮᱨᱢᱟ ᱩᱢᱮᱨ ᱨᱮ ᱦᱚᱲ ᱮᱞ ᱖᱖᱖ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾ ᱵᱚᱱᱚᱜᱨᱟᱢ ᱨᱮ ᱚᱞ ᱯᱟᱲᱦᱟᱣ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱜᱩᱴ ᱮᱞ ᱓,᱔᱓᱑ ᱦᱚᱲ ᱠᱚ (᱖ ᱥᱮᱨᱢᱟ ᱠᱷᱚᱱ ᱰᱷᱮᱨ ᱦᱚᱲᱟᱜ ᱖᱙.᱐᱕%) ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ ᱾",
        "ᱮᱛᱚᱢ ᱮᱥᱤᱭᱟ ᱨᱮᱭᱟᱜ ᱮᱴᱟᱜ ᱢᱩᱬᱩᱛ ᱱᱟᱜᱟᱨ ᱠᱚ ᱞᱮᱠᱟᱜᱮ, ᱪᱚᱴᱴᱚᱜᱨᱟᱢ ᱨᱮᱦᱚᱸ ᱠᱟᱹᱣᱰᱤᱟᱹᱨᱤ ᱠᱟᱹᱢᱤᱦᱚᱨᱟ ᱵᱟᱹᱲᱛᱤᱜ ᱟᱨ ᱟᱹᱛᱩ ᱫᱤᱥᱚᱢ ᱠᱷᱚᱱ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱦᱮᱡ ᱠᱷᱟᱹᱛᱤᱨ ᱚᱥᱚᱨᱠᱟᱨᱤ ᱵᱚᱥᱚᱛᱤ ᱠᱚ ᱞᱮᱛᱟᱲ ᱜᱮ ᱵᱟᱹᱲᱛᱤ ᱟᱠᱟᱱᱟ᱾ ᱡᱮᱡᱟᱹᱛᱤᱭᱟᱹᱨᱤ ᱠᱟᱹᱣᱰᱤ ᱯᱷᱟᱸᱰ ᱨᱮᱭᱟᱜ ᱢᱤᱫ ᱨᱮᱸᱜᱮᱡ ᱠᱚᱢ ᱥᱟᱠᱟᱢ ᱞᱮᱠᱟᱛᱮ, ᱥᱤᱴᱤ ᱠᱚᱨᱯᱚᱨᱮᱥᱚᱱ ᱮᱞᱟᱠᱟ ᱵᱷᱤᱛᱨᱤ ᱨᱮ ᱑,᱘᱑᱔ ᱜᱚᱴᱟᱝ ᱵᱚᱥᱛᱤ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱟᱢᱫᱟᱡᱽ ᱑.᱘ ᱢᱤᱞᱤᱭᱚᱱ (᱑᱘ ᱞᱟᱠᱷ) ᱵᱚᱥᱛᱤ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸᱱ ᱠᱟᱱᱟ, ᱱᱚᱣᱟ ᱫᱚ ᱨᱟᱡᱽᱜᱟᱲ ᱰᱷᱟᱠᱟ ᱛᱟᱭᱚᱢ ᱫᱤᱥᱚᱢ ᱨᱮ ᱫᱚᱥᱟᱨ ᱡᱚᱛᱚ ᱠᱷᱚᱱ ᱢᱟᱨᱟᱝ ᱠᱟᱱᱟ᱾ ᱵᱚᱥᱛᱤ ᱨᱮ ᱛᱟᱦᱮᱸᱱ ᱦᱚᱲ ᱠᱚᱫᱚ ᱟᱭᱢᱟ ᱫᱷᱟᱣ ᱴᱚᱴᱷᱟᱠᱤᱭᱟᱹ ᱯᱨᱚᱥᱟᱥᱚᱱ ᱦᱚᱛᱮᱛᱮ ᱩᱪᱷᱮᱫ ᱨᱮᱭᱟᱜ ᱮᱴᱠᱮᱴᱚᱬᱮ ᱠᱚ ᱥᱟᱢᱟᱝᱼᱟ, ᱡᱟᱦᱟᱸ ᱨᱮ ᱩᱱᱠᱩ ᱪᱮᱛᱟᱱ ᱥᱚᱨᱠᱟᱨᱤ ᱡᱟᱭᱜᱟ ᱨᱮ ᱵᱮ-ᱟᱹᱱᱟᱹᱨᱤ ᱞᱮᱠᱟᱛᱮ ᱛᱟᱦᱮᱸᱱ ᱨᱮᱭᱟᱜ ᱫᱳᱥ ᱞᱟᱜᱟᱣᱜᱼᱟ᱾ ᱑۹᱙᱐ ᱫᱚᱥᱚᱠ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱥᱮᱫ, ᱪᱚᱴᱴᱚᱜᱨᱟᱢ ᱨᱮ ᱑.᱕ ᱢᱤᱞᱤᱭᱚᱱ ᱠᱷᱚᱱ ᱠᱤᱪᱷᱩ ᱵᱟᱹᱲᱛᱤ ᱦᱚᱲ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ, ᱡᱟᱦᱟᱸ ᱢᱩᱫᱽ ᱨᱮ ᱖᱙ ᱜᱚᱴᱟᱝ ᱮᱞᱟᱠᱟ ᱨᱮ ᱟᱢᱫᱟᱡᱽ ᱖᱖,᱖᱗᱖ ᱡᱚᱵᱚᱨᱫᱚᱠᱷᱚᱞᱠᱟᱨᱤ ᱠᱚ ᱛᱟᱦᱮᱸ ᱠᱟᱱᱟ᱾",
        "ᱱᱩᱠᱩ ᱵᱚᱸᱜᱟ ᱠᱚᱣᱟᱜ ᱫᱚ ᱡᱟᱦᱮᱨ ᱨᱮ ᱛᱷᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ ᱟᱹᱰᱤ ᱵᱚᱛᱚᱨᱟᱱ ᱥᱮ ᱩᱥᱟᱹᱨᱟ ᱟᱹᱲᱤᱥᱚᱜ ᱠᱚ ᱢᱟᱱᱟᱣ ᱠᱚᱣᱟ᱾ ᱢᱤᱫ ᱢᱟᱨᱮ ᱠᱟᱛᱷᱟ ᱞᱮᱠᱟᱛᱮ ᱩᱱᱠᱩ ᱫᱚ ᱢᱚᱬᱮ ᱵᱚᱭᱦᱟ ᱟᱨ ᱢᱤᱫ ᱢᱤᱥᱮᱨᱟ ᱠᱟᱱᱟ ᱠᱚ᱾ ᱩᱱᱠᱩᱣᱟᱜ ᱫᱚ ᱢᱤᱫᱴᱟᱹᱝ ᱜᱮ ᱵᱚᱸᱜᱟ ᱴᱷᱟᱶ ᱢᱮᱱᱟᱜᱼᱟ ᱟᱨ ᱡᱚᱛᱚ ᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱢᱤᱫᱴᱟᱹᱝ ᱜᱮ ᱵᱚᱸᱜᱟ ᱦᱩᱭᱩᱜᱼᱟ, ᱥᱮ ᱟᱥᱚᱞ ᱫᱚ ᱢᱚᱬᱮ ᱦᱚᱲ ᱞᱟᱹᱜᱤᱫ ᱜᱮ, ᱪᱮᱫᱟᱜ ᱥᱮ ᱛᱩᱨᱩᱭ ᱟᱱᱤᱡ ᱫᱚ ᱵᱟᱭ ᱥᱮᱞᱮᱫᱚᱜᱼᱟ, ᱚᱱᱟᱛᱮ ᱱᱩᱠᱩ ᱫᱚ ᱟᱭᱢᱟ ᱫᱷᱟᱣ ᱥᱩᱢᱩᱝ ᱢᱚᱬᱮᱠᱚ ᱠᱚ ᱢᱮᱛᱟ ᱠᱚᱣᱟ᱾ ᱢᱟᱨᱮ ᱠᱚᱞᱭᱟᱱ ᱜᱩᱨᱩᱭ ᱢᱮᱱ ᱟᱠᱟᱫ ᱞᱮᱠᱟ : ᱛᱩᱨᱩᱭᱠᱚ ᱚᱬᱦᱮ ᱫᱚᱞᱮ ᱚᱬᱦᱮᱠᱚᱣᱟ, ᱵᱚᱸᱜᱟ ᱫᱚ ᱟᱨ ᱵᱟᱞᱮ ᱵᱚᱸᱜᱟᱣᱟᱠᱚᱣᱟ, ᱟᱞᱮ ᱫᱚ ᱛᱩᱨᱩᱭ ᱞᱮ ᱥᱟᱨᱦᱟᱣ ᱠᱚᱣᱟ, ᱢᱮᱱᱠᱷᱟᱱ ᱟᱨ ᱵᱟᱞᱮ ᱵᱚᱸᱜᱟ ᱟᱠᱚᱣᱟ᱾",
        "ᱦᱩᱫᱤᱥ ᱫᱚ ᱢᱤᱫ ᱥᱟᱱᱛᱟᱲᱤ ᱥᱟᱶᱦᱮᱫ ᱯᱟᱛᱷᱟᱢ (ᱯᱚᱛᱨᱤᱠᱟ) ᱠᱟᱱᱟ᱾ ᱱᱚᱶᱟ ᱯᱟᱛᱷᱟᱢ ᱨᱮᱭᱟᱜ ᱩᱪᱷᱟᱹᱱ ᱫᱚ ᱑᱙᱘᱒ ᱥᱟᱞ ᱠᱷᱚᱱ ᱮᱦᱚᱵ ᱞᱮᱱᱟ᱾ ᱱᱚᱶᱟ ᱫᱚ ᱯᱮ ᱪᱟᱸᱫᱚ ᱨᱮ ᱢᱤᱫ ᱫᱷᱟᱣ (ᱛᱨᱮᱭᱢᱟᱥᱤᱠ) ᱩᱪᱷᱟᱹᱱᱚᱜ ᱠᱟᱱ ᱛᱟᱦᱮᱸᱫ ᱾",
        "ᱫᱤᱥᱩᱣᱟᱹ ᱥᱟᱶᱟᱨ ᱫᱚ ᱦᱚᱲ ᱠᱚᱣᱟᱜ ᱥᱟᱶᱟᱨ ᱪᱮᱛᱟᱱ ᱨᱮ ᱡᱳᱨ ᱮᱢᱚᱜᱼᱟ᱾",
        "ᱟᱨ ᱢᱤᱫ ᱧᱩᱛᱩᱢᱟᱱ ᱥᱟᱢᱟᱞᱚᱪᱚᱱᱤᱭᱟᱹ ᱫᱚᱭ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱤᱛᱷᱟᱱ ᱣᱟᱴᱟᱨᱥ, ᱡᱟᱦᱟᱸᱭ ᱫᱚ ᱠᱨᱮᱡᱤ ᱞᱟᱭᱤᱠ ᱟᱥ: ᱫᱟ ᱜᱞᱳᱵᱟᱞᱟᱭᱡᱮᱥᱚᱱ ᱚᱯᱷ ᱫᱟ ᱟᱢᱮᱨᱤᱠᱟᱱ ᱥᱟᱭᱠᱤ ᱨᱮᱱ ᱚᱱᱚᱞᱤᱭᱟᱹ ᱠᱟᱱᱟᱭ᱾ ᱵᱷᱤᱱᱥᱮᱱᱡᱳ ᱰᱤ ᱱᱤᱠᱳᱞᱟ ᱦᱚᱛᱮᱛᱮ ᱟᱨᱦᱚᱸ ᱢᱤᱫ ᱵᱮᱱᱟᱣᱟᱱ ᱫᱤᱥᱴᱤᱵᱷᱚᱝᱜᱤ ᱮᱢ ᱟᱠᱟᱱᱟ ᱡᱟᱦᱟᱸᱭᱟᱜ ᱚᱱᱚᱞ ᱫᱚ ᱢᱤᱫ ᱱᱟᱶᱟ ᱩᱰᱩᱠᱚᱜ ᱠᱟᱱ ᱮᱯᱤᱥᱴᱮᱢᱳᱞᱳᱡᱤ ᱞᱮᱠᱟᱛᱮ ᱜᱞᱳᱵᱟᱞ ᱥᱟᱣᱩᱛᱷ ᱪᱮᱛᱟᱱ ᱨᱮ ᱡᱮᱜᱮᱛᱟᱹᱨᱤᱠᱚᱨᱚᱱ ᱨᱮᱭᱟᱜ ᱥᱟᱢᱟᱞᱚᱪᱚᱱᱟ ᱟᱨ ᱡᱮᱜᱮᱛᱟᱹᱨᱤ ᱢᱚᱱᱮ ᱥᱟᱶᱟᱨ ᱟᱱᱫᱚᱲ ᱨᱮᱭᱟᱜ ᱮᱛᱚᱦᱚᱵ ᱯᱷᱟᱨᱟᱠ ᱟᱨ ᱥᱤᱢᱟᱹ ᱠᱚ ᱛᱟᱞᱟ ᱨᱮ ᱢᱤᱫ ᱥᱟᱠᱳᱭ ᱵᱮᱱᱟᱣᱟ᱾",
        "ᱜᱩᱨᱩᱪᱚᱨᱚᱱ ᱢᱟᱺᱡᱷᱤ ᱫᱚ ᱟᱡᱟᱜ ᱥᱮᱨᱮᱧ ᱯᱩᱛᱷᱤ ᱠᱚ ᱛᱟᱞᱟ ᱛᱮ ᱥᱟᱱᱛᱟᱲ ᱥᱟᱶᱛᱟ ᱨᱮᱱᱟᱜ ᱟᱭᱢᱟ ᱞᱮᱠᱟᱱ ᱠᱟᱛᱷᱟ, ᱟᱹᱨᱤᱪᱟᱹᱞᱤ, ᱥᱮᱨᱣᱟ ᱟᱨ ᱥᱟᱶᱛᱟᱨᱤ ᱵᱮᱵᱚᱥᱛᱟ ᱠᱚ ᱟᱹᱰᱤ ᱱᱟᱯᱟᱭ ᱛᱮᱭ ᱥᱚᱫᱚᱨ ᱟᱠᱟᱫᱟ ᱾ ᱩᱱᱤ ᱫᱚ ᱑᱙᱘᱒ ᱥᱟᱞᱮ ᱨᱮ ᱪᱟᱭ ᱟᱠᱷᱲᱟ ᱧᱩᱛᱩᱢᱟᱱ ᱢᱤᱫ ᱟᱹᱰᱤ ᱜᱚᱱᱚᱝ ᱟᱱᱟᱜ ᱥᱮᱨᱮᱧ ᱯᱩᱛᱷᱤᱭ ᱯᱟᱨᱥᱟᱞ ᱞᱮᱫᱟ ᱾ ᱱᱚᱶᱟ ᱯᱩᱛᱷᱤ ᱫᱚ ᱥᱟᱱᱛᱟᱲᱤ ᱥᱟᱶᱦᱮᱫ ᱨᱮ ᱟᱹᱰᱤ ᱜᱮ ᱧᱩᱛᱩᱢ ᱮ ᱦᱟᱢᱮᱴ ᱟᱠᱟᱫᱟ ᱾",
        "Morocco dominated through the match against the inexperienced Haitian team that were already eliminated, though Yassine Bounou made a costly own goal in the 10-minute first half. The Moroccan team bounced back and scored four goals throughout, with Haiti's Wilson Isidor scoring a goal though it was not enough as it concluded with their 4–2 defeat.",
        "ᱵᱟᱧᱪᱟᱣ ᱫᱟᱬᱮ: ᱨᱩᱣᱟᱹ ᱦᱟᱹᱥᱩ ᱟᱨ ᱵᱤᱯᱚᱫᱽ ᱠᱷᱚᱱ ᱵᱟᱧᱪᱟᱣ ᱨᱮᱱᱟᱜ ᱫᱟᱲᱮ᱾"
    ]
}
