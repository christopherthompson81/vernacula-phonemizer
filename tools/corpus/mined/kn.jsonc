    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "ಉಪಗ್ರಹ ಚಿತ್ರಗಳ ಅನ್ವೇಷಣೆಯ ನಂತರದಲ್ಲಿ ದಕ್ಷಿಣ ಮತ್ತು ಪೂರ್ವ ಅಟ್ಲಾಂಟಿಕ್ ನಲ್ಲಿ ದಾಖಲಾಗಿರುವ ಉಷ್ಣವಲಯದ ಚಂಡಮಾರುತಗಳಲ್ಲಿ ಫ್ರೆಡ್ ಶಕ್ತಿಶಾಲಿಯಾಗಿದೆ, ಮತ್ತು 35°W ದ ಪೂರ್ವದ ಮೂರನೇ ಮಹಾ ಚಂಡಮಾರುತವಾಗಿ ದಾಖಲಾಗಿದೆ." },
        { "cell": "digit-run", "text": "ಭಯಭೀತರಾದ ಕಿಂಗ್ ಲೂಯಿಸ್ XVI, ರಾಣಿ ಮೇರಿ ಆಂಟೊಯೊನೆಟ್ ಅವರ ಇಬ್ಬರು ಚಿಕ್ಕ ಮಕ್ಕಳು (11 ವರ್ಷದ ಮೇರಿ ಥೆರೆಸ್ ಮತ್ತು ನಾಲ್ಕು ವರ್ಷದ ಲೂಯಿಸ್-ಚಾರ್ಲ್ಸ್) ಮತ್ತು ರಾಜನ ಸಹೋದರಿ ಮೇಡಮ್ ಎಲಿಜಬೆತ್ ಅವರನ್ನು 1789 ರ ಅಕ್ಟೋಬರ್ 6 ರಂದು ಮಾರುಕಟ್ಟೆ ಮಹಿಳೆಯರ ಜನಸಮೂಹದಿಂದ ಪ್ಯಾರಿಸ್‌ಗೆ ವಾಪಸ್ಸು ಕಳುಹಿಸುವಂತೆ ಒತ್ತಾಯಿಸಲಾಯಿತು." },
        { "cell": "digit-run", "text": "ಅಂತಿಮವಾಗಿ, ಮರದ ಚಕ್ರಗಳನ್ನು ಕಬ್ಬಿಣದ ಚಕ್ರಗಳಿಂದ ಬದಲಾಯಿಸಲಾಯಿತು. 1767 ರಲ್ಲಿ, ಮೊದಲ ಪೂರ್ಣ ಕಬ್ಬಿಣದ-ಹಳಿಗಳನ್ನು ಪರಿಚಯಿಸಲಾಯಿತು." },
        { "cell": "digit-run", "text": "ಪೊರ್ಚುಗೀಸರು ಅದನ್ನು ನಿರ್ನಾಮ ಮಾಡಿ ಕಾಸಾ ಬ್ರಾಂಕಾ ಹೆಸರಿನಲ್ಲಿ ಮತ್ತೆ ಕಟ್ಟಿದರಾದರೂ, 1755ರಲ್ಲಿ ನಡೆದ ಭೂಕಂಪದ ನಂತರ ಅದನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ತೊರೆದರು." },
        { "cell": "digit-run", "text": "2008ರಿಂದಲೂ ಆಸ್ಟ್ರೇಲಿಯಾ ಗಣರಾಜ್ಯವಾಗಲು ವಿರೋಧಿಸಿದ 1400 ಜನರಲ್ಲಿ ಶೇಕಡ 8 ಪ್ರತಿಶತದಷ್ಟು ಜನರು 2010ರ ಸಾರ್ವತ್ರಿಕ ಚುನಾವಣೆಗೆ ಮುನ್ನ ಹೆಚ್ಚಾದರು." },
        { "cell": "fractions", "text": "ಇದನ್ನು ಬರೆದವರು ಯಾರು ಎಂಬುದರ ಅರಿವಿಲ್ಲದಿದ್ದರೂ, ನಮಗೆ ತಿಳಿದಂತೆ ಇದನ್ನು ತಯಾರಿಸಿದಂದಿನ ದಿನಗಳಲ್ಲಿ, ಈ ದೊಡ್ಡ ಚರ್ಮಕಾಗದವನ್ನು( ಇದು 29¾ ಇಂಚು X 24½ ಇಂಚು ಅಳತೆಯದಾಗಿದೆ) ಸುರಳಿ ಸುತ್ತಿ ಇಡಲಾಗುತಿತ್ತು." },
        { "cell": "fractions", "text": "ಪ್ಯಾಟರ್ನ್‌ ಸಾಕಷ್ಟು ಆಳವಾಗಿರಬೇಕು, 5 ಮಿ.ಮೀ (1/5 ಇಂಚು) ಅಥವಾ ಹೆಚ್ಚು ಇರಬೇಕು ಮತ್ತು ಶೀತ ವಾತಾವರಣದಲ್ಲಿ ಸಾಮಗ್ರಿಯು ಸಾಕಷ್ಟು ಮೃದುವಾಗಿರಬೇಕು." },
        { "cell": "clock", "text": "10:00-11:00 pm MDT ನಡುವೆ, ಹೊಲದಲ್ಲಿ ಕೈದಿಗೆ ಬೆಂಕಿ ಕಾಣಿಸಿಕೊಂಡಿದೆ." },
        { "cell": "clock", "text": "ಅಂತರ್ ಜಿಲ್ಲಾ ಬಸ್ ನಿಲ್ದಾಣ ದಿಂದ(ನದಿಗೆ ಅಡ್ಡಲಾಗಿ ಇರುವ) ದಿನವಿಡೀ ಬಸ್ಸುಗಳು ನಿರ್ಗಮಿಸುತ್ತವೆ, ಆದರೆ ಪೂರ್ವ ದಿಕ್ಕಿಗೆ ಮತ್ತು ಜಕರ್/ಬಮ್ ಥಾಂಗ್ ಕಡೆಗೆ ಹೋಗುವ ಬಹಳಷ್ಟು ಬಸ್ಸುಗಳು 06:30 ರಿಂದ 07:30 ಒಳಗೆ ಹೊರಡುತ್ತವೆ." },
        { "cell": "clock", "text": "ಬೇಸ್ ಸ್ಟೇಷನ್‍‌ನಲ್ಲಿ ಡ್ಯುಯಲ್ ರೇಡಿಯೋ ಹೊಂದಿದ್ದಲ್ಲಿ, ಇದು 802.11a, 802.11b ಮತ್ತು 802.11g ಗಳೊಂದಿಗೆ ಅದನ್ನು ಹಿಮ್ಮೊಗ ಹೊಂದಾಣಿಕೆಯಾಗಲು ಅವಕಾಶ ಮಾಡಿಕೊಡುತ್ತದೆ." },
        { "cell": "clock", "text": "802.11n ಗುಣಮಟ್ಟದ 2.4Ghz ಮತ್ತು 5.0Ghz ಪುನರಾವರ್ತನೆಯಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ." },
        { "cell": "signs", "text": "ಆತ ಅನೇಕ ದೇಶಗಳಿಗಾಗಿ ನೋಟುಗಳನ್ನು ರಚನೆ ಮಾಡಲು ನಿರತರಾಗಿದ್ದರು, ಆತನ ಇತ್ತೀಚಿನ ಕೆಲಸಗಳ ಉದಾಹರಣೆಗಳೆಂದರೆ ಕೆನಡಾದ $5 ಮತ್ತು $100 ಗಳ ನೋಟುಗಳ ಮೇಲಿರುವ ಪ್ರಧಾನ ಮಂತ್ರಿಯ ಭಾವಚಿತ್ರಗಳು ಸೇರಿವೆ." },
        { "cell": "signs", "text": "ಕೆಫೆನೆಟ್ ಎಲ್ ಸಾಲ್ US$30 ಗಳಿಗೆ ಕಾಯ್ದಿರಿಸುವ ಸೇವೆ ಅಥವಾ $10 ಗಳಿಗೆ 1 ದಿನದ ಪಾಸ್‌ಗಳನ್ನು ಕೊಡುತ್ತದೆ: ವಿವರಗಳು ಅವರ ಕೋರ್ಕೊವಾಡೂ ಪುಟದಲ್ಲಿ ಸಿಗುತ್ತದೆ." },
        { "cell": "signs", "text": "ಮೊದಲ ಸರ್ವೀಸ್‌ನಲ್ಲಿ 76 ಪಾಯಿಂಟ್‌ಗಳಿಂದ ಗೆದ್ದ ಪಂದ್ಯದಲ್ಲಿ ನಡಾಲ್ 88% ನೆಟ್‌ ಪಾಯಿಂಟ್‌ಗಳನ್ನು ಪಡೆದಿದ್ದಾರೆ." },
        { "cell": "signs", "text": "ಅವುಗಳ ಹಣಕಾಸಿನ ನಿರ್ಬಂಧಗಳು ಮತ್ತು ಕಚ್ಚಾ ತೈಲ ರಫ್ತಿಗೆ ಯುರೋಪಿಯನ್ ಒಕ್ಕೂಟದ ನಿಷೇಧವಿದೆ, ಇದರಿಂದ ಇರಾನಿನ ಆರ್ಥಿಕತೆಯು ತನ್ನ ವಿದೇಶಿ ಆದಾಯದ 80% ರಷ್ಟು ಪಾಲನ್ನು ಪಡೆಯುತ್ತಿತ್ತು ಎಂಬುದು ಗಮನಿಸಬೇಕಾದ ಅಂಶ." },
        { "cell": "dotted", "text": "ಸ್ಥಳೀಯ ಸಮಯ ಬೆಳಿಗ್ಗೆ 07:19 ಕ್ಕೆ (09:19 p.m. GMT ಶುಕ್ರವಾರ) ಮರಿಯಾನದಲ್ಲಿ ಭೂ ಕಂಪನವಾಯಿತು." },
        { "cell": "year", "text": "ಉದಾಹರಣೆಗೆ, \"ಕಲಿಕೆ\" ಮತ್ತು \"ಸಾಮಾಜಿಕೀಕರಣ\" ವನ್ನು ಇಂಟರ್ನೆಟ್ ಬಳಕೆಗೆ ಪ್ರಮುಖ ಪ್ರೇರಣೆಗಳಾಗಿ ಸೂಚಿಸಲಾಗಿದೆ (ಜೇಮ್ಸ್ ಎಟ್ ಅಲ್, 1995)." },
        { "cell": "year", "text": "ಉತ್ತರ ಭಾಗ ಅಥವಾ ಸೆಂಟಿನೆಲ್ ಶ್ರೇಣಿಯು ಅಂಟಾರ್ಟಿಕಾದ ಅತಿ ಎತ್ತರದ ಪರ್ವತಗಳಾದ ವಿನ್ಸನ್ ಮಾಸಿಫ್, 4892 ಮೀಟರ್ ಮೌಂಟ್ ವಿನ್ಸನ್‌ನಲ್ಲಿ ಉತ್ತುಂಗಕ್ಕೇರಿತು." },
        { "cell": "year", "text": "ಅವರ 1,000 ನೇ ಅಂಚೆ ಚೀಟಿಯು ಡೇವಿಡ್‌ ಕ್ಲೋಕರ್ ಎಹ್ರೆನ್‌ಸ್ಟರಾಹ್ಲ್‌ರಿಂದ 2000 ರಲ್ಲಿ ಅದ್ಭುತ \"ಸ್ವೀಡಿಶ್‌ ರಾಜರಿಂದ ಉತ್ತಮ ಕೆಲಸಗಳು\" ಎಂಬುದಾಗಿದ್ದು, ಇದನ್ನು ವಿಶ್ವ ದಾಖಲೆಗಳ ಗಿನ್ನೆಸ್ ಪುಸ್ತಕದಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡಲಾಗಿದೆ." },
        { "cell": "year", "text": "1990 ರಲ್ಲಿ, ಮರುಭೂಮಿ ಮರಳಿನ ಬೆದರಿಕೆಯಿಂದಾಗಿ ಈ ಸ್ಥಳವನ್ನು ವಿಶ್ವ ಪರಂಪರೆ ತಾಣಗಳ ಪಟ್ಟಿಗೆ ಸೇರಿಸಲಾಯಿತು." },
        { "cell": "decimals", "text": "ಆ ಪಾರ್ಕು 19,500 ಚದರ ಕಿಮೀ ಸುತ್ತಳತೆ ಹೊಂದಿದ್ದು 14 ಈಕೊಜೋನ್‌ಗಳಾಗಿ ವಿಭಾಗಿಸಲ್ಪಟ್ಟು, ಪ್ರತಿಯೊಂದು ಬೇರೆ ಬೇರೆ ವನ್ಯಜೀವಿಯನ್ನು ಸಲಹುತ್ತದೆ." },
        { "cell": "decimals", "text": "ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್ ಆಫ್ ಅಮೇರಿಕಾದಲ್ಲಿ, ಮಲ್ಟಿಪಲ್ ಸ್ಕ್ಲೆರೋಸಿಸ್ (MS) ನ ಸುಮಾರು 400,000 ಪ್ರಕರಣಗಳಿವೆ, ಇದು ಕಿರಿಯ ಮತ್ತು ಮಧ್ಯವಯಸ್ಕರಲ್ಲಿ ಪ್ರಮುಖ ನರವೈಜ್ಞಾನಿಕ ಕಾಯಿಲೆಯಾಗಿದೆ." },
        { "cell": "decimals", "text": "ಜಪಾನ್ ಸುಮಾರು 7,000 ದ್ವೀಪಗಳನ್ನು ಹೊಂದಿದ್ದು (ಹೊನ್ಶು ಅತಿ ದೊಡ್ಡದು) ವಿಶ್ವದ 7ನೇ ಅತಿದೊಡ್ಡ ದ್ವೀಪ ಹೊಂದಿರುವ ರಾಷ್ಟ್ರವಾಗಿದೆ!" },
        { "cell": "decimals", "text": "ಸುಂದರಬನ್ಸ್ 1966 ರಿಂದ ವನ್ಯಜೀವಿ ಅಭಯಾರಣ್ಯವಾಗಿದೆ, ಮತ್ತು ಈ ಪ್ರದೇಶದಲ್ಲಿ ಈಗ 400 ರಾಯಲ್ ಬಂಗಾಳ ಹುಲಿಗಳು ಮತ್ತು ಸುಮಾರು 30,000 ಚುಕ್ಕೆ ಜಿಂಕೆಗಳಿವೆ ಎಂದು ಅಂದಾಜಿಸಲಾಗಿದೆ." },
        { "cell": "units", "text": "ಸುಂದರಬನ್ಸ್ 3,850 km² ವಿಸ್ತೀರ್ಣಯನ್ನು ಹೊಂದಿದೆ, ಅದರಲ್ಲಿ ಮೂರನೇ- 1 ಭಾಗದಷ್ಟು ಪ್ರದೇಶ ನೀರು/ಕೆಸರುಗಳಿಂದ ಆವರಿಸಿದೆ." },
        { "cell": "units", "text": "ಹಲವಾರು ವರ್ಷಗಳಿಂದ ಹಲವು ವಿನ್ಯಾಸದ ಫಿಲ್ಮ್‌ಗಳನ್ನು ಬಳಸಲಾಗಿದೆ. ಅದರಲ್ಲಿ ಸ್ಟ್ಯಾಂಡರ್ಡ್ 35 mm ಫಿಲ್ಮ್ ( 36 by 24 mm ನೆಗೆಟಿವ್) ಬಹಳ ಬಳಸಲಾಗುವಂತದ್ದು." },
        { "cell": "ranges", "text": "ಎರಡನೇ ಸೆಟ್‌ನಲ್ಲಿ ಡೆಲ್ ಪೊಟ್ರೊ ಆರಂಭಿಕ ಲಾಭವನ್ನು ಪಡೆದಿದ್ದರು, ಆದರೆ 6-6 ತಲುಪಿದ ನಂತರ ಟೈ ವಿರಾಮ ಬೇಕಾಯಿತು." },
        { "cell": "ranges", "text": "ಘಟನೆಗಳು ನಡೆದ ಯುಗವನ್ನು ಸಾಮಾನ್ಯವಾಗಿ 11, 12 ಮತ್ತು 13ನೇ ಶತಮಾನಗಳಲ್ಲಿ (ಕ್ರಿ.ಶ. 1000–1300) ಯುರೋಪಿಯನ್ ಇತಿಹಾಸದ ಅವಧಿಯ ಅಧಿಕ ಮಧ್ಯಯುಗ ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ." },
        { "cell": "ranges", "text": "ನಿದ್ರೆಯ ಅಡಚಣೆ ಎಂದರೆ ಸಾಮಾನ್ಯ ನಿದ್ರೆಯ ಸಮಯದಲ್ಲಿ ಪ್ರಜ್ಞಾಪೂರ್ವಕವಾಗಿ ಎಚ್ಚರಗೊಂಡು ನಂತರ ಅಲ್ಪಾವಧಿಯಲ್ಲಿಯೇ (10-60 ನಿಮಿಷಗಳು) ನಿದ್ರಿಸುವುದು." },
        { "cell": "ranges", "text": "ಸುಂಟರಗಾಳಿಯು ಜೋರು ಗಾಳಿಯನ್ನು( ಹೆಚ್ಚು ಕಡಿಮೆ 100-200 ಮೈಲಿ ಪ್ರತಿ ಗಂಟೆ) ಉಂಟು ಮಾಡುತ್ತವೆ ಮತ್ತು ಅವು ಭಾರದ ವಸ್ತುಗಳನ್ನು ಗಾಳಿಯಲ್ಲಿ ಎತ್ತಿ ತನ್ನೊಂದಿಗೆ ಕೊಂಡು ಸಾಗುತ್ತದೆ." },
        { "cell": "currency", "text": "2008ರ 400 ಶ್ರೀಮಂತ ಅಮೆರಿಕನ್ನರ ಪಟ್ಟಿಯಲ್ಲಿ ಬ್ಯಾಟನ್ 190 ನೇ ಸ್ಥಾನದಲ್ಲಿದ್ದರು, ಇವರ ಅಂದಾಜು ಆಸ್ತಿ ಮೌಲ್ಯ $ 2.3 ಶತಕೋಟಿ." },
        { "cell": "currency", "text": "ಮಸೂದೆಯಲ್ಲಿ ಕ್ಯಾಲಿಫೋರ್ನಿಯಾದಲ್ಲಿ ಮಾರಾಟವಾಗುವ ಹಿಂಸಾತ್ಮಕ ವಿಡಿಯೋ ಗೇಮ್‌ಗಳನ್ನು \"18\" ಎಂಬ ಪದದೊಂದಿಗೆ ಲೇಬಲ್ ಮಾಡುವುದು ಮತ್ತು ಪ್ರತಿ ಅಪರಾಧಕ್ಕೂ ವೀಡಿಯೊ ಗೇಮ್‌ಗಳನ್ನು ಅಪ್ರಾಪ್ತ ವಯಸ್ಕರಿಗೆ $ 1,000 ದಂಡದೊಂದಿಗೆ ಮಾರಾಟ ಮಾಡುವುದು ಅಗತ್ಯವಾಗಿರುತ್ತದೆ." },
        { "cell": "currency", "text": "250 ವರ್ಷಗಳ ನಂತರ, ಗಿನ್ನೆಸ್ ಒಂದು ಜಾಗತಿಕ ವ್ಯವಹಾರವಾಗಿ ಬೆಳೆದಿದೆ, ಅದು ಪ್ರತಿ ವರ್ಷ 10 ಬಿಲಿಯನ್ ಯುರೋಗಳಷ್ಟು (US$ 14.7 ಬಿಲಿಯನ್) ವಹಿವಾಟು ನಡೆಸುತ್ತದೆ." },
        { "cell": "abbrev", "text": "ಯು.ಎಸ್ ನ. ಅಭಿಯಂತರದಳವು 6 ಇಂಚುಗಳಷ್ಟು ಮಳೆಯು ಹಿಂದೆ ಹಾನಿಗೊಳಗಾದ ಮಟ್ಟವನ್ನು ಉಲ್ಲಂಘಿಸಬಹುದು ಎಂದು ಅಂದಾಜಿಸಿದೆ." },
        { "cell": "latin-in-native", "text": "ಈ ಮುಂಚೆ, ಜೇಮೀ ಸಿಮಿನಾಫ್, ರಿಂಗ್ ಕಂಪನಿಯ CEO, ಅವನ ಮನೆಯ ಡೋರ್‌ಬೆಲ್ ಅವನ ಗ್ಯಾರೇಜಿನಲ್ಲಿ ಇದ್ದ ಅಂಗಡಿಯ ತನಕ ಕೇಳದೇ ಹೋದಾಗ ಅವನು ಈ ಕಂಪನಿ ಶುರು ಮಾಡಿದ ಎಂದು ವಿವರಿಸಿದ್ದ." },
        { "cell": "latin-in-native", "text": "NHK ವರದಿ ಮಾಡಿದಂತೆ, ನಿಗಾಟಾ ಪ್ರಾಂತ್ಯದಲ್ಲಿರುವ ಕಾಸಿವಾಜಾಕಿ ಕರಿವಾ ಪರಮಾಣು ವಿದ್ಯುತ್ ಸ್ಥಾವರ ಎಂದಿನಂತೆ ಕಾರ್ಯ ನಿರ್ವಹಿಸುತ್ತಿದೆ." },
        { "cell": "latin-in-native", "text": "ಇದು ನಾಲ್ಕು ವರ್ಷಗಳಲ್ಲಿ ಮಾರ್ಟೆಲಿಯ ಐದನೇ CEP ಆಗಿದೆ." },
        { "cell": "latin-in-native", "text": "NPWS ಮತ್ತು ಸ್ಪೋರ್ಟಿಂಗ್ ಶೂಟರ್ಸ್ ಅಸೋಸಿಯೇಶನ್ ಆಫ್ ಆಸ್ಟ್ರೇಲಿಯಾ (NSW) ಇಂಕ್‌ನ ಸಹಭಾಗಿತ್ವದಲ್ಲಿ, ಸ್ಪೋರ್ಟಿಂಗ್ ಶೂಟರ್ ಅಸೋಸಿಯೇಶನ್‌ನ ಹಂಟಿಂಗ್ ಕಾರ್ಯಕ್ರಮದಡಿಯಲ್ಲಿ ಅರ್ಹ ಸ್ವಯಂಸೇವಕರನ್ನು ನೇಮಕ ಮಾಡಿಕೊಳ್ಳಲಾಯಿತು." },
        { "cell": "percent", "text": "ಯುರೋಪಿಯನ್ ಟರ್ಕಿ (ಬಾಲ್ಕನ್ ಪರ್ಯಾಯ ದ್ವೀಪದಲ್ಲಿ ಪೂರ್ವ ಥ್ರೇಸ್ ಅಥವಾ ರುಮೆಲಿಯಾ) ದೇಶದ 3% ರಷ್ಟು ಭಾಗವನ್ನು ಒಳಗೊಂಡಿದೆ." },
        { "cell": "percent", "text": "ಯುರೋಪ್ ಮತ್ತು ಬ್ರಾಡ್ ಬ್ಯಾಂಡ್ ಉಪಗ್ರಹಗಳ ನಡುವಿನ ಫೈಬರ್ ಆಪ್ಟಿಕ್ ಕೇಬಲ್ ಸಂಪರ್ಕದಿಂದ, ಗ್ರೀನ್ ಲ್ಯಾಂಡ್ ನ 93% ನಷ್ಟು ಜನತೆ ಅಂತರ್ಜಾಲ ಸಂಪರ್ಕ ಹೊಂದಿದ್ದು ಗ್ರೀನ್ ಲ್ಯಾಂಡ್ ಉತ್ತಮ ಸಂಪರ್ಕ ಜಾಲ ಹೊಂದಿದೆ." },
        { "cell": "rate", "text": "ಉದ್ಯಾನವನದ ಅಧಿಕಾರಿಗಳ ಪ್ರಕಾರ, ಕರಡಿಗಳು ಮತ್ತು ತೋಳಗಳಿಂದ ಕನಿಷ್ಠ 100 ಗಜ/ಮೀಟರ್ ದೂರದಲ್ಲಿರಬೇಕು ಮತ್ತು ಇತರ ಎಲ್ಲಾ ಕಾಡು ಪ್ರಾಣಿಗಳಿಂದ 25 ಗಜ/ಮೀಟರ್ ದೂರದಲ್ಲಿರಬೇಕು!" },
        { "cell": "rate", "text": "802.11n ವೇಗವು ಅದರ ಹಿಂದಿನ ಉತ್ಪನ್ನಗಳಿಗಿಂತ ಹೆಚ್ಚು ವೇಗವಾಗಿರುತ್ತದೆ, ಗರಿಷ್ಠ ಸೈದ್ಧಾಂತಿಕ ಥ್ರೋಪುಟ್ 600Mbit/s ಆಗಿದೆ." },
        { "cell": "zero-width", "text": "ಈ ಸೀಸನ್‌ನಲ್ಲಿನ ರೋಗದ ಮೊದಲ ಪ್ರಕರಣವು ಜುಲೈ ಕೊನೆಯಲ್ಲಿ ವರದಿಯಾಯಿತು." },
        { "cell": "zero-width", "text": "ಎಬೋಲಾ ವೈರಸ್‌ನ ಕೆಲವು ಪ್ರಕರಣಗಳು ಕಂಡುಬಂದಿರುವ ನೈಜೀರಿಯಾಗೆ ರೋಗಿ ಪ್ರಯಾಣಿಸಿದ್ದರು." },
        { "cell": "zero-width", "text": "ನ್ಯೂ ಕಿಂಗ್‌ಡಮ್‌ ಪುರಾತನ ಈಜಿಪ್ಶಿಯನ್ನರು ತಮ್ಮ ಹಿಂದಿನವರ ಪ್ರತಿಮೆಗಳಿಂದ ಅಚ್ಚರಿಗೊಳಗಾದರು, ಇವು ಸಾವಿರ ವರ್ಷ ಹಿಂದಿನದಾಗಿದ್ದವು." },
        { "cell": "zero-width", "text": "ಚರ್ಚ್ ಯಾರ್ಡ್‍ನಲ್ಲಿ, ಗೋರಿಗಳ ಮೇಲೆ ಪಾರಿವಾಳಗಳ ಆಕರ್ಷಕವಾದ ಮಾರ್ಬಲ್ ಶಿಲ್ಪಗಳಿವೆ." },
        { "cell": "roman", "text": "ಮಾವ್ ಆಂದೋಲನವು ಆಯೋಜಿಸಿದ್ದ ಸ್ವತಂತ್ರ ಸಂಗ್ರಾಮದ ಹೋರಾಟದಲ್ಲಿ, ಪಟ್ಟಣದಲ್ಲಿನ ಒಂದು ಶಾಂತಿಯುತ ಮೆರವಣಿಗೆ ಸರ್ವಶ್ರೇಷ್ಠ ಮುಖ್ಯಸ್ಥ ಟುಪುವಾ ತಮಾಸೆಸೆ ಲಿಯಾ ಲೋಫಿ III ಇವರ ಹತ್ಯೆಗೆ ಕಾರಣ ವಾಯಿತು." },
        { "cell": "roman", "text": "ಅಕ್ಟೋಬರ್ 7ರಂದು, ಟೇಕಾಫ್ ನಂತರ ಒಂದು ಇಂಜಿನ್ ಯಾವುದೇ ಹಾನಿಗೊಳಗಾಗದೇ ಕಳಚಿಕೊಂಡಿತು. ಈ ಅಫಘಾತದ ನಂತರ ರಷ್ಯಾ II-76s ಅನ್ನು ಸ್ವಲ್ಪ ದಿನಗಳ ಕಾಲ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿತು.." },
        { "cell": "roman", "text": "ವಿಶ್ವಯುದ್ಧ I ಮತ್ತು ವಿಶ್ವಯುದ್ಧ II ರಲ್ಲಿ ಸಬ್‌ಮರೀನ್‌ಗಳನ್ನು ಬಳಸಲಾಯಿತು. ಆಗ ಅವು ತುಂಬಾ ನಿಧಾನವಾಗಿದ್ದವು ಮತ್ತು ಸೀಮಿತ ಶೂಟಿಂಗ್‌ ಶ್ರೇಣಿಯನ್ನು ಹೊಂದಿದ್ದವು." },
        { "cell": "roman", "text": "ರಾಣಿ ಎಲಿಜಬೆತ್ II ರ ಆಳ್ವಿಕೆಯ ಕೊನೆಯಲ್ಲಿ ಆಸ್ಟ್ರೇಲಿಯಾ ಗಣರಾಜ್ಯವಾಗುತ್ತದೆ ಎಂದು ನಾನು ನಂಬಿದ್ದೆ ಎಂದು ಉಸ್ತುವಾರಿ ಪ್ರಧಾನಿ ಜೂಲಿಯಾ ಗಿಲ್ಲಾರ್ಡ್ 2010 ರ ಫೆಡರಲ್ ಚುನಾವಣೆಯ ಪ್ರಚಾರದ ಸಮಯದಲ್ಲಿ ಹೇಳಿದ್ದಾರೆ." },
        { "cell": "initialism", "text": "ಹಣ ವಿನಿಮಯ, ಈ ದ್ವೀಪದ FIC ವೆಸ್ಟ್ ಅಂಗಡಿಯ ಎದುರು ಸ್ಟ್ಯಾನ್ಲೆ ಯಲ್ಲಿ ಇರುವ ಏಕೈಕ ಬ್ಯಾಂಕಿನಲ್ಲಿ ಮಾಡಬಹುದಾಗಿದೆ." },
        { "cell": "initialism", "text": "ಅನೇಕ ಸಾಮಾನ್ಯ ಸ್ವರೂಪಗಳು (APS ಸರಣಿ ಸ್ವರೂಪಗಳು) ಈ ಆಕಾರ ಅನುಪಾತಕ್ಕೆ ಸಮಾನ ಅಥವಾ ಅಂದಾಜು." },
        { "cell": "initialism", "text": "AI ನಲ್ಲಿನ ಸಂಶೋಧನೆಯು ಬುದ್ಧಿವಂತ ನಡವಳಿಕೆಯ ಅಗತ್ಯವಿರುವ ಕಾರ್ಯಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸಲು ಯಂತ್ರಗಳನ್ನು ತಯಾರಿಸುವುದನ್ನು ಒಳಗೊಂಡಿರುತ್ತದೆ." },
        { "cell": "initialism", "text": "ASUS Eee PC ಅನ್ನು, ವೆಚ್ಚದಲ್ಲಿ ಕಡಿತ ಹಾಗೂ ಕ್ರಿಯಾತ್ಮಕ ಅಂಶಗಳಿಗಾಗಿ ಈ ಹಿಂದೆ ಪ್ರಪಂಚಾದ್ಯಂತ ಹೊರತರಲಾಯಿತು, ಮತ್ತೆ ಇದು 2007 ರಲ್ಲಿ ತೈಪೆ ಐಟಿ ಮಂತ್ ನ ಬಿಸಿಬಿಸಿ ಸುದ್ದಿಯಾಯಿತು." },
        { "cell": "grouped", "text": "ಅಪಿಯಾ ಸಮೋವಾದ ರಾಜಧಾನಿಯಾಗಿದೆ. ಈ ಪಟ್ಟಣವು ಉಪೋಲು ದ್ವೀಪದಲ್ಲಿದ್ದು 40,000 ಕ್ಕಿಂತಲೂ ಕಡಿಮೆ ಜನಸಂಖ್ಯೆಯನ್ನು ಹೊಂದಿದೆ." },
        { "cell": "grouped", "text": "ಅದ್ಯಾಗೂ, ಕ್ಷಯರೋಗ ಹೂಂದಿದ್ದ ಆ ಇಡೀ ಗುಂಪಿನ ಜನರಲ್ಲಿನ XDR-TBಯ ಶೇಕಡಾವಾರು ಪ್ರಮಾಣ ಇನ್ನೂ ಬಹಳ ಕಡಿಮೆ ಇರುವಂತಿದೆ; ಒಂದು ನಿರ್ದಿಷ್ಟ ಅವಧಿಯಲ್ಲಿ, ದಕ್ಷಿಣ ಆಫ್ರಿಕಾದಲ್ಲಿ ಒಟ್ಟು 330,000 ಜನರಲ್ಲಿ 6000 ಜನರು ಸೋಂಕಿತರಾಗಿರುತ್ತಾರೆ." },
        { "cell": "grouped", "text": "ಆಡುಗಳನ್ನು, ಸುಮಾರು 10,000 ವರ್ಷಗಳ ಹಿಂದೆ ಇರಾನ್ ನ ಝಾಗ್ರೋಸ್ ಮೌಂಟೇನ್ ನಲ್ಲಿ ಮೊದಲ ಬಾರಿಗೆ ಸಾಕಲು ಪಳಗಿಸಲಾಯಿತು ಎಂದು ತಿಳಿದು ಬರುತ್ತದೆ." },
        { "cell": "grouped", "text": "ಭೂಮಿಯಲ್ಲಿ ವಿರಳವಾಗಿರುವ ಈ ಬಂಡೆಕಲ್ಲುಗಳಲ್ಲಿ ಕೆಲವನ್ನು ಪ್ರತಿ ಔನ್ಸ್‌ಗೆ 11,000 ದಿಂದ 22,500 ಅಮೇರಿಕದ ಡಾಲರುಗಳಂತೆ ಮಾರಲಾಗುತ್ತಿದ್ದು, ಇದು ಚಿನ್ನದ ಬೆಲೆಗಿಂತ ಸುಮಾರು ಹತ್ತು ಪಟ್ಟು ಹಚ್ಚ್ಚಾಗಿರುತ್ತದೆ." },
        { "cell": "signed-number", "text": "ಈ ಪಂದ್ಯಾವಳಿಯ ಅಗ್ರ ಶ್ರೇಯಾಂಕದ ಸೌತ್ ಆಫ್ರಿಕಾ, 5ನೇ ಶ್ರೇಯಾಂಕಿತ ಜಾಂಬಿಯಾ ವಿರುದ್ದ 26 -00 ಅಂತರದಿಂದ ಗೆಲುವು ಸಾಧಿಸಿ ಅಗ್ರಸ್ಥಾನವನ್ನು ಪಡೆದುಕೊಂಡಿತು." },
        { "cell": "signed-number", "text": "ಇಂದು ರಾತ್ರಿಯ ಆತನ ಎರಡನೆಯ ಗೋಲ್ ಈ ಸೀಸನ್ ನ 60ನೆಯದು, ಅಲ್ಲದೇ 1995 -96 ರಲ್ಲಿ ಜರೋಮಿರ್ ಜಾಗರ್ ಹಾಗೂ ಮಾರಿಯೋ ಲೆಮಿಯಕ್ಸ್ ಈ ಮೈಲಿಗಲ್ಲನ್ನು ತಲುಪಿದ ನಂತರ 60 ಅಥವಾ ಅದಕ್ಕೂ ಹೆಚ್ಚು ಗೋಲುಗಳನ್ನು ಮಾಡಿದ ಮೊದಲ ಆಟಗಾರ ಎಂಬ ಹೆಗ್ಗಳಿಕೆಗೆ ಇವರು ಪಾತ್ರರಾಗಿದ್ದಾರೆ." },
        { "cell": "signed-number", "text": "ಉಟಾಹ್ ನ ಜಾಸ್ ಆಟಗಾರನ ಕೋವಿಡ್-19 ವೈರಸ್‍‌ ಟೆಸ್ಟ್ ಪಾಸಿಟೀವ್ ಬಂದಿದ್ದರ ಹಿಂದೆಯೇ NBAಯ ನಿರ್ಣಯ ಹೊರಬಂದಿತು." },
        { "cell": "signed-number", "text": "ಪ್ರತಿಭಟನೆಯು, ಡೌನಿಂಗ್ ಸ್ಟ್ರೀಟ್ ನಲ್ಲಿರುವ ಪೊಲೀಸರಿಂದ ಕಾಯಲ್ಪಟ್ಟಿರುವ ಪ್ರಧಾನ ಮಂತ್ರಿಯ ಅಧಿಕೃತ ನಿವಾಸದ ಎದುರಿರುವ ವೈಟ್ ಹಾಲ್ ನಲ್ಲಿ ಸ್ಥಳೀಯ ಸಮಯ 11:00(UTC +1)ಕ್ಕೆ ಶುರುವಾಯಿತು." },
        { "cell": "letter-name", "text": "ಪರೀಕ್ಷಿಸಿದ ರಾಸಾಯನದಲ್ಲಿರುವ ಹೈಡ್ರೋಜನ್ ( pHನಲ್ಲಿನ H ) ಐಯಾನುಗಳ ಪ್ರಮಾಣದಿಂದ pH ಪ್ರಮಾಣವನ್ನು ಸೂಚಿಸಲಾಗುತ್ತದೆ." },
        { "cell": "letter-name", "text": "ಫುಟ್ಬಾಲ್, ಬಾಸ್ಕೆಟ್‌ಬಾಲ್, ವಾಲಿಬಾಲ್, ವಾಟರ್-ಪೋಲೊ, ಫೆನ್ಸಿಂಗ್, ರಗ್ಬಿ, ಸೈಕ್ಲಿಂಗ್, ಐಸ್ ಹಾಕಿ, ರೋಲರ್ ಹಾಕಿ ಮತ್ತು F1 ಮೋಟಾರ್ ರೇಸಿಂಗ್ ಜನಪ್ರಿಯ ಕ್ರೀಡೆಗಳಲ್ಲಿ ಸೇರಿವೆ." },
        { "cell": "letter-name", "text": "A1GP ನ್ಯೂಜಿಲೆಂಡ್ ತಂಡದ ಸಹ-ಚಾಲಕ ಜಾನಿ ರೀಡ್ ಅವರು ಇಂದು ಕಾನೂನುಬದ್ಧವಾಗಿ ನ್ಯೂಜಿಲೆಂಡ್‌ನ 48 ವರ್ಷದ ಆಕ್ಲೆಂಡ್ ಹಾರ್ಬರ್ ಸೇತುವೆಯ ಮೇಲೆ ವೇಗವಾಗಿ ಓಡಿಸುವ ಮೂಲಕ ಇತಿಹಾಸ ನಿರ್ಮಿಸಿದ್ದಾರೆ." },
        { "cell": "letter-name", "text": "ಟರ್ಕಿಯ ಮಕ್ಕಳು ಈಗ ಅನಾರೋಗ್ಯಕ್ಕೆ ಒಳಗಾಗದೆ A(H5N1ಏವಿಯನ್ ಇನ್ಫ್ಲುಯೆನ್ಸ ವೈರಸ್ ಸೋಂಕಿಗೆ ಒಳಗಾಗಿದ್ದಾರೆ ಎಂದು ಡಾ. ಲೀ ಅವರ ವರದಿಗಳ ಬಗ್ಗೆ ತಮ್ಮ ಕಳವಳವನ್ನು ವ್ಯಕ್ತಪಡಿಸಿದರು." },
        { "cell": "sports-time", "text": "ಆಕೆಯ ಇನ್ನೊಂದು ಸ್ಪರ್ಧೆ, ದ ಜೇಂಟ್ ಸ್ಲಾಲೋಮ್, ಮಹಿಳೆಯರ ಸಿಟ್ಟಿಂಗ್ ಗುಂಪಿನಲ್ಲಿ ಹತ್ತನೇ ಸ್ಥಾನದಲ್ಲಿ ಓಟದ ಸಮಯ 4:41.30 ದೊಂದಿಗೆ ಮುಗಿಸಿದಳು, ಇದು ಪ್ರಥಮ ಸ್ಥಾನ ಪಡೆದ ಆಸ್ಟ್ರಿಯನ್ ಕ್ಲೌಡಿಯಾ ಲೊಶ್ಗಿಂತ 2:11.60 ನಿಮಿಷಗಳಷ್ಟು ನಿಧಾನ ಹಾಗೂ ಒಂಬತ್ತನೇ ಸ್ಥಾನದಲ್ಲಿ ಮುಗಿಸಿದ ಹಂಗೇರಿಯಾದ ಜ್ಯಾಂಗಿ ಡ್ಯಾನಿಕ್ಕಿಂತ 1:09.02 ನಿಮಿಷ ನಿಧಾನವಾಗಿದೆ." },
        { "cell": "version-dot", "text": "ಇಜ್ಮಿರ್ ಟರ್ಕಿಯಲ್ಲಿನ ಮೂರನೆ ಅತಿದೊಡ್ಡ ನಗರವಾಗಿದ್ದು ಅದರ ಒಟ್ಟು ಜನಸಂಖ್ಯೆಯು ಸರಿಸುಮಾರು 3.7ದಶಲಕ್ಷ, ಹಾಗೆಯೇ ಇಸ್ತಾಂಬುಲ್ ನಂತರ ಎರಡನೆ ಅತಿದೊಡ್ಡ ಬಂದರಾಗಿದ್ದು ಅತ್ಯುತ್ತಮವಾದ ಸಾಗಣೆ ತಾಣ ಕೂಡಾ ಆಗಿದೆ." },
        { "cell": "quote-letter", "text": "ಕೀಟಶಾಸ್ತ್ರಜ್ಞರು 'ಬಗ್' ಎಂಬ ಹೆಸರನ್ನು ಶಾಸ್ತ್ರೋಕ್ತ ವಾಗಿ ಕೀಟಗಳ ಈ ಗುಂಪಿಗೆ ಬಳಸುತ್ತಾರೆ." },
        { "cell": "quote-letter", "text": "ಒಂದು ನೈಜ \"ಅಗೋಚರ ತಂಡ'ದ ಉಪಸ್ಥಿತಿ (ಲಾರ್ಸನ್ ಮತ್ತು ಲಾಫಾಸ್ಟೋ, 1989, p109) ಕೂಡ ಒಂದು ಅಗೋಚರ ತಂಡದ ವಿಶಿಷ್ಟತೆಯಾಗಿದೆ." },
        { "cell": "quote-letter", "text": "ಬೆಳಿಗ್ಗೆ 10.00 ಗಂಟೆಗೆ ಉತ್ತಮ ಹವಾಮಾನದೊಂದಿಗೆ ಪಂದ್ಯಗಳು ಶುರುವಾದವು ಹಾಗು ಪೂರ್ವಾಹ್ನದಲ್ಲಿ ಶುರುವಾದ ಹನಿಮಳೆ ಬಹಳ ಬೇಗ ನಿಲ್ಲುವುದರೊಂದಿಗೆ 7's ರಗ್ಬಿ ಗೆ ಉತ್ತಮ ದಿನವಾಗಿದೆ" },
        { "cell": "quote-letter", "text": "NPWSನ ಪಾರ್ಕ್ ಕನ್ಸರ್ವೇಷನ್ ಅಂಡ್ ಹೆರಿಟೇಜ್‍‌ನ ಪ್ರಭಾರ ನಿರ್ದೇಶಕ ಮೈಕ್ ಓ'ಪ್ಲೈನ್ ಅವರ ಪ್ರಕಾರ, ಮೊದಲ ಶೂಟಿಂಗ್ ಕಾರ್ಯಾಚರಣೆಗೆ ಆಯ್ಕೆಯಾದ ೪ ಶೂಟರ್ಗಳಿಗೆ ಸಮಗ್ರ ಸುರಕ್ಷತೆ ಮತ್ತು ತರಬೇತಿ ನೀಡಲಾಯಿತು." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "ಇಟಾಲಿಯನ್ ಭಾಷೆಯಲ್ಲಿ ಉಚ್ಚಾರಣೆಯು ತುಲನಾತ್ಮಕವಾಗಿ ಸುಲಭವಾಗಿದೆ ಏಕೆಂದರೆ ಹೆಚ್ಚಿನ ಪದಗಳನ್ನು ಅವುಗಳನ್ನು ಬರೆಯಲಾಗುವ ರೂಪದಲ್ಲೇ ಉಚ್ಚರಿಸಲಾಗುತ್ತದೆ.",
        "ಮುಕ್ತ ಚರ್ಚೆಯ ಮನವಿ ಮತ್ತು ಮಧ್ಯಪ್ರಾಚ್ಯದ ಬಗೆಗಿನ ನೀತಿಯ ಬಗ್ಗೆ ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್‌ನಲ್ಲಿ ಒಮ್ಮತದ ರಚನೆಯ ಕುರಿತಾಗಿ ಈ ವರದಿಯಲ್ಲಿ ತಿಳಿಸಲಾಗಿದೆ.",
        "ಫಿಲಿಪೈನ್ಸ್‌ನ ರಾಜಧಾನಿಯಾದ ಮನಿಲಾದಲ್ಲಿ ಅಲ್ಲಿನ ಓರ್ವ ಮಾಜಿ ಪೋಲೀಸ್ ಅಧಿಕಾರಿ ಹಾಂಗ್‌‌ಕಾಂಗ್ ಪ್ರವಾಸಿಗರ ಬಸ್ಸನ್ನು ಅಪಹರಿಸಿ ಅವರನ್ನು ಒತ್ತೆಯಾಳುಗಳನ್ನಾಗಿ ಇರಿಸಿಕೊಂಡಿದ್ದಾರೆ.",
        "ಆಗಸ್ಟ್ 15, 1940 ರಂದು, ಮಿತ್ರರಾಷ್ಟ್ರಗಳು ದಕ್ಷಿಣ ಫ್ರಾನ್ಸ್ ಮೇಲೆ ಆಕ್ರಮಣ ಮಾಡಿದವು, ಈ ಆಕ್ರಮಣವನ್ನು \"ಆಪರೇಷನ್ ಡ್ರಾಗನ್\" ಎಂದು ಕರೆಯಲಾಯಿತು.",
        "ಹಾಟ್ ಚಾಕೊಲೇಟ್ ಬೆಲ್ಜಿಯಂ ನ ಉತ್ಕೃಷ್ಟ ಗುಣಮಟ್ಟಕ್ಕೆ ಸರಿಸಾಟಿ ಯಾಗಿದೆ. ಹಣ್ಣಿನ ರಸ ಬಹಳ ದುಬಾರಿ ಅನಿಸಿದರೂ ಶ್ರೇಷ್ಠ ವಾಗಿದೆ.",
        "ಸಂತ ಪೀಟರ್ಸ್‌ಬರ್ಗ್‍ನ ನೌಕಾಯಾನ ವಿಹಾರದಲ್ಲಿ ನಗರದಲ್ಲಿ ಕಳೆದ ಸಮಯವೂ ಸೇರುತ್ತದೆ. ನೌಕಾ ವಿಹಾರದ ಪ್ರಯಾಣಿಕರು ವೀಸಾ ಹೊಂದಿರಬೇಕೆಂದಿಲ್ಲ (ನಿಯಮಗಳನ್ನು ನೋಡಿ).",
        "ಆತನು ತನ್ನ ನೋವನ್ನು ನಿವಾರಿಸಿಕೊಳ್ಳಲು ಅಗತ್ಯವಾದ ಔಷಧಿಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ ಏಕೆಂದರೆ ಅವುಗಳನ್ನು ಆಟದಿಂದ ನಿರ್ಬಂಧಿಸಲಾಗಿತ್ತು.",
        "ಈಸ್ಟರ್ ವಾರಾಂತ್ಯದಲ್ಲಿ ಹೆಚ್ಚಿನ ಸಾಂಪ್ರದಾಯಿಕ ಚರ್ಚುಗಳು ಶನಿವಾರ ರಾತ್ರಿ ಈಸ್ಟರ್ ವಿಜಿಲ್ ಅನ್ನು ನಡೆಸುತ್ತವೆ, ಕ್ರಿಸ್ತನ ಪುನರುತ್ಥಾನವನ್ನು ಆಚರಿಸುವ ಸಭೆಗಳು ಮಧ್ಯರಾತ್ರಿಯ ವೇಳೆಗೆ ಸಂಭ್ರಮಾಚರಣೆಗೆ ಬದಲಾಗುತ್ತವೆ.",
        "ಸೇತುವೆಯ ಕೆಳಗಿನ ಎತ್ತರ ತೆರವು 15 ಮೀಟರ್. ಇದರ ನಿರ್ಮಾಣವು ಆಗಸ್ಟ್ 2011 ರಲ್ಲಿ ಪೂರ್ಣಗೊಂಡಿತು, ಮಾರ್ಚ್ 2017 ರವರೆಗೂ ಇದು ಸಂಚಾರಕ್ಕೆ ಮುಕ್ತವಾಗಲಿಲ್ಲ.",
        "ಈಗ ಜಪಾನ್‌ಗೆ. ಬ್ರಿಟನ್‌ನಂತೆಯೇ ಜಪಾನ್ ಒಂದು ದ್ವೀಪ ದೇಶವಾಗಿದೆ.",
        "ವೃತ್ತಿಪರ ಸೇವೆಗಳು, ಸರ್ಕಾರ, ಹಣಕಾಸು, ವ್ಯಾಪಾರೋದ್ಯಮ ಮತ್ತು ಪ್ರವಾಸೋದ್ಯಮವು ಅತಿದೊಡ್ಡ ಉದ್ಯೋಗ ಕ್ಷೇತ್ರಗಳಾಗಿವೆ.",
        "ಇನ್ನೊಬ್ಬ ಜನಪ್ರಿಯ ಗ್ರೀಕ್‌ ವ್ಯಕ್ತಿಯೆಂದರೆ ಗಣಿತತಜ್ಞ ಪೈಥಾಗೊರಸ್‌, ಬಲ ತ್ರಿಕೋನಗಳ ಬದಿಯ ಸಂಬಂಧಗಳ ಬಗ್ಗೆ ಜನಪ್ರಿಯ ಪ್ರಮೇಯದಿಂದಾಗಿ ಹೆಸರಾಗಿದ್ದಾರೆ.",
        "ಜನಾಂಗದ ಎಲ್ಲ ವ್ಯಕ್ತಿಗಳು ನಿರ್ದಿಷ್ಟ ಫಿನೋಟೈಪಿಕ್ ಗುಣಲಕ್ಷಣಕ್ಕೆ ಸಂಬಂಧಿಸಿದಂತೆ ಒಂದೇ ಆಗಿರುವಾಗ ಅವರನ್ನು ಮೊನೊಮಾರ್ಫಿಕ್ ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ.",
        "ಡೇವಿಡ್ ಹೆಡ್ಲಿಯ ಬೇಹುಗಾರಿಕೆ ಮತ್ತು ಮಾಹಿತಿ ಸಂಗ್ರಹವು ಪಾಕಿಸ್ತಾನದ ಉಗ್ರಗಾಮಿ ಸಂಘಟನೆ ಲಷ್ಕರ್ ಎ ತೊಯ್ಬಾದ 10 ಸಶಸ್ತ್ರಧಾರಿಗಳು ಕಾರ್ಯಾಚರಣೆ ನಡೆಸಲು ಸಹಾಯವಾಯಿತು.",
        "ನಂತರ ಲೈಟ್ ಬಲ್ಬ್ ಬದಲಿಸುವ ಅಗತ್ಯವಿದೆ. ಲೈಟ್ ಬಲ್ಬ್ ಬದಲಿಸುವಾಗ ಸ್ವಲ್ಪ ಎಚ್ಚರವಹಿಸುವುದು ಅಗತ್ಯ.",
        "ಮಾನವನ ವೈಜ್ಞಾನಿಕ ಮತ್ತು ತಂತ್ರಜ್ಞಾನ ಆಧರಿತ ಸುಧಾರಣೆಗಳಿಂದಾಗಿ ವಿಶ್ವವು ಹಲವು ಬದಲಾವಣೆ ಕಂಡಿರುವುದು ಖಚಿತ ಮತ್ತು ಜನಸಂಖ್ಯೆ ಮತ್ತು ಮನುಕುಲದ ಐಷಾರಾಮಿ ಜೀವನ ಶೈಲಿಯಿಂದಾಗಿ ಸಮಸ್ಯೆಗಳು ಹೆಚ್ಚಾಗಿವೆ.",
        "ಸಾಂಕ್ರಾಮಿಕ ರೋಗವು ವೈರಸ್, ಬ್ಯಾಕ್ಟೀರಿಯಂ, ಶಿಲೀಂಧ್ರ ಅಥವಾ ಇತರ ಪರೋಪಜೀವಿಗಳಂತಹ ರೋಗಕಾರಕದಿಂದ ಉಂಟಾಗುತ್ತದೆ.",
        "ಆದ್ದರಿಂದ, ಈ ವ್ಯಾಕರಣ ಪ್ರಾಥಮಿಕ ಪುಸ್ತಕ ಅನ್ನು ಓದುವುದರಿಂದ ಪರ್ಷಿಯನ್ ವ್ಯಾಕರಣದ ಬಗ್ಗೆ ಹೆಚ್ಚಿನದನ್ನು ಕಲಿಯಲು ಮತ್ತು ನುಡಿಗಟ್ಟುಗಳನ್ನು ಚೆನ್ನಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ.",
        "1884 ರಲ್ಲಿ, ನ್ಯೂಯಾರ್ಕ್ ನಗರದಲ್ಲಿರುವ ಎಡಿಸನ್ ಕಂಪನಿಯಲ್ಲಿ ಕೆಲಸಕ್ಕೆ ಸೇರಲು ಟೆಸ್ಲಾ ಅವರು ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್ ಆಫ್ ಅಮೇರಿಕಾಕ್ಕೆ ತೆರಳಿದರು.",
        "ಪಾರ್ಕ್‌ನಲ್ಲಿನ ಬಹುತೇಕ ಪ್ರಾಣಿಗಳು ಮಾನವರನ್ನು ನೋಡುತ್ತವೆಯಾದರೂ, ವನ್ಯಜೀವಿಗಳು ಸ್ವಲ್ಪವೂ ಕಾಡಿನದಾಗಿರುವುದಿಲ್ಲ ಮತ್ತು ಅವುಗಳಿಗೆ ಆಹಾರ ನೀಡಬಾರದು ಅಥವಾ ಅಡ್ಡಿಪಡಿಸಬಾರದು.",
        "ವಿಶಿಷ್ಟ ಸಾಂಸ್ಕೃತಿಕ ಮತ್ತು ಐತಿಹಾಸಿಕ ಮೌಲ್ಯದ ಕಾರಣಕ್ಕಾಗಿ, ಸಂಪೂರ್ಣ ಜಿಲ್ಲೆಯನ್ನು ಯುನೆಸ್ಕೋ ವಿಶ್ವ ಪರಂಪರೆಯ ತಾಣವಾಗಿ ಗೊತ್ತುಪಡಿಸಲಾಗಿದೆ ಮತ್ತು ಅದರ ಆಸ್ತಿ ಮೌಲ್ಯಗಳು ದೇಶದ ಅತ್ಯುನ್ನತ ಸ್ಥಾನದಲ್ಲಿವೆ.",
        "ಕ್ಯಾಲೆಜಾನ್ ಡೆಲ್ ಬೆಸೊ (ಅಲ್ಲೆ ಆಫ್ ದಿ ಕಿಸ್). ಕೇವಲ 69 ಸೆಂಟಿಮೀಟರ್‌ಗಳಿಂದ ಬೇರ್ಪಡಿಸಿದ 2 ಬಾಲ್ಕನಿಗಳು ಹಳೆಯ ಪ್ರೇಮ ದಂತಕಥೆಯ ನೆಲೆಯಾಗಿದೆ.",
        "ಜೈವಿಕ ಗಡಿಯಾರವು ಸ್ವಾವಲಂಬಿ ಆಂದೋಲಕವಾಗಿದೆ. ಯಾವುದೇ ಬಾಹ್ಯ ಪ್ರಾಂಪ್ಟ್ ಇಲ್ಲದಿದ್ದರೂ ಸಹ, ಜೈವಿಕ ಗಡಿಯಾರವು ಮುಕ್ತ ಚಾಲನೆಯಲ್ಲಿರುವ ಚಕ್ರದ ಅವಧಿಗೆ ಮುಂದುವರಿಯುತ್ತದೆ.",
        "ಸಿಂಗಾಪುರ್ ಸಾಮಾನ್ಯವಾಗಿ ಅತ್ಯಂತ ಸುರಕ್ಷಿತ ಸ್ಥಳವಾಗಿದೆ ಮತ್ತು ನಗರಗಳಾದ್ಯಂತ ಸುತ್ತಾಡುವುದು ತುಂಬಾ ಸುಲಭ, ಮತ್ತು ನೀವು ಅಲ್ಲಿಗೆ ಬಂದ ಕೂಡಲೇ ಏನನ್ನು ಬೇಕಾದರೂ ಖರೀದಿಸಬಹುದು.",
        "ಕೇಪ್ ಟೌನ್ ಮತ್ತು ಸುತ್ತಮುತ್ತಲಿನ ಪ್ರಯಾಣಿಕರ ರೈಲುಗಳಲ್ಲಿ MetroRail 2 ತರಗತಿಗಳನ್ನು ಹೊಂದಿದೆ: MetroPlus (ಇದನ್ನು ಪ್ರಥಮ ದರ್ಜೆ ಎಂದೂ ಕರೆಯುತ್ತಾರೆ) ಮತ್ತು ಮೆಟ್ರೋ (ಮೂರನೇ ದರ್ಜೆ ಎಂದು ಕರೆಯಲಾಗುತ್ತದೆ).",
        "ನಾಸಾದ ಶಟಲ್ ಪ್ರೋಗ್ರಾಮ್ ಮುಖ್ಯಸ್ಥ ಎನ್‌ ವಾಯ್ನೆ ಹಾಲೆ ಜ್ಯೂ. \"ನಾವು ಕಳವಳ ಹೊಂದಿದ ಸಮಯದ ನಂತರ\" ಫೋಮ್ ಬಿದ್ದಿದೆ ಎಂದಿದ್ದಾರೆ.",
        "ಸಾಮಾನ್ಯವಾಗಿ ವಿಮಾನ, ಹಡಗು ಅಥವಾ ಬೇರೆ ಯಾವುದೇ ವಾಹನದಿಂದ ಕೆಳಗಿಳಿದ ನಂತರದ ಮೊದಲನೇ ನಿಲುಗಡೆಯೇ ಇಮಿಗ್ರೆಷನ್ ತಪಾಸಣಾ ಕೇಂದ್ರ.",
        "ಮಾನವ ಕೈಗಳು ಕಾಲಿಗಿಂತ ಸಣ್ಣದಾಗಿದ್ದು, ನೇರ ಅಂಗರಚನಾಶಾಸ್ತ್ರದಲ್ಲಿದೆ.",
        "ಅವು ಸಾಮಾನ್ಯವಾಗಿ ಹೆಚ್ಚಿನ ಬ್ಯಾಂಡ್‍ವಿಡ್ತ್ ಮತ್ತು ಉತ್ತಮ ಗುಣಮಟ್ಟದ ಸೇವೆಯನ್ನು ಕೊಡುತ್ತವೆ. ಅವು ಎನ್ಕ್ರಿಪ್ಟ್ ಮಾಡಲ್ಪಟ್ಟಿದ್ದು ಬೇಹುಗಾರಿಕೆ ಮಾಡಲು ಕಷ್ಟಕರವಾದುದಾಗಿದೆ.",
        "ಫ್ಲೂ ಲಕ್ಷಣಗಳು ಕಡಿಮೆಯಾಗಿದ್ದರೂ ರೋಗಿಗಳು ತಮ್ಮ ದೈನಂದಿನ ಕಾರ್ಯಗಳಲ್ಲಿ ಭಾಗವಹಿಸಿದಾಗ ಇತರರಿಗೂ ಸೋಂಕು ತಗಲಿಸಬಹುದು ಎಂಬ ಕಾಳಜಿಯಿದೆ."
    ]
}
