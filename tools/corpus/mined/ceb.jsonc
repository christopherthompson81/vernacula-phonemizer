    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Ang Montevideo kay anaa sa mga sikbit-tropiko; sa mga ting-init nga bulan, komon ra nga moabot ang temperatura sa +30°C." },
        { "cell": "digit-run", "text": "Anaa sa amihanang bahin o Sentinel Range ang kinatas-ang bukid sa Antarctica, ang Vinson Massif, nga miabot og 4892 m Mount Vinson." },
        { "cell": "digit-run", "text": "Ang 2004 medalistang pilak sa Olympic nga si Amir Khan miingon, \"Sa kinailadman, nagtoo ko nga dili dapat makig-away ang mga kababayen-an. Mao kana ang akong opinyon.\"" },
        { "cell": "digit-run", "text": "Ang 21-anyos nga si Hesus miapil sa Manchester City sa miaging tuig sa Enero 2017 gikan sa Brazilian club nga Palmeiras alang sa gibalitang bayad nga £27 milyon." },
        { "cell": "digit-run", "text": "Ang bagyo, nga nahimutang mga 645 milya (1040 km) kasadpan sa mga isla sa Cape Verde, lagmit nga mawala sa dili pa kini makahulga sa bisan-asang lugar sa yuta kini sumala sa mga mananagna." },
        { "cell": "digit-run", "text": "Ang bagyo nga si Danielle, ikaupat nga ginganlang bagyo sa tuig 2010 sa panahon sa Atlantic nga bagyo, ug kini naporma sa sidlakang dagat sa Atlantic." },
        { "cell": "digit-run", "text": "Ang British nga dyaryo nga The Guardian kay nag-ingon nga gikontrol sa Deutsche Bank ang halos ang ikatulong bahin sa 1200 ka mga shell company aron mabuhat kini." },
        { "cell": "digit-run", "text": "Ang Couchsurfing kay gitukod kaniadtong Enero tuig 2004 human ang kompyuter programmer nga si Casey Fenton nakakita og barato nga biyahe sa eroplano padulong sa Iceland apan walay lugar nga kapuy-an." },
        { "cell": "digit-run", "text": "Ang dokumento, matud pa sa nag-leak, kay mohisgot sa bikil sa mga utlanan, nga gusto makuha sa Palestine base sa mga utlanan sa wala pa ang 1967 Mideast War." },
        { "cell": "fractions", "text": "Ang sumbanan kinahanglan nga igo-igo ang giladmon, 5 ka milimetros (1/5 ka pulgada) o sobra pa, ug ang materyal kay igo ang kahumok alang sa bugnaw nga temperatura." },
        { "cell": "fractions", "text": "Samtang walay nasayod kon kinsa ang misulat niini, nahibaw-an nga sa sayong bahin sa iyang kinabuhi, ang dakong dokumentong papel (nagsukod kini og 29¾ ka pulgada por 24½ ka pulgada) kay gihipos aron tipigan." },
        { "cell": "clock", "text": "Ang duha ka tore adunay gitas-on nga 83 metros, 378 metros ang kataas niini ug aduna kini duha ka dalan nga 3.50 ang gilapdon." },
        { "cell": "clock", "text": "Ang JAS 39C Gripen nahagbong sa landinganan mga alas 9:30 sa buntag sa lokal nga oras (0230 UTC) ug mibuto maong gipasirad-an ang tugpahanan sa mga komersiyal nga paglupad." },
        { "cell": "clock", "text": "Ang linog nitay-og sa Mariana pagka-alas 07:19 sa buntag sa lokal nga oras (09:19 sa hapon GMT Biyernes)." },
        { "cell": "clock", "text": "Ang mga dula gisugdan sa alas 10:00 sa buntag nga adunay maayong panahon, walay apil ang pagtaligsik tunga-tunga sa buntag nga dali nahanaw, kini usa ka hingpit nga adlaw alang sa 7 nga rugby." },
        { "cell": "clock", "text": "Ang mga kakusog sa 802.11n kay labing paspas kaysa sa mga gisundan niini nga adunay kinadak-an nga theoretical throughput nga 600Mbit/s." },
        { "cell": "clock", "text": "Gihulagway nga \"makatabang\" ang ulan nga nakaabot sa 6.34 pulgada sa usa ka sukdanan sa Oahu." },
        { "cell": "clock", "text": "Gipresentar sa Iraq Study Group ang taho niini sa 12.00 GMT karong adlawa." },
        { "cell": "clock", "text": "Mga 11:29, ang protesta ningbalhin sa Whitehall, labay sa Trafalgar Square, subay sa Strand, nag-agi sa Aldwych ug pataas sa Kingsway padulong sa Holborn diin ang Konserbatibo nga Partido naghupot sa ilang Spring Forum sa Grand Connaught Rooms nga hotel." },
        { "cell": "signs", "text": "250 ka tuig ang milabay, nahimong usa ka global nga negosyo ang Guinness nga nakahalin og 10 bilyones nga euro (US$14.7 bilyones) kada tuig." },
        { "cell": "signs", "text": "Ang CafeNet El Sol nagtanyag og usa ka serbisyo nga reserba sa bayad nga US$30, o $10 alang sa usa ka adlaw nga mga pass; ang mga detalye anaa sa ilang panid sa Corcovado." },
        { "cell": "signs", "text": "Ang ubang mga bato, nga talagsaon kaayo sa kalibutan, ginabaligya gikan sa US$11,000 ngadto sa US$22,500 matag 30 gramos, mga napulo kapilo ang kamahalon kaysa sa bulawan." },
        { "cell": "signs", "text": "Ang Uropanhong Turko (sidlakang Thrace o Rumelia sa Balkanhong dawis) nahilakip sa 3% sa nasod." },
        { "cell": "signs", "text": "Apan giingon ni Punong Ministro John Howard nga ang balaod kay aron lang mapanalipdan ang mga pasilidad sa ospital gikan sa pagpa-downgrade sa gobyerno sa Tasmanian, sa paghatag og dugang AUD$45 milyon." },
        { "cell": "signs", "text": "Gidahum na nga kasagaran sa mga event tickets kay naa sa ¥2,500 ug ¥130,000, nga ang mga tipikal nga ticket kay naa sa presyo nga ¥7,000." },
        { "cell": "signs", "text": "Naglakip sila ug pinansyal na mga pagpugong og pag-ban sa European Union sa pag-angkat sa lanang krudo, kon asa gadawat ang ekonomiya sa Iran sa 80% sa langyaw nga kita niini." },
        { "cell": "signs", "text": "Nagsugod ang protesta mga 11:00 sa lokal nga oras (UTC+1) sa Whitehall atbang sa ganghaan nga gibantayan sa pulis sa Downing Street, ang opisyal nga puluy-anan sa Punong Ministro." },
        { "cell": "dotted", "text": "Ang mga airline nga nagtanyag niini kauban ang Air Canada, Delta Air Lines, Lufthansa alang sa mga byahe nga gikan sa U.S. o Canada, ug WestJet." },
        { "cell": "dotted", "text": "Giasayn kini sa Ikapitong Panon sa U.S. Navy ug nakabase kini sa Sasebo, Nagasaki sa Japan." },
        { "cell": "dotted", "text": "Gibanabana sa U.S. Corps of Engineers nga ang 6 pulgadang ulan ang mahimo nga pagbungkag sa mga kaniadtong nadaot nga pilapil." },
        { "cell": "dotted", "text": "Ingon ang U.S. nga nakadawat kini og impormasyon gikan sa wala nahibaw-an nga source nga espesipikong naghisgot sa paggamit sa mga naghikog nga mamomomba aron pabutohon ang \"mga bantugang timailhan\" sa Ethiopia ug Kenya." },
        { "cell": "dotted", "text": "Nabantog kini isip episentro sa luho nga nagsugod mga 400 A.D. ug nilungtad hangtod mga 1100 A.D." },
        { "cell": "dotted", "text": "Naglaum usab ang H.K. (Hiniusang Kanasoran) matapos na ang pondo aron ipangtabang sa mga nasod nga apektado sa pag-init sa yuta aron masagubang ang mga epekto niini." },
        { "cell": "dotted", "text": "Nagsugod ang programa alas 8:30 p.m. sa lokal nga oras (15.00 UTC)." },
        { "cell": "dotted", "text": "Sama sa gihisgotan sa ibabaw, masking ginadawat gihapon ang pulong nga \"Eskimo\" sa Estados Unidos, gikonsiderar kining mabiaybiayon sa daghang mga dili U.S. nga Artiko nga tawo, labi na sa Canada." },
        { "cell": "year", "text": "Ang gisugyot nga pag-amendar kay nakapasar na sa parehas nga balay kaniadtong 2011." },
        { "cell": "year", "text": "Ang Hangeul ra ang gituyo og imbento nga alpabeto sa iladong adlaw-adlaw nga paggamit. Ang alpabeto naimbento sa 1444 sa panahon sa paghari ni King Sejong (1418 – 1450)." },
        { "cell": "year", "text": "Ang High Middle Ages giunhan sa Early Middle Ages ug gisundan sa Late Middle Ages, nga sa kombensyon nahuman niadtong 1500." },
        { "cell": "year", "text": "Ang Il-76 kay usa ka dakong bahin sa militar sa Russia ug Soviet gikan pa sa katuigan sa 1970, ug nakakita na usa ka grabe nga aksidente sa Russia sa miaging bulan." },
        { "cell": "year", "text": "Ang iyang ika-1,000 nga selyo mao ang matahom nga \"Great Deeds by Swedish Kings\" ni David Klöcker Ehrenstrahl sa 2000, nga nalista sa Guinness Book of World Records." },
        { "cell": "year", "text": "ang iyang ikaduhang goal sa gabie mao ang iyang ika-60 sa season, ang naghimo sa iya isip unang magduduwa nga nakapuntos og 60 o labaw pa nga mga goal sa usa ka season sukad 1995-96, sa dihang sila si Jaromir Jagr ug Mario Lemieux tagsa-tagsang nakaabot ato nga milestone." },
        { "cell": "year", "text": "Ang karon nga mga bahin sa Belgium kay bahin sa Luxembourg kaniadto apan nahimo nga Belgian pagkahuman sa 1830s nga Rebolusyon sa Belgium." },
        { "cell": "year", "text": "Ang kataas-taasang pinuno sa nasud nga si Ayatollah Ali Khamenei, gihulagway ang pagsalig sa aseite ingon \"lit-ag\" adto pang niaging Islamic nga rebolusyon sa Iran sa 1979 ug dapat makagawas ang nasod niini." },
        { "cell": "decimals", "text": "Anaa sa ikaduha si Johnson nga adunay 2,243 nga puntos ug pito ka puntos ang biya." },
        { "cell": "decimals", "text": "Ang Apia ang kapital sa Samoa. Kining lungsora naa sa isla sa Upolu ug adunay populasyon nga ubos ra sa 40,000." },
        { "cell": "decimals", "text": "Ang bagyo, nga nahimutang sa gibanabanang 3,000 ka milya gikan sa Miami, Florida, adunay labing taas nga gikusgon sa hangin nga 40 ka milya kada oras (64 ka kilometro kada oras)." },
        { "cell": "decimals", "text": "Ang espesyalisasyon sa bipedal nakit-an sa mga fossil sa Australopithecus gikan 4.2-3.9 milyon ka tuig na ang milabay, bisan tuod ang Sahelanthropus tingali naglakaw sa duha ka mga bitiis ingon ka sayo sa pito ka milyon ka tuig na ang milabay." },
        { "cell": "decimals", "text": "Ang gidungag nga 300 nagresulta sa kinatibuk-ang 1,300 ka mga karwahe nga makuha aron mahupay ang kadaghan sa tawo." },
        { "cell": "decimals", "text": "Ang isla unang gipuy-an sa mga Taino ug Caribe. Ang mga Caribe kay mga Arawakan ang panultihon nga mga tao nga miabot mga 10,000 BCE." },
        { "cell": "decimals", "text": "Ang Izmir ang ikatulong pinakadako nga siyudad sa Turkey nga adunay populasyon nga moabot og 3.7 milyon, ang ikaduhang pinakadako nga mga pantalan sunod sa Istanbul, ug maayo kini nga sentro sa transportasyon." },
        { "cell": "decimals", "text": "Ang Japan adunay duolan sa 7,000 ka mga isla (Honshu ang labing dako), nga naghimo sa Japan isip ika-7 nga pinakadakong isla sa kalibutan!" },
        { "cell": "ordinal-latin", "text": "Ang mga halapad nga dalan, bildo og atubangan nga mga building ug mga modernong shopping center kay adunay tradisyonal nga pulang mga atop, ang ika-18th nga siglo nga merkado, ug mga karaan nga moske ug simbahan, bisan nga adunay atmospera ang siyudad nga murag Mediterranean Europe kaysa sa tradisyonal nga Turkey." },
        { "cell": "ordinal-latin", "text": "Ang nangamatay kay sila Nicholas Alden, 25, ug Zachary Cuddeback, 21. Si Cuddeback mao ang nag-drayb." },
        { "cell": "ordinal-latin", "text": "Ang populasyon sa Siyudad sa Batikano kay anaa sa mga 800. Kini ang pinakagamay nga independenteng nasod sa kalibutan ug ang nasod nga pinakaubos ang populasyon." },
        { "cell": "ordinal-latin", "text": "Ang usa gipadala kaniadto kay George Washington sa ika-6 sa Hulyo, kun asa gibasa niini sa iyahang mga tropa sa New York pagka Hulyo 9. Usa ka kopya niini niabot sa London pagka Agosto 10." },
        { "cell": "ordinal-latin", "text": "Dili maayo ang nahimong kahimtang sa mga Italyano sa Amihanang Aprika halos gikan sa sinugdan. Sulod sa usa ka semanang pagdeklara og giyera sa Italya kaniadtong Hunyo 10, 1940, giilog sa 11th Hussars sa Britanya ang Fort Capuzzo sa Libya." },
        { "cell": "ordinal-latin", "text": "Mahitabo ang Paralympics gikan sa 24 sa Agosto hangtod sa Septyembre 5, 2021. Ang pipila ka mga event pagahimuon sa ubang mga lokasyon sa tibuok Japan." },
        { "cell": "ordinal-latin", "text": "Manggawas sa mga kabaybayonan ang mga sabay duol sa mga bokana sa suba gikan sa Oktubre ngadto sa Abril sa amihang bahin sa 1770. Makita usab kini usahay gawas aning mga panahuna." },
        { "cell": "units", "text": "Ang mga bundok sa Peninsula diri kay nagsagol nga nahimong talampas, unya nagbalik og sagol aron maporma ang 360 km nga linya sa Ellsworth Mountains, nga gisumpayan sa Minnesota Glacier." },
        { "cell": "units", "text": "Ang mga gibutang nga limitasyon sa katulinon kay makit-an nga mas ubos kaysa sa nangagi ug sunod nga mga seksyon — kasagaran 35-40 mph (56-64 km / h) — ug ang higpit nga pagsunod niini labi ka hinungdanon kaysa kon dili." },
        { "cell": "units", "text": "Ang pipila nga medium-format film nga mga kamera nagagamit og usa ka 6 by 6 cm format, mas tukmang usa ka 56 by 56 mm nga negatibo." },
        { "cell": "units", "text": "Ang South Pole Traverse (o Dalan) mao ang usa ka 1600 km nga agianan gikan sa Istasyon sa McMurdo sa Dagat sa Ross ngadto sa Pole." },
        { "cell": "units", "text": "Ang Sundarbans ang pinakadako nga baybay nga gabakos og kabakhawan nga binuhat sa kalibutan, nga nagbuklad sa 80km (50 mi) ngadto sa Bangladesh ug kabaryohan sa India gikan sa baybayon." },
        { "cell": "units", "text": "Ang Sundarbans nagkobre sa luna nga 3,850 km², nga usa sa tulo kay tubigon nga mga lugar." },
        { "cell": "units", "text": "Ang ubang skiing event mahitabo sa Taizicheng ski area sa Zhangjiakou, nga kapin kon kulang 220 km (140 miles) gikan sa Beijing." },
        { "cell": "units", "text": "Daghang mga nagkadaiyang pormat sa film nga gigamit sa mga niaging katuigan. Ang standard nga 35mm nga film (36 by 24mm negatibo) kay sobra na sa kasagaran sa tanan." },
        { "cell": "ranges", "text": "Aduna siyay 2 ka goal ug 2 ka assist sa 5-3 nga daog sa Washington batok sa Atlanta Thrashers." },
        { "cell": "ranges", "text": "Ang estilo nga Gothic kay nisikat niadtong ika-10-11 nga siglo ug sa ika-14 nga siglo." },
        { "cell": "ranges", "text": "Ang Luno adunay 120-160 metro kubikong sakay nga gasolina sa dihang kini nabuak ug ang kusog nga hangin ug mga balud natuklod niini sa riprap." },
        { "cell": "ranges", "text": "Ang tawo-por-tawo nga rekord ni Nadal batok sa taga-Canada kay 7-2." },
        { "cell": "ranges", "text": "Kaniadtong 1895, pagkahuman sa pagkapildi sa Unang Gubat sa Sino-Hapon (1894-1895), gipirmahan sa gobyerno sa Qing ang Kasabotan sa Shimonoseki, diin gitugyan ang soberanya sa Taiwan ngadto sa Japan, kon asa kini kay nagmando sa isla hangtod sa tuig 1945." },
        { "cell": "ranges", "text": "Kasagaran mulongtad ang kurso sa 2-5 ka adlaw ug maglakip og drama-drama, daghang emerhensiyang pagtambal ug usahay pagbansay sa mga hinagiban." },
        { "cell": "ranges", "text": "Nagadala kini sila og kusog nga hangin (usahay naa sa 100-200 kilometro kada oras) ug makaalsa og mga bug-at nga butang ngadto sa hangin, nga ginadala niini samtang nagalihok ang buhawi." },
        { "cell": "ranges", "text": "Natukod ang relihiyon sa ika-15 nga siglo ni Guru Nanak (1469–1539). Gisundan kini og siyam ka mga guru." },
        { "cell": "currency", "text": "Nakigbahin usab siya sa pagkulit sa mga kuwarta alang sa daghang mga nasod, bag-ohay nga mga pananglitan sa iyang trabaho lakip ang hulagway sa Punong Ministro sa atubang sa bag-ong $5 ug $100 nga kwartang papel sa Canada." },
        { "cell": "currency", "text": "Si Batten naa sa ika-190 nga ranggo sa lista sa 2008 nga 400 Kinadatoang Mga Amerikano nga adunay gibanabana nga bahanding $2.3 bilyon." },
        { "cell": "currency", "text": "Sumala sa balaodnon, ang mga bayolenteng mga dula sa video nga gibaligya sa estado sa California kinahanglan nga gimarkahan og mabasang disenyo nga \"18\" ug ang mobaligya niini ngadto sa menor de edad silotan pinaagi sa multa nga $1000 matag kalapasan." },
        { "cell": "abbrev", "text": "Adunay mga iho, apan panagsa ra sila moatake sa mga tawo. Kasagaran sa mga iho mahadlok og mga tawo ug molangoy ra palayo." },
        { "cell": "abbrev", "text": "Ang Alemanya mao ang komon nga kaaway sa World War 2, nga nagresulta sa kooperasyon sa USSR ug USA. Paghuman sa giyera, ang pagbanggaay sa sistema, proseso ug kultura kay nagresulta sa di-pagsinabtanay sa mga nasod." },
        { "cell": "abbrev", "text": "Ang Cook Islands kay walay syudad apan aduna kini 15 ka lain-laing mga isla. Ang mga kaulohang isla kay ang Rarotonga ug Aitutaki." },
        { "cell": "abbrev", "text": "Ang hepe sa programa sa shuttle sa NASA nga si N. Wayne Hale Jr. miingon nga ang espongha nahulog \"human sa oras nga gikabalak-an nato.\"" },
        { "cell": "abbrev", "text": "Ang ihap sa mga tawo nga naa didto daghan kaayo maong dili mahimo alang sa tanan nga makaadto sa lubong sa St. Peter's Square." },
        { "cell": "abbrev", "text": "Ang mga Aleman nga submarino kay gitawag nga mga U-Boat. Ang mga Aleman maayo kaayo sa paglawig ug pagpadagan sa ilang mga submarino." },
        { "cell": "abbrev", "text": "Ang mga nahibilin niini naghimo og talisik sa halos tanang mga isla. Bisan pa niini, walay kadaot o pagbaha nga gibalita." },
        { "cell": "abbrev", "text": "Ang mga permiso kinahanglan ipareserba daan. Kinahanglan aduna kay permiso nga magpabilin sa gabii sa Sirena." },
        { "cell": "latin-in-native", "text": "34 porsyento sa mga botohan nag-ambit ani nga panan-aw, nga gusto si Queen Elizabeth II ang mahimong ulahing monarko sa Australia." },
        { "cell": "latin-in-native", "text": "Aduna kami tibuok-tuig nga krisis sa panalapi, nga labing migrabe sa miaging duha ka bulan, ug karon nagtuo kong ang pinansyal nga mga merkado kay nagsugod na sa pagbawi.\"" },
        { "cell": "latin-in-native", "text": "Aduna kini mas huyang nga kasundalohan ug navy, bisan kon bag-o pa sila nakapahimo og upat ka bag-ong mga barko sa wala pa magsugod ang gubat." },
        { "cell": "latin-in-native", "text": "Aduna kini parehas nga istraktura sa molekula bisan pa kon kini gas, likido o solid." },
        { "cell": "latin-in-native", "text": "\"Aduna na kami karon 4 ka bulang mga ilaga nga dili dayabetik nga kaniadto dayabetik,\" dugang pa niya." },
        { "cell": "latin-in-native", "text": "Aduna nay bayad alang sa musobra sa duha ka pasahero, maong kani nga opsyon mas mahal kaysa gikinahanglan." },
        { "cell": "latin-in-native", "text": "Aduna pay daghang buhing lalaki ug babaye nga nakalahutay sa ilang kaagi dinhi, ug daghan pa kinsa adunay mga minahal nga gipatay o gipatrabaho hangtod kamatayon, mga Judiyo ug dili mga Judio." },
        { "cell": "latin-in-native", "text": "Aduna pud mga almendras, hazelnut, ug uban pang liso sa kahoy ang daghang lutong gina-bake sa Aleman. Ang mga sikat nga cake kanunay nga gipares sa usa ka tasang isog nga kape." },
        { "cell": "percent", "text": "Nasakmit ni Nadal ang 88% nga puntos sa sangka, nga nakadaog og 76 ka puntos sa una nga pag-serve." },
        { "cell": "percent", "text": "Salamat sa undersea fiber optic, ang mga kable nakonekta sa Europa ug broadband satellite, ang Greenland konektado pag-ayo sa 93% sa populasyon ang adunay access sa internet." },
        { "cell": "rate", "text": "Kining dako kaayo nga mga bagyo adunay hangin nga moabot hangtod sa 480 km/h (133 m/s; 300 mph)." },
        { "cell": "rate", "text": "Matud pa sa mga otoridad sa parke, magpabilin sa labing menos 100 yarda/metros layo gikan sa mga oso ug lobo, ug 25 yarda/metros ang layo sa tanang ihalas nga mananap!" },
        { "cell": "rate", "text": "Naglisod ang pulisya sa New Zealand sa paggamit sa ilang mga speed radar gun aron makita kon unsa katulin ang pagmaneho ni Mr Reid tungod sa kamubo sa Itom nga Katahum, ug ang bugtong higayon nga naorasan sa pulisya si G. Reid katong naghinay siya sa 160km/h." },
        { "cell": "rate", "text": "Nahimo ni Mr. Reid nga padaganon ang A1GP nga sakyanan sa New Zealand nga Black Beauty, sa kapaspason nga lapas sa 160 km/h sa ikapito ka beses sa taytayan." },
        { "cell": "rate", "text": "Si Fred karon kay adunay hangin nga 105 ka milya matag oras (165 km/h) ug nagalihok padulong sa amihanan-kasapdan." },
        { "cell": "roman", "text": "Ang mga submarino gigamit sa Gubat sa Kalibutan I ug Gubat sa Kalibutan II. Niadto pa hinay kaayo sila ug adunay limitado kaayo nga range sa pagpamusil." },
        { "cell": "roman", "text": "Ang pipila ka mga hotel adunay panulundon gikan sa bulawanong yugto sa mga steam railway ug ocean liner sa wala pa ang World War II, kaniadtong ika-19 o sayong bahin sa ika-20 nga siglo." },
        { "cell": "roman", "text": "Kanunay nga gipaningkamutan sa Luxembourg nga magpabilin nga usa ka neutral nga nasud apan gisakop kini sa Alemanya sa World War I ug World War II." },
        { "cell": "roman", "text": "Miangkon ang Tig-Atiman nga Punong Ministro nga si Julia Gillard sa panahon sa kampanya sa federal nga pilianay sa 2010 nga nagtuo siya nga dapat nang mahimong republika ang Australia sa katapusan sa pagmando ni Queen Elizabeth II." },
        { "cell": "roman", "text": "Nausab ang balaud sa Pransya. Nagsugod ang iyang pagkaaktibista sa edad nga 15 sa kadtong miapil siya sa French Resistance sa panahon sa World War II." },
        { "cell": "initialism", "text": "Ang ADD kay makaapekto sa mga relasyon sa ubang mga kaedad tungod kay dili makasabot ang ubang bata kon nganong naglihok sila sa paagi nga ilang gibuhat o kon nganong nag-espeling sila sa paagi nga ilang gihimo o nganong lahi ang ilang lebel sa pagkahamtong." },
        { "cell": "initialism", "text": "Ang Bantugang Piramide, nga gitukod sa mga taga-Ehipto sa ikatulong siglo BCE, kay usa sa daghang dagko nga piramideng istraktura nga gitukod alang sa pahinungod sa namatay nga Paraon." },
        { "cell": "initialism", "text": "Ang boto kinahanglan gihapon nga aprubahan sa tibuok nga IOC sa Oktubre nga miting niini sa Copenhagen." },
        { "cell": "initialism", "text": "Ang dalan diin nahitabo ang pagkahugno temporaryong gisirado samtang ang mga serbisyo sa emerhensya nagapagawas sa nagmaneho gikan sa pula nga Audi TT." },
        { "cell": "initialism", "text": "Ang desisyon sa NBA gisundan sa usa ka magdudula sa Utah Jazz nga positibo sa test para sa COVID-19 virus." },
        { "cell": "initialism", "text": "Ang Direktor sa Public Relations, Kier Stamer QC, naghatag og pahayag karong buntag sa pagpahibalo sa prosekusyon nila Huhne ug Pryce." },
        { "cell": "initialism", "text": "Ang eksperimento nga Hershey ug Chase kay usa ka mga nangunang sugyot nga ang DNA kay usa ka henetikong materyal." },
        { "cell": "initialism", "text": "Ang GDP sa Tsina mahimo pang masmo dako kaysa sa Estados Unidos sulod sa duha ka dekada." },
        { "cell": "grouped", "text": "Ang kalibutan adunay sobra sa 5,000 nga lainlaing mga sinultian, lakip ang sobra sa baynte ka sinultihan nga adunay 50 ka milyon o labaw pa nga mga manunulti." },
        { "cell": "grouped", "text": "Ang lugar sa Turkey, apil ang mga lanaw naglangkob sa 783,562 kilometro kwadrado (300,948 sq mi), diin 755,688 kilometro kwadrado anaa sa habagatang kasadpan sa Asya ug 23,764 kilometro kwadrado (9,174 sq mi) sa Europa." },
        { "cell": "grouped", "text": "Ang mga bangag sa balbula mitugot sa pagpagawas sa presyur alang sa sistema ug ang lana niawas sa pad sa usa ka tanke nga mahimong makasulod og 55,000 bariles (2.3 milyon ka galon)." },
        { "cell": "grouped", "text": "Ang mga satelayt nga parehas adunay gibug-aton nga sobra sa 1,000 ka libras, ug nagbiyahe nga gibanabana sa 17,500 kilometros matag oras, nagbangga sa 491 ka milya sa ibabaw sa Yuta." },
        { "cell": "grouped", "text": "Ang pangunang Amazon River kay 6,387 kilometros (3,980 ka milya). Nagakolekta kini og tubig gikan sa liboan ka gagmayng mga suba." },
        { "cell": "grouped", "text": "Ang pangunang pang-atakeng puwersa sa 2,400 ka lalaki motabok sa suba nga siyam ka milya sa amihanan sa Trenton, ug pagkahuman bahinon sa duha ka mga grupo. Usa niini ilalom ni Greene ug ang usa sa ilalom ni Sullivan, aron maglansad og pag-atake sa wala pa ang kaadlawon." },
        { "cell": "grouped", "text": "Ang teritoryo sa Turkey sobra sa 1,600 kilometros (1000 milya) ang gitas-on ug 800 kilometros (500 milya) ang gilapdon, nga halos rectangular ang porma." },
        { "cell": "grouped", "text": "Ang usa pa ka sekundaryong sidlanan nga lugar sa ilawom sa mga tangke nga makahupot og 104,500 ka mga baril kay wala pa mapuno ang kapasidad." },
        { "cell": "letter-name", "text": "Adunay sila mga tiil nga naay himbis ug mga kuko, mangitlog sila, ug naglakaw sila gamit ang ilang duha ka paa sa likud sama sa T-Rex." },
        { "cell": "letter-name", "text": "Ang kaandam sa mga gobyerno sa pag-isyu og mga pasaporte nga wala gisulti ang gender (X) o mga dokumento nga gi-update aron sa pagpares sa gitinguhang ngalan ug lainlain ang sekso." },
        { "cell": "letter-name", "text": "Ang lebel sa pH ginapakita pinaagi sa kadaghan sa mga ion nga Hydrogen (ang H sa pH) sa gisulayan nga kemikal." },
        { "cell": "letter-name", "text": "Ang makamatay nga flu sa mga tawo, H5N1, kay gikumpirma nga nakatakod kini og usa ka patay nga itik, nakit-an pagka-Lunes, sa usa ka marshland duol sa Lyon sa may silangan sa Pransiya." },
        { "cell": "letter-name", "text": "Ang mga bantog nga isport apil ang football, basketball, volleyball, water-polo, fencing, rugby, pagbisikleta, ice hockey, roller hockey ug F1 motor racing." },
        { "cell": "letter-name", "text": "Ang mga pagdunggo sa D-Day ug ang mga mosunud nga panagsangka nakapagawas sa amihanan sa Pransya, apan ang habagatan dili gihapon gawasnon." },
        { "cell": "letter-name", "text": "Ang mga udyong gikan sa makamatay nga mga pana mahimong makalusot sa armadura sa mga kalaban nga sundalo. Mga 1000 B.C,. gipaila sa mga Asiryanhon ang una nga magkakabayo." },
        { "cell": "letter-name", "text": "Ang Oyapock River Bridge kay usa ka tulay nga nagpabilin sa kable. Naglibot kini sa Oyapock River aron isumpay ang mga siyudad sa Oiapoque sa Brazil ug Saint-Georges de I'Oyapock sa French Guiana." },
        { "cell": "ampersand", "text": "Nigradwar siya sa College of Arts & Science sa University of Virginia kaniadtong 1950 ug usa siya ka hinungdanong mi-donar sa mao nga institusyon." },
        { "cell": "ampersand", "text": "Sa taas nga kalidad, klaro nga nag-indigay ang mga B&B sa duha ka labing hinungdanon: higdaan ug pamahaw." },
        { "cell": "quote-letter", "text": "Ang Crown Office, nga mao ang kinatibuk-ang katungdanan sa prosekusyon, gipakita sa mga tigbalita nga wala’y dugang nga komento nga himuon bisan hangtod sa pagsumbong." },
        { "cell": "quote-letter", "text": "Ang doktor nga nagtrabaho sa Children's Hospital of Pittsburgh, Pennsylvania kay pasakaan og kasong aggravated murder human makit-i ang patayng lawas sa iyang inahan sa likod sa iyang sakyanan sa Miyerkules, ingon sa mga awtoridad sa Ohio." },
        { "cell": "quote-letter", "text": "Ang duha ka popular nga teyorya sa content mao ang Maslow's Hierarchy of Needs Theory ug Hertzberg's Two Factor Theory." },
        { "cell": "quote-letter", "text": "Ang palabas sa PBS adunay labaw pa sa duha ka dosenag mga pasidungog sa Emmy, ug ang dagan niini mas mubo ra kaysa sa Sesame Street ug Mister Roger's Neighborhood." },
        { "cell": "quote-letter", "text": "Ang partido nga nagamando, South West Africa People's Organisation (SWAPO), nagpabilin usab ang gidaghanon sa mga piliay sa parlyamento." },
        { "cell": "quote-letter", "text": "Ang punoan nga inspektor sa RSPCA New South Wales nga si David O'Shannessy misulti sa ABC nga ang pagbantay ug mga pag-inspeksyon sa mga abattoir kinahanglan maandan sa Australia." },
        { "cell": "quote-letter", "text": "Ang Tulo ka mga Gingharian kay usa sa mga labing dugoon nga panahon sa kasaysayan sa Karaang Tsina diin libolibong mga tawo ang namatay nga nakig-away aron sa paglingkod sa pinakataas nga lingkuranan sa hataas nga palasyo sa Xi'an." },
        { "cell": "quote-letter", "text": "A World's Fair (kasagarang gitawag nga World Exposition, o sa yano Expo) kay usa ka dakong internasyonal nga piyesta sa mga arte ug siyensya." }
    ],

