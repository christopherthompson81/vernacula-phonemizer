    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Uma llaqta: Berlin (3.426.000 runakuna, 2005 watapi, *52°31′ N 13°24′ E)" },
        { "cell": "degrees", "text": "Tsiqa kukush (Anqas simipi, Ankash shimichu)(kastilla simipi: ángulo recto). Tupunin 90°, rimay isqun chunka patakuna" },
        { "cell": "degrees", "text": "Qullqa qhichwa (ispaña simipi: Valle del Colca) nisqaqa piruwanu Qullqa mayup qhichwanmi, Antikunapi, Ariqipa suyupi, Kaylluma pruwinsyapi, Wampu distritupi Callalli distritupipas (15°35′50″S, 71°52′45″W)." },
        { "cell": "degrees", "text": "Kimra siwi icha Tinkurachina hanaq (latitud) nisqaqa chawpipacha siq'imanta qhipakunakama yupasqam. Chawpipachapiqa ch'usaq k'atma (0°), chinchay qhipapiqa chinchay hanaq isqun chunka k'atma (90° Ch / 90° N), urin qhipapitaq urin hanaq isqun chunka k'atma (90° Ur / 90° S)." },
        { "cell": "degrees", "text": "Suni siwi icha Tinkurachina suni (longitud) nisqataq London llaqtanta puriq Greenwich siwimanta iskaynintin kinraymanmi yupasqa. Greenwich siwipiqa London llaqtapi ch'usaq k'atma (0°), chay siwipqa huk kinrayman, anti puriyllaman anti pachak pusaq chunka k'atma (180° An / 180° E) nisqakama, kunti puriyllaman kunti pachak pusaq chunka k'atma (180° Ku / 180° W) nisqakamam yupanchik." },
        { "cell": "degrees", "text": "Pata (Kastilla simipi: 90° sexagesimales) ; Patachak = grado centesimal; Liwiki = radian. Muyuk'uchu = 360 patakuna = 400 patachakkuna = 2Π liwikikuna." },
        { "cell": "degrees", "text": "Qullpa Ananta icha Qallanqati V, 6.110 m (13° 43′ 55″ S 71° 9′ 34″ W)" },
        { "cell": "degrees", "text": "Qallanqati I, 5.950 m (13° 42′ 41″ S 71° 9′ 26″ W) (Qallanqati qutup chinchayninpi)" },
        { "cell": "digit-run", "text": "Arhjintina, Arhintina icha Qullqillaqta nisqaqa Uralan Awya Yalapi huk mama llaqtam. Uma llaqtanqa Buenos Aires llaqtam. Arhintina suyupiqa 3.921833 tiyaqmi kawsachkanku. Hallka k'iti k'ancharn kay 2.766.890 km&sup2;." },
        { "cell": "digit-run", "text": "Río Salado del Oeste (Bermejo-Desaguadero-Salado), 1700 km, 14 m³/s" },
        { "cell": "digit-run", "text": "Ojos del Salado, 6880&nbsp;m, (Atakama suyu)" },
        { "cell": "digit-run", "text": "Tupungato, 6800&nbsp;m (Metropolitana suyu)" },
        { "cell": "digit-run", "text": "Yuyayyaku, 6739&nbsp;m (Antuphaqasta Suyu)" },
        { "cell": "digit-run", "text": "Likankawur, 5916&nbsp; (Antuphaqasta Suyu)" },
        { "cell": "digit-run", "text": "Descabezado Grande, 3830&nbsp;m ('Mawlli suyu)" },
        { "cell": "digit-run", "text": "Torres del Paine, 2800&nbsp;m (Región de Magallanes y de la Antártica Chilena)" },
        { "cell": "fractions", "text": "Urqukuna: Shuyturahu (6.120 m) - Artisunrahu (5,999/6,025 m) - Kanchas (6.049 m) - Qarwatakaq (6.176 m) - Chawpikallki (6.307 m) - Wallqan (6.122 m) - Hirihanka (6.094 m) - Matarahu (6.074 m) - Pisqu urqu (5.452 m) - Pukachirka (6.100 m) - Pukaranka (6.156 m) - Pallqarasu (6.274 m) - Pastururi (5.240 m) - Pukarahu (6.241 m) - Pumapampa (6.258 m) - Pumpuyaq (6.166 m) - Kitarahu (6.036 m) - Rahupakinan (6.122 m) - Rasaq (6 017 m) - Rurimachay (6.309 m) - Shaprarahu (6.112 m) - Tawllirahu (5.830 m) - Tullparahu (6.395 m) - Tuqllarahu (6.032 m) - Wantuy (6.395 m) - Waskaran (6.768 m) - Quñuqranra (5.181) - Wakrish (5.560 m) - Yerupaja (6.635 m)" },
        { "cell": "fractions", "text": "Felipe Guaman Poma de Ayala: El primer nueva corónica y buen gobierno (1615/1616) - qillqasqata internetpi ñawinchay" },
        { "cell": "fractions", "text": "Sinfonie Nr. 3 Es-Dur op. 55, Eroica, 1803/04" },
        { "cell": "fractions", "text": "Laurentius von Durham (Lawrence of Durham, Laurentius Dunelmensis), (1110/1114-1154)" },
        { "cell": "fractions", "text": "Beiträge zur Optik (Abhandlungen, 2 Bde.), 1791/92" },
        { "cell": "fractions", "text": "Wilhelm Meisters Lehrjahre, 1795/96 (Text)" },
        { "cell": "fractions", "text": "Pandora (Festspiel), entstanden 1807/08, im Druck 1817" },
        { "cell": "fractions", "text": "U2 nisqaqa huk Ilanda mama llaqtayuq rock kusituymi, 1976/1977 watapi Baile Átha Cliath llaqtapi paqarisqa. 1980 watakunapim ancha riqsisqam kusituy tukurqan." },
        { "cell": "clock", "text": "Piruwqa (Ispaña simipi: Perú, Aymara simipi: Piruw, Inlis simi: Peru) Urin Apyalap intichinkayninpi llaqtam. Pata waqtamanta Ikwatur llaqtawan, Kulunsuyu llaqtawan tinkuna, inti lluqsiy waqtamantataq Parasil llaqtawan Pulipya llaqtawan tinkuna, uray waqtamantataq Chili llaqtawan Puliwya llaqtawan Titiqaqa quchawan tinkuna, inti chinkay waqtamantataq Pasihiku mama quchawan tinkusqa. Piruw huk achkaniray kawsayuq mamallaqtam tiyayr’itikunayuqmi kan, tiyayr’itintaq -Kuntipi, Pasiphiku chala suyupa purun pampapi; mamallaqtap wichayninmanta urayantinkama Anti wallap umanpi; Amarumayupa quñi yunkanpi- mastarikunmi. Piruwqa 34 hunu runakuna charin, umallaqtantaq hatunnin llaqtapas Limaqmi. 1.28 hunu km2 (0.5 hunu mi2) charispa, Piruwqa Tiqsimuyupi chunqa isqunñiqin, Urin Awyalapi kimsañiqinpas hatunnin mamallaqtam." },
        { "cell": "clock", "text": "Anqash. s. Piruwp suyun, Chawpin yachay tarpuypa k'irawnin, raki simi QI, riqsisqa aswan unayniyuq. . Sutita churarqanku Sapan Piruwta Chili urmaskiptin, Yunkay maqanakuypi, 20.01.1839" },
        { "cell": "clock", "text": "El quechua al alcance de los profesores bilingues: manual autoinstructivo para la escritura del quechua Ancash .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. 97 p.; il., 28 cm. QUECHUA / LENGUA AMERINDIA / EDUCACION BILINGÜE / MANUAL DEL PROFESOR" },
        { "cell": "clock", "text": "El quechua al alcance de los profesores bilingues: manual autoinstructivo para la escritura del quechua Cuzco - Collao .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. 97 p.; il., 28 cm. QUECHUA / LENGUA AMERINDIA / EDUCACION BILINGÜE / MANUAL DEL PROFESOR" },
        { "cell": "clock", "text": "El quechua al alcance de los profesores bilingues: manual autoinstructivo para la escritura del quechua Ayacucho - Chanca .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. 97 p.; il., 28 cm." },
        { "cell": "clock", "text": "El aimara al alcance de los profesores bilingues: manual autoinstructivo para la escritura del aimara .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. 97 p.; il., 28 cm. AIMARA / LENGUA AMERINDIA / EDUCACION BILINGÜE / MANUAL DEL PROFESOR" },
        { "cell": "clock", "text": "Puku pukumantawan k'ankamantawan: ¿pitaq maytaq kanchikiri?, qusqu qullaw runa simipi aranway .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. 58 p.; il., col; 28 cm. CUENTO / LITERATURA DE FICCION / LENGUA AMERINDIA / QUECHUA" },
        { "cell": "clock", "text": "Puku pukumantawan utulumantawan: ¿pitaq maytaq kanchik?, ayakuchu chanka runa simipi aranway .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. 58 p.; il., col; 28 cm. CUENTO / LITERATURA DE FICCION / LENGUA AMERINDIA / QUECHUA" },
        { "cell": "signs", "text": "Arhintina: 86.4% iwrupa panakayuq, 8% misti, 1.6% indihina runa, 750.000 wamaq runa" },
        { "cell": "signs", "text": "Suti: Virú ---> Pirú ---> Perú (kastilla simipi) ---> Piruw (qhichwa simipi)" },
        { "cell": "signs", "text": "Tukri sutin: República Peruana (Piruwki Sapan Llaqta) [1821 - 1950] ---> República del Perú (Piruw Sapan Llaqta Republikan) [1950 watamanta kunankama]" },
        { "cell": "signs", "text": "Bandera - Unancha (Wiphala = Tawantinsuyup unanchan, bandera de los Incas)" },
        { "cell": "signs", "text": "Superficie - Surface - Hawa (hawa = superficie de una cosa, del agua etc.)" },
        { "cell": "signs", "text": "Personas por/cada kilómetro cuadrado - sapallan km²-pi runakuna (km² = t'asra waranqa thatki)" },
        { "cell": "signs", "text": "Suomi simi / Phinis simi 4.797.311 rimaqkuna, 93,5% (2002)" },
        { "cell": "signs", "text": "Lophonetta specularioides = Anas specularoides (kastilla simipi: pato cordillerano)" },
        { "cell": "dotted", "text": "Awya Yala, Apya Yala icha Awyala nisqaqa (Kuna simimanta Abya-yala, Qhichwa simipi: Puqusqa pacha, Qunti Kuskanrunp'u, Kichwa simipi: Pantinsaya), Amirika icha Amerika nisqapas Tiksi muyup huk allpa pachanmi. Mu Lan Pi (Chunwa simipi. 1100 K. q.) chaymanta Mulanpi" },
        { "cell": "dotted", "text": "Anqash. s. Anqash suyu, Piruwpi. 818 289 tiyaqkuna 1981 watapi." },
        { "cell": "dotted", "text": "Diamantes y Pedernales. Agua (Willakuykuna, Juan Mejía Baca y P.L. Villanueva, editores, Lima, 1954)" },
        { "cell": "dotted", "text": "Hacha hacha sumaqkay rankachikuqyuq, Machupíkchu pukara tiyaykan hatikasa Qosqo chawpi Antikunapi. Kaykan 2.430 t. q. s. h. . Qusqu (Qosqo) llaqtamantaqa 70 km. karum." },
        { "cell": "dotted", "text": "Paquchakunaqa kancha kanchalla tiyanku, achkan achkanpi. Sapa watan puna lumakunapi itaq pampakunapi Andes sutichasqapi, kasqallantak Arhintina, Wuliwiya, Chili, Ikwayur, hinallatakpis Piruw suyupi, kay suyupi allin mirachisqa mahdakuna kashkan, hastanmantapis hanan sayakunapi tiyanku 3500 - 5000&nbsp;m s. n. m. kaman, kashallantakmi paqucha uywahkuna Hukllachasqa Amirika Suyukuna, Iwrupa, itaq Musuq Silanda" },
        { "cell": "dotted", "text": "Sánchez, Luis Alberto: La literatura peruana. Derrotero para una historia cultural del Perú, tomo V, págs. 1524 A 1526. Cuarta edición y definitiva. Lima, P. L. Villanueva Editor, 1975." },
        { "cell": "dotted", "text": "Toro Montalvo, César: Historia de la Literatura Peruana. Tomo X. Siglo XX. Poesía - Teatro (1900-1995). Lima, A.F.A. Editores, 1996. Primera Edición." },
        { "cell": "dotted", "text": "1992 Diversidad y unificación léxica en el mundo andino. En Godenzzi, Juan Carlos (Comp.) El quechua en debate: ideología normal y enseñanza. Cuzco: C.E.R.A. \"Bartolomé de Las Casas\", pp. 205-235." },
        { "cell": "era-marker", "text": "La literatura peruana. Derrotero para una historia cultural del Perú. 3a. ed. 5 vlms. Lima, Ediventas, S.A. 1963." },
        { "cell": "era-marker", "text": "Historia General de América. Reedición, 3 tomos Editorial DESA S.A. 1987." },
        { "cell": "era-marker", "text": "12-I-1900: iskay rakiy, Chinchay Yunka pruwinsya Uralan Yunka pruwinsyapas (D.S. 1-VII-1899, José Manuel Pando, umalliq)" },
        { "cell": "era-marker", "text": "American Alpine Club, American Alpine Journal, N.Y. 1974" },
        { "cell": "era-marker", "text": "Observaciones al dixtámen de los señores Cisneros y garcía en la cuestión relativa al salitre. Lima : s.n. 1875" },
        { "cell": "era-marker", "text": "John Biggar: The Andes. A Guide for Climbers. p. 108" },
        { "cell": "era-marker", "text": "Willem F. H. Adelaar, Pieter Muysken (2004): The Languages of the Andes. p. 242-249. A sketch of a Peruvian Quechua dialect (Pacaraos)" },
        { "cell": "era-marker", "text": "John Biggar: The Andes. A Guide for Climbers. p. 121" },
        { "cell": "year", "text": "Villarrica, 2840&nbsp;m (Arawkaniya Suyu)" },
        { "cell": "year", "text": "Hudson, 1905&nbsp;m, XI. Region (Aysin Suyu)" },
        { "cell": "year", "text": "Punchaw Ispañamanta 14 ñiqin aymuray killapi 1811 watapi" },
        { "cell": "year", "text": "Kay suyukunaqa hatun orqukunap chawpinpim kachkan (2300 msnm-manta wisq'asqa). Kaypiqa aswan achka runasimim parlakun." },
        { "cell": "year", "text": "3000 ñp watamanta 2500ñp watakama, Supi qichwapi, Karal ruynakuna (Norte Chico sibilisayun), prinsipalmente rumi wasimanta rurachisqa, rikurikunmi. 1000 ñp wataniqmanta - 200 ñp wataniqkama, Anti Walla lliwninpi -pumatam, amarutam, kunturtapas wakashina muchaq- Chavin kulturaqa puqurikusqanmi. Chaymanta, chalapa hananpi Chimu kulturaqa 100 qp-niqmanta - 700 qp-niqkama Truhillu llaqtapa hawanpi Inti Wakatam, Killa Wakatapashmi konstruisqanku. Chalapa urayninpitaq, 1 qp-niqmanta 600 qp-niqkama, iñinkupaq, tarpunankupaq qiqukunatam qillqakuq Nasqa kulturaqa puqurisqanmi." },
        { "cell": "year", "text": "800 qp wataniqpi, Antikunap Urayninpi Ayakuchu pukrupi Wari kulturaqa paqarisqanmi. Tiwanakupa iñiyninmanta ancha influensyayuq kultura kasqanta hamurpakusqansi kan. Sapa suyupa llimpinkunatan riqsichikuqmi chaypas, sañururasqapi aywasqakunapi shukllachisqa temaqa t'iktusqa kanraqmi. Inka Qhapaq Ñanpa wamaqnin ñanqa puqurichisqanmanta, shinallataq, heometrichasqa -tawakuchuta chimpakuq- llaqtapa wasichakuyninmanta, Wari Imperyu theoriqa -lliw Antikunapi mastarikuq kaspa- riqsichikusqanmi. Shinallataq, 1000-niq watakama qatikusqanta hamurpakusqansi kan. Chalapa hanayninpi Lampayiqi suyupiqa -qurimantapas tumpagamantapas chaninchasqa saynatata rurakuqmanta riqsichsiqa- Sikan kulturaqa Waripa tukuyninpachapi puqurisqanmi" },
        { "cell": "year", "text": "Unay pacha conquistasqamanta Piruw llaqtaqa kimsa hatunsuyuman t`ipisqa kaqkasqa: Chala (Costa) nisqa Pasiphiku mama quchawan tinkusqa; chaymantataq Walla (Sierra) nisqa hanan pata llaqtakuna; chaymantataq Urqu (montaña) nisqa Amarumayu sach'a-sach'a suyu (Selva Amazónica) nisqa karqan. Kayhinaman t'ipisqaqa 1941 watakamallan kaq kasqa; imaraykuchus chhaqay III Asamblea General del Instituto Panamericano de Geografía e Historia nisqaqa pusaq regionman t`ipiytan apruwasqaku, chaymanta Geógrafo nisqa Javier Pulgar Vidal nisqa yuyasqa. Kay musuq t`ipiyqa Mapa Fisiográfico nisqatan rikhurichisqa, chaymi chiqan biogeografican; hinamantan kayhina suyukuna rikhurisqa:" },
        { "cell": "year", "text": "Nisqalla Dimukratiya (Democracia nominal), 1824 – 1895" },
        { "cell": "decimals", "text": "Mapuchi simi (Mapudungun) (30.000 rimaq)" },
        { "cell": "decimals", "text": "Kastilla simi: 4 000 000 rimaqkuna (chaymanta 3.500.000 waraniyitapas rimaqkuna)" },
        { "cell": "decimals", "text": "Turistiku llaqtaqa Qusqu, chay Qusqupiqa Machu Pikchu unay llaqta kan, hinaspa Willka Qhichwa kan. Mayutata suyupi tarikullantaq Manu mamallaqta parki. Punu suyupitaq Titiqaqa qucha, hinaspa Sillustanipi chullpakuna kan. Ariqipa suyupitaq Misti nina urqu, Qullqa qhichwa hinaspapis Nina Urqu Qhichwa (Valle de los volcanes) tarikullantaq. Ika suyupitaq Naska siq'ikuna hinaspapis Paraqas mamallaqta parki chaykuna kan. Anqash suyupitaq Waylas qhichwa hinaspa Waskaran (6,768 m) chaykuna kan. Ikitus llaqtapitaq llipin sach'akunayuq selva hinaspa Amarumayu hatun mayu ima kan; Tumpis suyupitaq ima munay playakuna kan. Lampalliqipitaq Valle de las Pirámides hinaspa Tesoros de Sipan nisqakuna kan. Kashamarka suyu Inka armakuna hinaspa sumaq campiñayuq. Qispi kay suyutaq unay pacha mawk'a Chan Chan llaqtayuq." },
        { "cell": "decimals", "text": "Prasil, Brasil icha Pinruramaqa (Waraniyi simipi: Pindoráma, Purtuyis simipi: República Federativa do Brasil) Urin Apya Yalapi mama llaqtam. Uma llaqtanqa Prasilia llaqtam. Prasilpiqa 184.101.109 runakunam kawsachkanku (2004)." },
        { "cell": "decimals", "text": "Qusqu icha Qosqo (ispaña simipi: Cusco icha Cuzco) nisqaqa Piruw mama llaqtapi huk hatun llaqtam, Qusqu suyup uma llaqtanmi. Qusqu llaqtapi 329.203 tiyaq (runa) kawsachkanku (2005)." },
        { "cell": "decimals", "text": "Winisuyla icha Winiswila (kastilla simipi: Venezuela) Urin Awya Yalapi mama llaqtam. Uma llaqtanqa Karakas llaqtam. Winisuylapiqa 28 549 745 runa kawsachkanku (2009). Hanaq kay: 916.445 km²." },
        { "cell": "decimals", "text": "Wayuwu simi (119.000 rimaqkuna, Marakaywu quchap patanpi)" },
        { "cell": "decimals", "text": "Kulunyiru aliman simi (10.000 rimaqkuna)" },
        { "cell": "ordinal-latin", "text": "(1. Busqueda de páginas seleccionadas: sample.pdf / 2.Bajar archivo comprimido: zip)" },
        { "cell": "ordinal-latin", "text": "Wasi Ruraymanta. Rimana 2, Kuskanchik Yachasunchik, Qichwa, Yachana 16, p. 61-64. Perú Suyupi Yachay Kamayuq, Lima 2013." },
        { "cell": "ordinal-latin", "text": "¿Cuántos cuentos cuentas tú?: laminas de secuencia para castellano como segunda lengua .- Lima: Ministerio de Educación. Dirección Nacional de Educación Bilingue Intercultural, 2005. ESPAÑOL / ENSEÑANZA / COMUNICACIÓN / EUCACION |BILINGUE" },
        { "cell": "ordinal-latin", "text": "Crónica de San Gabriel (1960) - Mama llaqta Suñay 1960. San Kaprilpa unay musya" },
        { "cell": "ordinal-latin", "text": "Tauro del Pino, Alberto: Enciclopedia Ilustrada del Perú. Tercera Edición. Tomo 1. AAA/ANG. Lima, PEISA, 2001. ISBN 9972-40-150-2" },
        { "cell": "ordinal-latin", "text": "El rayo que no cesa, Madrid, Héroe, 1936. Mana shaykuq illaqu." },
        { "cell": "ordinal-latin", "text": "Seis poemas inéditos y nueve más, Alicante, Col. Ifach, 1951. Manaraq maqtsishqa suqta hawari, isqun yapayuq." },
        { "cell": "ordinal-latin", "text": "Teatro en la guerra, Alicante, Socorro Rojo Internacional, 1938. Maqanakuychaw aranwapaq." },
        { "cell": "units", "text": "Río Salado (Buenos Aires), 700 km, 88 m³/s" },
        { "cell": "units", "text": "Colico qucha, 56 km², IX. Region (Arawkaniya Suyu)" },
        { "cell": "units", "text": "Caburga qucha, 51 km², IX. Region (Arawkaniya Suyu)" },
        { "cell": "units", "text": "Villarrica qucha, 176 km², IX. Region (Arawkaniya Suyu)" },
        { "cell": "units", "text": "Calafquén qucha, 120 km², IX. Region (Arawkaniya Suyu) / (Quchakuna Suyu)" },
        { "cell": "units", "text": "Panguipulli qucha, 116 km² (Quchakuna Suyu)" },
        { "cell": "units", "text": "Llanquihue qucha, 860 km² (Quchakuna Suyu)" },
        { "cell": "units", "text": "Maypu mayu, 250 km (Metropolitana suyu) / Walparaysu Suyu)" },
        { "cell": "ranges", "text": "Kay suyukunaqa mama quchap patanpim kachkan (0-500 msnm). Kaypiqa inti k'anchay hinaspa ch'aki allpakunam kan:" },
        { "cell": "ranges", "text": "Chaqrusqa Qillqayatiqpa Dimukratiyan (Democracia mixta alfabeta), 1956 – 1978" },
        { "cell": "ranges", "text": "843-1806 Aliman Nasyunpa Willka Romanu Qhapaq Suyun" },
        { "cell": "ranges", "text": "1806-1871 Aliman mama llaqta mana karqanchu" },
        { "cell": "ranges", "text": "1933-1945 Nasyunal-susyalista pusaq suyu (Pusaq, \"Führer\" nisqa: Adolf Hitler)" },
        { "cell": "ranges", "text": "1945-1949 Aliyadukunap ukupasyun suyunkuna" },
        { "cell": "ranges", "text": "1949-1990 iskay aliman mama llaqtakuna: Aliman&nbsp;Dimukratiku&nbsp;Republika, Tantasqa&nbsp;Republika&nbsp;Alimanya" },
        { "cell": "ranges", "text": "1939-1945 Iskay ñiqin pachantin maqanakuy" },
        { "cell": "currency", "text": "Ahinataq, pachak amirikanu sintuqa huk amirikanu dollarmi: &nbsp;&bull; 100 ¢ = 1 $" },
        { "cell": "currency", "text": "Aswan pisi qullqi junt’achina kay unquypaq kay Estados Unidospi wawaspaq $350.000.000 kan." },
        { "cell": "currency", "text": "2010 (Google Inc., US$ 49,600): Corpus Caucasicum" },
        { "cell": "currency", "text": "Mu 1925, Crosby adapita ku Los Angeles (California) ndi Rinker, yemwe mlongo wake Mildred Bailey anali kale wojambula wodziwika mu mzindawo. Anali iye yemwe kudzera mukulumikizana nawo pachiwonetsero adatha kuyambitsa achinyamata awiriwo kutchuka, akugwira ntchito m'magazini ya The Syncopation Idea, amalandira $ 75 pasabata. Pambuyo pake adapanga zoyeserera zawo, zomwe zidakopa chidwi cha wochititsa wotchuka Paul Whiteman, yemwe adafuna kudzipatula pakati pa magulu ena nthawi ndikupereka chiwonetsero chachikulu. Mu Okutobala 1926, Crosby adapanga kujambula koyamba kwa Columbia Record ndi Rinker, ndi nyimbo \"Ndapeza Mtsikanayo\"." },
        { "cell": "currency", "text": "Kafukufuku wa 2000 adapeza kuti ndi matikiti akanema okwana 1,077,900,000 omwe agulitsidwa, Crosby anali wachitatu wodziwika kwambiri nthawi zonse, kumbuyo kwa Clark Gable (1,168,300,000) ndi John Wayne (1,114,000,000). International Motion Chithunzi Almanac imayika pamndandanda wachiwiri pamalo onse omwe azikhala ndi nyenyezi yoyamba ndi nambala 1 ndi Clint Eastwood, Tom Hanks ndi Burt Reynolds. Kanema wake wotchuka, White Christmas, adapeza $ 30 miliyoni mu 1954 ($ 286 miliyoni mu mtengo wapano)." },
        { "cell": "currency", "text": "#from:1100 till:1532 $broad $center1 color:blue textcolor:blue text:Mangomarca" },
        { "cell": "currency", "text": "ChatGPT huk prututipu hina 30 ñiqin inti raymi killapi 2022 watapi qallarisqa, chaymanta usqhaylla qhawayta huñurqan sut'i kutichiyninkunarayku chaymanta artikuladu kutichiyninkunarayku achka yachaypa domainkunapi. Mana kaqlla chiqap kayninmi riqsichikurqa huk hatun mana allin kananpaq. ChatGPT lluqsisqanmanta qhipaman, OpenAI $29 waranqa hunu dularwan chaninchasqa karqan." },
        { "cell": "currency", "text": "OpenAI huk Hukllachasqa Amirika Mamallaqtakunamanta kapchisqa yuyay (AI) mask'ay hamut'aywasi, qullqi urqunapaq imprisa OpenAI LP kaqmanta chaymanta tata impirisanmanta, OpenAI Inc mana qullqi urqunanpaq. Imprisaqa AI nisqapi taripanata ruwan, chay nisqa chayanawan, masichakuq kapchisqa yuyay (freindly AI) nisqa allin kananpaq, wiñachiypas, llapan runaq allinninpaq hina. Kay tantanakuyqa San Francisco llaqtapi, 2015 watapi Sam Altman, Elon Musk, Reid Hoffman, Jessica Livingstonwan, icha waq runakunawapis, hukllamanta kamasqa karqan , paykuna huñusqa $1 waranqa hunu USD dularta qurqanku. Muskqa 2018 watapi huknusqa rukuchunamanta lluqsirqan ichataq qullqi quq hina qhipakurqan. 2019 watapi OpenAI LP $1 waranqa hunu USD chaskirqan qullqi churay Microsoft kaqmanta. OpenAI nisqaqa Yachanan Distritupi, San Francisco llaqtapi, Pioneer Building nisqapi umalliq wasiyuq." },
        { "cell": "abbrev", "text": "Formal shutiqa ofisyal kastilla simipi, \"República del Perú\"-mi kan. Qichwa simipi, \"Piruw Mamallaqta\"-mi kan wan \"Piruw Ripuwlika\"-mi kan, Aymar simipipash \"Piruw Jacha Suyu\"-mi kan. Inlish formal shutillataqmi \"Republic of Peru\" kan. Llaqtashutiqa Qichwapi \"Piruwruna\"-mi kan, Inlish simipi \"Peruvian\" kantaqmi." },
        { "cell": "abbrev", "text": "Perup sutinpa pukyunmanta achka theorikunami kan. XVI siklu qallarichkasqapi, Panama ismupa San Miguel Bahianiraqpi dominakuq kamachiq biru sutichasqami, chaymanta shamunsi. Panamapa uranpi Biru sutichasqa qullqiyuq mamallaqta kaq, indihina rimasqanmanta uyarispaqa, hispanarunaqa shamusqanku chay kit'iman, chaymi Peru - shina sutinchakun. Chaymanta, kastilla konkistadorkunapaq Tawantinsuyuta Piruwsina sutichasqa kapun. Chaymanta Peru sutiqa kay suyupaq riqsichinanpaq kunankama kutipakullantaqmi" },
        { "cell": "abbrev", "text": "Me encargaría de traducir estas tablas al quechua, en las proximas, pero todavía me faltan las denominaciones en quechua de los indicadores principales, como superficie, población, forma de estado etc. Por favor, si alguien sabe la denominación correcta de alguno de estos indicadores, que los traduzca al quechua y reemplaze los términos en castellano de la tabla abajo por los en quechua." },
        { "cell": "abbrev", "text": "Hinusuyu, Hinu k'iti, Phinusuyu, Hinis suyu, Hinishallp'a, Suwami icha Hinlanriya (Phinis simipi Suomi, Suysu simipi Finland) Chincha Iwrupapi mama llaqta kan. Uma llaqtanqa Helsinki (Suysiya simipi: Helsingfors) llaqtam. Qispi llaqtap kamachiynin kan. Hatun kamachiq warmi kan, pay Sauli Niinistö sutikun." },
        { "cell": "abbrev", "text": "Tawantinsuyu nisqaqa Inkakunap mama llaqtankus karqan, tawantin suyuyuq kaq. Qusqu llaqtas uma llaqtan kaptin, unanchankutaq wiphalas karqan. Kunan pachaqa Antikunap runankunam kikinkunatapas llaqta suyunkunatapas kawsay saphintapas Tawantinsuyu nikunku." },
        { "cell": "abbrev", "text": "Ripuwlika icha Ripuplikaqa (kastilla simimanta: República, latin simipi: res publica) mama llaqtayuq runakuna kamachiyniyuq mama llaqtam. Manam huklla sapan qhapaqchu kan. Ripuwlikap umalliq nisqa pusaq runantaqa mama llaqtayuq runakunam akllanku." },
        { "cell": "abbrev", "text": "Chicha sutiyuqqa achka laya upyanakunam, principalmente sarapa 、 waq Awyalamanta sirialpa -manam destilasqa- fermentasyuninmanta derivasqam kan. Maski, en menor medida, achkalaya sirialpa 、 frutapa fermentasyuninmantapas preparapayanku" },
        { "cell": "abbrev", "text": "Ispaña icha Kastillasuyu Iwrupapi llaqtam, k'itim. Uma llaqtanqa Madrid llaqtam." },
        { "cell": "latin-in-native", "text": "A, a nisqaqa latin siq'i llumpapi huk kaq sanampam. Qhichwa simipitaq huk kaqpas sanampam, hanllalli kunkapaqmi." },
        { "cell": "latin-in-native", "text": "B, b nisqaqa latin siq'i llumpapi iskay kaq sanampam. Qhichwa simipiqa huk rimaykunamanta simikunallapim." },
        { "cell": "latin-in-native", "text": "C, c nisqaqa latin siq'i llumpapi kimsa kaq sanampam. Qhichwa simipiqa ch nisqa t'inkisqa sanampallapim (urin runasimipitaq ch, chh nisqa t'inkisqa sanampakunapipas, Wanka, Kashamarka, Inkawasi rimaykunapitaq ĉ nisqa waki sanampapim)." },
        { "cell": "latin-in-native", "text": "Romanu simikunapiqa c sanampataqa e, i, y ñawpanpi [ s ] hinam rimanku, manataq [ k ] hinam. Chayrayku qhichwa simipi wamaq rimaykunamanta hap'isqa simikunataqa s, k sanampakunawanmi qillqanchik." },
        { "cell": "latin-in-native", "text": "D, d nisqaqa latin siq'i llumpapi tawa kaq sanampam. Qhichwa simipiqa huk rimaykunamanta simikunallapim." },
        { "cell": "latin-in-native", "text": "Ll, ll nisqaqa huk t'inkisqa sanampam, qhichwa simipi qanchis kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "latin-in-native", "text": "M, m nisqaqa latin siq'i llumpapi chunka kimsayuq kaq sanampam. Qhichwa simipitaq pusaq kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "latin-in-native", "text": "N, n nisqaqa latin siq'i llumpapi chunka tawayuq kaq sanampam. Qhichwa simipitaq isqun kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "percent", "text": "Kay pruwinsyakunapi aswanta qhichwa simitam rimanku 1993 watapi: Kallawaya (88,1%), Lampa (85,0%), Asankaru (83,3%), Melgar (76,9%)." },
        { "cell": "percent", "text": "Kay pruwinsyakunapi aswanta huk indihina simitam (aswanta aymara simitam) rimanku 1993 watapi: Muhu (87,2%), Yunkuyu (82,5%), Chukuwitu (81,2%), Qullaw (80,9%), Wankani (60,2%)." },
        { "cell": "percent", "text": "Chakrapura k'itikuna: 93% aymara simi rimaq" },
        { "cell": "percent", "text": "Chuqiyapu: 40% aymara simi rimaq, 10% qhichwa simi rimaq, 54% kastilla simi rimaq" },
        { "cell": "percent", "text": "Altu llaqta 60% aymara simi rimaq, 53% aymara simi/kastilla simi, 35% kastilla simi" },
        { "cell": "percent", "text": "Umasuyu pruwinsiya: 96% aymara simi rimaq" },
        { "cell": "percent", "text": "Franz Tamayo pruwinsiya: 98% aymara simi rimaq, 16% qhichwa simi rimaq" },
        { "cell": "percent", "text": "Wiyacha llaqta 60% aymara, 55% aymara/kastilla simi, 38% kastilla simi" },
        { "cell": "rate", "text": "2006 watapi Puliwya suyupi 9.627.269 runa kawsasqan (8,76 runa/km²)." },
        { "cell": "rate", "text": "Piruwpas Piluta hayt'aq: mejor promedio de gol en competencias iwrupa, 72 golkuna oficiales en 122 partidukuna wan 0,59 gol/partido." },
        { "cell": "rate", "text": "Chuwilla (kastilla simipi: Chuhuilla) nisqaqa Antikunapi, Buliwya suyupi, huk urqum Buliwyap Kunti Wallanpi, P'utuqsi suyupi, Chinchay Lipis pruwinsyapi, Qulcha \"K\" munisipyupi, Suniqira kantunpi. Pikchunqa mama quchamanta 5.279 m / 5.435 m / mitrum aswan hanaq." },
        { "cell": "rate", "text": "1948 - 3 Godfathers /Los tres hijos del diablo /Los tres padrinos" },
        { "cell": "rate", "text": "\"Non è facile avere 18 anni / Son finite le vacanze\" (1964)" },
        { "cell": "rate", "text": "Sapa miray mana antaq'aytuyuq karurimana allwiyakama riqsichisqa yapasqa sakha waskhar usqaylla chaymanta llika atiy. 4G 150kama usqaylla puriyniyuq Mbit/s hurayk'uchisqa, 50 Mbit/s hunt'achikuq, maypichus 3G 7.2 pico velocidadniyuq karqa Mbit/s uraykachiy hinaspa 2 Mbit/s nisqa apachiy." },
        { "cell": "rate", "text": "Antawaqalla ñuñu warani (ESO 350-40 icha PGC 2248 nisqapas) nisqaqa huk lenticular anillu ñuñuwaranim, yaqa 500 hunu k'anchay wata karum Sculptor hawa phuyu huñupi. D 25 isofotal diámetro 44.23 kiloparsec (144,300 wata k'ancha), yaqa 2.9–4.8 × 109 inti masayuq masayuq; hawa anillunqa 217 km/s muyuriq rit'iyuq." },
        { "cell": "rate", "text": "Huk Phutun, P'unchaw icha Uru (Ñawpa griego simipi: φῶς, φωτός; \"K'ancha\") nisqaqa huk tiksi k'atacham, illatari llut'ariy nisqaqta machkhana, k'anchaypas radiyu wallchha hina illari-llut'ariy nisqaqta llimp'inpas, illari kallpapaq kallpa apaykachanapas. Phutunkunaqa mana masayuq, chay sapa kuti kuyunku k'anchaypa usqaylla puriyninpi ch'usaqpi, 299792 458 m/s (icha yaqa 186,282 mi/s). Phutunqa boson nisqakunaqta klasiman kapun." },
        { "cell": "zero-width", "text": "Taytan: Juan Pantaleón Jaramillo Erazo, Maman: Apolonia Laurido Cáceres. Warmikuna: María Eudocia Rivera (1955) / Anamelba (1957) / Gloria Reich (1958) / Coralia Valle (1960) / Nancy Arroyo (1970). ​Churinkuna: Pepe Jaramillo, Ielda Jaramillo Pinzás, Julio Jaramillo Arroyo wan Arnau Gazquez." },
        { "cell": "zero-width", "text": "Chandrika Bandaranaike Kumaratunga sutiyuq warmiqa (Sinhala simi: චන්ද්‍රිකා බන්ඩාරනායක කුමාරතුංග, Tamil simi: சந்திரிகா பண்டாரநாயக்க குமாரதுங்க) (* paqarisqa Kulumbu llaqtapi - llaqtapi). Sri Lanka mama llaqtap Umalliqpi pulitiku." },
        { "cell": "zero-width", "text": "Ali Hoseiní Khamenei (Pharsi simipi: سید علی حسینی خامنه‌ای ), sutiyuq runaqa, (1939-2026), huk mama llaqtayuq Muslim Dyusmanta yachachiq pusaqmi qarqan." },
        { "cell": "zero-width", "text": "Qusan: Serguéi Yesenin; Jules Grandjouan, André Caplet, Paris Singer, Edward Gordon Craig, Mercedes de Acosta.​ Churinkuna: Deirdre Beatrice Craig (1906-1913) wan Patrick Augustus Singer (1910-1913)." },
        { "cell": "zero-width", "text": "Taytan: Andrés Samper Gnecco; Maman: Helena Pizano de Samper. Warmi: Silvia Arbeláez (c. 1972)1​ / Jacquin Strouss Lucena (1979-). Churinkuna: Andrés Samper Arbeláez, Felipe Samper Strouss wan Miguel Samper Strouss." },
        { "cell": "zero-width", "text": "Taytan: Joaquín Fernández Lindo Molina​, Maman: Bárbara Zelaya Fiallos. Warmi: Josefa Pineda Castejón. Churinkuna:." },
        { "cell": "zero-width", "text": "Taytan: Carlos Alberto Ayllón; Maman: Renee Urbina († ). Qusan: Juan Yamasaki (2005-2007). Churinkuna: Carlos Yamasaki Ayllón wan​ Francisco García Ayllón." },
        { "cell": "zero-width", "text": "Taytan: Edgardo Rebagliati Raybaud​; Maman: Concepción Martins de Rebagliati. Warmi: Emma Meyer Cárdenas. Churinkuna: (5) Edgardo Rebagliati Meyer; Enrique Rebagliati Meyer; Olga Rebagliati de Pinillos; Enma Rebagliati de Malachowski; Rosa Rebagliati de Montes." },
        { "cell": "roman", "text": "Hinallataqsi urinnin suyupiqa Tiwanaku’qa, paqarimurqan, llapan Qullaw patapi chimpaq aylluhina. Chanta Wari Aylluqa paqarikusqan, Antis Llaqta wallpamata puquchirqan, imperiu laya llaqta paqarichispaqa, kay wallpamaqa hanaqninman mastakusqa XVIII pachaqkama. IX pachaqmanta, Wari saqipusqanmanta, Antis Wallanta mushuq chawpichaq llaqtakunaqa paqarikusqan, Lampayiqi, Chimu, Chincha hina, “qipa intermediu” “suyu-suyu llaqta” sutichasqa." },
        { "cell": "roman", "text": "XV siklupi, Inkakuna paqarimusqan kallpasapa istadushina, shuk siklullapi ñawpaq Colon Awyalakunapi hatunnin suyutam kutichimushqa, Qusqu umallaqtanwan. Qallariq Qusqu’pa Inkankunaqa shuk uchuy etniku qututa kakuhsqanku, Qichwa’kunashina sutichasqa. Aslla asllamanta, kimsachunka siklumanta, mastariyta qallarirqanku, chaywan chimpaqinkunata wankuriyta qallarishqanku. Inka’pa mastariyninqa chunka pisqa siklukama hayralla kashqa, piru chay pachamanta llalliypa utqayninta wichayta qallarishqa, wamaqllamanta Pachakuti Inka qapaqchashqan pachapi. Paypa, churinpa (Thupa Inka Yupanki) kamachishqankupi, Inkakunaqa tukuymari Antis suyuta kamachiyta atishqanku, qapaqchashqankupi runakunataqri 9 hunumanta 16 hunukama kashqa. Pachakuti’qa hunta ley sanampata takyachimushqa, hatunsaya imperiunta allinta kamachinapaq, chaywanpash Inti’pa churinshina tukuy-atikuq ispiritu-kamachiq awturidadmi kallpachamushqa, -musuqta wasichashqa- Qusqu markamanta kamachispa." },
        { "cell": "roman", "text": "Inka taytanchiskunaq kawsayninta yacharispa. Instituto Superior Público la Salle, proyecto CRAM II, Urubamba, Qusqu 2002." },
        { "cell": "roman", "text": "Región XIV I-pas (Arika Parinaqutapas suyu Tarapaka suyupas): Tarapaka, Arica, Iquique, 15.439 runa" },
        { "cell": "roman", "text": "Región II (Antofagasta suyu): 4.187 runa" },
        { "cell": "roman", "text": "Región VI (Libertador General Bernardo O'Higgins suyu): 1.316 runa" },
        { "cell": "roman", "text": "Región XIV, X-pas (Mayukuna suyu Quchakuna suyupas): 1.602 runa" },
        { "cell": "roman", "text": "Región XII (Magallanes Antartika suyu): 203 runa" },
        { "cell": "initialism", "text": "O, o nisqaqa latin siq'i llumpapi chunka pichqayuq kaq sanampam, hanllallipaq. Qhichwa simipitaq wamaq rimaykunamanta simikunallapim. QSHKS runakunataq qillqankum, \"qhichwa simipi pichqantin hanllallim\" nispa, chay o-taq u kunkapaq q-wan rimasqa huk rimay hinalla kaptinpas, ahinataq:" },
        { "cell": "initialism", "text": "INDEPA, Piruwpa llaqta takin (kastilla simipi widyum)" },
        { "cell": "initialism", "text": "INDEPA, Piruwpa llaqta takin (qhichwa simipi widyum)" },
        { "cell": "initialism", "text": "INDEPA, Piruwpa llaqta takin (aymara simipi widyum)" },
        { "cell": "initialism", "text": "INDEPA, Piruwpa llaqta takin (ashaninka simipi widyum)" },
        { "cell": "initialism", "text": "INDEPA, Piruwpa llaqta takin (awahun simipi widyum)" },
        { "cell": "initialism", "text": "Para empezar, hay que encontrar un formato común en la tabla con los datos básicos. Propongo que se use el formato de las tablas que se usa en la Wikipedia alemana, en la que se usa el lenguaje propio a la Wikipedia, en vez del formato de la Wikipedia en castellano, que usa HTML, lo que hace mucho más dificil y complicado editar los datos de la tabla." },
        { "cell": "initialism", "text": "Unquy hark'aypa chaskisqa waqlliynin UHCW, SIDA icha AIDS nisqaqa runa unquy hark'ay waqlliy añaw (HIV, VIH) nisqa añawkunap paqarichisqan, runap unquy hark'ayninta ch'utiq, yuquywan qatichisqa (yuquy unquy nisqa), ancha chiki (maqlluq) unquymi. Achka runakunam chay unquywan wañun." },
        { "cell": "grouped", "text": "Purtuyis simi: 500 000 rimaqkuna (Brasilmanta hamuq, wamaq runakuna)" },
        { "cell": "grouped", "text": "Aliman simi, Plawtich simi: 200 000 rimaqkuna (iwanhiliku runakuna Hatun Chakupi)" },
        { "cell": "grouped", "text": "Kastilla simi (tukri simi hina llamk'achisqa): 16 000 000 rimaq" },
        { "cell": "grouped", "text": "Waraniyi simi: 200 000 rimaqkuna (Parawayiwan saywapi)" },
        { "cell": "grouped", "text": "Tupi simi (Ñengatu): 30 000 rimaqkuna (Yanamayu patapi)" },
        { "cell": "grouped", "text": "Surinam llaqtaqa Urin Awya Yalapi huk mama llaqtam. Surinampiqa 487.024 runakunam kawsachkanku." },
        { "cell": "grouped", "text": "1780 Wata Hatun Pillunkuy nisqaqa Awya Yalap Atlantiku mama quchap chalanwan ancha hatun pillunkuysi karqan. Chay wayramantaqa achkam wañuq runa yupasqa karqan. Martiniquepi, San Eustatiuspi, Barbadospi pichaptirqan yaqam 22.000 runa wañurqan. Payrayku aswan runapas huq kitipi wañurqanku." },
        { "cell": "grouped", "text": "Mayukuna: Guadalquivir (657 km) - Ebro (910 km) - Tajo (1.007 km) - Duero (895 km)" },
        { "cell": "signed-number", "text": "Allin profesional kananpaq, Universidad Nacional Mayor de San Marcos especializakun Etnología yachaypi, grado de bachillerkaman chayarqa 20 -12 -1957 tesista La Evolucion de las Comunidades Indigenas sutiyuqta ruwarqa, chay llamkaywanpas Premio Nacional Fomento a la Cultura Javier Prado sutiyuqta 1958 watapi llallillantaq. Chaymi qallariy kutipi Europaman rirqa, Unesco becata quptin, España llaqtapi, hinaspa Francia llaqtapipas achka ruwaykuna estudiananpaq. España llaqtapi kachkaspanmi, Arguedas Zamora comunidadkunapa chawpinpi tapukachakuspa maskarqa, maypim kay andino kawsayninchikpa España lawpi sapin nispan maskarqa, chaymi tesis dukturalninpaq allin kanqa: Las Comunidades de España y el Perú, chaywanmi pichqa punchaw julio killapi 1963 watapi graduwakurqa." },
        { "cell": "signed-number", "text": "2 + 5i\\,\\ wan\\ -8 + 17 i yarqun: (2 + 5i) + (-8 +17i) = (2 + -8) + (5 + 17) = -6 + 22i ; kamanpura yapantsik : rikcha patamakunata; muspa patmanatapis." },
        { "cell": "signed-number", "text": "Jean-Joseph Rabéarivelo (1901?/1902?/1904?-1937)" },
        { "cell": "signed-number", "text": "Kunturkunka (kastilla simipi: Condorcunca) nisqaqa Piruw mama llaqtapi huk urqum, Ayakuchu suyupi, Wamanqa pruwinsyapi, Kinwa distritupi. Pikchunqa mama quchamanta +4.200 mitrum aswan hanaq." },
        { "cell": "signed-number", "text": "# so shift texts up or down manually to avoid overlap shift:(25,-10)" },
        { "cell": "signed-number", "text": "Urqukuna: Chunta urqu (+4.600 m) - Murusq'asa (+4.000 m) - Puywanniyuq (+4.400 m) - Tullpa Rumi (+4.600 m) - Uchuy Pirwalla (+4.600 m)" },
        { "cell": "signed-number", "text": "Urqukuna: Achamarka - Arpachayuq - Chikllarasu (5.167 m) - Sasaylla (+4.600 m) - Saywaq'asa - Suyuqucha - Tampuchayuq (+4.800 m) - Tarukapunta - Wamanripayuq - Wamansa - Waranwallqa - Yawlillayuq" },
        { "cell": "signed-number", "text": "Urqukuna: Rasuwillka (Razuhuillca) (+4.800 m)" },
        { "cell": "letter-name", "text": "P, p nisqaqa latin siq'i llumpapi chunka suqtayuq kaq sanampam. Qhichwa simipitaq chunka hukniyuq kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "letter-name", "text": "S, s nisqaqa latin siq'i llumpapi chunka isqunniyuq kaq sanampam. Qhichwa simipitaq chunka tawayuq kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "letter-name", "text": "T, t nisqaqa latin siq'i llumpapi iskay chunka kaq sanampam. Qhichwa simipitaq chunka suqtayuq kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "letter-name", "text": "U, u nisqaqa latin siq'i llumpapi iskay chunka hukniyuq kaq sanampam. Qhichwa simipitaq chunka qanchisniyuq kaq sanampam, hanllalli kunkapaqmi." },
        { "cell": "letter-name", "text": "Y, y nisqaqa latin siq'i llumpapi iskay chunka pichqayuq kaq sanampam. Qhichwa simipitaq chunka isqunniyuq kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "letter-name", "text": "R, r nisqaqa latin siq'i llumpapi chunka pusaqniyuq kaq sanampam. Qhichwa simipitaq chunka kimsayuq kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "letter-name", "text": "Kachapuwal mayu, 172 km (Libertador General Bernardo O'Higgins suyu)" },
        { "cell": "letter-name", "text": "K, k nisqaqa latin siq'i llumpapi chunka hukniyuq kaq sanampam. Qhichwa simipitaq pichqa kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "exponent", "text": "Superficie (Área) - Surface (Area) [km²] - Hallka k'iti k'anchar [km²]" },
        { "cell": "exponent", "text": "Qullqaquyllur icha Mayu nisqaqa (latin simipi: Via Lactea) ñuñu waraninchikmi. Watiqaykunamanta, Qullqaquyllurmi huk wisnuyuqqa 10¹² intip wisnunkunahina, huk muyuqi k'aspim icha. Huk chayna-chayna 100.000 achkiy wata chawpi raqtawan, quyllur yachaqkuna Qullqaquyllurmi 200.000 hunu quylluryuq 400.000 hunu quylluryuqpas llup'inku. Intim Qullqaquyllurpa chawpinmantaqa 27.700-chá achkiy wata (8,5 kpc)." },
        { "cell": "exponent", "text": "Kiskachay (aymara simipi: Kiskachay jisk'a suyu; kastilla simipi: Provincia de Espinar) nisqaqa Piruw mama llaqtapi, Qusqu suyupi, huk pruwinsyam, Qusqu llaqtamanta 250 km karu uralan kuntinpi, mama quchap hawanmanta 3 800 mitru hanaqmanta 5.000 mitru hanaqkama, 5 311.09 km²-yuq. Uma llaqtanqa Yawri llaqtam." },
        { "cell": "exponent", "text": "Uyakuna tarpuytupunin (qaran tupu) T = 6l² ; chaypi, l = tupra tupu = tupra suni" },
        { "cell": "exponent", "text": "Wayru sayaynin = Warupa hakukaynin = l³ ; chaypi, l= tupra tupu" },
        { "cell": "exponent", "text": "Suisa, Suwisuhallp'a, Suwisa icha Suwishallp'a (Aliman simipi Schweiz, ransis simipi Suisse, Italia simipi Svizzera, Riturumanu simipi Svizra) Iwrupapi mama llaqtam. Uma llaqtanqa Bern llaqtam. Suwisapiqa 7.476.200 runakunam kawsachkanku (2005). Hanaq kay 41.285 km²." },
        { "cell": "exponent", "text": "Lac d’Annecy 27,59 km² , Haute-Savoie, Rhône-Alpes" },
        { "cell": "exponent", "text": "Lac du Bourget, 44.5 km², Savoie, Rhône-Alpes" },
        { "cell": "arithmetic", "text": "K'ili (\"Kele\") Centropelma microptera = Rollandia microptera" },
        { "cell": "arithmetic", "text": "Sichura atuq Pseudalopex sechurae = Dusicyon sechurae" },
        { "cell": "arithmetic", "text": "Antikuna atuq icha Piruwanu atuq (Dusicyon culpaeus = Pseudalopex culpaeus)" },
        { "cell": "arithmetic", "text": "Usqhullu icha Usqu misi (Felis colocolo = Leopardus colocolo)" },
        { "cell": "arithmetic", "text": "Antikuna atuq icha Piruwanu atuq (Lycalopex culpaeus = Pseudalopex culpaeus)" },
        { "cell": "arithmetic", "text": "Pili laya: Anas specularoides = Lophonetta specularioides (kastilla simipi: pato cordillerano)" },
        { "cell": "arithmetic", "text": "Atuq (Pseudalopex culpaeus = Dusicyon culpaeus)" },
        { "cell": "arithmetic", "text": "José María Arguedas: Warma kuyay y otros relatos [Yawar willay, Sapan Churi = Hijo solo]. Traducción als quechua de Gloria Cáceres Vargas. Edición bilingüe, con introducción de Gonzalo Espino Relucé. Lima, Editorial San Marcos, 2011." },
        { "cell": "ampersand", "text": "Tawa quchakuna (Qusqu: 107&nbsp;km): Pumaqanchi qucha, Aqupiya qucha, Asnaqucha, Pampamarka qucha (Qusqu:" },
        { "cell": "ampersand", "text": "Khallka llaqta (Qusqu: 50&nbsp;km); Huch'uy Qusqu raqaykuna; Machakancha armakuna; Minasmuqu; urqukuna: Pitusiray, Sawasiray." },
        { "cell": "ampersand", "text": "Qiswa chaka (Qusqu: 143&nbsp;km) (Q'iwi distritupi)" },
        { "cell": "ampersand", "text": "*Raqch'i (Wiraqucha) Qanchi pruwinsyapi (Qusqu llaqtamanta 112&nbsp;km karum)" },
        { "cell": "ampersand", "text": "Chuqik'iraw ( (Qusqu: 90&nbsp;km, Awankay: 123&nbsp;km, Cachora: 30&nbsp;km), (Awankay pruwinsyapi), Inka llaqta" },
        { "cell": "ampersand", "text": "Kimsatawa / Kimsa Krus / Kimsa chakana (Tres Cruzes) (Qusqu: 109&nbsp;km) Manu mamallaqta parkipi qhawana" },
        { "cell": "ampersand", "text": "Antawaylla (Qusqu: 45&nbsp;km); 1580 watamanta inlisya;" },
        { "cell": "ampersand", "text": "Tipun (Qusqu: 25&nbsp;km), 3.316 m; Intiwatana Pukutuyuj, Pukara, Muqu Krus, Pitupukyu ayamarka, Hatun Wayq'u." },
        { "cell": "sports-time", "text": "Piruwpi pacha kuyuy (2007) nisqaqa 15 ñiqin chakra yapuy killapi 2007, 23:40:56 UTC pachapi qallarirqan, 210 sikundu pachata kuyuchispa, 8.0 graduyuq. Qallariy chawpinqa Piruwpa chalanpi karqan, tawa chunka kilumitru Hanan Chinchamanta karu kuntinpi, pachak pichqa chunka kilumitru Lima llaqtamanta karum urin kuntinpi, kimsa chunka isqunniyuq kilumitru allpa pachap ukhunpi." },
        { "cell": "sports-time", "text": "Aytipi pacha kuyuy (2010) nisqaqa 12 ñiqin qhulla puquy killapi 2010, 21:53:10 UTC pachapi qallarirqan, 7.0 graduyuq." },
        { "cell": "sports-time", "text": "200 m estilo libre: 1:52.78 (1972, world record)" },
        { "cell": "sports-time", "text": "200 m estilo mariposa: 2:00.70 (1972, world record)" },
        { "cell": "sports-time", "text": "4×100 m estilo libre: 3:26.43 (1972, world record)" },
        { "cell": "sports-time", "text": "4×200 m estilo libre: 7:35.78 (1972, world record)" },
        { "cell": "sports-time", "text": "4×100 m medley: 3:48.16 (1972, world record)" },
        { "cell": "sports-time", "text": "Video:KUNTUR WACHANA. Director Federico García- Productora Pilar Roca / Tiempo: 1:26:35" },
        { "cell": "version-dot", "text": "Q'asakuna: Iskay Krus (4.350m) Mariscal Cáceres pruwinsyapi; Ventanas (4.200 m) Patazpi, Tahgarana (1.500 m) Lamas pruwinsyapi." },
        { "cell": "version-dot", "text": "Karikuchawan urqunkuna Phuya Phuya (Fuya Fuya) 4.294 m, Colocal 4.145m, Yanaurku (Yanahurcu) 4.272 m," },
        { "cell": "version-dot", "text": "Inga kichwa nisqaqa huk kichwa k'iti rimaymi, Kulumbyap Putumayu suyunpi tiyaq Inga runakunap rimayninmi, 25.000niraq rimaqniyuqmi." },
        { "cell": "version-dot", "text": "Yanashalla q'asa icha Yanashallash q'asa nisqaqa Antikunapi, Piruw mama llaqtapi, huk 4.650m hanaq q'asam, Wallanka wallapi, Anqash suyupi, Bolognesi pruwinsyapi, Akya distritupi, Wallanka distritupipas, Yanashallash urqu ñiqpi." },
        { "cell": "version-dot", "text": "1768 watamanta huk chawpi ñawiriywasi paqariyta munakurqan, achqa yachaqkunanpaq, sapa facultad kikin huñunakuna kaspaqa, huk aswan hatun ñawiriywasi ruwachiyta kananta. 1871 watapi, qhipa Chiliwan maqanakuy, tukuy ñawiriywasi ch'usaq karqan, hinaqsi XX siglopi, huk allin ñawiriywasi kamachiq, Pedro Zulen, Jorge Basadre-wan musuqllachiy ruwarirqanku, kamachirqanku kay chawpi ñawiriywasi, paykunaqa yuparqan tukuy qillqapanq'akunaqa, yupana churarqanku. Kunanpacha Pedro Zulen Chawpi Ñawiriywasi sinchi achka huñusqa informatización , musuqllachiy proyectokuna. Chawpi ñawiriywasi 19.800m² -pi purin, kaywan, Piruw mamallaqtapi sinchi hatun ñawiriywasi kapun, Awya Yalapi huk sinchi hatun hina kan. Tawa huñusqata wasikuna ruwan, tinkisqa kanku, pichk'a sarunakuna kapun, Mamallaqtap San Markus Hatun Yachay Sunturnin hawk'aypatan kachkan" },
        { "cell": "version-dot", "text": "ñkojdjepjskñijsd´pojep0uwew'DÑOFRNÑLRVIJWDRIKPIWRE9638++9R8+87+E7LD´WEOC22.76RTH7{B" },
        { "cell": "version-dot", "text": "DNK sayt'u polimeru m kikinchasqa unitatmanta hamun nuklustidi sutiyuq. Sapa kaykuna qiquyuq sapa qillqananwan: A, т, с, icha G kanman. DNKpa rakinakuqninqa sayt'u npi kuyuykachaqmi, imaynapas rikch'ahinaa qiwi nta atinman. Lliw kawsaqpi, iskay waskaryuqmi elisemanta rurasqam, paykunapura yakutiqsi t'inkiwan k'asqasqam. Waskarqa iskaynin kikin aksispi qiwirisqam kanku, hinallataq kikin 34 angstrom (3.4nm) tonuyuqmipas kanku. Iskayninpa radyunqa 10 Å (1.0 nm)-mi. Wakin hamut'a sqapaq, waknin solusyonpi tupuspaqa DNRqa 22–26 Å (2.2–2.6 nm) tupu n, hinaqsi huk nuklutidi unitasqa 3.3 Å (0.33 nm) sayt'uyuqmi tupun. . Sapanchasqa nuklutidi huch'uyllam kaptin, DNR polimer ancha hatunraq kanman; chaywan pachak hunu nuklutidiyuqmi kanman, kromoson 1 hina. Kromoson1 runapa aswan hatun kromoson mi, 220 hunu pitu basiyuqmi, sayt'uchasqataq 85mm tupusqa kanman," },
        { "cell": "version-dot", "text": "Chaytaqa tarirqanku Andes nisqapi kaq Parque Nacional Sangay nisqapi humedad montane sach’a-sach’api, 3.400manta 3.900 metrokama altitudpi. 167-184 mm suni kayninwan, Ikwadur mama llaqtapi Thomasomys nisqa rikch'aqkunamanta aswan hatunmi." },
        { "cell": "quote-letter", "text": "Chili, Chili k'iti icha Chilisuyuqa Urin Apya Yalapi llaqtam. Uma llaqtanqa Santiago de Chile llaqtam." },
        { "cell": "quote-letter", "text": "Manaraq América llaqtata tarichkaptinkuqa, Atacama chunniqpa urayninpi allpakunaqa Chili sutiyuqñam karqa indigenakunapa tradicionninpi. Huk kuti Musuq Castilla, Musuq Toledo llaqtakunapi tiyaptinku, Ispaña atipaqkunaqa chay sutiwanmi uralan suyuta suticharqanku, wakin kutitaq \"Chili wayq'u\" nispapas riqsirqanku, chay sutiqa qhipamanmi kunan pacha lliw suyuman mast'arikurqan." },
        { "cell": "quote-letter", "text": "Ariqkuna: Ampay - Chhachani - Chupiqiña - Hamp'atu urqu - Misti urqu" },
        { "cell": "quote-letter", "text": "Wat'akuna: Chincha wat'akunakuna - Ballestas wat'akuna - Yuraqwat'a - Titiqaqa wat'a - Amantani - Intika - Uru wat'akuna" },
        { "cell": "quote-letter", "text": "kuntur - tunki - wik'uña - chinchilla - charapa - tiwrun - khillaychuki challwa - chuqi challwa - samanna - pinwinu - quwi - añas - yukra - wisk'acha - mach'aqway - wakamayu - luru - puma - paqucha - wanaku - llama - suwaq'ara - uturunku" },
        { "cell": "quote-letter", "text": "Independencia (fecha de) - Qispikusqa pacha / Qispikusqa wata / Qispikusqa p'unchaw" },
        { "cell": "quote-letter", "text": "H, h nisqaqa latin siq'i llumpapi pusaq kaq sanampam. Qhichwa simipitaq kimsa kaq sanampam, kunkawaki kunkapaqmi." },
        { "cell": "quote-letter", "text": "Sisi icha Sik'imira, kichwapi Añanku nisqakunaqa (familia Formicidae) huk palamakunam." },
        { "cell": "scaled-currency", "text": "Nvidia willakurqa plankunata 13 ñiqin tarpuy killapi 2020 watapi, Arm SoftBank kaqmanta rantinanpaq, kamachiy aprobacionta suyaspa, huk chanin US$40 waranqa hunumanta stock kaqpi chaymanta qullqi kaqpi, mayqinchus kunankama aswan hatun chawpi-purichiq rantiy kanman. SoftBank Group Nvidiapi 10% qullqi quyninmanta pisillata rantinqa, Armtaq Cambridge llaqtapi umalliq wasinta waqaychanqa." },
        { "cell": "scaled-currency", "text": "7 ñiqin pawqar waray killapi 2022 watapi, yapasqa kamachiy hark'akunawan tupaspa, Nvidia Arm rantiyninta saqisqanmanta unancharqan. Chay rimanakuyqa, chip sikturpi astawan hatun kanman karqan, thuñikusqan pachaqa $66 waranqa hunu dularkunan chaninchasqa karqan." },
        { "cell": "scaled-currency", "text": "Kay web kitiqa 2020 watapi iskay ñawpaq Salesforce llamk'aqkunap kamasqanmi karqan, Bryan McCann wan Richard Socher. Mask'ay kuyuchinapa willakusqanmanta qatispa, 2021 watapi beta llaqtapaq kichasqanmanta, $20 hunu dular qullqita chaskirqa Marc Benioff, Salesforce kamaqmanta." },
        { "cell": "scaled-currency", "text": "Internet Explorer icha Chawpillika Mask'aq (ñawpaq Microsoft Internet Explorer chaymanta Windows Internet Explorer, sapa kuti pisichasqa IE utaq MSIE) huk \"jubilasqa\" (utaq aswan mana llamk'achisqa Windowspi kaqkuna) qillqa web wamp'uq siriyikuna Microsoft kaqmanta ruwasqa chaymanta Windows siq'i llamkanakuna llikakuna kaqpi llamk'achisqa. IE aswan Windowspi kaqkunapi jubilasqa kaptinpas, wakin kananpi kanku, kayhina Windows 10 LTSC chaymanta Windows 10 Chunwa suyu kawpakamachiqkunapa kaq manaraq yanapakuymanta lluqsisqachu. 1995 watamanta qallarispa, ñawpaqta lluqsirqa yapasqa q'ipi Plus! chay wata Windows 95 kaqpaq. Qhipa layakuna mana rantina hurayk'uchiykunahina utaq qarana q'ipipi hina karqanku chaymanta ñawpaq llamk'ay killana makiruwachiq (OEM) yanapakuy lluqsichiykunapi Windows 95 kaqmanta chaymanta qhipa Windows kaqmanta ruwasqakuna kaqpi churasqa. Microsoft US$100 hunu sapa wata Internet Explorer nisqapi 1990 wata tukukuypi chikcharqan, 1.000manta aswan runakunayuq 1999 watapi chay llamk'aypi llamk'arqanku Musuq ruwanakuna wiñachiy wamp'uqpaq saqisqa karqan 2016 watapi qatiqninpa allinninpaq, Microsoft Edge." },
        { "cell": "scaled-currency", "text": "Motorola, Inc. nisqaqa Hukllachasqa Amirika Mamallaqtakunamanta achka kawsayllaqtachasqa karuwillanakuykuna llamk'aymi karqan, Schaumburg llaqtapi, Illinois suyupi. 1928 watapi Galvin Manufacturing Corporation sutiwan kamarisqa karqan, Paulwan Joseph Galvin wawqikunawan. Chay llamk'ayqa 1947 watapi Motorola sutiman tikrarqan. $4.3 thular qullqita chinkachisqanmanta&nbsp;waranqa hunumanta 2007 watamanta 2009 watakama, chay llamk'ayqa iskay sapanchasqa llaqta llamk'anakunamanmi rak'ikurqan, Motorola Mobility wan Motorola Solutions, 4 ñiqin Kantaray killapi 2011 watapi. Chay musuqmanta tantanakuyqa Motorola Solutions kamachiypi Motorola, Inc., Motorola Mobility nisqap qhatiqninwan ruwasqa karqan." },
        { "cell": "scaled-currency", "text": "HSBC icha HSBC Holdings plc ñisqaqa Piritañamanta tiqisimuyuntinpi qullqiwasi, qullqimanta yanaykuna qutum, Lunrun, Inlispampa suyupi umalliq wasiyuq, sapalla wiñay kawsasqa chaymanta qhatuy t'inkiykunayuq Kuntu Apya Yalapi chaymanta ancha achka kawsayllaqtachasqa chakiyuq. Iwrupapi aswan hatun qullqiwasim tukuy p'itiwan, BNP Paribas manta ñawpaqpi, 2021 watapi Qhapay raymi killakama $2.953 hunu thularkunawan. 2021 watapi, HSBC $10.8 hunu thular qullqita p'itukunapi arariway urapi (AUC) hinallataq $4.9 hunu thular qullqita p'itupi kamachiy urapi (AUA)." },
        { "cell": "ordinal-caps", "text": "1996-1998 / 1999-2002: María Delia Vergara Pérez, Alianza Cambio 90-Nueva Mayoría / Movimiento Vamos Vecino." },
        { "cell": "ordinal-caps", "text": "Burford N & Royan BW 1989, 'Preparation, Spectroscopic Characterization, and Crystal and Molecular Structure of 1,3,2-Benzothiazarsolium Tetrachloroaluminate: A Dicoordinate Arsenic Cation Containing As–S and As–N pπ-Bonding,' Journal of the American Chemical Society, vol. 111, pp.&nbsp;3746–47," },
        { "cell": "ordinal-caps", "text": "Wawa wasikuna : CEI Nº 43-Kachachi, Nº 51-Araqueda, Nº 69-Chuqipampa, Nº 06-Pampa Quchapampa." },
        { "cell": "ordinal-caps", "text": "Wawa wasikuna : CEI 36-La Pampa, CEI 107-La Alameda, CEI 108-Musuq Llaqta, CEI 312-Cercado" },
        { "cell": "ordinal-caps", "text": "Warmi: María Páez Wawakuna: María, Juan (Llerena 1620-Sevilla 1649), (que fue pintor, como su padre, y murió durante la gran epidemia de peste en Sevilla, 1649), wan Isabel Paula." },
        { "cell": "ordinal-caps", "text": "+9+98+95FT+9D59NG5+GFH9+DFGN+95M+9VG5M+CFH5+ 9C5 B5BG+N DF+95HE56+YU5356+93U5+ERY5N+Y +E46+E5+E95+56E9+ 5+9E55 +EY84 TY+ N4ETY+ J5EY+9JU55+Y5TR+5ND +5TY+ 85+YE95+ERY 5E+YJ5JERY+5TY+5TY+9TY5+J95" },
        { "cell": "ordinal-caps", "text": "Tome 3 - Junio de 1940-Julio de 1941 Plon 1981" },
        { "cell": "ordinal-caps", "text": "Tome 4 - Julio de 1941-Mayo de 1943 Plon 1982" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "A, a nisqaqa latin siq'i llumpapi huk kaq sanampam. Qhichwa simipitaq huk kaqpas sanampam, hanllalli kunkapaqmi.",
        "Mayukuna: Huchusuma mayu - Jilawi mayu - Lampa mayu - Pukara mayu - Quwata mayu - Ramis mayu - Such'i mayu - San Gabán mayu - Wankani mayu; Kallawaya pruwinsyapi: Makusani mayu - Ayapata mayu - Ayuyani mayu; Melgar pruwinsyapi: Nuñuwa mayu - Q'urawiña mayu (Río Corahuiña)",
        "Kantunkuna: Unsiya kantun, Aymaya kantun, Chukiuta kantun, Musuq Qulcha kantun, Qala Qala kantun, Llallawa kantun, Sicoya",
        "Anrura icha Anthura (Katilla simipi: Andorra) llaqtaqa Iwrupapi huk mama llaqtam. Uma llaqtanqa Andorra la Vella llaqtam.",
        "Kukuchimanta / Juan de Dios Quispe Melo.",
        "Instituto Nobel Noruego (Nobel de la Paz)",
        "Historia de la Literatura Americana. (desde los orígenes hasta 1936).Chile, Ed. Ercilla, 1937; 631 p.",
