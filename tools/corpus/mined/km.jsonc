        { "cell": "fractions", "text": "ខេត្ត​ត្បូង​ឃ្មុំ ត្រូវ​បាន​បង្កើត​ឡើង​ដោយ​យោង​តាម​ព្រះ​រាជ​ក្រឹត្យ នស/រកត/១២១៣/១៤៤៥ ដែល​ធ្វើ​នៅ​ថ្ងៃ​ទី​៣១ ខែ​ធ្នូ ឆ្នាំ​២០១៣ ហើយ​ត្រូវ​បាន​ចេញ​ប្រកាស​នៅ​ដើម​ខែ​មករា ឆ្នាំ​២០១៤។" },
        { "cell": "fractions", "text": "១/៣នៃទីក្រុងតូក្យូ ត្រូវបានឆេះដោយសារគ្រាប់បែក ហើយប្រហែលជា ១០០,០០០​ នៃប្រជាជនត្រូវបានស្លាប់ ។" },
        { "cell": "fractions", "text": "ទោះបីជាមានឧស្សាហកម្មធុនស្រាលក៏ដោយ (ជាពិសេសការកិនក្រដាស និងផលិតស្រាបៀរ) ប្រជាជនភាគច្រើនត្រូវបានជួលដោយវិស័យសេវាកម្ម ក្នុងឆ្នាំ 2001 វិស័យសេវាកម្ម និងឧស្សាហកម្មទីបីផ្សេងទៀត បានបង្កើតច្រើនជាង 3/4 នៃផលិតផលក្នុងស្រុកសរុប" },
        { "cell": "fractions", "text": "សមណគោតម (ប្រសូត​មក​ប្រហែល​ជា ៥៦៣/៤៨០ - បានចូលបរិនិពា្វនប្រហែលជា ៤៨៣/៤០០ មុន គ.ស.) ត្រូវបានគេស្គាល់ផងដែរថាជា សិទ្ធាថ៌ គៅតម (सिद्धार्थ गौतम) នៅក្នុងភាសាសំស្ក្រឹត ឬ សិទ្ធត្ថ គោតម (शिद्धत्थगोतम) នៅក្នុងភាសាបាលី ឬព្រះពុទ្ធ ជាព្រះសង្ឃ មេដឹកនាំស្ម័គ្រចិត្ត ទស្សនវិទូ គ្រូបង្រៀននិង មេដឹកនាំសាសនាដែលត្រូវបានគេចាត់ទុក្ខជាអ្នកបង្កើតពុទ្ធសាសនា​ ​​ ។" },
        { "cell": "clock", "text": "ឥណ្ឌា​ មាន​ប្រជាជន​ប្រហែល​ ១.១៤ លាន​នាក់​ ជា​ប្រទេស​ ដែល​មាន​ប្រជាជន​ច្រើន​ជាង​គេ​ទី ​២ ក្នុង​លោក បន្ទាប់​ពី​ប្រទេស​ ចិន ​។" },
        { "cell": "clock", "text": "ខណៈអាស៊ីកំពុងទទួលកំណើនក្នុងវិស័យទេសចរណ៍ក្នុងតំបន់ ក៏ដូចជាភ្ញៀវទេសចរចិន MasterCard បានចេញផ្សាយសន្ទស្សន៍ទីក្រុងគោលដៅសកលប្រចាំឆ្នាំ២០១៣ ដោយក្នុងនោះមានទីក្រុង ១០ ក្នុងចំណោមទីក្រុងសរុប ២០ ជាទីក្រុងស្ថិតក្នុងតំបន់អាស៊ី និងប៉ាស៊ីហ្វិក ហើយក៏ជាលើកដំបូងផងដែរដែលទីក្រុងនៃប្រទេសមកពីអាស៊ី (បាងកក) បានជាប់ចំណាត់ថ្នាក់កំពូលលេខមួយជាមួយនឹងភ្ញៀវអន្តរជាតិមកទស្សនាចំនួន ១៥.៩៨ លាននាក់។" },
        { "cell": "clock", "text": "អូសេអានីគឺជាទ្វីបមួយដែលមាន ប្រទេសចំនួន១៤ប្រទេសចូលរួម ទ្វីបនេះមានផ្ទៃដីចំនួន ៨.៥២៥.៩៨៩ Km² មានប្រជាជនចំនួន៣៦៦៥៩០០០ លាននាក់ ដែលមានដង់ស៊ីតេចំនួន ៤.១៩នាក់/km² មានភាសា២៩ភាសា។" },
        { "cell": "clock", "text": "ការចំណាយរបស់រដ្ឋាភិបាលក្នុងឆ្នាំ 2013 មានចំនួន 3.1 ពាន់លានដុល្លារ កើនឡើងពី 2.95 ពាន់លានដុល្លារក្នុងឆ្នាំ 2012 ។" },
        { "cell": "clock", "text": "ទន្ទឹមនឹងនេះដែរ ប្រាក់ចំណូលក្នុងស្រុកបានកើនឡើងដល់ 2.06 ពាន់លានដុល្លារកាលពីឆ្នាំមុន កើនឡើងពី 2.01 ពាន់លានដុល្លារក្នុងឆ្នាំ 2012 ។" },
        { "cell": "clock", "text": "ការផ្តល់ហិរញ្ញប្បទានបន្ថែមចំនួន 1.06 ពាន់លានដុល្លារពីមូលនិធិបរទេសបានកើនឡើង 9 ភាគរយក្នុងឆ្នាំ 2013 ពី 972 លានដុល្លារក្នុងឆ្នាំ 2012 ។" },
        { "cell": "clock", "text": "ភ្នំពេញ គឺជារាជធានីដែលមានផ្ទៃដី 678.46 គីឡូម៉ែត្រការ៉េ (261.95 sq mi) ដែលមានឋានៈរដ្ឋាភិបាលស្មើនឹងខេត្ត ។" },
        { "cell": "clock", "text": "តម្លៃសំបុត្រសម្រាប់រថយន្តក្រុងសាធារណៈគឺ 1,500 រៀល (USD0.37) ក្នុងមួយការធ្វើដំណើរដោយមិនគិតពីចម្ងាយ ។" },
        { "cell": "signs", "text": "បើវិភាគពាក្យតាមនិរុត្តិសាស្ត្រ(etymology) ពាក្យថាសេដ្ឋកិច្ចគឺបានមកពីពាក្យក្រិច(ភាសាក្រិច)​ οίκω [oeko=ផ្ទះ] និង νέμω​ [nemo=ការបែងចែក] ពោលគឺសំដៅទៅ​ លើការចាត់ចែងទាំងឡាយនៅក្នុងផ្ទះដោយមេគ្រួសារ។" },
        { "cell": "signs", "text": "ជាមួយ​អត្រា​កំណើន​ ៩.៤% នៅ​ឆ្នាំ ២០០៦-២០០៧ សេដ្ឋកិច្ច​​ឥណ្ឌា​ ស្ថិត​នៅ​ក្នុង​បណ្ដា​សេដ្ឋកិច្ច​ ដែល​មាន​កំណើន​ខ្លាំង​បំផុត​ក្នុង​លោក​។" },
        { "cell": "signs", "text": "ឥណ្ឌា​ មាន​កម្លាំង​ពលកម្ម​ ៥១៦.៣ លាននាក់​ជាប់​លំដាប់​ទី​២​ក្នុង​លោក ដែល​ក្នុង​នោះ​ ៦០% បម្រើ​ការ​នៅ​ក្នុង​វិស័យ​កសិកម្ម​ និង​សហគ្រាស​ពាក់ព័ន្ធ​ ២៨%​ បម្រើ​វិស័យ​សេវាកម្ម​ និង​សហគ្រាស​ពាក់ព័ន្ធ​ និង​ ១២%​ទៀត​បម្រើ​ក្នុង​វិស័យ​ឧស្សាហកម្ម​។" },
        { "cell": "signs", "text": "វិស័យ​កសិកម្ម​រួម​ចំណែក​ ២៨% នៃ​ផលិតផល​ក្នុង​ស្រុក​ដុល​ វិស័យ​សេវាកម្ម​ និង​សហគ្រាស​ពាក់ព័ន្ធ​មាន​រហូត​ដល់​ ៥៤% ហើយ​ ១៨%ទៀត​ តំណាង​ឲ្យ​ឧស្សាហកម្ម​សំខាន់​រួមមាន​ ឧស្សាហកម្ម​យានយន្ត​ ស៊ីម៉ងត៍​ គីមី អេឡិចត្រូនិក​ ម្ហូបអាហារ​ គ្រឿងយន្ត​ អាជីវកម្ម​រុករក​រ៉ែ​ ប្រេងកាត​ ឱសថ​ ដែកថែប​ សម្ភារៈ​ដឹកជញ្ជូន​និង​វាយនភណ្ឌ​។" },
        { "cell": "signs", "text": "បំណែង​ចែក​ភោគផល​ (Wealth Distribution) នៅ​ឥណ្ឌា ពុំ​មាន​សមភាព​ឡើយ​ ដោយ​អ្នក​មាន​ចំណូល​ខ្ពស់​ ១០% នៃ​ក្រុម​ចំណូល​ ទទួល​បាន​ផល​រហូត​ដល់ ៣៣%​ នៃ​ចំណូល​។" },
        { "cell": "signs", "text": "នៅ​ឆ្នាំ​ ២០០៤-២០០៥​ ​ប្រជាជន​ ២៧.៥% បាន​រស់​នៅ​ក្រោម​បន្ទាត់​ភាព​ក្រីក្រ​។" },
        { "cell": "signs", "text": "ប្រជាជន​ប្រហែល​ ៧០% រស់​នៅ​តាម​ទី​ជនបទ​ ទោះជា​នៅ​ទសវត្ស​ ចុងក្រោយ​ប្រជាជន​ ដែល​មាន​ជីវភាព​តោកយ៉ាក​ខ្លាំង​ បាន​ធ្វើ​ចំណាក​ស្រុក​ទៅ​កាន់​ទីក្រុង ​ក្នុង​ចំនួន​កាន់​តែ​ច្រើន​ឡើង​ក៏ដោយ​ ​។" },
        { "cell": "signs", "text": "ឥណ្ឌា ​គឺជា​ទី​កំណើត​ នៃ​អំបូរ​ភាសា​ពីរ​ធំៗ​គឺ៖ ឥណ្ឌូ-អារ្យ័ន (មាន​​ប្រជាជន​ ៧៤% ជា​អ្នក​និយាយ) និង​ទ្រាវីទ (មាន​ប្រជាជន​ ២៤% ជា​អ្នក​និយាយ)​។" },
        { "cell": "dotted", "text": "ប្រទេសចិន និងឥណ្ឌាបាន​ឆ្លាស់កន្លែងគ្នាទៅវិញទៅមកក្នុងនាម​ជា​រដ្ឋប្រទេស​ដែលមាន​សេដ្ឋកិច្ច​ធំ​ជាង​គេ​លើពិភពលោក​ចាប់ពី​ឆ្នាំ​ទី ១ នៃ គ.ស. រហូតដល់​ឆ្នាំ ១៨០០ គ.ស.។" },
        { "cell": "dotted", "text": "ការបំបែកពិភពចាស់ទៅជាបីប៉ែកមាន អាស៊ី អាហ្វ្រិក និងអឺរ៉ុបត្រូវបានគេយកមកអនុវត្តប្រើប្រាស់ចាប់តាំងពីសតវត្សរ៍ទី៦ មុន គ.ស. មកម៉្លេះទៅតាមទស្សនៈរបស់ភូមិវិទូក្រិកបុរាណពីរនាក់គឺ អាណាស៊ីម៉ង់ដ៍ និងអេកាធី។" },
        { "cell": "dotted", "text": "​ អាណាស៊ីម៉ង់ដ៍បានកំណត់ព្រំប្រទល់រវាងអាស៊ីនិងអឺរ៉ុបនៅត្រង់ទន្លេហ្វាស៊ីស (បច្ចុប្បន្នជាទន្លេរីយ៉ូនីនៅក្នុងភាគខាងលិចនៃប្រទេសចចជី) ហើយសម្មតិកម្មបែបនេះនៅតែបន្តប្រើប្រាស់ដោយអេកាធីនៅក្នុងសតវត្សរ៍ទី៥ មុន គ.ស.។" },
        { "cell": "dotted", "text": "នៅ​ឆ្នាំ​ ៨០២ ​នៃ ​គ.ស. ព្រះ​បាទ​ជយវម៌្មទី២​បាន​ប្រកាស​ព្រះ​អង្គ​ឯង​ជា​ព្រះ​មហាក្សត្រ ដែលយើងអាចសម្គាល់ឃើញនូវ​ការ​ចាប់កំណើត​នៃ​មហារាជាណាចក្រ​ខ្មែរដ៏រុងរឿង​អស់​រយៈពេល​ជាង​ ៦០០​ ប្លាយឆ្នាំ ហើយ​ព្រះ​មហាក្សត្រ​សោយ​រាជ្យ​បន្ត​បន្ទាប់ពីទ្រង់នោះ បានបន្ត​ត្រួតត្រាមួយ​ភាគធំ​នៃ​អាស៊ី​អាគ្នេយ៍ និង​​ប្រមូលផ្ដុំ​អំណាច ព្រម​ទាំង​ភោគ​ទ្រព្យ​​ច្រើន​លើស​លប់ជាងគេ។" },
        { "cell": "dotted", "text": "កំណាយក្នុងស្រទាប់ក្រោមដីបានផលិតនូវតំណបន្តនៃវិទ្យុកាបូនមួយដែលចុះកាលបរិច្ឆេទថានៅឆ្នាំ ៦០០០ ម.គ.។" },
        { "cell": "dotted", "text": "មុខងារនិងអាយុកាលរបស់បន្ទាយគូទាំងនេះនៅតែត្រូវគេលើកយកមកពិភាក្សាដដែល ផ្ទុយទៅវិញបន្ទាយគូទាំងនោះមួយចំនួនប្រហែលជាមានអាយុកាលយ៉ាងហោចណាស់ក៏ចាប់តាំងពី​សហវត្សទី២ម.គ. ដែរ។" },
        { "cell": "dotted", "text": "ព្រឹត្តិការណ៍ស្នូលក្នុងបុរេប្រវត្តិសាស្ត្រកម្ពុជាគឺធ្លាប់មានការហូរចូលមកយឺតៗនៃពួកអ្នក​ដាំដុះស្រូវលើកទីមួយចាប់ពីភាគខាងជើង ដែលបានចាប់ផ្ដើមនៅចុងសហវត្សទី៣ម.គ.។" },
        { "cell": "dotted", "text": "ដែកត្រូវបានគេយកមកប្រើការនៅប្រហែលឆ្នាំ ៥០០ ម.គ. ដែលមានភស្តុតាងគាំទ្រមកពីខ្ពង់រាបគោរាជ (កូរ៉ាត) នៅប្រទេសថៃសម័យទំនើប។" },
        { "cell": "era-marker", "text": "ការបញ្ចុះសព ដែលសម្បូរច្រើនជាងអ្វីដែលគេបានរកឃើញ ផ្ដល់ជាសក្ខីភាពអំពីការរីកចម្រើននៃការប្រើប្រាស់ចំណីអាហារ និងការជួញដូរ (ទោះបីជានៅចម្ងាយដ៏ឆ្ងាយ: នៅសតវត្សទី៤ម.គ. ទំនាក់ទំនងពាណិជ្ជកម្មជាមួយឥណ្ឌាត្រូវបានដំណើរការរួចទៅហើយ) និងអត្ថិភាពនៃរចនាសម្ព័ន្ធសង្គម និងអង្គការចាត់តាំងការងារ។" },
        { "cell": "era-marker", "text": "នៅឆ្នាំ ១៩៧៣ ប.ក.ក.បានប្រយុទ្ធគ្នាក្នុងសមរភូមិប្រឆាំងនឹងកងកម្លាំងរដ្ឋាភិបាលដែលមានជំនួយកងទ័ពវៀតណាមខាងជើងតិចតួច រឺ គ្មានទាល់តែសោះ ហើយពួកគេបានគ្រប់គ្រងស្ទើរតែ ៦០% នៃទឹកដីកម្ពុជា និង ប្រជាជន ២៥%។" },
        { "cell": "era-marker", "text": "ពេញមួយទសវត្សឆ្នាំ ១៩៨០ រ.ច.ក.ប. បានផ្គត់ផ្គង់ដោយចិន ថៃ សហរដ្ឋ និងសហរាជាណាចក្រ ដែលបានគ្រប់គ្រងប៉ែកខ្លះនៃប្រទេស បានវាយយកទឹកដីខ្លះដែលមិននៅក្រោមការត្រួតត្រារបស់ខ្លួន។" },
        { "cell": "era-marker", "text": "ស្ត្រាបុង (Strabon) ភូមិវិទូជនជាតិក្រិក អំឡុង​ឆ្នាំ ៥៧ ម.គ.ស.បាននិយាយថា​ ភូមិវិទ្យាជាគោលដ្ឋានសំរាប់បង្ហាត់បង្រៀន អ្នកដែលចង់មានសិទ្ធិសំរេច។" },
        { "cell": "era-marker", "text": "Eratosthenes(២៧៥- ១៩៥ ម.គ.ស.) គឺជាមនុស្សដំបូងដែលប្រើភូមិសាស្រ្តនៅប្រទេសក្រិក។" },
        { "cell": "era-marker", "text": "Eratosthenes (276 ម.គ.ស - 194 ម.គ.ស) - បានគណនាទំហំនៃផែនដី" },
        { "cell": "era-marker", "text": "នៅសតវត្សន៍ទី ៩គ.ស. មានប្រជាជនថ្មីហៅថា Mayaដែលមានការសរសរ និងប្រតិទិនមួយដែលល្អបំផុតក្នុងប្រវត្តិរបស់ពិភពលោក។" },
        { "cell": "era-marker", "text": "ធម្មយាត្រា​នេះ​ បាន​ធ្វើ​ដំណើរ​​និង​ចំណាយ​ពេល​អស់​រយៈ​ពេល ​១៦ ​ថ្ងៃ ​និង​ ​២០០ គ.ម. ​ឆ្ពោះ​ទៅ​កាន់​​តំបន់​ខ្មែរ​ក្រហម ដោយ​ឆ្លង​កាត់​ដី ដែល​ពួក​ខ្មែរ​ក្រហម​បាន​បង្កប់​គ្រាប់​មីន ។" },
        { "cell": "year", "text": "ក្រោយ​ការ​ទទួល​បាន​ជ័យជំនះ​ ឧបទ្វីបឥណ្ឌា​ត្រូវ​បាន​បែងចែក​ជា​រដ្ឋ​ពីរ​ផ្សេង​គ្នា ដោយ​បុព្វហេតុ​ទំនាស់​សាសនា​គឺៈ ឥណ្ឌា និង​រដ្ឋឥស្លាម​ប៉ាគីស្ថាន ហើយ​មហាត្មៈ​ គន្ធី ត្រូវ​បាន​ធ្វើ​ឃាត​ដោយ​ពួក​ហិណ្ឌូនិយម​ជ្រុល​ នៅ​​ថ្ងៃ​​ទី​​ ៣០ មករា​ ឆ្នាំ​ ១៩៤៨ ក្រោយ​​ពេល​​ដែល​​ឥណ្ឌា​​ទើប​តែ​​បាន​​ទទួល​​ឯករាជ្យ​​ពី​​អង់គ្លេស​​។" },
        { "cell": "year", "text": "សង្គ្រាម​​លើក​ទី​៣ រវាង​ប្រទេស​ទាំង​ពីរ​នៅ​ឆ្នាំ ១៩៧១ បាន​បណ្តាល​ឲ្យ​ប្រទេសប៉ាគីស្ថានខាងកើត​ក្លាយ​ជា​រដ្ឋ​បង់ក្លាដេស​ឯករាជ្យ ពី​ប្រទេស​ប៉ាគីស្ថាន​ខាងលិច (ប្រទេស​ប៉ាគីស្ថាន​សព្វថ្ងៃ)។" },
        { "cell": "year", "text": "រដ្ឋធម្មនុញ្ញ​ឥណ្ឌា គឺជា​រដ្ឋធម្មនុញ្ញ​ ដែល​ចំណាស់​ជាងគេ និង​ទូលំទូលាយ​បំផុត​ក្នុងចំណោម​ប្រជាជាតិ​ឯករាជ្យ​នៅ​លើ​ពិភពលោក ដោយ​បាន​ប្រកាស​ដាក់​ឲ្យ​ប្រើ​ចាប់​តាំង​ពី​ថ្ងៃ​ទី​២៦ ខែ សីហា ឆ្នាំ ១៩៥០ ​មក​ម៉្លេះ​។" },
        { "cell": "year", "text": "ចាប់​តាំង​ពី​ទទួល​ឯករាជ្យ​នៅ​ឆ្នាំ​ ១៩៤៧ មក ឥណ្ឌា​ បាន​ថែ​រក្សា​ចំណង​មិត្តភាព​ជាមួយ​ប្រជាជាតិ​ជា​ច្រើន​។" },
        { "cell": "year", "text": "នៅ​ទសវត្សរ៍​ឆ្នាំ​ ១៩៥០​ ឥណ្ឌា​បាន​ចាប់​យក​តួនាទី​ជា​អ្នក​ដឹកនាំ​ការ​គាំទ្រ​ដល់​ការ​ទាមទារ​ឯករាជ្យ​នៃ​បណ្ដា​អាណានិគម​​អឺរ៉ុបនៅ​ទ្វីប​​​អាស៊ី និង​​​អាហ្វ្រិក។" },
        { "cell": "year", "text": "ក្រោយ​ពី​សង្គ្រាម​រវាង​ ចិន-ឥណ្ឌា​ និង​ ឥណ្ឌា-ប៉ាគីស្ថាន​ នៅ​ឆ្នាំ​ ១៩៦៥ មក​ទំនាក់ទំនង​យ៉ាង​ជិតស្និទ្ធ​រវាង​ ឥណ្ឌា​ និង​​​សហភាព សូវៀត បាន​ធ្វើ​ឲ្យ​ឥណ្ឌា​ បាត់បង់​នូវ​ទំនាក់ទំនង​ជាមួយ​ ​សហរដ្ឋ​អាមេរិក ​ ហើយ​បាន​បន្ត​សភាព​បែប​នេះ​រហូត​ដល់​ការ​បញ្ចប់​នូវ​សង្គ្រាម ត្រជាក់​។" },
        { "cell": "year", "text": "ឥណ្ឌា​ បាន​ឈ្នះ​សង្គ្រាម​ជាមួយ​​ប៉ាគីស្ថាន​ នៅ​ឆ្នាំ​ ១៩៧១ ដោយ​ឥណ្ឌា​បាន​ជួយ​គាំទ្រ​ដល់​ចលនា​រំដោះ​ជាតិ​​បង់ក្លាដេស (​អតីត​ប្រ​ទេស​ប៉ាគីស្ថាន​ខាងកើត)​។" },
        { "cell": "year", "text": "ឥណ្ឌា​បាន​ក្លាយ​ទៅ​ជា មហាអំណាច​នុយក្លេអ៊ែរ នៅ​ឆ្នាំ​ ១៩៧៤ បន្ទាប់​ពី​ការ​សាកល្បង​អាវុធ​នុយក្លេអ៊ែរ​ជា​លើក​ដំបូង​មក​ ដោយ​ពុំ​មាន​ការ​ប្រកាស​ជា​សាធារណៈ​ទេ​។" },
        { "cell": "decimals", "text": "ប្រទេស​ឥណ្ឌា មាន​ផ្ទៃដី ៣,២៨៧,៥៩០ គីឡូម៉ែត្រ​ក្រឡា ធំ​ជាង​គេ​ទី​៧លើ​ពិភពលោក​ ស្ថិត​នៅ​ភូមិភាគអាស៊ីខាងត្បូង ខាងលិច​ជាប់នឹង សមុទ្រ​អារ៉ាប់ ខាងកើត​ជាប់នឹង ឈូងសមុទ្របេងហ្គាល់ និង​ខាងត្បូង​ជាប់​ មហាសមុទ្រឥណ្ឌា ចន្លោះ​ប្រទេស មីយ៉ាន់ម៉ា និងប៉ាគីស្ថាន។" },
        { "cell": "decimals", "text": "ឥណ្ឌា មាន​ព្រំដែន​គោក​សរុប​ប្រវែង ១៤.១០៣ គីឡូម៉ែត្រ ជាប់នឹង​ប្រទេស បង់ក្លាដេស ៤.០៥៣ គីឡូម៉ែត្រ ប្រទេសប៊ូតាន ៦០៥ គីឡូម៉ែត្រ ប្រទេសភូមា ១.៤៦៣ គីឡូម៉ែត្រ ប្រទេសចិន ៣.៣៨០ គីឡូម៉ែត្រ ប្រទេសនេប៉ាល់ ១.៦៩០ គីឡូម៉ែត្រ និង​ប្រទេសប៉ាគីស្ថាន ២.៩១២ គីឡូម៉ែត្រ។" },
        { "cell": "decimals", "text": "លើស​ពី​នេះ​ឥណ្ឌា នៅ​មាន​ឆ្នេរសមុទ្រ​ជាង ៧.៥១៧ គីឡូម៉ែត្រ​ទៀត។" },
        { "cell": "decimals", "text": "ឥណ្ឌា​គឺ​ជា​សមាជិក​ និង​ជា​អ្នក​ទ្រទ្រង់​ដ៏​យូរ​លង់​ នៃ​អង្គការ​សហប្រជាជាតិ នៅ​ក្នុង​ប្រតិបត្តិការ​ថែរក្សា​សន្តិភាព​ចំនួន​ ៣៥ ទូទាំង​ទ្វីប​ទាំង​ ៤ ដោយ​មាន​កងទ័ព​ជាង​ ៥៥.០០០ នាក់​ និង​កម្លាំង​នគរបាល​ផ្ទាល់​ខ្លួន​ផង​ដែរ​។" },
        { "cell": "decimals", "text": "ការ​ផ្តោះ​ប្តូរ​​ពាណិជ្ជកម្ម​​ក្រៅ​ប្រទេស​បាន​កើន​ឡើង​ពី ៥.៨ ពាន់​លាន​ដុល្លារ​ នៅ​ឆ្នាំ ១៩៩១ ដល់ ៣០៨ ពាន់​លាន​ដុល្លារ នៅ​ថ្ងៃ​ទី ៤ កក្កដា ឆ្នាំ ២០០៨​ នៅ​ខណៈ​ដែល​ថវិកា​រដ្ឋ​ និង​សហព័ន្ធ​បាន​ធ្លាក់​ចុះ​ ការ​ធ្វើ​ឯកជនូបនីយកម្ម​លើ​សហគ្រាស​សាធារណៈ​ត្រូវ​បាន​បន្ត​។" },
        { "cell": "decimals", "text": "ផលិតផល​ក្នុង​ស្រុក​​ដុល (GDP) ​របស់​ឥណ្ឌា​ គិត​ជា​ដុល្លារ​មាន ១.០៨៩ លាន​លាន​ដុល្លារ​ ខណៈ​ដែល អំណាច​ទិញ​ (PPP) មាន​ដល់​ ៤.៧២៦ លាន​លាន​ដុល្លារ​ជាប់​លំដាប់​ទី​៤​ ក្នុង​លោក​។" },
        { "cell": "decimals", "text": "ចំណូល​របស់​ប្រជាជន​ម្នាក់ៗ មាន​ ៩៧៧ ដុល្លារ ស្រប​ពេល​ដែល​អំណាច​ទិញ​របស់​ប្រជាជន​ម្នាក់ៗ​មាន​ ២.៧០០ ដុល្លារ​។" },
        { "cell": "decimals", "text": "សមភាព​ នៃ​ចំណូល​នៅ​ប្រទេស​ឥណ្ឌា​ មាន​ទំនាក់ទំនង​គ្នា​តិច​ណាស់​ (Gini Coefficient: 36.8 នៅ​ឆ្នាំ ២០០៤) ទោះជា​មាន​ការ​កើន​ឡើង​នៅ​រយៈកាល​ចុង​ក្រោយ​នេះ​ក៏ដោយ​។" },
        { "cell": "ordinal-latin", "text": "1586 - Thomas Howard, 21st Earl of Arundel, English statesman (ស. ១៦៤៦)" },
        { "cell": "ordinal-latin", "text": "ក្រុងបានលុង គឺជាទីរួមខេត្តរតនគីរី northeast Cambodia. As of 1998, it had a population of 16,999. It contains 16 villages, which are located in three communes. It surrounds the provincial capital of Banlung." },
        { "cell": "ordinal-latin", "text": "10th Anniversary Special Edition (ជាភាសាអង់គ្លេស)" },
        { "cell": "ordinal-latin", "text": "d stoneware of a Buddhist monk, or Future Buddha, dated to the 20th year of the យុគចេនឡា, or 1468 AD.]]" },
        { "cell": "ordinal-latin", "text": "កើតដោយវិបាកនៃបឋមជ្ឈានមានបីជាន់ (1st jhāna)" },
        { "cell": "ordinal-latin", "text": "ផលនៃទុតិយជ្ឈានមានបីជាន់ (2nd jhāna)" },
        { "cell": "ordinal-latin", "text": "ផលនៃតតិយជ្ឈានមានបីជាន់ (3rd jhāna)" },
        { "cell": "ordinal-latin", "text": "ផលនៃចតុត្ថជ្ឈានមានប្រាំពីរជាន់ (4th jhāna)" },
        { "cell": "units", "text": "វីទ្យុជាតិ FM 92.3Mhz" },
        { "cell": "units", "text": "រឹទ្ធីសែន FM 99.75Mhz" },
        { "cell": "units", "text": "My FM 98.70MHz ខេត្តកំពង់ឆ្នាំង" },
        { "cell": "units", "text": "កាលពីដើមឡើយស្រុកពញាក្រែកជាស្រុកមួយដែលស្ថិតក្នុងខេត្តកំពង់ចាមមានផ្ទៃដីសរុប9,799km តែក្រោយមកត្រូវបានកាត់ចូលខេត្តត្បូងឃ្មុំវិញ" },
        { "cell": "units", "text": "ដ៏ស្រស់បំព្រង ភូមិនេះមានចំងាយ ពីទីរួមខេត្តរតនគិរី ២៥ km យោងតាម(​ ឯកសារ​របស់អង្គការ ( NTFP) ប្រចាំខេត្តរនតនគិរី ។" },
        { "cell": "units", "text": "​ បើយើងធ្វើដំណើរទៅស្រុកដងទង់យើងធ្វើដំណើរ​តាមផ្លូវជាតិលេខ៣ ដល់ស្រុកឈូកបត់ទៅទិសខាងត្បូងខាងលិចវិទ្យាល័យឈូកហើយប្រហែល២០km យើងនិងដល់ស្រុកដងទង់ ហើយធ្វើដំំណើរពីស្រុកកំពង់ត្រាច មកស្រុកដងទង់ក៏បានដែរ។" },
        { "cell": "units", "text": "ផ្ទាំងបឋមសីលាជាប្រវត្តិសាស្ត្រនេះ ត្រូវបានគេយកមកពី ខេត្តចង្វា​ត្រពាំង (Bien Hoa) មានទំហំ ៥០ Cm បួនជ្រុង ហើយត្រូវបានគេដាក់រូបិយប័ណ្ណ នាសម័យនោះ ដែលផលិតពីមាស ប្រាក់ និងស្ពាន់ចូលទៅរន្ធខាងក្នុង ។" },
        { "cell": "units", "text": "គឺជាខេត្តរបស់ប្រទេសជប៉ុន មានទីតាំងនៅតំបន់ថូហុគឹរបស់កោះហុងស្ស៊ូ ចំនួនប្រជាជនរបស់វាគឺប្រហែល 966,000 (គិតត្រឹមថ្ងៃទី 1 ខែតុលា ឆ្នាំ 2019) និងតំបន់ភូមិសាស្រ្តគឺ 11,637 km2 (4,493 sq mi) ខេត្តអាគីតាមានព្រំប្រទល់ជាប់ខេត្តអាអូម៉ូរីទៅភាគខាងជើង ខេត្តអ៊ីវ៉ាតិទៅភាគខាងកើត ខេត្តមីយ៉ាហ្គិទៅភាគអាគ្នេយ៍ និងខេត្តយ៉ាម៉ាហ្គាតាទៅភាគខាងត្បូង" },
        { "cell": "ranges", "text": "ប្រជាជនកាន់ភាគច្រើនដែលកាន់ប្រតិបត្តិសាសនាព្រះពុទ្ធគឺមាននៅក្នុងប្រទេសកម្ពុជា (៩៦%), ថៃ (៩៥%), ភូមា (៨០–៨៩%), ជប៉ុន (៣៦–៩៦%), ភូតាន (៧៥–៨៤%), ស្រីលង្កា (៧០%), ឡាវ (៦០–៦៧%), និងម៉ុងហ្គោលី (៥៣–៩៣%)។" },
        { "cell": "ranges", "text": "ប្រទេសដែលមានប្រជាជនភាគតិចកាន់ព្រះពុទ្ធសាសនារួមមាន៖ តៃវ៉ាន់ (៣៥–៩៣%), កូរ៉េខាងត្បូង (២៣–៥០%), ម៉ាឡេស៊ី (១៩–២១%), នេប៉ាល់ (៩–១១%), វៀតណាម (១០–៧៥%), ចិន (២០–៥០%), កូរ៉េខាងជើង (២–១៤%) ក៏ដូចជាសហគមន៍តូចៗនៅក្នុងប្រទេសឥណ្ឌា និងបង់ក្លាដែស។" },
        { "cell": "ranges", "text": "សង្គ្រាមវៀតណាមបាន​រីក​រាល​ដាល​ដល់​កម្ពុជា ដែល​ធ្វើ​ឱ្យ​មាន​ការ​ងើប​ឡើង​របស់​ពួក​ខ្មែរក្រហម ដែល​ពួកនោះបាន​ដណ្ដើម​កាន់កាប់បាន​ទីក្រុងភ្នំពេញ​នៅ​ឆ្នាំ ​១៩៧៥ ហើយ​បាន​បន្ដ​ការប្រល័យពូជសាសន៍ខ្មែរ ចាប់​ពីឆ្នាំ ១៩៧៥-១៩៧៩ និង​ក្រោយ​មក​បាន​វាយ​ប្រយុទ្ធ​នឹង​ពួក​យួន​ដែល​នៅ​ពី​ក្រោយ​ខ្នង​របប​សាធារណរដ្ឋប្រជាមានិតកម្ពុជា​កំឡុង​សម័យសង្គ្រាមកម្ពុជា-វៀតណាម (១៩៧៩-១៩៩១)។" },
        { "cell": "ranges", "text": "បន្ត​បន្ទាប់​ពីកិច្ចព្រមព្រៀងសន្តិភាពទីក្រុងប៉ារីស១៩៩១ កម្ពុជា​ត្រូវ​បាន​អភិបាលកិច្ច​មួយរយៈពេល​ខ្លី​ដោយក្រុម​បេសកកម្មសហប្រជាជាតិ (១៩៩២-១៩៩៣) ក្រោយ​ពី​ការ​បោះ​ឆ្នោត​ទៅ គេ​​ឃើញមានអ្នក​បោះ​ឆ្នោតប្រហែល ៩០%​ ​បាន​បោះ​ឆ្នោត​ ហើយអង្គការសហប្រជាជាតិ ក៏​បាន​ដកថយ​ចេញពីកម្ពុជាទៅវិញ។" },
        { "cell": "ranges", "text": "អធិរាជាណាចក្រខ្មែរបានធំធាត់ឡើងចេញពីការបន្សល់ទុកទាំងប៉ុន្មានពីចេនឡា ហើយបានប្រែកាន់តែរឹងមាំឡើងនៅឆ្នាំ ៨០២ នៅពេលដែលព្រះបាទជ័យវម៌្មទី២ (បានសោយរាជ្យ ប.៧៩០-៨៥០) បានប្រកាសឯករាជ្យពីជ្វានិងប្រកាសព្រះអង្គឯងជាទេវរាជ។" },
        { "cell": "ranges", "text": "សង្គ្រាមសៀម-យួន (១៨៤១-១៨៤៥) (សមរភូមិដើមពោធិ៍បីដើម) បានបញ្ចប់ជាមួយកិច្ចព្រមព្រៀងមួយដែលដាក់ប្រទេសនេះក្រោមអធិរាជភាពរួមគ្នា។" },
        { "cell": "ranges", "text": "ផលិតផលស្រូវកើនឡើងតិចតួច តែមានមនុស្សរាប់រយពាន់នាក់បានស្លាប់រវាង ឆ្នាំ១៩៧៦-១៩៧៨ដោយកង្វះខាតចំណីអាហារ ធ្វើការហួសកម្លាំង និងជំងឺដង្កាត់​ដែលពុំបានយកចិត្តទុកដាក់ព្យាបាលនិងពិនិត្យរោគវិនិច្ឆ័យខុស ពួកខែ្មរក្រហម បានប្រហារជីវិតមនុស្សរាប់រយពាន់នាក់ ដោយចោទពួកគេថាជាសត្រូវរបស់អង្គការ​។" },
        { "cell": "ranges", "text": "ក្នុងឆ្នាំ១៩៩៥ សេដ្ឋកិច្ចប្រទេសទាំងមូលមានកម្រិតត្រឹមពី៤០-៥០ ភាគរយប៉ុណ្ណោះ បើបៀ្របធៀបទៅនឹងមុនឆ្នាំ១៩៧០ សម្រាប់អ្នកមកទស្សនានៅប្រទេសកម្ពុជា ភាពក្រីក្រត្រូវបានបិទបាំងដោយសារភាពរីកចម្រើនដែលគេមើលឃើញនៅភ្នំពេញ។" },
        { "cell": "currency", "text": "នៅឆ្នាំ២០១១ ប្រាក់ចំណូលម្នាក់ៗរបស់កម្ពុជាក្នុងយុគភាពអំណាចការទិញគឺ២៤៧០$ និង១០៤០$ជាមធ្យមក្នុងមនុស្សម្នាក់ៗ។" },
        { "cell": "currency", "text": "សេវាជាមូលដ្ឋានជាមួយល្បឿន៣មបៃ/វ ថ្លៃ១២$ក្នុងមួយខែបូកតម្លៃម៉ូដឹមជួល។" },
        { "cell": "currency", "text": "ប្រាក់ចំណូលជាមធ្យមរបស់គ្រួសារបច្ចុប្បន្នរបស់ទីក្រុងភ្នំពេញគឺស្ថិតនៅក្រោមកម្រិតដែលអាចប្រៀបធៀបបានគឺ $12,400 នៅទីក្រុងបាងកក និងច្រើនជាងពីរដងនៃទីក្រុងហូជីមិញ $5,200 នៅវៀតណាម ។" },
        { "cell": "currency", "text": "សួនទឹក Garden City Water Park ដែលជាសួនទឹកធំជាងគេនៅទីក្រុងភ្នំពេញ សាងសង់ដោយគ្រុមហ៊ុន LYP Group របស់លោក ឧកញ៉ា លី យ៉ុងផាត់ ដែលវិនិយោគលើទំហំទឹកប្រាក់ $44 លានដុល្លារអាមេរិក បានបើកដំណើរការជាផ្លូវការណ៍នៅខែសីហា ឆ្នាំ 2020 ដែលជាផ្នែកមួយក្នុងការជំរុញវិស័យទេសចរណ៍នៅទីក្រុងភ្នំពេញផងដែរ ។" },
        { "cell": "currency", "text": "១. ការគ្រប់គ្រងការដាំដុះម្រេចក្នុងមួយរង (បង្គោល) ចំណាយ ២,៣ €" },
        { "cell": "currency", "text": "ក្រុមហ៊ុនមានវិនិយោគគម្រោងបានវាយតម្លៃ $២,០៦៣ដប់កោដិ។" },
        { "cell": "currency", "text": "ផលិតផលក្នុងស្រុកសរុប (ធម្មតា) របស់ឥណ្ឌូណេស៊ីសម្រាប់ឆ្នាំ២០០៨គឺ៥១១,៧ រយកោដិ$ស.រ.ដោយបានប៉ាន់ស្មានជាធម្មតាក្នុងផសសម្នាក់ៗគឺ២២៤៦$ស.រ. និងក្នុងយ.អ.ទ.ផសសម្នាក់គឺ៣៩៧៩$ស.រ. (ដុល្លារអន្តរជាតិ)។" },
        { "cell": "currency", "text": "ជាមួយនឹងផលិតផលក្នុងស្រុក (GDP) ១៣០០០$ ម៉ាឡេស៊ីបានក្លាយខ្លួនបន្តិចម្តងៗទៅជា​ប្រទេសឧស្សាហកម្មថ្មី។" },
        { "cell": "abbrev", "text": "តែយ៉ាងណា ន័យរបស់ពាក្យសេដ្ឋកិច្ច និងសេដ្ឋសាស្ត្រនៅក្នុងពេលបច្ចុប្បន្ននេះគឺជាន័យដែលផ្តល់ឲ្យដោយលោក រ. គោវិទជាចម្បង។" },
        { "cell": "abbrev", "text": "អ្នកឯកទេសកម្ពុជាលោកខ្រេខ-អិឆឆឹសឹនបានលើកឡើងថាខ្មែរក្រហមនឹងឈ្នះយ៉ាងណាក្ដី បើទោះបីជាគ្មានអន្តរាគមន៍ស.រ. ក៏មានការជម្រុញឱ្យមានការកេណ្ឌកងទ័ពដដែល។" },
        { "cell": "abbrev", "text": "រវាងឆ្នាំ ១៩៦៩ និង ១៩៧៣ កងកម្លាំងសាធារណរដ្ឋវៀតណាម និងស.រ. បានទម្លាក់គ្រាប់បែកលើប្រទេសកម្ពុជាក្នុងកិច្ចប្រឹងប្រែងរារាំងទប់ស្កាត់ពួកវៀតកុង និង ពួកខ្មែរក្រហម។" },
        { "cell": "abbrev", "text": "ជាការឆ្លើយតបទៅនឹងការឈ្លានពានរបស់វៀតណាមខាងជើង ប្រធានាធិបតីស.រ.រីឆាដ-និច្សុនបានប្រកាសឱ្យកងកម្លាំងស.រ. និង វៀតណាមខាងត្បូងចូលកម្ពុជាក្នុងយុទ្ធនាការមួយបំណងវាយកម្ទេចតំបន់មូលដ្ឋានក.វ.ជ.នៅកម្ពុជា (សូមមើលការឈ្លានពានកម្ពុជា)។" },
        { "cell": "abbrev", "text": "ការដឹកជញ្ជូនអាវុធយុទ្ធភណ្ឌនិងស្រូវអង្ករតាមអាកាសដែលផ្ដល់ដោយស.រ. បានបញ្ចប់នៅពេលសមាជច្រានចោលនូវជំនួយបន្ថែមដល់កម្ពុជា។" },
        { "cell": "abbrev", "text": "អ្នកតំណាងខ្មែរក្រហមនៅស.ប. ជួន-ប្រសិទ្ធិត្រូវបានគេទទួលស្គាល់ ប៉ុន្តែលោកត្រូវបានគេឱ្យធ្វើការក្នុងការពិគ្រោះយោបល់ជាមួយពួកអ្នកតំណាងភាគីខ្មែរមិនមែន​កុម្មុយនិស្ត។" },
        { "cell": "abbrev", "text": "ការបដិសេធដកទ័ពថយពីកម្ពុជារបស់វៀតណាមបាននាំឱ្យមានការដាក់ទណ្ឌកម្មសេដ្ឋកិច្ច ដោយស.រ. និងសម្ព័ន្ធមិត្ត ធ្វើឱ្យការស្ដារឡើងវិញពិតជាមិនអាចធ្វើទៅរួចឡើយ និងទុកឱ្យប្រទេសនេះលិចលង់យ៉ាងខ្លាំង។" },
        { "cell": "abbrev", "text": "អគ្គមេបញ្ជាការថ្មីនៃក.យ.ខ.ភ. ត្រូវបានជំនួសដោយលោកឧត្តមសេនីយ៍ប៉ុល-សារឿន ដែលជាអ្នកស្មោះត្រង់នឹងលោកនាយករដ្ឋមន្ត្រីហ៊ុន-សែនជាយូរមកហើយ។" },
        { "cell": "latin-in-native", "text": "ការ​​រៀប​រាប់​លម្អិត​អំពី​ភាសា​ដែល​មាន​វ័យ​ចំណាស់​គឺ ការវិភាគភាសា​សំស្ក្រឹត ឈ្មោះថា អស្តធ្យយិ​ (Ashtadhyayi)​របស់បាណិនិ (Pāṇini)។" },
        { "cell": "latin-in-native", "text": "ចំណែក​ឯ Philology កើត​មាន​មុន​ភាសាវិទ្យា​បច្ចុប្បន្ន តែ​កាលនោះ​គេ​សិក្សា​តែ​ពី​វេយ្យាករណ៍​ និង​ការ​ប្រើប្រាស់ភាសាដោយ​ផ្អែក​លើ​សម័យ​កាល​ ឬ ប្រវត្តិ​នៃភាសាប៉ុណ្ណោះ។" },
        { "cell": "latin-in-native", "text": "មជ្ឈមណ្ឌលពត៌មានអំពីម្ហូបអាហារនិងការបំប៉នចំណី Food & Nutrition Information Center" },
        { "cell": "latin-in-native", "text": "ភ្ជាប់ទៅគេហទំព័រ របស់MayoClinic និយាយពីរោគសញ្ញានិងជម្ងឺជាច្រើនប្រភេទជាភាសាអង់គ្លេស" },
        { "cell": "latin-in-native", "text": "PubMed គេហទំព័រដែលមានប្រមូលផ្តុំនូវអត្ថបទបោះពុម្ពប្រភេទ Journals, ទស្សនាវដ្តី និង សៀវភៅផ្នែកពេទ្យជាច្រើនពាន់ក្បាល" },
        { "cell": "latin-in-native", "text": "Family Doctors វេជ្ជបណ្ឌិតប្រចាំគ្រួសារ" },
        { "cell": "latin-in-native", "text": "គេហទំព័រនៃទីក្រុងញូវយកដែលនិយាយអំពីបញ្ហាសុខភាព ជាភាសាអង់គ្លេស និង អេស្បាញ NOA Health" },
        { "cell": "latin-in-native", "text": "សំណេរក្រោយ​មកមានការ​ប្រើ​ប្រាស់ពាក្យនេះក្នុងន័យប្រាស​ចាក​ពី​ន័យ​ដើម​របស់វា ពោលគឺនៅពេល​ដែលពាក្យនេះត្រូវបានយកទៅប្រើឲ្យសមន័យទៅនឹងពាក្យបារាំងឬអង់គ្លេសថា អេកូនូមី (Economy)។" },
        { "cell": "percent", "text": "ទ្វីប​នេះបាន​គ្របដណ្ដប់លើផ្ទៃដីជាង ៤៤​ លានគីឡូម៉ែត្រការ៉េ ដែលស្មើនឹង ៣០% នៃផ្ទៃដីសរុបនៅលើផែនដី និង ៨% នៃ​ផ្ទៃផែនដី។" },
        { "cell": "percent", "text": "អាស៊ីមាន​ប្រជាជនរស់នៅប្រមាណ ៤.៧ ពាន់លាន​នាក់ដែលស្មើនឹងប្រមាណ ៦០% នៃ​ប្រជាជន​ទាំងអស់នៅលើពិភពលោក។" },
        { "cell": "percent", "text": "សេដ្ឋកិច្ចប្រទេសឥណ្ឌាក៏បាទទួលការអភិវឌ្ឍន៍រីកចម្រើនខ្លះផងដែរ ពិសេសបន្ទាប់ពីការធ្វើសេរីភាវូបនីយកម្មសេដ្ឋកិច្ចឥណ្ឌាដែលបានចាប់ផ្តើមនៅក្នុងទសវត្សរ៍ឆ្នាំ១៩៩០ ដោយភាពក្រីក្រកម្រិតធ្ងន់បានធ្លាក់ចុះមកនៅក្រោម ២០%។" },
        { "cell": "percent", "text": "ទ្វីបនេះបានគ្របដណ្តប់លើផ្ទៃផែនដីប្រមាណ ៩% (ឬ ៣០% នៃផ្ទៃដីនៃភពផែនដី) ហើយមានឆ្នេរសមុទ្រវែងបំផុតផងដែរដោយអូសបន្លាយចម្ងាយ ៦២,៨០០ គីឡូម៉ែត្រ។" },
        { "cell": "percent", "text": "ក្រុមហ៊ុនអន្តរជាតិសរុបប្រមាណ ៦៨% គឺសុទ្ធតែមានការិយាល័យយ៉ាងតិចមួយកន្លែងនៅទីក្រុងហុងកុង។" },
        { "cell": "percent", "text": "នៅចុងទសវត្សរ៍ឆ្នាំ១៩៩០ និងដើមទសវត្សរ៍ឆ្នាំ២០០០ សេដ្ឋកិច្ចប្រទេសចិនត្រូវបានគេសង្កេតឃើញថាមានអត្រាកំណើនប្រចាំឆ្នាំជាមធ្យមលើសពី ៨%។" },
        { "cell": "percent", "text": "បើយោងតាមប្រវត្តិវិទូសេដ្ឋកិច្ច លោកអង់ហ្គូស ម៉ាដឌីសុនបានឱ្យដឹងថា ឥណ្ឌាគឺធ្លាប់មានសេដ្ឋកិច្ចធំជាងគេបំផុតនៅលើពិភពលោកក្នុងរយៈពេល ៣ សហវត្សរ៍មុន លើកលែងតែនៅក្រោយសតវត្សរ៍ទី១៩ ដោយសេដ្ឋកិច្ចឥណ្ឌាកាលនុះគឺស្មើនឹង ២៥% នៃទិន្នផលឧស្សាហកម្មសរុបនៅលើពិភពលោក។" },
        { "cell": "percent", "text": "ជ្វីហ្វគឺជាក្រុមជនជាតិភាគច្រើននៅប្រទេសអ៊ីស្រាអែល (៧៥.៦%) ដែលមានចំនួនប្រមាណ ៦.១ លាននាក់ ប៉ុន្តែមិនប្រាកដថាជនជាតិជ្វីហ្វទាំងអស់សុទ្ធតែកាន់សាសនាយូដានោះទេ។" },
        { "cell": "rate", "text": "ថ្ងៃទី ៣០ ខែមេសា ឆ្នាំ ១៩៧៥ របបសាធារណរដ្ឋវៀតណាមត្រូវដួលរលំ ដែនដីកម្ពុជាក្រោមត្រូវបានត្រួតត្រាដោយរដ្ឋាភិបាលបក្សកុម្មុយនិស្ត វិមាននរោត្តម ត្រូវបានប្តូរឈ្មោះទៅជា សាលឯកភាព (Hội trường Thống Nhất ) តាមសេចក្តីសម្រេចលេខ 77A/VHQĐ ចុះថ្ងៃទី ២៥ ខែមិថុនា ឆ្នាំ ១៩៧៦ របស់ក្រសួងវប្បធម៌ ដែលសព្វថ្ងៃជា ក្រសួងវប្បធម៌ កីឡា និង ទេសចរណ៍ (Bộ Văn hóa – Thể thao và Du lịch ) នៃរដ្ឋាភិបាលសាធារណរដ្ឋសង្គមនិយមវៀតណាម ។" },
        { "cell": "rate", "text": "កំរិតរំលាយអុកស៊ីសែន ៥ ml/l។" },
        { "cell": "rate", "text": "វត្ថុមួយមានល្បឿន 1 m/s ចរបាន 1 m ដោយប្រើរយៈពេល 1 s។" },
        { "cell": "rate", "text": "ល្បឿនដើរជាមធ្យមរបស់មនុស្ស 1 m/s" },
        { "cell": "rate", "text": "តារាវិទូជាច្រើននាក់ជឿថាកាឡាក់ស៊ីមីលគីវេយកំពុងធ្វើចលនា​ដោយល្បឿនប្រហែល 600 km/s ធៀបនឹងកាឡាក់ស៊ីដទៃទៀតដែលនៅក្បែរ។" },
        { "cell": "rate", "text": "ផែនដីកំពុងធ្វើចលនាវិលជុំវិញខ្លួនឯងដោយល្បឿន 0.4651 km/s ចំពោះចំនុចលើអេក្វាទ័រ។" },
        { "cell": "rate", "text": "ម្យ៉ាងទៀតផែនដីក៏វិលជុំវិញព្រះអាទិត្យដោយល្បឿនប្រហែល 30 km/s។" },
        { "cell": "rate", "text": "ចលនាដែលលឿនជាងគេគឺចលនាផ្លាកកូកូស (75 mm/ឆ្នាំ) និងផ្លាកប៉ាស៊ីហ្វិក (52–69 mm/ឆ្នាំ)។" },
        { "cell": "zero-width", "text": "សមថកម្មដ្ឋាន គឺជាការគ្រៀកចិត្ត​ឬចងចិត្តឲ្យជាប់ក្នុងអារម្មណ៍តែមួយមិនបណ្តោយឲ្យចិត្តត្រាច់ចរទៅរកអារម្មណ៍ផ្សេងៗ។" },
        { "cell": "zero-width", "text": "ភាសាវិទ្យា​ គឺ​ជាការសិក្សា​អំពី​ភាសា​តាមបែប​វិទ្យា​សាស្ត្រអំពីភាសា។" },
        { "cell": "zero-width", "text": "គេ​មិនគួរ​ច្រឡំ​ភាសាវិទ្យា​ និង​វេយ្យាករណ៍​ឡើយ ព្រោះ​ចំពោះ​ភាសាមួយ​វេយ្យាករណ៍​ជាក្បួនខ្នាត​មាន​លក្ខណៈ​ប្រពៃណី​ជាង ហើយ​មាន​ប្រធានបទ​​ខ្លះ​គេ​សិក្សា​ក្នុង​ភាសាវិទ្យា​​តែ​ពុំ​មាន​សេចក្ដី​លម្អិត​ក្នុង​វេយ្យាករណ៍​ប្រពៃណី​ឡើយ។" },
        { "cell": "zero-width", "text": "ភាសាវិទ្យា​សិក្សា​ផ្នែក​ផ្សេងៗ​នៃ​ភាសា មាន​ដូចជា ការបញ្ចេញ​សម្លេង ការ​កត់ត្រា​សម្លេង ន័យ​របស់​ពាក្យ របៀប​​រៀប​លំដាប់​ពាក្យឱ្យ​មាន​ន័យ​ស្ដាប់​បាន របៀប​ប្រើ​ប្រាស់​ភាសា​តាម​បរិបទ និង​លក្ខណៈជាច្រើន​ទៀត។" },
        { "cell": "zero-width", "text": "សាខារបស់​ភាសាវិទ្យា​ ចេះ​តែ​កើនឡើង​ជា​បន្តបន្ទាប់​តាម​កាលសម័យ។" },
        { "cell": "zero-width", "text": "ក្រុមប្រឹក្សាជាតិ​ភាសាខ្មែរ ឋិតនៅក្រោម​រដ្ឋបាលនៃ​ទីស្ដីការគណៈរដ្ឋមន្ត្រី។" },
        { "cell": "zero-width", "text": "ក្រុមប្រឹក្សាជាតិភាសាខ្មែរផ្សាយ​ព្រឹត្តិបត្រ និង សទ្ទានុក្រមផ្សេងៗ​ទាក់​ទង​នឹង​ភាសាជាតិ។" },
        { "cell": "zero-width", "text": "មកទល់បច្ចុប្បន្ន ការ​ផ្សាយ​ភាគច្រើន​និយាយអំពី​ការប្រើប្រាស់​ពាក្យ និង​ពាក្យ​ថ្មីៗដែល​ក្រុមប្រឹក្សា​ប្រកាស​ឱ្យ​ប្រើ ហើយ​គេ​ពុំ​សូវ​ឃើញ​មាន​ការ​ផ្សាយ​ពី​ទម្រង់​សំនេរ​ច្រើននៅ​ឡើយ​ទេ។" },
        { "cell": "roman", "text": "សាលាអន្តរជាតិ ស៊ី អាយ អាយ អេស （CII-SCHOOL)" },
        { "cell": "roman", "text": "ព្រាប សុវត្ថិ បានបន្តច្រៀងក្នុងផលិតកម្ម រស្មីហង្សមាស ពីឆ្នាំ ១៩៩៥ ដល់ឆ្នាំ ១៩៩៧ ជាមួយតារាចម្រៀងជាច្រើនដូចជា៖ លោក សុះ ម៉ាច និង អ្នកស្រី សួន ចន្ថា ក្នុងអាល់ប៊ុមរស្មីហង្សមាស RHM Album (CD Vol.19) និង កញ្ញា ទូច ស៊ុននិច ក្នុងអាល់ប៊ុមរស្មីហង្សមាស RHM Album (CD Vol.20), RHM Album CD Vol.24, RHM Album CD Vol.25។" },
        { "cell": "roman", "text": "ក្នុងឆ្នាំ ១៩៩៨-១៩៩៩ ព្រាប សុវត្ថិ បានចាប់ដៃគូចម្រៀង ជាមួយអ្នកស្រី ហ៊ឹម ស៊ីវន និង អ្នកស្រី សួន ចន្ថា ចេញនូវអាល់ប៊ុមរួមគ្នា ក្នុងអាល់ប៊ុមរស្មីហង្សមាស RHM Album CD Vol.26, RHM Album CD Vol.27 និង RHM Album CD Vol.29, RHM Album CD Vol.33, RHM Album CD Vol.34 ដែលជាអាល់ប៊ុមចម្រៀងឆ្លងឆ្លើយដែលមានការពេញនិយមស្ដាប់ជាច្រើនផងដែរ។" },
        { "cell": "roman", "text": "សង្គ្រាម​លោក​លើក​ទី២ (អង់គ្លេស: World War II) អក្សរកាត់ (WW2) គឺជាសង្គ្រាមពិភពលោកដែលចាប់ផ្ដើមលើកទី២ បន្ទាប់ពីសង្គ្រាមពិភពលោកលើកទី១ ត្រូវបានបញ្ចប់ ។" },
        { "cell": "roman", "text": "វិទ្យាស្ថាន អ៊ីនធីរេដ II" },
        { "cell": "roman", "text": "Internet Exchange Point (IX,IXP) ចំណុចផ្លាស់ប្តូរចរាចរណ៍ឥន្ធើណិត" },
        { "cell": "roman", "text": "ជ័យវរ្ម័នទី២ (អង់គ្លេស: Jeyvaraman II) (សំស្ក្រឹត: Jayavarman II) (ប្រ.ស|គ.ស ៧៧០-៨៥០) រជ្ជកាលគ្រងរាជ (គ.ស ៨០២-៨៣៥) ព្រះអង្គជាស្ដេចខ្មែរដ៏ខ្លាំងពូកែមួយព្រះអង្គដែលរើបំរាសពីការត្រួតត្រា របស់រាជវង្ស សៃលេន្ត្រៈ ដែលមកពីកោះជ្វា (អង់គ្លេស: Java) នៃប្រទេស ឥណ្ឌូណេស៊ី បច្ចុប្បន្ន ។" },
        { "cell": "roman", "text": "ជ័យវរ្ម័នទី៣ (អង់គ្លេស: Jeyvaraman III) (សំស្ក្រឹត: Jayavarman III) (ប្រ.ស|គ.ស ៨១២-៨៧៧) រជ្ជកាលគ្រងរាជ (គ.ស ៨៣៥-៨៧៧) មិនមានកំណត់ត្រារៀបអភិសេក និង មិនមានកំណត់ត្រាអំពីបុត្រស្នងរាជ្យឡើយ ។" },
        { "cell": "initialism", "text": "ចក្រភពមោរ្យា (Maurya Empire) នៃ​សតវត្ស​ទី​៤ និង​ទី​៣​មុន​​គ្រិស្ត​សករាជ​​បាន​ស្គាល់​ភាព​រុងរឿង​ដល់​កំពូល​ក្នុង​រជ្ជកាល ព្រះបាទ អសោក (​ASHOKA) ដោយ​គ្រប​ដណ្តប់​ស្ទើរតែ​ទាំងស្រុង​នៃ​ភូមិភាគ អាស៊ីខាងត្បូង។" },
        { "cell": "initialism", "text": "ប៉ុន្មាន​ឆ្នាំ​ថ្មីៗ​នេះ ឥណ្ឌា​បាន​ដើរ​តួនាទី​ដ៏​មាន​ឥទ្ធិពល​ក្នុង​សមាគម​អាស៊ាន SAARC និង​ WTO ។" },
        { "cell": "initialism", "text": "ទោះបី​ជា​មាន​ការ​រិះគន់​ និង​មាន​ការ​ផ្ដល់​សច្ចាប័ន​យោធា​ក៏ដោយ​ ឥណ្ឌា​ នៅ​តែ​រក្សា​ជំហរ​បដិសេធ​មិន​ព្រម​ចុះ​ហត្ថលេខា​លើ​ CTBT និង NTP ជំនួស​ការ​ថែ​រក្សា​អធិបតេយ្យភាព​លើ​កម្មវិធី​នុយក្លេអ៊ែរ​របស់​ខ្លួន​។" },
        { "cell": "initialism", "text": "ខាងក្រោមគឺជាតំបន់សម្គាល់នីមួយៗក្នុងទ្វីបអាស៊ីដែលប្រើប្រាស់ដោយក្រុមផ្នែកស្ថិតិអង្គការសហប្រជាជាតិ (UNSD)។" },
        { "cell": "initialism", "text": "កំណើនសន្ទស្សន៍អភិវឌ្ឍន៍មនុស្ស (HDI) ក្នុងអាស៊ីបូព៌ាបានហក់ស្ទុះឡើងខ្ពស់ជាងឆ្ងាយពីតំបន់ដទៃៗទៀតនៅលើពិភពលោក ដោយកំណើនរបស់វាស្ទើរកើនជិតទ្វេដងនៃ HDI ជាមធ្យមដែលបានសម្រេចនៅក្នុងរយៈពេល ៤០ ឆ្នាំមុន នេះបើយោងតាមការវិភាគរបស់របាយការណ៍អំពីទិន្នន័យសុខភាព ការអប់រំ និងប្រាក់ចំណូល។" },
        { "cell": "initialism", "text": "ហុងកុងជារដ្ឋនៅអាស៊ីដែលជាប់ចំណាត់ថ្នាក់ខ្ពស់បំផុតនៅក្នុងចំណោមប្រទេសផ្សេងៗនៃ HDI (ពោលមានចំណាត់ថ្នាក់លេខ ៧ នៅលើពិភពលោកដែលជាចំណាត់ថ្នាក់ \"អភិវឌ្ឍន៍មនុស្សខ្ពស់\") បណ្ដាប្រទេសអាស៊ីជាបន្តបន្ទាប់គឺ សិង្ហបុរី (៩) ជប៉ុន (១៩) និងកូរ៉េខាងត្បូង (២២)។" },
        { "cell": "initialism", "text": "អាហ្វហ្កានីស្ថាន (១៥៥) គឺជាប្រទេសអាស៊ីដែលជាប់ចំណាត់ថ្នាក់ទាបបំផុតក្នុងចំណោមប្រទេសសរុប ១៦៩ ដែលមាននៅក្នុងបញ្ជី HDI។" },
        { "cell": "initialism", "text": "ប្រទេស​០៥​នៃ​សហភាពអឺរ៉ុប បាន​ជាប់​ចំណាត់ថ្នាក់​ក្នុង​ចំណោម​១០​ប្រទេស ដែល​មាន​សេដ្ឋកិច្ច​ធំជាងគេ​លើ​ពិភពលោក បើ​គិត​តាម​អំណាចទិញ (PPP) ។" },
        { "cell": "grouped", "text": "អ្នកវិទ្យាសាស្ត្រស្រាវជ្រាវជឿថា អម្បូរមនុស្សបច្ចុប្បន្ន ឬអូម៉ូសាព្យាងនោះបានធ្វើនិរប្រវេសន៍មកកាន់អាស៊ីខាងត្បូងនៅប្រមាណ ៦០,០០០ ឆ្នាំមុនតាមបណ្តោយមហាសមុទ្រឥណ្ឌា។" },
        { "cell": "grouped", "text": "បុព្វបុរសនៃពួកអឺរ៉ាស៊ីខាងកើតបានបំបែកចេញពីពួកអឺរ៉ាស៊ីបុរាណខាងលិចនៅប្រមាណ ៤៦,០០០ ឆ្នាំមុន ដោយធ្វើនិរប្រវេសន៍ចេញពីតំបន់ខ្ពង់រាបអ៊ីរ៉ង់។" },
        { "cell": "grouped", "text": "ភ័ស្តុតាងពីការសិក្សាអំពីពន្ធុវិទ្យាពេញលេញបានបង្ហាញថា មនុស្សដំបូងនៅទ្វីបអាមេរិកត្រូវបានបែកចេញពីពួកអាស៊ីបូព៌ាបុរាណនៅប្រមាណ ៣៦,០០០ ឆ្នាំមុន ហើយបានវាតទីទៅភាគខាងជើងចូលទៅកាន់តំបន់ស៊ីបេរី ដែលជាកន្លែងពួកគេបានជួប និងប្រាស្រ័យទាក់ទងជាមួយក្រុមមនុស្សស៊ីបេរីសម័យថ្មបំបែក (ដែលគេស្គាល់ថា ពួកអឺរ៉ាស៊ីបុរាណខាងជើង) ហើយក៏បានបង្កបង្កើតជាក្រុមមនុស្សប៉ាលេអូស៊ីបេរី និងពួកអាមេរិកាំងបុរាណ។" },
        { "cell": "grouped", "text": "អឺរ៉ុប គឺជា​ទ្វីប​តូចជាងគេ​ទី២ បន្ទាប់ពី «អូសេអានី» ដែល​មាន​ក្រឡាផ្ទៃ​ប្រមាណ ១០,១៨០,០០០ គីឡូម៉ែត្រការ៉េ ឬ ២% នៃ​ផ្ទៃ​ផែនដី និង ប្រហែល ៦.៨% នៃ​ផ្ទៃដី​។" },
        { "cell": "grouped", "text": "អឺរ៉ុប គឺជា​ទ្វីប​ដែល​មាន​ប្រជាជន​ច្រើនជាងគេ​ទី៣ បន្ទាប់ពី​អាស៊ី និង អាហ្វ្រិក ដែល​មាន​ប្រជាជន ៧៣១,០០០,០០០ ឬ ប្រហែល ១១% នៃ​ប្រជាជន​ពិភពលោក​។" },
        { "cell": "grouped", "text": "ទោះយ៉ាងណាក៏ដោយ តាម​របាយការណ៍​អង្គការសហប្រជាជាតិ ចំនួន​ប្រជាជន​នៅ​ទ្វីប​នេះ នឹង​ធ្លាក់​មក​នៅ​ត្រឹមតែ ៧% នៅ​ឆ្នាំ​២០៥០ ដែល​មាន​ចំនួន​ប្រហែល ៦៥៣,០០០,០០០ ប៉ុណ្ណោះ​។" },
        { "cell": "grouped", "text": "ប្រទេសកម្ពុជាមានផ្ទៃក្រឡាសរុប ១៨១,០៣៥ គីឡូម៉ែត្រការ៉េ ដោយមានព្រំប្រទល់ជាប់នឹងប្រទេសថៃនៅភាគខាងលិចនិងពាយ័ព្យ ប្រទេសឡាវនៅភាគឦសាន្ត ប្រទេសវៀតណាមនៅភាគខាងកើត និងឈូងសមុទ្រថៃ​នៅភាគនិរតី។" },
        { "cell": "grouped", "text": "បុរេប្រវតិ្តសាស្រ្តនៅឥណ្ឌូចិនមានរយៈពេលប្រហែល ១០០០ ០០០ ឆ្នាំហើយ។" },
        { "cell": "signed-number", "text": "ទោះបី​ចាល​នា​តស៊ូ​ទាំងនេះ​ត្រូវ​បាន​បង្ក្រាប​យ៉ាង​ ​ឃោរឃៅ​ពី​សំណាក់​ ​កងទ័ព​បារាំង​ក៏​ដោយ​ ​តែ​បាន​រីក​ផុសផុល​មិន​ឈប់​ឈរ​រហូត​ដល់​រជ្ជកាល​ព្រះបាទ​ស៊ី​សុវត្ថិ​មុនី​វង្ស​ ​(១៩២៧ -១៩៤១) និង​បន្ត​មក​ដល់​រជ្ជកាល​ព្រះបាទ​នរោត្តម​សីហ​នុ​វរ្ម័ន​ក្នុង​រាជ្យ​ទី​១​ ​(១៩៤១ - ១៩៥៥)។" },
        { "cell": "signed-number", "text": "​ ​ពី​ឆ្នាំ​១៩៥១​-១៩៥៣ ដោយសារ​មានការ​គាបសង្កត់​ពី​មតិ​សកលលោក​ ​និង​ដោយសារ​ស្ថានភាព​របស់​ខ្លួន​ចុះ​ខ្សោយ​ទាំង​ផ្នែក​នយោបាយ​ ​និង​ ​យោធា​នៅ​ឥណ្ឌូ​ចិន​។" },
        { "cell": "signed-number", "text": "​ ​ផលិតផល​ស្រូវ​កើនឡើង​តិចតួច​ ​តែ​មាន​មនុស្ស​រាប់រយ​ពាន់​នាក់​បាន​ស្លាប់​រវាង​ឆ្នាំ​១៩៧៦​-១៩៧៨ ដោយ​កង្វះខាត​ចំណីអាហារ​ ​ធ្វើការ​ហួសកំលាំង​ ​និង​ជំងឺ​ដ​ង្កា​ត់​ដែល​ពុំ​បាន​យកចិត្តទុកដាក់​ព្យាបាល​ ​និង​ពិនិត្យ​រោគ​សញ្ញា​ ​ខុស​។" },
        { "cell": "signed-number", "text": "​ ​ក្នុង​ឆ្នាំ​១៩៩៥​ សេដ្ឋកិច្ច​ប្រទេស​ទាំងមូល​មាន​កម្រិត​ត្រឹម​ពី​៤០​-៥០ ភាគរយ​ប៉ុណ្ណោះ​បើ​ ​ប្រៀបធៀប​ ​ទៅ​នឹង​មុន​ឆ្នាំ​ ​១៩៧០សម្រាប់អ្នកមកទស្សនានៅប្រទេសកម្ពុជា ភាព​ក្រីក្រ​ត្រូវ​បាន​បិទ​បាំង​ដោយសារ​ភាព​រីក​ចម្រើន​ដែល​គេ​ ​មើលឃើញ​នៅ​ភ្នំពេញ​។" },
        { "cell": "signed-number", "text": "១,២៥០,០០១​៛​-៨,៥០០,០០០​៛ គិត​ ​១០%" },
        { "cell": "signed-number", "text": "៨,៥០០,០០១​៛​-១២,៥០០,០០០​៛ គិត​ ​១៥%" },
        { "cell": "signed-number", "text": "អង្គ​ការស​ហប្រជាជា​តិបានធ្វើ​ការវា​យតំលៃថា​ នៅលើពិ​ ភ​ពលោក​ចំនួន​ក្មេងតាម​ចិញ្ចើ​មថ្នល់​ដែលមា​នអាយុ​ពី៣​-១៨​ឆ្នាំមានកា​រកើន​ឡើងជា​រៀងរាល់ថ្ងៃ​។" },
        { "cell": "signed-number", "text": "​ នៅ​ក្នុងទី​ក្រុងភ្នំពេ​ញមាន​​១០,០០០​ ទៅ​២០,០០០​នាក់ ​ ដែល​មាន​៥០​ភាគរ​យជាក្មេងស្រី ​និងភាគ​ច្រើនមាន​អាយុពី៦​-១៥​ឆ្នាំ។" },
        { "cell": "letter-name", "text": "ប្រាសាទនេះត្រូវបានសិក្សាដោយលោក ប៉ាម៉ង់ ទីយ៉េ និងលោកឡាហ្សង់ គីយ្យា លោកអៃម៉ូនីញ៉េ និងលោកបាកអស់រយៈពេលមួយសតវត្សរ៍មកហើយ ចុងក្រោយបំផុតសិលាចារឹកសំខាន់ៗទាំងនោះដែលមានរហូតដល់ទៅប្រាំបួនផ្ទាំង ត្រូវបានបកប្រែជាបន្តបន្ទាប់ ជាពិសេសសិលាចារឹក K-៣៤១ និងបកប្រែដោយលោក ហ្សក សឺដេស នៅក្នុងឆ្នាំ១៩៥៤។" },
        { "cell": "letter-name", "text": "នៅ​ឆ្នាំ ១៩៨០ ព្រះ​មហា​ឃោសានន្ទ និង​​បព្វជិត​សាសនា​គ្រីស្ទាន ១ រូប គឺ​គ្រូ​គង្វាល ភីធ័រ ឡរ៉ែន្ស ផនដ៍ (Peter L. Pond) បាន​បង្កើត​ « បេសកកម្ម​អន្តរសាសនា​ដើម្បី​សន្តិភាព​នៅ​កម្ពុជា » ។" },
        { "cell": "letter-name", "text": "ហាំង ង៉ោHaing S. Ngor, the first Cambodian to ever won an academy award for his supporting acting role in The Killing Fields, playing Dith Pran, the New York Time's reporter working with Syndney Schamberg." },
        { "cell": "letter-name", "text": "១៧៩៨ - សង្គ្រាម​ផាស៊ីស: The U.S. Congress rescinds treaties with France sparking the 'war.'" },
        { "cell": "letter-name", "text": "១៩៨៣ - សង្គ្រាម​ត្រជាក់: Samantha Smith, a U.S. schoolgirl, flies to the Soviet Union at the invitation of Secretary General Yuri Andropov." },
        { "cell": "letter-name", "text": "1907 - Robert A. Heinlein, អ្នក​និពន្ធ​សញ្ជាតិ​អាមេរិច (ស. ១៩៨៨)" },
        { "cell": "letter-name", "text": "1908 - Revilo P. Oliver, សាស្ត្រាចារ្យ​សញ្ជាតិអាមេរិច (ស. ១៩៩៤)" },
        { "cell": "letter-name", "text": "បុណ្យ​នេះ​កើត​ដោយ​សារ​ទណ្ឌកម្ម​កាងារ(乞巧節; qǐ qiǎo jié)ដែល​ក្លាយ​មក​ពី​បុណ្យ អូបន(O-bon) ក្នុង​សម័យ​កាល អ៊ីដូ(Edo) ។" },
        { "cell": "exponent", "text": "ដង់សុីតេប្រជាជន គឺជាស្ថិតិដែលបង្ហាញពីចំនួនរស់នៅរបស់ប្រជាជនជាអចិន្រ្តៃយ៍ក្នុងមួយគីឡូម៉ែត្រការ៉េ គិតត្រឹមឆ្នាំ 2023 ក្រុងភ្នំពេញមានប្រជាជនសរុបចំនួន 2.3 លាននាក់ និងមានអត្រាប្រជាជនចំនួន 5,700 នាក់ ក្នុងមួយគីឡូម៉ែត្រការ៉េ (5,700/km²) ការប៉ាន់ស្មានចំនួនប្រជាជន និងការព្យាករទាំងនេះបានមកពីការកែសម្រួលចុងក្រោយបំផុតនៃចក្ខុវិស័យនគរូបនីយកម្មពិភពលោករបស់អង្គការសហប្រជាជាតិ ។" },
        { "cell": "exponent", "text": "ប្រទេសកម្ពុជា​មាន​ផ្ទៃ​ដី ១៨១ ០៣៥ គម²។" },
        { "cell": "exponent", "text": "ដង់ស៊ីតេ​ប្រជាជន​គឺ​ចំនួន​ប្រជាជន​ក្នុង​១គម²។" },
        { "cell": "exponent", "text": "ប្រជាជន​កម្ពុជា​មាន​ផ្ទៃ ១៨១ ០៣៥គម² និង​មាន​ដង់ស៊ីតេ​ប្រជាជន​មធ្យម ៦៤នាក់ក្នុង ១គម²។" },
        { "cell": "exponent", "text": "ក្នុង​ចំណោម​ខេត្ត​ក្រុង​ទាំងអស់​ដង់ស៊ីតេ​ប្រជាជន​ប្រែប្រួល​ពី ២នាក់ក្នុង ១គម²នៅ​មណ្ឌលគីរី ដល់ ៣៤៤៨នាក់ក្នុង ១គម²នៅ​រាជធានី​ភ្នំពេញ​។" },
        { "cell": "exponent", "text": "គីឡូម៉ែត្រ​ការ៉េ: (square kilometre) សរសេរកាត់ជាភាសាខ្មែរ គម២ និងជាអក្សរឡាតាំង km² ជាខ្នាតនៃក្រលាផ្ទៃ ។" },
        { "cell": "exponent", "text": "អាល់បឺត អាន់ស្តាញ លោកជាអ្នកទ្រឹស្ដីរូបវិទ្យាដែលកើតនៅប្រទេសអាល្លឺម៉ង់ ដែលត្រូវបានគេស្គាល់ថាជាអ្នកបង្កើតទ្រឹស្តីទំនាក់ទំនងនៃរូបវិទ្យាកង់ទិច រូបមន្តដ៏ល្បីល្បាញរបស់លោកគឺ សមមូលថាមពល E=mc² ។" },
        { "cell": "exponent", "text": "ទីក្រុងនេះមានផ្ទៃដីសរុប ១៣៩,៩០ km² ។" },
        { "cell": "arithmetic", "text": "ព្យញ្ជនៈ មាន ៣៣+២=៣៥ តួ ។" },
        { "cell": "arithmetic", "text": "ស្រៈ​ពេញ​តួ ១២+៣=១៥ តួ ។" },
        { "cell": "arithmetic", "text": "១គម២= ១០០០០០០ម២ (១០៦ម២)" },
        { "cell": "arithmetic", "text": "១គម២= ១០០ ហិចតា (១០០ha)" },
        { "cell": "arithmetic", "text": "១ម២= ០,០០០០០១គម២(១០⁻៦គម២)" },
        { "cell": "arithmetic", "text": "(២) title = ចំណងជើងដែលបង្ហាញនៅលើថាសបារខាងលើគេបង្អស់នៃ Browser" },
        { "cell": "arithmetic", "text": "ផលបូក: \\,(a + bi) + (c + di) = (a + c) + (b + d)i" },
        { "cell": "arithmetic", "text": "ផលដក: \\,(a + bi) - (c + di) = (a - c) + (b - d)i" },
        { "cell": "ampersand", "text": "វត្តពោធិវង្ស & វត្តបុទុមសាគរ ឃុំកោះខ្សាច់ទន្លា" },
        { "cell": "ampersand", "text": "នៅ​ឆ្នាំ ១៩៧៨ លោក ប្រ៊ីយ៉ាន ឃ័រនីញ៉ាន (Brian Kernighan) និង ដេនីស រីឆាត (Dennis Ritchie) បាន​បោះពុម្ព​សៀវភៅ The C Programming Language លើក​ទី​មួយ ដែល​ក្រោយ​មក​បាន​គេ​ហៅ​ថា \"K&R\"។" },
        { "cell": "ampersand", "text": "scanf(\"%lf %lf\",&a, &b); /*បញ្ជូលតំលៃ a និង b*/" },
        { "cell": "ampersand", "text": "អារ៉ាប់ពីយ៉ា (រាំវង់) ទូច ស៊ុននិច & ឡោ សារិត" },
        { "cell": "ampersand", "text": "ក្រោយទទួលរាជសម្បត្តិគ្រងរាជទ្រង់មានព្រះបរមនាមថា \"វ្រះបាទ ធូលីជេង វ្រះកម្រតេង អញ ឝ្រីជយវម៌្មទេវ\" ប្រែជាខេមរៈភាសា \"ព្រះបាទដែនដីខាងជើង ព្រះកម្រតែងអញ ព្រះស្រីជ័យវរ្ម័នទេវៈ\" ដែលមានរាជធានីឈ្មោះ \"ហៈរិហៈរាល័យ\" (Kh-pronoun: Hariharealay) & (Foreingners text: Hariharālaya) នៅតំបន់រលួស ខេត្តសៀមរាប ។" },
        { "cell": "ampersand", "text": "ទីលានបាល់ទាត់ថ្មី​និងទីលានកីឡាក្នុងម្លប់មួយត្រូវបានសាងសង់នៅក្រុងប៉ាស៊ីហ្គ ដោយដាក់ឈ្មោះថា University of Life Track & Field and Arena (ULTRA) ដែលបច្ចុប្បន្នប្ដូរឈ្មោះជា" },
        { "cell": "ampersand", "text": "នៅឆ្នាំ១៨៨០ គ្រួសារនេះបានប្ដូរទីលំនៅទៅ​ក្រុងមឿនហិន (មុយនិច) ដែលនៅទីនោះ ឪពុកលោករួមគ្នាជាមួយឪពុកមារបស់លោកបានបើកក្រុមហ៊ុនមួយឈ្មោះ Elektrotechnische Fabrik J. Einstein & Cie ដែលជាក្រុមហ៊ុនផលិតបរិក្ខារអគ្គីសនី​ប្រើចរន្តជាប់។" },
        { "cell": "ampersand", "text": "Einstein, Albert; Podolsky, Boris & Rosen, Nathan (15 May 1935), \"Can Quantum-Mechanical Description of Physical Reality Be Considered Complete? (តើការពណ៌នាបែបកង់ទិច-មេកានិច នៃភាពពិតបែបរូបវិទ្យា អាចចាត់ទុកថាពេញលេញហើយឬនៅ?\", Physical Review 47(10): 777–780, doi:10.1103/PhysRev.47.777" },
        { "cell": "iteration", "text": "សមាធិ គឺការតាំងចិត្តមាំក្នុងអារម្មណ៍តែមួយ ឬការដឹងច្បាស់នូវអារម្មណ៍នោះៗដោយសច្ចភាព។" },
        { "cell": "iteration", "text": "គ្រួសារប្រឈម​មុខ​នឹង​ការសំរេចចិត្តជាច្រើនដូចជាថា​​តើ​សមាជិក​ក្នុង​គ្រួសារ​និមួយៗត្រូវធ្វើ​អ្វី​ខ្លះ? អ្នកណា​ជា​អ្នក​បោកគក់​? អ្នកណា​ជា​អ្នកដាំស្ល​? តើ​ចំណូល​ដែល​រកបាន​ត្រូវ​សន្សំ​ប៉ុន្មាន​និង​ចាយ​វាយ​ប៉ុន្មាន? តើត្រូវចាយវាយលើ​អ្វី​ខ្លះ រាប់ចាប់តាំង​ពី​ការចំណាយប្រចាំថ្ងៃ ការចំណាយលើការសិក្សា​របស់​កូនៗ ការ​ដាក់ទុន​រកស៊ី ។" },
        { "cell": "iteration", "text": "និយាយ​អោយ​ខ្លី​ គ្រួសារនិមួយៗ​ត្រូវ​បែងចែក​ធនធាន​របស់​ខ្លួន​ក្នុង​ចំណោម​សមាជិកដោយ​ផ្អែក​លើ​សមត្ថភាព​ ការខិតខំ​ប្រឹងប្រែង ចំណង់​ចិត្តរបស់​ពួកគេ​ម្នាក់ៗ និងត្រូវធ្វើយ៉ាងណាដើម្បីរក្សាលំនឹងស្ថានភាព​គ្រូសារផងដែរ។" },
        { "cell": "iteration", "text": "​ យើងនឹងពិនិត្យទៅលើការឲ្យនិយមន័យ ដល់ពាក្យសេដ្ឋសាស្ត្រដោយបណ្តាសេដ្ឋវិទូនៅគ្រប់មជ្ឈដ្ឋាន ហើយនិងពីអ្វីៗដែលពូកគេនិយាយអំពីសេដ្ឋសាស្ត្រ។" },
        { "cell": "iteration", "text": "លោក Paul Samuelson បានសរសេរថា \"កម្មវត្ថុសិក្សាស្តីពីសេដ្ឋសាស្ត្រគឺជាការប្រើប្រាស់ធនធាន ភោគទ្រព្យដែលមានកំណត់សំរាប់ផលិតទំនិញនិងសេវា រួចបែងចែក​របស់​ទាំងនោះ​ទៅអោយ​វណ្ណៈ និងក្រុមមនុស្សផ្សេងៗគ្នា\"។" },
        { "cell": "iteration", "text": "ពិនិត្យតាមនិយមន័យនេះ មានពាក្យ​បីសំខាន់គឺរបៀប​ វិធីសាស្ត្រចាត់ចែងធនធានកំរ និងសង្គម អាចប្រែបានថាជាក្បួនខ្នាត ដែលសំដៅទៅលើការរៀបចំធានធានដែលមានកំណត់ ដូចជាផ្ទៃដី ធនធានធម្មជាតិ ប្រជាជន ដោយធ្វើយ៉ាង​ណាឲ្យទទួលផលមកវិញជាអតិបរមា ហើយមិនមែនសំរាប់មនុស្សម្នាក់ៗទេ តែសំរាប់បណ្ដុំមនុស្សទាំងអស់ ឬក៏សង្គមមួយ។" },
        { "cell": "iteration", "text": "មុខវិជ្ជា​នេះ​ត្រូវ​បាន​បែងចែក​ជា​ពីរ​សាខា​គឺ៖​ មីក្រូសេដ្ឋកិច្ចដែល​សិក្សា​ពី​បុគ្គល​​ម្នាក់ៗ​មានដូចជា​គេហជន​ និង​អាជីវកម្ម និង​ម៉ាក្រូសេដ្ឋកិច្ច​ជាកាសិក្សា​​ពីកិច្ចការ​របស់​ប្រទេស​មួយទាំងមូល​​ដែល​ជាទូទៅ​ពិចារណា​ទៅលើ​ការផ្គត់ផ្គង់សរុប​និងតម្រូវការសរុប​ មូលធន និងទំនិញ។" },
        { "cell": "iteration", "text": "ក្រោយ​ការ​​សោយទីវង្កត​របស់​ព្រះបាទ អសោក ឥណ្ឌា​បាន​ធ្លាក់ចុះ​ខ្សោយ​ ដោយ​ចក្រភព​ឥណ្ឌា​ត្រូវ​បែក​ទៅ​ជា​រដ្ឋ​តូចៗ​ជាច្រើន​។" },
        { "cell": "sports-time", "text": "23:00:00 ចប់កម្ឦវិធី" },
        { "cell": "sports-time", "text": "23:00:01 កម្មវិធីផ្ងៃស្អែក" },
        { "cell": "sports-time", "text": "ដែលត្រូវនិងម៉ោងនៅទីក្រុងភ្នំពេញ ៤:៥៣:០៩វិនាទីព្រឹកនាថ្ងៃពុធ ទី១៣ ខែមករា ឆ្នាំ២០១០។" },
        { "cell": "sports-time", "text": "រាមនេះណាស់៕< នៅសហរដ្ឌអាមេរិចខាងត្បូងមានការរញ្ជួយដីនៅប្រទេសឆីលីនៅវេលាម៉ោង ០៣:៣៤:១៧ វិនាទីម៉ោងនៅក្នុងស្រុកនាថ្ងៃ សៅ" },
        { "cell": "sports-time", "text": "ទោះជាយ៉ាងណាក៏ដោយ បើកសិករមានផ្ទៃដីតូចជាងនេះ ឬច្រើនជាងនេះ ក៏អាចប្រើតាមរូបមន្ដ ៣០:៣០:៣០:១០ ជាគោលកំណត់បាន ពោលគឺ៖" },
        { "cell": "sports-time", "text": "នៅថ្ងៃទី២៨ ខែមីនា ឆ្នាំ២០២៥ នៅវេលាម៉ោង ១២:៥០:៥២ ម៉ោងនៅមីយ៉ាន់ម៉ា (០៦:២០:៥២ ម៉ោងសកល) មានគ្រោះរញ្ជួយដីកម្រិត ៧.៧ វិចទ័រមួយបានកើតឡើងនៅតំបន់សាហ្គាំងនៃប្រទេសមីយ៉ាន់ម៉ា ជាពិសេសនៅជុំវិញទីក្រុងម៉ាន់ដាឡាយ ដែលជាទីក្រុងធំបំផុតទីពីរនៅក្នុងប្រទេស។" },
        { "cell": "version-dot", "text": "​ ប្រទេសនេះមានរដ្ឋធានីថាទីរ៉ាណា ដែលមានប្រជាជនរស់នៅប្រមាណជាជាង៧២៧ ០០០នាក់ ក្នុងចំនោមប្រជាជន៣.៦លាននាក់ ហើយវាក៏ជាកន្លែងហិរញ្ញវត្ថុដ៏សំខាន់ក្នុងប្រទេសផងដែល។" },
        { "cell": "version-dot", "text": "ខេត្តព្រះវិហារមានផ្ទៃដីសរុប ១៣.៧៨៨ គីឡូម៉ែត្រការ៉េ ក្នុងនោះផ្ទៃដីបង្ករបង្កើនផលមានចំនួន ៣០.០០០ហិចតា និងមានចំនួន៨៥%ជាព្រៃឈើ។" },
        { "cell": "version-dot", "text": "បច្ចុប្បន្ន ផែនដីវិលជុំវិញ ព្រះអាទិត្យមួយដងក្នុងរាល់366.26ដងវិលជុំវិញអាក្សខ្លួនឯង(ស្មើនឹង 365.26 ទិវាសុរិយៈ), ដំណាក់កាលមួយត្រូវបានស្គាល់ថាជាទំព័រពិតនៃឆ្នាំ។" },
        { "cell": "version-dot", "text": "តាមការធ្វើជំរឿនប្រជាជនកម្ពុជានៅថ្ងៃទី៣ ខែមីនា ឆ្នាំ២០១៩ បានបង្ហាញថា ខេត្តតាកែវមានប្រជាជនសរុបចំនួន ៨៩៩,៤៨៥នាក់ និងមានដង់ស៊ីតេចំនួន ២៥២.៥នាក់ក្នុងមួយគីឡូម៉ែត្រការ៉េ។" },
        { "cell": "version-dot", "text": "ខេត្តមណ្ឌលគីរីមានផៃ្ទដីសរុបទាំងអស់ ១៤២៨៨គីឡូម៉ែត្រការ៉េ ដែលមានប្រជាជនសរុប ៣២៤០៧នាក់ មាន៥៦៥៧គ្រួសារ ប្រុស១៦៣៨០នាក់ និង ស្រី១៦០២៧នាក់ (តាមរបាយការណ៍ជំរឿនឆ្នាំ១៩៩៨) ហើយដង់ស៊ីតេប្រជាជនគិតជាមធ្យម ២នាក់ក្នុង ១គីឡូម៉ែត្រការ៉េ អត្រាកំនើនប្រជាជន ០.៣២ភាគរយ។" },
        { "cell": "version-dot", "text": "ជាក់ស្តែង ក្នុងឆ្នាំ២០១៩ ខេត្តក្រចេះ បានស្វាគមន៍ភ្ញៀវទេសចរទាំងជាតិ-អន្តរជាតិ សរុបចំនួន ៣៧៣.៦៩៦នាក់ ក្នុងនោះភ្ញៀវជាតិ ចំនួន ៣៤៦.៨១៨នាក់ និងភ្ញៀវអន្តរជាតិ ចំនួន ២៦.៨៧៨នាក់ ។" },
        { "cell": "version-dot", "text": "ខេត្តក្រចេះ មានប្រជាពលរដ្ឋសរុបចំនួន ៤១៧.៣២១នាក់ ស្រ្តី ២១០.៨៣៧នាក់ ស្មើនឹង ៩៤.០៨០គ្រួសារ ដង់ស៊ីតេប្រជាជន ៣៧នាក់/គម២ ដែលប្រមាណ ៨២,២% ជាកសិករ ១៧,៣% ជាសេវាករ និង០,៥% ជាសិប្បករ ។" },
        { "cell": "version-dot", "text": "នៅថ្ងៃទី០១ ខែកញ្ញា ឆ្នាំ១៩៣៩ ប្រទេសអាល្លឺម៉ង់បានបញ្ជូនកងកម្លាំងរបស់ខ្លួនចំនួន ១.៥លាននាក់ រថក្រោះ ២,៧០០គ្រឿង យន្តហោះចម្បាំង ២,៣១៥គ្រឿង និង កាំភ្លើងធំ ៩,០០០ដើម ចូលទៅឈ្លានពានប្រទេសប៉ូឡូញ ។" },
        { "cell": "quote-letter", "text": "គោលបំណងរបស់ខ្មែរក្រហមគឺចង់កែទម្រង់វិស័យកសិកម្មតាមរយៈការប្រមូលផ្តុំប្រជាជនឱ្យធ្វើការរួមគ្នាដែលជាហេតុនាំឱ្យមានការអត់ឃ្លាននៅពាសពេញផ្ទៃប្រទេស ខណៈពេលដែល'អង្គការ'បានស្បថថានឹងជួយមើលថែរក្សាប្រជាជន ប៉ុន្តែតាមពិតវាបែរជាផ្ទុយពីនោះទៅវិញ។" },
        { "cell": "quote-letter", "text": "'ខ្មែរក្រហម'ជាភាសាឡាតាំងគឺ Khmer Rouge ឬ red Khmer។" },
        { "cell": "quote-letter", "text": "ទោះបីជាយ៉ាងណាក្តី, រដ្ឋាភិបាលចម្រុះកម្ពុជាប្រជាធិបតេយ្យនូវតែបន្តយក'ដប់ប្រាំពីរមេសាជោកជ័យ'ជាបទភ្លេងជាតិរបស់ពួកគេ។" },
        { "cell": "quote-letter", "text": "វ៉ាន់ ណាត, painter and one of seven Tuol Sleng Torture Prison's Survivors" },
        { "cell": "quote-letter", "text": "ឌិត ប្រ៉ន, compiled stories and poems of Cambodian genocide survivors and published The Children of the Killing Fields: Memoirs of Survivors. His life's story has been portrayed in the movie, The Killing Fields. His genocide education project has helped people in the United States to further understand the flight of the Cambodian people." },
        { "cell": "quote-letter", "text": "'ស្រុកកោះអណ្ដែត'ជាស្រុកមួយដែលសម្បូរទៅដោយអ្នកចេះដឹងយ៉ាងសម្បូរបែប​។" },
        { "cell": "quote-letter", "text": "ចាប់ពីឆ្នាំ ១៨៨៧ ដល់ ១៩៤៥ រដ្ឋការអាណានិគមបារាំងទូទាំងឥណ្ឌូចិន (Gouverneur-général de l’Indochine Française) បានប្រើអាគារនេះជាទីស្នាក់នៅ និងសម្រាប់ប្រជុំកិច្ចការរដ្ឋការធំៗ ទើបគេហៅហៅថា អាគាររដ្ឋាភិបាល ។" },
        { "cell": "quote-letter", "text": "ចាប់ពីឆ្នាំ ១៨៨៧ ដល់ ១៩៤៥ រដ្ឋការអាណានិគមបារាំង ទូទាំងឥណ្ឌូ ចិន (Gouverneur-général de l’Indochine Française) បានប្រើអាគារនេះជាទីស្នាក់នៅ និងសម្រាប់ប្រជុំកិច្ចការរដ្ឋការធំៗ ទើបគេហៅហៅថា អាគាររដ្ឋាភិបាល ។" },
        { "cell": "scaled-currency", "text": "ប្រុសមានប្រាក់ចំណូលមធ្យម$៣២,៣២៩ ផ្ទុយមកវិញ$២១,៩៨៦សំរាប់ស្ត្រី ។" },
        { "cell": "scaled-currency", "text": "ចិនបានប្រមែប្រមូលជំនួយយោធាទៅអោយពួកខ្មែរក្រហម ដែលក្នុងទសវត្ស១៩៨០បានបង្ហាញថាជាកងកម្លាំងកុបកម្មដ៏អង់អាចបំផុត គ្រានោះសហរដ្ឋបានគាំទ្រជាសាធារណៈដល់លទ្ធភាពមិនមែនកុម្មុយនិស្តទល់នឹងស.ប.ក. រដ្ឋការរីហ្គឹនបានយល់ស្រប$៥ លានជាជំនួយទៅរ.រ.ជ.ប.ខ.សាធារណរដ្ឋ ដែលដឹកនាំដោយអតីតនាយករដ្ឋមន្ត្រីលោកសឺន-សាន និងក.ជ.ស. ជាស្លាបប្រដាប់អាវុធនៃគណបក្សហ៊្វុនស៊ិនប៉ិចសីហនុនិយម ។" },
        { "cell": "scaled-currency", "text": "គ្រួសារដែលត្រូវបានសម្ភាសបានចំណាយជាមធ្យម 105 ថ្ងៃក្នុងមួយឆ្នាំលើការទាញយកជ័រ ហើយចំណូលសរុបប្រចាំឆ្នាំជាមធ្យមពីជ័ររាវប្រហែល US$3,236; ការសិក្សាក៏បានរាយការណ៍ថាបរិមាណទិន្នផលប្រែប្រួលតាមទំហំដើមឈើ និងលក្ខខណ្ឌទីតាំងដូចជាការជិតផ្លូវទឹក។" },
