    "command": "npx tsx tools/normalization/mine.ts mine --in tw.ak.txt,fat.ak.txt --out ak.jsonc --lang ak --segment paragraph --terms ak.tsv --source \"tw.wikipedia + fat.wikipedia dumps (pages-articles, paragraphs), filter-by-language.py --lang ak\" --per-cell 6 --sample 40",
