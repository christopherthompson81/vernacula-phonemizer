    "hard": [
        { "cell": "degrees", "text": "ሞንቴቪዲዮ ከፊል ሞቃታማ ክፍል ውስጥ ይገኛል፤ በበጋ ወራት፣ +30°C የሙቀት መጠኖች የተለመዱ ናቸው።" },
        { "cell": "degrees", "text": "ፍሬድ የሳተላይት የምስል ስርአት ከመምጣቱ በኋላ በአትላንቲክ ውቅያኖስ ላይ በደቡብ እና ምስራቅ እስካሁን ከተመዘገበው በጣም ጠንካራው ማዕበል ነው፣ እና በምስራቅ 35 °W የተመዘገበው ሶስተኛው ብቻ ዋና ማዕበል ነው።" },
        { "cell": "digit-run", "text": "እንደ NSA፣ እንደ ካምፕ ዴቪድ አኮርድስ፣ 1978፤ በ1970ዎች የአሜሪካ እና የቻይና ግንኙነትን መመለስ፤ የኢራን ታጋች ቀውስን የመራው የኢራን ርዕዮተ አለም፣ 1979፤ እና በአፍጋኒስታን የሶቭየት ወረራ፣ 1979 ያሉ የአለም ጉዳዪች በዲፕሎማሲ መንገድ ለማስተናገድ ካርተርን ረዳው።" },
        { "cell": "digit-run", "text": "1000ኛው እትሙ በ2000 ላይ ያሳታተመው አስገራሚው «ግሬት ዲድስ ባይ ስዊድሽ ኪንግስ» በዴቪድ ክሎከር አህረንስትራል ነው፣ በዓለም አቀፍ የድንቃድንቅ መዝገብ ላይ ተጠቅሷል።" },
        { "cell": "digit-run", "text": "በመጨረሻም የእንጨት ጎማዎች በብረት ተተኩ። በ1767፣ የመጀመሪያዎቹ ሙሉ በሙሉ ብረት የሆኑ ሃዲዶች ተዋወቁ።" },
        { "cell": "digit-run", "text": "ከ2010 ፌደራላዊ ምርጫ በፊት ከመረጡት 1,400 ሰዎች ውስጥ፣ የአውስትራሊያን ሪፐብሊክ መሆን የሚቃወሙት ከ2008 አንስቶ በ8 በመቶ አደጉ።" },
        { "cell": "fractions", "text": "ማን እንደፃፈው ማንም በእርግጠኝነት ባያውቅም፣ በህይወቱ መጀመሪያ ላይ፣ ትልቁ የብራና ሰነድ (29¾ ኢንች በ 24½ ኢንች ይለካል) ለመቀመጥ ተጠቅልሏል።" },
        { "cell": "fractions", "text": "የስንጥቅ ሰረዙ ጥልቀት ያለው ፣ 5 ሚሜ (1/5 ኢንች) ወይም ከዚያ በላይ ፣ እና እቃው በቀዝቃዛ አየር ውስጥ በበቂ ሁኔታ ለስላሳ መሆን አለበት።" },
        { "cell": "clock", "text": "የዋና ጣቢያው ሁለት ሬዲዮዎች ሳሉት፣ ይህ ከ 802.11a ፣ 802.11b እና 802.11g ጋር ወደኋላ የሚስማማ እንዲሆን ያስችለዋል።" },
        { "cell": "clock", "text": "10:00-11:00 ከሰዓት ኤምዲቲ መካከል፣ ግቢ ውስጥ በእስረኞቹ እሳት ተነሳ።" },
        { "cell": "clock", "text": "በመጨረሻ የእሳት አደጋ መከላከያ ሠራተኞች ከሌሊቱ 11:35 ሰዓት ላይ እሳቱን ማጥፋት ችለዋል።" },
        { "cell": "clock", "text": "አውቶቡሶች ቀኑን ሙሉ ከየአውራጃው የአውቶቡስ መናኸሪያ (ከወንዙ ማዶ) ይነሳሉ ፣ ምንም እንኳን አብዛኛዎቹ በተለይም ወደ ምስራቅ እና ጃካር/ቡምታን የሚጓዙት ከ 06:30 እስከ 07:30 ባለው ጊዜ ውስጥ ይነሳሉ።" },
        { "cell": "signs", "text": "በተጨማሪም ለብዙ ሀገሮች የባንክ ኖቶችን መቅረጽ ላይ ተሰማርቶ ነበር። የቅርብ ከሆኑ ስራዎቹ መካከል በአዲሶቹ የካናዳ $5 እና $100 ዶላሮች ፊትለፊት ላይ የጠቅላይ ሚኒስትር ሥዕሎችን ጨምሮ ይገኙበታል፡፡" },
        { "cell": "signs", "text": "በመጀመሪያው ሰርብ 76 ነጥቦችን በማሸነፍ ናዳል በጨዋታ ውስጥ 88% የተጣሩ ነጥቦች አግኝቷል።" },
        { "cell": "signs", "text": "የአውሮፓ ቱርክ (ምስራቃዊ ትሬስ ወይም በባልካን ባሕረ ሰላጤ ያለችው ሩሚሊያ) የሀገሪቷን 3% ያካትታል።" },
        { "cell": "signs", "text": "ከ250 አመታት በኋላ፣ ጊኒስ በአመት 10 ቢሊዮን ዩሮዎች (US$14.7 ቢሊዮን) የሚያስገባ አለም አቀፋዊ ንግድ ሆኗል።" },
        { "cell": "dotted", "text": "የደቡብ ምዕራብ አፍሪካ ህዝቦች ድርጅት (ኤስ.ደብልዩ.ኤስ.ፒ.ኦ) ገዥው ፓርቲ፣ በፓርላማው ምርጫም ብዙዎችን እንደያዘ ቆይቷል።" },
        { "cell": "dotted", "text": "እስከ አሁን ድረስ፣ በአሜሪካ ውስጥ በስፋት ጥቅም ላይ በመዋሉ ምክንያት ኤ.ኦ.ኤል በራሱ ፍጥነት የአይ.ኤም ገበያውን ማንቀሳቀስ እና ማሳደግ።" },
        { "cell": "dotted", "text": "በ 1970 እ.ኤ.አ. የህክምና ዶክተር እና የምርምር ሳይንቲስት የሆኑት ሬይመንድ ዳማዲያን መግነጢሳዊ አስተጋብኦ ምስልን እንደ ለህክምና ምርመራ መሣሪያ ለማድረግ መሠረቱን አገኙ።" },
        { "cell": "dotted", "text": "የእንስሳት ነፃ አውጭ እና ሮያል ሶሳይቲ ፎር ፕሪቨንሽን ኦፍ ክሩሊቲ ቱ አኒማልስ (አር.ኤስ.ፒ.ሲ.ኤ) በሁሉም የአውስትራሊያ የእርድ ቦታዎች የሲሲቲቪ ካሜራዎች እንዲገቡ እንደገና አሳውቀዋል።" },
        { "cell": "era-marker", "text": "የደቡብ ዋልታ መሻገሪያ (ወይም አውራ ጎዳና) በሮዝ ባሕር እስከ ዋልታው ድረስ ከማክሙርዶ ጣቢያ 1600 ኪ.ሜ. ነው።" },
        { "cell": "year", "text": "ፖርቹጊዞቹ አፈረሱት እና ካዛ ብራንካ በሚል ስም መልሰው ገነቡት፣ በ1755 ከመሬት መንቀጥቀጥ በኋላ መልሰው ተዉት።" },
        { "cell": "year", "text": "ሰሜናዊው ክፍል ወይም ሰንቲነል ሬንጅ በ 4892ሜ ከፍታ የቪንሰን ተራራ የአንታርቲካን ትልልቅ ተራሮች የያዘውን ቪንሰን ማሲፍ ይዟል።" },
        { "cell": "year", "text": "ከድልድዩ ስር ያለው ቀጥታ ከፍታ 15 ሜትር ነው። ግንባታ የተጠናቀቀው በኦገስት 2011 ነው፣ እስከ ማርች 2017 ለህዝብ ክፍት አልሆነም።" },
        { "cell": "year", "text": "ኦገስት 15 ቀን 1940 አሊያንስ ደቡባዊ ፈረንሳይን ወረሩ ፣ ወረራው “ኦፕሬሽን ድራጎን” ተባለ።" },
        { "cell": "decimals", "text": "ፓርኩ 19,500 ኪ.ሜ² የሚሸፍን ሲሆን፤ በ14 የተለያዩ የኢኮ ዞኖች ተከፋፍሏል፤ እያንዳንዱ የተለያየ የዱር ህይወት ይዟል።" },
        { "cell": "decimals", "text": "ጃፓኖች ወደ 7,000 የሚጠጉ ደሴቶችን የያዙ (ትልቁ ደግሞ ሆንሹ ይባላል) ሲሆን ጃፓንን በዓለም 7 ኛ ትልቋ ደሴት ያደርጋታል!" },
        { "cell": "decimals", "text": "አፒያ የሳሞአ ዋና ከተማ ናት። ከተማዋ በኡፖሉ ደሴት ላይ ናት እና ለትንሽ ከ40,000 ያነሰ የህዝብ ቁጥር አላት።" },
        { "cell": "decimals", "text": "ፍየሎች በመጀመሪያ ከ 10,000 ዓመታት በፊት በኢራን ዛግሮስ ተራሮች ውስጥ ለመጀመሪያ ጊዜ በቤት ውስጥ የተሰማሩ ይመስላል።" },
        { "cell": "units", "text": "በምድር ላይ 200 ፓውንድ (90kg) የሚመዝን ሰው በ IO ላይ ወደ 36 ፓውንድ (16 ኪሎ ግራም) ይመዝናል። ስለዚህ የስበት ኃይል በእርግጥ በእናንተ ላይ ያንሳል።" },
        { "cell": "ranges", "text": "የእንቅልፍ መቋረጥ በመደበኛ የእንቅልፍ ጊዜዎ ውስጥ አውቀው የመንቃት እና ከትንሽ ጊዜ በኋላ (10–60 ደቂቃዎች) መልሶ የመተኛት ሂደት ነው።" },
        { "cell": "ranges", "text": "ክንዋኔዎቹ የተከሰቱበት ጊዜ ከፍተኛ መካከለኛው ዘመን በመባል ይታወቃል በአውሮፓ ታሪክ ውስጥ 11ኛው፣ 12ኛው እና 13ኛው ክፍለዘመናት (AD 1000–1300)።" },
        { "cell": "ranges", "text": "ዴል ፖትሮ በሁለተኛው ዙር ቀዳሚ ጥቅም ነበረው፣ ግን ይህም 6-6 ከደረሱ በኋላ የአቻ መለያ አስፈለገው።" },
        { "cell": "ranges", "text": "በ 1683 የቺንግ ሥርወ-መንግሥት (1644-1912) ኃይሎች የታይዋን ምዕራባዊ እና ሰሜናዊ የባህር ዳርቻ አካባቢዎችን ተቆጣጥረው ታይዋንን በ 1885 የቺንግ ኢምፓየር አውራጃ መሆኗን አወጁ።" },
        { "cell": "currency", "text": "ባትን በ2008ቱ 400 ሀብታም አሜሪካኖች ዝርዝር ላይ $2.3 ቢልየን የተገመተ ሀብት ኖሮት 190ኛ ሆኖ ቀርቧል።" },
        { "cell": "currency", "text": "አይነተኛ ትኬቶች ¥7,000 አካባቢ የሚያስከፍሉ ሆኖ ሳለ አብዛኞቹ የሁነት ትኬቶች በ¥2,500 እና ¥130,000 መካከል እንደሚያስከፍሉ ይጠበቃል።" },
        { "cell": "currency", "text": "በምድር ላይ በጣም ጥቂት ከሆኑት ዐለቶች/አልማዞች መካከል አንዳንዶቹ በአሜሪካን ዶላር ከ US$11,000 ዶላር እስከ $22,500 ዶላር እየተሸጡ ሲሆን ከወርቅ ዋጋ በአስር እጥፍ ይበልጣል።" },
        { "cell": "currency", "text": "ካፌኔት ኤል ሶል ለአንድ ቀን መግቢያዎች በዩኤስ$30፣ ወይም $10 ክፍያ የማስያዝ አገልግሎትን ያቀርባል፤ ዝርዝር ኮርኮቫዶ ገፃቸው ላይ።" },
        { "cell": "abbrev", "text": "ሴቶች የባህል ልዩነቶች እነሱ ትንኮሳ ብለው ወደሚያስቡት እንደሚያመራ ማሰብ አለባቸው እና መከተል እና በእጅ መጎተት ወዘተ. ያልተለመደ አይደለም።" },
        { "cell": "abbrev", "text": "በመስታወቱ አምስት ደቂቃ በኋላ ንፋሱ መግባት ይጀምራል፣ ከአንድ ደቂቃ በኋላ ንፋሱ 70ኪ.ሜ/ሰዓ. እየደረሰ ነው… ከዛ ዝናቡ ይመጣል ነገር ግን በጣም ከባድ እና ትልቅ ከመሆኑ የተነሳ ቆዳህን እንደ መርፌ ይመታዋል ከዛ በረዶ ከሰማይ ወረደ፣ ሰዎች እየደነገጡ እና እየጮሁ እና እርስ በራሳቸው ላይ ይሮጣሉ።" },
        { "cell": "abbrev", "text": "ይህ በኖርዌይ፣ ስዊድን፣ እና ኒው ዚላንድ ይዛመዳል፣ ነገር ግን አለበለዚያ በጣም ልዩ (ምሳ. በኔዘርላንድ ቁጥሩ አንድ ለ አርባ ነው)።" },
        { "cell": "abbrev", "text": "የሰሜን ሮክ ባንክ ኩባንያው የUK መንግሥት የአስቸኳይ ጊዜ ድጋፍ ማግኘቱ ከታወቀ በኋላ እ.ኤ.አ. በ 2008 ዓ.ም ብሄራዊ ተደርጓል።" },
        { "cell": "latin-in-native", "text": "እስራኤል አንድ ስምምነት ከተፈረመ በኋላ ለአስር ዓመታት በሸለቆው ውስጥ ቀጣይነት ያለው ወታደራዊ መገኘት ትፈልጋለች፣ PA በበኩሉ እንዲህ ዓይነቱን መገኘት ለአምስት ዓመታት ብቻ እንዲሆን ይስማማል።" },
        { "cell": "latin-in-native", "text": "በ AI ውስጥ የሚደረግ ምርምር ብልህ ባህሪን የሚጠይቁ ስራዎችን በራስ-ሰር ለማከናወን ማሽኖችን መስራትን ያካትታል።" },
        { "cell": "latin-in-native", "text": "ገንዘብ ከ FIC ዌስት መደብር ባሻገር በስታንሌይ በሚገኙት ደሴቶች ብቸኛው ባንክ ሊለወጥ ይችላል።" },
        { "cell": "latin-in-native", "text": "በተሞከረው ኬሚካል ውስጥ ያለው የpH መጠን በሃይድሮጂን (H በ pH ውስጥ) አዮኖች መጠን ያመለክታል።" },
        { "cell": "percent", "text": "እነሱም የገንዘብ ገደቦችን እና የኢራን ኢኮኖሚ 80% የውጭ ገቢን የሚያገኝበትን ድፍድፍ ነዳጅ ወደ ውጭ ለመላክ በአውሮፓ ህብረት መከልከልን ያካትታሉ ፡፡" },
        { "cell": "percent", "text": "ወደ አውሮፓ እና ወደ ብሮድባንድ ሳተላይት ለሚያገናኙ የባህር ስር ፋይበር ኦፕቲክ ሽቦዎች ምስጋና ይግባቸው፤ ግሪንላንድ 93% ህዝብ የበይነ መረብ አገልግሎት የሚያገኝበት በደንብ የተገናኘ ሀገር ነው።" },
        { "cell": "rate", "text": "የተለጠፉት የፍጥነት ገደቦች በቀዳሚ እና ቀጣይ ክፍሎች — በተለምዶ 35-40 ማይል በሰዓት (56-64 ኪሜ/ሰ) —ውስጥ በሚያስታውቅ ሁኔታ ያነሱ ናቸው እና ካለማክበር ይልቅ ለእነርሱ በጥብቅ መገዛት በጣም ጠቃሚ ነው።" },
        { "cell": "rate", "text": "በፓርክ ባለስልጣናቱ መሰረት ከድቦችና ተኩላዎች ቢያንስ 100 ያርዶች/ሜትሮች እና ከሁሉም ሌሎች እንስሳት 25 ያርዶች/ሜትሮች ርቀው ይቆዩ።" },
        { "cell": "rate", "text": "የ802.11n ፍጥነቶች በፊት ከነበረው ከፍተኛ ንድፈ ሀሳባዊ 600 ሜቢ/ሰ ከሆነው እጅግ ይፈጥናል።" },
        { "cell": "rate", "text": "እነዚህ ከባድ አውሎ ነፋሶች እስከ 480 ኪ.ሜ/በሰዓት (133 ሜ/በሰከንድ ፤ 300 ማ/በሰዓት) የሚደርሱ ነፋሶች አሏቸው።" },
        { "cell": "roman", "text": "ከድምጽ መስጫ ጣቢያው ውስጥ 34 በመቶ የሚሆኑት ይህንን አመለካከት የሚጋሩ ሲሆን ንግስት ኤልሳቤጥ II የአውስትራሊያ የመጨረሻዋ ንግስት እንድትሆን ይፈልጋሉ።" },
        { "cell": "roman", "text": "ተጠባባቂ ጠቅላይ ሚኒስትር ጁሊያ ጊላርድ በ 2010 የፌዴራል ምርጫ ዘመቻ ወቅት ንግስት ኤልሳቤጥ II በንግሥና ማብቂያ አውስትራሊያ ሪፐብሊክ መሆን አለባት ብለው እንደሚያምኑ ተናግረዋል።" },
        { "cell": "initialism", "text": "MS በአንጎል ፣ በስፓይናል ኮርድ እና በኦፕቲክ ነርቭ የተገነባውን ማዕከላዊውን የነርቭ ሥርዓት የሚያጠቃ በሽታ ነው።" },
        { "cell": "initialism", "text": "ባለፈው ሳምንት፣ METI አፕል ኩባንያው “ከባድ ያልሆኑ” ብሎ የጠራቸውን 34 ተጨማሪ ከመጠን በላይ የመሞቅ ክስተቶች እንዳሳወቀው ገልጿል።" },
        { "cell": "initialism", "text": "ተሽከርካሪው ራሱ በተመሳሳይ ቀን በግምት 1200 GMT አደጋው ከተከሰተበት ቦታ ላይ ተወስዷል።" },
        { "cell": "initialism", "text": "በ2005 አመት ምክር ቤቱ የወሲብ ተነሳሽነትን በገንዘብ ማገዝ ጀመረ አና FBI 10 ወኪሎችን ወደ ለወሲባዊ ፊልሞች መስጠት እንዳለበት ጠቅሷል።" },
        { "cell": "grouped", "text": "ከ1966 ጀምሮ ሰንዳርባኖች የዱር እንስሳት መኖሪያ ሆነዋል፣ እናም በአሁኑ ጊዜ በአካባቢው 400 ሮያል ቤንጋል ነብሮች እና 30,000 አካባቢ ነጠብጣብ ያለባቸው ሚዳቋ እንደሚገኙ ይገመታል።" },
        { "cell": "grouped", "text": "ነገር ግን፣ ከሶቪዬት ህብረት ቀይ የጦር ኃይል 800,000 ወታደሮች ሪጋ የሰላም ውል፣ የሶቪዬት-ፖሊሽ ፀረ-ጠብ ስምምነት፣ እና ሌሎች የሁለት እና የብዙ ሃገራት አለምዓቀፍ ውሎችን በመጣስ የፖላንድን ምስራቃዊ ክልሎች ከወረሩ በኋላ ገብተው ቤላሩሲያዊ እና ዩክሬናዊ ግንባሮችን ሲፈጥሩ እነዚህ ዕቅዶች በአንድ ሌሊት ከሸፉ።" },
        { "cell": "grouped", "text": "አለም ከ 50 ሚሊዮን እና ከዚያ በላይ ተናጋሪዎች ያሏቸውን ሀያ ቋንቋዎች ጨምሮ 5,000 በላይ የተለያዩ ቋንቋዎች አሉት።" },
        { "cell": "grouped", "text": "ለስዊድን እና ለሌሎች 28 ሀገራት ከ1,000 በላይ የሚሆኑ ቴምብሮችን አምርቷል።" },
        { "cell": "letter-name", "text": "በተመሳሳይ ጊዜ የጀርመን የባህር ኃይል በዋናነት U-ጀልባዎችን በመጠቀም ይህንን ትራፊክ ለማስቆም እየሞከረ ነበር።" },
        { "cell": "letter-name", "text": "JAS 39C Gripen በማኮብኮብያ ሜዳ ላይ በ9፡30 am አካባቢያዊ ሰዕት (0230 UTC) ተከሰከሰ እና ፈነዳ፣ ስለሆነም ያንን የአየር ማረፊያ ለንግድ በረራውች ዝግ አደረገው።" },
        { "cell": "letter-name", "text": "መንገደኞች በ 90(F)-ሙቀት ላይ ቆመው ሲጠብቁ ውሃ ተሰጣቸው፡፡" },
        { "cell": "letter-name", "text": "ምልክቱ በአካል አልተጎዳም፣ ማሻሻያው የተደረገ ውሃ በማያበላሸው ጥቁር ቀለም ሲሆን “O”ን ለመቀየር እና ትንሿን “e” ለማንበብ በሰላም እና ልብ ቅርጾች ተሸብርቋል።" },
        { "cell": "exponent", "text": "ሰንዳርባን 3,850 ኪ.ሜ² ፣ ስፋት ይይዛል፣ ከዚህም አንድ-ሦስተኛው በውሃ/በረግረግማ ስፍራዎች የተሸፈነ ነው።" },
        { "cell": "ampersand", "text": "በላይኛው ጥግ፣ ቤድ&amp;ብሬክፋስቶች በግልጽ በዋነኝነት ሁለት ነገሮች ላይ ይወዳደራሉ፡ አልጋ አገልግሎት እና ቁርስ።" },
        { "cell": "sports-time", "text": "ሌላው ውድድሯ በግዙፉ ስላሉም በሴቶች ቡድን ውስጥ በተደመረ ሰዓት 4:41.30 ዐሥረኛ ሆና ስትጨርስ አየናት፣ ከመጀመሪያ ደረጃ ጨራሽ ኦስትሪያዊዋ ክላውዲያ ሎአስችህ 2:11.60 ቀስ ያለ እና ዘጠነኛ ከጨረሰችው የሃንጋሪዋ ግዮንግዪ ዳኒ 1:09.02 ያክል የዘገየ ጊዜ ነው።" },
        { "cell": "quote-letter", "text": "ዋናው የሀገር ውስጥ ቢራ 'ቁጥር አንድ' ነው፣ ውስብስብ ቢራ ሳይሆን፣ አስደሳች እና አርኪ ነው። ሌላው የሀገር ውስጥ ቢራ \"ማንታ\" ይባላል።" },
        { "cell": "quote-letter", "text": "አርኤስፒሲኤ ኒው ሳውዝ ዌልስ ዋና መርማሪ ዴቪድ ኦ’ሻነሲ የቄራዎች ክትትል እና ምርመራዎች አውስትራሊያ ውስጥ የተለመደ ነገር መሆን አለባቸው በማለት ለኤቢሲ ተነግሯል።" },
        { "cell": "quote-letter", "text": "የመንግስት መርማሪዎች ረቡዕ ዕለት ሁለት ‘የጥቁር ሣጥን’ የበረራ መቅጃዎችን ማግኘታቸውን ዢንህዋ ዘግቧል።" },
        { "cell": "quote-letter", "text": "ቨርጅን የገዛው የንብረት አስተዳደር ኩባንያ ሳይሆን 'የሰሜን ሮክ' ጥሩ ባንክን ብቻ ነው።" },
        { "cell": "scaled-currency", "text": "ህጉ በካሊፎርኒያ ግዛት ውስጥ የሚሸጡ አመፀኛ ቪዲዮ ጨዋታዎች \"18\" በሚል ፅሑፍ ምልክት እንዲደረግባቸው እና ከዚያ ዓመት በታች ለሆነ ልጅ መሸጥ በአንድ ጥፋት $1000 የሚያስቀጣ ነው።" },
        { "cell": "scaled-currency", "text": "21-አመት-ዕድሜ ያለው ጂሰስ ማንቸስተር ሲቲን ያለፈው አመት በጃንዋሪ 2017 ከብራዚል ፓልሜሪያስ ቡድን በ £27 ሚሊየን የተዘገበ ክፍያ ተቀላቀለ።" },
        { "cell": "scaled-currency", "text": "ነገር ግን ጠቅላይ ሚኒስትር ጆን ሆዋርድ እንደተናገሩት ድርጊቱ ተጨማሪ የ AUD$45 ሚሊዮን ዶላር በመስጠት የሆስፒታሉን ተቋማት በታስማኒያ መንግስት እንዳያወርዱ ለመጠበቅ ብቻ ነበር።" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "የማጓጓዣ ኩባንያዎች ነገሮችን በፍጥነት ለማቅረብ በደንብ ይከፈላሉ። ባብዛኛው ጊዜ ለንግድ ሰነዶች፣ ግብይይት ወይም ለአስቸኳይ ጥገና መለዋወጫ እቃዎች በጣም አስፈላጊ ነው።",
        "አንድን ንዑስ ባህል ልዩ የሚያደርጉት ባህሪዎች የቋንቋ፣ የስነ ውበት፣ የሃይማኖት፣ የፖለቲካ፣ የጾታዊ፣ የመልካ ምድራዊ ወይም የእነዚህ ቅልቅል ምክንያቶች ሊሆኑ ይችላሉ።",
        "ለምሳሌ፣ በሰሜን ካሮላይና ውስጥ ከሚገኙት የቤኔት ት/ቤት ተማሪዎች በየአመቱ ወደ ግዛቱ ዋና ከተማ ስለሚያደርጉት ጉዞ የድረ-ገጽ ዲዛይን ያዘጋጃሉ፣ በየዓመቱ ድረ-ገጹ እንደገና ይስተካከላል፣ ነገር ግን ነባር ስሪቶች እንደ ማጣቀሻ ስለሚያገለግሉ በመስመር ላይ ይቆያሉ።",
        "አደጋው ከተከሰተ በኋላ፣ ጊብሰን ወደ ሆስፒታል ተወሰደ ግን ከዚያ ወዲያው ሞተ።",
        "አደጋው በተራራማው የመሬት አቀማመጥ ከፍ ብሎ የተከሰተ ሲሆን በአደገኛ እሳት ምክንያት እንደሆነ ይታመናል።",
        "ከ1966 ጀምሮ ሰንዳርባኖች የዱር እንስሳት መኖሪያ ሆነዋል፣ እናም በአሁኑ ጊዜ በአካባቢው 400 ሮያል ቤንጋል ነብሮች እና 30,000 አካባቢ ነጠብጣብ ያለባቸው ሚዳቋ እንደሚገኙ ይገመታል።",
        "ስለዚህም አቅራቢዎቹ የሐሺሽ ጥቅሎችን በመድረክ ላይ ያጨሳሉ፣ ቲያትሩ እራሱ ሰዎች እንዲቀላቀሉ እያበረታታ ነው።",
        "አልጌው በሰውም ሆነ በአሳ ውስጥ ነርቮችን ሊያሰናክል የሚችል ኒውሮቶክሲን ይሠራል።",
        "የግሪንላንድ ተወላጆች ይህንን ቃል ሲጠቀሙ ቢሰሙም፣ የውጭ ዜጎች ሊጠቀሙበት አይገባም።",
        "ሉክሰምበርግ ረጅም ታሪክ ቢኖራትም ነፃነቷ ግን ከ 1839 ዓ.ም ጀምሮ ነው።",
        "ችሎቱ በርሚንግሃም ክራውን ፍርድ ቤት ውስጥ ተካሂዶ በኦገስት 3 ተጠናቋል።",
        "ከአንድ ሺህ ለሚበልጡ ዓመታት የክርስትና ሃይማኖት የቋንቋና የባህል ልዩነቶች ቢኖሩም የአውሮፓን ግዛቶች አንድ ላይ አቆራኝቷል። እኔ",
        "በዚህ ጊዜ ሰዎች ለመዝናናት እና ለመደሰት ከመደበኛ የዕለት ተዕለት ኑሯቸው በጣም ወደሚለይበት ቦታ ይሄዳሉ።",
        "የእርሱ ጥናት እንደሚያሳየው ሆርሞን ከተሰጠ የሕፃኑን የፅንስ የሳንባ ብስለት ያፋጥናል።",
        "በጣም ፈጣን ጊዜው ባለፉት ሁለት ወራት ውስጥ የነበረ፣ አንድ ዓመት የቆየ የገንዘብ ቀውስ አለን እና አሁን የገንዘብ ገበያዎቹ እያገገሙ እንደሆን አስባለሁ።”",
        "የአንድ ሰው ወደ አንድ ቦታ የሚደረግ ጉብኝት ዓላማው የቦታውን ታሪክ እና ባህል በደንብ ለማወቅ ከሆነ የዚህ ዓይነቱ ቱሪዝም ባህላዊ ቱሪዝም በመባል ይታወቃል።",
        "መንፈሳዊነት ማለት ከማይቀየር እውነታ፣ ከመለኮት፣ መንፈሳዊ እውነት፣ ወይም እግዚአብሔር ጋር ኅብረት፣ ማንነት ወይም እውቀትን መፈለግ ማለት ነው።",
        "ሲቅርቡት ወይም ሲቀርቧት የተጎጂውን ቦታ እና ማንኛውንምን ከባድ እንከኖች መገንዘብ አለቦት።",
        "ለስልክዎ የየኢንተርኔት ዳታ ከሌለዎት ወይም ከአገልግሎት ክልል ውጭ በሚሆንበት ጊዜ አፈፃፀማቸው ሊገደብ ወይም ላይገኝ ይችላል።",
        "ድምፁ አሁንም ቢሆን በኦክቶበር ወር ኮፐንሃገን ውስጥ በሚደረገው ዓለም አቀፍ የኦለምፒክ ኮሚቴ (IOC) ስብሰባ ላይ ሙሉው መፅደቅ አለበት።",
        "መኮንኖቹን እሷ 500 ጫማ ርቆ ወደሚገኘው ጥቁር ኦልድስሞቢል ሴራዋ መራቻቸው።",
        "ዳኒኤል የትሮፒካል ማዕበሉ፣ የ2010ሩ የአትላንቲክ ማዕበል ወቅት አራተኛው ስም የተሰጠው ማዕበል ሲሆን በሰሜን አትላንቲክ ውቅያኖስ ተከስቷል።",
        "ከSiem Reap በ12ኪሜ ደቡባዊ ምዕራብ ላይ የሚገኘው Phnom Krom። ይህ በኮረብታ ላይ የሚገኝ ቤተመቅደስ የተገነባው በ9ኛው ክፍለ ዘመን መጨረሻ ላይ በንጉስ Yasovarman ዘመን ነበር።",
        "በዚህም የተነሳ፣ ባለፉት አመታት ውስጥ ዳኞች፣ ጠበቆች፣ የተከሳሽ ጠበቃዎችና አቃቢ ሕጎች የሰሯቸው ሕገወጥ ስራዎች መጋለጣቸውን ተከትሎ በግሪክ የሕግ ማሕበረሰብ ውስጥ ከፍተኛ የሆነ ቅሌት ተነስቷል።",
        "ቁርስ የአካባቢውን ወቅታዊ አስደሳች ነገሮች ወይም የእንግዳ ተቀባዩን ልዩ ምግብ ሊያካትት ይችላል።",
        "ጊዜ በዙሪያችን ያለ ነገር ነው፣ እና የምናደርገውን ነገር ላይ ሁሉ ተጽእኖ የሚያደርግ ነገር ነው፣ ግን ለመረዳት አስቸጋሪ ነው፡፡",
        "በበረዶ ላይ የመንሸራተት ሐሳብ በጣም የቆየ ነው - ዋሻዎች ላይ የበረዶ ተንሸራታቾችን እንዲገልጹ የተሰሳሉት ስዕሎች እስከ 5000ቢሲ ድረስ ይደርሳሉ!",
        "ምስጢራዊነት ከሌላው የኃይማኖታዊ እምነት እና የአምልኮ ዓይነቶች ሊለይ የሚችለው ለየት ያለ የንቃተ ህሊና ቀጥተኛ የግል ተሞክሮ ላይ በማተኮር ነው ፣ በተለይም ሰላማዊ ፣ አስተዋይ ፣ ደስተኛ ፣ አልፎ ተርፎም አስደሳች ባህሪ።",
        "እያንዳንዱ ባቡር ሁለቱም ሜትሮፕላስ እና ሜትሮ ተሳቢዎች አሏቸው፤ ሜትሮፕላስ ተሳቢዎቹ ሁሌም ለኬፕ ታውን ቅርቡ የባቡር ጫፍ ላይ ናቸው።",
        "ድብቁ ሰው እንደ በስተጀርባ ዳራ እና እንደ ረጅም ታሪክ ተራኪ የተሰራ ነው፡፡"
    ]
}
