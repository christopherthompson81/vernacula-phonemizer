// MINED NORMALIZATION CORPUS — cjy. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer, for a
// language with no FLEURS corpus. The cells are the empirical shape of the rules the treated languages
// actually needed, so coverage of them is the completeness criterion — not size.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠⚠ AND WHETHER "sample" CAN CARRY THAT DEPENDS ON THE SOURCE, which this warning used to assert
// unconditionally. A uniform stride is only representative of what it strides OVER. Over a full dump it is
// the language's real distribution. Over an API fetch it is a stride across random ARTICLE INTROS plus
// articles chosen by a search ranked on the very patterns being measured — so a rate computed from it is a
// fact about the fetch, not about the language. The line below states which case this artifact is.
// ⚠ THIS artifact is API-sourced (random article intros + `insource:` fill), so `sample` is NOT
//   frequency-representative either — the fill's articles were chosen by a search ranked on the very
//   patterns being counted. Do not compute a rate from it; re-mine from a dump if a rate is needed.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: Wikimedia Incubator Wp/cjy (the only Jin corpus that exists — there is no cjy.wikipedia)
//
// ⚠ REGENERATE WITH THE COMMAND BELOW, NOT FROM MEMORY. This artifact's shape depends on flags that leave no
// trace in the data — omit --sample and the whole sample tier silently disappears; omit --terms and the lexical
// cells report EMPTY. Both happened while re-mining this fleet: km lost its 200-entry sample tier to a
// reconstructed invocation, and my dropped from 35/35 cells to 33/35 because it is the one language with a terms
// list and the sweep did not pass it. Neither failure is visible in the output — the run reports success.
//
// command: npx tsx tools/normalization/mine.ts mine --in cjy_prose.txt --out cjy.jsonc --lang cjy --source "cjy (the only Jin corpus that exists — there is no cjy.wikipedia)" --segment paragraph --per-cell 6 --sample 40
// segmentation: paragraph (no dot is ever interpreted — correct when the target IS the period)
{
    "language": "cjy",
    "source": "Wikimedia Incubator Wp/cjy (the only Jin corpus that exists — there is no cjy.wikipedia)",
    "command": "npx tsx tools/normalization/mine.ts mine --in cjy_prose.txt --out cjy.jsonc --lang cjy --source \"cjy (the only Jin corpus that exists — there is no cjy.wikipedia)\" --segment paragraph --per-cell 6 --sample 40",
    "segmentMode": "paragraph",
    "totalSegments": 36,
    "cellsCovered": 7,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 0,          // in 22 treated languages
        "digit-run": 4,        // in 19 treated languages
        "fractions": 0,        // in 18 treated languages
        "clock": 1,            // in 18 treated languages
        "signs": 1,            // in 17 treated languages
        "dotted": 0,           // in 16 treated languages
        "era-marker": 0,       // in 14 treated languages
        "year": 4,             // in 14 treated languages
        "decimals": 2,         // in 12 treated languages
        "ordinal-latin": 0,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 0,            // in 9 treated languages
        "ranges": 0,           // in 7 treated languages
        "currency": 0,         // in 6 treated languages
        "abbrev": 0,           // in 6 treated languages
        "latin-in-native": 11, // in 6 treated languages
        "percent": 0,          // in 5 treated languages
        "rate": 0,             // in 4 treated languages
        "zero-width": 0,       // in 4 treated languages
        "roman": 0,            // in 3 treated languages
        "initialism": 0,       // in 3 treated languages
        "grouped": 0,          // in 3 treated languages
        "signed-number": 0,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 0,      // in 3 treated languages
        "exponent": 0,         // in 24 treated languages
        "arithmetic": 0,       // in 2 treated languages
        "ampersand": 0,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 0,      // in 3 treated languages
        "version-dot": 2,      // in 3 treated languages
        "quote-letter": 0,     // in 4 treated languages
        "scaled-currency": 0,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 49 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 38
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "digit-run", "text": "晉語 是漢藏語系漢語族的一種語言，也是中國北廂漢族地勢唯獨一種不是官話的語言，到了1996年，晉語的使用人口約莫4500萬（不算上汾河片），按使用人口排世界第22名，在漢語中影響力僅次於官話（北方話）、吳語、粵語和閩南語。到2007年，晉語的母語使用人數有4762萬人（不算上汾河片），還是世界100大語言之一。" },
        { "cell": "digit-run", "text": "乔家大院占地10642平方米，建筑面积4175平方米。大院是双喜字型布局，分为6个大院，内套20个小院，313间房屋。整个院落是城堡式建筑，三面临街，四周是高达10余米的全封闭青砖墙。大门为城门式洞式。" },
        { "cell": "digit-run", "text": "晉語 ，震旦北廂唯獨一種非官話語言，使用人口約莫6305萬，晉語區迎太行山東bar起去，往西快也到賀蘭山、北挨的陰山、南面子抵住黃河汾渭河穀，是遠東文明的重要發源地行兒之一。" },
        { "cell": "digit-run", "text": "汾陽有約莫2600年的歷史。 [http://www.fenyang.gov.cn/chnl1005/ 走进汾阳]" },
        { "cell": "clock", "text": "汾陽市 （拼音：feng yo si ）是中華人民共和國山西省的一箇縣級市，呂梁市代管。在山西中部，太原盆地西南面子。北挨的文水縣、南面子抵住孝義市。人口約莫43.46萬。" },
        { "cell": "signs", "text": "35px|link=oldwikisource:Main_Page/晉語|維基文庫" },
        { "cell": "decimals", "text": "官話（又稱北方話、官話方言、北廂方言、北語）是漢藏語系漢語族的一種語言，説官話那主要地勢是中國北廂和西南的大部。官話有四箇聲調（不算輕聲），有那地勢有五箇聲調（西南官話、江淮官話）。官話的使用人口約莫11.2億（母語使用人口約莫9.2億)，是世界第一大語言。 [https://www.ethnologue.com/language/cmn/ 官话（《民族语》）]" },
        { "cell": "latin-in-native", "text": "迎輸入圪框框行兒寫上題目，完後點“寫動iaq”。 可嫑刪了前頭的“Wp/cjy/”。" },
        { "cell": "latin-in-native", "text": "晉語使用前綴，比方圪 /kəʔ/， 唿(忽) /xuəʔ/ 及嘿(黑)/xəʔ/， 𠯐(入、日）/ʐ(z)əʔ/，吥(不)/pəʔ/，來構成不同種類的派生詞。比方：𠯐(日）鬼（胡鬧、搞鬼）← 鬼；這些箇前綴大多數沒有傢意義。編輯頁面的時候甭忘了多用上它這些箇特色字/詞。" },
        { "cell": "latin-in-native", "text": "/pəʔ ləŋ/ ← 蹦 /pəŋ/、/tʰəʔ luɤ/ ← 拖 /tʰuɤ/、/kuəʔ la/ ← 刮 /kua/、/xəʔ lɒ̃/ ← 巷 /xɒ̃/(上面都是太原話)" },
        { "cell": "latin-in-native", "text": "晉祠 ，原根兒叫 晉王祠 （唐叔虞祠），圖紀念晉王和母后邑薑給蓋起的。山西太原市西南面子懸甕山跟前晉水畔畔那胡闌兒doqloq，景致襲人，祠行兒裡頭有老些老古房房，外有可些來來稀奇的塑像、壁畫、碑刻。此地人道古難老泉、侍女像、聖母像是“晉祠三絕”。" },
        { "cell": "latin-in-native", "text": "晉語跟官話不像那特點行兒讓數保留入聲茲一量兒。晉語那連續變調現象也可複雜lioq。晉語全濁清化有四種不一樣那演化方式。一多半兒多的晉語有五個聲調，有那地勢有六個、七個要不俫四個聲調。晉語有老些和官話差異海大那特徵詞和保留那老古語詞。" },
        { "cell": "latin-in-native", "text": "政府網站：[https://http//www.fenyang.gov.cn/ 汾陽市政府門戶網站]" }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Category:Incubator:Test wikis of languages of China",
        "{| style=\"border-spacing:0px; margin:3px 0px; width:100%; background:none\"",
        "| width=\"51%\" class=\"MainPageBG\" style=\"border: 1px solid lightgrey; color: #000; background: #ffffff\" |",
        "晉語 是漢藏語系漢語族的一種語言，也是中國北廂漢族地勢唯獨一種不是官話的語言，到了1996年，晉語的使用人口約莫4500萬（不算上汾河片），按使用人口排世界第22名，在漢語中影響力僅次於官話（北方話）、吳語、粵語和閩南語。到2007年，晉語的母語使用人數有4762萬人（不算上汾河片），還是世界100大語言之一。",
        "晉語區迎太行山東邊起去，往西快到賀蘭山，北挨的陰山，南面抵住汾渭河谷，是遠東文明的重要發源地行之一。説晉語那主要地勢是山西省、内蒙古中西部（舊時綏遠省那地勢）、陝北、豫北（河南省黃河北面大部和河北省西面），地跨175來箇市縣。太原話是那代表方言，核心晉語主要是并州話和呂梁話。",
        "晉語跟官話不像那特點行讓數保留入聲這一量。晉語那連續變調現象也可複雜咧。晉語全濁清化有四樣不一樣那演化方式。一多半兒的晉語有五箇聲調，有那地勢有六箇、七箇要不俫四箇聲調。晉語有老些和官話差異海大那特徵詞和遺留下那老古説法。",
        "| style=\"border:1px solid transparent\" |",
        "| width=\"49%\" class=\"MainPageBG\" style=\"border: 1px solid lightgrey; color: #000; background: #F3FDFF;font-family: 'Charis SIL', 'FreeSerif', 'Linux Libertine', times, serif;\" |",
        "preload=Template:Standard content for new page",
        "迎輸入圪框框行兒寫上題目，完後點“寫動iaq”。 可嫑刪了前頭的“Wp/cjy/”。",
        "維基百科是多種語言、内容自由、大家一搭来編寫的協作打算，目標是建一部完整、準確、中立的百科全書。",
        "晉語維基百科的發展靠大家幫襯，不管是建立新頁面、修改舊文，還是添加圖畫，都是爲維基百科出力。",
        "35px|link=oldwikisource:Main_Page/晉語|維基文庫",
        "晉語使用前綴，比方圪 /kəʔ/， 唿(忽) /xuəʔ/ 及嘿(黑)/xəʔ/， 𠯐(入、日）/ʐ(z)əʔ/，吥(不)/pəʔ/，來構成不同種類的派生詞。比方：𠯐(日）鬼（胡鬧、搞鬼）← 鬼；這些箇前綴大多數沒有傢意義。編輯頁面的時候甭忘了多用上它這些箇特色字/詞。",
        "有用詞差異的時候，迎討論區下討論過後，選擇 使用地區、頻率較多 的詞彙；討論不出箇結果的，以 并州片——太原話 爲標準。",
        "有些箇地勢有合音的情況，比較常見的有以下幾箇。比方： 嫊 ，媳婦的合音，主要見於呂梁片與汾河片； 簡 ，少單用，常用於「簡婆」、「簡爺」中，意思是「外婆」、「外公」。根據晉南稱呼爲「舅舍爺」、「舅莊爺」等，疑此字爲「舅間」之合音。主要見於呂梁片與幷州片",
        "/pəʔ ləŋ/ ← 蹦 /pəŋ/、/tʰəʔ luɤ/ ← 拖 /tʰuɤ/、/kuəʔ la/ ← 刮 /kua/、/xəʔ lɒ̃/ ← 巷 /xɒ̃/(上面都是太原話)",
        "分音詞應以正字爲準，要是碰見正字沒灋查證的情況，留下那國際音標標識上，給別人查見了再改。",
        "有的晉語方言（比方説和順話）有三種不同的指示詞（近指、中指、遠指），編輯詞條時要留下這些箇指示詞，表意更準確。",
        "Hai²-di²-lau¹ si³ Zung¹-gueh⁴ dieh⁴ hue²-gue¹-tsi² ing²-seh⁵ gung¹-si¹.",
        "叔虞 ，又叫 唐叔虞 、 太叔 ；姓姬，名虞，字子于，周武王姬發的小子，跟周成王姬誦是親弟兄，母王后是邑姜（齊太公呂尚的閨女），周封國晉國的始祖。",
        "周武王歿了以後，周成王可小小兒繼了位，叔虞的叔叔周公旦攝政。完了周公旦滅了古唐國，把唐地封給叔虞。唐叔虞歿了以後，他小子燮繼位。燮繼位後搬到晉水畔畔，把國號改成了晉，他就是晉侯燮。",
        "入聲 是無聲除阻的塞音，在晉語裏頭就是音節最後頭的[ʔ]音，在別的漢語方言裏頭就是[p̚]，[t̚]，[k̚]這夥音。漢語裏頭，這夥音都跟特定的音高一塊出現，成爲一組獨立的聲調。比方說“一”“七”“八”“十”這夥字晉語的聲調就都是入聲。",
        "乔家大院 ，位于山西祁县乔家堡村。它又名“在中堂”。北距太原54公里，南距东观镇2公里。是国家级文物保护单位。",
        "清代全国著名的商业资本家乔致庸的宅第。乔家大院始建于清乾隆年间，后又在清同治、光绪年间及民国初年多次增修，时间虽跨越了两个世纪。",
        "乔家大院占地10642平方米，建筑面积4175平方米。大院是双喜字型布局，分为6个大院，内套20个小院，313间房屋。整个院落是城堡式建筑，三面临街，四周是高达10余米的全封闭青砖墙。大门为城门式洞式。",
        "电影《大红灯笼高高挂》使乔家大院成为晋商大院的代表，引起全世界的高度关注。电视连续剧《乔家大院》的所有场景也在乔家大院拍摄。",
        "官話（又稱北方話、官話方言、北廂方言、北語）是漢藏語系漢語族的一種語言，説官話那主要地勢是中國北廂和西南的大部。官話有四箇聲調（不算輕聲），有那地勢有五箇聲調（西南官話、江淮官話）。官話的使用人口約莫11.2億（母語使用人口約莫9.2億)，是世界第一大語言。 [https://www.ethnologue.com/language/cmn/ 官话（《民族语》）]",
        "官話和晉語同是漢語族語言,但官話不像晉語囫圇保留入聲這一量，官話也有老些和晉語差異海大那词。",
        "晉祠 ，原根兒叫 晉王祠 （唐叔虞祠），圖紀念晉王和母后邑薑給蓋起的。山西太原市西南面子懸甕山跟前晉水畔畔那胡闌兒doqloq，景致襲人，祠行兒裡頭有老些老古房房，外有可些來來稀奇的塑像、壁畫、碑刻。此地人道古難老泉、侍女像、聖母像是“晉祠三絕”。",
        "晉語 ，震旦北廂唯獨一種非官話語言，使用人口約莫6305萬，晉語區迎太行山東bar起去，往西快也到賀蘭山、北挨的陰山、南面子抵住黃河汾渭河穀，是遠東文明的重要發源地行兒之一。",
        "晉語跟官話不像那特點行兒讓數保留入聲茲一量兒。晉語那連續變調現象也可複雜lioq。晉語全濁清化有四種不一樣那演化方式。一多半兒多的晉語有五個聲調，有那地勢有六個、七個要不俫四個聲調。晉語有老些和官話差異海大那特徵詞和保留那老古語詞。",
        "晉語那主要使用地勢是山西省、綏遠省（茲陣內蒙古省中西部）、陝西省北部、豫北（河南省黃河北面大部和河北省西面），地跨175來個市縣。晉語核心區主要為太原話（分化下新老兩派）和呂梁話。",
        "汾陽市 （拼音：feng yo si ）是中華人民共和國山西省的一箇縣級市，呂梁市代管。在山西中部，太原盆地西南面子。北挨的文水縣、南面子抵住孝義市。人口約莫43.46萬。",
        "汾陽有約莫2600年的歷史。 [http://www.fenyang.gov.cn/chnl1005/ 走进汾阳]",
        "政府網站：[https://http//www.fenyang.gov.cn/ 汾陽市政府門戶網站]"
    ]
}
