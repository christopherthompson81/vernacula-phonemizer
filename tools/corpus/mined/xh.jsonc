    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 113 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 0
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "UFred yeyona nkanyamba inamandla eyakha yakho emzantsi nasempuma Atlantic ukuza kuthi ga ngoku ukususela oko kwabakho imifanekiso ye-satelite, yinkqwithela enkulu yesithathu ezimbalini kwimpuma 35°W." },
        { "cell": "degrees", "text": "I Montevideo ikwingingqana ezitshisayo; kwinyanga zehlobo, amaqondo angaphezulu kwe +30°C aqhelekile." },
        { "cell": "digit-run", "text": "Abahlaseli base Mumbai bafika ngesikhitshane no Novemba 26,2008 bephethe iziqhushumbisi, izixhobo eziqubulisayo baze babetha ithagethi kuquka nezihlwele kwisitrishi I Chhatrapati Shivaji Terminus nedumileyo i Taj Mahal Hotel." },
        { "cell": "digit-run", "text": "Ngo-1957 iLuxembourg yaba lilungu elingumseki walo mbutho ngoku namhlanje owaziwa ngokuba yiEuropean Union." },
        { "cell": "digit-run", "text": "Isaqhwithi, esiku malunga neekhilomitha ezingama-3000 ukusuka eMiami, eFlorida, sineyona mimoya ebhudla kangange -40 mph (i-64 kph)." },
        { "cell": "digit-run", "text": "I-Tokyo iza kuba siso sodwa isixeko sase-Asia esikhe sabamba imidlalo yee-Olimpiki kabini, ekubeni yayikhe yabamba imihlalo yango-1964." },
        { "cell": "fractions", "text": "Ipateni kufuneka ibe nzulu ngokwaneleyo, i-5 mm (1/5 intshi) okanye nangaphezulu, kwaye izinto zithambe ngokwaneleyo kumaqondo obushushu abandayo." },
        { "cell": "clock", "text": "Ngokutsho kwamangqina, ngo-1:15 a.m. ngoMgqibelo, ibhasi ibidlula iirobhoti ziluhlaza xa imoto ibijika phambi kwayo." },
        { "cell": "clock", "text": "Ukuna ofikelela ku 6.34 ye intshi ngegeyji kwo Oahu, yachazwa njenge “lulutho”." },
        { "cell": "clock", "text": "Ngo-11:20,amapolisa acela abaqhankqalazi ukuba babuye umva kwindlela yabahamba ngenyawo, ecacisa ukuba kufuneka balungelelanisa ababhikishi nomthamo wabo onyukayo." },
        { "cell": "clock", "text": "I-eathquake ibethe iMariana ngo-07:19 a.m. ixesha lasekuhlaleni (09:19 p.m. GMT ngolwesiHlanu)." },
        { "cell": "signs", "text": "Umthetho oyilwayo ufuna imidlalo yevidiyo enogonyamelo ithengiswe kwiphondo laseCalifornia ukuba ibhalwe uphawu lokufunda \"u-18\" kwaye yenze ukuba ukuthengisa kwabo umntwana kohlwaywe isohlwayo se- $ 1000 ngetyala." },
        { "cell": "signs", "text": "Ngenxa yeentambo ze-fiber optic ezingaphantsi kolwandle namakhonkco aya kwi Europe kunye ne-broadband satellite, iGreenland iqhagamshelekee kakuhle yaye inabantu abayi-93% abanokufikelela kwi intanethi." },
        { "cell": "signs", "text": "Emva kweminyaka engama-250, iGuinness ikhule yaya kwishishini lehlabathi elenza ngaphezulu kwe-10 yezigidi zeYuro (i-US $ 14.7 yezigidi) minyaka le." },
        { "cell": "signs", "text": "I-CafeNet El Sol inikezela ngeenkonzo zokubhukisha ngexabiso leUS$30, okanye i$10 yosuku olunye; iinkcukacha zikwiphepha elingaphandle labo iCorcovado." },
        { "cell": "dotted", "text": "Kakade, ingeniso ebaxekileyo efumaneke ngokuxhaphaza abantu base Filipino yenza ingeniso ye imperialism yase U.S." },
        { "cell": "dotted", "text": "Iintola e ezivela kwindlela enqamlezileyo inokungena kwisikrweqe sokulwa samajoni. Malunga ne-1000 B.C.E., ama-Asiriya azisa ihashe lokuqala." },
        { "cell": "dotted", "text": "NgoMvulo, iinzululwazi ezivela eStandford University School of Medicine zazise ngesixhobo sokuxilonga esitsha esinoku sota iiseli ngohlobo: itship encinci eprintwayo enokwenziwa ngokusebenzisa iiprinta ze inki yaye zinokuxabisa malunga nesenti enye yase U.S.." },
        { "cell": "dotted", "text": "Akukho ngxelo zikhawlezileyo zifunyenwe yi-U.S.Geological Survey (USGS) kunye neZiko loLwazi ngeNyikima." },
        { "cell": "era-marker", "text": "Inkqubo iqale nge-8: 30 p.m. ixesha lasekhaya (15.00 UTC)." },
        { "cell": "era-marker", "text": "Inyikima ebingenamandla kangako yanyikima entshona yeMontana ngo-10:08 p.m. ngoMvulo." },
        { "cell": "year", "text": "UNadia, owazalwa ngo-Septemba 17, 2007, ngecandelo le-Cesarean kwiklinikhi yokubelekisa e-Aleisk, eRashiya, enobunzima obuli-17 leepawundi ne 1 awunsi." },
        { "cell": "year", "text": "Emva koko, kwiminyaka embalwa kamva, ngo-1639, isazinzulu ngeenkwenkwezi saseNgilani ekuthiwa nguJeremiah Horrocks sabona ukudlula kwe-Venus elangeni." },
        { "cell": "year", "text": "I South Pole Traverse (okanye i Highway) ikumgama we 1600 km trail ukusuka kwisitishi i McMurdo kulwandle I Ross Sea ukuya kwi Pole." },
        { "cell": "year", "text": "Iindawo ezithile zanamhlanje zaseBelgium zisukela kuba yiLuxembourg kudala kodwa zayi yiBelgian emva kwengququko yase Belgian ngo 1830s ." },
        { "cell": "decimals", "text": "Ama-300 ongezelelweyo azisa iinqwelo ezi-1,300 zizonke eziza kufunyanwa ukunciphisa ukuxinana." },
        { "cell": "decimals", "text": "I-capsule iza kuhamba malunga neekhilomitha eziyi-12.8 okanye imayile eziyi-8 ngomzuzwana, ikhawuleza kakhulu kangangokuba ingasuka eSan Francisco iyofika eLos Angeles ngomzuzu omnye." },
        { "cell": "decimals", "text": "Abaququzeleli babaqhankqalazi bathi malunga nama 100,000 abonakala kwizixeko zase German ezinjenge Berlin, Cologne, Hamburg, neHanover." },
        { "cell": "decimals", "text": "Kwindawo yesithathu, nguHamlin ongasemva ngamanqaku angamashumi amabini, kudwa uphambili kuBowyer ngamahlanu. UKahne kunye noTruex, Jr. babambe indawo yesihlanu neyesithandathu ngokulandelelana kwabo ngamanqaku ayi-2,220 nayi-2,207." },
        { "cell": "ordinal-latin", "text": "Iiarhente zokucwangcisa uhambo bezikho ukususela kwinkulungwane ye-19. Iarhente yokucwangcisa uhambo idla ngokuba lukhetho oluhle kuhambo oluquka izinto umhambi angakhange azenze, inkcubeko, ulwimi okanye amazwe ahluphekayo." },
        { "cell": "ordinal-latin", "text": "Ngexesha le-18th sentyhuri iCambodia yazifumana icinezelekile phakathi kwabamelwane ababini abanamandla, iThailand neVietnam." },
        { "cell": "ordinal-latin", "text": "I-Box jellyfish ibakho ngasenxwemeni kunye nangakwichweba lomlambo ukususela ngoOkthobha ukuya kuAprili emntla we-1770. Ngamanye amaxesha zinokufunyanwa ingelilo eli xesha lonyaka." },
        { "cell": "ordinal-latin", "text": "I-Canal District (Dutch: Grachtengordel) yeyaziwayo yango 17th-century district erhangqwe i-Binnenstad yase-Amsterdam." },
        { "cell": "units", "text": "Ezi zaqhwithi zikhulu ziba nemimoya enesantya esifikelela ukuya kutsho kwi-480 km/h (133 m/s; 300 mph)." },
        { "cell": "units", "text": "IiSundarbans zigubungela indawo eyi-3,850 km², apho malunga nesinye kwisithathu sigutyungelwe ngamanzi / kwiindawo ezinomgxobhozo." },
        { "cell": "units", "text": "IFred unomoya oyi-105 ngeyure (165km/h) kwaye ubheka ngasemantla ntshona." },
        { "cell": "units", "text": "U Mnumzana u Reid ukwazile ukuqhuba imoto eyi New Zealand's A1GP , Black Beauty kwisantya esingaphezu kwe 160km/h esiphindaphindwe kasixhenxe ngapha kwebhulorho." },
        { "cell": "ranges", "text": "iLuno ibine-120-160 ye-cubic metres yamaftuha ngaphakathi xa yangakwazi ukuhamba kwaye imimoya enkulu kunye namaza ayityhalela elunxwemeni." },
        { "cell": "ranges", "text": "Ngo-1895, emva koloyiso kwiMfazo Yokuqala ye-Sino-Japanese (ngo-1894-1895), urhulumente we-Qing utyikitya Isivumelwano saseShimoneki, apho enekezela igunya lophatho lwe-Taiwan kwi-Japan, eyaphatha eso siqithi kwade kwangu-1945." },
        { "cell": "ranges", "text": "Irekhodi kaNadal xa edlala nalo waseCanada ngu- 7-2." },
        { "cell": "ranges", "text": "Zenza umoya ovuthuza ngamandla (ngokuqhelekileyo, ofikelela ku-100-200 wemaliye ngeyure) ibe unokuphakamisa izinto ezisindayo uze uhambe nazo njengoko isitshingitshane sihamba." },
        { "cell": "currency", "text": "Amanye amatye, anqabe kakhulu Emhlabeni, athengiswa ngemali eqala kwi-US$11,000 ukuya kutsho kwi-$22,500 igram, oku kuxabisa ngokuphindwe kalishumi kunegolide." },
        { "cell": "currency", "text": "Kodwa u-Nkulumbuso u-John Howard uthe isenzo senzelwe kuphela ukukhusela amaziko esibhedlele ekuthotyelweni ngurhulumente wase-Tasmania, ngokunika i-AUD engaphezulu kwe-$45 izigidi." },
        { "cell": "currency", "text": "UBatten wayebalwe njengowe-190 kuludwe luka-2008 lwawona ma-Melika ayi-400 Azizityebi,kuqikelelwa ubutyebi bakhe bungange-$2.3 bhiliyoni." },
        { "cell": "currency", "text": "Kulindeleke ukuba amatikiti ezinto ezininzi aza kubiza phakathi kwe-¥2,500 ne-¥130,000, yaye amaxabiso aqhelekileyo aya kubiza malunga ne-¥7,000." },
        { "cell": "abbrev", "text": "Umntu obunzima obuzipawundi eziyi-200 (iikhologram eziyi-90) emhlabeni anganobunzima obumalunga neepawundi eziyi-36 (iikhilogram eziyi-16) kwi lo. Ngoko ke igravithi, kakade,itsala kancinci kuwe." },
        { "cell": "abbrev", "text": "“Iqela elingabonakaliyo” liqela elilawulayo apho amagosa enikezela ingxelo kulo. Iqela elingabnakaliyo libeka izinga legosa ngalinye." },
        { "cell": "abbrev", "text": "UMnu. Costello uthe xa amandla okuphuhlisa i-nuclear enengeniso, iOstreliya kumele ijonge ekuwasebenziseni." },
        { "cell": "abbrev", "text": "\"UKuba iyashishinisa, simele sibe nayo. Ukuthi,akukho gunya lichaseneyo namandla enuclear\" watsho uMnu Costello." },
        { "cell": "latin-in-native", "text": "Ookrebe bakhona, kodwa abafane bahlasele abantu. Ookrebe abaninzi bayaboyika abantu kwaye bayababaleka." },
        { "cell": "latin-in-native", "text": "Ingqokelela yohlobo olunye lwezinto kummandla othile kuthiwa ngabemi bakhona." },
        { "cell": "latin-in-native", "text": "Inani lokufa liyi-15 ubuncinci, nani elo kulindeleke ukuba linyuke." },
        { "cell": "latin-in-native", "text": "Emva kweveki yelahleko kunyulo lwaphakathi enyakeni, uBush uxelele abaphulaphuli ngokwandiswa korhwebo e-Asia." },
        { "cell": "percent", "text": "UNadal ufumene amanqaku ayi-88% kumdlalo, ephumelela ngamanqaku ayi-76 kwi-serve yokuqala." },
        { "cell": "percent", "text": "Zibandakanya ukuthintelwa kwezezimali kunye noku bhenishwa yi-European Union ekukhupheni ngaphandle i-oyile ekrwada, apho uqoqosho lwaseIran lufumana u-80% wengeniso esuka kumanye amazwe." },
        { "cell": "percent", "text": "I-European Turkey (eastern Thrace okanye i-Rumelia ekwi Balkan peninsula) iqukai 3% yelizwe." },
        { "cell": "rate", "text": "Amapolisa aseNew Zealand anengxaki yokusebenzisa imipu yayo ye-radar yokujonga isantya ukuze abone ukuba uMnu Reid ubaleka kangakanani ngenxa yokuba phantsi kukaBlack Beauty, kwaye ixesha akwaze ngalo ukubona ukuba uMnu Reid kube ngelixa ecotha ehamba nge-160km/h." },
        { "cell": "rate", "text": "Ukuqala kwanamhlanje, umoya wawusondele kwi-83 km / h, kwaye kwakulindelekile ukuba bube buthathaka." },
        { "cell": "rate", "text": "Isantya se-802.11n sikhawuleze kakhulu kunesabangaphambili abaphumeleleyo be-600Mbit / s." },
        { "cell": "rate", "text": "Eziposiweyo izimiselo zesantya ziyaqapheleka ukuba zingeneno kunezangaphambili kwaye iindawana ezithile— ikakhulu u-35-40 mph (56-64 km/h) — kwaye ukuzithobela kubaluleke nangakumbi kunokunye." },
        { "cell": "roman", "text": "Iipesenti ezingama-34 zabo bavotayo babelana ngolu luvo, befuna ukuba uKumkanikazi uElizabeth II abe yikumkani yokugqibela yase-Australia." },
        { "cell": "roman", "text": "Ekhathalayo inkulubaphathiswa u Julia Gillard ubange ngelithi ngethuba lokukhampeynela konyulo luka 2010 lwe federal ukuba wakholelwa ukuba i-Australia imele yenziwe iriphablikhi ekupheleni kolawulo luka Kumkanikazi u-Elizabeth II." },
        { "cell": "roman", "text": "Iinqwelo mafutha ezintywilayo zazisetyenziswa kwi-Mfazwe yeZwelonke I futhi nakwi-Mfazwe yeZwelonke II. Ngeloxesha zazicotha zidubulela kufuphi." },
        { "cell": "roman", "text": "Umthetho waseFrance watshintshwa. I-activism yakhe yabuyela kwiminyaka eyi-15 xa wajoyina i-French Resistance ngexesha leMfazwe yesibini (II) yeHlabathi." },
        { "cell": "initialism", "text": "UAlexander, njengekumkani, wazinikela ukuyakha itempile, kodwa umnikelo wakhe wakhatywa. Ethubeni, akuba u Alexander ebhubhile, itempile yakhiwa ngokutsha ngo-323 BCE." },
        { "cell": "initialism", "text": "I-ADD ichaphazela ulwalamano kunye noontanga babo, ngenxa yokuba abanye abantwana abakwazi ukuqonda ukuba kutheni besenza izinto ngale ndlela benza ngayo okanye kutheni bepela amagama ngendlela abapela ngayo okanye ukukhula kwabo kutheni kwahlukile." },
        { "cell": "initialism", "text": "U-Hershey no-Chase basebenzise ii-phages, okanye ii-virus, ukufaka i-DNA yabo kwintsholongwane." },
        { "cell": "initialism", "text": "i-National Hurricane Center (NHC) ithi xa kunje u-Jerry akayongozi kule ndawo." },
        { "cell": "grouped", "text": "E-Berlin, amapolisa aqikelela abaqhankqalazi abangama-6 500." },
        { "cell": "grouped", "text": "Ummandla waseTurkey kuquka amachibi ufikelela kwi-783,562 square kilometres (300,948 sq mi), apho i-755,688 square kilometres (291,773 sq mi) zikumzantsi ntshona we-Asia yaye i-23,764 square kilometres (9,174 sq mi) iseYurophu." },
        { "cell": "grouped", "text": "Emva komdyarho, uKeselowski usakhokhela Kubuntshatsheli Babaqhubi ngamanqaku ayi-2,250." },
        { "cell": "grouped", "text": "Iisathelayithi, zombini ezazinobunzima obungaphezulu kweepawundi ezili-1000, kwaye zihamba malunga neekhilomitha ezingama-17,500 ngeyure, zangqubana neekhilomitha ezingama-491 ngaphezulu koMhlaba." },
        { "cell": "letter-name", "text": "Ezinye I applications kolu luhlu zikwazi nokuguqulela okubhaliweyo ngalwimi zimbi ngesayns okanye ezinye iiobjects xa umsebenzisi ekhomba ismartphone sakhe kwezo objects." },
        { "cell": "letter-name", "text": "I Lake Onega iqhakamishelalana ne Volga, ngoko ke xa usuka kulwandle I Caspiam uhamba nge Russia kusenokwazeka." },
        { "cell": "letter-name", "text": "Ukufika komhlaba kwe-D-Day kunye neemfazwe ezilandelayo zakhulula amantla eFrance, kodwa amazantsi ayengakhululekanga." },
        { "cell": "letter-name", "text": "Owayekubasisithethi kwi-U.S House, uNewt Gingrich uphume kwindawo yesibini ngo-32 pesenti." },
        { "cell": "ampersand", "text": "Wathweswa isidanga eCollege of Arts & Sciences yeUniversity of Virginia ngo-1950 yaye ebengomnye wabantu abanikela kakhulu kule ntlangano." },
        { "cell": "ampersand", "text": "Kwicala eliphezulu, kucacile ukuba izinto ezimbini eziphambili iiB&amp;B ezikhuphisana ngazo: yindawo yokulala nesidlo sakusasa." },
        { "cell": "quote-letter", "text": "Kumathafa asempuma yase Bardia, abase Britane babamba i-Italian Tenth Army's Engineer-in-Chief, u-General Lastucci." },
        { "cell": "quote-letter", "text": "Abasemagunyeni bathi, ugqirha obesebenza kwiChildren’s Hospital of Pittsburgh, ePennsylvania uza kutyholwa ngokubulala okumasikizi emva kokuba umama wakhe efunyenwe efile kwibhuti yemoto yakhe ngoLwesithathu." },
        { "cell": "quote-letter", "text": "Ngokutsho kukaMick O'Flynn, iDirector ebambeleyo ePark Conservation and Heritage eNPWS, abadubuli abane bokuqala abaye bachongelwa ukudubula baye bafumana imiyalelo epheleleyo yezokhuseleko noqeqesho." },
        { "cell": "quote-letter", "text": "Ibhulorho yoMlambo iOyapock yibhulorho ehlala intambo. Inqumla uMlambo iOyapock ukudibanisa izixeko zaseOiapoque eBrazil naseSaint-Georges de l'Oyapock eFrench Guiana." },
        { "cell": "scaled-currency", "text": "uJesus oneminyaka engama-21 ubudala wajoyina iManchester City kunyaka ophelileyo ngoJanuwari 2017 esuka kwiqela laseBrazil iPalmeiras ngentlawulo ebikiweyo ye-£ 27 yezigidi." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Ookrebe bakhona, kodwa abafane bahlasele abantu. Ookrebe abaninzi bayaboyika abantu kwaye bayababaleka.",
        "Kodwa ukuba oku kuyenzeka kusenokungaphindi kwenzeke kangangexesha elide. Iinkwenkwezi ziqelelene kangangokuba kukho iitriliyoni zeekhilomitha phakathi kweenkwezi “ezingabamelwane.”",
        "UStewart, uGordon, uKenseth, kunye noHarvick bathatha izithuba ezilishumi eziphezulu ze-Championship zabaqhubi kusasele imidyarho emine enyakeni.",
        "UStearns uphanda ukuba ingaba irhafu isetyenziselwa ukuxhasa ukuqhomfa izisu nge-Planned Parenthood kwindima yakhe njengosihlalo weKomitana ejongene noPhando, ephantsi kwe-House Energy ne Commerce Committe.",
        "Oku kuza kuqinisekisa ukuba izinto ozithandayo kunye/okanye izinto ongazifuniyo zimataniswa nenqanawa efanelekileyo kubo.",
        "Ngoku ngafani nezinye ii-primates, ii-hominids azisasebenzisi izandla ukuhamba okanye ukuthwala umthwalo okanye ukujinga emithini.",
        "IiSundarbans zigubungela indawo eyi-3,850 km², apho malunga nesinye kwisithathu sigutyungelwe ngamanzi / kwiindawo ezinomgxobhozo.",
        "UNadal ufumene amanqaku ayi-88% kumdlalo, ephumelela ngamanqaku ayi-76 kwi-serve yokuqala.",
        "UPiquet Jr. waye wagxothwa emva kweGrand Prix yaseHungary ka-2009.",
        "Indawo zemiboniso yakudala azisasetyenziswa unamhlanje, sezihleli njengemyuziyam, okanye iindawo zokufundisa.",
        "Ngo-2009 wawongwa ngokuba Yintsumpa yonyaka Kwilizwe lonke.",
        "Ukutshintsha kofuzo kongeza ufuzo olwahlukahlukeneyo,ibe ukukhetha kuyikhupha kwipuli yezahlukahlukeneyo ezibonisiweyo.",
        "Ukongezelela ekubeni yintshtsheli yeHlabathi neyee-Olympics, ngexesha lokufa kwakhe uSaito ebengusihlalo wekomiti yokuqeqesha kwi-All Japan Judo Federation.",
        "Umzi wozakuzo wase-United States ozinze eNairobi, eKenya ukhuphe isilumkiso sokuba “abavukeli baseSomalia” baceba ukuhlasela eKenya nase-Ethopia ngeziqhushumbisi zokuzibulala.",
        "Yalandelwa yi Istanbul State Symphony Orchestra, iJanissary band, kunye nabaculi iFatih Erkoç and Müslüm Gürses.",
        "IIngoma ezimbini zemuvi, iAudition (The Fools Who Dream) kunye neCity of Stars, zifumene ukunconywa ngeyona ngoma iphambili kweziyilwe ukususela ekuqaleni. iLionsgate studio ifumene uncomelo oluyi-26o - ngaphezulu kwayo nayiphi na enye studiyo.",
        "Umzekelo omnye, abahlali base-Melika e-Middle East bangadibana neemeko ezohlukileyo kunabantu base-Yurophu okanye ama-Arab.",
        "Ukwalusa iiReindeer yindlela yokuziphilisa ebalulekileyo kumaSámi, ibe isiko elinokuthanani nolu shishino lubalulekile nakwanye abantu abenza eminye imisebenzi.",
        "Le iya iyeka ukuba yingxaki njengoko abavelisi beelensi bevelisa iilensi ezikumgangatho ophezulu.",
        "Ukunyuka kwetekhnoloji entsha kusenza sikwazi ukubona nokuphanda ulwakhiwo lobuchopho kunye neenkqubo ezingazange zibonwe ngaphambili.",
        "Abantu abacinga ngale ndlela bacinga kakuhle, bayakwazi ukunqaya izinto ezihambiselanayo, ukucombulula iingxaki nokusebenza kuphando lwezesayensi.",
        "Ukukhempisha ngemoto kunokwenzeka ukuba unayo i-minivan enkulu, i-SUV, iSedan okanye iStation Wagon esinezitulo ezihlayo.",
        "Abababantwana badla ngokungena engxakini, kuba “benza izinto eziyingozi, bangena imilwo, futhi baphikisana nomthetho” ukuze bazivuse iingqondo, kuba iingqondo zabu azikwazi ukuvuswa ngendlela eziqhelekileyo.",
        "Le nqanawa yayikhokelwa ngu-Olaf Trygvasson, waseNorway onamabhongo okubuyisa ilizwe lakhe kulawulo lwaseDenmark.",
        "Ngo-1884, uTesla wafudukela eMerika ukuyakuphangela kwiEdison Company eNew York City.",
        "Uluhlu lwababuki zindwendwe abafumaneka luye lwenziwe lufumaneke luprintiwe okanye kwi-intanethi, ngamanye amaxesha luba nezimvo kunye noncomelo lwabantu ebebekhe bahlala apho.",
        "Izilwanyana zifumaneka kuwo wonke umhlaba. Ziyagrumba emhlabathini,Ziqubhe elwandle, kwaye zibhabhe esibhakabhakeni.",
        "Ipateni kufuneka ibe nzulu ngokwaneleyo, i-5 mm (1/5 intshi) okanye nangaphezulu, kwaye izinto zithambe ngokwaneleyo kumaqondo obushushu abandayo.",
        "Nyaka ngamnye, abakhenkethi bayonzakala kuba abagcini mgama ulungileeyo, Ezi zilwanyana zikhulu,zinoburhalarhume kwaye zinobungozi, ngoko ke zinikeni indawo yazo.",
        "Ukutyhubela iinkulungwane, abantu bakha ngononophelo ukwakha amathambeka kwindawo emxinwa, enamatye de aya kuthi xhaxhe ngakwelwandle."
    ]
}
