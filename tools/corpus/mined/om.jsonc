// MINED NORMALIZATION CORPUS — om. Generated by tools/normalization/mine.ts.
//
// WHAT THIS IS. Excerpts of running text SELECTED because they challenge the normalization layer. The cells
// are the empirical shape of the rules the treated languages actually needed, so coverage of them is the
// completeness criterion — not size.
//
// ⚠ THIS TIER IS NOT A FALLBACK FOR MISSING FLEURS, and this header used to say it was — unconditionally,
// in all 163 artifacts, of which 95 belong to languages that DO have a FLEURS transcript. The two sources
// are COMPLEMENTARY and neither subsumes the other: FLEURS is read-aloud running text, so it is
// frequency-shaped and mostly exercises nothing the normalizer does; this artifact is selected
// ADVERSARIALLY against the pattern cells, so it is far richer per line in exactly the shapes a
// normalization rule has to decide. A language with FLEURS is still worth mining, and most were.
//
// ⚠ SO DO NOT READ THIS FILE AS THE WHOLE HAYSTACK. Shona's layer did: it repeated the old claim and argued
// its refusals from a corpus that was missing 1,901 FLEURS transcripts, which left one count wrong by a
// factor of twenty (#1064). Count over both.
//
// ⚠ "hard" IS NOT FREQUENCY-REPRESENTATIVE. It is selected adversarially, so an instance count inside it
// means nothing about the language. Use "sample" (uniform, deterministic stride) for anything that needs
// real proportions, and to check that ORDINARY text still survives a change — a hard-set proves the rules
// fire, not that nothing else broke.
//
// ⚠ AN EMPTY CELL IS NOT EVIDENCE. It is a query to run or a tool bug. Both have happened here: random
// sampling read intros and missed 1013 articles with a percentage, and a sentence splitter ate the
// abbreviation dots and emptied three cells that a grep showed were well populated.
//
// source: FLEURS om_et
// segmentation: sentence (abbreviation dots protected before splitting)
{
    "language": "om",
    "source": "FLEURS om_et",
    "segmentMode": "sentence",
    "totalSegments": 1216,
    "cellsCovered": 25,
    "cellsTotal": 35,

    // Occurrences across the whole corpus, and what an ASCII-only \d selector would have found instead.
    "counts": {
        "degrees": 1,          // in 22 treated languages
        "digit-run": 83,       // in 19 treated languages
        "fractions": 1,        // in 18 treated languages
        "clock": 10,           // in 18 treated languages
        "signs": 8,            // in 17 treated languages
        "dotted": 2,           // in 16 treated languages
        "era-marker": 1,       // in 14 treated languages
        "year": 83,            // in 14 treated languages
        "decimals": 32,        // in 12 treated languages
        "ordinal-latin": 1,    // in 11 treated languages
        "ordinal-native": 0,   // lexical cell — matched via the term list
        "units": 2,            // in 9 treated languages
        "ranges": 13,          // in 7 treated languages
        "currency": 4,         // in 6 treated languages
        "abbrev": 45,          // in 6 treated languages
        "latin-in-native": 1216, // in 6 treated languages
        "percent": 3,          // in 5 treated languages
        "rate": 1,             // in 4 treated languages
        "zero-width": 0,       // in 4 treated languages
        "roman": 1,            // in 3 treated languages
        "initialism": 64,      // in 3 treated languages
        "grouped": 19,         // in 3 treated languages
        "signed-number": 0,    // in 2 treated languages
        "ordinal-range": 0,    // in 1 treated languages
        "letter-name": 12,     // in 3 treated languages
        "exponent": 0,         // in 24 treated languages
        "arithmetic": 0,       // in 2 treated languages
        "ampersand": 1,        // in 1 treated languages
        "iteration": 0,        // in 1 treated languages
        "calendar": 0,         // lexical cell — matched via the term list
        "sports-time": 0,      // in 3 treated languages
        "version-dot": 2,      // in 3 treated languages
        "quote-letter": 762,   // in 4 treated languages
        "scaled-currency": 3,  // in 3 treated languages
        "ordinal-caps": 0,     // in 2 treated languages
    },

    // ⚠ NOT A CORPUS COUNT. These cells entered the inventory after this artifact was mined, and
    // re-mining means re-fetching the wiki, which would resample the tiers that every figure quoted from this
    // file elsewhere rests on. So they were evaluated against THIS FILE'S OWN retained text — "hard" + "sample",
    // 93 segments — and the number is how many of those segments match. "hard" is adversarially selected, so
    // this establishes that the language WRITES the pattern (a presence lower bound) and NOTHING about how often.
    // A 0 here is not evidence of absence either; it means the retained text does not happen to show it.
    // Re-mine to replace this with a real corpus count in "counts" above — mine.ts never emits this block.
    "backfill": {
        "native-terminator": 0
    },

    // The hard-set: up to N examples per cell.
    "hard": [
        { "cell": "degrees", "text": "Fireed obomboleettii tirooppikaalaa cimaa durarraa gara kibbaatti galmaa’eedha akkasumas Atilaantik bahaa keessatti jalqabuu suuraa saatalaayitii irraa eegalee, fi sadarkaa sadaffaarra kan jiru Heerikeen qofaatu gara bahaatti 35°W galmeesse." },
        { "cell": "digit-run", "text": "Bara 1977 keessa,Dr. Damadiiyan ijaarsa iskanerii MRI “qaama walii galaa” isa jalqaba xumure, kan inni “indoomiteebilii” jedhe waame." },
        { "cell": "digit-run", "text": "Siminoof akka jedhutti erga inni 2013 kutaa fiilmii Taankii Shaark iddoo itti beeksisni agarsiisichaa deggersa jalqabsiisuu kuffise’en booda gurgurtaan baayyee dabale jedhe." },
        { "cell": "digit-run", "text": "Shuumeeker kan erga tapha shaampiyoonummaa Foormulaa 1 bara 2006 mo’achuun booda sooroma ba’ee, Filiippee Maasaa isai midhame bakka bu’uuf jedha." },
        { "cell": "digit-run", "text": "Naadiyaan, isiin gaafa Fulbaana 17, 2007 baqaqsanii hodhuudhaan kilinika haadholii Aleeyiski, Raashaa keessatti dhalatte, paawundii 17 fi aawunsii 1 ulfaatti turte." },
        { "cell": "fractions", "text": "Sarxaan isaa akka gaariitti gadi fagoo ta’uu qaba, mm 5 (inchii 1/5) ykn caalaa, fi meeshaan isaamoo baayee lallafaa qilleensa qabana’aa qabuu dha." },
        { "cell": "clock", "text": "Sanbata sa’a 1:15 a.m tti, akka raga baatotni jedhanitti, wayita konkolaataan isa duratti marfate atoobisichi ifa magariisaa keessa darbaa ture." },
        { "cell": "clock", "text": "Hammi roobaa, geejii Oohuu irratti inchii 6.34 gahaa jiru, \"faayida qabeessa\" jedhamee ibsama." },
        { "cell": "clock", "text": "Taphichi ganama keessaa sa’aatii 10:00 irratti haala qilleensaa baay’ee gaarii ta’ee fi tiifuu giidduu ganamaa ture kan dafee darbee irraa kan hafe, 7ttan raagbiidhaaf guyyaa gaarii ture." },
        { "cell": "clock", "text": "Gareen Qo’annoo Iraaq gabaasa isaa har’a 12.00 GMT tti dhiyeesse." },
        { "cell": "signs", "text": "Naadaal servii jalqabaa tuqaa 76 ittiin tapha mo’e keessatti tuqaa saaphanaa 88% galche." },
        { "cell": "signs", "text": "Turkii Awurooppaa (Trees Bahaa ykn Ruumeeliyaa daarii galaana Baalkaan) 3% biyyattii qabaata." },
        { "cell": "signs", "text": "Seeliin kutaa sirnawaa fi tajaajilu =kan wantoota lubbu qabeeyyiiti." },
        { "cell": "signs", "text": "Taphataan umurii 21 Jiisas waggaa darbe Amajjii 2017 tti Manchestar Siitiitti makamekilabii Biraaziil Palmeriyaas irraa akka gabaafametti baasii miiliyoona £27tiin." },
        { "cell": "dotted", "text": "Yaadi cabbii irra mucucaachuu baayee kan ture dha — suuraawwan holqa keessaa kan namoota cabbiirra mucucaatanii D.K.D 5000 tti duubatti deebisanii mul’isu!" },
        { "cell": "dotted", "text": "Sa’aatii 8:46 a.m. irratti cal’isuun magaalaa, yeroo murteessaa jeetiin galma isaa itti rukuteedha." },
        { "cell": "year", "text": "1995 tti, seenaa seenaa warra Paartizan keessatti inni akka taphata uurjiiti filatame." },
        { "cell": "year", "text": "Yeroo hedduu dura osoo Agarsiisa-Guyyaa guyaa fi Gabaasni Kolbert hin dhiyaatin, Heeki fi Joonsan maxxansa oduu ba’eessa godhuu-fi gabaasa oduu mul’ata godhatanii turani—yeroo UW barataaa turan 1988’tti." },
        { "cell": "year", "text": "Daangaan Tuurkii kiiloo meetira 1600 (maayilii 1,000) caalaa dheerata, bal’iinna kiiloo meetira 800 (maayilii 500) qaba, boca olis gadis reektaanguulaarawaa wajjin." },
        { "cell": "year", "text": "2010’tti, osoodhuma harka mootummaa jiraatee iyyuu, bankiin karaa guddaarraa yeroo ammaa Noorzerni Rook plc’n ‘baankii gadhee’ irraa fottoqe, Norzerni Rook (To’ataa Qabeenyaa)." },
        { "cell": "decimals", "text": "Cabaa dhagoota tilmaamaan 24,000 ta’an kanneen Lafarra bu’an keessaa naannoo 34 qofaatu Maarsi irraa dhufuun isaanii mirkaneffame." },
        { "cell": "decimals", "text": "Addunyaan afaanota garaa garaa 5,000 ol qabdi, digdamaa ol kan dubbattoota miiliyoona 50 yookaan isaa olii kan qaban dabalatee." },
        { "cell": "decimals", "text": "Izmiir Turkii keessaa guddinaan sadarkaa sadaffaa irratti argamtudha baay’ina uummata miiliyoona 3.7 qabaachuudhaan, Istaanbulitti aanteebuufata doonii guddinaan sadarkaa lammaffaarra jirtu ta’uudhaan, akkasumas giddugala geejibaa baay’ee gaarii ta’uudhaan." },
        { "cell": "decimals", "text": "Naannoo Turkiitti, haroowwan dabalachuun, iskuweer kiloometiiri 783,562 qabata (300,948 sq mi), kan keessaa iskuweer kiloometirii 755,688 (291,773 sq mi) kan ta’u naannoo Eeshiyaa kibba lixaatti akkasuma iskuweer kiloometiri 23,764 (9,174 sq mi) kan ta’ummoo Awuurroppatit dha." },
        { "cell": "ordinal-latin", "text": "Kanneen du’an Nikoolaas Aalden, 25, fi Zaakarii Cuddeback, 21. Cuddeback isa konkolaachisaa ture dha." },
        { "cell": "units", "text": "Waggoottan darban keessatti foormaatiiwwan fiilmii hedduu garaa garaatu dhimma itti ba’amaa as ga’e. Inni yeroo baay’ee dhimma itti ba’amu isa miiliimeetirii 35 baratamaadha (mm 36 mm 24n negatiiva)." },
        { "cell": "units", "text": "Yeroo ammaa Fred qillensa sa’aati tokko kessatti mayilii 105 qillensa’aa (165km/h)akkasumas gara Kaaba dhiiyaatti deemaa jira." },
        { "cell": "ranges", "text": "Dorgoommiin dorgomtoota olaanoo Afriikaa Kibbaa kan jalqabe nootii mirgaa irratti yeroo isaan Zaambiyaa 5ffaa irrra jirtu 26-00 dhaan mo’atanidha." },
        { "cell": "ranges", "text": "Gooliin isaa lammaffaan inni galgala kanaa isa kan waqtichaa 60ffaadha, kan erga bara 1995-96 yeroo Jaaroomir Jaagir fi Maariyoo Leemiyaaksi lamaansaanii fageenya kana qaqqabanii booda taphataa jalqabaa gooliiwwan 60 yookaan isaa ol galche ta’uudhaan." },
        { "cell": "ranges", "text": "Riikardiin Nadaal mata mataattii warreen Kaanadaa waliin 7-2 dha." },
        { "cell": "ranges", "text": "Hangewul sirna qubee itti yaadamee hojjetamee faayidaa guyyaaf baayyee biratti beekame isa tokkichadha. Sirni qubee sun 1444 keessa yeroo bulchiinsa Mootii Sejoong (1418-1450)’tti kalaqame." },
        { "cell": "currency", "text": "Seerichi taphootni viidiyoo badii geessisan kan isteeta Kaalifoorniyaa keessatti gurguraman dubbisa decal \"18\"n akka moggaafamanii fi gurgaartaasaanii yakka salphaa kan seera-cabsuu tokkotti $ 1000 adabsiisuu barbaada." },
        { "cell": "currency", "text": "Bateen 190ffaa irra ka’amee ture bara 2008’ti Sorreesoota Ameerikaa 400 kan galii tilmaaman Biliyoona $2.3 qabanin." },
        { "cell": "currency", "text": "Dhagaan tokko tokkoo, laafa kana irratti yaartu kan ta’an gurguramaa jiru aawonsii tokkotti US$11,000 haga $22,500 tiin, gati warqee si’a kuudhanii ol kan ta’een." },
        { "cell": "abbrev", "text": "Maqaaniin dura haala gaariin kan barsiifaman karaa bakkatti qabuuf ture. Haa ta’u malee boodarra suuta suuta yoo sibiila bixxilmaa aayiranii irratti daballe karaan gahumsa garii akka qabaatu beekame." },
        { "cell": "abbrev", "text": "Mohammed dhimmoota kan biyya lafaa garasitti jiraniitiin baay’ee harkifamee ture. Holqa maqaan isaa “Hiiraa” jedhamee beekamu, kan gaara “Nuur” (ifaa) irratti argamutti deddeebi’aa ture." },
        { "cell": "abbrev", "text": "\"Inni [Weels] jalqabarraa nuun sobe. Jalqaba, akka waan kun sababa seeraatiif turee ta’uudhaan. Lammaffaa, waan nu dhageeffataa ture nutti fakkeessuudhaan, hamma dandeettiin isaa haqamutti.\"" },
        { "cell": "abbrev", "text": "Koomeen gadi bu’aaf fi bal’aa ta’uu qaba. Cirraachi, dhagaan fooyyee qabu yookaan ashaboon (kaalshiyeem kiloorayidii) akka miilli namaa lafa yookan karaa darbaa qabatuuf yeroo hedduu karaa irratti firfirfama." },
        { "cell": "latin-in-native", "text": "Nyaati warra Jaavaa, inni amma guutummaa tuuta cittuuwwaanii keessatti bal’inaan argamu, nyaata mi’eessituuwwan itti dabalaman sasalphaa hedduu qaba, mi’eessituuwwan irra guddinaan warri Jaavaa filatan, lawuza, mimmixa, fi sukkaara (keessumaa sukkaara warra jaavaa kan kokonatiiti) akkasumas mi’eessituu foolii gaarii qabana adda addaati." },
        { "cell": "latin-in-native", "text": "Gabaasni tokko tokkoo baay’inna nama du’ee saddeetiin ga’u, gabaasni seeraa akka mirkaneessetti immoo hanga 30tu midhame, garuu amallee lakkoofsi inni dhumaa hin beekamne." },
        { "cell": "latin-in-native", "text": "Reeffichi naannoo guyyaa tokkootiif achi akka oole ni mullata jedhe poolisiin." },
        { "cell": "latin-in-native", "text": "Kaariin “gogaa” yookin “jiidhaa”ta’u ni danda’a hammamtaa dhangala’aa irratti hundaa’uun." },
        { "cell": "percent", "text": "Shiboo faayibar optikii galaana jalaan Awurooppaa waliin walquunnamsiisuu fi saatalaayitii biroodbaandiitiif gallannii haa ta’uutii, Giriinlaandiin sirritti litti hidhamtee jirti, ummata isii kessaas 93% tajaajiila intarneetii ni qabu." },
        { "cell": "roman", "text": "Haati Imaanaa Muummittiin Ministeeraa Juuliyaa Gilaardi yeroo duula na filadhaa filannoo federaalaa 2010 tti akka cimsitee dubbattetti dhuma mootummaa Giiftii Eelsaabex II tti Awustiraaliyaan rippaabiliika ta’uu qabdi jettee amanti." },
        { "cell": "initialism", "text": "Jiimnaastikiin USA qorannoo of danda’ee deggera sunis yaanni sabboonummaan kan Leerii Naasaar lubbun isa hafeen kan kenname hammam badaa akka kan sirriitti mul’isa, kunimmo kan yeroo dheeraaf hin beekamin turee, osoo hin haammatamin turefi jijjiirran sirriin kan hin kennamneefidha." },
        { "cell": "initialism", "text": "Miidhaan guddaan yookiin cabiinsi Toongaa keessatti gabaafame hin jiru, garuu humni ibsaa yeroof badee ture, kun immoo itti gaafatamtootni Toongaa akeekachiisa Suunamii PTWC dhaan darbu akka hin fudhanne taasise." },
        { "cell": "initialism", "text": "Gaafa Roobii, ‘Waldaan Kubbaa Kaachoo Biyyaalessaa Yuunaayitid Isteetsi (NBA)’n sababa dhimmoota COVID-19n walqabatanniitiin waqtii kubbaa kaachoo ogeeyyotaa isaa yeroof dhaabeera." },
        { "cell": "initialism", "text": "ACMA dabalataan akka bira ga’etti viidiyoon isaa intarneetii irratti taphatamaa jiraatu illee , miidiyaan sun marsariitii Biig Biraazarii irra waan hin kaa’amneef Biig Biraazariin seera gulaallii qabiyyee toora inatrneetiirraa cabsee hinturre." },
        { "cell": "grouped", "text": "Lafa galaana gidduu filannoof dhihaatan 17,000 keessaa, nyaanni Indooneezhiyaa dibaabee haguugduu nyaatota naannoo garaagaraa lammiilee keessatti argamuuti." },
        { "cell": "grouped", "text": "Sadaffaa keessatti, Hamliin qabxii digdama duubatti haftee jirti, garuu Baaworiin shaniin dursitee turte. Kahne fi Truex Jr. walduraaduubaan qabxii 2,220 fi 2,207 n shanaffaa fi jahaffaadha." },
        { "cell": "grouped", "text": "Banaan vaalvii sirnichaaf akka dhiibbaan gad dhiifamu taasise achumaan boba’aan huccuu furdaa irraan gara kuusaa dhangala’aa barmeelii 55,000 (Gaaloonii miliyoona 2.3 ) baachuu danda’utti dhangala’e." },
        { "cell": "grouped", "text": "Qabxii torba boodatti hafuun, Joonsan qabxii 2,243n sadarkaa lammaffaarratti argama." },
        { "cell": "letter-name", "text": "Obbo Reeyid konkolaataa Niiwu Ziilaandii A1GP, Bilaak Biyuutii sa’a tokkotti saffisa kiiloo meetira 160 ol al torba riqicha irra oofuu danda’eera." },
        { "cell": "letter-name", "text": "Dhukaasa NASA kan dursu N. Wayne Hale Jr. akka jedhetti “yeroo nuti waa’ee isaa yaaddofne booda” hoomachi gad kufee ture." },
        { "cell": "letter-name", "text": "Yeroo wal-fakkaataatti, waraanni galaanaa Jarman daandii tiraafikaa kana bidiruu-U dhaan dhaabsisuuf yaalaa turan." },
        { "cell": "letter-name", "text": "Qubannaawwan Guyyaa-D fi lolli itti aananii geggeeffaman kaaba Faransaay bilisa baasanii turan, garuu kibbi ammallee bilisa hin turre." },
        { "cell": "ampersand", "text": "Gra fiixee dhumaa irratti , B&amp;B’ootaan kan beekamu irra caala wantoota lama irratti waldorgomu: siree tolchuu fi ciree qopheessuudha." },
        { "cell": "version-dot", "text": "Bara baraan naannoo ji’a Onkoloolessaa, bineensotni margaa fi biqiltuu sooratan kan miliyoona 1.5tti dhiyaatan rooba barbaacha laga Maaraa qaxxaamuruun gaarota kaabaarraa gara dirree kibbaatti geejjiba taasisu." },
        { "cell": "version-dot", "text": "Saffisawwan 802.11n kan isaan dura turan, kanneen saffisi isaanii ol-aanaan sekoondiitti meeggaabiitii 600 ta’e caalaa saffisa guddaa qabu." },
        { "cell": "quote-letter", "text": "Waraana addunyaa tokkoffaa irratti taateewwan babbadoo fi manca’iinsa dhala namaa irratti mul’ate biyyoonni baay’een eerga arganii booda, gara fuulduraatti akka deebi’ee hin uumamneef biyyootni fedhii argisiisan." },
        { "cell": "quote-letter", "text": "Dukkana keessatti agartuu halkaniitiin sirriitti arguu danda’u fi rakkoo tokko malee suuta jedhanii deemu, Adurreen bosonaa yemmuu adamsu warra adamfaman naannoo isaatti siksuun adamsee nyaata." },
        { "cell": "quote-letter", "text": "Saayintistoonni akka jedhanitti dhoohiinsi sababa kipheetin uumame baay’ee guddaa ture." },
        { "cell": "quote-letter", "text": "Boombiin dabalataa sadii yeroo sa’aatii lamaa keessatti cinaa gamoo mootummaatti dhuka’e." }
    ],

    // The representative tier. Uniform stride over the same segments; keep it alongside the hard-set.
    "sample": [
        "Nyaati warra Jaavaa, inni amma guutummaa tuuta cittuuwwaanii keessatti bal’inaan argamu, nyaata mi’eessituuwwan itti dabalaman sasalphaa hedduu qaba, mi’eessituuwwan irra guddinaan warri Jaavaa filatan, lawuza, mimmixa, fi sukkaara (keessumaa sukkaara warra jaavaa kan kokonatiiti) akkasumas mi’eessituu foolii gaarii qabana adda addaati.",
        "Wantichi baabura , konkolaataa fi meeshaalee geejjibaa biroo hedduu nuuf fideera.",
        "Gamoon kun namoota jilarra jiran, kanneen jalbultii imala hajjiitti magaalaa qulqullittii daawachuuf dhufan hedduu qabate.",
        "Imaammata kee fi teessoo qaama inshuraansii si seensisee koppii godhadhuutii qabadhuu deemi.",
        "Yaa'insa konkolaataa caalaatti bakka bu'uuf, amaloota ijoo sadeen irratti walitti dhuufeenyi dhaabamee jira: (1) ya'iinsa, (2) heddumminaa, fi (3) saffisa.",
        "Kan inni dhalate Hong Kongiti, Ma’n kan baratte Yuuniversitii Niiwu Yoorkiti fi mana barumsa seera Harvarditi fi yeroo tokko immo akka “green card” Ameerikaa qabaate ture.",
        "Oloompikii bara 2004 tti kan meedaaliyaa meetii argate Amir Khan akkas jedhe, “Keessa kootti Ani dubartootni loluu hin qaban. Kun yaada kiyya dha.”",
        "Afaan Ingiliziitiifi Afaan Jaappaaniitiin kan duraanuu gabaasaa jiru dhaabbati addunyaa kun teeleviizhiinii, marsariitii fi bilbila sochootuudhaaf Afaan Ispeenii, Xaaliyaanii, akkasumas Afaan Kooriyaatiin sagantaalee eegalee jira.",
        "Ilbiisonni baay’een carraa koochoo isaanii qaama isaanii wajjiin gara duubaatti dachaasuu qabu.",
        "Fulbaana17, 1939’tti, Humni ittisaa Poolaand cabee ture, abdiin inni tokkichi gara duubaatti deebi’anii Roomaaniyaa bakka hundee itti jabeeffatanii turanitti irra deebi’anii of ijaaruu ture.",
        "Meeshaalee sibiila gati-jabeessaa fi dhagaa hin argamne irra hojjetaman kumaatama dabalatee meeshaaleen Tutankhamun waliin awwaalaman hedduun sirritti kunuunfamaniiru.",
        "Dhukkuboonni daddarboon dhukkuboota haala salphaan nama hubametti waan siqaniif qofa namarra namatti dadddarbanidha.",
        "Suufiin uffannaa beekamaa hojiiti, namoonni waliin hojjetan immoo walii walii isaanii maqaa maatiitiin yookaan gita hojii isaaniitiin wal waamu.",
        "Sababoota hedduu pirooksiiwwan weebiihunda caalanidha: Irraa deebiin root godhanii Tiraafiika inteerneta, http qofa miti.",
        "Haaldureen kun kan qajeelfameef biyyoota lamaan gidduutti sochii godaansaa qindaa’aa ta’e uumuufidha.",
        "Xiyyaarri gara Irkuutiskiitti qajeelee ture, akkasumas loltoota keessatiin to’atamaa ture.",
        "Yohanis Grant, WNED bufaloo irra (Buufataa mana Ridiing Renboo) jedhee “Rediing Renboon sababaa maaliif akka dubbisu qabu barsiisa,… dubbisuu jallachu — [agarsiisichi] ijoollee kakaase akka macaafa fudhanii fi dubbisaniif.”",
        "Namootni bishaan faalame gara qilleensaatti qilleensa bubbee fi dambaliin fudhatamuun hubamuu danda’u.",
        "Eenyuyyuu Boobeekii alatti gonkumaa Dandeetti jabaa yookaan goolii bayyee kilabichaaf hin galmeesisne.",
        "Qopheessitoonni hoosteelii yeroo baayyee namoota umuriin ijoolleedha – gosoni keessummootaa warren umuriin digdamman kessaa jiranidha – garuu yeroo bayyee imaltoota umurniin deemanis argachuu dandeessa.",
        "Gaazexaan Ingilizii Ze Gaardiyaan Bankiin Neezarlaandi kaampaniiwwan sheelii 1200 keessaa naannoo harka tokko sadaaffaa akka to’atuuf yaada furmaataa dhiyeesse.",
        "Hojiiwwan tolaa kutaalee muraasa fi manaa fi nyaata akkasumas kafaltii xiqqoo waan dhiheessuuf yeroo dheeraaf bakka ta’e akka turuuf baajata osoo dheeratee.",
        "Yoo addunyaa guutummaatti naanna’uu barbaadda ta’e naannoo heemisfeera Kibbaa, filannoo balalii fi bakki ga’umsaa murtaa’aadha sababa daandii qaxxaamura garbaa waliin qabaniini.",
        "Namtichi meeshaa dhoohu hidhatee jedhame himamu konkolaataa miila sadi’iinilalama gara tuutaatti konkolaachise.",
        "Roobertis waa’ee yeroo itti jireenya jalqabee yeroo gafaatamee dubbachuu dide, gaaffii murteessaa yeroo waa’ee ulfa ofiirra baasuuf seera yeroo gaafatamee, akkas jechuudhan seeran alaa ta’uu danda’aa yaada kennun haala murteessa akkanaa irratti.",
        "Walta’iinsi daandii xiyyaaraa kam iyyuu qaxxaamura galaanaa Heemisfiirii Kibbaa keessatti argaman sadanuu waliinga’u hinjiru (fi IskaayTiim immoo qaxxaamurawwan kanniin keessaa tokko illee waliin hinga’u).",
        "Ka’umsi teeknoolojii haaraa akka caasaa sammuu ilaalluu fi qorannuu fi adeemsa hanga amma hin mul’anne arginu nu godhee jira.",
        "Chiiliin bilisumma ishee 1810 haa labsattuyyuu malee (waraanota Neepaaliyoon kan Ispeeniin mootummaa giddu galeessaa haboo qabu malee waggootaaf hanbise xumura argachiisuun), Ispeen irratti hanga 1818 tti guutummaatti injifannoon hin argamne.",
        "Tiyooriin kun maateriin baay’ee gurraachi naannoo Gaalaksii kan argaman naannoo gaalaksii haala haalootiini jedha, paartikiloota xixiqqoo hedduu irraas tolchame.",
        "Bakkoota addunyaa hedduu keessatti, fagooti harka walitti raasuun aggaammii hirriyummaa mul’isa, “nagumaa” jechuu agarsiisa."
    ]
}
