node_modules
*.log
.DS_Store

# Python training env (BiLSTM taggers) — not shipped
.venv/
__pycache__/

# fp32 intermediate from the G2P trainers; only the int8-quantised model is shipped
src/languages/english/en-g2p-tagger.onnx
src/languages/french/fr-g2p-tagger.onnx
src/languages/danish/da-g2p-tagger.onnx
src/languages/norwegian/nb-g2p-tagger.onnx

# Khmer boundary tagger: the torch checkpoint is a regeneratable intermediate — only the int8 graph and its
# meta ship. Rebuild with tools/khmer/build_km_segmenter_data.py + train_km_segmenter.py from a kmwiki dump.
src/languages/khmer/km_segmenter.pt

tools/fa-restoration/__pycache__/

# Sindhi tagger: checkpoints + fp32 intermediate (only the int8 model ships), and the regeneratable
# training artifacts. The MINED gold (sd.crossscript.tsv, sd.openlex*.tsv) IS committed — it is the
# input the lexicon and model derive from. sd_deva_pairs.json / sd_airab.json are rebuilt from the
# upstream dataset by extract_sd_openlex.py.
tools/sindhi/*.pt
# pa restorer checkpoint — a MEASURED NEGATIVE (investigation Run 9: loses to the shipped path at
# current data scale); the trainer is committed, the model is not shipped.
tools/perso-arabic/pa_restorer.pt
tools/sindhi/sd-g2p-tagger.onnx
tools/sindhi/sd-g2p-tagger.int8.onnx
# ckb bizroke tagger — the export tool writes fp32 + int8 + meta here and copies the shipped pair to src/
tools/central-kurdish/ckb-bizroke-tagger.onnx
tools/central-kurdish/ckb-bizroke-tagger.int8.onnx
tools/central-kurdish/ckb-bizroke-tagger.meta.json
tools/sindhi/sd-g2p-tagger.meta.json
tools/sindhi/sd_tagger_data*.tsv
tools/sindhi/sd_tagger_meta*.json
tools/sindhi/sd_deva_pairs.json
tools/sindhi/sd_airab.json

# Scratch notes — session handoffs and working files, never committed.
# ⚠ ANY extension, not just .md. The `.scratch.md` pattern was added for session handoffs and let a
# throwaway measurement script (`tools/normalization/yo-deg.scratch.mts`) into a merge commit — the
# convention is the `.scratch.` infix, so match on that.
*.scratch.*

# NON-COMMERCIAL licensed Urdu g2p data — regenerated by tools/perso-arabic/ur_build_hf_labels.py.
# Must never be committed: this repo is MIT + share-alike strata, and NC is neither.
tools/perso-arabic/silver.hfdict.tsv

# CC BY-SA 4.0 derived Urdu labels — regenerated by tools/perso-arabic/ur_build_dakshina_labels.py.
# Not committed: shipping it would need a LICENSES/PROVENANCE.md §3 share-alike fence + NOTICE
# attribution, and Run 18 sized its value at +1.3pp frequency-weighted and declined it.
tools/perso-arabic/silver.dakshina.tsv

# NON-COMMERCIAL licensed Khmer cross-check data — the aakanee.com dictionary via open-dict-data/ipa-dict
# (data/km.txt, CC BY-NC-SA 4.0). Measurement-only, consumed by tools/khmer/aakanee-crosscheck.ts from a
# path OUTSIDE the tree; this guard is for the canonical in-tree name in case a copy ever lands here.
tools/khmer/km.aakanee-nc.txt
tools/perso-arabic/silver.espeak-ps.tsv

# The --no-referee-silver measurement lexicon (tools/perso-arabic/invert_harakat.ts). A ~600 KB GPL-derived
# near-duplicate of lexicon.ps.tsv that exists only to measure how circular the ps referee score is; it
# regenerates from one documented flag and must never be mistaken for a shipped artifact. Ignored so a
# `git add -A` after a measurement run cannot commit it — which is exactly how it slipped into #797.
tools/perso-arabic/lexicon.*.noref.tsv

# Agent worktrees (created by parallel Claude Code agents; never source).
.claude/worktrees/

# C# build output — the port's bin/obj must never enter the tree
csharp/**/bin/
csharp/**/obj/
