// Native canonical-IPA definition for Kannada (kn) — a Dravidian Brahmic abugida read by the generic engine
// (core/abugida.ts), mirroring Telugu. Like Telugu (and unlike Hindi) Kannada does NOT delete the inherent vowel
// — every akshara is pronounced (inherent /a/, [ɐ] phonetically — the referee writes ɐ, folded). Dravidian
// short/long e,o are distinguished (ಎ e / ಏ eː, ಒ o / ಓ oː). Retroflex ʈ ɖ ɳ ɭ (ಟ ಡ ಣ ಳ) vs dental t̪ d̪ (ತ ದ),
// ಷ→ʂ, the archaic ೞ→ɻ / ಱ→r. Validated against wikipron kan + kaikki kan + epitran kan-Knda.
{
    "language": "kn",
    "name": "Kannada",
    "script": ["Kannada"],
    "provenance": "Authored from the Unicode Kannada chart + standard Kannada phonology. This file IS the language data — the generic abugida engine reads it directly.",

    "inherentVowel": "a",

    "consonants": {
        "ಕ": { "ipa": "k" }, "ಖ": { "ipa": "kʰ" }, "ಗ": { "ipa": "ɡ" }, "ಘ": { "ipa": "ɡʱ" }, "ಙ": { "ipa": "ŋ" },
        "ಚ": { "ipa": "t͡ʃ" }, "ಛ": { "ipa": "t͡ʃʰ" }, "ಜ": { "ipa": "d͡ʒ" }, "ಝ": { "ipa": "d͡ʒʱ" }, "ಞ": { "ipa": "ɲ" },
        "ಟ": { "ipa": "ʈ" }, "ಠ": { "ipa": "ʈʰ" }, "ಡ": { "ipa": "ɖ" }, "ಢ": { "ipa": "ɖʱ" }, "ಣ": { "ipa": "ɳ" },
        "ತ": { "ipa": "t̪", "note": "DENTAL (vs retroflex ಟ=ʈ)" }, "ಥ": { "ipa": "t̪ʰ" }, "ದ": { "ipa": "d̪" }, "ಧ": { "ipa": "d̪ʱ" }, "ನ": { "ipa": "n" },
        "ಪ": { "ipa": "p" }, "ಫ": { "ipa": "pʰ" }, "ಬ": { "ipa": "b" }, "ಭ": { "ipa": "bʱ" }, "ಮ": { "ipa": "m" },
        "ಯ": { "ipa": "j" }, "ರ": { "ipa": "ɾ" }, "ಱ": { "ipa": "r", "note": "archaic alveolar trill" }, "ಲ": { "ipa": "l" }, "ವ": { "ipa": "ʋ" },
        "ಶ": { "ipa": "ʃ" }, "ಷ": { "ipa": "ʂ" }, "ಸ": { "ipa": "s" }, "ಹ": { "ipa": "h" },
        "ಳ": { "ipa": "ɭ", "note": "retroflex lateral" }, "ೞ": { "ipa": "ɻ", "note": "archaic retroflex approximant" }
    },

    "independentVowels": {
        "ಅ": { "ipa": "a", "note": "short a (inherent; [ɐ])" },
        "ಆ": { "ipa": "aː", "note": "long a" },
        "ಇ": { "ipa": "i" }, "ಈ": { "ipa": "iː" }, "ಉ": { "ipa": "u" }, "ಊ": { "ipa": "uː" },
        "ಋ": { "ipa": "ɾu", "note": "vocalic r" }, "ೠ": { "ipa": "ɾuː" },
        "ಎ": { "ipa": "e", "note": "SHORT e (Dravidian)" }, "ಏ": { "ipa": "eː", "note": "long e" }, "ಐ": { "ipa": "ai" },
        "ಒ": { "ipa": "o", "note": "SHORT o (Dravidian)" }, "ಓ": { "ipa": "oː", "note": "long o" }, "ಔ": { "ipa": "au" }
    },

    "vowelSigns": {
        "ಾ": { "ipa": "aː" }, "ಿ": { "ipa": "i" }, "ೀ": { "ipa": "iː" }, "ು": { "ipa": "u" }, "ೂ": { "ipa": "uː" },
        "ೃ": { "ipa": "ɾu" }, "ೄ": { "ipa": "ɾuː" }, "ೆ": { "ipa": "e" }, "ೇ": { "ipa": "eː" }, "ೈ": { "ipa": "ai" },
        "ೊ": { "ipa": "o" }, "ೋ": { "ipa": "oː" }, "ೌ": { "ipa": "au" }
    },

    "signs": {
        "virama": { "char": "್", "effect": "suppressInherentVowel", "note": "vowel suppression / clusters" },
        "anusvara": { "char": "ಂ", "effect": "nasalizeVowel", "note": "→ homorganic nasal (aŋk); final → [m]" },
        "chandrabindu": { "char": "ಁ", "effect": "nasalizeVowel", "note": "nasalizes the preceding vowel" },
        "visarga": { "char": "ಃ", "effect": "appendH", "note": "→ [h]" },
        "nukta": { "char": "಼", "effect": "composeNukta", "note": "nukta (rare)" }
    },

    "clausePunctuation": {
        "।": ".", "॥": ".", ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Kannada spellings; canonical IPA DERIVED via the same G2P (no hand-written phonemes).
    // The compositor is Kannada's OWN (numbers.ts), not the shared `indicNumberWords`; see that file's
    // header for the three things the shared composer cannot express.
    "numbers": {
        "units": ["ಸೊನ್ನೆ", "ಒಂದು", "ಎರಡು", "ಮೂರು", "ನಾಲ್ಕು", "ಐದು", "ಆರು", "ಏಳು", "ಎಂಟು", "ಒಂಬತ್ತು"],
        "teens": ["ಹತ್ತು", "ಹನ್ನೊಂದು", "ಹನ್ನೆರಡು", "ಹದಿಮೂರು", "ಹದಿನಾಲ್ಕು", "ಹದಿನೈದು", "ಹದಿನಾರು", "ಹದಿನೇಳು", "ಹದಿನೆಂಟು", "ಹತ್ತೊಂಬತ್ತು"],
        "tens": { "20": "ಇಪ್ಪತ್ತು", "30": "ಮೂವತ್ತು", "40": "ನಲವತ್ತು", "50": "ಐವತ್ತು", "60": "ಅರವತ್ತು", "70": "ಎಪ್ಪತ್ತು", "80": "ಎಂಬತ್ತು", "90": "ತೊಂಬತ್ತು" },
        "compound": {
            "21": "ಇಪ್ಪತ್ತೊಂದು", "22": "ಇಪ್ಪತ್ತೆರಡು", "23": "ಇಪ್ಪತ್ತಮೂರು", "24": "ಇಪ್ಪತ್ತನಾಲ್ಕು", "25": "ಇಪ್ಪತ್ತೈದು",
            "26": "ಇಪ್ಪತ್ತಾರು", "27": "ಇಪ್ಪತ್ತೇಳು", "28": "ಇಪ್ಪತ್ತೆಂಟು", "29": "ಇಪ್ಪತ್ತೊಂಬತ್ತು",
            "31": "ಮೂವತ್ತೊಂದು", "32": "ಮೂವತ್ತೆರಡು", "33": "ಮೂವತ್ತಮೂರು", "34": "ಮೂವತ್ತನಾಲ್ಕು", "35": "ಮೂವತ್ತೈದು",
            "36": "ಮೂವತ್ತಾರು", "37": "ಮೂವತ್ತೇಳು", "38": "ಮೂವತ್ತೆಂಟು", "39": "ಮೂವತ್ತೊಂಬತ್ತು",
            "41": "ನಲವತ್ತೊಂದು", "42": "ನಲವತ್ತೆರಡು", "43": "ನಲವತ್ತಮೂರು", "44": "ನಲವತ್ತನಾಲ್ಕು", "45": "ನಲವತ್ತೈದು",
            "46": "ನಲವತ್ತಾರು", "47": "ನಲವತ್ತೇಳು", "48": "ನಲವತ್ತೆಂಟು", "49": "ನಲವತ್ತೊಂಬತ್ತು",
            "51": "ಐವತ್ತೊಂದು", "52": "ಐವತ್ತೆರಡು", "53": "ಐವತ್ತಮೂರು", "54": "ಐವತ್ತನಾಲ್ಕು", "55": "ಐವತ್ತೈದು",
            "56": "ಐವತ್ತಾರು", "57": "ಐವತ್ತೇಳು", "58": "ಐವತ್ತೆಂಟು", "59": "ಐವತ್ತೊಂಬತ್ತು",
            "61": "ಅರವತ್ತೊಂದು", "62": "ಅರವತ್ತೆರಡು", "63": "ಅರವತ್ತಮೂರು", "64": "ಅರವತ್ತನಾಲ್ಕು", "65": "ಅರವತ್ತೈದು",
            "66": "ಅರವತ್ತಾರು", "67": "ಅರವತ್ತೇಳು", "68": "ಅರವತ್ತೆಂಟು", "69": "ಅರವತ್ತೊಂಬತ್ತು",
            "71": "ಎಪ್ಪತ್ತೊಂದು", "72": "ಎಪ್ಪತ್ತೆರಡು", "73": "ಎಪ್ಪತ್ತಮೂರು", "74": "ಎಪ್ಪತ್ತನಾಲ್ಕು", "75": "ಎಪ್ಪತ್ತೈದು",
            "76": "ಎಪ್ಪತ್ತಾರು", "77": "ಎಪ್ಪತ್ತೇಳು", "78": "ಎಪ್ಪತ್ತೆಂಟು", "79": "ಎಪ್ಪತ್ತೊಂಬತ್ತು",
            "81": "ಎಂಬತ್ತೊಂದು", "82": "ಎಂಬತ್ತೆರಡು", "83": "ಎಂಬತ್ತಮೂರು", "84": "ಎಂಬತ್ತನಾಲ್ಕು", "85": "ಎಂಬತ್ತೈದು",
            "86": "ಎಂಬತ್ತಾರು", "87": "ಎಂಬತ್ತೇಳು", "88": "ಎಂಬತ್ತೆಂಟು", "89": "ಎಂಬತ್ತೊಂಬತ್ತು",
            "91": "ತೊಂಬತ್ತೊಂದು", "92": "ತೊಂಬತ್ತೆರಡು", "93": "ತೊಂಬತ್ತಮೂರು", "94": "ತೊಂಬತ್ತನಾಲ್ಕು", "95": "ತೊಂಬತ್ತೈದು",
            "96": "ತೊಂಬತ್ತಾರು", "97": "ತೊಂಬತ್ತೇಳು", "98": "ತೊಂಬತ್ತೆಂಟು", "99": "ತೊಂಬತ್ತೊಂಬತ್ತು"
        },
        "hundredForms": {
            "1": { "bare": "ನೂರು", "combining": "ನೂರಾ" },
            "2": { "bare": "ಇನ್ನೂರು", "combining": "ಇನ್ನೂರಾ" },
            "3": { "bare": "ಮುನ್ನೂರು", "combining": "ಮುನ್ನೂರಾ" },
            "5": { "bare": "ಐನೂರು", "combining": "ಐನೂರಾ" },
            "9": { "bare": "ಒಂಬೈನೂರು", "combining": "ಒಂಬೈನೂರಾ" }
        },
        "magnitudeForms": {
            "hundred": { "bare": "ನೂರು", "combining": "ನೂರಾ" },
            "thousand": { "bare": "ಸಾವಿರ", "combining": "ಸಾವಿರದ" },
            "lakh": { "bare": "ಲಕ್ಷ", "combining": "ಲಕ್ಷದ" },
            "crore": { "bare": "ಕೋಟಿ", "combining": "ಕೋಟಿ" }
        },

        "decimalWord": "ದಶಾಂಶ"
    },

    // ⚠ WRITTEN FORMS FOR RECOGNITION, NOT A SPELLING MAP — see the tamil manifest for the full argument.
    // ⚠ AND DELIBERATELY TINY. Only the four forms the corpus actually attests are listed: the rule merely
    // deletes the interior dots, so the letter names reaching the output are the corpus's own spellings
    // passed through unchanged, and nothing is invented. A generic short-token rule cannot be written safely
    // against a script with no case distinction.
    "initialismLetterForms": [
        "ಯು", "ಎಸ್", "ಡಿ", "ಕೆ"
    ],

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, NOT `symbols`, AND THE COLLISION IS REAL. `symbols` already means something else
    // in every abugida manifest: the BARE-SIGN → word map the Hindi engine's tokenizer reads (`% → প্রতিশত`,
    // `₹` stripped). This block is the SHARED TIER's data — percent forms, currency, units, exponents — a
    // different table read by a different pass. Filing both under one name would be the PREFIX_GUESS shape,
    // and here it would also not compile.
    "symbolTier": {
        // ⚠ THE AMPERSAND WAS A MISSING CELL, NOT A SOURCING PROBLEM — the tier's own `ampersand` note says so,
        // and this language is one of the fourteen that still had no word declared, so `&` was DROPPED outright.
        // ಮತ್ತು is ×1683 TOKEN in this language's own corpus, i.e. among its commonest words; there was nothing to source.
        //
        // A Latin-script printing LIGATURE rather than anything native, so what it takes is a reading and not a
        // translation: for a language written in Latin script that is its own conjunction, and for one that is not,
        // the symbol only ever arrives inside a Latin run. Either way the tier substitutes the conjunction, SPACED —
        // see the tier, where the spacing exists because `B&B` is two initialisms.
        "ampersand": "ಮತ್ತು",
        // `multiply` — this language had NO word for the sign at all. ⚠ STANDARD MATHEMATICAL REGISTER, not a
        // corpus attestation: the sweep's plausible hits were homographs of PREPOSITIONS (es `por` ×23, it `per` ×25,
        // ru `на` ×31 are all the preposition), the same trap that defeated the exponent sourcing. One word, so `by`
        // defaults to it — this language does not split dimension from product.
        "multiply": { "times": "ಗುಣಿಸಿ" },
        "percent": ["ಪ್ರತಿಶತ"],
        "currency": { "US$": ["ಡಾಲರ್"], "$": ["ಡಾಲರ್"] },
        "magnitudes": ["ಮಿಲಿಯನ್", "ಬಿಲಿಯನ್", "ದಶಲಕ್ಷ", "ಶತಕೋಟಿ", "ಲಕ್ಷ", "ಕೋಟಿ"],
        // `m` ADDED so the cube word below has a head noun at all — the exponent branch resolves the unit from
        // `units` first, so a cube word without it is dead data. ಮೀಟರ್ ×10, and digit-adjacent bare `m` is ×0 in
        // this corpus, so the one-letter-key hazard is checked rather than assumed.
        "units": { "km": ["ಕಿಲೋಮೀಟರ್"], "m": ["ಮೀಟರ್"] },
        // `120-160 ಘನ ಮೀಟರ್‍‌ನಷ್ಟು ಇಂಧನ` — word-first, beside ಚದರ.
        "exponentWords": { "squared": ["ಚದರ"], "cubed": ["ಘನ"], "position": "before" }
    }
}
