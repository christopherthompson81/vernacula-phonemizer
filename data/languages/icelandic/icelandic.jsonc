// Native canonical-IPA data manifest for Icelandic (is) — íslenska, the most archaic living North Germanic language
// (~330k), Latin script + ⟨þ ð æ ö⟩. One of the DEEPEST orthographies in the fleet: no voicing
// contrast in stops (the contrast is ASPIRATION), so ⟨b d g⟩/⟨p t k⟩ neutralize to [p t k]; famous epenthetic-stop
// clusters ⟨ll⟩→[tl] ⟨rl⟩→[rtl] ⟨rn⟩→[rtn]; rich vowel values (á→au, ó→ou, æ→ai, au→øy). Aspiration + length are
// folded (run 1). PRIMARY STRESS is fixed on the first syllable and IS emitted (dagur→tˈaɣʏr) — no table here
// because there is nothing to tabulate: the rule has no lexical exceptions and no prefix class. SECONDARY
// stress (later compound members) is not emitted; it needs a compound splitter this engine does not have.
// docs/investigations/icelandic_stress_investigation.md. Engine: icelandic.ts.
{
    "language": "is",
    "name": "Icelandic (íslenska)",
    "script": ["Latin"],

    // Multi-letter graphemes, scanned LONGEST-FIRST. Vowel digraphs ⟨au⟩→øy, ⟨ei ey⟩→ei; ⟨hv⟩→kv; the epenthetic-stop
    // sonorant clusters ⟨ll⟩→tl, ⟨rl⟩→rtl, ⟨rn⟩→rtn (⟨nn⟩ is context-dependent → handled in code).
    "digraphs": {
        "au": "øy", "ei": "ei", "ey": "ei",
        "hv": "kv", "hj": "ç", "hr": "r", "hl": "l", "hn": "n",
        "ll": "tl", "rl": "rtl", "rn": "rtn"
    },

    // Single grapheme → canonical IPA (aspiration folded, so ⟨p b⟩→p, ⟨t d⟩→t, ⟨k g⟩→k; g→ɣ/c is done in code).
    // Vowels: ⟨á⟩→au, ⟨é⟩→jɛ, ⟨í ý⟩→i, ⟨ó⟩→ou, ⟨u⟩→ʏ, ⟨ú⟩→u, ⟨ö⟩→œ, ⟨æ⟩→ai. ⟨þ⟩→θ, ⟨ð⟩→ð.
    "graphemes": {
        "a": "a", "á": "au", "e": "ɛ", "é": "jɛ", "i": "ɪ", "í": "i", "o": "ɔ", "ó": "ou",
        "u": "ʏ", "ú": "u", "y": "ɪ", "ý": "i", "ö": "œ", "æ": "ai",
        "b": "p", "d": "t", "g": "k", "p": "p", "t": "t", "k": "k",
        "f": "f", "s": "s", "h": "h", "j": "j", "l": "l", "m": "m", "n": "n", "r": "r", "v": "v",
        "þ": "θ", "ð": "ð", "x": "ks", "c": "k", "q": "k", "w": "v", "z": "s"
    },

    // ⚠ FOUR LETTER CLASSES, one per context rule in icelandic.ts. They overlap but none is derivable from
    // another, which is why each is written out.
    //
    // "frontVowels" — ⟨g k⟩ become the affricates [c ch] before one of these (kex→cɛxs). ⟨j⟩ is in the list
    // because the glide conditions the change exactly as a front vowel does.
    "frontVowels": ["e", "é", "i", "í", "y", "ý", "æ", "j"],
    // ⚠ "hiatusGlideVowels" — ONE LETTER, and that is the measured answer, not an oversight. A vowel here
    // inserts a glide [j] before a following vowel (Biblía→pɪplija). It was ⟨i í y ý⟩ ("the high front
    // vowels", by reasoning) and over-applied; the referee says the glide belongs to the LONG ⟨í⟩ alone.
    // Counting every referee headword with a high-front letter directly before another vowel letter
    // (tools/referee-eval/referees/is.wikipron-isl-broad.tsv):
    //     ⟨í⟩  90 glide /  13 none   — í+a 73/7 (Albanía, Asía, Biblía), í+u 10/2, í+ó 4/3, í+e 3/1
    //     ⟨i⟩   2 glide /   7 none   — i+e 0/4 (Briem, Nielsen, beitieski), i+ö 0/1, i+á 0/1
    //     ⟨ý⟩   0 glide /   4 none   — ý+y 0/2 (nýyrði), ý+a 0/1 (blýantur), ý+e 0/1 (hýena)
    //     ⟨y⟩   1 glide /   0 none
    // Measured end to end with tools/referee-eval/eval.ts: ⟨i í y ý⟩ 8086/10093 → ⟨í ý⟩ 8087 → ⟨í⟩ 8091.
    // NOT narrowed further: dropping ⟨í⟩ before ⟨ó⟩ (the bíó words, 4 glide / 3 none) would trade 4 losses
    // for 3 gains, so the residual there is left alone rather than tuned into noise.
    "hiatusGlideVowels": ["í"],
    // "longNuclei" — the accented vowels, which are long by spelling. A doubled ⟨nn⟩ is the PREASPIRATED
    // [tn] only after one of these (or after the diphthongs ⟨au ei ey⟩, which the engine tests separately);
    // after a short vowel it is the plain geminate [nː]. This is the ⟨nn⟩ of the definite article.
    "longNuclei": ["á", "é", "í", "ó", "ú", "ý", "æ"],
    // "collapsingDoubles" — the NON-STOP consonants whose doubling is purely orthographic and collapses to
    // one phone (Sviss→svɪs). The stops ⟨p t k⟩ are excluded deliberately: their doubling is preaspiration,
    // a real sound change, handled separately.
    "collapsingDoubles": ["s", "f", "m", "r", "v", "þ", "ð"],

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // ── CARDINAL NUMBER WORDS ────────────────────────────────────────────────────────────────────────────────────
    // Source: Wiktionary "Appendix:Icelandic numerals" (the cardinal table, the gender paradigms for 1–4, and the
    // magnitude words hundrað / hundruð / þúsund / milljón / milljarður), cross-checked against
    // languagesandnumbers.com/how-to-count-in-icelandic. Icelandic is tens-FIRST and joins the final unit with "og":
    // tuttugu og einn = 21, fjörutíu og fimm = 45.
    //
    // GENDER. Icelandic 1–4 inflect (einn/ein/eitt, tveir/tvær/tvö, þrír/þrjár/þrjú, fjórir/fjórar/fjögur) and a
    // bare numeral has no noun to agree with. The citation form used for counting aloud is the MASCULINE (einn,
    // tveir, þrír, fjórir) — that is the `ones` table. The other two genders are needed anyway, because a
    // multiplier agrees with its MAGNITUDE NOUN: hundrað and þúsund are NEUTER (tvö hundruð, þrjú þúsund), milljón
    // is FEMININE (ein milljón, tvær milljónir) and milljarður is MASCULINE (einn milljarður). numbers.ts selects
    // the right column per position; only 1–4 have entries, everything from fimm up is invariant.
    "numbers": {
        "ones": [
            "núll", "einn", "tveir", "þrír", "fjórir", "fimm", "sex", "sjö", "átta", "níu",
            "tíu", "ellefu", "tólf", "þrettán", "fjórtán", "fimmtán", "sextán", "sautján", "átján", "nítján"
        ],
        "onesFeminine": ["", "ein", "tvær", "þrjár", "fjórar"],
        "onesNeuter": ["", "eitt", "tvö", "þrjú", "fjögur"],
        "tens": ["", "", "tuttugu", "þrjátíu", "fjörutíu", "fimmtíu", "sextíu", "sjötíu", "áttatíu", "níutíu"],
        "connector": "og",
        "hundred": { "one": "eitt hundrað", "plural": "hundruð" },
        "thousand": { "one": "eitt þúsund", "word": "þúsund" },
        "million": { "one": "ein milljón", "plural": "milljónir" },
        "billion": { "one": "einn milljarður", "plural": "milljarðar" }
    },

    // THE ORDINAL SERIES, three agreement forms each: `masc` is the masculine nominative, `common` covers
    // masculine oblique / feminine nominative / all neuter (-a), and `femOblique` is the feminine oblique
    // (-u), which the corpus needs for the genitive `aldar`. ⚠ NAMED FIELDS RATHER THAN A POSITIONAL TRIPLE:
    // the code built these through an `ORD(masc, common, femOblique)` helper, and a bare 3-array in the
    // manifest would put the reader one indirection away from knowing which slot is which.
    "ordinals": {
        "1": { "masc": "fyrsti", "common": "fyrsta", "femOblique": "fyrstu" },
        "2": { "masc": "annar", "common": "annan", "femOblique": "annarrar" },
        "3": { "masc": "þriðji", "common": "þriðja", "femOblique": "þriðju" },
        "4": { "masc": "fjórði", "common": "fjórða", "femOblique": "fjórðu" },
        "5": { "masc": "fimmti", "common": "fimmta", "femOblique": "fimmtu" },
        "6": { "masc": "sjötti", "common": "sjötta", "femOblique": "sjöttu" },
        "7": { "masc": "sjöundi", "common": "sjöunda", "femOblique": "sjöundu" },
        "8": { "masc": "áttundi", "common": "áttunda", "femOblique": "áttundu" },
        "9": { "masc": "níundi", "common": "níunda", "femOblique": "níundu" },
        "10": { "masc": "tíundi", "common": "tíunda", "femOblique": "tíundu" },
        "11": { "masc": "ellefti", "common": "ellefta", "femOblique": "elleftu" },
        "12": { "masc": "tólfti", "common": "tólfta", "femOblique": "tólftu" },
        "13": { "masc": "þrettándi", "common": "þrettánda", "femOblique": "þrettándu" },
        "14": { "masc": "fjórtándi", "common": "fjórtánda", "femOblique": "fjórtándu" },
        "15": { "masc": "fimmtándi", "common": "fimmtánda", "femOblique": "fimmtándu" },
        "16": { "masc": "sextándi", "common": "sextánda", "femOblique": "sextándu" },
        "17": { "masc": "sautjándi", "common": "sautjánda", "femOblique": "sautjándu" },
        "18": { "masc": "átjándi", "common": "átjánda", "femOblique": "átjándu" },
        "19": { "masc": "nítjándi", "common": "nítjánda", "femOblique": "nítjándu" },
        "20": { "masc": "tuttugasti", "common": "tuttugasta", "femOblique": "tuttugustu" },
        "21": { "masc": "tuttugasti og fyrsti", "common": "tuttugasta og fyrsta", "femOblique": "tuttugustu og fyrstu" },
        "22": { "masc": "tuttugasti og annar", "common": "tuttugasta og annan", "femOblique": "tuttugustu og annarrar" },
        "23": { "masc": "tuttugasti og þriðji", "common": "tuttugasta og þriðja", "femOblique": "tuttugustu og þriðju" },
        "24": { "masc": "tuttugasti og fjórði", "common": "tuttugasta og fjórða", "femOblique": "tuttugustu og fjórðu" },
        "25": { "masc": "tuttugasti og fimmti", "common": "tuttugasta og fimmta", "femOblique": "tuttugustu og fimmtu" },
        "26": { "masc": "tuttugasti og sjötti", "common": "tuttugasta og sjötta", "femOblique": "tuttugustu og sjöttu" },
        "27": { "masc": "tuttugasti og sjöundi", "common": "tuttugasta og sjöunda", "femOblique": "tuttugustu og sjöundu" },
        "28": { "masc": "tuttugasti og áttundi", "common": "tuttugasta og áttunda", "femOblique": "tuttugustu og áttundu" },
        "29": { "masc": "tuttugasti og níundi", "common": "tuttugasta og níunda", "femOblique": "tuttugustu og níundu" },
        "30": { "masc": "þrítugasti", "common": "þrítugasta", "femOblique": "þrítugustu" },
        "31": { "masc": "þrítugasti og fyrsti", "common": "þrítugasta og fyrsta", "femOblique": "þrítugustu og fyrstu" }
    }
}
