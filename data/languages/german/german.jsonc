// Native canonical-IPA MANIFEST for German (de) — standard / Hochdeutsch, broad IPA. A self-describing
// description of the language's DATA, matching english.jsonc / arabic.jsonc: the vowel length maps, final
// devoicing pairs, the short-monosyllable / long-ch exception lists, clause punctuation, the morphology tables
// (affix IPA, linking elements, valid onsets), and the cardinal number words. The ALGORITHMS (the length scan,
// syllabification, compound splitting, affix stripping, stress) stay in code and read these tables.
//
// LOAD-BEARING blocks (read via manifest.ts): "vowelChars", "vowels", "voicedFinal", "shortMonosyllables",
// "longCh", "clausePunctuation", "morphology", "numbers". "convention" / "provenance" are documentation.
{
    // ACRONYMS read letter-by-letter that the OOV phonotactic rule would leave alone, being pronounceable
    // German letter strings. A LEXICAL fact: USA (x14) and US (x30) are spelled out, not said as words.
    // German's lexicon is a stress/length CORRECTION table, not a wordlist, so it cannot serve as the
    // "is this recorded" test the way CMUdict or Lexique do.
    "acronymLetters": [
        "usa", "us", "aol", "eu", "brd", "ddr", "zdf", "ard", "bmw", "vw", "dna", "gps", "utc",
        "pbs", "bbc", "cnn", "fbi", "tv", "pkw", "lkw", "akw", "who", "uno", "bip", "mwst"
    ],

    "language": "de",
    "script": ["Latin"],
    "name": "German (standard / Hochdeutsch)",
    "provenance": "Cleanroom, rule-based g2p + a pronunciation lexicon (lexicon.tsv) + morphological compound/affix analysis + a vigesimal-free number compositor. The affix IPA, the exception word-lists, and the number words are language facts.",

    // The canonical-IPA conventions the values below are written in (documentation).
    "convention": {
        "vowelLength": "tense/long vs lax/short pairs (aː/a, eː/ɛ, iː/ɪ, oː/ɔ, uː/ʊ, øː/œ, yː/ʏ); ə/ɐ reduced",
        "finalDevoicing": "Auslautverhärtung — b/d/ɡ/v/z → p/t/k/f/s word/syllable-finally",
        "morphology": "compound splitting (Fugen-s), separable/inseparable prefixes, closed-class suffixes with fixed IPA",
        "glides": "diphthongs aɪ̯ aʊ̯ ɔɪ̯; syllabic ɐ̯ (r-vocalisation); ç/x (ich/ach-Laut)",
        "numbers": "compound words, units before tens (einundzwanzig); split at thousand/million boundaries",
    },

    // IPA vowel inventory (for nucleus detection in the lexicon post-pass).
    "vowelChars": "aɐeɛiɪoɔuʊøœyʏə",

    // Vowel length maps. `long`/`short`: orthographic vowel letter → IPA (the g2p length rule picks one).
    // `longOf`/`shortOf`: IPA vowel → its long/short counterpart (the lexicon re-length post-pass).
    "vowels": {
        "long": {
            "a": "aː",
            "e": "eː",
            "i": "iː",
            "o": "oː",
            "u": "uː",
            "ä": "ɛː",
            "ö": "øː",
            "ü": "yː",
            "y": "yː",
        },
        "short": {
            "a": "a",
            "e": "ɛ",
            "i": "ɪ",
            "o": "ɔ",
            "u": "ʊ",
            "ä": "ɛ",
            "ö": "œ",
            "ü": "ʏ",
            "y": "ʏ",
        },
        "longOf": {
            "a": "aː",
            "ɛ": "eː",
            "ɪ": "iː",
            "ɔ": "oː",
            "ʊ": "uː",
            "œ": "øː",
            "ʏ": "yː",
        },
        "shortOf": {
            "a": "a",
            "e": "ɛ",
            "i": "ɪ",
            "o": "ɔ",
            "u": "ʊ",
            "ø": "œ",
            "y": "ʏ",
            "ɛ": "ɛ",
        },
    },

    // Context-free consonant letters → IPA (the g2p's final switch). The context-DEPENDENT letters h (silent
    // after a vowel), s (→z before a vowel), x (→ks) and all digraphs/diphthongs stay in the g2p scanner.
    "consonants": {
        "b": "b",
        "c": "k",
        "d": "d",
        "f": "f",
        "g": "ɡ",
        "j": "j",
        "k": "k",
        "l": "l",
        "m": "m",
        "n": "n",
        "p": "p",
        "t": "t",
        "v": "f",
        "w": "v",
        "z": "t͡s",
    },

    // Final devoicing (Auslautverhärtung): voiced obstruent → voiceless word/syllable-finally.
    "voicedFinal": { "b": "p", "d": "t", "ɡ": "k", "v": "f", "z": "s" },

    // Short-vowel function words / clitics that the V+single-final-C → long rule would over-lengthen.
    "shortMonosyllables": [
        "das",
        "was",
        "des",
        "es",
        "in",
        "im",
        "an",
        "am",
        "um",
        "mit",
        "bis",
        "weg",
        "man",
        "von",
        "hat",
        "ob",
        "ab",
        "bin",
        "hin",
        "wes",
        "bist",
        "ist",
        "und",
        "als",
        "hast",
        "wenn",
        "denn",
        "zur",
        "zum",
        "vom",
        "drin",
        "etwas",
        "darum",
        "warum",
        "herum",
        "worum",
        "vielleicht",
        "hinein",
        "herein",
    ],
    // Stems whose vowel before ⟨ch⟩ is LONG (the minority; default is short — ach, Bach, mich).
    "longCh": [
        "nach",
        "buch",
        "such",
        "sprach",
        "hoch",
        "tuch",
        "fluch",
        "kuch",
        "wuch",
    ],

    // Clause / phrase punctuation → canonical inline pause marks.
    // ── The tables normalize.ts and german.ts read ────────────────────────────────────────────────────

    "months": ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September",
               "Oktober", "November", "Dezember"],
    // Nouns that follow an ordinal numeral. ⚠ `Jahrunderts` is the CORPUS'S OWN MISSPELLING, kept so the
    // rule still fires on it — removing it would silently stop claiming those instances.
    "ordinalNouns": ["Jahrhundert", "Jahrhunderts", "Jahrunderts", "Jh"],
    // Prepositions that license an ordinal AND govern the weak -en ending.
    "weakEn": ["am", "im", "vom", "zum", "beim", "dem", "des", "den", "ins", "seit", "bis", "ab", "nach", "vor", "zur"],
    // ⚠ THE FULL LICENSER SET IS `weakEn` PLUS THESE — articles license the reading but not the -en ending.
    "ordinalLicensersExtra": ["das", "der", "die", "ein", "eine", "sein", "ihr"],

    "ordinals": {
        // Suppletive stems. `acht` is here because it already ends in t and must not take another.
        "irregularStems": { "1": "erst", "3": "dritt", "7": "siebt", "8": "acht" },
        "suffixBelow20": "t",
        "suffixFrom20": "st"
    },

    "dottedAbbrev": {
        "bzw": "beziehungsweise", "usw": "und so weiter", "ca": "circa", "evtl": "eventuell",
        "ggf": "gegebenenfalls", "inkl": "inklusive", "exkl": "exklusive", "bzgl": "bezüglich",
        "einschl": "einschließlich", "dr": "Doktor", "prof": "Professor", "st": "Sankt", "hr": "Herr",
        "fr": "Frau", "nr": "Nummer", "mio": "Millionen", "mrd": "Milliarden", "jh": "Jahrhundert",
        "bd": "Band", "s": "Seite", "vgl": "vergleiche"
    },

    // German letter names, for initialisms: USA is [uː ʔɛs ʔaː], not the word *usa*.
    "letterNames": {
        "a": "a", "b": "be", "c": "ze", "d": "de", "e": "e", "f": "eff", "g": "ge", "h": "ha", "i": "i",
        "j": "jott", "k": "ka", "l": "ell", "m": "emm", "n": "enn", "o": "o", "p": "pe", "q": "ku",
        "r": "err", "s": "ess", "t": "te", "u": "u", "v": "vau", "w": "we", "x": "iks", "y": "üpsilon",
        "z": "zett", "ä": "ä", "ö": "ö", "ü": "ü"
    },

    // Phonotactics, for the OOV rule in core/initialisms.ts.
    "phonotactics": {
        "vowels": "aeiouäöüy",
        "onsets": [
        "bl", "br", "ch", "dr", "fl", "fr", "gl", "gr", "kl", "kn", "kr", "pf", "pl", "pr", "ps", "qu", "sc",
        "sch", "sh", "sk", "sl", "sm", "sn", "sp", "st", "sw", "th", "tr", "tw", "vl", "vr", "zw", "ph", "gn",
        "schw", "wl"
        ],
        "codas": [
        "ch", "ck", "ft", "ht", "lb", "ld", "lf", "lk", "lm", "ln", "lp", "ls", "lt", "lz", "mm", "mp", "ms",
        "nd", "nf", "ng", "nk", "ns", "nt", "nz", "pf", "ps", "rb", "rd", "rf", "rg", "rk", "rl", "rm", "rn",
        "rp", "rs", "rt", "rz", "sch", "sk", "sp", "st", "ss", "tt", "tz", "ts", "ks", "nn", "bt", "hl", "gt",
        "hr", "kt", "hn", "zt", "hm", "mt", "ll", "rr", "cht", "ngt"
        ],
        "digraphs": [
        "ch", "sch", "tz", "ck", "ph", "th", "ng", "qu", "ss", "sh"
        ]
    },

    // Noun stems that mark a following number as a MEASURE rather than a year. ⚠ The rule appends
    // `\p{L}*`, so each entry is a STEM and matches its inflected forms.
    "measureStems": [
        "Prozent", "Grad", "Euro", "Cent", "Dollar", "Pfund", "Franken", "Kilometer", "Meter", "Zentimeter",
        "Millimeter", "Meile", "Kilogramm", "Gramm", "Tonne", "Liter", "Hektar", "Quadrat", "Kubik", "Volt",
        "Watt", "Stück", "Mal", "mal", "Million", "Milliarde", "Jahr", "Monat", "Tag", "Stunde", "Minute",
        "Sekunde", "Mann", "Mensch", "Einwohner", "Person", "Soldat", "Mitarbeiter", "Teilnehmer", "Besucher"
    ],

    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Morphological analysis tables (the algorithm — splitting/stripping/stress — is in morphology.ts).
    "morphology": {
        // Prefixes/suffixes tried longest-first for greedy stripping. Unstressed prefixes reduce their vowel;
        // stressed (separable) prefixes carry primary stress. Their IPA is in prefixIpa/suffixIpa below.
        "prefixUnstressed": [
            "ver",
            "zer",
            "ent",
            "emp",
            "miss",
            "be",
            "ge",
            "er",
            "un",
        ],
        "prefixStressed": [
            "hinter",
            "wider",
            "durch",
            "unter",
            "über",
            "gegen",
            "voll",
            "auseinander",
            "auf",
            "aus",
            "ein",
            "vor",
            "mit",
            "nach",
            "bei",
            "zu",
            "an",
            "ab",
            "um",
            "her",
            "hin",
            "los",
            "weg",
            "empor",
            "dar",
        ],
        "suffixes": [
            "schaft",
            "ungen",
            "lichen",
            "keiten",
            "heiten",
            "chen",
            "lein",
            "ung",
            "heit",
            "keit",
            "lich",
            "isch",
            "bar",
            "sam",
            "los",
            "haft",
            "nis",
            "tum",
            "ig",
            "er",
            "en",
            "es",
            "em",
            "et",
            "st",
            "e",
        ],
        // Vowel-initial suffixes resyllabify onto the stem (no devoicing boundary).
        "vowelInitialSuffixes": [
            "ung",
            "ungen",
            "ig",
            "isch",
            "en",
            "er",
            "e",
            "es",
            "em",
            "et",
        ],
        // be-/ge-/er- also occur root-initially (beide, geht, Erde): only strip if the remainder is a real word.
        "ambiguousPrefixes": ["be", "ge", "er"],
        // Fugen-elemente in preference order (a stem flagged `s` prefers -s-: Zeitungs-, Arbeits-).
        "linkingElements": ["", "s", "n", "es", "en", "e", "er"],
        // Valid German onset clusters (a stripped stem must start with one — so be+rlin is rejected).
        "validOnsets": [
            "st",
            "sp",
            "sc",
            "sk",
            "sm",
            "sn",
            "sw",
            "tr",
            "dr",
            "kr",
            "gr",
            "br",
            "pr",
            "fr",
            "kl",
            "gl",
            "bl",
            "pl",
            "fl",
            "kn",
            "gn",
            "pf",
            "kw",
            "zw",
            "tw",
            "ph",
            "th",
            "ch",
            "qu",
            "wr",
            "schl",
            "schw",
        ],
        // Fixed IPA for the closed affixes. Unstressed prefixes reduce; separable ones keep full vowels.
        "prefixIpa": {
            "be": "bə",
            "ge": "ɡə",
            "ver": "fɛɐ̯",
            "zer": "t͡sɛɐ̯",
            "ent": "ɛnt",
            "emp": "ɛmp",
            "miss": "mɪs",
            "er": "ɛɐ̯",
            "un": "ʊn",
            "auf": "aʊ̯f",
            "aus": "aʊ̯s",
            "ein": "aɪ̯n",
            "vor": "foːɐ̯",
            "mit": "mɪt",
            "nach": "naːx",
            "bei": "baɪ̯",
            "zu": "t͡suː",
            "an": "an",
            "ab": "ap",
            "um": "ʊm",
            "her": "heːɐ̯",
            "hin": "hɪn",
            "los": "loːs",
            "weg": "vɛk",
            "über": "yːbɐ",
            "unter": "ʊntɐ",
            "durch": "dʊʁç",
            "gegen": "ɡeːɡən",
            "voll": "fɔl",
            "wider": "viːdɐ",
            "hinter": "hɪntɐ",
            "dar": "daːɐ̯",
            "empor": "ɛmpoːɐ̯",
            "auseinander": "aʊ̯saɪ̯nandɐ",
        },
        "suffixIpa": {
            "ung": "ʊŋ",
            "ungen": "ʊŋən",
            "heit": "haɪ̯t",
            "heiten": "haɪ̯tən",
            "keit": "kaɪ̯t",
            "keiten": "kaɪ̯tən",
            "schaft": "ʃaft",
            "lich": "lɪç",
            "lichen": "lɪçən",
            "isch": "ɪʃ",
            "bar": "baːɐ̯",
            "sam": "zaːm",
            "los": "loːs",
            "haft": "haft",
            "nis": "nɪs",
            "tum": "tuːm",
            "chen": "çən",
            "lein": "laɪ̯n",
            "ig": "ɪç",
            "er": "ɐ",
            "en": "ən",
            "es": "əs",
            "em": "əm",
            "et": "ət",
            "st": "st",
            "e": "ə",
        },
        // Monomorphemic words where a leading ⟨ge⟩/⟨er⟩ is NOT a prefix, so the ⟨st⟩ stays alveolar st (gestern →
        // ɡɛstɐn, NOT the ge·stern → ʃt the sp/st-after-prefix rule would give). The trap: the "stem" is often a real
        // word (stern=star), so no structural test distinguishes these from real ge-/er- prefixing (ge·stein → ʃt).
        // Consulted by BOTH decompose (keep whole, don't strip ge-/er-) and the g2p (skip the st-sharpen branch).
        "stKeepWords": [
            "gestern", "gesterns", "geste", "gesten", "gestik", "gestisch", "gestapo",
            "erst", "erste", "ersten", "erster", "erstes", "erstem", "erstere", "ersteres",
            "erstens", "erstmal", "erstmals", "erstmalig", "erstmalige",
        ],
    },

    // Cardinal number words. Units precede tens, compounded (einundzwanzig); composition logic is in numbers.ts.
    "numbers": {
        "ones": [
            "null",
            "eins",
            "zwei",
            "drei",
            "vier",
            "fünf",
            "sechs",
            "sieben",
            "acht",
            "neun",
            "zehn",
            "elf",
            "zwölf",
            "dreizehn",
            "vierzehn",
            "fünfzehn",
            "sechzehn",
            "siebzehn",
            "achtzehn",
            "neunzehn",
        ],
        "tens": [
            "",
            "",
            "zwanzig",
            "dreißig",
            "vierzig",
            "fünfzig",
            "sechzig",
            "siebzig",
            "achtzig",
            "neunzig",
        ],
        "compoundOne": "ein",
        "connector": "und",
        "hundred": "hundert",
        "thousand": "tausend",
        "million": { "sg": "eine Million", "pl": "Millionen" },
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbols": {
        // ⚠ The tier spaces `und` on both sides, because `B&B` is two initialisms and joining them would make one
        // token.
        // ⚠ `multiply` is STANDARD MATHEMATICAL REGISTER, not a corpus attestation: a corpus sweep for the
        // operator returns homographs of PREPOSITIONS in every language tried. One word, so `by` defaults to it —
        // German does not split dimension from product.
        "multiply": { "times": "mal" },
        "ampersand": "und",
        "percent": ["Prozent"],
        "currency": { "€": ["Euro"], "$": ["Dollar"], "£": ["Pfund"], "¥": ["Yen"] },
        // `m` is declared because a digit-adjacent bare `m` in German is a metre (`4892 m Höhe`, `133 m/s`).
        // ⚠ Without it `Kubik`/`Quadrat` below cannot reach a bare metre, so `5 m³` reads as the raw letter while
        // `5 km³` reads correctly.
        // ⚠ ⟨g⟩ ⟨ha⟩ ⟨l⟩ ⟨L⟩ WERE NOT LEAKING, THEY WERE MIS-READING — the class `tools/normalization/misread.ts`
        // exists to see. `10 ha` read *t͡seːn haː*, which is a German interjection; `10 g` read as the letter.
        // Nothing in the tree could flag either, because neither the ASCII nor a DROP survives into the IPA.
        // Each word is definitional on de.wikipedia and each names its own symbol:
        //   Gramm  176/17  "Ein Gramm ist eine physikalische Einheit für die Masse, sein EINHEITENZEICHEN IST G"
        //   Hektar 356/20  "Das oder der Hektar … ist eine Maßeinheit der Fläche … in Deutschland, Österreich
        //                   und der Schweiz eine gesetzliche Einheit"
        //   Liter  468/18  "Der … Liter ist eine Einheit für das Volumen … mit \mathrm{L} symbolisiert"
        // ⚠ ⟨l⟩ AND ⟨L⟩ BOTH, the litre's documented exception to the one-letter rule (`resolveUnitSymbol`).
        // ⚠ THE ONE-LETTER KEYS MEASURED, not assumed (trap 46), and measured against the shape the tier will
        // actually build — a number, an optional MAGNITUDE, then the key. Over the artifact `<digit> g` is ×1
        // and it is `802.11g`, a Wi-Fi standard, which `NOT_VERSION` already rejects; `<digit> l` and
        // `<digit> L` are ×0. German's magnitudes are `Million(en)`/`Milliarde(n)` and none of them ends in a
        // unit letter, so the ligature trap that refused Tagalog's ⟨g⟩ does not arise here.
        "units": { "km": ["Kilometer"], "cm": ["Zentimeter"], "mm": ["Millimeter"], "kg": ["Kilogramm"], "mg": ["Milligramm"],
            "m": ["Meter"], "g": ["Gramm"], "ha": ["Hektar"], "l": ["Liter"], "L": ["Liter"] },
        // ⚠ AN UNDECLARED MEASURE WORD MAKES THE TIER ABANDON THE WHOLE MATCH, so `5 km²` reads as *fʏnf km* —
        // the abbreviation reaching the phoneme sink verbatim and the QUANTITY lost, not merely its power.
        // German FUSES the measure word onto the front, which is `compound`: *Quadratkilometer*, *Kubikmeter*.
        "exponentWords": { "squared": ["Quadrat"], "cubed": ["Kubik"], "position": "compound" },
        // BARE EXPONENT — the reading for a power with NO unit to modify (`20²`, `mc²`).
        // ⚠ THIS CANNOT REUSE `exponentWords` ABOVE: that is the unit MODIFIER and this is the PREDICATE, and in
        // most languages they are different words — Quadratkilometer, but zwanzig zum Quadrat.
        // ⚠ PROVENANCE, stated because it is weaker than most data in this repo: these are STANDARD MATHEMATICAL
        // REGISTER, not corpus attestations. The power words are ×0 in this language's artifact, and the apparent
        // hits for other languages were substring traps of exactly the kind tools/normalization/attest.ts warns
        // about — th `กำลัง` matched the progressive-aspect marker, fa `توان` and ar `أس` matched inside unrelated
        // words. FLEURS is news and encyclopedia prose and simply does not contain spoken arithmetic.
        // The cardinal is used for the generic power, never the ordinal — see core for that argument.
        "bareExponent": { "squared": "{n} zum Quadrat", "cubed": "{n} hoch drei", "power": "{n} hoch {e}" , "negative": "minus" },
        "magnitudes": ["Millionen", "Million", "Milliarden", "Milliarde"]
    }
}
