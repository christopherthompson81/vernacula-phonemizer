// Native canonical-IPA data manifest for Māori (mi) — te reo Māori, Eastern Polynesian, New Zealand (~185k).
// One of the simplest orthographies in the fleet: a near-1:1 phonemic map + the macron = LENGTH
// + two digraphs (⟨wh⟩→ɸ, ⟨ng⟩→ŋ). Strict CV syllables — no codas, no clusters, no glide formation. Stress
// (mora-based, unmarked) is not emitted. Engine: maori.ts.
{
    "language": "mi",
    "name": "Māori (te reo Māori)",
    "script": ["Latin"],

    // The two digraphs, scanned LONGEST-FIRST: ⟨wh⟩→[ɸ] (a bilabial fricative), ⟨ng⟩→[ŋ] (a velar nasal).
    "digraphs": { "wh": "ɸ", "ng": "ŋ" },

    // Single grapheme → canonical IPA. The 5 vowels + their MACRON (long) forms, and the 8 simple consonants
    // (⟨r⟩→[ɾ] tap). ⟨wh ng⟩ are the digraphs above; there is no ⟨g⟩ alone (only ⟨ng⟩).
    "graphemes": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "ā": "aː", "ē": "eː", "ī": "iː", "ō": "oː", "ū": "uː",
        "p": "p", "t": "t", "k": "k", "m": "m", "n": "n", "r": "ɾ", "h": "h", "w": "w"
    },

    // Cardinal numerals (composed by numbers.ts — see that file for the mā/kotahi rules and the source list). The
    // MODERN STANDARD tekau series (tekau mā tahi 11, rua tekau 20), not the older ngahuru decade forms. The KAHAKŌ
    // (macron) is phonemic length and load-bearing here: whā [ɸaː] 4, mā [maː] the additive particle.
    "numbers": {
        "zero": "kore",
        "units": ["", "tahi", "rua", "toru", "whā", "rima", "ono", "whitu", "waru", "iwa"],
        "ten": "tekau",
        "and": "mā",
        "one": "kotahi",
        "magnitudes": { "hundred": "rau", "thousand": "mano", "million": "miriona", "billion": "piriona" }
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbolTier": {
        "multiply": { "times": "whakarea" },
        "percent": ["ōrau"],
        // Prefixed forms are their own keys, longest-first: with only a bare `$`, `AUD$45` read its letters as a word
        // and dropped the sign. `NZ$` is declared because it is this language's own currency, not on frequency; the
        // other four do not depend on it.
        "currency": { "US$": ["tāra"], "AUD$": ["tāra"], "NZ$": ["tāra"], "$": ["tāra"], "£": ["pauna"] },
        // ⚠ A magnitude must be declared or the currency word lands INSIDE the number: without these, `$2.3 piriona`
        // read "rua . toru TĀRA piriona" — the sign is adjacent to the digits, so the word is emitted there and the
        // magnitude stranded behind it. Māori writes the magnitude first and takes no connective.
        "magnitudes": ["miriona", "piriona", "mano"],
        "units": {
            "km": ["kiromita"], "m": ["mita"], "m/h": ["maero ia hāora"],
            "mm": ["mirimita"], "ha": ["heketea"], "l": ["rita"], "L": ["rita"],
        },
        "unitPer": "ia",
        "rateDenominators": { "h": "hāora", "s": "hēkona" },
        "exponentWords": { "squared": ["pūrua"], "cubed": ["pūtoru"], "position": "after" }
    }
}
