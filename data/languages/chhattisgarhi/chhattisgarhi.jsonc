// Native canonical-IPA definition for CHHATTISGARHI (hne) — Eastern Indo-Aryan (Eastern-Hindi),
// Devanagari, read by the shared Hindi engine (src/languages/hindi/hindi.ts `makeNativeHindi`) and by
// its C# port. ⚠ THIS HEADER WAS THE HINDI TEMPLATE: its second line was an ORPHANED FRAGMENT
// ("standard Hindi phonology.") left behind when the first was rewritten, and it named
// src/Phonemize/native/nativeG2p.ts, a path that has never existed in this tree. The same stale
// header still sits on awadhi.jsonc, magahi.jsonc, maithili.jsonc, marathi.jsonc, nepali.jsonc and
// hindi.jsonc itself. A shallow abugida, so pronunciation is almost entirely rule-derivable; the one
// genuinely hard part is schwa deletion (a documented algorithm, not a lexicon).
//
// ⚠ WHAT THIS FILE DOES NOT DECLARE, IT INHERITS FROM hindi.jsonc. No `symbolTier`, no
// `ordinalSuffixes` and no `irregularOrdinals` are set here, so `makeNativeHindi` and normalize.ts
// fall back to Hindi's — every currency, unit, ordinal and clock word this language speaks is
// Hindi's, none of them Chhattisgarhi-sourced. That is deliberate (see `provenance`), not an
// oversight, but it is the reason `stripSymbols` does not do what its comment used to claim.
//
// Format: plain JSONC. Verbose, self-describing keys. Every phoneme value is CANONICAL IPA.
{
    "language": "hne",
    "name": "Chhattisgarhi (छत्तीसगढ़ी)",
    "script": ["Devanagari"],
    "provenance": "Authored from standard Chhattisgarhi phonology (Grierson LSI VI-ii; Chhattisgarhi is Eastern-Hindi, segmentally near-identical to Awadhi/Bhojpuri). Reuses the Hindi Devanagari engine. CORROBORATED against Hira Lal Kavyopadhyaya's 'A Grammar of the Chhattisgarhi Dialect of Eastern Hindi' (1921, rev. Grierson LSI) — its phoneme inventory + the attested UDHR Article-1 sample. This CONFIRMED श/ष→[s] (the inventory has no /ʃ/) but CORRECTED an initial error: ऐ/औ are MONOPHTHONGS [ɛː]/[ɔː] like Hindi (गौरव→[ɡɔrəʋ] in the sample), NOT the Bhojpuri-style diphthongs [ai]/[au]. ⚠ SCOPE OF 'SOLE': श/ष→[s] is the only LETTER that maps differently from Hindi, but this file diverges a second time by carrying NO finalRules at all, which drops Hindi's əɦə→ɛɦɛ lowering (शहर→[sˈəɦəɾ], not [ʃˈɛɦɛɾ], pinned in test/chhattisgarhi.test.ts) and its अय→ɛj and ɪ-offglide conventions; and by not carrying Hindi's ज्ञ→ɡj postRule (ज्ञान→[d͡ʒɲˈaːn], not [ɡjˈaːn]). A further documented feature (reduced schwa deletion — लोगन→[loɡən], बरोबरी→[bərobəri]) is noted but not modelled (needs more data). CANNOT-VERIFY: no phonetic corpus / independent referee exists — the anchor is the distinctive-feature gold, corroborated by the 1921 grammar.",

    // The vowel inserted after a consonant that has no explicit vowel sign and no virama (the abugida
    // 'inherent vowel'). Hindi's is the schwa /ə/. Its deletion (below) is the one non-trivial rule.
    "inherentVowel": "ə",

    // Consonant letters → canonical IPA. `note` documents the phonological class + any referee decision.
    "consonants": {
        "क": { "ipa": "k", "note": "velar stop, voiceless" },
        "ख": { "ipa": "kʰ", "note": "velar stop, voiceless aspirated" },
        "ग": { "ipa": "ɡ", "note": "velar stop, voiced" },
        "घ": { "ipa": "ɡʱ", "note": "velar stop, voiced breathy" },
        "ङ": { "ipa": "ŋ", "note": "velar nasal" },
        "च": {
            "ipa": "t͡ʃ",
            "note": "post-alveolar affricate, voiceless (Hindi च = t͡ʃ, cf. Bengali t͡ɕ)",
        },
        "छ": {
            "ipa": "t͡ʃʰ",
            "note": "post-alveolar affricate, voiceless aspirated",
        },
        "ज": { "ipa": "d͡ʒ", "note": "post-alveolar affricate, voiced" },
        "झ": {
            "ipa": "d͡ʒʱ",
            "note": "post-alveolar affricate, voiced breathy",
        },
        "ञ": { "ipa": "ɲ", "note": "palatal nasal" },
        "ट": { "ipa": "ʈ", "note": "retroflex stop, voiceless" },
        "ठ": { "ipa": "ʈʰ", "note": "retroflex stop, voiceless aspirated" },
        "ड": { "ipa": "ɖ", "note": "retroflex stop, voiced" },
        "ढ": { "ipa": "ɖʱ", "note": "retroflex stop, voiced breathy" },
        "ण": { "ipa": "ɳ", "note": "retroflex nasal" },
        "त": {
            "ipa": "t̪",
            "note": "DENTAL stop, voiceless (t̪ vs retroflex ट=ʈ — the core coronal contrast)",
        },
        "थ": { "ipa": "t̪ʰ", "note": "dental stop, voiceless aspirated" },
        "द": { "ipa": "d̪", "note": "dental stop, voiced" },
        "ध": { "ipa": "d̪ʱ", "note": "dental stop, voiced breathy" },
        "न": { "ipa": "n", "note": "dental/alveolar nasal" },
        "प": { "ipa": "p", "note": "labial stop, voiceless" },
        "फ": { "ipa": "pʰ", "note": "labial stop, voiceless aspirated" },
        "ब": { "ipa": "b", "note": "labial stop, voiced" },
        "भ": { "ipa": "bʱ", "note": "labial stop, voiced breathy" },
        "म": { "ipa": "m", "note": "labial nasal" },
        "य": { "ipa": "j", "note": "palatal approximant" },
        "र": { "ipa": "ɾ", "note": "alveolar tap" },
        "ल": { "ipa": "l", "note": "alveolar lateral" },
        "व": { "ipa": "ʋ", "note": "labiodental approximant" },
        "श": { "ipa": "s", "note": "Chhattisgarhi merges श → [s] (no /ʃ/) — शहर→sahar (vs Hindi ʃ); shared Eastern-Hindi feature" },
        "ष": { "ipa": "s", "note": "Chhattisgarhi ष → [s] (no /ʃ/ or /ʂ/)" },
        "स": { "ipa": "s", "note": "alveolar sibilant" },
        "ह": { "ipa": "ɦ", "note": "voiced glottal fricative (Hindi ह = ɦ)" },
        "ळ": {
            "ipa": "ɭ",
            "note": "retroflex lateral (rare, mainly loans/Marathi)",
        },
        // Nukta letters (borrowed/Perso-Arabic sounds)
        "क़": { "ipa": "q", "note": "uvular stop (nukta क)" },
        "ख़": { "ipa": "x", "note": "velar fricative voiceless (nukta ख)" },
        "ग़": { "ipa": "ɣ", "note": "velar fricative voiced (nukta ग)" },
        "ज़": { "ipa": "z", "note": "alveolar sibilant voiced (nukta ज)" },
        "ड़": { "ipa": "ɽ", "note": "retroflex flap (nukta ड)" },
        "ढ़": { "ipa": "ɽʱ", "note": "retroflex flap breathy (nukta ढ)" },
        "फ़": { "ipa": "f", "note": "labiodental fricative (nukta फ)" },
        "य़": { "ipa": "j", "note": "ya with nukta" },
    },

    // Independent vowel letters (word-initial / standalone).
    "independentVowels": {
        "अ": { "ipa": "ə", "note": "short central (schwa)" },
        "आ": { "ipa": "aː", "note": "long open" },
        "इ": { "ipa": "ɪ", "note": "short near-close front" },
        "ई": { "ipa": "iː", "note": "long close front" },
        "उ": { "ipa": "ʊ", "note": "short near-close back" },
        "ऊ": { "ipa": "uː", "note": "long close back" },
        "ऋ": {
            "ipa": "ɾɪ",
            "note": "vocalic r (Sanskrit; realized ɾɪ in Hindi)",
        },
        "ए": { "ipa": "eː", "note": "long close-mid front" },
        "ऐ": { "ipa": "ɛː", "note": "Chhattisgarhi ऐ → [ɛː] (monophthong, as Hindi) — CORROBORATED by the grammar's vowel inventory + गौरव→ɡɔrəʋ in the attested UDHR sample; the earlier [ai] was a wrong Bhojpuri copy" },
        "ओ": { "ipa": "oː", "note": "long close-mid back" },
        "औ": { "ipa": "ɔː", "note": "Chhattisgarhi औ → [ɔː] (monophthong, as Hindi) — CORROBORATED by गौरव→[ɡɔrəʋ] in the attested UDHR sample; the earlier [au] was a wrong Bhojpuri copy" },
        "ऍ": { "ipa": "ɛː", "note": "candra e (loans)" },
        "ऑ": { "ipa": "ɔː", "note": "candra o (loans, e.g. English 'o')" },
        "ॐ": { "ipa": "õːm", "note": "Om sign (U+0950) — a whole syllable" },
    },

    // Dependent vowel signs (matras) — replace the inherent vowel on the preceding consonant.
    "vowelSigns": {
        "ा": { "ipa": "aː" },
        "ि": { "ipa": "ɪ" },
        "ी": { "ipa": "iː" },
        "ु": { "ipa": "ʊ" },
        "ू": { "ipa": "uː" },
        "ृ": { "ipa": "ɾɪ" },
        "े": { "ipa": "eː" },
        "ै": { "ipa": "ɛː" },
        "ो": { "ipa": "oː" },
        "ौ": { "ipa": "ɔː" },
        "ॅ": { "ipa": "ɛː" },
        "ॉ": { "ipa": "ɔː" },
    },

    // Combining signs with special effects.
    "signs": {
        "virama": {
            "char": "्",
            "effect": "suppressInherentVowel",
            "note": "halant — the consonant carries no vowel (forms clusters/conjuncts)",
        },
        "anusvara": {
            "char": "ं",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel (canonical Hindi + wikipron: कांग्रेस→kãɡɾeːs, not a homorganic nasal consonant). Nasal vowels are short.",
        },
        "chandrabindu": {
            "char": "ँ",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel",
        },
        "visarga": { "char": "ः", "effect": "appendH", "note": "→ [h]" },
        "nukta": {
            "char": "़",
            "effect": "composeNukta",
            "note": "combines with the preceding consonant (decomposed form) into the nukta letter",
        },
    },

    // Schwa deletion — the one hard rule. Hindi deletes the inherent schwa word-finally (except
    // monosyllables) and medially in a VCəCV context (Ohala 1983), applied right-to-left after the
    // final deletion. The engine implements this; parameters are declared here for transparency.
    "schwaDeletion": {
        "deleteWordFinal": true,
        "retainInMonosyllable": true,
        "medialRule": "ohala-VCaCV",
        "note": "Final-first, then medial VCəCV → VCCV right-to-left. भारत → bʱaːɾət̪ (medial ə RETAINED because the following त̪ is word-final, no CV context).",
    },

    // Post-rules applied to the raw akshara IPA (declarative, ordered regex — portable). Geminate→length
    // is the fleet-wide Indic convention. ⚠ THIS COMMENT USED TO CREDIT "the offglide + अय→ɛ", which are
    // hindi.jsonc's `finalRules` and are NOT in this file at all (`finalRules` is empty — see below).
    // ⚠ ALSO ABSENT: Hindi's ज्ञ → ɡj rule, so ज्ञान reads [d͡ʒɲˈaːn] here where hi reads [ɡjˈaːn]. That
    // omission is DELIBERATE UPSTREAM — hindi.jsonc's own note scopes the rule to Hindi and says the
    // Eastern-Hindi siblings "likely pattern with Hindi but have no corpus evidence here" — but no such
    // evidence exists for Chhattisgarhi either (this repo holds no hne text at all), so the literal
    // reading stands unrefereed rather than endorsed. FILED, NOT FIXED.
    "postRules": [
        {
            "from": "((?:t͡ʃʰ|d͡ʒʱ|t͡ʃ|d͡ʒ|t̪ʰ|d̪ʱ|[kɡptbmnlʃsɳŋɽ]ʰ?ʱ?|t̪|d̪))\\1(?!͡)",
            "to": "$1ː",
            "note": "geminate → single + length (क्क→kː, च्च→t͡ʃː)",
        },
        {
            "from": "ː([ʰʱ])",
            "to": "$1ː",
            "note": "aspiration-before-length reorder: differing-aspiration conjunct द्ध→d̪ːʱ→d̪ʱː (fleet convention, matches bn/si); avoids stranding ʰ/ʱ after the length mark (युद्ध बुद्ध अच्छा पत्थर)",
        },
    ],
    // Final conventions applied AFTER schwa deletion.
    "finalRules": [],
    // No Hindi-style finalRules: Chhattisgarhi keeps intervocalic əɦə (शहर→sahar, not the Hindi ɛɦɛ) and has no
    // ɪ-offglide / अय→ɛj convention. ⚠ THIS IS A SECOND SEGMENTAL DIVERGENCE FROM HINDI, so `provenance`'s
    // "SOLE confident divergence" is scoped to the GRAPHEME TABLES only: श/ष→[s] is the only letter that
    // maps differently, but dropping all three of Hindi's finalRules moves शहर, जहर and समय too — and
    // test/chhattisgarhi.test.ts pins शहर→[sˈəɦəɾ] against Hindi's [ʃˈɛɦɛɾ] on exactly that basis.
    // ⚠ This line used to call the first rule the "और-offglide". hindi.jsonc's own note reads "और
    // i-offglide before a vowel", where और is just the Hindi word "and" — the rule is ɪ → ɪʲ before a
    // vowel and has nothing to do with और.

    // NUMBERS — authored Devanagari SPELLINGS (public-fact numerals); the canonical IPA is DERIVED by
    // running these through the same native G2P (no hand-written phonemes). The
    // compositor (src/core/numbers.ts `indicNumberWords`) assembles them with Indian lakh/crore grouping.
    // NOTE: Hindi-belt 21-99 are IRREGULAR (not compositional — इक्कीस ≠ इक+बीस); all 80 compound spellings
    // (21-99) + the round tens + 0-20 + magnitudes are present below (the Hindi set, shared by Eastern-Hindi).
    "numbers": {
        "units": [
            "शून्य",
            "एक",
            "दो",
            "तीन",
            "चार",
            "पाँच",
            "छह",
            "सात",
            "आठ",
            "नौ",
        ],
        "teens": [
            "दस",
            "ग्यारह",
            "बारह",
            "तेरह",
            "चौदह",
            "पंद्रह",
            "सोलह",
            "सत्रह",
            "अठारह",
            "उन्नीस",
        ],
        "tens": {
            "20": "बीस",
            "30": "तीस",
            "40": "चालीस",
            "50": "पचास",
            "60": "साठ",
            "70": "सत्तर",
            "80": "अस्सी",
            "90": "नब्बे",
        },
        "compound": {
            "21": "इक्कीस",
            "22": "बाईस",
            "23": "तेईस",
            "24": "चौबीस",
            "25": "पच्चीस",
            "26": "छब्बीस",
            "27": "सत्ताईस",
            "28": "अट्ठाईस",
            "29": "उनतीस",
            "31": "इकतीस",
            "32": "बत्तीस",
            "33": "तैंतीस",
            "34": "चौंतीस",
            "35": "पैंतीस",
            "36": "छत्तीस",
            "37": "सैंतीस",
            "38": "अड़तीस",
            "39": "उनतालीस",
            "41": "इकतालीस",
            "42": "बयालीस",
            "43": "तैंतालीस",
            "44": "चवालीस",
            "45": "पैंतालीस",
            "46": "छियालीस",
            "47": "सैंतालीस",
            "48": "अड़तालीस",
            "49": "उनचास",
            "51": "इक्यावन",
            "52": "बावन",
            "53": "तिरेपन",
            "54": "चौवन",
            "55": "पचपन",
            "56": "छप्पन",
            "57": "सत्तावन",
            "58": "अट्ठावन",
            "59": "उनसठ",
            "61": "इकसठ",
            "62": "बासठ",
            "63": "तिरेसठ",
            "64": "चौंसठ",
            "65": "पैंसठ",
            "66": "छियासठ",
            "67": "सड़सठ",
            "68": "अड़सठ",
            "69": "उनहत्तर",
            "71": "इकहत्तर",
            "72": "बहत्तर",
            "73": "तिहत्तर",
            "74": "चौहत्तर",
            "75": "पचहत्तर",
            "76": "छिहत्तर",
            "77": "सतहत्तर",
            "78": "अठहत्तर",
            "79": "उनासी",
            "81": "इक्यासी",
            "82": "बयासी",
            "83": "तिरासी",
            "84": "चौरासी",
            "85": "पचासी",
            "86": "छियासी",
            "87": "सत्तासी",
            "88": "अट्ठासी",
            "89": "नवासी",
            "91": "इक्यानवे",
            "92": "बानवे",
            "93": "तिरानवे",
            "94": "चौरानवे",
            "95": "पंचानवे",
            "96": "छियानवे",
            "97": "सत्तानवे",
            "98": "अट्ठानवे",
            "99": "निन्यानवे",
        },
        "magnitudes": {
            "hundred": "सौ",
            "thousand": "हज़ार",
            "lakh": "लाख",
            "crore": "करोड़",
        },
        "grouping": "indian-lakh-crore",
        "decimalWord": "दशमलव",
    },

    // Symbol → spoken word (read AFTER the preceding number in reading order: 50% → पचास प्रतिशत).
    // ⚠ `stripSymbols` DOES NOT MAKE ₹ SILENT, and this comment used to claim it did (and then trailed
    // off mid-sentence). The shared symbol tier this file inherits from hindi.jsonc runs BEFORE the
    // engine's own `symbols`/`stripSymbols`, so ₹ is already spoken by the time the strip would apply:
    // measured, ₹500 → [pˈaː̃t͡ʃ sˈɔː ɾˈʊpjeː] (Hindi's रुपये), not the bare number. Same shape as the
    // claim retracted in bhojpuri.jsonc.
    "symbols": { "%": "प्रतिशत" },
    "stripSymbols": "₹",

    // Clause / phrase punctuation → canonical inline pause marks (Devanagari danda ।/॥ + ASCII).
    "clausePunctuation": {
        "।": ".",
        "॥": ".",
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Nasalization does NOT change vowel length: the WikiPron hin_deva narrow referee keeps nasal vowels
    // long (नहीं→nɐɦĩː, कांग्रेस→kãːŋ, यहाँ→jɐɦãː, गांव→ɡãː), so a long vowel + anusvara/chandrabindu stays
    // long (kaː̃) and a short one stays short (गंगा→ɡə̃ŋ). Setting this false keeps the length mark.
    "nasalVowelsAreShort": false,
}
