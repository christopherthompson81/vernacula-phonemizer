// Native canonical-IPA definition for Nepali (ne) — Indo-Aryan, Devanagari. Reuses the Hindi Devanagari
// ENGINE (`makeNativeHindi`, src/languages/hindi/hindi.ts) but NOT Hindi's phoneme values: see
// `provenance` for the six divergences. This file IS the language data — the engine reads it directly.
// Devanagari is a shallow abugida, so pronunciation is almost entirely rule-derivable; the only
// genuinely hard part is schwa deletion (handled by a documented algorithm, not a lexicon).
//
// Format: plain JSONC. Verbose, self-describing keys. Every phoneme value is CANONICAL IPA.
{
    "language": "ne",
    "name": "Nepali",
    "script": ["Devanagari"],
    "provenance": "Authored from the Devanagari chart + standard Nepali phonology; cross-checked vs wikipron nep_deva narrow + kaikki. Reuses the Hindi Devanagari engine (makeNativeHindi) with the Nepali divergences: inherent vowel अ→[ʌ] (not Hindi ə), DENTAL affricates च/छ/ज/झ→[t͡s t͡sʰ d͡z d͡zʱ] (not palatal), sibilant merger श/ष→[s], NO phonemic vowel length (ई→i, ऊ→u), diphthongs ऐ→[ʌi]/औ→[ʌu], व→[w].",

    // The vowel inserted after a consonant that has no explicit vowel sign and no virama (the abugida
    // 'inherent vowel'). Hindi's is the schwa /ə/. Its deletion (below) is the one non-trivial rule.
    "inherentVowel": "ə",

    // Consonant letters → canonical IPA. `note` documents the phonological class + any referee decision.
    "consonants": {
        "क": { "ipa": "k", "note": "velar stop, voiceless" },
        "ख": { "ipa": "kʰ", "note": "velar stop, voiceless aspirated" },
        "ग": { "ipa": "ɡ", "note": "velar stop, voiced" },
        "घ": { "ipa": "ɡʱ", "note": "velar stop, voiced breathy" },
        "ङ": { "ipa": "ŋ", "note": "velar nasal" },
        "च": { "ipa": "t͡s", "note": "Nepali DENTAL affricate [t͡s] (not Hindi palatal t͡ʃ)" },
        "छ": { "ipa": "t͡sʰ", "note": "dental affricate, aspirated" },
        "ज": { "ipa": "d͡z", "note": "dental affricate, voiced ([d͡z]~[z])" },
        "झ": { "ipa": "d͡zʱ", "note": "dental affricate, voiced breathy" },
        "ञ": { "ipa": "ɲ", "note": "palatal nasal" },
        "ट": { "ipa": "ʈ", "note": "retroflex stop, voiceless" },
        "ठ": { "ipa": "ʈʰ", "note": "retroflex stop, voiceless aspirated" },
        "ड": { "ipa": "ɖ", "note": "retroflex stop, voiced" },
        "ढ": { "ipa": "ɖʱ", "note": "retroflex stop, voiced breathy" },
        "ण": { "ipa": "ɳ", "note": "retroflex nasal" },
        "त": {
            "ipa": "t̪",
            "note": "DENTAL stop, voiceless (t̪ vs retroflex ट=ʈ — the core coronal contrast)",
        },
        "थ": { "ipa": "t̪ʰ", "note": "dental stop, voiceless aspirated" },
        "द": { "ipa": "d̪", "note": "dental stop, voiced" },
        "ध": { "ipa": "d̪ʱ", "note": "dental stop, voiced breathy" },
        "न": { "ipa": "n", "note": "dental/alveolar nasal" },
        "प": { "ipa": "p", "note": "labial stop, voiceless" },
        "फ": { "ipa": "pʰ", "note": "labial stop, voiceless aspirated" },
        "ब": { "ipa": "b", "note": "labial stop, voiced" },
        "भ": { "ipa": "bʱ", "note": "labial stop, voiced breathy" },
        "म": { "ipa": "m", "note": "labial nasal" },
        "य": { "ipa": "j", "note": "palatal approximant" },
        "र": { "ipa": "ɾ", "note": "alveolar tap" },
        "ल": { "ipa": "l", "note": "alveolar lateral" },
        "व": { "ipa": "w", "note": "Nepali व → [w] (~[b] word-initially)" },
        "श": { "ipa": "s", "note": "Nepali merges श → [s] (no /ʃ/)" },
        "ष": { "ipa": "s", "note": "Nepali ष → [s]" },
        "स": { "ipa": "s", "note": "alveolar sibilant" },
        "ह": { "ipa": "ɦ", "note": "voiced glottal fricative (Hindi ह = ɦ)" },
        "ळ": {
            "ipa": "ɭ",
            "note": "retroflex lateral (rare, mainly loans/Marathi)",
        },
        // Nukta letters (borrowed/Perso-Arabic sounds)
        "क़": { "ipa": "q", "note": "uvular stop (nukta क)" },
        "ख़": { "ipa": "x", "note": "velar fricative voiceless (nukta ख)" },
        "ग़": { "ipa": "ɣ", "note": "velar fricative voiced (nukta ग)" },
        "ज़": { "ipa": "z", "note": "alveolar sibilant voiced (nukta ज)" },
        "ड़": { "ipa": "ɽ", "note": "retroflex flap (nukta ड)" },
        "ढ़": { "ipa": "ɽʱ", "note": "retroflex flap breathy (nukta ढ)" },
        "फ़": { "ipa": "f", "note": "labiodental fricative (nukta फ)" },
        "य़": { "ipa": "j", "note": "ya with nukta" },
    },

    // Independent vowel letters (word-initial / standalone).
    "independentVowels": {
        "अ": { "ipa": "ə", "note": "short central (schwa)" },
        "आ": { "ipa": "a", "note": "open central [ä] (no length in Nepali)" },
        "इ": { "ipa": "i", "note": "Nepali इ = [i] (no lax allophone)" },
        "ई": { "ipa": "i", "note": "no phonemic length" },
        "उ": { "ipa": "u", "note": "Nepali उ = [u]" },
        "ऊ": { "ipa": "u", "note": "no phonemic length" },
        "ऋ": {
            "ipa": "ɾɪ",
            "note": "vocalic r (Sanskrit); Nepali realizes it ɾɪ, as the whole Devanagari fleet does — कृष्ण → kɾˈɪsɳʌ",
        },
        "ए": { "ipa": "e" },
        "ऐ": { "ipa": "ʌi", "note": "diphthong (ʌ+i offglide)" },
        "ओ": { "ipa": "o" },
        "औ": { "ipa": "ʌu", "note": "diphthong (ʌ+u offglide)" },
        "ऍ": { "ipa": "ɛː", "note": "candra e (loans)" },
        "ऑ": { "ipa": "ɔː", "note": "candra o (loans, e.g. English 'o')" },
        "ॐ": { "ipa": "õːm", "note": "Om sign (U+0950) — a whole syllable" },
    },

    // Dependent vowel signs (matras) — replace the inherent vowel on the preceding consonant.
    "vowelSigns": {
        "ा": { "ipa": "a" },
        "ि": { "ipa": "i" },
        "ी": { "ipa": "i" },
        "ु": { "ipa": "u" },
        "ू": { "ipa": "u" },
        "ृ": { "ipa": "ɾɪ" },
        "े": { "ipa": "e" },
        "ै": { "ipa": "ʌi" },
        "ो": { "ipa": "o" },
        "ौ": { "ipa": "ʌu" },
        "ॅ": { "ipa": "ɛː" },
        "ॉ": { "ipa": "ɔː" },
    },

    // Combining signs with special effects.
    "signs": {
        "virama": {
            "char": "्",
            "effect": "suppressInherentVowel",
            "note": "halant — the consonant carries no vowel (forms clusters/conjuncts)",
        },
        "anusvara": {
            "char": "ं",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel rather than becoming a homorganic nasal consonant — कांग्रेस → kˈãŋɡɾes (⚠ the Nepali reading: no vowel length, unlike Hindi's kãɡɾeːs), अंश → ˈʌ̃s. Length is governed by `nasalVowelsAreShort` below, NOT here.",
        },
        "chandrabindu": {
            "char": "ँ",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel",
        },
        "visarga": { "char": "ः", "effect": "appendH", "note": "→ [h]" },
        "nukta": {
            "char": "़",
            "effect": "composeNukta",
            "note": "combines with the preceding consonant (decomposed form) into the nukta letter",
        },
    },

    // Schwa deletion — the one hard rule. Hindi deletes the inherent schwa word-finally (except
    // monosyllables) and medially in a VCəCV context (Ohala 1983), applied right-to-left after the
    // final deletion. The engine implements this; parameters are declared here for transparency.
    "schwaDeletion": {
        "deleteWordFinal": true,
        "retainInMonosyllable": true,
        "retainFinalAfterCluster": true,
        "medialRule": "ohala-VCaCV",
        "note": "Final-first (but RETAINED after a word-final cluster/geminate — the Marathi rule Nepali shares: एकाउन्न → ˈekaunːʌ), then medial VCəCV → VCCV right-to-left.",
    },

    // Post-rules applied to the raw akshara IPA (declarative, ordered regex — portable). Geminate→length
    // is the fleet-wide Indic convention; the offglide + अय→ɛ are systematic Hindi realizations.
    "postRules": [
        {
            "from": "d͡zɲ",
            "to": "ɡj",
            "note": "⚠ ज्ञ IS NOT ITS PARTS. Composing ज (d͡z, dental in Nepali) + ् + ञ (ɲ) literally gives d͡zɲ, which is not what Nepali says — it is /ɡj/, patterning with Hindi rather than with Marathi's *dnya*. hindi.jsonc's rule scoped itself deliberately (\"SCOPED TO HINDI DELIBERATELY … Awadhi/Bhojpuri/Magahi likely pattern with Hindi but have no corpus evidence here\") and simply does not mention Nepali either way, so this was never decided — it was never considered. MEASURED against wikipron nep_deva narrow (human), which is unambiguous on all 4 of its ज्ञ rows: ज्ञ `ɡ j`, ज्ञान `ɡ j ä n`, विज्ञान and बिज्ञान `b i ɡ̞ j ä n`. Primary referee 68.914% → 69.000%. 13 golden rows move. ⚠ The ɡ is written PLAIN even though the referee lowers it (ɡ̞) in the two विज्ञान rows: that is an intervocalic-lenition detail the referee notates narrowly and this manifest does not model anywhere else, and inventing a lenition rule for one ligature would be a wider claim than the evidence supports.",
        },
        {
            "from": "((?:t͡sʰ|d͡zʱ|t͡s|d͡z|t͡ʃʰ|d͡ʒʱ|t͡ʃ|d͡ʒ|t̪ʰ|d̪ʱ|[kɡptbmnlʃsɳŋɽ]ʰ?ʱ?|t̪|d̪))\\1(?!͡)",
            "to": "$1ː",
            "note": "geminate → single + length (क्क→kː, त्त→t̪ː, द्द→d̪ː, न्न→nː, च्च→t͡sː, ज्ज→d͡zː). ⚠ THE DENTAL AFFRICATES ARE NAMED FIRST AND THEY WERE MISSING. This alternation was inherited from hindi.jsonc, which names the PALATAL affricates t͡ʃ/t͡ʃʰ/d͡ʒ/d͡ʒʱ — none of which this file's `consonants` can produce, since Nepali's च/छ/ज/झ are the DENTAL t͡s/t͡sʰ/d͡z/d͡zʱ. So four arms were dead by inheritance rather than by decision, and the affricates were the ONLY geminates in the language that did not collapse: मक्का mˈʌkːa and सत्तरी sˈʌt̪ːʌɾi beside बच्चा bˈʌt͡st͡sa and लज्जा lˈʌd͡zd͡za. 113 of the 1,993 unique ne_np FLEURS utterances carried an uncollapsed one (t͡st͡s ×107, d͡zd͡z ×6) and 22 of the 200 parity-golden rows. ⚠ THE EARLIER DEFERRAL SAID \"no wikipron nep_deva referee is present in this repo\" — it is, at tools/referee-eval/referees/ne.wikipron-deva.tsv, and it settles the COLLAPSE: the primary score moves 69.000% → 69.128% (+3 words), and every candidate shape beats leaving the geminate doubled. ⚠ IT DOES NOT SETTLE THE SHAPE, and the shape chosen here is internal consistency, not measurement. Length was picked because every other geminate in this manifest is written that way. The eval cannot distinguish the alternatives — its geminate-notation fold `(.)\\1+ → $1` plus the backbone\u0027s length/unreleased stripping collapse t͡sː, tt͡s and t̚t͡s to one string, and all three score the identical 69.128%. ⚠ AND THE REFEREE\u0027S RAW NOTATION POINTS SOMEWHERE ELSE: its two च्च rows are पच्चीस `p ʌ t̚ t͡s i s` and बच्चा `b ʌ t̚ t͡s ä` — an unreleased ALVEOLAR stop plus the affricate, distinct from its dental t̪̚ for त्त — which is stop+affricate, not length. Two rows, and the four ज्ज rows are internally inconsistent (`d z d͡z` twice, `z d͡z` twice, i.e. the same word transcribed with and without the tie bar). Too thin to introduce an alveolar stop this inventory does not otherwise model, but recorded so the next reader with a wider referee knows exactly which question is open.",
        },
        {
            "from": "ː([ʰʱ])",
            "to": "$1ː",
            "note": "aspiration-before-length reorder: differing-aspiration conjunct द्ध→d̪ːʱ→d̪ʱː (fleet convention, matches bn/si); avoids stranding ʰ/ʱ after the length mark — युद्ध→jˈud̪ʱːʌ, बुद्ध→bˈud̪ʱːʌ, पत्थर→pˈʌt̪ʰːʌɾ. ⚠ अच्छा is NOT one of them in Nepali (it reads ˈʌt͡st͡sʰa, no length mark at all): rule 1 above never fires on the dental affricates, so this rule has nothing to reorder there. See that rule's note.",
        },
    ],
    // Final conventions applied AFTER schwa deletion.
    "finalRules": [],
    // No Hindi-style finalRules: Nepali keeps the intervocalic schwa (शहर→sahar, not the Hindi ɛɦɛ) and has no
    // और-offglide / अय→ɛj convention.

    // NUMBERS — authored Devanagari SPELLINGS (public-fact numerals); the canonical IPA is DERIVED by
    // running these through the same native G2P (no hand-written phonemes).
    "numbers": {
        "units": ["शून्य", "एक", "दुई", "तीन", "चार", "पाँच", "छ", "सात", "आठ", "नौ"],
        "teens": ["दश", "एघार", "बाह्र", "तेह्र", "चौध", "पन्ध्र", "सोह्र", "सत्र", "अठार", "उन्नाइस"],
        "tens": { "20": "बीस", "30": "तीस", "40": "चालीस", "50": "पचास", "60": "साठी", "70": "सत्तरी", "80": "असी", "90": "नब्बे" },
        "compound": {
            "21": "एक्काइस", "22": "बाईस", "23": "तेईस", "24": "चौबीस", "25": "पच्चीस",
            "26": "छब्बीस", "27": "सत्ताईस", "28": "अट्ठाईस", "29": "उनन्तीस",
            "31": "एकत्तीस", "32": "बत्तीस", "33": "तेत्तीस", "34": "चौंतीस", "35": "पैंतीस",
            "36": "छत्तीस", "37": "सैंतीस", "38": "अठतीस", "39": "उनन्चालीस",
            "41": "एकचालीस", "42": "बयालीस", "43": "त्रिचालीस", "44": "चवालीस", "45": "पैंतालीस",
            "46": "छयालीस", "47": "सतचालीस", "48": "अठचालीस", "49": "उनन्चास",
            "51": "एकाउन्न", "52": "बाउन्न", "53": "त्रिपन्न", "54": "चौवन्न", "55": "पचपन्न",
            "56": "छपन्न", "57": "सन्ताउन्न", "58": "अन्ठाउन्न", "59": "उनन्साठी",
            "61": "एकसठ्ठी", "62": "बैसठ्ठी", "63": "त्रिसट्ठी", "64": "चौसठ्ठी", "65": "पैंसठ्ठी",
            "66": "छैंसठ्ठी", "67": "सतसट्ठी", "68": "अठसट्ठी", "69": "उनन्सत्तरी",
            "71": "एकहत्तर", "72": "बहत्तर", "73": "तिरत्तर", "74": "चौहत्तर", "75": "पचहत्तर",
            "76": "छहत्तर", "77": "सतहत्तर", "78": "अठहत्तर", "79": "उनासी",
            "81": "एकासी", "82": "बयासी", "83": "त्रियासी", "84": "चौरासी", "85": "पचासी",
            "86": "छयासी", "87": "सतासी", "88": "अठासी", "89": "उनानब्बे",
            "91": "एकानब्बे", "92": "बयानब्बे", "93": "त्रियानब्बे", "94": "चौरानब्बे",
            "95": "पन्चानब्बे", "96": "छयानब्बे", "97": "सन्तानब्बे", "98": "अन्ठानब्बे",
            "99": "उनान्सय",
        },
        "magnitudes": { "hundred": "सय", "thousand": "हजार", "lakh": "लाख", "crore": "करोड" },
        "grouping": "indian-lakh-crore",
        "decimalWord": "दशमलव",
    },

    // Symbol → spoken word (read AFTER the preceding number in reading order: 50% → पचास प्रतिशत). Symbols
    // in `stripSymbols` are dropped so a currency amount reads as the bare number — ₹500 → पाँच सय
    // [pˈãt͡s sˈʌj], with Nepali's सय, NOT Hindi's सौ. ⚠ ₹ is dropped rather than spoken ON PURPOSE: it does
    // not occur in the ne_np corpus and no ne referee in this repo spells the noun, so the sign keeps
    // falling through instead of being given a confidently-wrong word (normalize.ts's CURRENCY note).
    "symbols": { "%": "प्रतिशत" },
    "stripSymbols": "₹",

    // Clause / phrase punctuation → canonical inline pause marks (Devanagari danda ।/॥ + ASCII).
    "clausePunctuation": {
        "।": ".",
        "॥": ".",
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Nasalization does NOT shorten the vowel it sits on — `false` keeps whatever length mark the vowel
    // already carried. ⚠ THE SETTING IS INHERITED FROM HINDI, WHERE IT IS LOAD-BEARING (the WikiPron
    // hin_deva narrow referee keeps nasal vowels long: नहीं→nɐɦĩː, यहाँ→jɐɦãː) AND HERE IT IS VACUOUS:
    // Nepali has NO phonemic vowel length, so no `vowelSigns` or `independentVowels` entry an anusvara can
    // follow carries a ː in the first place (नहीं→nˈʌɦĩ, यहाँ→jˈʌɦã, गंगा→ɡˈʌ̃ŋɡa). The two candidates that
    // DO carry one, ऍ/ॅ→ɛː and ऑ/ॉ→ɔː, are loan vowels. Kept explicit rather than dropped so the value is
    // a recorded decision and not a silent default.
    "nasalVowelsAreShort": false,
}
