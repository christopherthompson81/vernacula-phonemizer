// Native canonical-IPA data manifest for Shan / Tai Long (shn) — လိၵ်ႈတႆး, Southwestern Tai (Tai-Kadai),
// ~3.3M (Shan State, Myanmar), the SHAN ABUGIDA (a Myanmar-script variant, Unicode U+1000–U+109F incl. the
// Shan letters U+1075–U+108F), TONAL. The engine (shan.ts) is a per-syllable scan (the Burmese template) —
// onset consonant → medials (ွ/ႂ→w, ျ palatalises) → the RIME (vowel signs × coda) → the TONE. Unlike
// Burmese, Shan tone is LEXICAL and marked with EXPLICIT diacritics (unmarked→˨˦, ႇ→˩, ႈ→˧˧˨, visarga
// း→˥, ႉ→˦˨), so the tone is a direct lookup. Words are space-separated (no DAG segmentation needed).
// The rime resolver (vowel-sign combos × medial-w × coda) is code, in shan.ts; the letter values, tone
// marks and number words live here. THIN human single-source (wikipron, 2607).
{
    "language": "shn",
    "name": "Shan (လိၵ်ႈတႆး)",
    "script": ["Myanmar"],

    // Onset consonants (Shan letters + shared Myanmar letters) → IPA.
    //
    // ⚠ THE FOUR VOICED LOAN LETTERS WERE MISSING, AND THEY ARE A CONTIGUOUS BLOCK OF THE SHAN RANGE.
    // U+1075–U+1081 is the Shan letter run; this table held 1075 1076 1078 107A 107C 107D 107E 1080 1081
    // and skipped exactly ၷ 1077, ၹ 1079, ၻ 107B and ၿ 107F — the voiced series. `phonemizeWord` skips a
    // character that is not an onset, so ⟨ၻ ၿ⟩ read as NOTHING and dragged their vowel signs down with
    // them: `ၻွၵ်ႇတႂ်ႇ` ("doctor") → *kaː˨˦*, `ၿီႇလီႇယၢၼ်ႇ` ("billion") → *liː˩jaːn˩*.
    // `silentCharsIn` reported ⟨ၻ⟩ ×34 and ⟨ၿ⟩ ×22 on that.
    //
    // Standard Shan phonology has NO voiced plosives, so all four are loan-only — which is the reason they
    // were easy to miss and NOT a reason to leave them out: the corpus writes them ×34/×22/×13, in English
    // loans (ၻီႇၵရီႇ "degree" ×6, ၻေႃႇလႃႇ "dollar", ၻွၵ်ႇတႂ်ႇ "doctor", ၿီႇလီႇယၢၼ်ႇ "billion",
    // ၿရၼ်ႇတီႇ "brandy") and in Pali (ၻေဝꩪမ်မ devadhamma, ဝိၽင်ၷႃၻိပႃလိ). ⟨ၹ⟩ has 0 corpus instances and
    // is added anyway, to close the block rather than leave one member of a series to be found later.
    //
    // Sources: Wikipedia "Help:IPA/Shan and Tai Lue" consonant table — ၻ [d], ၿ [b], ၷ [ɡ] ("in foreign
    // words"), ၹ [z] ("in Burmese loanwords"); Wikipedia "Shan alphabet", which lists the same five rare
    // consonants as inherited from Burmese for non-native sounds. ⚠ NOTHING IS NEUTRALISED TOWARD THE
    // NATIVE INVENTORY (⟨ၻ⟩→t, ⟨ၿ⟩→p): that would make a loan letter indistinguishable from ⟨တ⟩/⟨ပ⟩ and is
    // not what the cited tables say. It is also the convention this table ALREADY follows for the other two
    // loan letters it carries — ⟨ရ⟩ → r and ⟨ႀ⟩ → θ are equally absent from native Shan.
    "onsets": {
        "ၵ": "k", "ၶ": "kʰ", "ၸ": "t͡ɕ", "သ": "sʰ", "ထ": "tʰ", "ပ": "p", "ၽ": "pʰ", "ၾ": "f", "တ": "t", "ၼ": "n",
        "မ": "m", "လ": "l", "ဝ": "w", "ယ": "j", "ရ": "r", "ႁ": "h", "ႀ": "θ", "ဢ": "ʔ", "င": "ŋ", "ၺ": "ɲ",
        "ၷ": "ɡ", "ၹ": "z", "ၻ": "d", "ၿ": "b",
    },

    // Coda consonants (a killed consonant, C + asat ်) → IPA. Nasals + checked stops (unreleased).
    "codas": {
        "င": "ŋ", "ၼ": "n", "မ": "m", "ၵ": "k̚", "တ": "t̚", "ပ": "p̚", "ၺ": "j", "ဝ": "w",
    },

    // Tone marks → Chao tone. Unmarked = ˨˦ (rising).
    "tones": { "း": "˥", "ႇ": "˩", "ႈ": "˧˧˨", "ႉ": "˦˨", "ႊ": "˧" },
    "unmarkedTone": "˨˦",

    // Palatalisation of an onset by ျ: ⟨ၵျ⟩→d͡ʑ (voiced), ⟨ၶျ⟩→t͡ɕʰ, ⟨သျ⟩→ʃ.
    "palatal": { "k": "d͡ʑ", "kʰ": "t͡ɕʰ", "sʰ": "ʃ" },

    // Vowel signs (above/below/after the onset) → an abstract vowel key; the combos are resolved by the
    // rime logic in shan.ts. ⟨ၢ⟩ (U+1062) and ⟨ႃ⟩ (U+1083) are BOTH long [aː] — ⟨ၢ⟩ writes closed-syllable
    // /aː/, ⟨ႃ⟩ the open one; short /a/ is the inherent (sign-less) vowel.
    "vowelSigns": {
        "ႃ": "aa", "ိ": "i", "ီ": "ii", "ု": "u", "ူ": "uu", "ေ": "ee", "ႄ": "ee_open",
        "ဵ": "e_short", "ႅ": "ee_short", "ၢ": "aa", "ႆ": "FINAL_Y",
    },

    // Cardinal number words (SHAN-SCRIPT spellings only; the abugida scan reads them). Shan is Southwestern
    // Tai, so the system is structurally Thai's (see thai.ts) with the cognate irregulars: 20 is သၢဝ်း (sao)
    // and REPLACES the whole "twenty" (no သိပ်း), and a FINAL 1 in any compound ≥11 is ဢဵတ်း (et) rather than
    // ၼိုင်ႈ (nueng) — သိပ်းဢဵတ်း 11, သၢဝ်းဢဵတ်း 21. Tens 30–90 are unit-first (သၢမ်သိပ်း = 3×10).
    // Sources: Wiktionary "Category:Shan numerals" (ၼိုင်ႈ … ၵဝ်ႈ, သိပ်း, သၢဝ်း, ဢဵတ်း, the 30–90 unit+သိပ်း
    // forms, ပၢၵ်ႇ 100, ႁဵင် 1000, မိုၼ်ႇ 10⁴, သႅၼ် 10⁵), cross-checked against Omniglot "Numbers in Shan",
    // which agrees on all of 0–100 + ပၢၵ်ႇ/ႁဵင်/မိုၼ်ႇ/သႅၼ်.
    // JUDGMENT CALL: neither source attests a word for 10⁶. Rather than invent one (the expected Tai cognate
    // လၢၼ်ႉ is unattested in both), the magnitude ladder STOPS at သႅၼ် (10⁵) and larger values are composed
    // as multiples of it (10⁶ = သိပ်းသႅၼ် "ten hundred-thousand") — compositional from cited words only.
    "numbers": {
        "units": ["သုၼ်", "ၼိုင်ႈ", "သွင်", "သၢမ်", "သီႇ", "ႁႃႈ", "ႁူၵ်း", "ၸဵတ်း", "ပႅတ်ႇ", "ၵဝ်ႈ"],
        "ten": "သိပ်း",
        "twenty": "သၢဝ်း",
        "finalOne": "ဢဵတ်း",
        "magnitudes": [[100000, "သႅၼ်"], [10000, "မိုၼ်ႇ"], [1000, "ႁဵင်"], [100, "ပၢၵ်ႇ"]],
    },
}
