// Native canonical-IPA definition for Swahili / Kiswahili (sw) — Bantu, Latin script. swahili.ts reads this file.
// Swahili has a highly PHONEMIC, shallow orthography and (unusually for Bantu) NO tone — just regular penultimate
// stress. The distinctive features: the plain voiced stops are IMPLOSIVES (b→ɓ d→ɗ j→ʄ g→ɠ, both human referees
// mark them), PRENASALIZED stops written as a nasal + voiced consonant (mb→ᵐb, nd→ⁿd, nj→ⁿd͡ʒ, ng→ᵑɡ) with a
// homorganic superscript nasal, ⟨ng'⟩→ŋ (velar nasal, DISTINCT from ⟨ng⟩→ᵑɡ), syllabic nasals (mtu→m̩tu), and
// Arabic-loan fricatives (dh→ð, th→θ, gh→ɣ, kh→x). Vowels are [a e i o u] — see the vowel note below.
{
    "language": "sw",
    "name": "Swahili",
    "script": ["Latin"],
    "provenance": "Authored from standard Swahili phonology (implosives, prenasalization, penultimate stress). Consonants + stress validated against wikipron swa + kaikki swa (human) + epitran swa-Latn. ⚠ The VOWELS were not: the referee eval folds them away, and the engine disagreed with epitran on all three until 2026-08-20 — they are now anchored on epitran + 3,070 FLEURS utterances instead (see the vowel note).",

    // ⟨ng'⟩ (with apostrophe) → the velar nasal ŋ — scanned before ⟨ng⟩ (the prenasalized ᵑɡ).
    "velarNasal": "ng'",

    // Prenasalized units: a homorganic nasal + voiced consonant → one prenasalized segment (superscript nasal).
    "prenasal": { "mb": "ᵐb", "nd": "ⁿd", "nj": "ⁿd͡ʒ", "ng": "ᵑɡ", "mv": "ᵐv", "nz": "ⁿz" },

    // Other multi-letter graphemes: affricate/fricative digraphs + the Arabic-loan fricatives.
    "digraphs": { "ch": "t͡ʃ", "sh": "ʃ", "ny": "ɲ", "dh": "ð", "th": "θ", "gh": "ɣ", "kh": "x" },

    // Single consonant letters → IPA. The plain voiced stops are IMPLOSIVE (ɓ ɗ ʄ ɠ); ⟨r⟩ is a tap ɾ.
    "consonants": {
        "p": "p", "b": "ɓ", "t": "t", "d": "ɗ", "k": "k", "g": "ɠ",
        "j": "ʄ", "f": "f", "v": "v", "s": "s", "z": "z", "h": "h",
        "m": "m", "n": "n", "l": "l", "r": "ɾ", "w": "w", "y": "j",
        "c": "k", "q": "k", "x": "ks"
    },

    // Vowels — a 5-vowel system with NO low/mid contrast anywhere in it, so the choice between [ɑ ɛ ɔ] and
    // [a e o] is NOTATION, not phonology: there is nothing for the backer/opener symbols to distinguish.
    // ⚠ THIS USED TO BE [ɑ ɛ i ɔ u], "the convention of both human referees". Both referees are ONE
    // tradition: wikipron swa and kaikki swa are both en.wiktionary, and they write ɑ 356:8 and 387:7. The
    // two sources that are NOT that tradition both disagree with it:
    //   · epitran swa-Latn writes a/e/o (habari→haɓaɾi, jambo→ʄambo, asante→asante). This is the load-bearing
    //     one: it is a rule system independent of BOTH Wiktionary and espeak.
    //   · 3,070 FLEURS utterances: our ɑ came back as [a] 81.4%, our ɛ as [e] 73.5%, our ɔ as [o] 77.3%,
    //     against controls of i→i 87.8% and u→u 80.0%. The recognizer writes ɑ/ɛ/ɔ freely in ~100 other
    //     languages and returns them here below 3.3%, so it is not inventory-limited — it did not hear them.
    //     ⚠ This recognizer is espeak-fine-tuned and espeak's Swahili voice also writes a/e/o, so it is NOT
    //     independent of espeak — count it and espeak as one witness, not two. The case rests on epitran
    //     plus the structural fact that the symbols distinguish nothing here.
    // Median audio distance 0.4439 → 0.1571 (rank 6 of 102). ⚠ The REFEREE CANNOT SEE THIS EITHER WAY:
    // the referee config (tools/referee-eval/langs/sw.jsonc) folds [aä]→ɑ, e→ɛ, o→ɔ on BOTH sides, so
    // 93.5%/97.8% are byte-identical under this change — which is how the old set survived two referees
    // at 93%+. Verified by running the eval both ways, not assumed. See
    // docs/investigations/low_vowel_notation_investigation.md.
    "vowels": { "a": "a", "e": "e", "i": "i", "o": "o", "u": "u" },

    "clausePunctuation": {
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — standard Swahili, joined by "na". units siz. tens kumi/ishirini/…; hundreds mia; thousands elfu;
    // millions milioni. Spellings read back through the same g2p.
    "numbers": {
        "units": ["sifuri", "moja", "mbili", "tatu", "nne", "tano", "sita", "saba", "nane", "tisa"],
        "ten": "kumi",
        "tens": { "2": "ishirini", "3": "thelathini", "4": "arobaini", "5": "hamsini", "6": "sitini", "7": "sabini", "8": "themanini", "9": "tisini" },
        "hundred": "mia", "thousand": "elfu", "million": "milioni", "and": "na"
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbolTier": {
        // ⚠ THE AMPERSAND WAS A MISSING CELL, NOT A SOURCING PROBLEM — the tier's own `ampersand` note says so,
        // and this language is one of the fourteen that still had no word declared, so `&` was DROPPED outright.
        // na is ×3577 TOKEN in this language's own corpus, i.e. among its commonest words; there was nothing to source.
        //
        // A Latin-script printing LIGATURE rather than anything native, so what it takes is a reading and not a
        // translation: for a language written in Latin script that is its own conjunction, and for one that is not,
        // the symbol only ever arrives inside a Latin run. Either way the tier substitutes the conjunction, SPACED —
        // see the tier, where the spacing exists because `B&B` is two initialisms.
        "ampersand": "na",
        // `multiply` — this language DROPPED the sign outright. ⚠ STANDARD MATHEMATICAL REGISTER, not a corpus
        // attestation: the sweep failed exactly as the exponent sweep did, because the plausible hits are homographs
        // of PREPOSITIONS — es `por` ×23, it `per` ×25, ru `на` ×31 are all the preposition, never the operator.
        // One word, so `by` defaults to it; this language does not split dimension from product.
        "multiply": { "times": "mara" },
        "percent": ["asilimia"],
        "percentPrefix": true,
        "currency": {
            "$": ["dola"], "€": ["euro"], "£": ["pauni"], "¥": ["yeni"],
            "KSh": ["shilingi"], "TSh": ["shilingi"],
        },
        "currencyPrefix": true,
        // `5 km` read as *tˈano kˈm̩*: no unit was declared, and until now none COULD be, because Swahili
        // puts the measure noun FIRST and the tier only emitted it after. Counted over sw_ke's four attested unit
        // words: 82 unit-before to 0 unit-after — "Mbuga hiyo inachukua kilomita 19,500 mraba", "mtindo huru wa
        // mita 100 na mita 200". Hence `unitPrefix`, the mirror of the `currencyPrefix` already set above.
        // Verified: kilomita ×59, mita ×23, kilogramu ×6, sentimita ×2.
        "unitPrefix": true,
        "units": { "km": ["kilomita"], "m": ["mita"], "cm": ["sentimita"], "kg": ["kilogramu"] },
        // THE RATE, because declaring the unit alone left a stray letter. sw_ke writes `160 Km/h` ×2 — with a
        // CAPITAL K, which a case-sensitive grep misses and the tier's `giu` pattern does not — and once `Km` read
        // as kilomita the `/h` was stranded as a bare *h*. "kwa saa" is attested ×34 and "kwa sekunde" ×5.
        "unitPer": "kwa",
        "rateDenominators": { "h": "saa", "s": "sekunde" }
    },

    // ERA MARKERS. `Baada ya Kristo` is attested in the corpus itself ("1000-1300 Baada ya Kristo"); its
    // counterpart `Kabla ya Kristo` is the standard Swahili for BC/BCE. Which SPELLINGS trigger them — the
    // dotted forms, and the rule that a bare `BC` must follow a NUMBER because two bare capitals are
    // otherwise an ordinary initialism — is the algorithm and stays in normalize.ts.
    "eraWords": { "bce": "Kabla ya Kristo", "ad": "Baada ya Kristo" }
}
