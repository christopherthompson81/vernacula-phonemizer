// Native canonical-IPA definition for Cantonese / Yue (yue). Written in Han characters; the Han→Jyutping mapping
// is the rime-cantonese dictionary (dict.tsv, word→jyutping), and this file maps Jyutping → canonical IPA:
// INITIALS, FINALS (rimes, with the aː/ɐ long/short split and the checked -p̚/-t̚/-k̚ codas), and the SIX Cantonese
// tones as Chao contour letters. cantonese.ts parses each jyutping syllable into initial + final + tone.
{
    "language": "yue",
    "name": "Cantonese",
    "script": ["Han"],

    // Syllable INITIALS (onsets). Parsed longest-first (ng/gw/kw before single letters).
    "initials": {
        "b": "p", "p": "pʰ", "m": "m", "f": "f",
        "d": "t", "t": "tʰ", "n": "n", "l": "l",
        "g": "k", "k": "kʰ", "ng": "ŋ", "h": "h",
        "gw": "kʷ", "kw": "kʷʰ", "w": "w",
        "z": "t͡s", "c": "t͡sʰ", "s": "s", "j": "j"
    },

    // FINALS (rimes) → IPA. Long ⟨aa⟩ = [aː], short ⟨a⟩ = [ɐ] (only in diphthongs/closed rimes). Checked rimes
    // (-p/-t/-k) end in an unreleased stop [p̚ t̚ k̚]. Syllabic nasals m̩ / ŋ̩ stand alone.
    "finals": {
        "aa": "aː", "aai": "aːi", "aau": "aːu", "aam": "aːm", "aan": "aːn", "aang": "aːŋ", "aap": "aːp̚", "aat": "aːt̚", "aak": "aːk̚",
        "ai": "ɐi", "au": "ɐu", "am": "ɐm", "an": "ɐn", "ang": "ɐŋ", "ap": "ɐp̚", "at": "ɐt̚", "ak": "ɐk̚",
        "e": "ɛː", "ei": "ei", "eu": "ɛːu", "em": "ɛːm", "eng": "ɛːŋ", "ep": "ɛːp̚", "ek": "ɛːk̚",
        "i": "iː", "iu": "iːu", "im": "iːm", "in": "iːn", "ing": "ɪŋ", "ip": "iːp̚", "it": "iːt̚", "ik": "ɪk̚",
        "o": "ɔː", "oi": "ɔːi", "ou": "ou", "on": "ɔːn", "ong": "ɔːŋ", "ot": "ɔːt̚", "ok": "ɔːk̚",
        "oe": "œː", "oeng": "œːŋ", "oek": "œːk̚",
        "eoi": "ɵy", "eon": "ɵn", "eot": "ɵt̚",
        "u": "uː", "ui": "uːi", "un": "uːn", "ung": "ʊŋ", "ut": "uːt̚", "uk": "ʊk̚",
        "yu": "yː", "yun": "yːn", "yut": "yːt̚",
        "m": "m̩", "ng": "ŋ̩",
        // Marginal rimes — colloquial particles, onomatopoeia, and loanwords.
        "a": "aː", "et": "ɛːt̚", "en": "ɛːn", "oet": "œːt̚",
        "om": "ɔːm", "op": "ɔːp̚", "um": "ɐm", "up": "ɐp̚"
    },

    // The SIX Cantonese tones (Jyutping 1–6) → Chao contour letters. Checked syllables (stop-coda) take the
    // level tones 1/3/6 (short high/mid/low); the tone number already encodes that, so one table serves both.
    "tones": {
        "1": "˥", "2": "˧˥", "3": "˧", "4": "˨˩", "5": "˩˧", "6": "˨"
    },

    // 、's rare sesame-dot variant ﹑ (×5) and the ellipsis … (×7) were unmapped and so silently lost
    // their pause; ─ ── — – － (×21 together) are the appositive dash this corpus uses (科查莫谷──智利…).
    // ．U+FF0E ×16 is deliberately ABSENT: in this corpus it is the interpunct INSIDE transliterated foreign
    // names (瑪麗．安東尼, 巴布．狄倫), not a sentence period, so mapping it would break 16 names apart. Same
    // reason 《》〈〉「」（）and the name dots ·‧・ are left unmapped.
    "clausePunctuation": {
        "。": ".", "，": ",", "、": ",", "？": "?", "！": "!", "；": ",", "：": ",",
        "﹑": ",", "…": ",", "─": ",", "—": ",", "–": ",", "－": ",",
        ".": ".", ",": ",", "?": "?", "!": "!", ";": ",", ":": ","
    },

    // a standalone 2 before one of these classifiers reads colloquial 兩 loeng5 (兩個, 兩座, 兩種), not
    // 二. 月 and 日 are excluded on purpose — "2 月" is February (二月), a date, not a count of months.
    "measureWords": "個位本張隻條件對群種次天年歲塊層排組步口面首部台輛架座間扇頁杯碗瓶盒袋斤磅噸",

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, one name fleet-wide. In the abugida manifests `symbols` already means the
    // BARE-SIGN → word map the engine's tokenizer reads, so the shared tier cannot use that name there —
    // and having the same table under two names depending on the language is exactly the kind of split this
    // sweep exists to remove.
    "symbolTier": {
        // ⚠ `multiply` is STANDARD MATHEMATICAL REGISTER, not a corpus attestation: a corpus sweep for the operator
        // returns homographs of PREPOSITIONS in every language tried. One word, so `by` defaults to it; Cantonese
        // does not split dimension from product.
        "multiply": { "times": "乘" },
        "ampersand": "和",
        "percent": ["百分之"],
        "percentPrefix": true,
        // ⚠ THE HK REGISTER, NOT THE MAINLAND ONE: 公里/公斤, not the 千米/千克 a concept label offers. A label gives
        // the language's term for a concept, not the register the text is in.
        // ⚠ `m` IS DELIBERATELY ABSENT. 米 is a one-character unit, and in an UNSPACED script that is inseparable
        // from any name containing it — 米勒 is "Miller". Declaring it would read every such name as a measurement.
        "units": { "km": ["公里"], "kg": ["公斤"] },
        "currency": { "$": ["美元"], "€": ["歐元"], "£": ["英鎊"] },
        // 平方公里 is fused and word-first. Cubed is undeclared, and could not be read anyway while 米 stays
        // undeclared for the 米勒 reason above — the two gaps are the same gap.
        "exponentWords": { "squared": ["平方"], "position": "compound" },
        "unspacedScript": true
    }
}
