// Native canonical-IPA data manifest for Kalaallisut / West Greenlandic (kl) — Eskimo-Aleut (Inuit
// branch), ~56k (Greenland), the 1973 PHONEMIC Latin orthography. Because the orthography is highly
// phonemic, the engine (kalaallisut.ts) is a near-1:1 scan:
//   ⚠ THREE-VOWEL system /a i u/ (the Inuit hallmark). ⟨e o⟩ are NOT phonemes — they are the LOWERED
//     allophones of /i u/ the orthography writes before a uvular ⟨q r⟩, so ⟨e⟩→[i], ⟨o⟩→[u] (aaneq→aːniq).
//     Doubled vowel → LENGTH.
//   ⚠ the UVULAR stop ⟨q⟩→[q] and the uvular fricative ⟨r⟩→[ʁ]; ⟨ng⟩→[ŋ], ⟨nng⟩→[ŋː]; a doubled consonant
//     → LENGTH. The gemination/digraph logic is code, in kalaallisut.ts.
// The PHONETIC regressive consonant ASSIMILATION (rp→pp) + uvular vowel-lowering ([ɜ ɔ ɑ], ll→ɬ) are the
// NARROW layer — deferred (the engine targets the broad/phonemic level). No stress (weight-based,
// unmarked). Referee: wikipron kal_latn_broad (human, 1581).
{
    "language": "kl",
    "name": "Kalaallisut (kalaallisut)",
    "script": ["Latin"],

    // Single vowel graphemes → IPA. ⟨e o⟩ are the orthographic lowered-before-uvular allophones of /i u/ →
    // [i]/[u]. ⟨y⟩ joins æ ø å as a Danish-loan vowel letter: it is unavoidable once Danish numerals are
    // read (tyve, fyrre, sytten — see numbers.ts), and without it the scan silently deleted it
    // (tyve → *[tvi]).
    "vowels": { "a": "a", "i": "i", "u": "u", "e": "i", "o": "u", "æ": "ɛ", "ø": "ø", "å": "ɔ", "y": "y" },

    // Single consonant graphemes → IPA. ⟨r⟩ is the uvular fricative [ʁ]. ⟨b d⟩ are loan letters —
    // Greenlandic has no voiced stops, so they DEVOICE to [p t] (Biina→piːna, Bolatta→pulatːa). ⟨g⟩ is the
    // voiced velar FRICATIVE [ɣ] (isigak→isiɣak) — the continuant parallel to the stop ⟨k⟩, exactly as
    // ⟨r⟩→[ʁ] is to ⟨q⟩ (the series v s g r = [v s ɣ ʁ]); the broad referee coarsens it to [ɡ] (fold).
    "consonants": {
        "p": "p", "t": "t", "k": "k", "q": "q", "b": "p", "d": "t", "g": "ɣ", "f": "f", "h": "h", "j": "j",
        "l": "l", "m": "m", "n": "n", "s": "s", "v": "v", "r": "ʁ", "w": "v",
    },

    // THE NUMERAL LEXICON. ⚠ TWO LANGUAGES IN ONE TABLE, AND IT IS A NECESSITY RATHER THAN A SHORTCUT:
    // 0–12 are NATIVE Kalaallisut, 13 up are DANISH and solid-compounded. The traditional system is a
    // BODY-PART TALLY and does not scale — the words say so themselves, which is why the glosses are kept
    // beside them: `arfinillit` (6) is "other hand"+1, so counting has crossed to the second hand;
    // `aqqanillit` (11) is "going down"+1, i.e. down to the feet. A system anchored to twenty fingers and
    // toes has nowhere to put a thousand, so speakers borrow Danish for everything above the small counts,
    // and the engine is reporting that fact rather than economising on it.
    // ⚠ `nul` AT INDEX 0 IS ITSELF A DANISH LOAN — no native zero exists — so the native list is native
    // from 1, and index 0 is already where the two systems touch. The boundary at 12 is the corpus's.
    // The ARITHMETIC stays in numbers.ts: which base applies at which magnitude, the solid compounding, the
    // `en`-vs-plural choice on million/milliard, and the digit-by-digit fallback above 10¹².
    "numbers": {
        "native": [
            "nul",              // 0 — Danish; the only attested form
            "ataaseq",          // 1
            "marluk",           // 2
            "pingasut",         // 3
            "sisamat",          // 4
            "tallimat",         // 5
            "arfinillit",       // 6 — "other hand" + 1
            "arfineq marluk",   // 7
            "arfineq pingasut", // 8
            "qulingiluat",      // 9
            "qulit",            // 10
            "aqqanillit",       // 11 — "going down" (to the feet) + 1
            "aqqaneq marluk"    // 12
        ],
        // ⚠ THE DANISH UNITS ARE THE COMBINING FORMS, not the citation ones: Danish uses `en` (not `et`) in
        // `enogtyve` and before `hundrede`/`tusind`. Index 0 is empty because no unit word appears there.
        "danish": {
            "units": ["", "en", "to", "tre", "fire", "fem", "seks", "syv", "otte", "ni"],
            "teens": ["ti", "elleve", "tolv", "tretten", "fjorten", "femten", "seksten", "sytten", "atten", "nitten"],
            "tens": {
                "20": "tyve", "30": "tredive", "40": "fyrre", "50": "halvtreds",
                "60": "tres", "70": "halvfjerds", "80": "firs", "90": "halvfems"
            },
            // `og` joins unit to ten and is written SOLID: enogtyve, otteoghalvfems.
            "and": "og",
            "hundred": "hundrede",
            "thousand": "tusind",
            // ⚠ THESE FOUR WERE BARE LITERALS IN TEMPLATE STRINGS, which is why they are here rather than
            // being composed from `units[1]` plus a scale word: the code emitted "en million" and
            // "millioner" directly, so a grep for the scale words found the tables and missed these.
            // Stored as the engine emits them, so the lift changes nothing.
            "million": { "singular": "en million", "plural": "millioner" },
            "milliard": { "singular": "en milliard", "plural": "milliarder" }
        }
    }
}
