// Native canonical-IPA data manifest for Georgian / ქართული (ka) — Kartvelian, the Mkhedruli script,
// Georgia (~4M). Georgian orthography is essentially ONE-LETTER-ONE-PHONEME (a transparent
// alphabet, NO digraphs), so the g2p is a greedy longest-match scan (georgian.ts) over the 33-letter table + ONE
// context rule (word-final voiced-stop devoicing).
// Referee: wikipron kat_geor_narrow (HUMAN, 20,894 words). The table was DERIVED empirically from 18,350 1:1-aligned
// referee words. Signatures:
//   • the three-way STOP/AFFRICATE contrast VOICED / ASPIRATED / EJECTIVE:
//       labial   ბ b · ფ pʰ · პ pʼ            velar    გ ɡ · ქ kʰ · კ kʼ
//       dental   დ d · თ tʰ · ტ tʼ            affr.(s) ძ d͡z · ც t͡sʰ · წ t͡sʼ
//       uvular            ყ qʼ (ejective)      affr.(ʃ) ჯ d͡ʒ · ჩ t͡ʃʰ · ჭ t͡ʃʼ
//   • UVULAR fricatives ღ=ʁ (voiced), ხ=χ (voiceless) — NOT velar ɣ/x (the referee confirms uvular).
//   • 5 vowels a ɛ i ɔ u (the referee's narrow ä/e̞/o̞ are folded to a/ɛ/ɔ).
// Stress is weak / non-contrastive → not marked. WORD-FINAL VOICED STOPS devoice to aspirated (ბ/დ/გ→pʰ/tʰ/kʰ) — the
// ONE context rule, MODELLED in georgian.ts (kʼaɾɡatʰ), not folded. The referee's other narrow ALLOPHONY IS folded
// (config): ä→a, e̞→ɛ, o̞→ɔ, dark ɫ→l, n→ŋ (pre-velar), the devoicing ring (b̥/ɡ̊/d̥), the ⟨ვ⟩ devoicing (f→v, before
// a voiceless C / final), and ⟨ყ⟩'s narrow [χʼ]→ the standard phonemic /qʼ/ we emit. Numbers deferred.
{
    "language": "ka",
    "name": "Georgian (ქართული)",
    "script": ["Georgian"],
    "provenance": "Authored greedy g2p from the Mkhedruli alphabet; the 33-letter table was derived empirically from the wikipron kat_geor_narrow referee (HUMAN, 18,350 1:1-aligned words), cross-checked against standard Georgian phonology.",

    "convention": {
        "stops": "three-way VOICED / ASPIRATED / EJECTIVE at labial ბ/ფ/პ, dental დ/თ/ტ, velar გ/ქ/კ; the ejective is marked ◌ʼ, the aspirate ◌ʰ, the voiced plain",
        "affricates": "ძ=d͡z / ც=t͡sʰ / წ=t͡sʼ (alveolar) and ჯ=d͡ʒ / ჩ=t͡ʃʰ / ჭ=t͡ʃʼ (post-alveolar), same voiced/aspirated/ejective three-way; tie-barred",
        "uvulars": "ღ=ʁ (voiced uvular fricative), ხ=χ (voiceless uvular fricative), ყ=qʼ (uvular ejective — the referee's narrow [χʼ] is folded)",
        "vowels": "5 vowels ა=a, ე=ɛ, ი=i, ო=ɔ, უ=u (the referee's narrow ä/e̞/o̞ centralised/lowered variants are folded)",
        "otherC": "ვ=v, ზ=z, ჟ=ʒ, შ=ʃ, ს=s, ლ=l (dark [ɫ] before back vowels/coda is allophonic → folded), რ=ɾ (tap), მ=m, ნ=n (→[ŋ] pre-velar, folded), ჰ=h",
        "stress": "weak / non-contrastive (no phonemic stress) → not marked",
        "finalDevoicing": "word-final voiced STOPS ბ/დ/გ devoice to aspirated pʰ/tʰ/kʰ — MODELLED in georgian.ts (kʼaɾɡatʰ), categorical in the referee. The voiced fricative ⟨ვ⟩→[f] (before a voiceless C / final) is NOT modelled → folded (f→v); the other voiced fricatives/affricates do not devoice"
    },

    // All keys are single Mkhedruli letters (no digraphs). Sorted length-desc by the loader (a no-op here).
    "graphemes": {
        "ა": "a", "ბ": "b", "გ": "ɡ", "დ": "d", "ე": "ɛ", "ვ": "v", "ზ": "z", "თ": "tʰ",
        "ი": "i", "კ": "kʼ", "ლ": "l", "მ": "m", "ნ": "n", "ო": "ɔ", "პ": "pʼ", "ჟ": "ʒ",
        "რ": "ɾ", "ს": "s", "ტ": "tʼ", "უ": "u", "ფ": "pʰ", "ქ": "kʰ", "ღ": "ʁ", "ყ": "qʼ",
        "შ": "ʃ", "ჩ": "t͡ʃʰ", "ც": "t͡sʰ", "ძ": "d͡z", "წ": "t͡sʼ", "ჭ": "t͡ʃʼ", "ხ": "χ", "ჯ": "d͡ʒ",
        "ჰ": "h"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",", "჻": "."
    },

    // VIGESIMAL cardinal numbers (composition logic in numbers.ts). Georgian counts 20–99 in SCORES:
    //   20 ოცი · 40 ორმოცი (ორ-"2" × ოც-"20") · 60 სამოცი (3×20) · 80 ოთხმოცი (4×20); any other 21–99 takes the
    //   score's stem + -და- ("and") + the plain 1–19 word, as ONE word:
    //     30 ოცდაათი (20+10) · 45 ორმოცდახუთი (2×20+5) · 67 სამოცდაშვიდი (3×20+7) · 89 ოთხმოცდაცხრა (4×20+9)
    //     99 ოთხმოცდაცხრამეტი (4×20+19)
    // From 100 up the units are written as SEPARATE words, and a numeral that is FOLLOWED by a smaller number
    // TRUNCATES — it drops its final ⟨ი⟩: ასი→ას, ორასი→ორას, ათასი→ათას, მილიონი→მილიონ. Hence
    //   101 ას ერთი · 250 ორას ორმოცდაათი · 1300 ათას სამასი · 1959 ათას ცხრაას ორმოცდაცხრამეტი ·
    //   2001 ორი ათას ერთი · 2101 ორი ათას ას ერთი
    // The two forms are therefore stored as PAIRS: "bare" (group-final) and "comb" (something follows).
    //
    // SOURCES: ka.wikipedia's per-number articles "N (რიცხვი)" for 0–20, the round tens, and the hundreds
    // (0 ნული · 8 რვა · 19 ცხრამეტი · 30 ოცდაათი · 50 ორმოცდაათი · 70 სამოცდაათი · 90 ოთხმოცდაათი · 100 ასი ·
    // 300 სამასი · 700 შვიდასი · 1000 ათასი); ka.wikipedia year articles for the compound/truncation evidence
    // above (101, 1101, 1300, 1500, 1800, 1900, 1959, 1999, 2001, 2101) and for ერთი მილიონი / ერთი მილიარდი;
    // and Wikipedia "Georgian numerals" for the rule statements ("Any other number between 21 and 99 is formed
    // using 20, 40, 60, or 80, dropping the final i, then adding da … followed by the appropriate number from 1
    // to 19"; "The final i is dropped when a smaller number is added to a multiple of 100").
    "numbers": {
        "units": ["ნული", "ერთი", "ორი", "სამი", "ოთხი", "ხუთი", "ექვსი", "შვიდი", "რვა", "ცხრა"],
        "teens": [
            "ათი", "თერთმეტი", "თორმეტი", "ცამეტი", "თოთხმეტი",
            "თხუთმეტი", "თექვსმეტი", "ჩვიდმეტი", "თვრამეტი", "ცხრამეტი"
        ],
        // Indexed by the SCORE count 1–4 (= 20, 40, 60, 80); index 0 is unused padding.
        "scores": {
            "bare": ["", "ოცი", "ორმოცი", "სამოცი", "ოთხმოცი"],
            "comb": ["", "ოცდა", "ორმოცდა", "სამოცდა", "ოთხმოცდა"]
        },
        // Indexed by the hundreds digit 1–9; index 0 is unused padding. ⟨რვა/ცხრა⟩ have no final ⟨ი⟩ to drop, so
        // their hundreds are რვაასი/ცხრაასი → რვაას/ცხრაას like the rest.
        "hundreds": {
            "bare": ["", "ასი", "ორასი", "სამასი", "ოთხასი", "ხუთასი", "ექვსასი", "შვიდასი", "რვაასი", "ცხრაასი"],
            "comb": ["", "ას", "ორას", "სამას", "ოთხას", "ხუთას", "ექვსას", "შვიდას", "რვაას", "ცხრაას"]
        },
        "magnitudes": {
            "thousand": { "bare": "ათასი", "comb": "ათას" },
            "million": { "bare": "მილიონი", "comb": "მილიონ" },
            "billion": { "bare": "მილიარდი", "comb": "მილიარდ" }
        }
    }
}
