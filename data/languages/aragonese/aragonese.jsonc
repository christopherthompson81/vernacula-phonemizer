// Native canonical-IPA data manifest for Aragonese (an) — aragonés, Ibero-Romance (Pyrenean), Aragon/NE Spain
// (~25k). Close to Spanish/Catalan/Occitan. A Spanish-shaped shallow g2p (the Asturian/Galician
// pattern) with the Aragonese hallmarks:
//   - ⟨ch⟩→[t͡ʃ] (very common — Aragonese writes ⟨ch⟩ where Spanish has [x]: Chesús, chuego), ⟨ny⟩→[ɲ] (Catalan-style
//     digraph: Espanya), ⟨x⟩→[ʃ] (baxo→baʃo), ⟨v⟩→[b] (betacism);
//   - DISTINCIÓN (standard/literary Aragonese, per the Academia): ⟨z⟩ and ⟨c⟩ before e/i → [θ] (seseo [s] is the
//     marked minority — Benasquese/Ribagorçan — so [θ] is emitted and the fold normalises the axis); ⟨j⟩/⟨g+e,i⟩→[x];
//   - WORD-FINAL ⟨-r⟩ APOCOPE: a final ⟨-r⟩ after a vowel is DROPPED (the categorical Aragonese trait, shared with
//     Catalan/Occitan — cantar→[kanˈta], flor→[flo], sur→[su]; the referee attests the dropped form throughout).
// Engine: aragonese.ts.
{
    "language": "an",
    "name": "Aragonese (aragonés)",
    "script": ["Latin"],

    // Digraphs, scanned LONGEST-FIRST: ⟨ny⟩→[ɲ], ⟨ll⟩→[ʎ], ⟨ch⟩→[t͡ʃ], ⟨tz⟩→[t͡s], ⟨rr⟩→[r] (trill). ⟨qu gu gü⟩,
    // the ⟨c⟩/⟨g⟩ softening, and the ⟨i u⟩ rising glides are handled in code.
    "digraphs": { "ny": "ɲ", "ll": "ʎ", "ch": "t͡ʃ", "tz": "t͡s", "rr": "r" },

    // Single grapheme → canonical IPA (BASE values; ⟨c g⟩ softening, ⟨qu gu⟩ clusters, glides, final-r drop in code).
    // ⟨x⟩→ʃ, ⟨j⟩→x (jota, loans), ⟨z⟩→θ (distinción), ⟨ñ⟩→ɲ, ⟨y⟩→ʝ, ⟨v⟩→b (betacism), ⟨h⟩ silent. Accents → plain vowel.
    "graphemes": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "á": "a", "é": "e", "í": "i", "ó": "o", "ú": "u", "ü": "u", "ï": "i",
        "b": "b", "c": "k", "d": "d", "f": "f", "g": "ɡ", "h": "", "j": "x", "k": "k",
        "l": "l", "m": "m", "n": "n", "ñ": "ɲ", "p": "p", "q": "k", "r": "ɾ", "s": "s", "t": "t",
        "v": "b", "w": "w", "x": "ʃ", "y": "ʝ", "z": "θ"
    },

    // The VOWEL LETTERS (plain + written-accent + the diaeresis ⟨ü⟩) — the environment the code rules test
    // for: a ⟨qu gu⟩ sequence only loses its ⟨u⟩ before one of these, and ⟨i u⟩ only become the rising
    // glides [j w] before one.
    "vowelLetters": ["a", "e", "i", "o", "u", "á", "é", "í", "ó", "ú", "ü"],
    // The FRONT vowel letters — the softening environment: ⟨c⟩ → [θ] and ⟨g⟩ → [x] before one of these, and
    // ⟨qu gu⟩ drop the [w] before one.
    "frontLetters": ["e", "i", "é", "í"],

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // CARDINAL NUMBER WORDS. Composition logic in numbers.ts.
    // SOURCE: "Los números en aragonés: cardinales", Mal de Lenguas (maldelenguas.blogspot.com/2012/05/
    // los-numeros-en-aragones-los-cardinales.html) — the fullest published Aragonese cardinal table (0–900,
    // 21–29, the ⟨y⟩ connector) — cross-checked against omniglot.com/language/numbers/aragonese.htm and
    // europeminoritylanguages.wordpress.com/2016/10/31/aragonese-os-numeros.
    // DIALECT NOTE: Aragonese numerals vary a lot east↔west (quatro~quatre, vinte~vint~vente, sixanta~sesenta,
    // diez~deu). This table takes the FIRST-LISTED (central/literary) variant of each entry in the source, which
    // is the set the two secondary sources agree on. Decimal throughout — no vigesimal residue.
    "numbers": {
        // 0–19. 16–19 are the analytic deci- series (decisiéis … decinueu), NOT the Spanish dieci- forms.
        "ones": ["zero", "un", "dos", "tres", "quatro", "cinco", "seis", "siete", "ueito", "nueu", "diez", "once",
            "dotze", "tretze", "catorce", "quince", "decisiéis", "decisiete", "deciueito", "decinueu"],
        "tens": ["", "", "vinte", "trenta", "quaranta", "cinquanta", "sixanta", "setanta", "uitanta", "novanta"],
        // 21–29 fuse into ONE word (vinti- + unit) — the source's primary series; 30–90 take the ⟨y⟩ connector.
        "twenties": ["", "vintiun", "vintidós", "vintitrés", "vintiquatro", "vinticinco", "vintiséis", "vintisiete",
            "vintiueito", "vintinueu"],
        "hundreds": ["", "cient", "docientos", "trecientos", "quatrecientos", "cincocientos", "seicientos",
            "sietecientos", "uitcientos", "noucientos"],
        "thousand": "mil",
        "and": "y", // 31 trenta y un, 42 quaranta y dos (the source's primary form; "trenta-un" is the variant)
        // millón is a NOUN (un millón / dos millons); 10⁹ falls out as the Ibero-Romance "mil millons".
        "scales": [{ "value": 1000000, "one": "un millón", "many": "millons" }],
    },
}
