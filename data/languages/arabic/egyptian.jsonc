// Egyptian Arabic (arz) variety data. Applied on the MSA g2p output (the "restore MSA then transform" path): the
// shared Arabic engine + diacritizer produce the MSA vocalization, and these Cairene shifts make it Egyptian.
//
// Two kinds, because they need different scopes:
//   consonantShifts — unambiguous string rewrites on the joined IPA (a consonant is always a consonant).
//   diphthongShifts — applied to a whole VOWEL SEGMENT only, NOT as a string replace: a true diphthong (fatḥa +
//     ي/و + sukūn) is one atomic seg [aj]/[aw], but a fatḥa + a glide that ONSETS the next syllable (طَوِيل tˤawiːl,
//     three segs a·w·iː) concatenates to the same "aw" substring — a blanket replace would wrongly monophthongize
//     the hiatus (tˤoːiːl). Matching the seg's ph exactly restricts it to real diphthongs.
{
    "variety": "egyptian",
    "iso": "arz",
    // Egyptian definite article is [il-] (assimilating to sun letters: in-, iʃ-), NOT MSA [al-]: النهارده → in-nahaːrda,
    // القاهرة → il-qaːhira. Raised on the tagged article-vowel SEG (not a string replace — a word-initial [a] can't be
    // told from an article [a] once joined). The teacher/diacritizer writes the article alif bare, so this is a g2p
    // variety rule, not learnable from silver.
    "articleVowel": "i",
    "consonantShifts": [
        // ⚠ FIRST, AND IT HAS TO BE: ["θ","t"] below introduces a [t], and a later ["t͡ʃ","ʒ"] would then be
        // matching a [t] this table produced rather than the one ⟨چ⟩ wrote.
        // ⟨چ⟩ → [ʒ], the Egyptian exception to the pan-Arabic [t͡ʃ] in arabic.jsonc. Egyptian ⟨ج⟩ is [ɡ], so the
        // foreign [ʒ~d͡ʒ] has no letter and ⟨چ⟩ takes it — چورچ George, چوزيف Joseph, تاچيكى Tajiki — while [t͡ʃ]
        // is written as the DIGRAPH ⟨تش⟩ (ادڤانتشر "adventure", دچوكوڤيتش "Djoković", which uses BOTH in one word).
        ["t͡ʃ", "ʒ"],
        ["d͡ʒ", "ɡ"], // ج → [ɡ] (Cairene; the signature Egyptian consonant)
        ["q", "ʔ"], // ق → [ʔ] (urban glottal stop)
        ["θ", "t"], // ث → [t] (native; the learned/loan [s] is a lexical tail)
        ["ð", "d"] // ذ → [d]; also turns ظ [ðˤ]→[dˤ] (ð→d leaves the pharyngealization) — native default
    ],
    "diphthongShifts": {
        "aj": "eː", // بيت bajt → beːt (only the atomic diphthong seg, not aj-hiatus)
        "aw": "oː" // يوم jawm → joːm
    },

    // ── Numerals — Egyptian, not MSA (80 was θamaːnuːn, with a θ the dialect does not have).
    // PROVENANCE per form: [k] = kaikki arz IPA; [w] = shipped wikipron arz referee; [t] = en.wiktionary
    // {{arz-numeral|tr=…}} transliteration; [p] = pedagogical literature only (Egyptian colloquial references;
    // the fused hundreds 300–900 have no kaikki/wikipron/Wiktionary-arz attestation — flagged, lowest confidence).
    // Notation matches the shipped egyptian-lexicon.tsv (rˤ, ʃ, ː).
    "numbers": {
        // [k] throughout; 0 sˤifr [k] (NOT the lexicon's sˤafːar, which is the verb "whistled" — a homograph).
        "ones": ["sˤifr", "waːħid", "itneːn", "talaːta", "ʔarbaʕa", "xamsa", "sitta", "sabʕa", "tamanja", "tisʕa"],
        // 10–19. 10–15 [k]; 16 sittaːʃarˤ [t]; 17 sabaʕtaːʃarˤ [t]; 18 tamantaːʃarˤ [t]; 19 tisʕataːʃarˤ [t].
        "teens": ["ʕaʃarˤa", "ħidaːʃarˤ", "itnaːʃarˤ", "talattaːʃarˤ", "ʔarbaʕtaːʃarˤ", "xamastaːʃarˤ",
            "sittaːʃarˤ", "sabaʕtaːʃarˤ", "tamantaːʃarˤ", "tisʕataːʃarˤ"],
        // 20 ʕiʃriːn [t]; 30 talatiːn [k]; 40 ʔarbiʕiːn [k]; 50 xamsiːn [k]; 60 sittiːn [k]; 70 sabʕiːn [w];
        // 80 tamaniːn [k] — the issue's headline; 90 tisʔiːn [k] (ʕ→ʔ is attested, not a typo).
        "tens": ["", "", "ʕiʃriːn", "talatiːn", "ʔarbiʕiːn", "xamsiːn", "sittiːn", "sabʕiːn", "tamaniːn", "tisʔiːn"],
        // Fused hundreds replace MSA's construct+dual composition. 100 mijːa [k]; 200 miteːn [t] (NOT wikipron's
        // majjitiːn — that is ميّتين "dead people", a homograph); 300–900 [p].
        "hundredsFused": ["", "mijːa", "miteːn", "tultumijːa", "rubʕumijːa", "xumsumijːa", "suttumijːa",
            "subʕumijːa", "tumnumijːa", "tusʕumijːa"],
        // wi — the Egyptian conjunction (MSA wa).
        "connector": "wi",
        // thousand ʔalf [k] (NOT the lexicon's ʔalːif, the letter name); dual ʔalfeːn [k]. 3–10 thousand use the
        // compositional unit + plural (talaːta ʔalaːf) — every word attested, slightly formal, chosen over the
        // fused colloquial talat-talaːf which lacks attestation. Millions: MSA-shaped with Egyptian phonology.
        "magnitudes": {
            "hundred": "mijːa", "hundredDual": "miteːn",
            "thousand": "ʔalf", "thousandDual": "ʔalfeːn", "thousandsPlural": "ʔalaːf",
            "million": "miljoːn", "millionDual": "miljoːneːn", "millionsPlural": "malajiːn",
        },
    },
}
