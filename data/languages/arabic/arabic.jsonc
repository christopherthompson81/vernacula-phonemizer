// Native canonical-IPA MANIFEST for Arabic (ar) — Modern Standard Arabic, broad phonemic. A fulsome, self-
// describing description of the language's DATA, matching english.jsonc / hindi.jsonc: the script inventory
// (harakat marks + special letters), the consonant map, sun letters, proclitics, clause punctuation, the number
// words, and the diacritizer's label / defective-spelling tables. The ALGORITHMS (diacritic parsing, article
// assimilation, quantity-sensitive stress, number composition, neural diacritization) stay in code and bind
// these to readable local names (FATHA = marks.fatha, …); only the data lives here.
//
// LOAD-BEARING blocks (read via manifest.ts): "marks", "letters", "consonants", "sunLetters", "proclitics",
// "clausePunctuation", "numbers", "diacritizer". "convention" / "provenance" are self-describing documentation.
{
    "language": "ar",
    "script": ["Arabic"],
    "name": "Arabic (Modern Standard)",
    "provenance": "Cleanroom, rule-based g2p + number compositor (no lexicon). WHICH consonants/letters map where and the number words are language facts. The neural diacritizer MODEL is separately + permissively sourced (CATT teacher Apache-2.0 → Arabic Wikipedia CC-BY-SA silver, no NC/GPL) — see diacritizer.PROVENANCE.md.",

    // The canonical-IPA conventions the values below are written in (documentation; the engine bakes them in).
    "convention": {
        "emphatics": "ˤ on the emphatics sˤ dˤ tˤ ðˤ",
        "pharyngeals": "ʕ (ع) and ħ (ح) — the census-gap pharyngeals",
        "gemination": "shadda → length mark Cː (not doubled CC)",
        "article": "al- with sun/moon assimilation; hamzat-wasl ʔ; a proclitic (وَ بِ …) fuses and the article alif elides",
        "stress": "MSA quantity-sensitive; the mark ˈ precedes the nucleus",
        "taaMarbuta": "ة silent in pausal (phrase-final) form",
        "numbers": "MSA counting / masculine forms; ones precede tens joined by wa; hundreds/thousands use construct + dual forms",
    },

    // Harakat — the Arabic combining marks the parser gathers after a consonant (short vowels, sukun, shadda
    // gemination, the three tanwīn nunations, and the superscript dagger-alif = long /aː/).
    "marks": {
        "fatha": "َ",
        "kasra": "ِ",
        "damma": "ُ",
        "sukun": "ْ",
        "shadda": "ّ",
        "fathatan": "ً",
        "kasratan": "ٍ",
        "dammatan": "ٌ",
        "daggerAlif": "ٰ",
    },

    // Special letters the parser treats specially: the alifs (long /aː/ carriers + madda glottal), tāʾ marbūṭa
    // (silent in pausal form), and the glide letters و/ي (long /uː iː/ or the diphthong glides).
    "letters": {
        "alif": "ا",
        "alifMaqsura": "ى",
        "alifMadda": "آ",
        "taaMarbuta": "ة",
        "waw": "و",
        "ya": "ي",
    },

    // Consonant letter → IPA. Emphatics carry ˤ; pharyngeals ʕ/ħ; every hamza seat (ء أ إ ؤ ئ) → ʔ.
    "consonants": {
        "ب": "b",
        "ت": "t",
        "ث": "θ",
        "ج": "d͡ʒ",
        "ح": "ħ",
        "خ": "x",
        "د": "d",
        "ذ": "ð",
        "ر": "r",
        "ز": "z",
        "س": "s",
        "ش": "ʃ",
        "ص": "sˤ",
        "ض": "dˤ",
        "ط": "tˤ",
        "ظ": "ðˤ",
        "ع": "ʕ",
        "غ": "ɣ",
        "ف": "f",
        "ق": "q",
        "ك": "k",
        "ل": "l",
        "م": "m",
        "ن": "n",
        "ه": "h",
        "و": "w",
        "ي": "j",
        "ء": "ʔ",
        "أ": "ʔ",
        "إ": "ʔ",
        "ؤ": "ʔ",
        "ئ": "ʔ",

        // ── THE PERSO-ARABIC EXTENSION LETTERS, for the sounds the 28-letter alphabet cannot write ────────────
        //
        // ⚠ THESE ARE ORDINARY LETTERS OF THE LANGUAGES THAT USE THEM, NOT DECORATION. Before this block they
        // were in no table and OUTSIDE `arabic.ts`'s TOKEN class, so each one both lost its own sound AND SPLIT
        // ITS WORD IN TWO: ary `السوپر → ˈasw r`, `لݣلونضات → l lwndˤˈaːt`, arz `فین → fˈe nˈuːn` (the fragment
        // ⟨ن⟩ then read as the LETTER NAME nūn). Found by `silentCharsIn` in `separator` mode — ary ⟨ݣ⟩ ×161,
        // ⟨پ⟩ ×119, ⟨ڭ⟩ ×25, ⟨گ⟩ ×6; arz ⟨پ⟩ ×49, ⟨ڤ⟩ ×49, ⟨چ⟩ ×23.
        //
        // Values are the pan-Arabic ones, corroborated word by word in the mined corpora:
        //   پ = /p/   — پاريس, اسپانيا, كليوپاترا, سوپر, پورتوجال, وپاركينݣ
        //   ڤ = /v/   — ڤيينا, بوليڤيا, ݣيڤارا, كوڤيد, ڤييطنام, نوڤاك, سيلڤا
        //   گ ڭ ݣ = /ɡ/ — the three glyphs Maghrebi and Mashriqi writing use for the same sound: ary writes
        //     Guelmim ⟨ݣلميم⟩ AND ⟨گلميم⟩ and Agadir ⟨أݣادير⟩ AND ⟨وأگادير⟩ in the SAME corpus, which is the
        //     evidence that they are one phoneme in three encodings (also أنتيݣوا, لكونݣو, مالاڭا, ݣيطار).
        //     /ɡ/ is a full phoneme of Darija — ⟨ݣاع⟩ gāʕ "all" is a native word, not a loan.
        //   ژ = /ʒ/   — zero in these corpora; listed because it is the Perso-Arabic partner of ⟨چ⟩ and a
        //     missing letter here costs a word, not a segment.
        //   چ = /t͡ʃ/  — the Mashriqi/Maghrebi value (Iraqi چان, Darija چ). ⚠ EGYPTIAN IS THE EXCEPTION AND
        //     SHIFTS IT TO /ʒ/ in egyptian.jsonc: because Egyptian ⟨ج⟩ is already [ɡ], arz uses ⟨چ⟩ for the
        //     foreign [ʒ~d͡ʒ] (چورچ George, چوزيف Joseph, تاچيكستان Tajikistan) and writes [t͡ʃ] as the DIGRAPH
        //     ⟨تش⟩ instead — ادڤانتشر "adventure", دچوكوڤيتش "Djoković" — a contrast the corpus makes itself.
        "پ": "p",
        "چ": "t͡ʃ",
        "ڤ": "v",
        "ژ": "ʒ",
        "گ": "ɡ",
        "ڭ": "ɡ",
        "ݣ": "ɡ",
    },

    // Sun letters: the definite article's ل assimilates into them (gemination); moon letters keep the l.
    "sunLetters": [
        "ت",
        "ث",
        "د",
        "ذ",
        "ر",
        "ز",
        "س",
        "ش",
        "ص",
        "ض",
        "ط",
        "ظ",
        "ل",
        "ن",
    ],

    // Proclitics that fuse with a following article (وَال بِال …) → IPA; the article's hamzat-wasl alif then elides.
    "proclitics": { "و": "w", "ف": "f", "ب": "b", "ك": "k", "ل": "l" },

    // Clause / phrase punctuation (Arabic + ASCII) → canonical inline pause marks.
    "clausePunctuation": {
        "۔": ".",
        ".": ".",
        "!": "!",
        "؟": "?",
        "?": "?",
        "،": ",",
        ",": ",",
        "؛": ",",
        ";": ",",
        ":": ",",
        "…": ",",
    },

    // MSA cardinal number words (IPA). ones precede tens joined by `connector`; hundreds 3–9 use the construct
    // stem + hundred; magnitudes carry singular/dual/plural forms. Composition logic is in numbers.ts.
    "numbers": {
        "ones": [
            "sˤifr",
            "waːħid",
            "iθnaːn",
            "θalaːθa",
            "ʔarbaʕa",
            "xamsa",
            "sitta",
            "sabʕa",
            "θamaːnija",
            "tisʕa",
        ],
        "teens": [
            "ʕaʃara",
            "ʔaħada ʕaʃar",
            "iθnaː ʕaʃar",
            "θalaːθata ʕaʃar",
            "ʔarbaʕata ʕaʃar",
            "xamsata ʕaʃar",
            "sittata ʕaʃar",
            "sabʕata ʕaʃar",
            "θamaːnijata ʕaʃar",
            "tisʕata ʕaʃar",
        ],
        "tens": [
            "",
            "",
            "ʕiʃruːn",
            "θalaːθuːn",
            "ʔarbaʕuːn",
            "xamsuːn",
            "sittuːn",
            "sabʕuːn",
            "θamaːnuːn",
            "tisʕuːn",
        ],
        "hundredsConstruct": [
            "",
            "",
            "",
            "θalaːθu",
            "ʔarbaʕu",
            "xamsu",
            "sittu",
            "sabʕu",
            "θamaːnu",
            "tisʕu",
        ],
        "connector": "wa",
        "magnitudes": {
            "hundred": "miʔa",
            "hundredDual": "miʔataːn",
            "thousand": "ʔalf",
            "thousandDual": "ʔalfaːn",
            "thousandsPlural": "ʔaːlaːf",
            "million": "miljuːn",
            "millionDual": "miljuːnaːn",
            "millionsPlural": "malaːjiːn",
        },
    },

    // Neural-diacritizer data tables (the model + inference live in diacritizer.ts).
    "diacritizer": {
        // Diacritizer output label → the Arabic combining mark it writes.
        "labelMarks": {
            "a": "َ",
            "u": "ُ",
            "i": "ِ",
            "o": "ْ",
            "F": "ً",
            "N": "ٌ",
            "K": "ٍ",
            "^": "ٰ",
        },
        // Defective-spelling closed class: high-frequency words whose long /aː/ is an unwritten dagger-alif.
        // Classical spellings rewritten to their modern form BEFORE the `defectiveSpelling` lookup — the otiose
        // alif of مائة, which reads /miʔa/ and not /maːʔa/. ⚠ A different table from the one below: this maps
        // skeleton→skeleton, that one maps skeleton→diacritized. Without it the ثلاثمئة/أربعمئة entries below
        // cannot be reached from a classically-spelled text.
        "classicalSpelling": { "مائة": "مئة", "مائت": "مئت" },
        "defectiveSpelling": {
            "هذا": "هٰذَا",
            "هذه": "هٰذِهِ",
            "هذان": "هٰذَان",
            "هذين": "هٰذَيْن",
            "ذلك": "ذٰلِكَ",
            "ذلكم": "ذٰلِكُم",
            "كذلك": "كَذٰلِكَ",
            "لكن": "لٰكِن",
            "هؤلاء": "هٰؤُلَاءِ",
            "ثلاثمئة": "ثَلَاثُمِئَة",
            "أربعمئة": "أَرْبَعُمِئَة",
            "خمسمئة": "خَمْسُمِئَة",
            "ستمئة": "سِتْتُمِئَة",
            "سبعمئة": "سَبْعُمِئَة",
            "ثمانمئة": "ثَمَانِمِئَة",
            "تسعمئة": "تِسْعُمِئَة",
        },
    },
}
