// Native canonical-IPA data manifest for Tajik / тоҷикӣ (tg) — Cyrillic.
// Tajik is a variety of Persian (Iranian, SW) written in a CYRILLIC alphabet that — unlike the Perso-Arabic
// abjad our `fa` uses — WRITES ALL ITS VOWELS. So this is a near-phonemic left-to-right Cyrillic scan with NO
// short-vowel restoration (the wall that keeps fa ) — the Kurmanji-vs-Persian advantage.
//
// The ALGORITHMS that read this stay in tajik.ts: the greedy grapheme scan (word-initial / post-vowel е→je,
// iotated ё/ю/я, the special letters), Persian FINAL stress, the tokenizer, and the cardinal-number compositor.
//
// CANONICAL values are adjudicated from three referees (wikipron tgk_cyrl broad + narrow, both human/Wiktionary;
// epitran tgk-Cyrl, programmatic): о→ɔ (broad writes o), а→a (narrow ä, epitran æ), ӯ→ɵ, х→χ (fold x), в→v (narrow
// writes the allophonic w), ҳ→h (narrow's intervocalic ɦ), к→k (narrow marks aspiration kʰ).
{
    "language": "tg",
    "name": "Tajik",
    "script": ["Cyrillic"],
    "provenance": "Authored from the Tajik Cyrillic orthography + standard Tajik (Persian) phonology — a shallow, near-phonemic alphabet, so the native Cyrillic G2P reads this manifest directly. Validated against wikipron tgk_cyrl (broad + narrow, human) and epitran tgk-Cyrl. No short-vowel restoration is needed (Cyrillic writes the vowels), unlike the fa abjad.",

    "convention": {
        "eInitial": "word-initial or post-vowel е → je (Ев→jev); after a consonant → e",
        "sixVowels": "и e а о у ӯ → i e a ɔ u ɵ. о is the Tajik reflex of Persian ā = [ɔ]; ӯ is the mid central rounded [ɵ] (northern dialects; merges with u in the south).",
        "stress": "Persian FINAL stress — the last vowel nucleus of the word carries primary stress",
        "special": "ғ→ʁ, қ→q, ҳ→h, ҷ→d͡ʒ, ӣ→i (stress-marked final и), ъ→ʔ (ayn/hamza)",
        "relabels": "х→χ (uvular), в→v, ч→t͡ʃ, ш→ʃ, ж→ʒ; loan ц→t͡s, щ→ʃt͡ʃ",
    },

    // Plain vowel letters → IPA nucleus (the six-vowel Tajik system).
    "vowels": {
        "а": "a",
        "о": "ɔ",
        "и": "i",
        "ӣ": "i",
        "е": "e",
        "у": "u",
        "ӯ": "ɵ",
        "э": "e",
        "ы": "i",
        // ⚠ TWO CONFUSABLES THE CORPUS ACTUALLY WRITES, and each one LOST A VOWEL from a word without any
        // gate seeing it. `ѝ` (U+045D, и with grave) appears in the artifact's `БЕНЍН` — the Benin headword —
        // and read as *bˈenn*, one syllable short; `ў` (U+045E, the Belarusian/Uzbek short u) arrives in
        // quoted Uzbek (`Ўзбекистон Республикаси`). Neither is a Tajik letter, so neither belongs in the
        // convention above; both are unambiguous in value, which is why they are folded here rather than
        // left to the confusable pass.
        "ѝ": "i",
        "ў": "u",
    },

    // Iotated letters → a fixed IPA sequence (the vowel is the nucleus). й is a pure glide (no nucleus).
    "glides": { "ё": "jɔ", "ю": "ju", "я": "ja", "й": "j" },

    // Consonant letters → canonical IPA (context-free).
    "consonants": {
        "б": "b",
        "в": "v",
        "г": "ɡ",
        "ғ": "ʁ",
        "д": "d",
        "ж": "ʒ",
        "з": "z",
        "к": "k",
        "қ": "q",
        "л": "l",
        "м": "m",
        "н": "n",
        "п": "p",
        "р": "r",
        "с": "s",
        "т": "t",
        "ф": "f",
        "х": "χ",
        "ҳ": "h",
        "ч": "t͡ʃ",
        "ҷ": "d͡ʒ",
        "ш": "ʃ",
        "ц": "t͡s",
        "щ": "ʃt͡ʃ",
        "ъ": "ʔ",
        "ь": "",
    },

    // Tajik cardinal numbers (Persian-based). The compositor in tajik.ts glues them; these are the atoms.
    //
    // ⚠ `milliard` AND `trillion` ARE NOT DECORATION. Without them the compositor's million branch indexed
    // `units[10]` for any n ≥ 10⁹ and produced the literal string "undefinedсад"; the g2p skips Latin letters
    // inside a token, so 1 000 000 000 read as *сад миллион* — one HUNDRED million, a silent 10× error with
    // no marker of any kind. Both words are attested: миллиард ×123 in 20 tg.wikipedia articles ("104
    // миллиард доллар") and ×12 in the mined artifact; триллион in "0,67 триллион метри мукааб".
    "numbers": {
        "units": ["сифр", "як", "ду", "се", "чор", "панҷ", "шаш", "ҳафт", "ҳашт", "нӯҳ"],
        "teens": ["даҳ", "ёздаҳ", "дувоздаҳ", "сездаҳ", "чордаҳ", "понздаҳ", "шонздаҳ", "ҳабдаҳ", "ҳаждаҳ", "нуздаҳ"],
        "tens": { "20": "бист", "30": "сӣ", "40": "чил", "50": "панҷоҳ", "60": "шаст", "70": "ҳафтод", "80": "ҳаштод", "90": "навад" },
        "hundred": "сад",
        "thousand": "ҳазор",
        "million": "миллион",
        "milliard": "миллиард",
        "trillion": "триллион",
        "and": "у",
    },

    // MONTH NAMES, in the IZOFAT form the corpus writes them in — `16 ноябри соли 1992`, `11 октябри соли
    // 2020`, `29 декабри соли 1939`, `28 майи соли 2018`. Used only to read a DOTTED date (1.01.2017), which
    // is otherwise spoken as three separate clauses. `майи` (not *маии*) is the corpus's own spelling and is
    // what fixes the izofat after a vowel.
    "months": ["январи", "феврали", "марти", "апрели", "майи", "июни", "июли", "августи", "сентябри", "октябри", "ноябри", "декабри"],

    // TAJIK CYRILLIC LETTER NAMES, for `core/initialisms.ts`. espeak does not ship Tajik at all, so this
    // table is the Tajik-alphabet name column of en.wikipedia's `Tajik alphabet`, corroborated against
    // tg.wikipedia itself for the three non-obvious entries: `и дароз` (ӣ) appears in *Қоидаҳои имлои
    // забони тоҷикӣ*, `и кӯтоҳ` (й) in seven articles, `аломати сакта` (ъ) in *Апостроф*.
    //
    // ⚠ THE NAMES ARE NOT RUSSIAN'S. Tajik says бе ве ге де for Russian's бэ вэ гэ дэ, ле ме не ре се for
    // эль эм эн эр эс, and has six letters Russian does not (ғе қе ҳе ҷе, и дароз, ӯ). Copying the Russian
    // table would have been the ru-standing-in-for-tg failure this language is most exposed to.
    "letterNames": {
        "а": "а", "б": "бе", "в": "ве", "г": "ге", "ғ": "ғе", "д": "де", "е": "е", "ё": "ё",
        "ж": "же", "з": "зе", "и": "и", "ӣ": "и дароз", "й": "и кӯтоҳ", "к": "ке", "қ": "қе",
        "л": "ле", "м": "ме", "н": "не", "о": "о", "п": "пе", "р": "ре", "с": "се", "т": "те",
        "у": "у", "ӯ": "ӯ", "ф": "фе", "х": "хе", "ҳ": "ҳе", "ч": "че", "ҷ": "ҷе", "ш": "ше",
        "ъ": "аломати сакта", "э": "э", "ю": "ю", "я": "я",
    },

    // LEXICAL: all-caps runs read letter-by-letter although the OOV phonotactic test would pass them as
    // words. Deliberately EMPTY — every caps run the artifact contains is decided correctly by phonotactics
    // alone (ИМА and КАРБОН are readable and stay words; СММ, ММД, ТВ, НБО have no legal Tajik onset and are
    // spelled), and this project does not bulk-invent language data. Add an entry when a corpus instance
    // proves one is needed.
    "acronymLetters": [],

    "clausePunctuation": {
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
        "…": ".",
    },

    "phonotactics": {
        "vowels": "аеёиоуыэюяӣӯ",
        "onsets": [
            "бл", "бр", "гл", "гр", "др", "кл", "кр", "пл", "пр", "сл", "см", "сп", "ст", "тр", "фл", "фр",
            "хл", "хр", "шк", "шл", "шп", "шт", "зв", "св", "тв", "дв", "сн"
        ],
        "codas": [
            "ст", "шт", "фт", "хт", "ҳт", "нт", "нд", "нг", "нҷ", "нч", "нз", "нс", "мб", "мп", "рб", "рд",
            "рг", "рз", "рк", "рқ", "рм", "рн", "рс", "рт", "рф", "рх", "рҳ", "рҷ", "рш", "лб", "лд", "лк",
            "лм", "лт", "лф", "хш", "шк", "зм", "сб", "ск", "ср", "тр", "др", "бр", "гр"
        ]
    }
}
