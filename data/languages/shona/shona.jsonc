// Native canonical-IPA data manifest for Shona / chiShona (sn) — Bantu (S10, Zezuru-based Standard Shona), the
// Latin orthography. A greedy longest-match scan: multi-letter graphemes (whistled sibilants,
// prenasalized clusters, breathy digraphs, affricates) before single letters. Shona syllables are open CV with a
// prenasalized cluster as a single onset unit, so no coda/syllabification logic is needed — a pure left-to-right
// longest-match over the grapheme table suffices. Signature features (grammar-confirmed, Wikipedia Shona phonology):
//   • IMPLOSIVES ⟨b⟩→ɓ, ⟨d⟩→ɗ — the plain letters are implosive; ⟨bh⟩→b̤, ⟨dh⟩→d̤ are the BREATHY-voiced plosives.
//   • WHISTLED sibilants ⟨sv⟩→ȿ, ⟨zv⟩→ɀ (+ the affricate/prenasal series t͡ȿ d͡ɀ ⁿɀ) — a famous Shona distinctive.
//   • PRENASALIZED ⟨mb nd ng nz nj⟩ → ᵐb ⁿd ᵑɡ ⁿz ⁿd͡ʒ (a superscript nasal marks the unit); ⟨ng'⟩ (apostrophe) → ŋ.
//   • BREATHY ⟨mh nh vh zh⟩ → m̤ n̤ v̤ ʒ; ⟨v⟩→ʋ (approximant).
// Tone (H/L) is unwritten and DEFERRED; there is no vowel-length/stress marking. Referee: epitran sna-Latn
// (programmatic, INDEPENDENT — the only substantial Shona source; kaikki has <25 IPA entries) → single-source.
{
    "language": "sn",
    "name": "Shona (chiShona)",
    "script": ["Latin"],
    "provenance": "Authored from the Standard Shona (Zezuru) orthography + phonology (Wikipedia Shona phonology; Doke). Referee: epitran sna-Latn.",

    "convention": {
        "implosives": "⟨b⟩→ɓ, ⟨d⟩→ɗ (plain letters = implosive); ⟨bh⟩→b̤, ⟨dh⟩→d̤ (breathy plosives)",
        "whistled": "⟨sv⟩→ȿ, ⟨zv⟩→ɀ, ⟨tsv⟩→t͡ȿ, ⟨dzv⟩→d͡ɀ, ⟨nzv⟩→ⁿɀ (whistling sibilants — a Shona signature)",
        "prenasalized": "⟨mb nd ng nz nj mv⟩ → ᵐb ⁿd ᵑɡ ⁿz ⁿd͡ʒ ᶬʋ (superscript nasal); ⟨ng'⟩ → ŋ (plain velar nasal)",
        "breathy": "⟨mh nh vh⟩ → m̤ n̤ v̤; ⟨v⟩→ʋ; ⟨zh⟩→ʒ",
        "tone": "H/L tone is unwritten → DEFERRED; no length/stress marking (open CV syllables)"
    },

    // Orthography → canonical IPA. The scanner sorts keys by LENGTH DESC, so trigraphs (ng', tsv, dzv, nzv) win
    // over digraphs (ts, sv, nz) which win over single letters. ⟨sw gw kw mw…⟩ and ⟨ty dy py…⟩ need no entries —
    // ⟨w⟩→w and ⟨y⟩→j fall out of the greedy scan as C+w / C+j (batya→batja, gwara→ɡwara).
    "graphemes": {
        "ng'": "ŋ", "tsv": "t͡ȿ", "dzv": "d͡ɀ", "nzv": "ⁿɀ",

        "ch": "t͡ʃ", "sh": "ʃ", "zh": "ʒ", "ny": "ɲ", "ts": "t͡s", "dz": "d͡z", "pf": "p͡f", "bv": "b͡v",
        "bh": "b̤", "dh": "d̤", "mh": "m̤", "nh": "n̤", "vh": "v̤",
        "sv": "ȿ", "zv": "ɀ",
        "mb": "ᵐb", "nd": "ⁿd", "ng": "ᵑɡ", "nz": "ⁿz", "nj": "ⁿd͡ʒ", "mv": "ᶬʋ",

        "b": "ɓ", "d": "ɗ", "p": "p", "t": "t", "k": "k", "g": "ɡ", "f": "f", "s": "s", "z": "z",
        "v": "ʋ", "m": "m", "n": "n", "r": "r", "l": "l", "w": "w", "y": "j", "h": "h", "j": "d͡ʒ",

        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // Cardinal number words (Standard Shona).
    //
    // ⚠ NOUN-CLASS CONCORD REACHES INSIDE A SHONA NUMERAL, and it does so in TWO slots that are NOT the same
    // problem. Measured over the mined artifact and sn.wikipedia (see docs/investigations/):
    //
    //   1. THE MAGNITUDE SLOT is computable and is fixed here. `makumi` and `mazana` are class-6 nouns and
    //      `zviuru` is class 8, so the numeral counting them takes that class's prefix REGARDLESS of what the
    //      whole phrase counts: `makumi maviri` (20), `mazana mana` (400), `zviuru zvisere` (8000). The
    //      corpus writes the ma- form 20 times out of 20 after `makumi`/`mazana` and never the bare stem, and
    //      sn.wikipedia glosses the zvi- forms against digits — `makiromita ezvuruzvisere (8000km)`,
    //      `ezvuruzvinomwe-nemazanamana (7,400km)`, `zviuru zvina` (four thousand).
    //   2. THE TRAILING UNIT SLOT agrees with the HEAD NOUN, which this layer cannot see (playbook trap 14 —
    //      a digit becomes words downstream of every rule, so there is nothing to agree with). One corpus
    //      sentence writes each of `makumi manomwe ne MAVARI` (72), `makumi matanhatu ne ZVINA` (64),
    //      `makumi mapfumbamwe ne VANOMWE` (97). Left as the bare RECITATION stem, which is what a digit read
    //      out of context is — sn.wikipedia states that series explicitly: *"Aya mazwi anoshandiswa pakurava
    //      sokuti: poshi, piri; tatu; ina; shanu; zvichingodaro"*.
    //
    // ⚠ `churu` WAS THE THOUSAND WORD HERE AND IT IS THE ANTHILL. `attest.ts --lang sn --words churu` returns
    // 33 tokens across 20 articles and every readable one is the mound — *"Churu kana chidzere (anthill) murwi
    // wevhu unovakwa nemuchenje"*, plus a comparative-Bantu list of other languages' anthill words. The
    // thousand is `chiuru`, 36 tokens / 20 articles and definitionally glossed: *"Chiuru (thousand) zvinoreva
    // mazana gumi"*, *"1,000 = chiuru"*. Same shape as zu's `amaphuzu` and rn's `kare`.
    "numbers": {
        "units": ["zero", "motsi", "piri", "tatu", "ina", "shanu", "tanhatu", "nomwe", "sere", "pfumbamwe"],
        // The class-6 (ma-) and class-8 (zvi-) concord series, indexed 2–9. Slots 0 and 1 are unused: a
        // magnitude of one is the SINGULAR noun (`gumi`, `zana`, `chiuru`), never "one ten".
        // Attested directly: ma- all eight; zvi- viri/tatu/na/tanhatu/nomwe/sere. `zvishanu` and
        // `zvipfumbamwe` are COMPOSED from the productive class-8 prefix and the attested stems — the
        // playbook's "prefer composing from the language's morphology" over tabulating what was seen.
        "unitsMa": ["", "", "maviri", "matatu", "mana", "mashanu", "matanhatu", "manomwe", "masere", "mapfumbamwe"],
        "unitsZvi": ["", "", "zviviri", "zvitatu", "zvina", "zvishanu", "zvitanhatu", "zvinomwe", "zvisere", "zvipfumbamwe"],
        "ten": "gumi",
        "tens": "makumi",
        "hundred": "zana",
        "hundreds": "mazana",
        "thousand": "chiuru",
        "thousands": "zviuru",
        // Million and billion, in the same MAGNITUDE-then-COUNT order as `zviuru` and with the same class-6
        // concord. The corpus's own worked reading of 431,257,698 supplies both the words and the order:
        // *"MAMIRIYONI mazana mana ane makumi matatu neimwe, ZVIURU mazana maviri ane makumi mashanu
        // nenomwe, mazana matanhatu ane makumi mapfumbamwe nesere"*. Corroborated by `matani 25 miriyoni`,
        // `mamiriyoni 210`, `mabhiriyoni makumi maviri nematatu emadhora`, and sn.wikipedia's
        // *"kusvika kumabhiriyoni maviri"*. `miriyoni` singular is glossed there too: *"Miriyoni (1,000,000)
        // zvinoreva chiuru chezviuru"*.
        "million": "miriyoni",
        "millions": "mamiriyoni",
        "billion": "bhiriyoni",
        "billions": "mabhiriyoni",
        "and": "ne"
    }
}
