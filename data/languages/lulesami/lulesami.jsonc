// Native canonical-IPA data manifest for Lule Sami (smj) — julevsámegiella, Uralic (Saami branch),
// ~700–2000 speakers (Norway/Sweden), the 1983 Latin orthography. The engine (lulesami.ts) is AUTHORED
// FROM Ylikoski, "Lule Saami" (a published reference chapter) — a TRANSPARENT SEGMENTAL grapheme scan.
//   · VOWELS /i u e o ɑ/ + diphthongs ⟨ie uo oa⟩: ⟨a⟩→ɑ, ⟨á⟩→ɑː (the one written length contrast), ⟨å⟩→o,
//     ⟨æ/ä⟩→æ, loan ⟨y⟩→y ⟨ø/ö⟩→ø. Most vowel LENGTH is UNWRITTEN, so it is not emitted.
//   ⚠ THE ORTHOGRAPHY TRAP (North-Saami-style): word-initial ⟨b d g⟩ are VOICELESS UNASPIRATED [p t k],
//     NOT voiced — bena=[peːnə], giella=[kiellɑ]. ⟨p t k⟩ are the marginal ASPIRATED series [pʰ tʰ kʰ],
//     found only WORD-INITIALLY in loans (§9.2.2); medially and in clusters they are PLAIN [p t k]
//     (Table 9.5: bargo=[parkuo]) — the initial-aspiration rule is code, in lulesami.ts.
//   · CONSONANTS: ⟨sj⟩→ʃ, ⟨tj⟩→t͡ʃ, ⟨ts⟩→t͡s, ⟨dtj⟩→d͡ʒ, ⟨dts⟩→d͡z, ⟨nj⟩→ɲ, ⟨ŋ⟩→ŋ, ⟨ddj⟩→ɟː; ⟨lj⟩→ʎ renders
//     the grammar's /lj/ SEQUENCE (Ylikoski has no phonemic /ʎ/). Doubled → geminate [Cː]; pre-stop ⟨h⟩
//     (⟨hk hp ht⟩) is the gradation/pre-aspiration marker. Primary stress = the FIRST syllable.
// DEFERRED, because none of it is recoverable from a segmental scan (§9.2.5): the 3-grade consonant
// gradation, epenthetic vowels, labial harmony, 2nd-syllable lengthening, and unwritten length.
{
    "language": "smj",
    "name": "Lule Sami (julevsámegiella)",
    "script": ["Latin"],

    // Multi-letter graphemes, LONGEST-FIRST (trigraphs → digraphs → geminate doubles). ⟨dtj dts⟩ = the
    // voiced affricates (geminate-only); ⟨ssj ttj tts nnj llj⟩ = the palatal/sibilant geminates;
    // ⟨ie uo oa⟩ = diphthongs.
    "multigraphs": [
        ["ddj", "ɟː"], ["dtj", "d͡ʒ"], ["dts", "d͡z"],
        ["ssj", "ʃː"], ["ttj", "t͡ʃː"], ["tts", "t͡sː"], ["nnj", "ɲː"], ["llj", "ʎː"],
        ["sj", "ʃ"], ["tj", "t͡ʃ"], ["ts", "t͡s"], ["nj", "ɲ"], ["lj", "ʎ"], ["dj", "ɟ"],
        ["ie", "ie"], ["uo", "uo"], ["oa", "oɑ"],
        ["bb", "pː"], ["dd", "tː"], ["gg", "kː"], ["pp", "pː"], ["tt", "tː"], ["kk", "kː"],
        ["mm", "mː"], ["nn", "nː"], ["ll", "lː"], ["rr", "rː"], ["vv", "vː"], ["ss", "sː"], ["ff", "fː"],
    ],

    // Single graphemes → IPA. ⟨b d g⟩ = VOICELESS UNASPIRATED [p t k]; ⟨p t k⟩ are PLAIN here
    // (word-initial aspiration is applied in lulesami.ts). c/q/w/x/z are loan letters (Scandinavian)
    // adapted to the nearest phoneme.
    "letters": {
        "a": "ɑ", "á": "ɑː", "å": "o", "e": "e", "i": "i", "o": "o", "u": "u", "æ": "æ", "ä": "æ",
        "ø": "ø", "ö": "ø", "y": "y",
        "b": "p", "d": "t", "g": "k", "p": "p", "t": "t", "k": "k",
        "m": "m", "n": "n", "ŋ": "ŋ", "r": "r", "l": "l", "v": "v", "j": "j", "f": "f", "h": "h", "s": "s",
        "c": "k", "q": "k", "w": "v", "x": "ks", "z": "s",
    },
}
