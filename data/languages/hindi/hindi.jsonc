// Native canonical-IPA definition for Hindi (hi) — re-derived from the Devanagari orthography and
// standard Hindi phonology. A shallow abugida — pronunciation is almost entirely rule-derivable.
// This file IS the language data: the native G2P engine (src/Phonemize/native/nativeG2p.ts) reads it
// directly. Devanagari is a shallow abugida, so pronunciation is almost entirely rule-derivable; the
// only genuinely hard part is schwa deletion (handled by a documented algorithm, not a lexicon).
//
// Format: plain JSONC. Verbose, self-describing keys. Every phoneme value is CANONICAL IPA.
{
    "language": "hi",
    "name": "Hindi",
    "script": ["Devanagari"],
    "provenance": "Authored from the Unicode Devanagari chart + standard Hindi phonology. This file IS the language data — the native G2P engine reads it directly.",

    // The vowel inserted after a consonant that has no explicit vowel sign and no virama (the abugida
    // 'inherent vowel'). Hindi's is the schwa /ə/. Its deletion (below) is the one non-trivial rule.
    "inherentVowel": "ə",

    // Consonant letters → canonical IPA. `note` documents the phonological class + any referee decision.
    "consonants": {
        "क": { "ipa": "k", "note": "velar stop, voiceless" },
        "ख": { "ipa": "kʰ", "note": "velar stop, voiceless aspirated" },
        "ग": { "ipa": "ɡ", "note": "velar stop, voiced" },
        "घ": { "ipa": "ɡʱ", "note": "velar stop, voiced breathy" },
        "ङ": { "ipa": "ŋ", "note": "velar nasal" },
        "च": {
            "ipa": "t͡ʃ",
            "note": "post-alveolar affricate, voiceless (Hindi च = t͡ʃ, cf. Bengali t͡ɕ)",
        },
        "छ": {
            "ipa": "t͡ʃʰ",
            "note": "post-alveolar affricate, voiceless aspirated",
        },
        "ज": { "ipa": "d͡ʒ", "note": "post-alveolar affricate, voiced" },
        "झ": {
            "ipa": "d͡ʒʱ",
            "note": "post-alveolar affricate, voiced breathy",
        },
        "ञ": { "ipa": "ɲ", "note": "palatal nasal" },
        "ट": { "ipa": "ʈ", "note": "retroflex stop, voiceless" },
        "ठ": { "ipa": "ʈʰ", "note": "retroflex stop, voiceless aspirated" },
        "ड": { "ipa": "ɖ", "note": "retroflex stop, voiced" },
        "ढ": { "ipa": "ɖʱ", "note": "retroflex stop, voiced breathy" },
        "ण": { "ipa": "ɳ", "note": "retroflex nasal" },
        "त": {
            "ipa": "t̪",
            "note": "DENTAL stop, voiceless (t̪ vs retroflex ट=ʈ — the core coronal contrast)",
        },
        "थ": { "ipa": "t̪ʰ", "note": "dental stop, voiceless aspirated" },
        "द": { "ipa": "d̪", "note": "dental stop, voiced" },
        "ध": { "ipa": "d̪ʱ", "note": "dental stop, voiced breathy" },
        "न": { "ipa": "n", "note": "dental/alveolar nasal" },
        "प": { "ipa": "p", "note": "labial stop, voiceless" },
        "फ": { "ipa": "pʰ", "note": "labial stop, voiceless aspirated" },
        "ब": { "ipa": "b", "note": "labial stop, voiced" },
        "भ": { "ipa": "bʱ", "note": "labial stop, voiced breathy" },
        "म": { "ipa": "m", "note": "labial nasal" },
        "य": { "ipa": "j", "note": "palatal approximant" },
        "र": { "ipa": "ɾ", "note": "alveolar tap" },
        "ल": { "ipa": "l", "note": "alveolar lateral" },
        "व": { "ipa": "ʋ", "note": "labiodental approximant" },
        "श": { "ipa": "ʃ", "note": "post-alveolar sibilant" },
        "ष": {
            "ipa": "ʃ",
            "note": "etymological retroflex ष, MERGED to [ʃ] in modern Hindi (wikipron hin ʃ 2519 : ʂ 123)",
        },
        "स": { "ipa": "s", "note": "alveolar sibilant" },
        "ह": { "ipa": "ɦ", "note": "voiced glottal fricative (Hindi ह = ɦ)" },
        "ळ": {
            "ipa": "ɭ",
            "note": "retroflex lateral (rare, mainly loans/Marathi)",
        },
        // Nukta letters (borrowed/Perso-Arabic sounds)
        "क़": { "ipa": "q", "note": "uvular stop (nukta क)" },
        "ख़": { "ipa": "x", "note": "velar fricative voiceless (nukta ख)" },
        "ग़": { "ipa": "ɣ", "note": "velar fricative voiced (nukta ग)" },
        "ज़": { "ipa": "z", "note": "alveolar sibilant voiced (nukta ज)" },
        "ड़": { "ipa": "ɽ", "note": "retroflex flap (nukta ड)" },
        "ढ़": { "ipa": "ɽʱ", "note": "retroflex flap breathy (nukta ढ)" },
        "फ़": { "ipa": "f", "note": "labiodental fricative (nukta फ)" },
        "य़": { "ipa": "j", "note": "ya with nukta" },
    },

    // Independent vowel letters (word-initial / standalone).
    "independentVowels": {
        "अ": { "ipa": "ə", "note": "short central (schwa)" },
        "आ": { "ipa": "aː", "note": "long open" },
        "इ": { "ipa": "ɪ", "note": "short near-close front" },
        "ई": { "ipa": "iː", "note": "long close front" },
        "उ": { "ipa": "ʊ", "note": "short near-close back" },
        "ऊ": { "ipa": "uː", "note": "long close back" },
        "ऋ": {
            "ipa": "ɾɪ",
            "note": "vocalic r (Sanskrit; realized ɾɪ in Hindi)",
        },
        "ए": { "ipa": "eː", "note": "long close-mid front" },
        "ऐ": {
            "ipa": "ɛː",
            "note": "long open-mid front (historic diphthong ai)",
        },
        "ओ": { "ipa": "oː", "note": "long close-mid back" },
        "औ": {
            "ipa": "ɔː",
            "note": "long open-mid back (historic diphthong au)",
        },
        "ऍ": { "ipa": "ɛː", "note": "candra e (loans)" },
        "ऑ": { "ipa": "ɔː", "note": "candra o (loans, e.g. English 'o')" },
        "ॐ": { "ipa": "õːm", "note": "Om sign (U+0950) — a whole syllable" },
    },

    // Dependent vowel signs (matras) — replace the inherent vowel on the preceding consonant.
    "vowelSigns": {
        "ा": { "ipa": "aː" },
        "ि": { "ipa": "ɪ" },
        "ी": { "ipa": "iː" },
        "ु": { "ipa": "ʊ" },
        "ू": { "ipa": "uː" },
        "ृ": { "ipa": "ɾɪ" },
        "े": { "ipa": "eː" },
        "ै": { "ipa": "ɛː" },
        "ो": { "ipa": "oː" },
        "ौ": { "ipa": "ɔː" },
        "ॅ": { "ipa": "ɛː" },
        "ॉ": { "ipa": "ɔː" },
    },

    // Combining signs with special effects.
    "signs": {
        "virama": {
            "char": "्",
            "effect": "suppressInherentVowel",
            "note": "halant — the consonant carries no vowel (forms clusters/conjuncts)",
        },
        "anusvara": {
            "char": "ं",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel (canonical Hindi + wikipron: कांग्रेस→kãɡɾeːs, not a homorganic nasal consonant). Nasal vowels are short.",
        },
        "chandrabindu": {
            "char": "ँ",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel",
        },
        "visarga": { "char": "ः", "effect": "appendH", "note": "→ [h]" },
        "nukta": {
            "char": "़",
            "effect": "composeNukta",
            "note": "combines with the preceding consonant (decomposed form) into the nukta letter",
        },
    },

    // Schwa deletion — the one hard rule. Hindi deletes the inherent schwa word-finally (except
    // monosyllables) and medially in a VCəCV context (Ohala 1983), applied right-to-left after the
    // final deletion. The engine implements this; parameters are declared here for transparency.
    "schwaDeletion": {
        "deleteWordFinal": true,
        "retainInMonosyllable": true,
        "medialRule": "ohala-VCaCV",
        "note": "Final-first, then medial VCəCV → VCCV right-to-left. भारत → bʱaːɾət̪ (medial ə RETAINED because the following त̪ is word-final, no CV context).",
    },

    // Post-rules applied to the raw akshara IPA (declarative, ordered regex — portable). Geminate→length
    // is the fleet-wide Indic convention; the offglide + अय→ɛ are systematic Hindi realizations.
    "postRules": [
        {
            "from": "d͡ʒɲ",
            "to": "ɡj",
            "note": "⚠ ज्ञ IS NOT ITS PARTS. Composing ज (d͡ʒ) + ् + ञ (ɲ) literally gives d͡ʒɲ, which is not how Modern Standard Hindi says this ligature — it is /ɡj/: ज्ञान gyaan, विज्ञान vigyaan, वैज्ञानिक vaigyaanik, ज्ञात gyaat, विशेषज्ञ visheshagya. 73 of 73 FLEURS hi_in rows containing ज्ञ were wrong, and the recognizer heard `ɡ i a t` where we wrote `d͡ʒɲˈaːt̪`. ⚠ SCOPED TO HINDI DELIBERATELY: Marathi reads the same ligature as `dnya` (dnyaan), so this must not move to the shared Devanagari layer or to marathi.jsonc. Awadhi/Bhojpuri/Magahi likely pattern with Hindi but have no corpus evidence here, so they are left alone.",
        },
        {
            "from": "((?:t͡ʃʰ|d͡ʒʱ|t͡ʃ|d͡ʒ|t̪ʰ|d̪ʱ|[kɡptbmnlʃsɳŋɽ]ʰ?ʱ?|t̪|d̪))\\1(?!͡)",
            "to": "$1ː",
            "note": "geminate → single + length (क्क→kː, च्च→t͡ʃː)",
        },
        {
            "from": "ː([ʰʱ])",
            "to": "$1ː",
            "note": "aspiration-before-length reorder: differing-aspiration conjunct द्ध→d̪ːʱ→d̪ʱː (fleet convention, matches bn/si); avoids stranding ʰ/ʱ after the length mark (युद्ध बुद्ध अच्छा पत्थर)",
        },
    ],
    // Final conventions applied AFTER schwa deletion.
    "finalRules": [
        {
            "from": "ɪ([eɛoɔaə]ː?)",
            "to": "ɪʲ$1",
            "note": "और i-offglide before a vowel (intentional; disambiguates)",
        },
        {
            "from": "ə(j)$",
            "to": "ɛ$1",
            "note": "word-final अय → ɛj (समय→səmɛj)",
        },
        {
            "from": "ə(ɦ)ə",
            "to": "ɛ$1ɛ",
            "note": "schwa-lowering around intervocalic ɦ: əɦə→ɛɦɛ (शहर→ʃɛɦɛɾ, जहर→d͡ʒɛɦɛɾ); referee-validated 24/0, wikipron-narrow",
        },
    ],

    // NUMBERS — authored Devanagari SPELLINGS (public-fact numerals); the canonical IPA is DERIVED by
    // running these through the same native G2P (no hand-written phonemes). The
    // compositor (src/Phonemize/native/abugidaNumbers.ts) assembles them with Indian lakh/crore grouping.
    // NOTE: Hindi 21-99 are IRREGULAR (not compositional — इक्कीस ≠ इक+बीस); the round tens + 0-20 +
    // magnitudes are here; the ~80 irregular 21-99 spellings are a bounded remaining authoring task.
    "numbers": {
        "units": [
            "शून्य",
            "एक",
            "दो",
            "तीन",
            "चार",
            "पाँच",
            "छह",
            "सात",
            "आठ",
            "नौ",
        ],
        "teens": [
            "दस",
            "ग्यारह",
            "बारह",
            "तेरह",
            "चौदह",
            "पंद्रह",
            "सोलह",
            "सत्रह",
            "अठारह",
            "उन्नीस",
        ],
        "tens": {
            "20": "बीस",
            "30": "तीस",
            "40": "चालीस",
            "50": "पचास",
            "60": "साठ",
            "70": "सत्तर",
            "80": "अस्सी",
            "90": "नब्बे",
        },
        "compound": {
            "21": "इक्कीस",
            "22": "बाईस",
            "23": "तेईस",
            "24": "चौबीस",
            "25": "पच्चीस",
            "26": "छब्बीस",
            "27": "सत्ताईस",
            "28": "अट्ठाईस",
            "29": "उनतीस",
            "31": "इकतीस",
            "32": "बत्तीस",
            "33": "तैंतीस",
            "34": "चौंतीस",
            "35": "पैंतीस",
            "36": "छत्तीस",
            "37": "सैंतीस",
            "38": "अड़तीस",
            "39": "उनतालीस",
            "41": "इकतालीस",
            "42": "बयालीस",
            "43": "तैंतालीस",
            "44": "चवालीस",
            "45": "पैंतालीस",
            "46": "छियालीस",
            "47": "सैंतालीस",
            "48": "अड़तालीस",
            "49": "उनचास",
            "51": "इक्यावन",
            "52": "बावन",
            "53": "तिरेपन",
            "54": "चौवन",
            "55": "पचपन",
            "56": "छप्पन",
            "57": "सत्तावन",
            "58": "अट्ठावन",
            "59": "उनसठ",
            "61": "इकसठ",
            "62": "बासठ",
            "63": "तिरेसठ",
            "64": "चौंसठ",
            "65": "पैंसठ",
            "66": "छियासठ",
            "67": "सड़सठ",
            "68": "अड़सठ",
            "69": "उनहत्तर",
            "71": "इकहत्तर",
            "72": "बहत्तर",
            "73": "तिहत्तर",
            "74": "चौहत्तर",
            "75": "पचहत्तर",
            "76": "छिहत्तर",
            "77": "सतहत्तर",
            "78": "अठहत्तर",
            "79": "उनासी",
            "81": "इक्यासी",
            "82": "बयासी",
            "83": "तिरासी",
            "84": "चौरासी",
            "85": "पचासी",
            "86": "छियासी",
            "87": "सत्तासी",
            "88": "अट्ठासी",
            "89": "नवासी",
            "91": "इक्यानवे",
            "92": "बानवे",
            "93": "तिरानवे",
            "94": "चौरानवे",
            "95": "पंचानवे",
            "96": "छियानवे",
            "97": "सत्तानवे",
            "98": "अट्ठानवे",
            "99": "निन्यानवे",
        },
        "magnitudes": {
            "hundred": "सौ",
            "thousand": "हज़ार",
            "lakh": "लाख",
            "crore": "करोड़",
        },
        "grouping": "indian-lakh-crore",
        "decimalWord": "दशमलव",
    },

    // Symbol → spoken word (read AFTER the preceding number in reading order: 50% → पचास प्रतिशत).
    // ⚠ `stripSymbols` NO LONGER REACHES ₹. The shared currency tier claims the sign first and reads it
    // as रुपये, matching what $ and € already did here. The declaration is kept because the mechanism is
    // live for other characters, but the ₹ entry is now inert — and that is the right outcome: dropping a
    // currency sign is the classic silent-loss defect, and before the registry folded native digits the two digit
    // systems disagreed (₹500 read रुपये, ₹५०० did not).
    "symbols": { "%": "प्रतिशत" },
    "stripSymbols": "₹",

    // Clause / phrase punctuation → canonical inline pause marks (Devanagari danda ।/॥ + ASCII).
    "clausePunctuation": {
        "।": ".",
        "॥": ".",
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Nasalization does NOT change vowel length: the WikiPron hin_deva narrow referee keeps nasal vowels
    // long (नहीं→nɐɦĩː, कांग्रेस→kãːŋ, यहाँ→jɐɦãː, गांव→ɡãː), so a long vowel + anusvara/chandrabindu stays
    // long (kaː̃) and a short one stays short (गंगा→ɡə̃ŋ). Setting this false keeps the length mark.
    "nasalVowelsAreShort": false,

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, one name fleet-wide — `symbols` above is the BARE-SIGN → word map the
    // tokenizer reads. Two tables, two passes.
    "symbolTier": {
        // ⚠ Declaring `multiply` HERE is what makes ASCII `x` read like `×`: otherwise `6x6 cm` reads the `x` as a
        // LETTER NAME, and `NxN` is the commoner written form. One word, so `by` defaults to it — Hindi does not
        // split dimension from product.
        "multiply": { "times": "गुणा" },
        "percent": ["प्रतिशत"],
        // ⚠ `¢` IS ROBUSTNESS, NOT ATTESTATION, and the one place it surfaces is almost certainly CORRUPT: a
        // sentence about a VERNIER SCALE (`२०¢ या १०¢ तक`), which reads arc-seconds rather than money — and a second
        // copy of the same sentence carries `²` in that slot. Two different characters in one position across two
        // copies is the signature of an OCR corruption of `″`. Declared anyway, because the engine's job is to read
        // the character it is given and a dropped sign is INAUDIBLE. `सेंट` is the ordinary Hindi form of the
        // currency name — plain lexis, so no later pass should credit a corpus with it.
        "currency": { "$": ["डॉलर"], "€": ["यूरो"], "£": ["पाउंड"], "₹": ["रुपये"], "¥": ["येन"], "¢": ["सेंट"] },
        // `m` — मीटर ×8, and digit-adjacent bare `m` is ×0 in this corpus, so the one-letter-key hazard is
        // checked rather than assumed. `घन` was declared below but unreachable without it: the exponent branch
        // resolves the unit from `units` first, so `5 m³` read as the bare letter *ˈɛm*.
        // ⚠ ⟨g⟩ ⟨l⟩ ⟨L⟩ ⟨ha⟩ WERE MIS-READING, NOT LEAKING — `10 ha` read *d̪ˈəs hˈɑː* and `10 l` *d̪ˈəs ˈɛɫ*,
        // the English letter name, out of a Devanagari engine. `tools/normalization/misread.ts` is the probe.
        //   लीटर     85/20  the litre article NAMES BOTH SYMBOLS: "लीटर आयतन की मात्रक है। इसके दो आधिकारिक
        //                   चिह्न (ℓ) और (L) हैं" — and writes them in use, "1 L ≡ 1 dm3", "मोल प्रति लीटर (mol/L)"
        //   हेक्टेयर  74/14  every example a digit-adjacent area glossed against acres — "1,281.67 हेक्टेयर
        //                   (3,167.1 एकड़)", "2,266.69 हेक्टेयर (5,601.1 एकड़)"
        //   ग्राम    130/10  the gram article, definitional — "ग्राम (… इसे gramme भी लिखा जाता है; एस आई इकाई…)"
        // ⚠ हेक्टर IS NOT THE WORD, and it probes better than the one that is (56 tokens / 12 arts). It is
        // HECTOR, the Trojan prince — "यूनानी मिथों के अनुसार 'हेक्टर' एक ट्रोजन सेनापति और राजकुमार था". The
        // hectare is हेक्टेयर, and taking the higher count would have put a mythological name in the unit slot.
        // ⚠ ग्राम IS A HOMOGRAPH and most of its 130 tokens are the OTHER sense — ग्राम पंचायत, "village
        // council". That is harmless HERE and would not be in a lexicon: this key emits the word only after a
        // number, where Hindi's village is not a possible reading, and the unit sense is the one the gram
        // article itself defines. The count is not the evidence; the definitional hit is.
        // ⚠ THIS TIER IS INHERITED BY SEVEN OTHER LANGUAGES, so these four keys are declared for them too.
        // `makeNativeHindi` resolves `overrides.symbols ?? SYMBOLS`, and awa, bgc, bho, hne, mag, mai and rkt
        // pass no override — mr is the one rider that does. Adding a key here therefore declares a word for
        // eight engines from ONE wiki's evidence, and it is stated rather than left to be discovered: the
        // words below are sourced from hi.wikipedia and were NOT separately attested against Awadhi, Haryanvi,
        // Bhojpuri, Chhattisgarhi, Magahi, Maithili or Rangpuri. That is the same footing the pre-existing
        // km/cm/mm/kg have stood on since they were declared, and the alternative — eight tiers differing only
        // in which SI units they omit — is worse. A rider that writes a different word should override.
        // ⚠ ONE-LETTER KEYS MEASURED (trap 46): over the artifact `<digit> g`, `<digit> l`, `<digit> L` are ×0
        // apiece, matching the bare-`m` check the line below already records, and Hindi declares no
        // `magnitudes`, so no ligature can put a stray letter where the tier expects a unit.
        // ⚠ `nm` WAS ADDED FROM A MAGAHI LEAK, NOT A HINDI ONE, and that is the clearest demonstration of the
        // inheritance note above. mag's artifact carries `एकर तरङ्गदैर्घ्य ५७०–५८० nm हे` — the visible-light
        // wavelength, in the colour article — and it read *… pˈɑ̃t͡ʃ sˈɔ ˈʌsːi nm* with the symbol echoed raw.
        // mag has no symbol tier of its own; it is this one. hi's own artifact contains no `nm` at all, so the
        // key could only ever have been found from a rider, and fixing it in the rider was never an option.
        // SOURCING, and hi.wikipedia GLOSSES THE SYMBOL ITSELF: the नैनोमीटर article opens
        // "नैनोमीटर (प्रतीक: नैमी या nm)" — the language's own statement that ⟨nm⟩ denotes this word — and the
        // word is in digit-adjacent use across unrelated articles ("380 नैनोमीटर से 750 नैनोमीटर तरंगदर्घ्य",
        // "1000 नैनोमीटर के तरंगदैघ्य पर 0.17 नैनोमीटर"). `attest.ts --lang hi`: 6 examples, every one the unit.
        // ⚠ नेनोमीटर IS A REAL VARIANT AND IS NOT DECLARED. It probes ×1, in a gloss of the symbol itself
        // ("100 nm (100 नेनोमीटर)"), against the article-title spelling with the ऐ. One form, the fuller lemma.
        "units": { "km": ["किलोमीटर"], "cm": ["सेंटीमीटर"], "mm": ["मिलीमीटर"], "kg": ["किलोग्राम"], "m": ["मीटर"],
            "g": ["ग्राम"], "l": ["लीटर"], "L": ["लीटर"], "ha": ["हेक्टेयर"], "nm": ["नैनोमीटर"] },
        // `km²` → वर्ग किलोमीटर. Undeclared, the tier left the whole match alone and `km²` reached the IPA as a
        // Latin fragment — `5 km²` read as *pˈaː̃t͡ʃ ˈʊkm*, worse than the raw text, and the review gate could not
        // flag it as a DROP because deleting the `²` changes the output.
        // वर्ग is corpus-attested in exactly this slot: "यह पार्क 19,500 वर्ग किलोमीटर में फैला है". घन is the
        // formal counterpart; the corpus writes the loan क्यूबिक once ("120-160 क्यूबिक मीटर ईंधन"), which is
        // what a speaker may say but not what the notation should compose to.
        // `before`, not `compound`: Hindi sets the measure word off with a space, and one form each because the
        // word does not agree with its count here.
        "exponentWords": { "squared": ["वर्ग"], "cubed": ["घन"], "position": "before" },
        // BARE EXPONENT — the reading for a power with NO unit to modify (`20²`, `mc²`), which every language
        // in the fleet was dropping silently. See `bareExponent` in core/normalizeSymbols.ts for why this cannot
        // reuse `exponentWords` above: that is the unit MODIFIER and this is the PREDICATE, and in most languages
        // they are different words (वर्ग किलोमीटर but बीस का वर्ग).
        // ⚠ PROVENANCE, stated because it is weaker than most data in this repo: these are STANDARD MATHEMATICAL
        // REGISTER, not corpus attestations. The power words are ×0 in this language's artifact, and the apparent
        // hits for other languages were substring traps of exactly the kind tools/normalization/attest.ts warns
        // about — th `กำลัง` matched the progressive-aspect marker, fa `توان` and ar `أس` matched inside unrelated
        // words. FLEURS is news and encyclopedia prose and simply does not contain spoken arithmetic.
        // The cardinal is used for the generic power, never the ordinal — see core for that argument.
        "bareExponent": { "squared": "{n} का वर्ग", "cubed": "{n} का घन", "power": "{n} की घात {e}" , "negative": "ऋण" }
    }
}
