// Native canonical-IPA data manifest for Hungarian / magyar (hu) — Uralic (Finno-Ugric), Latin script. Hungarian
// orthography is deep-ish but REGULAR: a longest-match scan (trigraphs/digraphs before single letters) resolves
// the digraphs and their GEMINATE forms (written by doubling the digraph's FIRST letter: sz→s but ssz→[sː],
// gy→ɟ but ggy→[ɟː]). hungarian.ts reads this table, then collapses doubled single consonants to length and adds
// FIXED first-syllable stress. Signature: ⟨s⟩→[ʃ] / ⟨sz⟩→[s] (the reverse of the intuition), ⟨gy⟩→[ɟ] ⟨ty⟩→[c]
// (palatal stops), ⟨a⟩→[ɒ], a full long/short vowel system (14 vowels).
{
    "language": "hu",
    "name": "Hungarian (magyar)",
    "script": ["Latin"],
    "provenance": "Authored from Hungarian orthography + phonology (regular, near-phonemic). This file IS the language data — the g2p reads it directly. Referees: wikipron hun_latn narrow + epitran hun-Latn.",

    "convention": {
        "sibilants": "⟨s⟩→ʃ, ⟨sz⟩→s (the reverse of the naive reading); ⟨zs⟩→ʒ, ⟨z⟩→z",
        "palatals": "⟨gy⟩→ɟ, ⟨ty⟩→c (palatal stops); ⟨ny⟩→ɲ; ⟨ly⟩→j (merged with ⟨j⟩)",
        "vowels": "long/short + front/back-round: a ɒ / á aː, e ɛ / é eː, o o / ó oː, ö ø / ő øː, u u / ú uː, ü y / ű yː, i i / í iː",
        "gemination": "a geminate digraph doubles the FIRST letter (ssz=[sː], ggy=[ɟː], nny=[ɲː]); a doubled single consonant → Cː",
        "stress": "FIXED first-syllable (Hungarian); vowel length is independent of stress",
    },

    // ⚠ THE VOICING-ASSIMILATION TRIGGERS. Hungarian assimilates a whole obstruent cluster to the LAST
    // member's voicing, so the engine needs both directions. These are Hungarian's own inventories — the
    // palatal stops ⟨c ɟ⟩ are members here in a way most languages' sets have no equivalent for.
    "voicelessTriggers": ["p", "t", "k", "f", "s", "ʃ", "t͡s", "t͡ʃ", "c", "x"],
    "voicedTriggers": ["b", "d", "ɡ", "z", "ʒ", "d͡z", "d͡ʒ", "ɟ"],

    // Longest-match orthography → IPA. The boolean = the unit is a vowel nucleus. Geminate digraphs (first letter
    // doubled) come before their base digraph; digraphs before single letters.
    "rules": [
        ["ddzs", "d͡ʒː", false],
        ["dzs", "d͡ʒ", false],
        ["ccs", "t͡ʃː", false],
        ["ddz", "d͡zː", false],
        ["ggy", "ɟː", false],
        ["lly", "jː", false],
        ["nny", "ɲː", false],
        ["ssz", "sː", false],
        ["tty", "cː", false],
        ["zzs", "ʒː", false],
        // ⚠ ⟨sch⟩ AND ⟨ch⟩ ARE FOREIGN SPELLINGS, and Hungarian has no rule for either — so the scan took
        // ⟨c⟩→[t͡s] and then a bare ⟨h⟩, giving *t͡sh*, a sound no reading of these words produces:
        // *charles* → ˈt͡shɒrlɛʃ, *canyoning* → ˈt͡sɒɲoniŋɡ, *cuddeback* → ˈt͡sudːɛbɒt͡sk. 173 tokens across
        // 66 distinct words in the hu_hu corpus, essentially all proper names.
        //
        // ⚠ [t͡ʃ] IS THE MEASURED DEFAULT, NOT THE OBVIOUS ONE. Hungarian's own learned vocabulary reads
        // ⟨ch⟩ as [x] (technológia, hierarchia, jacht) and that was the first candidate; against the audio
        // it is NET NEGATIVE — 103 rows closer against 149 further — because the corpus is name-dominated.
        // [t͡ʃ] scores 145 closer against 22 further on the 167 rows it changes. A `chn → xn` carve-out for
        // the techn- family was also tried and measured very slightly WORSE than leaving it out, so it is
        // not here. ⟨sch⟩ is German/Dutch and never native, hence its own entry above ⟨ch⟩ — without it the
        // ⟨s⟩ matches alone and *schumacher* comes out ʃt͡ʃ-.
        //
        // ⚠ THE MORPHEME BOUNDARY IS GUARDED IN hungarian.ts, NOT HERE. See the ⟨ch⟩ skip beside the
        // ⟨csz⟩ one — *harminchat* is c+h and must not become harmin-CSAT.
        ["sch", "ʃ", false],
        ["ch", "t͡ʃ", false],
        ["cs", "t͡ʃ", false],
        ["dz", "d͡z", false],
        ["gy", "ɟ", false],
        ["ly", "j", false],
        ["ny", "ɲ", false],
        ["sz", "s", false],
        ["ty", "c", false],
        ["zs", "ʒ", false],
        ["á", "aː", true],
        ["é", "eː", true],
        ["í", "iː", true],
        ["ó", "oː", true],
        ["ő", "øː", true],
        ["ú", "uː", true],
        ["ű", "yː", true],
        ["ö", "ø", true],
        ["ü", "y", true],
        ["a", "ɒ", true],
        ["e", "ɛ", true],
        ["i", "i", true],
        ["o", "o", true],
        ["u", "u", true],
        ["b", "b", false],
        ["c", "t͡s", false],
        ["d", "d", false],
        ["f", "f", false],
        ["g", "ɡ", false],
        ["h", "h", false],
        ["j", "j", false],
        ["k", "k", false],
        ["l", "l", false],
        ["m", "m", false],
        ["n", "n", false],
        ["p", "p", false],
        ["q", "k", false],
        ["r", "r", false],
        ["s", "ʃ", false],
        ["t", "t", false],
        ["v", "v", false],
        ["w", "v", false],
        ["x", "ks", false],
        ["y", "i", true],
        ["z", "z", false],
    ],

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // Cardinal number words. Hungarian tens are compounds (huszon-/harminc-…); units join directly (huszonegy).
    "numbers": {
        "units": ["nulla", "egy", "kettő", "három", "négy", "öt", "hat", "hét", "nyolc", "kilenc"],
        "teens": ["tíz", "tizenegy", "tizenkettő", "tizenhárom", "tizennégy", "tizenöt", "tizenhat", "tizenhét", "tizennyolc", "tizenkilenc"],
        "tens": ["", "tíz", "húsz", "harminc", "negyven", "ötven", "hatvan", "hetven", "nyolcvan", "kilencven"],
        // ⚠ ONE PREFIX, BECAUSE ONLY ONE IS READ. The TWENTIES are the only decade the compositor builds from
        // a bound prefix (huszon + egy); the TEENS are authored in full above, in `teens`, and that is the
        // table `below100` reads — so a `"10": "tizen"` entry beside this one could never reach a numeral.
        // It was here, and replacing its value with nonsense changed no reading at all (10 tíz, 11 tizenegy,
        // 1015 ezertizenöt, 2012 kétezertizenkettő). Dead data drifts silently; a mapped key is not a read one.
        "tensPrefix": { "20": "huszon" },
        "hundred": "száz",
        "thousand": "ezer",
        "million": "millió",
        "milliard": "milliárd"
    },

    "letterNames": {
        "a": "á", "á": "á", "b": "bé", "c": "cé", "d": "dé", "e": "é", "é": "é", "f": "ef", "g": "gé",
        "h": "há", "i": "í", "í": "í", "j": "jé", "k": "ká", "l": "el", "m": "em", "n": "en", "o": "ó",
        "ó": "ó", "ö": "ő", "ő": "ő", "p": "pé", "q": "kú", "r": "er", "s": "es", "t": "té", "u": "ú",
        "ú": "ú", "ü": "ű", "ű": "ű", "v": "vé", "w": "dupla vé", "x": "iksz", "y": "ipszilon", "z": "zé"
    },
    "phonotactics": {
        "vowels": "aáeéiíoóöőuúüű",
        "onsets": [
            "bl", "br", "cl", "cr", "dr", "dv", "fl", "fr", "gl", "gn", "gr", "hr", "kl", "kn", "kr", "kv",
            "kw", "pl", "pn", "pr", "ps", "sc", "sf", "sk", "sl", "sm", "sn", "sp", "sr", "st", "sv", "sw",
            "tr", "tv", "tw", "vl", "vr", "zl", "zn", "zv"
        ],
        "codas": [
            "ct", "ft", "js", "jt", "kk", "ks", "kt", "lb", "lc", "ld", "lf", "lg", "lj", "lk", "lm", "ln",
            "lp", "ls", "lt", "lz", "mb", "mp", "ms", "nc", "nd", "ng", "nj", "nk", "ns", "nt", "nz", "ps",
            "pt", "rb", "rc", "rd", "rf", "rg", "rj", "rk", "rl", "rm", "rn", "rp", "rs", "rt", "rz", "sk",
            "sp", "st"
        ]
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbols": {
        // ⚠ THE AMPERSAND WAS A MISSING CELL, NOT A SOURCING PROBLEM — the tier's own `ampersand` note says so,
        // and this language is one of the fourteen that still had no word declared, so `&` was DROPPED outright.
        // és is ×2257 TOKEN in this language's own corpus, i.e. among its commonest words; there was nothing to source.
        //
        // A Latin-script printing LIGATURE rather than anything native, so what it takes is a reading and not a
        // translation: for a language written in Latin script that is its own conjunction, and for one that is not,
        // the symbol only ever arrives inside a Latin run. Either way the tier substitutes the conjunction, SPACED —
        // see the tier, where the spacing exists because `B&B` is two initialisms.
        "ampersand": "és",
        "percent": ["százalék"],
        /**
         * CURRENCY. `$5` read as bare *ˈøt* — the sign contributed nothing, which is worse than a wrong
         * word because nothing in the output marks the loss. hu_hu contains ZERO `$` against 57 `%`, so the
         * corpus-driven gate that caught the percent could not see this; the WORDS are nonetheless in that same
         * corpus, spelled "out":
         *
         *   dollár  ×6   "11,000 és 22,500 amerikai dollár közötti áron"
         *   font    ×10  "hivatalos pénzneme a falklandi font (FKP)"
         *
         * ONE FORM EACH, because Hungarian takes the SINGULAR after a numeral (öt dollár, not *öt dollárok).
         *
         * `euró` and `jen` are DELIBERATELY "ABSENT": both are 0 in the corpus under a token test. An unsourced
         * currency word is left unread rather than guessed.
         */
        "currency": { "$": ["dollár"], "£": ["font"] },
        "units": {
            "km": ["kilométer"],
            "m": ["méter"],
            "cm": ["centiméter"],
            "mm": ["milliméter"],
            "kg": ["kilogramm"],
            "mérföld": ["mérföld"],
            "mbit": ["megabit"],
            /**
             * ⚠ `mp` IS THE SECOND, AND IT IS A NUMERATOR KEY EVEN THOUGH `s` IS A DENOMINATOR-ONLY ONE. The
             * artifact's `133 m/s, 300 mp/h` left `ˈmp ˈh` "raw": the tier resolved neither half, so the rate arm
             * declined and the whole phrase reached the IPA as ASCII. `s` cannot be promoted to fix it (see the
             * docblock above — a standalone `s` bites into `802.11a`-shaped codes), and `mp` has no such second
             * "life": it is two letters, vowel-free, and not a Hungarian word.
             *
             * SOURCING — hu.wikipedia states the equivalence twice, from both ends, and `attest.ts --lang hu`
             * has both "cached":
             *   · the *másodperc* "article": "…(szövegben – az **mp** rövidítést is)" — the second, abbreviated
             *     ⟨mp⟩ in running text. 110 tokens / 19 articles.
             *   · the ⟨mp⟩ disambiguation "page": "mp, Mp – időre vonatkozó mértékegységként a másodperc egyik
             *     jelölése, "helyesen": s". 156 tokens / 18 articles.
             * ⚠ THAT SAME PAGE LISTS A SECOND UNIT SENSE AND IT IS READ AND REJECTED, not "skipped": `mp` is also
             * the MILLIPOND, a CGS-era force unit. It is obsolete, it is not what a Hungarian text with a figure
             * in front of it means, and the ⟨s⟩-gloss above is the wiki's own account of ordinary written usage.
             * Declaring the millipond instead would be the *kong-si* error — the attested sense that is not the
             * one in the slot.
             * ⚠ AND THE CORPUS SENTENCE IS ITSELF A MISTRANSLATION — English "300 mph" rendered as `300 mp/h`,
             * so what it MEANS is miles per hour. That is not this layer's business and must not become "it": the
             * layer reads the Hungarian that is written, and *háromszáz másodperc per óra* is what is written.
             */
            "mp": ["másodperc"],
        },
        "unitPer": "per",
        "rateDenominators": { "h": "óra", "s": "másodperc", "ó": "óra", "óra": "óra", "órás": "órás" },
        "exponentWords": { "squared": ["négyzet"], "cubed": ["köb"], "position": "compound" }
    }
}
