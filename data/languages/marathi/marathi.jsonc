// Native canonical-IPA definition for Hindi (hi) — re-derived from the Devanagari orthography and
// standard Hindi phonology. A shallow abugida — pronunciation is almost entirely rule-derivable.
// This file IS the language data: the native G2P engine (src/Phonemize/native/nativeG2p.ts) reads it
// directly. Devanagari is a shallow abugida, so pronunciation is almost entirely rule-derivable; the
// only genuinely hard part is schwa deletion (handled by a documented algorithm, not a lexicon).
//
// Format: plain JSONC. Verbose, self-describing keys. Every phoneme value is CANONICAL IPA.
{
    "language": "mr",
    "name": "Marathi",
    "script": ["Devanagari"],
    "provenance": "Authored from the Unicode Devanagari chart + standard Hindi phonology. This file IS the language data — the native G2P engine reads it directly.",

    // The vowel inserted after a consonant that has no explicit vowel sign and no virama (the abugida
    // 'inherent vowel'). Hindi's is the schwa /ə/. Its deletion (below) is the one non-trivial rule.
    "inherentVowel": "ə",

    // Consonant letters → canonical IPA. `note` documents the phonological class + any referee decision.
    "consonants": {
        "क": { "ipa": "k", "note": "velar stop, voiceless" },
        "ख": { "ipa": "kʰ", "note": "velar stop, voiceless aspirated" },
        "ग": { "ipa": "ɡ", "note": "velar stop, voiced" },
        "घ": { "ipa": "ɡʱ", "note": "velar stop, voiced breathy" },
        "ङ": { "ipa": "ŋ", "note": "velar nasal" },
        "च": {
            "ipa": "t͡ʃ",
            "note": "post-alveolar affricate, voiceless (Hindi च = t͡ʃ, cf. Bengali t͡ɕ)",
        },
        "छ": {
            "ipa": "t͡ʃʰ",
            "note": "post-alveolar affricate, voiceless aspirated",
        },
        "ज": { "ipa": "d͡ʒ", "note": "post-alveolar affricate, voiced" },
        "झ": {
            "ipa": "d͡ʒʱ",
            "note": "post-alveolar affricate, voiced breathy",
        },
        "ञ": { "ipa": "ɲ", "note": "palatal nasal" },
        "ट": { "ipa": "ʈ", "note": "retroflex stop, voiceless" },
        "ठ": { "ipa": "ʈʰ", "note": "retroflex stop, voiceless aspirated" },
        "ड": { "ipa": "ɖ", "note": "retroflex stop, voiced" },
        "ढ": { "ipa": "ɖʱ", "note": "retroflex stop, voiced breathy" },
        "ण": { "ipa": "ɳ", "note": "retroflex nasal" },
        "त": {
            "ipa": "t̪",
            "note": "DENTAL stop, voiceless (t̪ vs retroflex ट=ʈ — the core coronal contrast)",
        },
        "थ": { "ipa": "t̪ʰ", "note": "dental stop, voiceless aspirated" },
        "द": { "ipa": "d̪", "note": "dental stop, voiced" },
        "ध": { "ipa": "d̪ʱ", "note": "dental stop, voiced breathy" },
        "न": { "ipa": "n", "note": "dental/alveolar nasal" },
        "प": { "ipa": "p", "note": "labial stop, voiceless" },
        "फ": { "ipa": "pʰ", "note": "labial stop, voiceless aspirated" },
        "ब": { "ipa": "b", "note": "labial stop, voiced" },
        "भ": { "ipa": "bʱ", "note": "labial stop, voiced breathy" },
        "म": { "ipa": "m", "note": "labial nasal" },
        "य": { "ipa": "j", "note": "palatal approximant" },
        "र": { "ipa": "ɾ", "note": "alveolar tap" },
        "ल": { "ipa": "l", "note": "alveolar lateral" },
        "ळ": { "ipa": "ɭ", "note": "retroflex lateral (Marathi-specific)" },
        "व": { "ipa": "ʋ", "note": "labiodental approximant" },
        "श": { "ipa": "ʃ", "note": "post-alveolar sibilant" },
        "ष": {
            "ipa": "ʂ",
            "note": "retroflex sibilant — KEPT in Marathi (अंडकोष→əɳɖkoʂ), unlike Hindi's ʃ-merger",
        },
        "स": { "ipa": "s", "note": "alveolar sibilant" },
        "ह": { "ipa": "ɦ", "note": "voiced glottal fricative" },
        // Nukta letters (borrowed/Perso-Arabic sounds)
        "क़": { "ipa": "q", "note": "uvular stop (nukta क)" },
        "ख़": { "ipa": "x", "note": "velar fricative voiceless (nukta ख)" },
        "ग़": { "ipa": "ɣ", "note": "velar fricative voiced (nukta ग)" },
        "ज़": { "ipa": "z", "note": "alveolar sibilant voiced (nukta ज)" },
        "ड़": { "ipa": "ɽ", "note": "retroflex flap (nukta ड)" },
        "ढ़": { "ipa": "ɽʱ", "note": "retroflex flap breathy (nukta ढ)" },
        "फ़": { "ipa": "f", "note": "labiodental fricative (nukta फ)" },
        "य़": { "ipa": "j", "note": "ya with nukta" },
    },

    // Independent vowel letters (word-initial / standalone).
    "independentVowels": {
        "अ": { "ipa": "ə", "note": "short central (schwa)" },
        "आ": { "ipa": "aː", "note": "long open" },
        "इ": { "ipa": "ɪ", "note": "short near-close front" },
        "ई": { "ipa": "iː", "note": "long close front" },
        "उ": { "ipa": "ʊ", "note": "short near-close back" },
        "ऊ": { "ipa": "uː", "note": "long close back" },
        "ऋ": {
            "ipa": "ɾu",
            "note": "vocalic r ऋ — realized [ɾu] in Marathi (कृपा→kɾupaː), unlike Hindi ɾɪ",
        },
        "ए": { "ipa": "eː", "note": "long close-mid front" },
        "ऐ": { "ipa": "əi", "note": "diphthong [əi] in Marathi (दैव→d̪əiʋ), not the Hindi monophthong ɛː" },
        "ओ": { "ipa": "oː", "note": "long close-mid back" },
        "औ": { "ipa": "əu", "note": "diphthong [əu] in Marathi (नौदल→nəud̪əl), not the Hindi monophthong ɔː" },
        "ऍ": { "ipa": "ɛː", "note": "candra e (loans)" },
        "ऑ": { "ipa": "ɔː", "note": "candra o (loans, e.g. English 'o')" },
        "ॐ": { "ipa": "õːm", "note": "Om sign (U+0950) — a whole syllable" },
    },

    // Dependent vowel signs (matras) — replace the inherent vowel on the preceding consonant.
    "vowelSigns": {
        "ा": { "ipa": "aː" },
        "ि": { "ipa": "ɪ" },
        "ी": { "ipa": "iː" },
        "ु": { "ipa": "ʊ" },
        "ू": { "ipa": "uː" },
        "ृ": { "ipa": "ɾu" },
        "े": { "ipa": "eː" },
        "ै": { "ipa": "əi" },
        "ो": { "ipa": "oː" },
        "ौ": { "ipa": "əu" },
        "ॅ": { "ipa": "ɛː" },
        "ॉ": { "ipa": "ɔː" },
    },

    // Combining signs with special effects.
    "signs": {
        "virama": {
            "char": "्",
            "effect": "suppressInherentVowel",
            "note": "halant — the consonant carries no vowel (forms clusters/conjuncts)",
        },
        "anusvara": {
            "char": "ं",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel (canonical Hindi + wikipron: कांग्रेस→kãɡɾeːs, not a homorganic nasal consonant). Nasal vowels are short.",
        },
        "chandrabindu": {
            "char": "ँ",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel",
        },
        "visarga": { "char": "ः", "effect": "appendH", "note": "→ [h]" },
        "nukta": {
            "char": "़",
            "effect": "composeNukta",
            "note": "combines with the preceding consonant (decomposed form) into the nukta letter",
        },
    },

    // Schwa deletion — the one hard rule. Hindi deletes the inherent schwa word-finally (except
    // monosyllables) and medially in a VCəCV context (Ohala 1983), applied right-to-left after the
    // final deletion. The engine implements this; parameters are declared here for transparency.
    "schwaDeletion": {
        "deleteWordFinal": true,
        "retainInMonosyllable": true,
        "retainFinalAfterCluster": true,
        "medialRule": "ohala-VCaCV",
        "note": "Final-first, then medial VCəCV → VCCV right-to-left. भारत → bʱaːɾət̪ (medial ə RETAINED because the following त̪ is word-final, no CV context). MARATHI keeps the word-final inherent schwa after a consonant CLUSTER or GEMINATE (अंक→əŋkə, महत्त्व→məɦət̪ːʋə, अन्न→ənːə) but deletes it after a single consonant (घर→ɡʱəɾ) — retainFinalAfterCluster; Hindi deletes both.",
    },

    // Post-rules applied to the raw akshara IPA (declarative, ordered regex — portable). Geminate→length
    // is the fleet-wide Indic convention; the offglide + अय→ɛ are systematic Hindi realizations.
    "postRules": [
        {
            "from": "d͡ʒɲ",
            "to": "d͡ʒn",
            "note": "⚠ ज्ञ IS NOT ITS PARTS, and Marathi's answer is not Hindi's. Composing ज (d͡ʒ) + ् + ञ (ɲ) literally gives d͡ʒɲ, which is neither reading anyone attests: Hindi says /ɡj/ (hindi.jsonc has that rule) and Marathi says *dnya* — d͡ʒn. The literal composition was simply the un-ruled default, and hindi.jsonc's own note already NAMES the Marathi reading (\"Marathi reads the same ligature as `dnya` (dnyaan)\") while correctly scoping its own ɡj rule away from this file. Nobody then wrote the rule that note implies. MEASURED against wikipron mar_deva broad (human): 16 of its 17 ज्ञ rows read `d͡ʑ n`, which the eval folds onto our d͡ʒ (see the alveolo-palatal fold in tools/referee-eval/langs/mr.jsonc), and the 17th is the bare letter ज्ञ as `d ɲ ə`. The primary referee score moves 91.605% → 91.933%, +16 words folded — exactly the rows in question. 10 golden rows move, all of this shape (ज्ञान d͡ʒɲˈaːn → d͡ʒnˈaːn).",
        },
        {
            "from": "((?:t͡ʃʰ|d͡ʒʱ|t͡ʃ|d͡ʒ|t̪ʰ|d̪ʱ|[kɡptbmnlʃsɳŋɽ]ʰ?ʱ?|t̪|d̪))\\1(?!͡)",
            "to": "$1ː",
            "note": "geminate → single + length (क्क→kː, च्च→t͡ʃː)",
        },
        {
            "from": "ː([ʰʱ])",
            "to": "$1ː",
            "note": "aspiration-before-length reorder: differing-aspiration conjunct द्ध→d̪ːʱ→d̪ʱː (fleet convention, matches bn/si)",
        },
        {
            "from": "t͡ʃʰ(?=[əaɑoɔuʊ])",
            "to": "t͡sʰ",
            "note": "Marathi छ → DENTAL affricate [t͡sʰ] before a back/central vowel",
        },
        {
            "from": "d͡ʒʱ(?=[əaɑoɔuʊ])",
            "to": "d͡zʱ",
            "note": "Marathi झ → dental [d͡zʱ] before a back/central vowel",
        },
        {
            "from": "t͡ʃ(?=[əaɑoɔuʊ])",
            "to": "t͡s",
            "note": "Marathi च → dental [t͡s] before a back/central vowel (चार→t͡saːɾ); stays palatal t͡ʃ before front i/e/y",
        },
        {
            "from": "d͡ʒ(?=[əaɑoɔuʊ])",
            "to": "d͡z",
            "note": "Marathi ज → dental [d͡z] before a back/central vowel (जन→d͡zən)",
        },
    ],
    // No Hindi-style finalRules — Marathi keeps intervocalic əɦə (शहर→ɕəɦəɾ, not the Hindi ɛɦɛ) and has no
    // और-offglide convention.
    "finalRules": [],

    // NUMBERS — authored Devanagari SPELLINGS (public-fact numerals); the canonical IPA is DERIVED by
    // running these through the same native G2P (no hand-written phonemes). The compositor
    // (core/numbers.ts `indicNumberWords`) assembles them with Indian lakh/crore grouping.
    "numbers": {
        "units": ["शून्य", "एक", "दोन", "तीन", "चार", "पाच", "सहा", "सात", "आठ", "नऊ"],
        "teens": ["दहा", "अकरा", "बारा", "तेरा", "चौदा", "पंधरा", "सोळा", "सतरा", "अठरा", "एकोणीस"],
        "tens": {
            "20": "वीस",
            "30": "तीस",
            "40": "चाळीस",
            "50": "पन्नास",
            "60": "साठ",
            "70": "सत्तर",
            "80": "ऐंशी",
            "90": "नव्वद"
        },
        // Irregular fused 21-99 (see the SOURCES note above). Round tens live in `tens`.
        "compound": {
            "21": "एकवीस",  "22": "बावीस",  "23": "तेवीस",  "24": "चोवीस",  "25": "पंचवीस",
            "26": "सव्वीस", "27": "सत्तावीस", "28": "अठ्ठावीस", "29": "एकोणतीस",
            "31": "एकतीस",  "32": "बत्तीस", "33": "तेहतीस", "34": "चौतीस",  "35": "पस्तीस",
            "36": "छत्तीस", "37": "सदतीस",  "38": "अडतीस",  "39": "एकोणचाळीस",
            "41": "एकेचाळीस", "42": "बेचाळीस", "43": "त्रेचाळीस", "44": "चव्वेचाळीस", "45": "पंचेचाळीस",
            "46": "शेहेचाळीस", "47": "सत्तेचाळीस", "48": "अठ्ठेचाळीस", "49": "एकोणपन्नास",
            "51": "एक्कावन्न", "52": "बावन्न", "53": "त्रेपन्न", "54": "चोपन्न", "55": "पंचावन्न",
            "56": "छप्पन्न", "57": "सत्तावन्न", "58": "अठ्ठावन्न", "59": "एकोणसाठ",
            "61": "एकसष्ट", "62": "बासष्ट", "63": "त्रेसष्ट", "64": "चौसष्ट", "65": "पासष्ट",
            "66": "सहासष्ट", "67": "सदुसष्ट", "68": "अडुसष्ट", "69": "एकोणसत्तर",
            "71": "एक्काहत्तर", "72": "बाहत्तर", "73": "त्र्याहत्तर", "74": "चौऱ्याहत्तर",
            "75": "पंच्याहत्तर", "76": "शहात्तर", "77": "सत्त्याहत्तर", "78": "अठ्ठ्याहत्तर",
            "79": "एकोणऐंशी",
            "81": "एक्याऐंशी", "82": "ब्याऐंशी", "83": "त्र्याऐंशी", "84": "चौऱ्याऐंशी",
            "85": "पंच्याऐंशी", "86": "शहाऐंशी", "87": "सत्त्याऐंशी", "88": "अठ्ठ्याऐंशी",
            "89": "एकोणनव्वद",
            "91": "एक्याण्णव", "92": "ब्याण्णव", "93": "त्र्याण्णव", "94": "चौऱ्याण्णव",
            "95": "पंच्याण्णव", "96": "शहाण्णव", "97": "सत्त्याण्णव", "98": "अठ्ठ्याण्णव",
            "99": "नव्व्याण्णव"
        },
        "magnitudes": {
            // शे, not शंभर: Marathi forms the hundreds as N+शे (दोनशे, आठशे). शंभर is the BARE hundred
            // only, which normalize.ts step 9 supplies for a standalone 100.
            "hundred": "शे",
            "thousand": "हजार",
            "lakh": "लाख",
            "crore": "कोटी"
        },
        "grouping": "indian-lakh-crore",
        "decimalWord": "दशांश"
    },

    // PERCENT — the ONE authored copy. It used to be written three times: here, in marathi.ts's tier, and
    // inline in normalize.ts. `symbols` (the bare-sign map the Hindi engine tokenizes on) is now DERIVED from
    // `plural` in marathi.ts rather than authored again. टक्के not प्रतिशत: Hindi's word is not Marathi's.
    "percent": { "plural": "टक्के", "singular": "टक्का" },

    // CURRENCY — likewise one copy, read by both normalize.ts (sign BEFORE the amount) and the symbol tier
    // (sign AFTER). ⚠ THE TWO PATHS USED TO DISAGREE ABOUT £: normalize.ts said पौंड and the tier said
    // पाउंड, so `£5` and `5 £` read as different words in the same document.
    //
    // ⚠ RESOLVED TO पाउंड, WHICH REVERSES normalize.ts's EARLIER CHOICE. That choice took पाउंड for Hindi's
    // form and preferred पौंड as the Marathi one, with the mined counts पौंड ×2 / पाउंड ×3 stated. The
    // deciding evidence is a SECOND, INDEPENDENT corpus: FLEURS mr writes पाउंड in running prose
    // ("ब्रिटिश पाउंड सहसा बेटांवर…") and पौंड not once. Two independent sources agreeing outweighs the
    // contamination hypothesis. डॉलर/येन are the fleet spellings; युरो is Marathi's (Hindi says यूरो).
    "currency": { "$": "डॉलर", "€": "युरो", "¥": "येन", "£": "पाउंड", "₹": "रुपये" },
    "stripSymbols": "₹",

    // ── The words Marathi's own normalizer and its symbol tier speak ────────────────────────────────
    // ⚠ AUTHORED HERE, READ IN BOTH PLACES. normalize.ts and marathi.ts's tier each used to spell their
    // own copies, and where the two disagreed the reading depended on which path claimed the token
    // first — that is how £ came to read पौंड before a number and पाउंड after one.

    // The two words the tier still needs beyond percent/currency.
    "ampersand": "आणि",   // `आणि` ×1073; the tier spaces it both sides so `B&B` stays two initialisms
    "multiply": "गुणिले",

    // The Latin unit abbreviations the SHARED TIER is keyed on.
    "units": {
        "km": "किलोमीटर", "cm": "सेंटीमीटर", "mm": "मिलिमीटर", "kg": "किलोग्रॅम",
        "ha": "हेक्टर", "l": "लिटर", "L": "लिटर"
    },

    // ⚠ A SECOND UNIT TABLE ON PURPOSE, and merging the two would be wrong. This one is normalize.ts's:
    // it carries the DEVANAGARI abbreviations the corpus actually writes (किमी ×14, मिमी ×8, मी ×3), and
    // it re-declares the Latin keys because step 14's bare-hundred rewrite turns `100 km` into `शंभर km`,
    // which the tier can no longer match — its NUM is a digit run. Left to the tier, `100 ha` read
    // *ˈeːk ʃˈeː ɦˈeːkʈəɾ*. Single-letter `m` and `g` are deliberately ABSENT: `100m`/`200m` are swim
    // events, and `802.11 g` is a spaced version designation this local rule has no guard against.
    // Key order is not significant — normalize.ts sorts longest-first at load.
    "unitWords": {
        "किमी/ताशी": "किलोमीटर ताशी",
        "किमी/तास": "किलोमीटर प्रति तास",
        "मी/से": "मीटर प्रति सेकंद",
        "किमी²": "चौरस किलोमीटर", "किमी2": "चौरस किलोमीटर",
        "सेमी²": "चौरस सेंटीमीटर", "सेमी2": "चौरस सेंटीमीटर",
        "मिमी²": "चौरस मिलीमीटर", "मिमी2": "चौरस मिलीमीटर",
        "मी²": "चौरस मीटर", "मी2": "चौरस मीटर",
        "किमी": "किलोमीटर", "सेमी": "सेंटीमीटर", "मिमी": "मिलीमीटर",
        "किग्रॅ": "किलोग्रॅम", "ग्रॅ": "ग्रॅम",
        "मी": "मीटर",
        "km²": "चौरस किलोमीटर", "km2": "चौरस किलोमीटर",
        "m²": "चौरस मीटर", "cm²": "चौरस सेंटीमीटर",
        "mm²": "चौरस मिलीमीटर", "mm2": "चौरस मिलीमीटर",
        "km": "किलोमीटर", "cm": "सेंटीमीटर", "mm": "मिलीमीटर", "kg": "किलोग्रॅम",
        "ha": "हेक्टर", "l": "लिटर", "L": "लिटर"
    },

    // Magnitude words that hop over the currency sign — "$२.३ बिलियन" is said "…बिलियन डॉलर".
    "magnitudeWords": ["बिलियन", "ट्रिलियन", "मिलियन", "दशलक्ष", "अब्ज", "कोटी", "लाख", "हजार"],

    "ordinals": {
        // Suffix → the agreement slot it marks. व्या ×36 (oblique), वा ×6, वे ×3.
        "suffixForm": { "व्या": 3, "वा": 0, "वी": 1, "वे": 2 },
        // Suppletive 1-4, indexed [masc, fem, plural/neuter, oblique]. ⚠ THE INDEX ORDER IS THE CONTRACT:
        // it must match the slots in `suffixForm`. Marathi's differ from Hindi's (पहिला not पहला).
        "irregular": {
            "1": ["पहिला", "पहिली", "पहिले", "पहिल्या"],
            "2": ["दुसरा", "दुसरी", "दुसरे", "दुसऱ्या"],
            "3": ["तिसरा", "तिसरी", "तिसरे", "तिसऱ्या"],
            "4": ["चौथा", "चौथी", "चौथे", "चौथ्या"]
        },
        // Stem alternations before the suffix. The bare-hundred ordinal, नऊ→नव, and -ीस→-िसा.
        "stemHundred": "शंभरा",
        "stemNine": ["नऊ", "नव"],
        "stemTens": ["ीस", "िसा"]
    },

    // The -तः adverbs, written with an ASCII colon for the visarga. ⚠ A CLOSED LIST, not the pattern
    // `त:` — that would also claim the genuine list colons in आहेत: ×5 and करतात: ×1.
    "visargaAdverbs": ["विशेषत", "सामान्यत", "साधारणत", "संभाव्यत", "मुख्यत", "अंशत", "स्वत", "दुख"],

    "clock": { "past": "वाजून", "minutes": "मिनिटे", "oclock": "वाजता" },
    "eraMarkers": { "bc": "इसवी सन पूर्व", "ad": "इसवी सन" },
    "abbreviations": { "डॉ": "डॉक्टर" },
    "degree": {
        "word": "अंश", "celsius": "सेल्सिअस", "fahrenheit": "फॅरेनहाइट",
        "north": "उत्तर", "south": "दक्षिण", "east": "पूर्व", "west": "पश्चिम"
    },
    "fractions": { "half": "अर्धा", "quarter": "पाव", "threeQuarters": "पाऊण", "dividedBy": "भागिले" },
    // ⚠ NOT THE FLEET'S `signWords`, AND THE NAME DIFFERS ON PURPOSE. That key is the shape the SHARED
    // symbol tier reads, and test/manifest-signwords.test.ts requires all nine of its slots — including
    // `minus`. Marathi REFUSES a minus rule outright (normalize.ts: "reading उणे एक is worse than
    // silence"), so declaring one here would be dead data contradicting that refusal. This set also needs
    // `approximately`, for which the shared shape has no slot. Marathi's own rules read these.
    "symbolWords": {
        "plus": "अधिक", "approximately": "सुमारे", "plusMinus": "अधिक उणे",
        "lessThan": "पेक्षा कमी", "greaterThan": "पेक्षा जास्त", "divide": "ने भागणे", "equals": "बरोबर",
        // ⚠ THE MINUS WORD IS DECLARED BUT NO ASCII-HYPHEN RULE READS IT, and that is deliberate: the
        // hyphen before a digit is a DESIGNATION here ("चंद्रयान -1") or a compound (आस-पास), so the
        // trigger is refused, not the vocabulary. It is `plusMinus`'s second half already. वजा is the
        // attested alternative and a one-word change if it is ever preferred.
        "minus": "उणे"
    },
    "rangeWord": "ते",
    // The STANDALONE hundred. `magnitudes.hundred` is शे, the COMBINING form; a bare 100 is शंभर.
    "bareHundred": "शंभर",

    // Clause / phrase punctuation → canonical inline pause marks (Devanagari danda ।/॥ + ASCII).
    "clausePunctuation": {
        "।": ".",
        "॥": ".",
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Nasalization does NOT change vowel length: the WikiPron hin_deva narrow referee keeps nasal vowels
    // long (नहीं→nɐɦĩː, कांग्रेस→kãːŋ, यहाँ→jɐɦãː, गांव→ɡãː), so a long vowel + anusvara/chandrabindu stays
    // long (kaː̃) and a short one stays short (गंगा→ɡə̃ŋ). Setting this false keeps the length mark.
    "nasalVowelsAreShort": false,
}
