// Native canonical-IPA data manifest for European Portuguese (pt-PT).
// This file IS the hand-authored context-free language DATA: the accent letter classes, the vowel-letter→IPA
// table, the unstressed-reduction and oral→nasal maps, the voiced-consonant / liquid sets, the function-word
// clitic list, clause punctuation, and the number words. The ALGORITHMS that read it stay in code:
//   g2p.ts        — the left-to-right scan (consonant digraphs + context-sensitive single consonants), nasal
//                   look-ahead, offglides, and the position-based sibilant voicing
//   portuguese.ts — stress placement, the reduction/nasalization realize pass, onglide demotion, tokenizer
//   numbers.ts    — the European-convention cardinal compositor (the "e" connector logic)
// The lexical CORRECTION table (stressed mid-vowel open/close + grapheme x) stays in the sibling lexicon.tsv /
// lexicon-manual.tsv (append-heavy wikipron data), which the engine only patches with.
//
// Format: plain JSONC. Every phoneme value is CANONICAL IPA.
{
    // ACRONYMS read letter-by-letter that the OOV phonotactic rule would leave alone, being perfectly
    // pronounceable Portuguese letter strings. A LEXICAL fact, listed rather than derived. EUA (x15 in the
    // corpus) and TV (x13) are the frequent ones; the pronunciation lexicon here is a CORRECTION table
    // rather than a wordlist, so it cannot serve as the "is this recorded" test.
    "acronymLetters": [
        "eua", "tv", "aol", "oha", "us", "url", "pib", "irm", "cpf", "cnpj", "ong", "dvd", "cd", "gps",
        "utc", "pbs", "bbc", "cnn", "fbi", "adn", "dna", "sms", "led", "usb", "pdf", "iptu"
    ],

    "language": "pt",
    "name": "Portuguese (European, pt-PT)",
    "script": ["Latin"],
    "provenance": "Authored from European Portuguese orthography + phonology (largely rule-governed). This file IS the language data — the native rule engine reads it directly. The two genuinely-lexical axes (stressed mid-vowel quality, grapheme x) are patched from a wikipron-derived correction lexicon (lexicon.tsv).",

    "convention": {
        "reduction": "unstressed oral vowels reduce — a→ɐ, e→ɨ, o→u (the EP signature)",
        "nasal": "tilde or a coda m/n nasalizes the nucleus (bom→bõ, falam→fɐlɐ̃w̃)",
        "sibilants": "single intervocalic s→z; any coda s/z→ʃ (voiceless/final) or ʒ (before a voiced C)",
        "stress": "written accent wins; else oxytone on r/l/z/x, i/u, nasal, -im/-um; else paroxytone",
        "midVowel": "bare stressed e/o default CLOSE (e/o); OPEN (ɛ/ɔ) is lexical (correction table)",
    },

    // Accent letter classes.
    "accents": {
        // Accented vowel → its base (unaccented) letter — drives reduction.
        "toBase": {
            "á": "a",
            "à": "a",
            "â": "a",
            "ã": "a",
            "é": "e",
            "ê": "e",
            "í": "i",
            "ó": "o",
            "ô": "o",
            "õ": "o",
            "ú": "u",
            "ü": "u",
        },
        "acuteGrave": "áàéíóú", // open / explicit-stress accents
        "circumflex": "âêô", // close-quality stressed
        "tilde": "ãõ", // nasal
    },

    // Vowel letters, and the front vowels that soften c/g (c→s, g→ʒ).
    "vowelLetters": "aeiouáàâãéêíóôõúü",
    "frontLetters": "eiéêíy",

    // Vowel letter → its STRESSED IPA realization (bare e/o default CLOSE; open ɛ/ɔ is lexical). Reduction and
    // nasalization rewrite these downstream.
    "vowelIpa": {
        "a": "a",
        "á": "a",
        "à": "a",
        "ã": "a",
        "â": "ɐ",
        "e": "e",
        "ê": "e",
        "é": "ɛ",
        "i": "i",
        "í": "i",
        "o": "o",
        "ô": "o",
        "õ": "o",
        "ó": "ɔ",
        "u": "u",
        "ú": "u",
        "ü": "u",
    },

    // Unstressed-vowel reduction (the EP signature). Keyed by the base vowel letter.
    "reduce": { "a": "ɐ", "e": "ɨ", "o": "u", "i": "i", "u": "u" },
    // Oral vowel IPA → its nasal quality (stressed keeps ɛ/ɔ/e/o; reduced e/o already normalised first).
    "nasal": {
        "a": "ɐ̃",
        "ɐ": "ɐ̃",
        "e": "ẽ",
        "ɛ": "ẽ",
        "i": "ĩ",
        "ɨ": "ɨ̃",
        "o": "õ",
        "ɔ": "õ",
        "u": "ũ",
    },

    // Consonants that make a preceding coda s/z surface as voiced ʒ (mesmo → meʒmu).
    "voicedConsonants": [
        "b",
        "d",
        "ɡ",
        "v",
        "z",
        "ʒ",
        "m",
        "n",
        "ɲ",
        "l",
        "ɫ",
        "ʎ",
        "ɾ",
        "ʁ",
        "j",
        "w",
    ],
    // Liquids — an obstruent+liquid onset cluster keeps a following high vowel a nucleus (criança → kɾiɐ̃sɐ).
    "liquids": ["ɾ", "l", "ʁ", "ɫ"],

    // Unstressed monosyllabic clitics (articles, prepositions, conjunctions, clitic pronouns) — de-stressed in
    // running text (the ˈ mark is stripped).
    "functionWords": [
        "o",
        "a",
        "os",
        "as",
        "um",
        "e",
        "ou",
        "que",
        "se",
        "de",
        "do",
        "da",
        "dos",
        "das",
        "em",
        "no",
        "na",
        "nos",
        "nas",
        "com",
        "por",
        "me",
        "te",
        "lhe",
        "vos",
        "lhes",
        "meu",
        "teu",
        "seu",
        "sua",
        "ao",
        "aos",
        "à",
    ],

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Cardinal number words (European convention; the "e" connector logic is in numbers.ts).
    "numbers": {
        "small": [
            "zero",
            "um",
            "dois",
            "três",
            "quatro",
            "cinco",
            "seis",
            "sete",
            "oito",
            "nove",
            "dez",
            "onze",
            "doze",
            "treze",
            "catorze",
            "quinze",
            "dezasseis",
            "dezassete",
            "dezoito",
            "dezanove",
        ],
        "tens": [
            "",
            "",
            "vinte",
            "trinta",
            "quarenta",
            "cinquenta",
            "sessenta",
            "setenta",
            "oitenta",
            "noventa",
        ],
        "hundreds": [
            "",
            "cento",
            "duzentos",
            "trezentos",
            "quatrocentos",
            "quinhentos",
            "seiscentos",
            "setecentos",
            "oitocentos",
            "novecentos",
        ],
        "hundredExact": "cem", // exactly 100 (not cento)
        "thousand": "mil",
        "million": "milhão",
        "millionPlural": "milhões",
        "connector": "e",
        "decimalConnector": "vírgula", // 3,14 → três vírgula um quatro
    },
    // ---------------------------------------------------------------------------------------------------
    // Month names, for the DATE rule. ⚠ READ ONLY ON THE BRAZILIAN PATH: Brazil says *primeiro de julho*
    // where Portugal normally says *um de julho*, and an EXPLICIT `1º` is honoured in both because there the
    // writer marked it. So a sweep run against `pt` alone scores this table dead — the same shape the es lift
    // found with its own `months`.
    "months": ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto",
        "setembro", "outubro", "novembro", "dezembro"],

    // Dotted abbreviations → the spoken words. ⚠ `no.` is deliberately ABSENT — bare "no" is the contraction
    // em+o and is everywhere in Portuguese, so only `nº`/`n.º`/`no` before a DIGIT is the number sign.
    "dottedAbbrev": {
        "sr": "senhor", "sra": "senhora", "srta": "senhorita", "srs": "senhores",
        "dr": "doutor", "dra": "doutora", "prof": "professor", "profa": "professora", "eng": "engenheiro",
        "etc": "etcétera", "pág": "página", "pag": "página", "págs": "páginas",
        "cap": "capítulo", "art": "artigo", "vol": "volume", "av": "avenida", "ex": "exemplo",
        "ltda": "limitada", "cia": "companhia", "núm": "número", "aprox": "aproximadamente"
    },

    // Portuguese letter names, each verified through this engine.
    "letterNames": {
        "a": "a", "b": "bê", "c": "cê", "d": "dê", "e": "é", "f": "éfe", "g": "gê", "h": "agá", "i": "i",
        "j": "jota", "k": "cá", "l": "éle", "m": "eme", "n": "ene", "o": "ó", "p": "pê", "q": "quê",
        "r": "erre", "s": "esse", "t": "tê", "u": "u", "v": "vê", "w": "dábliu", "x": "xis", "y": "ípsilon",
        "z": "zê"
    },

    // Portuguese PHONOTACTICS, for the OOV spell-it-out test in core/initialisms.ts.
    "phonotactics": {
        "vowels": "aeiouáéíóúâêôãõà",
        "onsets": [
            "bl", "br", "cl", "cr", "dr", "fl", "fr", "gl", "gr", "pl", "pr", "tr", "vr",
            "ch", "lh", "nh", "qu", "gu", "ps", "rr", "ss", "sc", "tl"
        ],
        "codas": [
            "ch", "lh", "nh", "rr", "ss", "ns", "rs", "ls", "is", "us", "as", "es", "os",
            "st", "rt", "rd", "rn", "rl", "rm", "lt", "ld", "nt", "nd", "nc", "ng", "mp", "mb",
            "sc", "sm", "cs", "ps", "ts", "ks", "bs", "ds"
        ]
    },

    // MASCULINE ordinals, 1 … 1000 (romanOrdinals.ts). Three callers: the Roman-numeral policy, the ordinal
    // INDICATORS (1º / 5ª) and the fraction rule. ⚠ NO `teens` ROW, unlike Spanish: Portuguese composes the
    // teens regularly from `tens[1]` + a unit (décimo primeiro), so a table would be a second way to say the
    // same thing.
    "ordinals": {
        "units": ["", "primeiro", "segundo", "terceiro", "quarto", "quinto", "sexto", "sétimo", "oitavo", "nono"],
        "tens": ["", "décimo", "vigésimo", "trigésimo", "quadragésimo", "quinquagésimo",
            "sexagésimo", "septuagésimo", "octogésimo", "nonagésimo"],
        "hundreds": ["", "centésimo", "ducentésimo", "trecentésimo", "quadringentésimo",
            "quingentésimo", "seiscentésimo", "septingentésimo", "octingentésimo", "noningentésimo"],
        "thousandth": "milésimo"
    },

    // FRACTIONS. Only 1/2 and 1/3 have a suppletive name; every other denominator takes the ordinal.
    // ⚠ NO `numeratorOne` HERE, unlike Spanish: Portuguese does not apocopate before the fraction noun
    // (*um quinto*, where Spanish has *un quinto* against its own *uno*), so the plain cardinal serves.
    "fractions": { "denominators": { "2": "meio", "3": "terço" } },

    // The FEMININE "one", for the clock: *hora* is feminine, so 1 takes *uma* (uma hora).
    "feminineOne": "uma",

    // The CLOCK's own noun, which Portuguese speaks aloud where Spanish elides it — *sete horas e dezenove*.
    // Both numbers are the feminine cardinal; `connector` joins the minutes.
    "clock": { "hour": "hora", "hours": "horas", "connector": "e" },

    // ERA MARKERS and the number sign.
    "eraMarkers": { "beforeChrist": "antes de Cristo", "afterChrist": "depois de Cristo" },
    "numberSign": "número",

    // DEGREES, agreeing with the count: *um grau*, *vinte graus*. Exactly 1 takes the singular; 0 and 2+ take
    // the plural, which is the same selector the shared symbol tier defaults to.
    // ⚠ THE AGREEMENT NEEDS THE WHOLE NUMBER, NOT ITS LAST DIGIT, and the rule used to capture `(\d)` — one
    // digit. That was invisible while the word was a hard-coded plural (`20 °C` → *vinte graus*, right by
    // luck, the leading digits simply passing through untouched) and wrong the moment the count is read off
    // the capture: `21 °C` would have seen the `1` and said *grau*. Widened to the full numeral with the fix.
    // The identical trap is recorded in ukrainian/normalize.ts, which hit it first.
    "degree": { "singular": "grau", "plural": "graus", "celsius": "Celsius", "fahrenheit": "Fahrenheit" },

    // The BRAZILIAN REAL, whose sign the shared tier cannot claim (`R$` was read as a stray [ʁ] followed by
    // "dólares"), and the dollar CODES that are folded to a bare `$` so the tier's declared key becomes
    // reachable — see normalize.ts step 5b for why a compound `US$` key there would be inert.
    "realWord": "reais",
    "dollarCodes": ["US", "AUD"],

    // ---------------------------------------------------------------------------------------------------
    // The SIGN AND MATH WORDS (core/normalizeSymbols.ts `SignWords`) — ± + − & = < > × ÷. ⚠ ONE SOURCE: the
    // symbol tier in portuguese.ts reads `times` and `ampersand` from here too.
    //
    // ⚠ SEARCH FOR THE WORDS, NEVER FOR THE SIGN. The notation is absent from pt_br; the vocabulary is
    // ordinary comparative prose and is present: `maior` ×100 tokens, `menor` ×29, `dividido` ×3 — and
    // `igual` ×0, absent entirely, so the corpus cannot source the equals word at all.
    //
    // ⚠ THE EQUALS WORD CAME FROM THE REGISTER TIER, and Portuguese produced the best evidence in the whole
    // issue: pt.wikipedia's Divisão article does not merely use the words, it NAMES THE SIGNS and reads the
    // notation back — "o sinal de menor que ( < ), o sinal de maior que ( > )" and "a ÷ b = c (a dividido por
    // b é igual a c)" — the sign and its reading in one sentence, operands in place. The copula is dropped
    // because those strings are what the source calls the SIGNS themselves.
    //
    // `times` — ⚠ STANDARD MATHEMATICAL REGISTER, not a corpus attestation; the sweep's plausible hits for
    // other languages were homographs of prepositions. `ampersand` — `e` ×1118 in this corpus.
    "signWords": {
        "plusMinus": "mais menos",
        "plus": "mais",
        "minus": "menos",
        "ampersand": "e",
        "equals": "igual a",
        "lessThan": "menor que",
        "greaterThan": "maior que",
        "times": "vezes",
        "dividedBy": "dividido por"
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data (portuguese.ts). Longest keys match first, so km/h beats km.
    "symbols": {
        "percent": ["por cento"],
        // ⚠ NO COMPOUND `US$` KEY — it would be unreachable. The INITIALISM pass runs before this tier and
        // splits `US` into letters, leaving the `$` preceded by a letter where the tier's guard correctly
        // refuses it. `dollarCodes` above folds them to a bare `$` instead. `dólar` ×9 / `dólares` ×8 are the
        // corpus's own words.
        "currency": {
            "€": ["euro", "euros"], "$": ["dólar", "dólares"], "£": ["libra", "libras"],
            "¥": ["iene", "ienes"]
        },
        "units": {
            "km/h": ["quilômetro por hora", "quilômetros por hora"],
            "m/s": ["metro por segundo", "metros por segundo"],
            "km": ["quilômetro", "quilômetros"], "cm": ["centímetro", "centímetros"],
            "mm": ["milímetro", "milímetros"],
            "kg": ["quilograma", "quilogramas"], "mg": ["miligrama", "miligramas"],
            "m": ["metro", "metros"],
            // ⚠ ⟨L⟩ AND ⟨l⟩ ARE BOTH OFFICIAL for the litre (⟨L⟩ is the dominant printed form), so BOTH are
            // declared — the one exception to the one-letter case rule in core/normalizeSymbols.ts, which
            // exists for symbols whose two cases are DIFFERENT units. Here they are the same unit.
            "l": ["litro", "litros"], "L": ["litro", "litros"], "ml": ["mililitro", "mililitros"],
            "g": ["grama", "gramas"], "t": ["tonelada", "toneladas"], "ha": ["hectare", "hectares"],
            "kw": ["quilowatt", "quilowatts"]
        },
        "exponentWords": { "squared": ["quadrado", "quadrados"], "cubed": ["cúbico", "cúbicos"] },
        // BARE EXPONENT — the PREDICATE for a power with no unit to modify, which is a different word from
        // the unit MODIFIER above: *quilómetros quadrados* but *vinte ao quadrado*.
        // ⚠ PROVENANCE: STANDARD MATHEMATICAL REGISTER, not a corpus attestation. The power words are ×0 in
        // this language's artifact.
        "bareExponent": {
            "squared": "{n} ao quadrado", "cubed": "{n} ao cubo", "power": "{n} elevado a {e}",
            "negative": "menos"
        },
        "magnitudes": ["milhões", "milhão", "bilhões", "bilhão"],
        "magnitudeConnective": "de"
    }
}
