// Native canonical-IPA data manifest for Thai (th) — authored.
// This file IS the hand-authored context-free DATA: the onset / coda / vowel-quality grapheme→IPA tables, the
// vowel-length exception sets, and the full tone system (consonant class × mark × life/length → tone → Chao
// letters). The ALGORITHMS that read it stay in code:
//   syllabifier.ts — the orthographic parser (leading-vowel reorder, อักษรนำ leaders, the schwa/inherent-vowel
//                    algorithm, syllable segmentation) — the context-sensitive scanner, kept as code
//   thaiTone.ts    — the tone-computation functions (effective class w/ silent-leader raise, computeThaiTone)
//   g2p.ts         — {onset, nucleus, coda, tone} → IPA rendering + stress; segment.ts — word segmentation
// The bulk lexica stay as sibling files (dictionary.tsv irregulars, seg-words.txt segmentation dictionary).
//
// Format: plain JSONC. Every phoneme value is CANONICAL IPA (contributes ɤ; tones as Chao contour letters).
{
    "language": "th",
    "name": "Thai",
    "script": ["Thai"],
    "provenance": "Authored from Thai orthography + phonology; the tone system is ported from Wiktionary Module:th-pron (CC-BY-SA, tone facts as provenance). This file IS the language data — the native syllabifier/renderer reads it directly. Irregulars are patched from a dictionary (dictionary.tsv).",

    "convention": {
        "tone": "Chao contour letters at syllable end; tone = consonant class × mark × (life × length)",
        "glottal": "a word-final short open syllable takes a glottal ʔ (จะ → t͡ɕaʔ)",
        "stress": "ˈ on syllable 1; ˌ on even syllable indices ≥2 (3, 5, 7…)",
    },

    // Onset consonant grapheme → IPA. อ = glottal ʔ; a silent ห/อ leader is dropped before this map is consulted.
    "onset": {
        "ก": "k",
        "ข": "kʰ",
        "ฃ": "kʰ",
        "ค": "kʰ",
        "ฅ": "kʰ",
        "ฆ": "kʰ",
        "ง": "ŋ",
        "จ": "t͡ɕ",
        "ฉ": "t͡ɕʰ",
        "ช": "t͡ɕʰ",
        "ซ": "s",
        "ฌ": "t͡ɕʰ",
        "ญ": "j",
        "ฎ": "d",
        "ฏ": "t",
        "ฐ": "tʰ",
        "ฑ": "tʰ",
        "ฒ": "tʰ",
        "ณ": "n",
        "ด": "d",
        "ต": "t",
        "ถ": "tʰ",
        "ท": "tʰ",
        "ธ": "tʰ",
        "น": "n",
        "บ": "b",
        "ป": "p",
        "ผ": "pʰ",
        "ฝ": "f",
        "พ": "pʰ",
        "ฟ": "f",
        "ภ": "pʰ",
        "ม": "m",
        "ย": "j",
        "ร": "r",
        "ล": "l",
        "ว": "w",
        "ศ": "s",
        "ษ": "s",
        "ส": "s",
        "ห": "h",
        "ฬ": "l",
        "อ": "ʔ",
        "ฮ": "h",
        "ฤ": "r",
    },
    // Coda consonant grapheme → IPA (8-way final neutralisation).
    "coda": {
        "ก": "k",
        "ข": "k",
        "ค": "k",
        "ฆ": "k",
        "ง": "ŋ",
        "จ": "t",
        "ช": "t",
        "ซ": "t",
        "ฎ": "t",
        "ฏ": "t",
        "ฐ": "t",
        "ฑ": "t",
        "ฒ": "t",
        "ด": "t",
        "ต": "t",
        "ถ": "t",
        "ท": "t",
        "ธ": "t",
        "ศ": "t",
        "ษ": "t",
        "ส": "t",
        "ญ": "n",
        "ณ": "n",
        "น": "n",
        "ร": "n",
        "ล": "n",
        "ฬ": "n",
        "บ": "p",
        "ป": "p",
        "พ": "p",
        "ฟ": "p",
        "ภ": "p",
        "ม": "m",
        "ย": "j",
        "ว": "w",
    },
    // Written-vowel unit (graphemes joined) → base quality (no length; ː is added from the scan's `long`).
    "vowelQuality": {
        "ะ": "a",
        "ั": "a",
        "า": "a",
        "ิ": "i",
        "ี": "i",
        "ึ": "ɯ",
        "ื": "ɯ",
        "ือ": "ɯ",
        "ุ": "u",
        "ู": "u",
        "ๅ": "a",
        "ัว": "ua",
        "ัวะ": "ua",
        "ว": "ua",
        "เ": "e",
        "เะ": "e",
        "แ": "ɛ",
        "แะ": "ɛ",
        "โ": "o",
        "โะ": "o",
        "เาะ": "ɔ",
        "เอ": "ɤ",
        "เอะ": "ɤ",
        "เิ": "ɤ",
        "เย": "ɤ",
        "เา": "a",
        "อ": "ɔ",
        "เีย": "ia",
        "เียะ": "ia",
        "เือ": "ɯa",
        "เือะ": "ɯa",
        "ไ": "a",
        "ใ": "a",
        "ไย": "a",
        "ำ": "a",
    },
    "noLength": ["ua", "ia", "ɯa"], // diphthongs — never take ː
    "forceLong": ["เอ", "เิ"], // เ–อ / เ–ิ are ɤː (long); the short exceptions (เงิน) are in the dict
    "raisable": "งญณนมยรลฬว", // sonorants a silent ห leader raises (drops the ห onset)

    // ⚠ THE SYLLABIFIER'S GRAPHEME CLASSES. These four decide where syllables BREAK and whether one is
    // live or dead — the inputs to the tone table below, not part of it.
    //
    // "vowelSigns" — standalone vowel signs, always a one-grapheme vowel.
    // ⚠ ⟨ำ⟩ IS DELIBERATELY ABSENT: it is a glide-bearing span (am), handled explicitly by the vowel-span
    // scanner rather than as a plain sign.
    "vowelSigns": ["ะ", "า", "ิ", "ี", "ึ", "ื", "ุ", "ู", "ั", "ๅ"],
    // "oGlottalNext" — ⟨อ⟩ is the glottal-stop CONSONANT [ʔ] before one of these, and the vowel [ɔː]
    // otherwise (epitran's vowel-diacritic list for อ→ʔ).
    // ⚠ ⟨ำ⟩ AND ⟨ๅ⟩ ARE DELIBERATELY ABSENT: epitran keeps ⟨อ⟩ as [ɔː] before them — อำนาจ → ɔːamnaːt.
    "oGlottalNext": ["า", "ี", "ู", "เ", "แ", "ื", "โ", "อ", "ะ", "ิ", "ุ", "ึ", "ไ", "ใ", "ั"],
    // "shortVowelSigns" — the short signs. Vowel LENGTH feeds the dead-short vs dead-long tone split, so
    // this list is upstream of the tone table.
    "shortVowelSigns": ["ะ", "ิ", "ึ", "ุ", "ั"],
    // "liveCodas" — the sonorant codas that make a syllable LIVE: the nasals and liquids ⟨มญณนรลฬง⟩ plus
    // the GLIDE codas ⟨ย ว⟩. A glide-final syllable is always live regardless of vowel length. (th-pron
    // reaches the same answer differently — it folds ย/ว into the nucleus, าย→aːj, าว→aːw, so the syllable
    // is open+long and therefore live. Our tokenizer treats the glide as a coda unit, so it is listed
    // here instead. This is what makes โดย mid and สาว rising.)
    "liveCodas": ["ม", "ญ", "ณ", "น", "ร", "ล", "ฬ", "ง", "ย", "ว"],

    // Tone system — a deterministic function of initial-consonant CLASS × syllable LIFE × vowel LENGTH × mark.
    "tone": {
        // Thai consonant → tonal class (อักษร กลาง/สูง/ต่ำ): 9 mid, 11 high, 24 low.
        "class": {
            "ก": "mid",
            "จ": "mid",
            "ฎ": "mid",
            "ฏ": "mid",
            "ด": "mid",
            "ต": "mid",
            "บ": "mid",
            "ป": "mid",
            "อ": "mid",
            "ข": "high",
            "ฃ": "high",
            "ฉ": "high",
            "ฐ": "high",
            "ถ": "high",
            "ผ": "high",
            "ฝ": "high",
            "ศ": "high",
            "ษ": "high",
            "ส": "high",
            "ห": "high",
            "ค": "low",
            "ฅ": "low",
            "ฆ": "low",
            "ง": "low",
            "ช": "low",
            "ซ": "low",
            "ฌ": "low",
            "ญ": "low",
            "ฑ": "low",
            "ฒ": "low",
            "ณ": "low",
            "ท": "low",
            "ธ": "low",
            "น": "low",
            "พ": "low",
            "ฟ": "low",
            "ภ": "low",
            "ม": "low",
            "ย": "low",
            "ร": "low",
            "ล": "low",
            "ฬ": "low",
            "ว": "low",
            "ฮ": "low",
        },
        // Tone from an explicit tone mark × class (mai ek/tho/tri/chattawa; ̄ = respelling-only forced mid).
        "fromMark": {
            "่": { "high": "low", "mid": "low", "low": "falling" },
            "้": { "high": "falling", "mid": "falling", "low": "high" },
            "๊": { "high": "high", "mid": "high", "low": "high" },
            "๋": { "high": "rising", "mid": "rising", "low": "rising" },
            "̄": { "high": "mid", "mid": "mid", "low": "mid" },
        },
        // Tone with NO mark, from syllable life+length × class.
        "noMark": {
            "dead-short": { "high": "low", "mid": "low", "low": "high" },
            "dead-long": { "high": "low", "mid": "low", "low": "falling" },
            "live": { "high": "rising", "mid": "mid", "low": "mid" },
        },
        // IPA Chao contour letters per tone.
        "ipa": {
            "high": "˦˥",
            "mid": "˧",
            "low": "˨˩",
            "rising": "˩˩˦",
            "falling": "˥˩",
        },
    },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Thai Character Cluster (TCC) rules — ported from PyThaiNLP (Apache-2.0; the Theeramunkong et al. algorithm).
    // Each alternative matches ONE inseparable cluster at the START of a string; segment.ts joins these with "|"
    // and wraps them "^(?:…)" to build THAI_TCC_RE (word boundaries are constrained to cluster boundaries).
    // ORDER IS LOAD-BEARING (leftmost-first, like the Python `|`). The literal `|` inside `[ูุ|ิ]` is faithful to
    // PyThaiNLP's expanded rule (its `[d|ิ]` template) — kept verbatim for parity; harmless since `|` never
    // occurs in a Thai run.
    "tcc": [
        "[ก-ฮ][ั]([่-๋][ก-ฮ])?",
        "[ก-ฮ][ั]([่-๋][ก-ฮ])?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ][่-๋]?าะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ]ี[่-๋]?ยะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ]ี[่-๋]?ย(?=[เ-ไก-ฮ]|$)([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ิีุู][่-๋]?ย(?=[เ-ไก-ฮ]|$)([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ิ[ก-ฮ]์[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ิ[่-๋]?[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ี[่-๋]?ยะ?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ื[่-๋]?อะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ื",
        "เ[ก-ฮ][่-๋]?า?ะ?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[ก-ฮ][ึื][่-๋]?[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[ก-ฮ][ะ-ู][่-๋]?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[ก-ฮ][ิุู]์",
        "[ก-ฮ]รร[ก-ฮ]์",
        "[ก-ฮ]็",
        "[ก-ฮ][่-๋]?[ะาำ]?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][ก-ฮ]์([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][่-๋]?ะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][ก-ฮ][ก-ฮ]์([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "โ[ก-ฮ][่-๋]?ะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[เ-ไ][ก-ฮ][่-๋]?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "ก็",
        "อึ",
        "หึ",
    ],

    // ⚠ KEYED BY UPPERCASE LATIN. The engine looks a run up by the character as WRITTEN, and an
    // embedded initialism in this script is always upper-case; lower-casing the keys would silently
    // miss every one. (Dictionary keys are not touched by the loader's camelCase property policy —
    // verified, not assumed, because that policy is exactly what mangled English's ARPABET block.)
    "letterNames": {
        "A": "เอ", "B": "บี", "C": "ซี", "D": "ดี", "E": "อี", "F": "เอฟ", "G": "จี", "H": "เอช",
        "I": "ไอ", "J": "เจ", "K": "เค", "L": "แอล", "M": "เอ็ม", "N": "เอ็น", "O": "โอ", "P": "พี",
        "Q": "คิว", "R": "อาร์", "S": "เอส", "T": "ที", "U": "ยู", "V": "วี", "W": "ดับเบิลยู",
        "X": "เอกซ์", "Y": "วาย", "Z": "แซด"
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, one name fleet-wide. In the abugida manifests `symbols` already means the
    // BARE-SIGN → word map the engine's tokenizer reads, so the shared tier cannot use that name there —
    // and having the same table under two names depending on the language is exactly the kind of split this
    // sweep exists to remove.
    "symbolTier": {
        // `&` was DROPPED outright, losing the sign from `ที่พักประเภท B&B`. `และ` is the ordinary
        // conjunction and the corpus's own word, ×1711 — the most frequent candidate by a wide margin (`กับ`
        // ×674 is "with", and `แอนด์`, the transliterated English "and", is ×0 here).
        // ⚠ THE STRONGEST EVIDENCE IS IN THE SENTENCE ITSELF: the corpus GLOSSES the abbreviation using this very
        // word — `ที่พักประเภท B&B แข่งขันกันในสองสิ่งเป็นหลัก คือ ที่นอนและอาหารเช้า` ("bed AND breakfast").
        // The text states what the sign expands to, in the same breath, with the conjunction chosen here.
        // `multiply` — the word is this language's OWN, harvested from its existing `×` rule, so nothing new
        // is sourced. Declaring it HERE is what makes ASCII `x` read like `×`: `6x6 cm` was reading the `x` as a
        // LETTER NAME, and `NxN` forms outnumber `×` roughly 85 to 20 across the corpora. One word, so `by` is
        // omitted and defaults to it — this language does not split dimension from product.
        "multiply": { "times": "คูณ" },
        "ampersand": "และ",
        "percent": ["เปอร์เซ็นต์"],
        // `5 km` read as *hˈaː˥˩ ˈʊkm*: no unit was declared. Verified in th_th, each immediately after a
        // numeral: กิโลเมตร ×25 "ห่างจากบัวโนสไอเรส 50 กิโลเมตร", เมตร ×46 "ยอดเขาวินสันสูง 4,892 เมตร",
        // เซนติเมตร ×1 "อยู่ห่างกันเพียง 69 เซนติเมตร". มิลลิเมตร and กิโลกรัม are ×0 and stay undeclared.
        "units": { "km": ["กิโลเมตร"], "m": ["เมตร"], "cm": ["เซนติเมตร"] },
        "currency": { "$": ["ดอลลาร์"], "€": ["ยูโร"], "£": ["ปอนด์"], "¥": ["เยน"] },
        // `ตารางกิโลเมตร` ×5 and `ลูกบาศก์เมตร` ×1.
        // ⚠ Bare ตาราง substring-matches ×11 and its first instance is `ตารางธาตุ` — the periodic TABLE, which
        // is what ตาราง means on its own. In an unspaced script the bare count cannot be a token count at all
        // (⚠ a word-boundary test is meaningless in an unspaced script), so only the full compound is evidence.
        // `before` RATHER THAN `compound`, against the orthography, because the fused form is MIS-SYLLABIFIED by
        // this G2P and the spaced one is not:
        //   5 ตารางกิโลเมตร  → …mˌeː˧to˧n      5 ตาราง กิโลเมตร  → …mˌeː˦˥t   (= bare กิโลเมตร)
        //   5 ลูกบาศก์เมตร   → lˈuːkbaː˧sˌa˨˩meː…   spaced → lˈuːkbaː˨˩t mˈeː˦˥t
        // The second is the clearer one: ลูกบาศก์ ends in a KARAN (ก์, a silencing mark) and only the spaced
        // reading honours it. This is not a defect introduced by the choice — the corpus's own
        // `2.2 ล้านตารางกิโลเมตรภายใน` already reads mˌeː˧to˧n as written, so the Thai compound path is broken
        // independently and is recorded as such. The space is an intermediate-representation hint to the G2P,
        // never output, so taking the correct reading costs nothing here.
        "exponentWords": { "squared": ["ตาราง"], "cubed": ["ลูกบาศก์"], "position": "before" },
        "unspacedScript": true
    }
}
