// Native canonical-IPA MANIFEST for English (en) — the small, hand-authored FACTS of English —
// hand-authored FACTS of English, consolidated into one self-describing file. UNLIKE hindi.jsonc,
// this is NOT the whole language: English is irregular, so its bulk data is STATISTICAL MODELS referenced
// under "models" below (a 125k-word lexicon + an n-gram OOV G2P + a POS perceptron), which cannot be
// authored as rules. Only the closed, hand-curatable facts live here.
//
// LOAD-BEARING blocks (via manifest.ts): "heteronyms", "numbers", "unstressedWords", "clausePunctuation",
// "nonTonicFinal", "whSecondary", "arpabet" (ARPABET→IPA + vowel bases), "g2pClasses" (injected into the pure
// OOV G2P). The "convention", "provenance", "models" blocks are self-describing documentation.
{
    "language": "en",
    "script": ["Latin"],
    "name": "English (General American)",
    "provenance": "CMUdict (public-domain lexicon) + a cleanroom joint-n-gram OOV G2P + a UD-EWT-trained averaged-perceptron POS tagger. Single canonical-IPA output mode, no fallback. WHICH words are heteronyms / function words, and the number words, are small closed language facts (no attribution needed).",

    // The canonical-IPA conventions every value below (and the CMUdict lexicon) is written in. These are
    // DOCUMENTATION — the engine bakes them into the IPA via englishArpabet.ts (ARPABET -> canonical IPA)
    // and the lexicon, cross-referenced here so the reader sees the whole decision in one place.
    "convention": {
        "stress": "before the nucleus (ˈ/ˌ precede the vowel, not the syllable)",
        "flapping": "intervocalic /t d/ → voiced flap t̬ (city → sˈɪt̬i)",
        "aspiration": "stressed voiceless-stop onsets kʰ pʰ tʰ",
        "darkL": "coda /l/ → ɫ",
        "offglides": "FACE/PRICE/MOUTH offglides as superscripts aᶦ aᶷ",
        "weakVowel": "reduced KIT → ᵻ",
        "rhotic": "NURSE ɝ, lettER ɚ",
        // ⚠ THIS SAID "merge": "LOT–THOUGHT → ɔː" AND THAT WAS NEVER TRUE OF THE ENGINE. `AA` renders `ɑː` and
        // `AO` renders `ɔː`, two distinct outputs, so whether a word merged depended entirely on which of the two
        // CMUdict happened to write — and CMUdict is not consistent. The result was an accent that was NEITHER:
        // `cot` and `caught` came out identical (both AA) while `lot`/`law` and `don`/`dawn` stayed distinct.
        // #1334 aligned the 466 straggler rows to misaki gold, which IS consistent — it distinguishes all seven
        // minimal pairs (cot/caught, don/dawn, lot/law, stock/stalk, odd/awed, hock/hawk, tot/taught) and keeps
        // PALM as ɑ — and which is the lexicon the downstream Kokoro model was trained on. 93.1% of our AA/AO
        // rows already agreed with it; the change was the remaining 6.9%.
        // ⚠ THE WIKIPRON REFEREE CANNOT ARBITRATE THIS and must not be used to: it writes `dawn` as `d ɑ n`,
        // merged, in the same file where it distinguishes elsewhere. That inconsistency is why the referee-eval
        // config REFUSES an ɔ/ɑ fold (see RefLang.intentional) — nothing there has been shown right.
        "lotThought": "DISTINGUISHED: LOT/CLOTH ɑː (cot, lot, don) vs THOUGHT ɔː (caught, law, dawn); PALM ɑː",
    },

    // ARPABET → canonical IPA correspondence (General American values). This is the DATA the converter reads;
    // the allophony ALGORITHM (flapping, aspiration, dark-l, ŋ-assimilation, ʲ-glide, stress marking) lives in
    // englishArpabet.ts. A different English variety (en-GB, en-AU) would supply its own `arpabet` block.
    "arpabet": {
        // Consonants + simple (unconditional) vowels. Stress-bearing / context-conditioned vowels are in
        // `conditionalVowels` below; IH's reduced ᵻ realization is applied by the engine's weak-vowel rule.
        "map": {
            "AA": "ɑː",
            "AE": "æ",
            "AO": "ɔː",
            "AW": "aᶷ",
            "AY": "aᶦ",
            "EH": "ɛ",
            "EY": "eᶦ",
            "IH": "ɪ",
            "OW": "oᶷ",
            "OY": "ɔᶦ",
            "UH": "ʊ",
            "B": "b",
            "CH": "t͡ʃ",
            "D": "d",
            "DH": "ð",
            "F": "f",
            "G": "ɡ",
            "HH": "h",
            "JH": "d͡ʒ",
            "K": "k",
            "L": "l",
            "M": "m",
            "N": "n",
            "NG": "ŋ",
            "P": "p",
            "R": "ɹ",
            "S": "s",
            "SH": "ʃ",
            "T": "t",
            "TH": "θ",
            "V": "v",
            "W": "w",
            "Y": "j",
            "Z": "z",
            "ZH": "ʒ",
        },
        // Vowels the engine resolves by stress (AH, ER) or a following R (IY, UW).
        // The ARPABET vowel bases (a fixed property of the notation). The allophony engine reads this to find nuclei.
        "vowels": [
            "AA",
            "AE",
            "AH",
            "AO",
            "AW",
            "AY",
            "EH",
            "ER",
            "EY",
            "IH",
            "IY",
            "OW",
            "OY",
            "UH",
            "UW",
        ],
        "conditionalVowels": {
            "AH": { "unstressed": "ə", "stressed": "ʌ" },
            "ER": { "unstressed": "ɚ", "stressed": "ɝ" },
            "IY": { "beforeR": "ɪ", "unstressed": "i", "stressed": "iː" },
            "UW": { "beforeR": "ʊ", "default": "uː" },
        },
    },

    // POS HETERONYMS — word → reading per part of speech, selected by the POS tagger (models.posModel) via
    // the token's threaded expectation: past → verb → noun → default. Excluded from the flat lexicon so the
    // POS choice wins. Regular -s/-es plurals get an appended allomorph (records → base + z); voicing pairs
    // (use/close/house) defer their plurals to the lexicon. See src/Phonemize/render.ts.
    "heteronyms": {
        "absent": { "default": "ˈæbsənt", "verb": "æbsˈɛnt" },
        "abstract": { "default": "ˈæbstɹækt", "verb": "æbstɹˈækt" },
        // ⚠ THESE TWO ARE HERE BECAUSE english.ts DELIBERATELY DOES NOT DERIVE THEM. It resolves the -s form
        // of a stress-shift heteronym at runtime (stem reading + sibilant allomorph), so `records`,
        // `projects` and 70-odd others need no row here and must not get one — a static copy of a runtime
        // rule is a second source of truth that goes stale silently. But `isVoicingHeteronym` EXCLUDES
        // voicing pairs, whose plural voicing is irregular (`house` hˈaᶷs → hˈaᶷzᵻz), and defers them to the
        // flat lexicon — which carries ONE reading. So "he uses it" read the NOUN's /s/, jˈuːsᵻz.
        // ⚠ Stated, not derived, which is the right mechanism for an irregular: each reading is written out
        // rather than computed from the stem. gold agrees on both (jˈuzᵻz/jˈusᵻz, əbjˈuzᵻz/əbjˈusᵻz).
        "abuses": { "default": "əbjˈuːsᵻz", "verb": "əbjˈuːzᵻz" },
        "abuse": { "default": "əbjˈuːs", "verb": "əbjˈuːz" },
        "accent": { "default": "ˈæksɛnt", "verb": "əksˈɛnt" },
        "addict": { "default": "ˈædɪkt", "verb": "ədˈɪkt" },
        "address": { "default": "ˈædɹɛs", "verb": "ədɹˈɛs" },
        "advert": { "default": "ˈædvɚt", "verb": "ædvˈɝt" },
        "alternate": { "default": "ˈɔːɫtɚnət", "verb": "ˈɔːɫtɚnˌeᶦt" },
        "annex": { "default": "ˈænɛks", "verb": "ənˈɛks" },
        "appropriate": { "default": "əpɹˈoᶷpɹiʲət", "verb": "əpɹˈoᶷpɹiʲˌeᶦt" },
        "approximate": { "default": "əpɹˈɑːksəmət", "verb": "əpɹˈɑːksəmˌeᶦt" },
        "attribute": { "default": "ˈætɹəbjˌuːt", "verb": "ətɹˈɪbjuːt" },
        "bow": { "default": "bˈoᶷ", "verb": "bˈaᶷ" },
        "close": { "default": "klˈoᶷs", "verb": "klˈoᶷz" },
        "combat": { "default": "kʰˈɑːmbæt", "verb": "kəmbˈæt" },
        "combine": { "default": "kəmbˈaᶦn", "noun": "kʰˈɑːmbaᶦn" },
        "commune": { "default": "kʰˈɑːmjuːn", "verb": "kəmjˈuːn" },
        "compact": { "default": "kʰˈɑːmpækt", "verb": "kəmpˈækt" },
        "compound": { "default": "kʰˈɑːmpaᶷnd", "verb": "kəmpˈaᶷnd" },
        "concert": { "default": "kʰˈɑːnsɚt", "verb": "kənsˈɝt" },
        // ⚠ ⟨n⟩, NOT ⟨ŋ⟩, at the `con-`/`in-` boundary — these three carried the unconditioned velar
        // assimilation the engine rule used to apply, frozen into the table where the rule fix cannot
        // reach them. CMUdict writes `N` for all three and the recordings agree (`conclude` n, `income`
        // n×4, `increase` n×4); see the rule in englishArpabet.ts for the full evidence.
        "concrete": { "default": "kʰˈɑːnkɹit", "verb": "kənkɹˈiːt" },
        "conduct": { "default": "kʰˈɑːndəkt", "verb": "kəndˈʌkt" },
        "conflict": { "default": "kʰˈɑːnflɪkt", "verb": "kənflˈɪkt" },
        "conscript": { "default": "kʰˈɑːnskɹɪpt", "verb": "kənskɹˈɪpt" },
        "console": { "default": "kʰˈɑːnsoᶷɫ", "verb": "kənsˈoᶷɫ" },
        "consort": { "default": "kʰˈɑːnsɔːɹt", "verb": "kənsˈɔːɹt" },
        "construct": { "default": "kʰˈɑːnstɹəkt", "verb": "kənstɹˈʌkt" },
        "content": { "default": "kʰˈɑːntɛnt", "verb": "kəntˈɛnt" },
        "contest": { "default": "kʰˈɑːntɛst", "verb": "kəntˈɛst" },
        "contract": { "default": "kʰˈɑːntɹækt", "verb": "kəntɹˈækt" },
        "contrast": { "default": "kʰˈɑːntɹæst", "verb": "kəntɹˈæst" },
        "converse": { "default": "kʰˈɑːnvɚs", "verb": "kənvˈɝs" },
        "convert": { "default": "kʰˈɑːnvɚt", "verb": "kənvˈɝt" },
        "convict": { "default": "kʰˈɑːnvɪkt", "verb": "kənvˈɪkt" },
        "coordinate": { "default": "koᶷˈɔːɹd̬ənət", "verb": "koᶷˈɔːɹd̬ənˌeᶦt" },
        "costume": { "default": "kʰˈɑːstuːm", "verb": "kɑːstˈuːm" },
        "decrease": { "default": "dᵻkɹˈiːs", "noun": "dˈiːkɹiːs" },
        "defect": { "default": "dˈiːfɛkt", "verb": "dᵻfˈɛkt" },
        "degenerate": { "default": "dᵻd͡ʒˈɛnɚˌeᶦt", "noun": "dᵻd͡ʒˈɛnɚət" },
        "deliberate": { "default": "dᵻlˈɪbɚət", "verb": "dᵻlˈɪbɚˌeᶦt" },
        "desert": { "default": "dˈɛzɚt", "verb": "dᵻzˈɝt" },
        // ⚠ `detail` WAS HERE AND IS NOT, because it is the one entry in this table whose two readings
        // are a REGIONAL variant rather than a part-of-speech distinction. Every other row is a stress
        // pair a speaker uses BOTH of (`ˈæbstɹækt` the thing, `æbstɹˈækt` the act); this one asked the
        // POS tagger to choose between `ˈdiːteᶦl` and `dᵻtˈeᶦl`, which no tagger can do because the
        // noun takes both. It also split its own paradigm: the table claimed the base while the
        // lexicon kept `detailed`, so `details` read DEE-tails beside de-TAILED.
        // CMUdict records ONE pronunciation for all three forms — `D IH0 T EY1 L` — so the table was
        // asserting a reading its own source does not carry. Reported by a Canadian reader; General
        // American does use the front-stressed noun, so this is a one-line restore if that is wanted.
        "detour": { "default": "dˈiːt̬ʊɹ", "verb": "dᵻtʰˈʊɹ" },
        "dictate": { "default": "dɪktˈeᶦt", "noun": "dˈɪkteᶦt" },
        "digest": { "default": "dˈaᶦd͡ʒɛst", "verb": "daᶦd͡ʒˈɛst" },
        "discharge": { "default": "dɪst͡ʃˈɑːɹd͡ʒ", "noun": "dˈɪst͡ʃɑːɹd͡ʒ" },
        "dove": { "default": "dˈʌv", "past": "dˈoᶷv" },
        "egress": { "default": "ˈiːɡɹɛs", "verb": "iɡɹˈɛs" },
        "elaborate": { "default": "ɪlˈæbɚˌeᶦt", "noun": "ɪlˈæbɹət" },
        "entrance": { "default": "ˈɛntɹəns", "verb": "ɛntɹˈæns" },
        "escort": { "default": "ˈɛskɔːɹt", "verb": "ɛskˈɔːɹt" },
        "essay": { "default": "ˈɛseᶦ", "verb": "ɛsˈeᶦ" },
        "estimate": { "default": "ˈɛstəmət", "verb": "ˈɛstəmˌeᶦt" },
        "excess": { "default": "ˈɛksɛs", "verb": "ɪksˈɛs" },
        // ⚠ THE VERB IS /z/, NOT /s/, AND THAT MAKES THIS A STRESS PAIR RATHER THAN A VOICING ONE. misaki
        // gold has ˈɛksˌIz / ɪksˈIz and Moby /I/k's/aI/z — both readings voiced, in both sources. With the
        // /s/ the two readings differed only in their FINAL CONSONANT, so `isVoicingHeteronym` classified
        // it as a voicing pair and english.ts stopped deriving its -s plural, which then fell to the flat
        // lexicon as a single reading. Corrected, `excises` is derived POS-gated for free.
        "excise": { "default": "ˈɛksaᶦz", "verb": "ɛksˈaᶦz" },
        "exploit": { "default": "ˈɛksplɔᶦt", "verb": "ɛksplˈɔᶦt" },
        "export": { "default": "ˈɛkspɔːɹt", "verb": "ɪkspˈɔːɹt" },
        "extract": { "default": "ˈɛkstɹækt", "verb": "ɪkstɹˈækt" },
        "ferment": { "default": "fɚmˈɛnt", "noun": "fˈɝmɛnt" },
        "finance": { "default": "fˈaᶦnæns", "verb": "fənˈæns" },
        "forearm": { "default": "fˈɔːɹɑːɹm", "verb": "fɔːɹˈɑːɹm" },
        "fragment": { "default": "fɹˈæɡmənt", "verb": "fɹæɡmˈɛnt" },
        "graduate": { "default": "ɡɹˈæd͡ʒəwət", "verb": "ɡɹˈæd͡ʒuːˌeᶦt" },
        "house": { "default": "hˈaᶷs", "verb": "hˈaᶷz" },
        "houses": { "default": "hˈaᶷzᵻz" },
        "impact": { "default": "ˈɪmpækt", "verb": "ɪmpˈækt" },
        "implant": { "default": "ˈɪmplænt", "verb": "ɪmplˈænt" },
        "import": { "default": "ˈɪmpɔːɹt", "verb": "ɪmpˈɔːɹt" },
        "imprint": { "default": "ˈɪmpɹɪnt", "verb": "ɪmpɹˈɪnt" },
        "impulse": { "default": "ˈɪmpəɫs", "verb": "ɪmpˈʌɫs" },
        "inbound": { "default": "ˈɪnbaᶷnd", "verb": "ɪnbˈaᶷnd" },
        "incense": { "default": "ˈɪnsɛns", "verb": "ɪnsˈɛns" },
        "incline": { "default": "ɪnklˈaᶦn", "noun": "ˈɪnklaᶦn" },
        "increase": { "default": "ˈɪnkɹiːs", "verb": "ɪnkɹˈiːs" },
        "insert": { "default": "ˈɪnsɚt", "verb": "ɪnsˈɝt" },
        "insult": { "default": "ˈɪnsʌɫt", "verb": "ɪnsˈʌɫt" },
        "intern": { "default": "ˈɪntɚn", "verb": "ɪntˈɝn" },
        "lead": { "default": "lˈiːd" },
        "live": { "default": "lˈaᶦv", "verb": "lˈɪv" },
        "moderate": { "default": "mˈɑːd̬ɚət", "verb": "mˈɑːd̬ɚˌeᶦt" },
        "object": { "default": "ˈɑːbd͡ʒɛkt", "verb": "əbd͡ʒˈɛkt" },
        "offset": { "default": "ˈɔːfsɛt", "verb": "ɔːfsˈɛt" },
        "perfect": { "default": "pʰˈɝfɪkt", "verb": "pɚfˈɛkt" },
        "permit": { "default": "pʰˈɝmᵻt", "verb": "pɚmˈɪt" },
        "pervert": { "default": "pʰˈɝvɚt", "verb": "pɚvˈɝt" },
        "present": { "default": "pɹˈɛzənt", "verb": "pɹᵻzˈɛnt" },
        "produce": { "default": "pɹədˈuːs", "noun": "pɹˈoᶷd̬uːs" },
        "progress": { "default": "pɹˈɑːɡɹɛs", "verb": "pɹəɡɹˈɛs" },
        "project": { "default": "pɹˈɑːd͡ʒɛkt", "verb": "pɹəd͡ʒˈɛkt" },
        "protest": { "default": "pɹˈoᶷt̬ɛst", "verb": "pɹətʰˈɛst" },
        "read": { "default": "ɹˈiːd", "past": "ɹˈɛd" },
        "rebel": { "default": "ɹˈɛbəɫ", "verb": "ɹᵻbˈɛɫ" },
        "recall": { "default": "ɹˈiːkʰɔːɫ", "verb": "ɹᵻkʰˈɔːɫ" },
        "recess": { "default": "ɹˈiːsɛs", "verb": "ɹᵻsˈɛs" },
        // ⚠ THE NOUN IS INITIAL-STRESSED, AND THIS IS MEASURED RATHER THAN PREFERRED. The asr-align
        // corpus is the only instrument here that witnesses spoken register, and across every en_us
        // utterance containing the stem it heard the FULL FLEECE prefix — 15 of 15, zero reduced:
        // `it narrows the research`, `cautioned that the research` and `his research showed` all came back
        // with ɹ iː. ⚠ ONLY THE PREFIX IS EVIDENCE: that recognizer emits ɝ zero times in 2,602 en_us rows,
        // so its unstressed-looking second syllable would print the same either way.
        // ⚠ espeak DISAGREES (ɹᵻsˈɜːtʃ, and ɹᵻsˈɜːtʃɚ for `researcher`), and Merriam-Webster lists the
        // final-stressed noun first — which is why this needed an instrument rather than a dictionary
        // vote. The verb keeps the final-stressed reading; the corpus has no verb instance to check it
        // against, so that half rests on the dictionaries alone.
        // ⚠ KNOWN LIMIT: en-GB inherits this block, and the corpus has ZERO en_gb rows for the stem.
        // BrE leans final-stressed for both parts of speech, so the noun reading here is the American
        // one applied to both varieties — mitigated only by the UK referee listing initial-stressed
        // `researcher` (ɹiːsɜːt͡ʃə) FIRST of its two variants. Revisit if en_gb audio ever lands.
        "research": { "default": "ɹˈiːsɚt͡ʃ", "verb": "ɹisˈɝt͡ʃ" },
        "record": { "default": "ɹˈɛkɚd", "verb": "ɹᵻkʰˈɔːɹd" },
        // ⚠ THE DEFAULT IS THE NOUN AND THE MARKED FORM IS THE ADJECTIVE, which is the opposite way
        // round from every other entry here — and is what the reference gold says, keying this word
        // as {ADJ, DEFAULT} rather than {NOUN, DEFAULT}. CMUdict carries only the adjective
        // (EH2 R IH0 TH M EH1 T IH0 K), so "the arithmetic is wrong" came out ar-ith-MET-ic: the
        // property's stress on the subject's word. The adjective use is the narrower one — an
        // arithmetic mean, an arithmetic progression — so it is the one that has to be asked for.
        "arithmetic": { "default": "əɹˈɪθmətʰˌɪk", "adj": "ˌɛɹɪθmˈɛt̬ɪk" },
        "redress": { "default": "ɹᵻdɹˈɛs", "noun": "ɹˈiːdɹɛs" },
        "refund": { "default": "ɹˈiːfənd", "verb": "ɹᵻfˈʌnd" },
        "refuse": { "default": "ɹᵻfjˈuːz", "noun": "ɹˈɛfjuːs" },
        "reject": { "default": "ɹᵻd͡ʒˈɛkt", "noun": "ɹˈiːd͡ʒɛkt" },
        "resent": { "default": "ɹᵻzˈɛnt", "past": "ɹizˈɛnt" },
        "romance": { "default": "ɹˈoᶷmæns", "verb": "ɹoᶷmˈæns" },
        "segment": { "default": "sˈɛɡmənt", "verb": "sɛɡmˈɛnt" },
        "separate": { "default": "sˈɛpɹət", "verb": "sˈɛpɚˌeᶦt" },
        "subject": { "default": "sˈʌbd͡ʒɪkt", "verb": "səbd͡ʒˈɛkt" },
        "subordinate": { "default": "səbˈɔːɹd̬ənət", "verb": "səbˈɔːɹd̬ənˌeᶦt" },
        "surcharge": { "default": "sˈɝt͡ʃɑːɹd͡ʒ", "verb": "sɚt͡ʃˈɑːɹd͡ʒ" },
        "survey": { "default": "sˈɝveᶦ", "verb": "sɚvˈeᶦ" },
        "suspect": { "default": "sˈʌspɛkt", "verb": "səspˈɛkt" },
        "tear": { "default": "tʰˈɪɹ", "verb": "tʰˈɛɹ" },
        "torment": { "default": "tʰˈɔːɹmɛnt", "verb": "tɔːɹmˈɛnt" },
        "transfer": { "default": "tɹˈænsfɚ", "verb": "tɹænsfˈɝ" },
        "transform": { "default": "tɹænsfˈɔːɹm", "noun": "tɹˈænsfɔːɹm" },
        "transport": { "default": "tɹˈænspɔːɹt", "verb": "tɹænspˈɔːɹt" },
        "triplicate": { "default": "tɹˈɪplɪkət", "verb": "tɹˈɪplɪkˌeᶦt" },
        "update": { "default": "ˈʌpdeᶦt", "verb": "əpdˈeᶦt" },
        "upgrade": { "default": "ˈʌpɡɹeᶦd", "verb": "əpɡɹˈeᶦd" },
        "upset": { "default": "ˈʌpsɛt", "verb": "əpsˈɛt" },
        "uses": { "default": "jˈuːsᵻz", "verb": "jˈuːzᵻz" },
        "use": { "default": "jˈuːs", "verb": "jˈuːz" },
        // ⚠ NOT A STRESS PAIR LIKE ITS NEIGHBOURS — a VOWEL pair, and the two senses are unrelated words.
        // The fabric is wˈʊstᵻd (from Worstead in Norfolk); the past tense of `worst` is wˈɝstᵻd. CMUdict
        // carries only the verb, so the fabric read wˈɝstᵻd in every text about textiles.
        // ⚠ SURFACED BY THE #1374 AUDIT AS A "BOTH SOURCES AGREE AGAINST US" ROW, which it is not: gold
        // and Moby carry the FABRIC and CMUdict the VERB, and neither is wrong. A candidate that is
        // really a heteronym is the one shape the audit cannot tell from a defect.
        "worsted": { "default": "wˈʊstᵻd", "verb": "wˈɝstᵻd" },
        "wind": { "default": "wˈɪnd", "verb": "wˈaᶦnd" },
        "wound": { "default": "wˈuːnd", "past": "wˈaᶷnd" },
    },

    // NUMBER WORDS — canonical IPA for the number words, so 42 reads exactly like typed "forty two"
    // (12 → twˈɛɫv, with dark-l/aspiration). CMUdict-sourced + an authored high-magnitude supplement
    // (quadrillion…nonillion, on the regular -illion pattern). units[0-9], teens[10-19], tens by value,
    // magnitudes[0]=thousand..[9]=nonillion (hundred is separate). Digit input is expanded to these WORDS
    // (numbers.ts) which then resolve through the lexicon like any word, so 42 == "forty two". ORDINALS
    // (1st -> "first") and decimals route through the same word path. See src/languages/english/english.ts.
    // Cardinal number WORDS (short scale). A digit becomes these words, which then resolve through the lexicon
    // like any other word (42 == "forty two"), so no IPA is stored here. Composition logic is in numbers.ts.
    "numbers": {
        "ones": [
            "zero",
            "one",
            "two",
            "three",
            "four",
            "five",
            "six",
            "seven",
            "eight",
            "nine",
            "ten",
            "eleven",
            "twelve",
            "thirteen",
            "fourteen",
            "fifteen",
            "sixteen",
            "seventeen",
            "eighteen",
            "nineteen",
        ],
        "tens": [
            "",
            "",
            "twenty",
            "thirty",
            "forty",
            "fifty",
            "sixty",
            "seventy",
            "eighty",
            "ninety",
        ],
        "hundred": "hundred",
        "scale": [
            "thousand",
            "million",
            "billion",
            "trillion",
            "quadrillion",
            "quintillion",
            "sextillion",
            "septillion",
            "octillion",
            "nonillion",
        ],
        "ordinals": {
            "zero": "zeroth",
            "one": "first",
            "two": "second",
            "three": "third",
            "four": "fourth",
            "five": "fifth",
            "six": "sixth",
            "seven": "seventh",
            "eight": "eighth",
            "nine": "ninth",
            "ten": "tenth",
            "eleven": "eleventh",
            "twelve": "twelfth",
            "thirteen": "thirteenth",
            "fourteen": "fourteenth",
            "fifteen": "fifteenth",
            "sixteen": "sixteenth",
            "seventeen": "seventeenth",
            "eighteen": "eighteenth",
            "nineteen": "nineteenth",
            "twenty": "twentieth",
            "thirty": "thirtieth",
            "forty": "fortieth",
            "fifty": "fiftieth",
            "sixty": "sixtieth",
            "seventy": "seventieth",
            "eighty": "eightieth",
            "ninety": "ninetieth",
            "hundred": "hundredth",
            "thousand": "thousandth",
            "million": "millionth",
            "billion": "billionth",
            "trillion": "trillionth",
            "quadrillion": "quadrillionth",
            "quintillion": "quintillionth",
            "sextillion": "sextillionth",
            "septillion": "septillionth",
            "octillion": "octillionth",
            "nonillion": "nonillionth",
        },
    },

    // ARPABET phonetic-class sets the OOV G2P uses (injected into the PURE englishG2p.ts, which reads no files
    // — so it still ports trivially to C#). vowelLetters are orthographic; the rest are ARPABET phone classes;
    // stopPieces are short common words the compound-splitter must not split on.
    "g2pClasses": {
        "vowelLetters": ["a", "e", "i", "o", "u"],
        "voiceless": ["P", "T", "K", "F", "TH", "S", "SH", "CH", "HH"],
        "sibilants": ["S", "Z", "SH", "ZH", "CH", "JH"],
        "stopPieces": [
            "the",
            "and",
            "for",
            "are",
            "but",
            "not",
            "you",
            "all",
            "any",
            "can",
            "her",
            "was",
            "one",
            "our",
            "out",
            "his",
            "has",
            "had",
            "him",
            "how",
            "man",
            "new",
            "now",
            "old",
            "see",
            "two",
            "way",
            "who",
            "boy",
            "did",
            "its",
            "let",
            "put",
            "say",
            "she",
            "too",
            "use",
            "ate",
            "eat",
            "ion",
            "per",
        ],

        // THE COMPOUND SPLITTER'S STRESS DISCRIMINATOR. When the first piece of a split is one of these,
        // the STEM keeps the primary (`dis·AGREE`, `mis·LEAD`, `inter·CEPT`); otherwise the compound path
        // fore-stresses, which is right for a real compound (`BACK·yard`, `HEAD·mistress`).
        //
        // Scored against the dictionary over the 13,661 words the compound path decodes and whose
        // segments already match their dict row:
        //
        //     fore-stress always (what shipped before)         78.8%
        //     stem-stress always                               20.3%
        //     keyed on en-morph-boundary.tsv's `prefix` label   83.1%
        //     this list                                         84.0%    +710 words
        //
        // ⚠ THE LIST BEATS THE TABLE #1360 BUILT FOR THIS CONSUMER, and could not have been the table
        // anyway: `tools/gen/en-morph-boundary.tsv` ships in neither package, and it cannot speak to a
        // word Wiktionary does not carry — which is most of what reaches an OOV path. The table found the
        // class; this is how the engine expresses it, and unlike the table it ports to C#.
        //
        // ⚠ THE RULE IS ONE STATED CRITERION WITH NO HAND-PICKED EXCEPTIONS: the dictionary puts the
        // primary on the STEM for at least 74% of that piece's rows, over at least 12 rows. Per entry,
        // that share and the net gain:
        //
        //     non 97% +133   dis 95% +166   mis 94% +76   extra 94% +15   radio 94% +14
        //     neo 92%  +10   pre 89%  +81   trans 86% +15   photo 81% +10   psycho 81% +13
        //     electro 78% +13   anti 77% +24   bio 77% +19   inter 76% +73   arch 75% +6
        //
        // ⚠ THE THREE PIECES THAT CLEAR THE CRITERION AND ARE STILL REFUSED ARE NOT PREFIXES. `van`
        // (85%, n=73), `imp` (82%, n=22) and `outs` (88%) are the splitter cutting a surname
        // (`van|derbilt`) or a fragment. Fitting them would fit the splitter's noise rather than English
        // morphology, and no phonological statement covers them. Every entry above is a bound prefix.
        //
        // ⚠ `sub` MISSES THE FLOOR AT 73% AND THAT IS NOT AN ACCIDENT OF SAMPLING. `sub-` is genuinely
        // two prefixes: the Latinate verbs are stem-stressed (sub·MIT, sub·TRACT) and the productive
        // noun-former is not (SUB·way, SUB·set, SUB·reddit). An earlier version of this list admitted it
        // on a "positive net" criterion and turned `subreddit` — pinned in `english.test.ts` since long
        // before this rule — into sʌbˈɹɛdɪt. The productive kind is exactly what reaches an OOV path,
        // which a dictionary-shaped population under-represents, so the floor is doing real work here.
        //
        // ⚠ THE DICTIONARY-POPULATION BIAS APPLIES TO THE WHOLE LIST, NOT ONLY TO `sub`, AND IT IS
        // BOUNDED RATHER THAN ABSENT. Held out from the dict, this rule reads `interface`, `internet`,
        // `photocopy`, `presale` and `antibody` as stem-stressed, and all of them are fore-stressed
        // nouns. What saves the number is that those words ARE in the measured population — they are
        // dict rows, held out one at a time — so the 74% floor has already priced them in, and `inter`
        // still clears it at 76% over 141 rows. What no dictionary-shaped population can supply is the
        // RATE at which each class turns up in real OOV text, and that is a real limit on every figure
        // in this comment. `sub` is called out separately because it is the one entry where the split
        // between the two classes is even enough to put it under the floor on its own.
        //
        // ⚠ AND THE STRESSED PREFIXES ARE ABSENT ON PRINCIPLE AND ON MEASUREMENT BOTH. `over`, `under`,
        // `super`, `multi`, `poly`, `post` and `pro` measure around half — they carry their own stress
        // and behave like the first element of a compound as often as not. `over·COME` stays a
        // dictionary row and a documented curation gap because of it.
        //
        // ⚠ IT IS NOT LOSSLESS AND IS NOT MEANT TO BE. `psychobabble` ˈsaɪkoʊˌbæbəl is fore-stressed and
        // both referees say so, while `psychosocial` ˌsaɪkoʊˈsoʊʃəl is stem-stressed and both referees
        // say so. The same prefix, opposite answers — which is why those are dictionary rows and a
        // curation gap, not an argument against a rule that is right 84% of the time.
        "stemStressPrefixes": [
            "anti",
            "arch",
            "bio",
            "dis",
            "electro",
            "extra",
            "inter",
            "mis",
            "neo",
            "non",
            "photo",
            "pre",
            "psycho",
            "radio",
            "trans",
        ],
    },

    // REFERENCED statistical models — the part Hindi has no equivalent of. NOT inlined (megabytes of
    // lexical/statistical data, not authorable facts); listed here so the manifest documents the whole path.
    "models": {
        "lexicon": {
            "file": "accent-lexicon.tsv",
            "words": 124928,
            "note": "CMUdict → canonical IPA; the flat per-word override (the 'grapheme→IPA table' an irregular language can only express as a word list).",
        },
        "oovG2p": {
            "model": "g2p-model.json",
            "dict": "g2p-dict.tsv",
            "common": "g2p-common.txt",
            "note": "cleanroom joint n-gram — the rule engine Hindi doesn't need (English spelling isn't rule-derivable).",
        },
        "posModel": {
            "file": "pos-model.json",
            "note": "averaged perceptron (UD-EWT); drives heteronym selection + de-accenting.",
        },
    },

    // Per-word resolution order in src/languages/english/english.ts. No fallback anywhere.
    "resolve": [
        "number words",
        "heteronym (POS-gated)",
        "possessive 's",
        "flat lexicon",
        "OOV G2P",
    ],
    // UNSTRESSED function words — English's closed grammatical class (articles, prepositions, conjunctions,
    // auxiliaries, unstressed pronouns). WHICH words are function words is a language fact. The de-accent
    // pass strips their citation primary stress (I -> a, not stressed); a clause left with no primary then
    // promotes its last word to the nuclear tonic. See src/languages/english/english.ts.
    // ACRONYMS read letter-by-letter although their lowercase form is an ordinary word, so the
    // pronunciation dictionary cannot express the distinction (CMUdict has "us" as the pronoun [ʌs]).
    // A LEXICAL fact, listed rather than derived: the wikipron referee records the near-identical USAR as
    // a WORD [jusɑɹ] while USAF is letters, which is why spelling cannot decide it. Everything else is
    // left to the dictionary or, if unrecorded and unpronounceable, spelled out by the OOV rule.
    "acronymLetters": [
        "us", "un", "it", "id", "am", "led", "who", "usaf", "usda", "usps", "ieee",
        // Pronounceable by the OOV test, so it would be left to the g2p, which mangles it ([niːk]).
        "nyc", "latam", "minae", "rov", "suv",
        // ⚠ `ai` IS A DICTIONARY WORD AND THAT IS WHY IT NEEDS TO BE HERE. CMUdict records `ai` as [AY1]
        // — the three-toed sloth — so `AI` resolved to the word and read as "eye". The lowercase form is
        // untouched (this list is case-gated: `it` is still [ˈɪt]), and the acronym is now spelled out.
        // Confirmed against misaki's gold, which letter-spells it. The frequency argument is one-sided:
        // the sloth is a crossword word and the initialism is in every other sentence about software.
        "ai",
        // ⚠ SAME SHAPE AS `ai`, AND THE GOLDS AGREE WITH THE DICTIONARY THAT IT SHOULD. CMUdict and both
        // misaki golds record `psi` as [S AY1] — the Greek letter — so `PSI` resolved to the word and read
        // as "sigh" where the unit (pounds per square inch) is said letter by letter. Case-gated like the
        // rest of this list, so the Greek letter in running prose is untouched.
        "psi",
        // ⟨u⟩ and ⟨a⟩ are vowels and ⟨cl⟩ a legal onset, so the phonotactic gate calls this READABLE and
        // leaves it to the g2p, which invents the word [ˈuːklɑː]. Same shape as `cra` and `nyc` above.
        "ucla", "atv", "gps", "hiv", "ufo", "faa", "epa", "irs",
        // ⟨cr⟩ is a legal onset and ⟨a⟩ a vowel, so the phonotactic test calls this READABLE and leaves it
        // to the g2p, which duly invents the word [kɹˈæ]. It is said letter by letter.
        "cra",
        // DOUBLED LETTERS. A repeated capital is a code — an alphanumeric identifier, a date mask
        // (YYYY-MM-DD), a size (AA battery) — and never a word being used as one, but each of these
        // reaches the initialism pass looking like one and is read as a word:
        //     AA [ˈɑː]  the Hawaiian lava word, which CMUdict records
        //     MM [m]    the interjection, likewise recorded
        //     EE [ˈiː]  ONE letter name for two letters — the worst of them, because it looks right
        //     OO [ˈuː]  UU [ˈʌ]  YY [d͡ʒˈiː]  invented by the OOV g2p, which finds them pronounceable
        // Reported as a project code ending in `-AA` read as one run-together vowel instead of two
        // letter names. CC and SS are absent on purpose: CMUdict already records those two with their
        // LETTER readings, in one token with one stress, which is better prosody than spelling out.
        "aa", "ee", "mm", "oo", "uu", "yy",
        // …and the four-Y date mask, which the same measurement turned up: `YYYY-MM-DD` read its
        // first field as the invented word [jˈiːʲiʲi]. DD needs no entry — it is unrecorded and
        // unpronounceable, so the OOV rule already spells it.
        "yyyy",
    ],

    "unstressedWords": [
        "about",
        "above",
        "across",
        "among",
        "amongst",
        "an",
        "and",
        "as",
        "at",
        "be",
        "been",
        "before",
        "behind",
        "below",
        "beneath",
        "beside",
        "between",
        "beyond",
        "by",
        "could",
        "did",
        "do",
        "does",
        "for",
        "from",
        "had",
        "has",
        "have",
        "he",
        "her",
        "hers",
        "his",
        "i",
        "if",
        "in",
        "is",
        "it",
        "its",
        "may",
        "might",
        "my",
        "not",
        "of",
        "or",
        "our",
        "over",
        "per",
        "she",
        "should",
        "than",
        "that",
        "their",
        "there",
        "these",
        "they",
        "this",
        "those",
        "through",
        "to",
        "under",
        "upon",
        "was",
        "we",
        "what",
        "whenever",
        "which",
        "will",
        "with",
        "within",
        "without",
        "would",
        "you",
        "your",
    ],

    // Clause / phrase punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Personal pronouns that stay DE-ACCENTED at clause end — the nuclear tonic holds on the preceding content
    // word ("please use it" → jˈuːz ɪt, not …ˈɪt). Demonstratives (this/that) and content words take the
    // clause-final tonic, so they are excluded.
    "nonTonicFinal": [
        "i",
        "you",
        "he",
        "she",
        "it",
        "we",
        "they",
        "me",
        "him",
        "her",
        "us",
        "them",
    ],

    // Interrogative / relative PRONOUNS demote to SECONDARY (not fully unstressed) in non-tonic position
    // ("what is the use" → wˌʌt). The wh-ADVERBS (how/where/when/why) keep their citation stress, so they are
    // NOT listed here.
    "whSecondary": ["what", "which", "who", "whom", "whose"],

    // THE STRONG FORM OF A COORDINATOR THAT OPENS A CLAUSE. Both reduce everywhere else; one
    // RESUMING after a pause is phrase-initial and carries the beat that restarts the clause.
    //
    // ⚠ IT IS A MAP, NOT A LIST, BECAUSE `and` HAS NO STRONG FORM TO FALL BACK ON. CMUdict carries
    // only the weak `AH0 N D`, so the lexicon's citation IS `ənd` and "keep the citation stress"
    // would be a no-op for exactly the word this exists for. The strong form is written out.
    //
    // ⚠ `or` IS DELIBERATELY ABSENT, and was in an earlier draft. It is the obvious parallel — also a
    // coordinator, also in "unstressedWords" — but it was extrapolated from `and` rather than tested,
    // and the A/B did not support it: the listener reported the strong and reduced readings as
    // differing only in "pure speaker dynamicism", with no meaning carried either way. `and` earns its
    // entry because the reduced reading was reported as actively WRONG ("ind"). One word, one piece of
    // evidence; the parallel that sounded obvious is left out until something measures it.
    //
    // ⚠ COORDINATORS ONLY — the other clause-initial function words (the, to, of, in) must keep
    // reducing; "…, the man arrived" does not want `ðˈiː`. What licenses this is the resumption, not
    // the position. "but", "so", "nor" and "yet" are absent for a different reason: they are not in
    // "unstressedWords" to begin with and so were never reduced.
    "clauseInitialStressed": { "and": "ˈænd" },

    // ⚠ ENGLISH NEEDS ALMOST NO LETTER-NAME DATA, and that is why there is no `letterNames` table here.
    // CMUdict already carries all 26 single letters with their letter-NAME pronunciations (f = EH1 F,
    // h = EY1 CH, w = D AH1 B AH0 L Y UW0), so emitting the bare letters space-separated resolves
    // correctly — the speller is a RULE, not a table. The EXCEPTIONS are genuine data, and there are
    // exactly TWO — checked by spelling every letter of the alphabet inside a run and asking which came
    // out with no stress mark at all:
    //
    //   ⟨a⟩  the dict has it as the reduced article AH0, not the letter name
    //   ⟨i⟩  the dict has the letter name, but `i` is the PRONOUN and so is in `unstressedWords`
    //
    // ⚠ THE ⟨i⟩ CASE IS ABOUT STRESS, NOT PHONES, which is why it hid: `I` alone is ˈaᶦ and looks
    // perfectly right. Inside a spelled run it reduces to a bare `aᶦ`, so `PSI` came out pʰˈiː ˈɛs aᶦ —
    // the last two run together as "sigh", and the unit was reported as reading "psy" even after it was
    // correctly classified as an initialism. `eye` is a content word and keeps its beat.
    "letterNameExceptions": { "a": "ay", "i": "eye" },

    // English PHONOTACTICS, for the fail-safe guard in core/initialisms.ts. English codas are far more
    // permissive than French ones, so the load here is carried mostly by the NO-VOWEL test — which is
    // exactly the failing class (NHS, MP, GDP, DVD, TV, PBS all lack a vowel entirely).
    "phonotactics": {
        "vowels": "aeiouy",
        "onsets": [
            "bl", "br", "ch", "cl", "cr", "dr", "dw", "fl", "fr", "gh", "gl", "gr", "gn", "kn", "kl", "kr",
            "ph", "pl", "pr", "ps", "qu", "rh", "sc", "sh", "sk", "sl", "sm", "sn", "sp", "sq", "st", "sv",
            "sw", "th", "tr", "tw", "vl", "wh", "wr", "zl"
        ],
        "codas": [
            "ch", "ck", "ct", "ff", "ft", "gh", "gs", "ks", "ld", "lf", "lk", "ll", "lm", "ln", "lp", "ls",
            "lt", "lv", "mb", "mn", "mp", "ms", "nc", "nd", "ng", "nk", "ns", "nt", "ph", "pt", "ps", "rb",
            "rc", "rd", "rf", "rg", "rk", "rl", "rm", "rn", "rp", "rs", "rt", "rv", "sh", "sk", "sm", "sp",
            "ss", "st", "th", "ts", "tt", "xt", "zz", "bs", "ds",  "nx", "mf", "lb", "rth", "nth"
        ]
    }
}
