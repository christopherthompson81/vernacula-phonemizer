// Native canonical-IPA definition for Malayalam (ml) — a Dravidian Brahmic abugida read by the generic engine
// (core/abugida.ts), mirroring Telugu/Kannada. Like the other Dravidian languages (and unlike Hindi) Malayalam
// does NOT delete the inherent vowel — every akshara is pronounced (inherent /a/, [ɐ] phonetically — the referee
// writes ɐ, folded). Dravidian short/long e,o are distinguished (എ e / ഏ eː, ഒ o / ഓ oː). Retroflex ʈ ɖ ɳ ɭ
// (ട ഡ ണ ള) vs dental t̪ d̪ (ത ദ) vs the ALVEOLAR series റ (r) / ന (n); ഴ→ɻ (retroflex approximant, shared with
// Tamil), ഷ→ʂ. Malayalam-specific handling (chillu pure-consonants, word-final samvritokaram) is in malayalam.ts.
// Validated against wikipron mal + kaikki mal.
{
    "language": "ml",
    "name": "Malayalam",
    "script": ["Malayalam"],
    "provenance": "Authored from the Unicode Malayalam chart + standard Malayalam phonology. This file IS the language data — the generic abugida engine reads it directly.",

    "inherentVowel": "a",

    "consonants": {
        "ക": { "ipa": "k" }, "ഖ": { "ipa": "kʰ" }, "ഗ": { "ipa": "ɡ" }, "ഘ": { "ipa": "ɡʱ" }, "ങ": { "ipa": "ŋ" },
        "ച": { "ipa": "t͡ʃ" }, "ഛ": { "ipa": "t͡ʃʰ" }, "ജ": { "ipa": "d͡ʒ" }, "ഝ": { "ipa": "d͡ʒʱ" }, "ഞ": { "ipa": "ɲ" },
        "ട": { "ipa": "ʈ" }, "ഠ": { "ipa": "ʈʰ" }, "ഡ": { "ipa": "ɖ" }, "ഢ": { "ipa": "ɖʱ" }, "ണ": { "ipa": "ɳ" },
        "ത": { "ipa": "t̪", "note": "DENTAL (vs retroflex ട=ʈ)" }, "ഥ": { "ipa": "t̪ʰ" }, "ദ": { "ipa": "d̪" }, "ധ": { "ipa": "d̪ʱ" }, "ന": { "ipa": "n" },
        "പ": { "ipa": "p" }, "ഫ": { "ipa": "pʰ" }, "ബ": { "ipa": "b" }, "ഭ": { "ipa": "bʱ" }, "മ": { "ipa": "m" },
        "യ": { "ipa": "j" }, "ര": { "ipa": "ɾ", "note": "tap" }, "റ": { "ipa": "r", "note": "ALVEOLAR trill/tap (റ്റ geminate → rː; the referee writes it doubled)" }, "ല": { "ipa": "l" }, "വ": { "ipa": "ʋ" },
        "ശ": { "ipa": "ʃ" }, "ഷ": { "ipa": "ʂ" }, "സ": { "ipa": "s" }, "ഹ": { "ipa": "h" },
        "ള": { "ipa": "ɭ", "note": "retroflex lateral" }, "ഴ": { "ipa": "ɻ", "note": "retroflex approximant (shared with Tamil)" }, "ഺ": { "ipa": "t̪" }
    },

    "independentVowels": {
        "അ": { "ipa": "a", "note": "short a (inherent; [ɐ])" },
        "ആ": { "ipa": "aː", "note": "long a" },
        "ഇ": { "ipa": "i" }, "ഈ": { "ipa": "iː" }, "ഉ": { "ipa": "u" }, "ഊ": { "ipa": "uː" },
        "ഋ": { "ipa": "ɾu", "note": "vocalic r" }, "ൠ": { "ipa": "ɾuː" }, "ഌ": { "ipa": "lu", "note": "vocalic l (rare)" }, "ൡ": { "ipa": "luː" },
        "എ": { "ipa": "e", "note": "SHORT e (Dravidian)" }, "ഏ": { "ipa": "eː", "note": "long e" }, "ഐ": { "ipa": "ai" },
        "ഒ": { "ipa": "o", "note": "SHORT o (Dravidian)" }, "ഓ": { "ipa": "oː", "note": "long o" }, "ഔ": { "ipa": "au" }
    },

    "vowelSigns": {
        "ാ": { "ipa": "aː" }, "ി": { "ipa": "i" }, "ീ": { "ipa": "iː" }, "ു": { "ipa": "u" }, "ൂ": { "ipa": "uː" },
        "ൃ": { "ipa": "ɾu" }, "ൄ": { "ipa": "ɾuː" }, "െ": { "ipa": "e" }, "േ": { "ipa": "eː" }, "ൈ": { "ipa": "ai" },
        "ൊ": { "ipa": "o" }, "ോ": { "ipa": "oː" }, "ൌ": { "ipa": "au" }, "ൗ": { "ipa": "au", "note": "au-length mark" }
    },

    "signs": {
        "virama": { "char": "്", "effect": "suppressInherentVowel", "note": "chandrakkala — vowel suppression / clusters" },
        "anusvara": { "char": "ം", "effect": "nasalizeVowel", "note": "→ homorganic nasal; final → [m]" },
        "chandrabindu": { "char": "ഁ", "effect": "nasalizeVowel", "note": "nasalizes the preceding vowel" },
        "visarga": { "char": "ഃ", "effect": "appendH", "note": "→ [h]" },
        "nukta": { "char": "഼", "effect": "composeNukta", "note": "nukta (rare)" }
    },

    "clausePunctuation": {
        "।": ".", "॥": ".", ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Malayalam spellings; canonical IPA DERIVED via the same G2P.
    //
    // The composer is the SHARED `dravidianNumberWords` (core/numbers.ts), not `indicNumberWords`:
    // Malayalam is the fourth Dravidian language and the one the playbook named as the trigger to
    // consolidate rather than write a fourth private composer. It needs all three things
    // `indicNumberWords` cannot say — a fused 21-99, suppletive round hundreds AND thousands, and a
    // combining magnitude form before a remainder.
    "numbers": {
        "units": ["പൂജ്യം", "ഒന്ന്", "രണ്ട്", "മൂന്ന്", "നാല്", "അഞ്ച്", "ആറ്", "ഏഴ്", "എട്ട്", "ഒമ്പത്"],
        "teens": ["പത്ത്", "പതിനൊന്ന്", "പന്ത്രണ്ട്", "പതിമൂന്ന്", "പതിനാല്", "പതിനഞ്ച്", "പതിനാറ്", "പതിനേഴ്", "പതിനെട്ട്", "പത്തൊമ്പത്"],
        "tens": { "20": "ഇരുപത്", "30": "മുപ്പത്", "40": "നാല്പത്", "50": "അമ്പത്", "60": "അറുപത്", "70": "എഴുപത്", "80": "എൺപത്", "90": "തൊണ്ണൂറ്" },
        "compound": {
            "21": "ഇരുപത്തിയൊന്ന്", "22": "ഇരുപത്തിരണ്ട്", "23": "ഇരുപത്തിമൂന്ന്", "24": "ഇരുപത്തിനാല്", "25": "ഇരുപത്തിയഞ്ച്", "26": "ഇരുപത്തിയാറ്", "27": "ഇരുപത്തിയേഴ്", "28": "ഇരുപത്തിയെട്ട്", "29": "ഇരുപത്തിയൊമ്പത്",
            "31": "മുപ്പത്തിയൊന്ന്", "32": "മുപ്പത്തിരണ്ട്", "33": "മുപ്പത്തിമൂന്ന്", "34": "മുപ്പത്തിനാല്", "35": "മുപ്പത്തിയഞ്ച്", "36": "മുപ്പത്തിയാറ്", "37": "മുപ്പത്തിയേഴ്", "38": "മുപ്പത്തിയെട്ട്", "39": "മുപ്പത്തിയൊമ്പത്",
            "41": "നാല്പത്തിയൊന്ന്", "42": "നാല്പത്തിരണ്ട്", "43": "നാല്പത്തിമൂന്ന്", "44": "നാല്പത്തിനാല്", "45": "നാല്പത്തിയഞ്ച്", "46": "നാല്പത്തിയാറ്", "47": "നാല്പത്തിയേഴ്", "48": "നാല്പത്തിയെട്ട്", "49": "നാല്പത്തിയൊമ്പത്",
            "51": "അമ്പത്തിയൊന്ന്", "52": "അമ്പത്തിരണ്ട്", "53": "അമ്പത്തിമൂന്ന്", "54": "അമ്പത്തിനാല്", "55": "അമ്പത്തിയഞ്ച്", "56": "അമ്പത്തിയാറ്", "57": "അമ്പത്തിയേഴ്", "58": "അമ്പത്തിയെട്ട്", "59": "അമ്പത്തിയൊമ്പത്",
            "61": "അറുപത്തിയൊന്ന്", "62": "അറുപത്തിരണ്ട്", "63": "അറുപത്തിമൂന്ന്", "64": "അറുപത്തിനാല്", "65": "അറുപത്തിയഞ്ച്", "66": "അറുപത്തിയാറ്", "67": "അറുപത്തിയേഴ്", "68": "അറുപത്തിയെട്ട്", "69": "അറുപത്തിയൊമ്പത്",
            "71": "എഴുപത്തിയൊന്ന്", "72": "എഴുപത്തിരണ്ട്", "73": "എഴുപത്തിമൂന്ന്", "74": "എഴുപത്തിനാല്", "75": "എഴുപത്തിയഞ്ച്", "76": "എഴുപത്തിയാറ്", "77": "എഴുപത്തിയേഴ്", "78": "എഴുപത്തിയെട്ട്", "79": "എഴുപത്തിയൊമ്പത്",
            "81": "എൺപത്തിയൊന്ന്", "82": "എൺപത്തിരണ്ട്", "83": "എൺപത്തിമൂന്ന്", "84": "എൺപത്തിനാല്", "85": "എൺപത്തിയഞ്ച്", "86": "എൺപത്തിയാറ്", "87": "എൺപത്തിയേഴ്", "88": "എൺപത്തിയെട്ട്", "89": "എൺപത്തിയൊമ്പത്",
            "91": "തൊണ്ണൂറ്റിയൊന്ന്", "92": "തൊണ്ണൂറ്റിരണ്ട്", "93": "തൊണ്ണൂറ്റിമൂന്ന്", "94": "തൊണ്ണൂറ്റിനാല്", "95": "തൊണ്ണൂറ്റിയഞ്ച്", "96": "തൊണ്ണൂറ്റിയാറ്", "97": "തൊണ്ണൂറ്റിയേഴ്", "98": "തൊണ്ണൂറ്റിയെട്ട്", "99": "തൊണ്ണൂറ്റിയൊമ്പത്"
        },

        // SUPPLETIVE ROUND HUNDREDS, keyed by the count of hundreds — Malayalam does not say "two
        // hundred" as two words.
        "hundredForms": {
            "1": { "bare": "നൂറ്", "combining": "നൂറ്റി" },
            "2": { "bare": "ഇരുന്നൂറ്", "combining": "ഇരുന്നൂറ്റി" },
            "3": { "bare": "മുന്നൂറ്", "combining": "മുന്നൂറ്റി" },
            "4": { "bare": "നാന്നൂറ്", "combining": "നാന്നൂറ്റി" },
            "5": { "bare": "അഞ്ഞൂറ്", "combining": "അഞ്ഞൂറ്റി" },
            "6": { "bare": "അറുനൂറ്", "combining": "അറുനൂറ്റി" },
            "7": { "bare": "എഴുനൂറ്", "combining": "എഴുനൂറ്റി" },
            "8": { "bare": "എണ്ണൂറ്", "combining": "എണ്ണൂറ്റി" },
            "9": { "bare": "തൊള്ളായിരം", "combining": "തൊള്ളായിരത്തി" }
        },

        // SUPPLETIVE ROUND THOUSANDS 1-9. Malayalam fuses the count INTO the thousand. This is
        // what makes 2011 രണ്ടായിരത്തി പതിനൊന്ന് and not *രണ്ട് ആയിരം പതിനൊന്ന്. Counts of 10 and above
        // fall back to `below1000(count) + ആയിരം`, which is a documented approximation — Malayalam
        // fuses those too (23,000 ഇരുപത്തിമുവ്വായിരം), and 10 of the 1,955 utterances land there.
        "thousandForms": {
            "1": { "bare": "ആയിരം", "combining": "ആയിരത്തി" },
            "2": { "bare": "രണ്ടായിരം", "combining": "രണ്ടായിരത്തി" },
            "3": { "bare": "മൂവായിരം", "combining": "മൂവായിരത്തി" },
            "4": { "bare": "നാലായിരം", "combining": "നാലായിരത്തി" },
            "5": { "bare": "അയ്യായിരം", "combining": "അയ്യായിരത്തി" },
            "6": { "bare": "ആറായിരം", "combining": "ആറായിരത്തി" },
            "7": { "bare": "ഏഴായിരം", "combining": "ഏഴായിരത്തി" },
            "8": { "bare": "എണ്ണായിരം", "combining": "എണ്ണായിരത്തി" },
            "9": { "bare": "ഒമ്പതിനായിരം", "combining": "ഒമ്പതിനായിരത്തി" }
        },

        // The magnitude nouns, bare and combining. The combining form is the joint that holds an Indian
        // numeral together: 1976 is ആയിരത്തി തൊള്ളായിരത്തി എഴുപത്തിയാറ്.
        "magnitudeForms": {
            "hundred": { "bare": "നൂറ്", "combining": "നൂറ്റി" },
            "thousand": { "bare": "ആയിരം", "combining": "ആയിരത്തി" },
            "lakh": { "bare": "ലക്ഷം", "combining": "ലക്ഷത്തി" },
            "crore": { "bare": "കോടി", "combining": "കോടി" }
        },

        // The decimal-point word
        "decimalWord": "ദശാംശം"

    }
}
