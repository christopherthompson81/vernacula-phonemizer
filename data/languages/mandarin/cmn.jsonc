// Mandarin Chinese (cmn) — native canonical-IPA manifest for vernacula-phonemizer.
//
// Pipeline: Han text → segment + Hanzi→pinyin (polyphone-aware) → tone sandhi → pinyin→IPA (Chao tones).
// The pinyin→IPA correspondence is a 424-row lookup table (syllable-ipa.tsv) generated from the project's
// already-converged cmn engine (validated vs wikipron + epitran); this manifest carries the tone system,
// sandhi rules, and numbers.
{
    "language": "cmn",
    "script": ["Han"],
    "name": "Mandarin Chinese (Standard, Hanyu Pinyin)",

    "convention": {
        "tones": "Chao contour letters at SYLLABLE END (中 → ʈ͡ʂoŋ˥˥)",
        "toneNumbers": "pinyin tone digit 1–4 = the four lexical tones; 5 or absent = neutral (unmarked)",
        "retroflex": "zh ch sh r → ʈ͡ʂ ʈ͡ʂʰ ʂ ʐ ; the -i after them is the syllabic ʐ̩ (chi → ʈ͡ʂʰʐ̩)",
        "apical": "-i after z c s → syllabic ɹ̩ (si → sɹ̩)",
        "palatals": "j q x → t͡ɕ t͡ɕʰ ɕ ; ü after them written u (ju → t͡ɕy)",
        "aspiration": "p t k / q c ch etc. aspirated as ʰ",
        "stress": "none — Mandarin has no contrastive lexical stress; tone (and its absence on neutral-tone syllables) carries prominence",
    },

    // Tone number → Chao contour letters. Appended at syllable end. 5 (neutral) is unmarked.
    "tones": { "1": "˥˥", "2": "˧˥", "3": "˨˩˦", "4": "˥˩", "5": "" },

    // Tone sandhi (operate on tone NUMBERS before rendering).
    "sandhi": {
        // Third-tone sandhi: a 3rd tone before another 3rd tone becomes 2nd (你好 nǐ hǎo → ní hǎo).
        // Applied left-to-right pairwise across a prosodic run (pinyinToIpa.ts reads this rule).
        "thirdThird": { "from": "3", "before": "3", "to": "2" },
        // 一 yī / 不 bù sandhi need the source character → yiBuSandhi.ts (Hanzi front-end).
    },

    "resolve": [
        "pinyin syllable → toneless lookup",
        "third-tone sandhi",
        "append Chao tone",
    ],

    // Clause / phrase punctuation (Chinese + ASCII) → canonical inline pause marks.
    "clausePunctuation": {
        "。": ".",
        "！": "!",
        "？": "?",
        "，": ",",
        "、": ",",
        "；": ",",
        "：": ",",
        "…": ",",
        "—": ",",
        ".": ".",
        "!": "!",
        "?": "?",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Common measure words: a standalone 2 before one of these reads colloquial 两 (两个, 两天), not 二.
    "measureWords": "个位本张只条头匹件双对群种次遍回天年岁块层排组步口面名首部台辆架座间扇页杯碗瓶盒袋斤",

    // Number reading (Arabic → Chinese numeral characters, then phonemized like any Han run).
    "numbers": {
        "digits": ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"], // 0–9 (digits[0] 零 = the internal zero-gap filler)
        "positions": ["千", "百", "十", ""], // place value within a 4-digit group
        "bigUnits": ["", "万", "亿", "兆"], // 10⁴ⁿ group multipliers
        "two": "两", // colloquial 2 (千-multiplier, leading 百-multiplier, 万/亿 multiplier, before a measure word)
        "decimalPoint": "点", // 点 between integer and fractional digit-string
        "zeroDigit": "〇", // digit-string (year/ID) zero, distinct from quantity 零
    },

    // NUMBERS + normalization + punctuation→pause: Phase 3.
    "phases": {
        "done": [
            "pinyin path",
            "syllable→IPA",
            "tones",
            "third-tone sandhi",
            "Hanzi front-end (char + phrase polyphone disambiguation)",
            "numbers (Arabic → Chinese quantity reading + decimals)",
            "year digit-string reading (4-digit before 年)",
            "bare 一/不 sandhi",
            "colloquial 两 (multipliers + measure words)",
            "punctuation → pause",
            "embedded Latin → English",
            "referee sweep (epitran + wikipron); fixed -e→ɤ",
        ],
        "pending": [
            "counting-sequence 一 (一二三 reads sandhi'd, not citation — needs non-tonal context)",
            "phone/ID digit-string reading",
            "C# mirror (if pursued)",
        ],
    },

    // ⚠ KEYED BY UPPERCASE LATIN. The engine looks a run up by the character as WRITTEN, and an
    // embedded initialism in this script is always upper-case; lower-casing the keys would silently
    // miss every one. (Dictionary keys are not touched by the loader's camelCase property policy —
    // verified, not assumed, because that policy is exactly what mangled English's ARPABET block.)
    "letterNames": {
        "A": "诶", "B": "比", "C": "西", "D": "迪", "E": "伊", "F": "艾弗", "G": "吉", "H": "艾尺", "I": "艾",
        "J": "杰", "K": "开", "L": "艾勒", "M": "艾姆", "N": "恩", "O": "欧", "P": "皮", "Q": "丘", "R": "阿儿",
        "S": "艾丝", "T": "提", "U": "优", "V": "维", "W": "大布留", "X": "艾克斯", "Y": "歪", "Z": "兹"
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, one name fleet-wide. In the abugida manifests `symbols` already means the
    // BARE-SIGN → word map the engine's tokenizer reads, so the shared tier cannot use that name there —
    // and having the same table under two names depending on the language is exactly the kind of split this
    // sweep exists to remove.
    "symbolTier": {
        // `multiply` — this language's OWN word, harvested from its existing `×` rule, so nothing new is
        // sourced. Declaring it here is what makes ASCII `x` read like `×`: `6x6 cm` read the `x` as a LETTER NAME,
        // and `NxN` forms outnumber `×` roughly 85 to 20 across the corpora. One word, so `by` defaults to it.
        "multiply": { "times": "乘以" },
        "percent": ["百分之"],
        "percentPrefix": true,
        // Currency: the sign was DROPPED outright ($50 read as 五十, losing 美元). Mandarin says the unit after
        // the number, which is what the shared tier emits. Degrees likewise: °C was falling through to the
        // English reading of the bare letter C.
        "currency": { "$": ["美元"], "€": ["欧元"], "£": ["英镑"], "¥": ["元"], "₤": ["英镑"] },
        "units": { "mm": ["毫米"], "cm": ["厘米"], "km": ["公里"], "m": ["米"], "kg": ["千克"], "g": ["克"],
            "km/h": ["公里每小时"], "°c": ["摄氏度"], "°f": ["华氏度"], "°": ["度"],
            // ℃ and ℉ are SINGLE CODE POINTS (U+2103, U+2109), not `°`+letter, so the two keys above could not
            // reach them and `20℃` read as bare 二十 — the whole unit gone, not merely the degree sign. They are
            // in the RAWMARK leak class for exactly this reason. Found while reviewing the hi change, which had
            // the identical gap; measured across the fleet, most languages still do.
            "℃": ["摄氏度"], "℉": ["华氏度"] },
        // `km²` → 平方公里. The measure word PRECEDES the unit and fuses to it with no space, which is the
        // `compound` position — the same one Japanese uses for 平方キロメートル. `before` would emit "平方 公里",
        // splitting one Han run into two and losing the segmenter's chance to see the compound.
        // Attested in the artifact itself: 公园占地 19500 平方公里 · 783,562 平方公里（300,948 平方英里）.
        // One form each, because a Chinese measure word does not agree with its count.
        "exponentWords": { "squared": ["平方"], "cubed": ["立方"], "position": "compound" },
        // BARE EXPONENT — the reading for a power with NO unit to modify (`20²`, `mc²`), which every language
        // in the fleet was dropping silently. See `bareExponent` in core/normalizeSymbols.ts for why this cannot
        // reuse `exponentWords` above: that is the unit MODIFIER and this is the PREDICATE, and in most languages
        // they are different words (平方公里 but 二十的平方).
        // ⚠ PROVENANCE, stated because it is weaker than most data in this repo: these are STANDARD MATHEMATICAL
        // REGISTER, not corpus attestations. The power words are ×0 in this language's artifact, and the apparent
        // hits for other languages were substring traps of exactly the kind tools/normalization/attest.ts warns
        // about — th `กำลัง` matched the progressive-aspect marker, fa `توان` and ar `أس` matched inside unrelated
        // words. FLEURS is news and encyclopedia prose and simply does not contain spoken arithmetic.
        // The cardinal is used for the generic power, never the ordinal — see core for that argument.
        "bareExponent": { "squared": "{n}的平方", "cubed": "{n}的立方", "power": "{n}的{e}次方" , "negative": "负" },
        // Chinese groups by MYRIADS, so the magnitude word between a number and its unit is 万 (10⁴) or 亿 (10⁸),
        // not "million". Undeclared, the tier's number–unit adjacency broke on it and the unit fell through to
        // the English letter reading: `5 万 km²` came out as *ˈʊkm*, which is worse than the raw text. The
        // artifact writes the magnitude against a currency NOUN (13 万日元, 40 万例) rather than against a Latin
        // unit, so this guards a plausible input rather than a sampled one.
        "magnitudes": ["万", "亿", "兆"],
        // Chinese has NO SPACES between words, so a unit or a currency sign is normally flanked by Han — which is
        // exactly what the tier's letter-boundary guards were rejecting. Only punctuation-adjacent instances
        // worked: `38℃。` read 摄氏度 and `38℃很热` dropped the ℃; `$500。` read 美元 and `為$500，` dropped the sign;
        // `50 km²的面积` lost the exponent; `20°C很热` read the C as English *sˈiː*. Found by the zh.wikipedia fill,
        // because the FLEURS corpus writes its units as words (平方公里) and its few signs sit next to punctuation.
        "unspacedScript": true
    }
}
