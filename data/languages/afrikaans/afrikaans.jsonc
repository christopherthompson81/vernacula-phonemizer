// Native canonical-IPA data manifest for Afrikaans (af)
//
// Indo-European (West Germanic, daughter of Dutch), ~7M, South Africa/Namibia, Latin script + diacritics.
//
// Fairly regular orthography, but with the Germanic OPEN/CLOSED-SYLLABLE vowel-length rule (a single vowel
// is long/tense in an open syllable, short/lax in a closed one) → the engine (afrikaans.ts) does the length
// lookahead; this file holds the declarative tables. Referee: en.wiktionary Afrikaans IPA.
{
    "language": "af",
    "name": "Afrikaans",
    "script": ["Latin"],
    "provenance": "Authored greedy g2p for Standard Afrikaans. Referee: en.wiktionary Afrikaans IPA (2220 words).",

    "convention": {
        "vowelLength": "single vowel: LONG/tense in an open syllable (V.CV: ape→ɑː), SHORT/lax in a closed one (VC#/VCC: al→a) — engine lookahead",
        "longMids": "the long mid vowels are CENTERING DIPHTHONGS: ee / open-e = iə, oo / open-o = uə; long a = ɑː; ie = i, oe = u",
        "signatures": "⟨g⟩ = velar/uvular fricative [χ] (not [ɡ]); ⟨w⟩ = [v]; ⟨v⟩ = [f]; ⟨h⟩ = [ɦ]; final obstruent DEVOICING (b→p, d→t); ⟨y⟩ = diphthong [əi]",
        "folded": "stress (unwritten) + syllable dots not emitted; r~ɾ one symbol [r]; nasalization before nasal+C and unstressed-vowel schwa-reduction DEFERRED"
    },

    // Fixed multi-letter graphemes + ⟨y⟩ + consonants (the greedy length-desc table; bare a/e/i/o/u go through the
    // open/closed length code instead). Long vowels here are the doubled/di-graph spellings (always long).
    // ⚠ ⟨sch⟩ AND ⟨chr⟩ MUST OUT-RANK ⟨ch⟩, and longest-match is what makes that work — the same argument
    // as every other multi-letter entry here. Without ⟨sch⟩ the surnames come out [sʃ], which is not a
    // possible Afrikaans onset (Schalk → *sʃalk); the referee's majority is [sk] — Schalk, Schoeman,
    // Schutte, Labuschagne — against Schuster/Laubscher [ʃ] and Hauptfleisch [s]. ⟨schr⟩ falls out of
    // ⟨sch⟩ + ⟨r⟩ with no entry of its own.
    "fixed": {
        "aai": "ɑːi", "ooi": "oːi", "oei": "ui", "eeu": "iːu", "aau": "ɑːu",
        "aa": "ɑː", "ee": "iə", "oo": "uə", "uu": "yː", "ie": "i", "oe": "u", "eu": "øː",
        "ei": "əi", "ui": "œy", "ou": "œu", "au": "œu", "y": "əi",
        "tjie": "ki", "djie": "ki", "jie": "ki", "tz": "ts", "sj": "ʃ", "tj": "c", "dj": "dʒ", "ch": "ʃ",
        "sch": "sk", "chr": "kr", "ng": "ŋ", "nk": "ŋk",
        "b": "b", "d": "d", "f": "f", "g": "χ", "h": "ɦ", "j": "j", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "p", "q": "k", "r": "r", "s": "s", "t": "t",
        "v": "f", "w": "v", "x": "ks", "z": "z",
        // ⚠ TWO LETTERS AFRIKAANS DOES NOT WRITE BUT DOES BORROW, and which the scan used to DELETE
        // (garçon → *χarɔn, Cañitas → *kɑːitas). Both are attested on af.wikipedia in running Afrikaans
        // prose, not only inside quoted foreign titles: ⟨ç⟩ in garçon ×15 and Provençaalse ×3, ⟨ñ⟩ in
        // piñata ×4 ("tradisionele gebruike soos vir 'n piñata").
        // ⟨ç⟩ = [s], its value in the French and Portuguese words Afrikaans takes it from — NOT the [t͡ʃ] of
        // Turkish/Albanian, which is the shared table's default and would be wrong for every attestation here.
        // ⟨ñ⟩ = ⟨nj⟩, the sequence this engine already emits for the palatal nasal (Spanje → spanjə). Not [ɲ]:
        // Afrikaans has no such phone anywhere else in this table, and not [n], which discards the palatal.
        "ç": "s", "ñ": "nj"
    },

    // Bare single vowels — the engine picks long (open syllable) or short (closed) per the length rule.
    "vowelsLong": { "a": "ɑː", "e": "iə", "i": "i", "o": "uə", "u": "yː" },
    "vowelsShort": { "a": "a", "e": "ɛ", "i": "ə", "o": "ɔ", "u": "œ" },

    // Diacritic vowels: circumflex = long (ê ô û î); diaeresis ë ï = syllable-break, base value; acute/grave = loan stress.
    "diacriticVowels": {
        "ê": "ɛː", "ô": "ɔː", "û": "œː", "î": "əː",
        "ë": "ə", "ï": "i", "é": "eː", "è": "ɛ", "á": "ɑː", "à": "a", "ó": "oː", "ú": "y", "ü": "y", "ö": "ø"
    },

    // The BARE single vowels — the five letters routed through the open/closed length rule above (the
    // digraphs and the diacritic vowels carry their own length, so only these need the lookahead).
    "bareVowels": ["a", "e", "i", "o", "u"],
    // Every letter that heads a vowel/nucleus, bare or diacritic. This BOUNDS THE CONSONANT RUN in that same
    // lookahead: the syllable is open iff at most one consonant separates a vowel from the next one, so a
    // letter missing here would be counted as a consonant and close the syllable that should be open.
    "vowelLetters": [
        "a", "e", "i", "o", "u", "y", "ê", "ô", "û", "î", "ë", "ï",
        "é", "è", "á", "à", "ó", "ú", "ü", "ö"
    ],

    // FINAL DEVOICING (Auslautverhärtung): a voiced obstruent devoices word- and morpheme-finally
    // (hond→ɦɔnt). ⟨g⟩→[χ] and ⟨v⟩→[f] need no entry — the grapheme table already emits the voiceless one.
    "voicedFinal": { "b": "p", "d": "t", "z": "s" },

    // ⚠ THE VOICELESS OBSTRUENTS OF THE INVENTORY — the REGRESSIVE half of the devoicing rule reads this,
    // not a hand-written letter list. The engine used to test the following LETTER against the literal
    // "ptksfcgx", which is a spelling-level restatement of "voiceless" and had drifted from the grapheme
    // table: ⟨v⟩ is [f] in Afrikaans and ⟨q⟩ is [k], so neither triggered devoicing and `advies` read
    // [adfis] — a voiced [d] before a voiceless [f], which the language does not have. Derived from
    // `fixed` instead (afrikaans.ts), so a grapheme change carries into the trigger automatically.
    // ⚠ THAT IS ONLY HALF A GUARANTEE, and the half it is not is this list: the trigger is
    // `fixed` ∩ `voicelessPhones`, and THIS list is still hand-written. Add a single-letter grapheme whose
    // phone is not named here and it drops out of the trigger silently — the old literal's failure mode,
    // relocated one file over. The derived set is pinned as a SET in test/afrikaans.test.ts, which is what
    // actually closes it.
    // ⟨c⟩ is added by the engine rather than listed here: it has no `fixed` entry (a code rule picks [s]
    // or [k] by the following letter) and BOTH of its values are voiceless.
    "voicelessPhones": ["p", "t", "k", "c", "f", "s", "ʃ", "χ"],

    // ⚠ UNSTRESSED BARE VOWELS REDUCE. The open/closed length rule only lengthens in a STRESSED syllable;
    // elsewhere the vowel stays short and ⟨e⟩/⟨i⟩ centralise to schwa. Digraph vowels (aa, ee=iə …) are
    // inherently long and never reach this table.
    "unstressedReduction": { "a": "a", "e": "ə", "i": "ə", "o": "ɔ", "u": "œ" },

    // ⚠ THE UNSTRESSED **OPEN** SYLLABLE IS ITS OWN CELL, and the engine had no table for it — `unstressedReduction`
    // above was applied to every unstressed vowel regardless of syllable shape. The Germanic open/closed rule does
    // not switch off outside the stress: an open unstressed syllable still takes the TENSE quality, it just takes
    // it short.
    // ⚠ DERIVED FROM DATA, NOT GUESSED. The RCRL secondary carries stress AND syllable boundaries for 27,428 words;
    // pairing vowel-letter group k of the spelling with syllable k of the transcription gives 25,247 usable words
    // and a direct reading of all 20 cells (tools/referee-eval/build-af-rcrl.ts's source; the derivation is in
    // docs/afrikaans_stress_investigation.md Run 12). It confirmed 17 of the 20 cells the manifest already had —
    // every stressed cell and every unstressed CLOSED cell — and contradicted the three unstressed-open ones.
    // ⚠ ONLY TWO OF THE THREE SHIP, because RCRL is a REFEREE and deriving tables from it then scoring against it
    // is circular. The en.wiktionary PRIMARY is the non-circular check, and it is the arbiter here:
    //     ⟨o⟩ ɔ→u   RCRL u 53% / ɔ 25% / uə 21% (n=1846)   primary ±0, secondary +222   KEPT
    //     ⟨u⟩ œ→y   RCRL y 65% / œ 30%          (n= 568)   primary +4, secondary  +96   KEPT
    //     ⟨i⟩ ə     RCRL ə 55% / i 45%          (n=2771)   primary −9, secondary +174   REJECTED
    // The ⟨i⟩ cell is the one to be careful about: RCRL prefers ə, and the primary's OWN derivation agrees (ə 58%)
    // — but on only 12 words, while the primary's 2220-word eval says −9. Twelve rows of derivation do not outweigh
    // a direct measurement on the whole set, so ⟨i⟩ keeps its existing tense/lax-by-syllable rule and this is
    // written down rather than left as a gap. ⟨a⟩ (ɑː) and ⟨e⟩ (iə) were swept as CONTROLS — RCRL says a 77% and
    // ə 90%, i.e. our existing values — and both duly lost (−23, −54 on the primary), which is the method
    // validating itself.
    // ⚠ AND THE STEM-LIST DIFF, which the first draft of this change skipped — the gate Run 7 exists to enforce
    // ("THE REFEREE IS 2220 WORDS AND THE STEM LIST IS 53k"). This rewrites 4,741 of 53,344 stems (8.9%), far
    // more than the 143 that got `shortHeads` reverted, so the direction of those edits is the evidence that
    // matters, not the count. Of the touched words a referee covers: **35 toward / 2 away on the INDEPENDENT
    // primary**, and 809 toward / 56 away on RCRL (circular, listed for completeness). ⟨o⟩ in particular is
    // 0-gained/0-lost on the primary's 30 word-exact rows — word-exact is simply too coarse there, and the
    // distance metric is what shows those words moving closer (symbol accuracy 94.4% → 94.7% is the same fact).
    "unstressedOpen": { "o": "u", "u": "y" },

    // ⟨c⟩ is soft [s] before one of these and [k] elsewhere. A LETTER list, not a phone list — it is read
    // off the spelling during the scan.
    "cSoftBefore": ["e", "i", "y", "ê", "é", "è"],

    // ⚠ ⟨w⟩ IS THE GLIDE [w], NOT [v], IN A MORPHEME-INITIAL OBSTRUENT CLUSTER — swaar [swɑːr], twee [twiə],
    // kwaad [kwɑːt], dwaal [dwɑːl]. Donaldson describes it; the engine emitted [v] everywhere anyway, because
    // when the rule was first tried (Run 4) it measured EXACTLY net zero against the only referee af then had:
    // en.wiktionary writes swaar [sw] beside swaan [sv] in the same environment, six each way, so it fixed six
    // words and broke six. It was recorded as referee inconsistency and demoted to an eval fold.
    // ⚠ THE SECOND REFEREE SETTLED IT, and the other way: RCRL (non-Wiktionary, 27417) is **260 of 261** for the
    // glide — ⟨sw⟩ 88:0, ⟨tw⟩ 53:0, ⟨kw⟩ 84:1, ⟨dw⟩ 34:0 — against en.wiktionary's 10:9 coin flip across the same
    // four onsets. The rule was always right; the primary just could not adjudicate it. This is the single
    // clearest thing importing an independent source bought.
    // ⚠ THE LIST IS THE ATTESTED FOUR, not "obstruents" (handoff §11): those are the only C+⟨w⟩ onsets RCRL
    // contains. Its one ⟨rw⟩ is a loan taking an epenthetic vowel (rwandese → rəwandiəsə), not a cluster.
    // ⚠ MEASURED HONESTLY, because the first draft of this PR over-credited it: the ENGINE RULE is worth
    // +67 on the secondary and +1 on the primary. Widening the eval fold from ⟨sd⟩ to ⟨sdtk⟩ is a further
    // +92/+1 — but that is a SCORING change (it normalises both sides of a comparison), not an engine one,
    // and it now applies to the PRIMARY ONLY so the secondary scores the contrast rather than hiding it.
    // ⚠ AND IT DEPENDS ON THE SPLITTER PUTTING THE FUGEN-S ON THE HEAD (`linkingElements` order): with the
    // ⟨s⟩ on the following element, voeding·swaarde looks like an ⟨sw⟩ onset and this rule fires on a
    // mirage — *fudəŋswɑːrdə for RCRL ˈfu.dəŋs.vɑːr.də. Four such words were shipping wrong until review.
    "wGlideAfter": ["s", "d", "t", "k"],

    // ⚠ LOAN SUFFIXES THAT MOVE THE STRESS off the native first syllable. Afrikaans stress is initial by
    // default (the Germanic pattern) and these Romance/Latinate endings override it: "final" takes the last
    // nucleus (ingenieur, universiteit), "penultimate" the second-to-last (aborsie → a·BOR·sie). Matched as
    // word-final alternatives, LONGEST FIRST so ⟨siteit⟩ wins over ⟨teit⟩.
    // ⚠ THE LIST IS MEASURED, NOT COLLECTED. Every plausible Romance ending was swept individually against
    // the referee; most LOSE, because the same letters also end native words where stress is initial —
    // ⟨sie⟩ −12, ⟨aar⟩ −6, ⟨el⟩ −42 (kabel, tafel, wortel are all initial-stress). Only ⟨uur⟩ (+3),
    // ⟨oen⟩ (+2) and ⟨eel⟩ (+1) pay, and they are kept for that reason alone.
    // ⚠ AND THE WHOLE LEVER IS SMALL, which is worth knowing before anyone extends this list: replacing
    // stressedNucleus with a PERFECT ORACLE built from the referee's own stress marks scores 1783/2220
    // against the rule engine's 1738 — so every stress rule that could ever be written, together, is
    // worth about 45 words (2pp). The residual is segmental, not prosodic.
    "stressFinalSuffixes": ["siteit", "teit", "isme", "eer", "eur", "oor", "oon", "ees", "uur", "oen", "eel", "yn"],
    "stressPenultSuffixes": ["ie"],

    // ⚠ THE STRESS TABLE, DERIVED — suffix → how many syllables from the END carry primary stress
    // (0 = final, 1 = penult, 2 = antepenult). Consulted LONGEST-FIRST, ahead of the two hand-authored lists
    // above, which it largely subsumes; they are kept because they are cheap and were measured separately.
    // ⚠ THIS EXISTS BECAUSE THE OLD MEASUREMENT WAS TAKEN ON A SAMPLE TOO SMALL TO SEE IT. Run 4 swept
    // candidate stress suffixes against the 2220-word primary, found almost nothing, and concluded from a
    // perfect-stress ORACLE that every stress rule that could ever be written was worth ~45 words. That oracle
    // covers only 529 of the primary's rows. Re-run against the RCRL secondary it covers 24,709 and is worth
    // **+1168 words (4.3pp)** — the lever is ~26x what was recorded, and the old number was an artefact of the
    // sample. Our placement accuracy is 74.8% overall and falls with length: 88% at 2 syllables, 64% at 4, 40% at 8.
    // ⚠ DERIVED AND VALIDATED ON A HELD-OUT SPLIT, not fitted to the score: suffixes are read off an 80% train
    // split and scored on the untouched 20% — placement 72.7% → 74.9% held-out against 75.5% on train, so it
    // generalises rather than memorises. The shipped table is then refit on all 23,382 usable rows.
    // ⚠ THREE FILTERS, each of which earned its place:
    //   · n≥10 occurrences and ≥95% agreement on one position. LOWER PRECISION MEASURES BETTER ON THE SOURCE AND
    //     WORSE IN REALITY: at 0.85 the secondary gains +166 but the INDEPENDENT primary loses 2, and the words
    //     it breaks are real — motief, positief, gedig, letterkundig. A 15% error rate admits 15% errors.
    //   · LENGTH-CONSISTENCY: every syllable-count bucket with ≥5 examples must agree with the overall majority,
    //     which rejects suffixes that are really a from-START rule in disguise.
    //   · ⟨tig⟩ is excluded BY NAME. It is genuinely penult for the bulk (gunstig, aandagtig) and the filters
    //     above pass it, but the -tig NUMERALS are a closed, high-frequency, initially-stressed class that it
    //     mis-stresses: negentig → *nəχɛntəχ for RCRL's ˈniə.xən.təx. Dropping it is better on EVERY axis
    //     (secondary 17840 → 17847), which is the tell that the class it was helping was not paying for itself.
    // ⚠ THE RESULT IS MORPHOLOGY, NOT NOISE, which is the check that it is real: ⟨aliseer⟩/⟨ifiseer⟩ take final
    // stress, ⟨isering⟩/⟨seerde⟩ penult, ⟨igheid⟩/⟨logiese⟩ antepenult, and the ⟨gemaak⟩/⟨gestaan⟩ entries at 2
    // are compound-initial stress on a past participle (skoongemaak).
    // ⚠ WHAT IS LEFT: the oracle says +1168 and this table takes +82 of it. The residue is not suffix-shaped.
    "stressFromEnd": {
        "derlike": 3, "digheid": 2, "geslaan": 2, "gestaan": 2, "iseerde": 1, "isering": 1, "tigheid": 2,
        "waardig": 1, "alisme": 1, "derlik": 2, "gegooi": 2, "geloop": 2, "gemaak": 2, "geneem": 2, "gestel": 2,
        "getrek": 2, "ggende": 2, "kkende": 2, "aties": 1, "biese": 2, "diges": 2, "eksie": 1, "elike": 3,
        "eloos": 2, "elose": 3, "fiese": 2, "gegee": 2, "gehou": 2, "gesit": 2, "giese": 2, "glike": 2, "igste": 2,
        "ineer": 0, "iseer": 0, "kaart": 1, "kbaar": 1, "kbare": 2, "ktief": 0, "ldige": 2, "llend": 1, "llige": 2,
        "nende": 2, "pende": 2, "rdige": 2, "sbaar": 1, "sbare": 2, "slike": 2, "steer": 0, "telik": 2, "tiese": 2,
        "tiewe": 1, "uleer": 0, "urige": 2, "wende": 2, "adig": 1, "ator": 1, "deer": 0, "iete": 1, "klik": 1,
        "nies": 1, "nêre": 1, "psie": 1, "rale": 1, "reer": 0, "self": 0, "slik": 1, "tige": 2, "usie": 1,
        "wige": 2, "ydig": 1, "dat": 1, "gel": 1, "nig": 1, "ci": 0, "êr": 0
    },

    // Reduced IPA for the UNSTRESSED (inseparable) prefixes named in `morphology.prefixUnstressed`.
    // ⚠ PHONEMISED STANDALONE THEY WOULD STRESS THEIR OWN VOWEL (ver→fɛr); as a prefix the vowel reduces
    // (ver·staan → fər·stɑːn). The KEYS must match morphology.prefixUnstressed — afrikaans.ts throws if
    // they diverge, because this list, that one and the stress regex were three copies of the same six.
    "prefixIpa": { "be": "bə", "ge": "χə", "ver": "fər", "ont": "ɔnt", "her": "ɦər", "er": "ər" },

    // ── TEXT NORMALIZATION DATA (normalize.ts) ─────────────────────────────────────────────────────────
    // ⚠ THE SIGN AND MATH WORDS. Read by normalize.ts, one per symbol.
    // ⚠ ± IS A SINGLE CODE POINT (U+00B1), not a ⟨+⟩, so no ⟨+⟩ rule can ever reach inside it — it needs
    // its own entry or the sign vanishes silently. Its reading is two SIGN names juxtaposed rather than an
    // OPERATION name, which is what ± wants: it marks a TOLERANCE, not an addition.
    // ⚠ ⟨&⟩ IS "en", the ordinary word for and — the same string the number compositor uses as its
    // connective, and deliberately not shared with it: they are different jobs that happen to coincide.
    // ⚠ ⟨×⟩ DOES OCCUR — as the ASCII ⟨x⟩ of `6x6 cm`, which the symbol tier in afrikaans.ts routes here by
    // declaring `multiply` (it reads `times` from this very block, so the two paths cannot diverge).
    // ⟨=⟩ ⟨<⟩ ⟨>⟩ ⟨÷⟩ do not occur in the af_za corpus and are declared for completeness.
    "signWords": {
        "plusMinus": "plus of minus",
        "plus": "plus",
        "minus": "minus",
        "ampersand": "en",
        "equals": "gelyk aan",
        "lessThan": "kleiner as",
        "greaterThan": "groter as",
        "times": "keer",
        "dividedBy": "gedeel deur"
    },

    // Clock half-day words, keyed by the ABBREVIATION as written (matched case-insensitively).
    "clockPeriods": { "vm": "voormiddag", "nm": "namiddag" },

    // ⚠ FRACTIONS ARE BUILT ON THE ORDINAL (1/5 → een vyfde, 3/4 → drie vierde), as in Dutch — so only the
    // HALVES need words of their own, and they are suppletive: ⟨een half⟩ for 1/2, ⟨halwe⟩ for the rest.
    "fractionWords": { "oneHalf": "een half", "halves": "halwe" },

    // Ordinals 1–19. The regular ending is the cardinal plus -de; ⟨eerste⟩, ⟨derde⟩ and ⟨agtste⟩ are the
    // suppletive/assimilated forms. From 20 up the ending is -ste (twintigste), except that a sub-20
    // remainder carries its own small-ordinal form onto the compound — 101e honderdeerste, 112e
    // honderdtwaalfde. Index 0 is unused padding.
    "ordinalsBelow20": [
        "", "eerste", "tweede", "derde", "vierde", "vyfde", "sesde", "sewende", "agtste", "neënde",
        "tiende", "elfde", "twaalfde", "dertiende", "veertiende", "vyftiende", "sestiende",
        "sewentiende", "agtiende", "negentiende"
    ],

    // ⚠ MULTI-DOT ABBREVIATIONS, and EVERY LETTER PAIR HERE IS DOT-BOUND — that is load-bearing, not
    // tidiness. The corpus's four BC instances are `v. C.`, `v.C.`, `V.C.` and the undotted `vC`/`VC` — a
    // dotted form, or the two letters ADJACENT, never "letter space letter". Allowing the unpunctuated
    // spaced form (`v\.?\s?C\.?`) made `n\.?\s?C\.?` match the indefinite article before any c-word:
    // `'n Chinese skip` → *'na Christushinese skip*. Afrikaans's commonest word, destroyed by a rule with
    // ZERO corpus instances of its own (na Christus never occurs).
    // Values are REGEX SOURCE, so a backslash is doubled for JSON.
    "multiDotAbbreviations": [
        ["v\\.\\s?C\\.?", "voor Christus"],
        ["vC(?![\\p{L}\\p{M}])", "voor Christus"],
        ["n\\.\\s?C\\.?", "na Christus"],
        ["d\\.\\s?i\\.", "dit is"]
    ],

    // Single-dot abbreviations → the spoken words. The dot is a phrase break otherwise, and the stem is
    // usually unpronounceable. `m.p.u` = myl per uur (mph, the Afrikaans way); `n.m.` = namiddag (PM). The
    // undotted vm/nm AM/PM suffixes are handled by the clock rule instead — they attach to a clock.
    // ⚠ Only the DOTTED keys may appear without their trailing dot; a plain word like `dr` is never matched
    // bare, since it starts "Dromaeosauridae" and would misfire (the split is computed in normalize.ts).
    // ⚠ `mnr` WAS ADDED FROM A MEASURED LEAK — the artifact's only raw-ASCII run. `mnr. Reid` ×2 in one
    // sentence reached the IPA as the letters ⟨mnr⟩, which is not a possible Afrikaans word (no vowel), and
    // no gate but the raw-Latin one could see it: in a Latin-script language a Latin run looks like a word.
    // The dotted-abbreviation rule is exactly the right home — same shape as `dr`, one key, no new machinery.
    // SOURCING (`attest.ts --lang af`, both cached): `meneer` 6 examples, every one the honorific before a
    // NAME (`Meneer Cee`, `Meneer Ibrahim`); `mnr` likewise, and always in the same slot the corpus uses it
    // in — `Mnr. G.J. Bisschop`, `Mnr. G. Goodwin`, `Mnr. Blake`. The abbreviation and its expansion are
    // attested independently, in the same construction, which is the pair this table needs.
    // ⚠ `mev` (mevrou) IS THE IDENTICAL SHAPE AND IS DELIBERATELY NOT DECLARED. It attests just as well
    // (`Mev. Peperpot`, `Mev. Ples`) but it is ×0 in this language's artifact, so declaring it would be
    // widening on a guess rather than repairing a measurement. It is recorded here so the next reader does
    // not have to re-derive it — one line, whenever a corpus instance appears.
    "dottedAbbreviations": {
        "dr": "Dokter", "mnr": "Meneer", "m.p.u": "myl per uur", "m.p.u.": "myl per uur",
        "n.m": "namiddag", "n.m.": "namiddag"
    },

    // Afrikaans letter names — aa, bee, see … (the corpus's own alphabet article: "die gewone alfabet as
    // die ABC (uitgespreek aa-bee-see)"). The g2p spells them through itself.
    "letterNames": {
        "a": "aa", "b": "bee", "c": "see", "d": "dee", "e": "ee", "f": "ef", "g": "gee", "h": "haa",
        "i": "ie", "j": "jee", "k": "kaa", "l": "el", "m": "em", "n": "en", "o": "oo", "p": "pee",
        "q": "kuu", "r": "er", "s": "es", "t": "tee", "u": "uu", "v": "vee", "w": "wee", "x": "eks",
        "y": "ei", "z": "zet"
    },

    // LEXICAL: acronyms read AS WORDS despite being unreadable by phonotactics (REM-slaap, COVID, FIFA,
    // NATO, OPEC, UNESCO, AIDS). "die GPS" by contrast is read as letters.
    "wordAcronyms": ["rem", "covid", "fifa", "nato", "opec", "unesco", "aids"],
    // …and the readable-looking runs Afrikaans nonetheless SPELLS OUT, which the phonotactic rule would
    // otherwise hand to the g2p as a word.
    "acronymLetters": ["uk", "vk", "vn", "vsa", "vs", "aol"],

    // Afrikaans phonotactics for the OOV initialism rule (core/initialisms.ts): can this letter run be a
    // word at all? Onsets and codas that a native word may actually carry.
    "phonotactics": {
        "legalOnsets": [
            "bl", "br", "ch", "dr", "dw", "fl", "fr", "gl", "gn", "gr", "kl", "kn", "kr", "kw", "pl",
            "pr", "ps", "sc", "sch", "sf", "sj", "sk", "sl", "sm", "sn", "sp", "st", "sw", "th", "tj",
            "tr", "tw", "vl", "vr", "wr", "zw"
        ],
        "legalCodas": [
            "ch", "ck", "ft", "ht", "kt", "ld", "lf", "lg", "lk", "lm", "lp", "ls", "lt", "mp", "ms",
            "mt", "nd", "ng", "nk", "ns", "nt", "pt", "rd", "rf", "rg", "rk", "rl", "rm", "rn", "rp",
            "rs", "rt", "sp", "st", "ts", "ks", "ps", "sk"
        ]
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // Cardinal number words (authored spelling; the compositor in numbers.ts phonemizes each through the g2p, so
    // they stay in our convention). Afrikaans uses the Dutch-style UNIT-en-TEN order: 21 = een-en-twintig.
    "numbers": {
        "units": ["nul", "een", "twee", "drie", "vier", "vyf", "ses", "sewe", "agt", "nege"],
        "teens": ["tien", "elf", "twaalf", "dertien", "veertien", "vyftien", "sestien", "sewentien", "agtien", "negentien"],
        "tens": ["", "", "twintig", "dertig", "veertig", "vyftig", "sestig", "sewentig", "tagtig", "negentig"],
        "en": "en", "hundred": "honderd", "thousand": "duisend", "million": "miljoen"
    },

    // Morphology for the shared West-Germanic compound engine (core/germanicMorphology.ts). Afrikaans is heavily
    // compounding like Dutch/German; splitting a word into its morphemes lets each element be phonemized with its own
    // stress + coda devoicing (huis·deur → ɦœys·døːr). Affixes longest-first. The stem lexicon is a frequency wordlist.
    // ⚠ THIS COMMENT USED TO CITE aand·ete AS THE WORKED EXAMPLE, and morphology.ts still claims the guard below
    // keeps it whole. IT DOES NOT: "dete" is in the frequency wordlist (junk), so `realWordStressedPrefixes` is
    // satisfied and the stressed-prefix strip — which runs BEFORE splitCompound — wins with aan·dete. Trying
    // splitCompound first is worth exactly +1 word in af (measured) and would reorder the SHARED Germanic engine
    // for nl/de as well, so it was left alone and written down instead. See docs/afrikaans_stress_investigation.md Run 6.
    "morphology": {
        "prefixUnstressed": ["ver", "ont", "her", "be", "ge", "er"],
        "prefixStressed": ["agter", "binne", "buite", "onder", "terug", "deur", "voor", "saam", "teen", "aan", "af", "by", "in", "om", "oor", "op", "uit", "weg", "mee", "toe", "na"],
        "ambiguousPrefixes": ["be", "ge", "er"],
        "suffixes": ["likheid", "heid", "teit", "asie", "isie", "isme", "agtig", "baar", "loos", "saam", "lik"],
        "vowelInitialSuffixes": ["agtig", "asie", "isie"],
        // ⚠ ORDER IS LOAD-BEARING, LONGEST-FIRST. With "" first, a head whose next letter is ⟨s⟩ loses the
        // Fugen-s to the FOLLOWING element whenever that also happens to be a word: voedingswaarde split as
        // voeding·swaarde rather than voedings·waarde, which is wrong on its own terms and additionally made
        // the ⟨sw⟩ look like an onset for the `wGlideAfter` rule (*fudəŋswɑːrdə for RCRL ˈfu.dəŋs.vɑːr.də).
        // Trying ⟨s⟩ first only wins when the remainder is STILL a valid constituent, so hoof·sweep is
        // untouched (⟨weep⟩ is not a word) while voedings·waarde is fixed.
        "linkingElements": ["s", "e", ""],
        "validOnsets": ["st", "sp", "sk", "sl", "sm", "sn", "sw", "skr", "str", "spr", "spl", "tr", "dr", "kr", "kn", "gr", "gl", "br", "bl", "pr", "pl", "fr", "fl", "vr", "vl", "kw", "tw", "dw", "gn", "ts", "kl"],
        "stKeep": [],

        // ⚠ THE VOWEL-INITIAL SUFFIXES THAT RESYLLABIFY, and so BLOCK the stem's final devoicing: the /d/ of
        // ⟨send⟩ is a CODA in *sende* but the ONSET of the next syllable in send·ing, and Auslautverhärtung is
        // a coda rule — sen·ding [sɛndəŋ], not *[sɛntəŋ]. Read by afrikaans.ts, which phonemizes each morpheme
        // independently and would otherwise devoice at every seam.
        // ⚠ THIS IS A CLOSED LIST, NOT A "next part starts with a vowel" TEST, and the difference is the point:
        // a vowel-initial COMPOUND ELEMENT is its own prosodic word and the stem DOES devoice in front of it —
        // the referee writes aandete [ɑntiətə], bandopnemer [bantɔpniəmər], bloedoortapping [blutuərtapəŋ].
        // Only a SUFFIX resyllabifies.
        // ⚠ ATTESTED, NOT COLLECTED (handoff §11): these are the three tails the splitter actually produces at
        // a voiced-obstruent seam in the 2220-word referee, and the referee corroborates the voiced reading in
        // every one — ⟨ing⟩ ×5 (sending, voeding, verbeelding, volharding, skoolvoeding), ⟨ers⟩ ×1 (kinders
        // kənərs), ⟨eer⟩ ×1 (waardeer vɑrdier). A fourth environment, ⟨ana⟩ in *bandana*, is NOT listed: it is
        // not an Afrikaans suffix, it is a loanword the stem splitter tore in half, and the defect there is the
        // split. Measured contribution: +4 words (the other three carry a second, unrelated error each).
        "resyllabifyingSuffixes": ["ing", "ers", "eer"]
    }
}
