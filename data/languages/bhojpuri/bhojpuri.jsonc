// Native canonical-IPA definition for BHOJPURI (bho) — Devanagari, read by the shared Hindi engine
// (src/languages/hindi/hindi.ts `makeNativeHindi`) and by its C# port. ⚠ THIS HEADER USED TO SAY "for
// Hindi (hi)" and to name a module path that no longer exists; the file has always been Bhojpuri's, and
// the divergences from Hindi are in `provenance` below. A shallow abugida, so pronunciation is almost
// entirely rule-derivable; the one genuinely hard part is schwa deletion (a documented algorithm, not a
// lexicon). ⚠ The same stale Hindi header still sits on hindi.jsonc's siblings magahi.jsonc and
// marathi.jsonc.
//
// Format: plain JSONC. Verbose, self-describing keys. Every phoneme value is CANONICAL IPA.
{
    "language": "bho",
    "name": "Bhojpuri",
    "script": ["Devanagari"],
    "provenance": "REVISED from 'A Grammar of Bhojpuri' (dissertation, Shukla-tradition), whose glossed examples were g2p-mined (1622 Devanagari→IPA pairs) as a falsifiable anchor. Reuses the Hindi Devanagari engine with the Bhojpuri divergences: an 8-vowel /i e ɛ a ʌ ɔ o u/ system with NO phonemic length (0/1622 mined length marks), ऐ→ɛ/औ→ɔ MONOPHTHONGS (the earlier 'diphthong' claim was WRONG), श/ष→s (only /s ɦ/ fricatives), व→w (not Hindi ʋ), ण/ञ→n. Single published source → [confidence grade TRUNCATED — the generator that wrote this string dropped the token after the arrow; magahi.jsonc has the same wound. Not reconstructed here, because guessing a confidence grade is worse than showing that one is missing].",

    // The vowel inserted after a consonant that has no explicit vowel sign and no virama (the abugida
    // 'inherent vowel'). Hindi's is the schwa /ə/. Its deletion (below) is the one non-trivial rule.
    "inherentVowel": "ə",  // schwa (fleet ə convention; Bhojpuri realises it [ʌ], folded)

    // Consonant letters → canonical IPA. `note` documents the phonological class + any referee decision.
    "consonants": {
        "क": { "ipa": "k", "note": "velar stop, voiceless" },
        "ख": { "ipa": "kʰ", "note": "velar stop, voiceless aspirated" },
        "ग": { "ipa": "ɡ", "note": "velar stop, voiced" },
        "घ": { "ipa": "ɡʱ", "note": "velar stop, voiced breathy" },
        "ङ": { "ipa": "ŋ", "note": "velar nasal" },
        "च": {
            "ipa": "t͡ʃ",
            "note": "post-alveolar affricate, voiceless (Hindi च = t͡ʃ, cf. Bengali t͡ɕ)",
        },
        "छ": {
            "ipa": "t͡ʃʰ",
            "note": "post-alveolar affricate, voiceless aspirated",
        },
        "ज": { "ipa": "d͡ʒ", "note": "post-alveolar affricate, voiced" },
        "झ": {
            "ipa": "d͡ʒʱ",
            "note": "post-alveolar affricate, voiced breathy",
        },
        "ञ": { "ipa": "n", "note": "palatal nasal" },
        "ट": { "ipa": "ʈ", "note": "retroflex stop, voiceless" },
        "ठ": { "ipa": "ʈʰ", "note": "retroflex stop, voiceless aspirated" },
        "ड": { "ipa": "ɖ", "note": "retroflex stop, voiced" },
        "ढ": { "ipa": "ɖʱ", "note": "retroflex stop, voiced breathy" },
        "ण": { "ipa": "n", "note": "retroflex nasal" },
        "त": {
            "ipa": "t̪",
            "note": "DENTAL stop, voiceless (t̪ vs retroflex ट=ʈ — the core coronal contrast)",
        },
        "थ": { "ipa": "t̪ʰ", "note": "dental stop, voiceless aspirated" },
        "द": { "ipa": "d̪", "note": "dental stop, voiced" },
        "ध": { "ipa": "d̪ʱ", "note": "dental stop, voiced breathy" },
        "न": { "ipa": "n", "note": "dental/alveolar nasal" },
        "प": { "ipa": "p", "note": "labial stop, voiceless" },
        "फ": { "ipa": "pʰ", "note": "labial stop, voiceless aspirated" },
        "ब": { "ipa": "b", "note": "labial stop, voiced" },
        "भ": { "ipa": "bʱ", "note": "labial stop, voiced breathy" },
        "म": { "ipa": "m", "note": "labial nasal" },
        "य": { "ipa": "j", "note": "palatal approximant" },
        "र": { "ipa": "ɾ", "note": "alveolar tap" },
        "ल": { "ipa": "l", "note": "alveolar lateral" },
        "व": { "ipa": "w", "note": "labial-velar approximant — Bhojpuri [w], NOT Hindi's labiodental ʋ (the description this note used to carry, copied from hindi.jsonc)" },
        "श": { "ipa": "s", "note": "Bhojpuri merges श → [s] (NO /ʃ/) — शहर→sahar (vs Hindi ʃ)" },
        "ष": { "ipa": "s", "note": "Bhojpuri ष → [s] (no /ʃ/ or /ʂ/)" },
        "स": { "ipa": "s", "note": "alveolar sibilant" },
        "ह": { "ipa": "ɦ", "note": "voiced glottal fricative (Hindi ह = ɦ)" },
        "ळ": {
            "ipa": "ɭ",
            "note": "retroflex lateral (rare, mainly loans/Marathi)",
        },
        // Nukta letters (borrowed/Perso-Arabic sounds)
        "क़": { "ipa": "q", "note": "uvular stop (nukta क)" },
        "ख़": { "ipa": "x", "note": "velar fricative voiceless (nukta ख)" },
        "ग़": { "ipa": "ɣ", "note": "velar fricative voiced (nukta ग)" },
        "ज़": { "ipa": "z", "note": "alveolar sibilant voiced (nukta ज)" },
        "ड़": { "ipa": "ɽ", "note": "retroflex flap (nukta ड)" },
        "ढ़": { "ipa": "ɽʱ", "note": "retroflex flap breathy (nukta ढ)" },
        "फ़": { "ipa": "f", "note": "labiodental fricative (nukta फ)" },
        "य़": { "ipa": "j", "note": "ya with nukta" },
    },

    // Independent vowel letters (word-initial / standalone).
    // ⚠ THE "short"/"long" IN THE NOTES BELOW DESCRIBES THE DEVANAGARI LETTER PAIR, NOT THIS INVENTORY.
    // Bhojpuri has NO phonemic length, so इ/ई and उ/ऊ each collapse to one phone (i, u) and no value here
    // carries ː. The wording is inherited from hindi.jsonc, where the pairs really do contrast.
    "independentVowels": {
        // ⚠ SECOND SUSPECTED DEFECT, ALSO FILED RATHER THAN FIXED — ONE PHONEME, TWO SYMBOLS. This letter
        // ships [ʌ] while `inherentVowel` above ships [ə], and that comment calls the [ʌ] realisation
        // "folded", i.e. the same sound. So अञ्जन reads ʌnd͡ʒən — both symbols, one word, two syllables
        // apart. `provenance` compounds it: the declared inventory is /i e ɛ a ʌ ɔ o u/, which contains ʌ
        // and NOT ə, so neither value matches the file's own statement of the system.
        // NOT A COSMETIC SPLIT: ʌ is in 99 of the 200 golden rows and ə in all 200.
        // Every non-derived Devanagari sibling writes ə here (hi/mr/awa/mai/hne); only magahi.jsonc, which
        // was derived from this file, copies the ʌ. rangpuri.jsonc also splits (अ→ɔ over an ə inherent)
        // but documents an Eastern-Indic reason; this file documents none.
        // ⚠ THE DIRECTION IS NOT OBVIOUS, which is why this is filed and not fixed: folding ʌ→ə matches the
        // inherent vowel and the siblings, folding ə→ʌ matches `provenance`'s inventory. The 1622-pair
        // grammar-mined referee decides it; it is not in the repo. Whichever way, both engines move
        // together and csharp/goldens/bho.tsv is regenerated with `tools/gen_variant_golden.mts hi bho`.
        "अ": { "ipa": "ʌ", "note": "short central (schwa) — see the filed defect above" },
        "आ": { "ipa": "ɑ", "note": "long open" },
        "इ": { "ipa": "i", "note": "short near-close front" },
        "ई": { "ipa": "i", "note": "long close front" },
        "उ": { "ipa": "u", "note": "short near-close back" },
        "ऊ": { "ipa": "u", "note": "long close back" },
        "ऋ": {
            "ipa": "ɾi",
            // ⚠ WAS ASCII ⟨r⟩ (IPA: alveolar TRILL) — the only r in this manifest, beside `consonants`
            // र→ɾ and no declared trill, so कृष्ण read krisn with a trill while कर read kəɾ with a tap in
            // one language. bho and magahi were the ONLY two of the eight Devanagari engines doing this;
            // hi/awa/mai/hne/mr write ɾɪ and rkt ɾi. The slip's shape was visible in the file: the
            // Bhojpuri revision was about LENGTH (ɪ→i) and ɾɪ→ri dropped the hook along with the laxness.
            // ⚠ RESOLVED ON INTERNAL CONSISTENCY, BECAUSE THE REFEREE CANNOT ARBITRATE — and the earlier
            // deferral turned on finding it. The 1622-pair grammar-mined artifact IS in the repo, at
            // tools/referee-eval/referees/bho.grammar-mined.tsv (it was searched for under tools/corpus/
            // and /mnt/data). It transcribes the rhotic as ASCII r in 370 rows and ɾ in ZERO, and
            // tools/referee-eval/langs/bho.jsonc already folds ɾ→r for exactly that reason ("the ⟨र⟩ tap
            // [ɾ] ~ the grammar's [r]"). So the grammar's `r` in drisʈi/srij/vrit is its notation for the
            // rhotic in general, not a trill claim, and it cannot witness this question either way.
            // The fold is also why the referee score is INVARIANT under this change — measured, unchanged
            // at 71.041% — so nothing here is being traded for a number.
            // ⚠ SUSPECTED DEFECT, FILED RATHER THAN FIXED — the rhotic here is ASCII ⟨r⟩ (IPA: alveolar
            // TRILL), and it is the ONLY r in this manifest. `consonants` gives र→ɾ and declares no trill,
            // so कृष्ण reads krisn with a trill while कर reads kəɾ with a tap, in one language. Every
            // sibling Devanagari manifest writes the tap — hi/awa/mai/hne/mr ɾɪ, rkt ɾi — and this note
            // itself says "ɾɪ". The shape of the slip is visible: the Bhojpuri revision was about LENGTH
            // (ɪ→i), and ɾɪ→ri drops the hook as well as the laxness; magahi.jsonc, derived from this file,
            // carries the same ⟨r⟩ while independently-revised rangpuri.jsonc has ɾi.
            "note": "vocalic r (Sanskrit; realized ɾɪ in Hindi, ɾi here — no phonemic length)",
        },
        "ए": { "ipa": "e", "note": "long close-mid front" },
        "ऐ": { "ipa": "ɛ", "note": "⚠ MONOPHTHONG [ɛ], NOT the diphthong [ai] — बैल→bɛl. An earlier revision of this note claimed Bhojpuri 'KEEPS the diphthong'; `provenance` above records that claim as WRONG. Do not 'fix' the value to match the retracted note." },
        "ओ": { "ipa": "o", "note": "long close-mid back" },
        "औ": { "ipa": "ɔ", "note": "⚠ MONOPHTHONG [ɔ], NOT the diphthong [au] — कौन→kɔn. Same retraction as ऐ above." },
        "ऍ": { "ipa": "ɛ", "note": "candra e (loans)" },
        "ऑ": { "ipa": "ɔ", "note": "candra o (loans, e.g. English 'o')" },
        "ॐ": { "ipa": "õm", "note": "Om sign (U+0950) — a whole syllable" },
    },

    // Dependent vowel signs (matras) — replace the inherent vowel on the preceding consonant.
    "vowelSigns": {
        "ा": { "ipa": "ɑ" },
        "ि": { "ipa": "i" },
        "ी": { "ipa": "i" },
        "ु": { "ipa": "u" },
        "ू": { "ipa": "u" },
        "ृ": { "ipa": "ɾi" }, // moved with ऋ above, as its note requires
        "े": { "ipa": "e" },
        "ै": { "ipa": "ɛ" },
        "ो": { "ipa": "o" },
        "ौ": { "ipa": "ɔ" },
        "ॅ": { "ipa": "ɛ" },
        "ॉ": { "ipa": "ɔ" },
    },

    // Combining signs with special effects.
    "signs": {
        "virama": {
            "char": "्",
            "effect": "suppressInherentVowel",
            "note": "halant — the consonant carries no vowel (forms clusters/conjuncts)",
        },
        "anusvara": {
            "char": "ं",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel. ⚠ THE PARENTHETICAL THIS NOTE USED TO CARRY WAS HINDI'S AND WAS ALSO FALSE OF THE ENGINE: the shared abugida g2p DOES restore a homorganic nasal before a stop, so कांग्रेस reads kɑ̃ŋɡɾes and इंटरनेट ĩɳʈəɾneʈ — the [ɳ] is an inserted allophone and is deliberately absent from `consonants` above, where ण→n. And 'nasal vowels are short' is vacuous here: see `nasalVowelsAreShort` at the foot of the file.",
        },
        "chandrabindu": {
            "char": "ँ",
            "effect": "nasalizeVowel",
            "note": "nasalizes the preceding vowel",
        },
        "visarga": { "char": "ः", "effect": "appendH", "note": "→ [h]" },
        "nukta": {
            "char": "़",
            "effect": "composeNukta",
            "note": "combines with the preceding consonant (decomposed form) into the nukta letter",
        },
    },

    // Schwa deletion — the one hard rule. Hindi deletes the inherent schwa word-finally (except
    // monosyllables) and medially in a VCəCV context (Ohala 1983), applied right-to-left after the
    // final deletion. The engine implements this; parameters are declared here for transparency.
    "schwaDeletion": {
        "deleteWordFinal": true,
        "retainInMonosyllable": true,
        // ⚠ A word-final AVAGRAHA ⟨ऽ⟩ RETAINS the vowel. Bhojpuri uses it as a live orthographic mark on the
        // imperative/participial forms (करऽ kʌrʌ, देखऽ dekʰʌ, दऽ dʌ, खइलऽ kʰʌilʌ) — not as Sanskrit's
        // elision sign. All 31 avagraha forms in the grammar-mined referee keep the vowel; none delete it.
        "retainOnAvagraha": true,
        "medialRule": "ohala-VCaCV",
        "note": "Final-first, then medial VCəCV → VCCV right-to-left. भारत → bʱɑɾət̪ (medial ə RETAINED because the following त̪ is word-final, no CV context). ⚠ The example used to be written with Hindi's LONG aː, which this language does not have.",
    },

    // Post-rules applied to the raw akshara IPA (declarative, ordered regex — portable). Geminate→length
    // is the fleet-wide Indic convention; the offglide + अय→ɛ are systematic Hindi realizations.
    "postRules": [
        {
            "from": "((?:t͡ʃʰ|d͡ʒʱ|t͡ʃ|d͡ʒ|t̪ʰ|d̪ʱ|[kɡptbmnlʃsɳŋɽ]ʰ?ʱ?|t̪|d̪))\\1(?!͡)",
            "to": "$1ː",
            "note": "geminate → single + length (क्क→kː, च्च→t͡ʃː)",
        },
        {
            "from": "ː([ʰʱ])",
            "to": "$1ː",
            "note": "aspiration-before-length reorder: differing-aspiration conjunct द्ध→d̪ːʱ→d̪ʱː (fleet convention, matches bn/si); avoids stranding ʰ/ʱ after the length mark (युद्ध बुद्ध अच्छा पत्थर)",
        },
    ],
    // Final conventions applied AFTER schwa deletion.
    "finalRules": [],
    // No Hindi-style finalRules: Bhojpuri keeps intervocalic əɦə (शहर→sahar, not the Hindi ɛɦɛ) and has no
    // और-offglide / अय→ɛj convention.

    // NUMBERS — authored Devanagari SPELLINGS (public-fact numerals); the canonical IPA is DERIVED by
    // running these through the same native G2P (no hand-written phonemes). The
    // compositor (core/numbers.ts) assembles them with Indian lakh/crore grouping.
    // NOTE: 21-99 are IRREGULAR (not compositional — इक्कीस ≠ इक+बीस), so all 72 are spelled out in
    // `compound` below. ⚠ These are HINDI's spellings, unrevised: no Bhojpuri numeral source has been
    // applied to this table, and Bhojpuri numerals are not uniformly identical to Hindi's.
    "numbers": {
        "units": [
            "शून्य",
            "एक",
            "दो",
            "तीन",
            "चार",
            "पाँच",
            "छह",
            "सात",
            "आठ",
            "नौ",
        ],
        "teens": [
            "दस",
            "ग्यारह",
            "बारह",
            "तेरह",
            "चौदह",
            "पंद्रह",
            "सोलह",
            "सत्रह",
            "अठारह",
            "उन्नीस",
        ],
        "tens": {
            "20": "बीस",
            "30": "तीस",
            "40": "चालीस",
            "50": "पचास",
            "60": "साठ",
            "70": "सत्तर",
            "80": "अस्सी",
            "90": "नब्बे",
        },
        "compound": {
            "21": "इक्कीस",
            "22": "बाईस",
            "23": "तेईस",
            "24": "चौबीस",
            "25": "पच्चीस",
            "26": "छब्बीस",
            "27": "सत्ताईस",
            "28": "अट्ठाईस",
            "29": "उनतीस",
            "31": "इकतीस",
            "32": "बत्तीस",
            "33": "तैंतीस",
            "34": "चौंतीस",
            "35": "पैंतीस",
            "36": "छत्तीस",
            "37": "सैंतीस",
            "38": "अड़तीस",
            "39": "उनतालीस",
            "41": "इकतालीस",
            "42": "बयालीस",
            "43": "तैंतालीस",
            "44": "चवालीस",
            "45": "पैंतालीस",
            "46": "छियालीस",
            "47": "सैंतालीस",
            "48": "अड़तालीस",
            "49": "उनचास",
            "51": "इक्यावन",
            "52": "बावन",
            "53": "तिरेपन",
            "54": "चौवन",
            "55": "पचपन",
            "56": "छप्पन",
            "57": "सत्तावन",
            "58": "अट्ठावन",
            "59": "उनसठ",
            "61": "इकसठ",
            "62": "बासठ",
            "63": "तिरेसठ",
            "64": "चौंसठ",
            "65": "पैंसठ",
            "66": "छियासठ",
            "67": "सड़सठ",
            "68": "अड़सठ",
            "69": "उनहत्तर",
            "71": "इकहत्तर",
            "72": "बहत्तर",
            "73": "तिहत्तर",
            "74": "चौहत्तर",
            "75": "पचहत्तर",
            "76": "छिहत्तर",
            "77": "सतहत्तर",
            "78": "अठहत्तर",
            "79": "उनासी",
            "81": "इक्यासी",
            "82": "बयासी",
            "83": "तिरासी",
            "84": "चौरासी",
            "85": "पचासी",
            "86": "छियासी",
            "87": "सत्तासी",
            "88": "अट्ठासी",
            "89": "नवासी",
            "91": "इक्यानवे",
            "92": "बानवे",
            "93": "तिरानवे",
            "94": "चौरानवे",
            "95": "पंचानवे",
            "96": "छियानवे",
            "97": "सत्तानवे",
            "98": "अट्ठानवे",
            "99": "निन्यानवे",
        },
        "magnitudes": {
            "hundred": "सौ",
            "thousand": "हज़ार",
            "lakh": "लाख",
            "crore": "करोड़",
        },
        "grouping": "indian-lakh-crore",
        "decimalWord": "दशमलव",
    },

    // Symbol → spoken word, read by THIS engine's own tokenizer AFTER the preceding number (50% → पचास
    // प्रतिशत). `stripSymbols` drops a sign here instead of reading it.
    // ⚠ ₹ DOES NOT COME OUT SILENT, AND THIS COMMENT USED TO CLAIM IT DID ("₹500 → पाँच सौ", plus a
    // half-sentence that trailed off). The SHARED symbol tier runs first and it is HINDI's — bho declares no
    // `symbolTier`, so makeNativeHindi falls back to hindi.jsonc's — and that tier claims ₹ and appends
    // रुपये before the strip below ever sees the sign. Measured: `₹500` reads pɑ̃t͡ʃ sɔ ɾupje. The strip is
    // the second line of defence, for a ₹ the shared tier did not claim.
    "symbols": { "%": "प्रतिशत" },
    "stripSymbols": "₹",

    // Clause / phrase punctuation → canonical inline pause marks (Devanagari danda ।/॥ + ASCII).
    "clausePunctuation": {
        "।": ".",
        "॥": ".",
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // ⚠ INERT IN THIS LANGUAGE, AND KEPT ONLY SO THE FAMILY'S FILES READ ALIKE. The flag's whole effect is
    // `out.replace(/ː$/, "")` before the nasal tilde (core/abugida.ts), and BHOJPURI HAS NO PHONEMIC LENGTH:
    // not one entry in `independentVowels` or `vowelSigns` above carries ː, and the only ː this engine ever
    // writes comes from the geminate `postRules`, which run AFTER g2p. So neither setting can move a byte.
    // ⚠ The evidence this note used to cite was HINDI's — the WikiPron hin_deva narrow referee's nɐɦĩː /
    // jɐɦãː / ɡãː — which is not a Bhojpuri source and, in a language with no length contrast, not an
    // argument for either value. Flipping it is safe; sourcing it is not required, because nothing reads it.
    "nasalVowelsAreShort": false,
}
