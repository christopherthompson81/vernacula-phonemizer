// Native canonical-IPA data manifest for Zulu (zu, isiZulu) — Nguni Bantu, AUTHORED.
// This file IS the hand-authored language DATA: the longest-match orthography→IPA rule table (clicks,
// affricates, depressor consonants), the tone-code→Chao map, clause punctuation, and the number words. The
// ALGORITHMS that read it stay in code:
//   g2p.ts   — the longest-match scan (multi-char keys first) + the word-initial ntsh special case
//   zulu.ts  — Nguni penultimate stress + vowel lengthening, camelCase-compound split, lexical tone overlay
//   numbers.ts — the agglutinative Bantu cardinal compositor (ku-/na-/ama- stems, noun-class magnitudes)
// The per-word tone lexicon stays in the sibling tone.tsv (kaikki/Wiktionary-derived), which the engine overlays.
//
// Format: plain JSONC. Every phoneme value is CANONICAL IPA (fills the census click gaps ǀ ǃ ǁ).
{
    "language": "zu",
    "name": "Zulu (isiZulu)",
    "script": ["Latin"],
    "provenance": "Authored; IPA + inventory anchored on the epitran zul-Latn + kaikki referees. A near-clone of Xhosa. This file IS the language data — the native rule engine reads it directly.",

    "convention": {
        "clicks": "15-way series: c/q/x → kǀ/kǃ/kǁ; aspirated ch/qh/xh; depressor gc/gq/gx; nasal nc/nq/nx; etc.",
        "implosive": "b → ɓ (plain b only after m: mb = [mb])",
        "ejective": "plain voiceless stops p/t/k → pʼ/tʼ/kʼ; aspirates ph/th/kh → pʰ/tʰ/kʰ",
        "depressor": "voiced obstruents carry the breathy diacritic ̤ (g→ɡ̤, d→d̤, z→z̤)",
        "stress": "Nguni penultimate — the penult vowel takes ˈ and length ː",
        "tone": "lexical overlay from tone.tsv (H/L/F/R per vowel); out-of-lexicon words untoned",
    },

    // Orthography → IPA, LONGEST-match (multi-char keys tried first). The boolean = the unit is a vowel nucleus.
    "rules": [
        ["tshh", "t͡ʃʰ", false],
        ["thsh", "t͡ʃʰ", false],
        ["ntsh", "ɲt͡ʃʼ", false],
        ["nkc", "ŋǀʼ", false],
        ["nkx", "ŋǁʼ", false],
        ["nkq", "ŋǃʼ", false],
        ["ngc", "ŋ̤ǀ", false],
        ["ngx", "ŋ̤ǁ", false],
        ["ngq", "ŋ̤ǃ", false],
        ["tsh", "t͡ʃʼ", false],
        ["ths", "t͡sʰ", false],
        ["tyh", "cʰ", false],
        ["bh", "b̤", false],
        ["ch", "kǀʰ", false],
        ["dl", "ɮ̤", false],
        ["dy", "ɟ̤", false],
        ["gc", "ɡ̤ǀ", false],
        ["gx", "ɡ̤ǁ", false],
        ["gq", "ɡ̤ǃ", false],
        ["gr", "ɣ̤", false],
        ["hh", "ɦ̤", false],
        ["hl", "ɬ", false],
        ["kh", "kʰ", false],
        ["kl", "k͡xʼ", false],
        ["mb", "mb", false],
        ["nc", "ŋǀ", false],
        ["nx", "ŋǁ", false],
        ["nq", "ŋǃ", false],
        ["ng", "ŋɡ̤", false],
        ["ny", "ɲ", false],
        ["nj", "ɲd͡ʒ̤", false],
        ["nk", "ŋkʼ", false],
        ["ph", "pʰ", false],
        ["qh", "kǃʰ", false],
        ["sh", "ʃ", false],
        ["th", "tʰ", false],
        ["ts", "t͡sʼ", false],
        ["ty", "cʼ", false],
        ["xh", "kǁʰ", false],
        ["a", "a", true],
        ["e", "ɛ", true],
        ["i", "i", true],
        ["o", "ɔ", true],
        ["u", "u", true],
        ["b", "ɓ", false],
        ["c", "kǀ", false],
        ["d", "d̤", false],
        ["f", "f", false],
        ["g", "ɡ̤", false],
        ["h", "h", false],
        ["j", "d͡ʒ̤", false],
        ["k", "kʼ", false],
        ["l", "l", false],
        ["m", "m", false],
        ["n", "n", false],
        ["p", "pʼ", false],
        ["q", "kǃ", false],
        ["r", "r", false],
        ["s", "s", false],
        ["t", "tʼ", false],
        ["v", "v̤", false],
        ["w", "w", false],
        ["x", "kǁ", false],
        ["y", "j", false],
        ["z", "z̤", false],
    ],

    // Lexical tone code → Chao contour letters (overlaid after the vowel + its length).
    "toneChao": { "H": "˥", "L": "˩", "F": "˥˩", "R": "˩˥" },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Cardinal number words — agglutinative Bantu. Units 1–9 have standalone (ku-), connective (na-) and
    // multiplier (ama-) stems; magnitudes are noun classes with a singular (1) / plural (≥2) form.
    "numbers": {
        "ku": [
            "",
            "kunye",
            "kubili",
            "kuthathu",
            "kune",
            "kuhlanu",
            "isithupha",
            "isikhombisa",
            "isishiyagalombili",
            "isishiyagalolunye",
        ],
        "na": [
            "",
            "nanye",
            "nambili",
            "nantathu",
            "nane",
            "nanhlanu",
            "nesithupha",
            "nesikhombisa",
            "nesishiyagalombili",
            "nesishiyagalolunye",
        ],
        "ama": [
            "",
            "",
            "amabili",
            "amathathu",
            "amane",
            "amahlanu",
            "ayisithupha",
            "ayisikhombisa",
            "ayisishiyagalombili",
            "ayisishiyagalolunye",
        ],
        "zero": "iqanda",
        "ten": { "one": "ishumi", "many": "amashumi" },
        "hundred": { "one": "ikhulu", "many": "amakhulu" },
        "thousand": { "one": "inkulungwane", "many": "izinkulungwane" },
        "million": { "one": "isigidi", "many": "izigidi" },
    },

    // The `ye-` ordinal series, 2–10. ⚠ IT FEEDS THE FRACTION RULE, not an ordinal one: `1/2` reads
    // *ingxenye yesibili*, so these are the DENOMINATOR forms. Numerator 1 only — see normalize.ts step 14
    // for why a numerator above one is left unclaimed (its class-8 concord would have to be applied).
    "ordinalYe": {
        "2": "yesibili", "3": "yesithathu", "4": "yesine", "5": "yesihlanu", "6": "yesithupha",
        "7": "yesikhombisa", "8": "yesishiyagalombili", "9": "yesishiyagalolunye", "10": "yeshumi"
    }
}
