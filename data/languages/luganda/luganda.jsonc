// Native canonical-IPA data manifest for Luganda / Oluganda (lg) — Bantu (Great Lakes, JE15), the Latin
// orthography. The principal language of Uganda (~11M incl. L2). A greedy longest-match scan
// (luganda.ts) with CONSONANT GEMINATION (doubled → Cː) and VOWEL LENGTHENING before a prenasalised consonant
// (Buganda → buɡaːnda). Phonology grounded in Wikipedia (Luganda) + the epitran lug-Latn map. Signatures:
//   • 5 vowels a e i o u; DOUBLING = LENGTH (aa→aː …). Length is phonemic (bana 'four' vs baana 'children').
//   • PRENASALISED consonants as single onset units (mb→ᵐb, nd→ⁿd, ng→ᵑɡ, nj→ⁿɟ, nc→ⁿc, nk→ᵑk, mp→ᵐp, nf→ᵐf,
//     nv→ᵐv); ⟨ng'⟩→ŋ (velar nasal, distinct from ⟨ng⟩→ᵑɡ), ⟨ny⟩→ɲ; LABIALISATION ⟨Cw⟩→Cʷ.
//   • ⟨ŋ⟩ IS A ROW OF ITS OWN (#1131). ⟨ng'⟩ is the commoner spelling of the velar nasal, but the literal
//     letter occurs in this language's own corpus (FLEURS lg_ug + tools/corpus/mined/lg.jsonc), and without
//     a row the nativiser's UNDECOMPOSABLE fold sent it to ⟨n⟩ — so `ziseŋŋendo` spoke an ALVEOLAR geminate
//     nː where the orthography wrote the velar. The two spellings now read the same phoneme.
//   • ⟨c⟩=c, ⟨j⟩=ɟ (voiceless/voiced palatal STOPS, Wikipedia — [tʃ]/[dʒ] are allophones before front vowels;
//     folded c~tʃ, ɟ~dʒ vs the epitran referee). ⟨l⟩=l, ⟨r⟩=ɾ (allophones the orthography already writes).
// TONE (3-way H/L/falling) is LEXICAL + UNWRITTEN → DEFERRED (not emitted). REFEREE = epitran lug-Latn only, which
// is itself RULE-based, so the comparison is partly circular (single-source).
{
    "language": "lg",
    "name": "Luganda (Oluganda)",
    "script": ["Latin"],
    "provenance": "Authored greedy g2p from the Luganda orthography; phonology per Wikipedia + epitran lug-Latn (the referee, rule-based → partly circular).",

    "convention": {
        "vowels": "5 vowels a e i o u; DOUBLING = LENGTH (aa→aː, ee→eː, ii→iː, oo→oː, uu→uː)",
        "prenasal": "⟨mb mp mf mv nf nv nd nt nc nj nk ng⟩ → ᵐb ᵐp ᵐf ᵐv ᵐf ᵐv ⁿd ⁿt ⁿc ⁿɟ ᵑk ᵑɡ (single onset units) — all TWELVE, since this string is now the only place the mapping is written; ⟨ŋ⟩ triggers it too (⟨ŋk⟩ → ᵑk, as ⟨nk⟩ does)",
        "velarNasal": "⟨ng'⟩ → ŋ (distinct from ⟨ng⟩ → ᵑɡ); ⟨nng'⟩ → ŋː; the literal letter ⟨ŋ⟩ → ŋ, ⟨ŋŋ⟩ → ŋː; ⟨ny⟩ → ɲ, ⟨nny⟩ → ɲː",
        "gemination": "a doubled consonant is a GEMINATE Cː (bbiri→bːiri, kitto→citːo) — handled in code",
        "labialisation": "⟨Cw⟩ → Cʷ (bw→bʷ, gw→ɡʷ, …)",
        "palatalStops": "⟨c⟩=c, ⟨j⟩=ɟ (palatal STOPS, not affricates — Wikipedia); ⟨l⟩=l, ⟨r⟩=ɾ",
        "vowelLengthening": "a vowel before a prenasalised consonant is LONG (Buganda → buɡaːnda)",
        "tone": "3-way tone (H/L/falling) is LEXICAL + UNWRITTEN → DEFERRED"
    },

    // Orthography → canonical IPA. The scanner (luganda.ts) reads this table in exactly three places: the
    // SPECIAL list (nng'/nny/ng'/ny/n'), OTHER_DIGRAPHS (⟨Cw⟩ + the vowel-length pairs), and the single-letter
    // lookup. Gemination and vowel-lengthening-before-prenasal are code rules.
    // ⚠ NO PRENASAL DIGRAPH ROW BELONGS HERE, and twelve of them used to (#1132). OTHER_DIGRAPHS filters
    // length-2 keys to `k[1] === "w"` or vowel+vowel, which excluded ⟨mb mp mf mv nf nv nd nt nc nj nk ng⟩
    // BY CONSTRUCTION — deliberately, because the prenasalisation CODE rule consumes only the nasal, which is
    // what keeps a following ⟨w⟩ reachable (ndw → ⁿdʷ). The rows were unreachable and this comment used to
    // claim the scanner tried them, so editing one changed nothing with no way to find out. The mapping they
    // duplicated is stated once, in `convention.prenasal`, and computed once, in the code rule.
    "graphemes": {
        "nng'": "ŋː", "ng'": "ŋ", "nny": "ɲː", "ny": "ɲ", "n'": "ⁿ",
        "bw": "bʷ", "dw": "dʷ", "fw": "fʷ", "gw": "ɡʷ", "jw": "ɟʷ", "kw": "kʷ", "lw": "lʷ",
        "mw": "mʷ", "nw": "nʷ", "pw": "pʷ", "sw": "sʷ", "tw": "tʷ", "vw": "vʷ", "zw": "zʷ",
        "aa": "aː", "ee": "eː", "ii": "iː", "oo": "oː", "uu": "uː",
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "b": "b", "c": "c", "d": "d", "f": "f", "g": "ɡ", "h": "h", "j": "ɟ", "k": "k",
        "l": "l", "m": "m", "n": "n", "ŋ": "ŋ", "p": "p", "q": "k", "r": "ɾ", "s": "s", "t": "t",
        "v": "v", "w": "w", "x": "ks", "y": "j", "z": "z"
    },

    // The five VOWEL LETTERS. Two rules in luganda.ts read them: the DOUBLING split (a doubled vowel is
    // length, a doubled consonant is a geminate [Cː]), and the two-letter grapheme test that admits a
    // vowel-vowel key.
    "vowelLetters": ["a", "e", "i", "o", "u"],
    // The obstruent letters that a preceding ⟨n m ŋ⟩ PRENASALISES (⟨mb nd ŋk⟩ → ᵐb ⁿd ᵑk, one onset unit).
    // ⚠ ⟨ɡ⟩ (U+0261) WAS LISTED HERE as a "defensive alias" beside ASCII ⟨g⟩ and is REMOVED (#1132). It made
    // every reading it touched WORSE, never better: there is no ⟨ɡ⟩ grapheme row and luganda.ts's place test
    // is the ASCII string "kg", so the alias fired the rule, picked the wrong place, dropped the consonant
    // anyway AND spuriously lengthened the vowel — ⟨anɡ⟩ read *aːⁿ* where without it it reads *an*. Measured
    // exhaustively over every three-letter frame containing U+0261 drawn from ASCII a-z with ⟨g⟩ replaced by
    // U+0261 (26³ − 25³ = 1,951 frames): 153 differ, 0 of them in the alias's favour. A defence with no input
    // for which it helps is not a defence.
    // ⚠ DELETING THE ALIAS IS ONLY HALF. On its own it made U+0261 fail predictably rather than corruptly —
    // `luɡanda` → *luaːⁿda*, a consonant still deleted. The other half is a `ɡ → g` row in core/hostWord.ts's
    // UNDECOMPOSABLE table, added with this change: script g is a typographic variant of ⟨g⟩, not a letter of
    // anyone's orthography, and the fold is what makes it READ. `luɡanda` now reads *luɡaːⁿda*, and the same
    // row repairs the whole fleet (`ɡato` read *ˈato* in es). With the fold in place no ⟨ɡ⟩ entry in
    // `prenasalisable` is wanted at all — wiring the alias up would have been in the fold's way.
    "prenasalisable": ["b", "p", "f", "v", "t", "d", "c", "j", "k", "g"],

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // CARDINAL NUMBERS — the CITATION / COUNTING series (emu, bbiri, ssatu, nnya, ttaano …). Luganda numerals
    // 1–5 are adjectival and take noun-class concord (bbiri ~ abiri ~ bibiri ~ bubiri …); the counting series is
    // the class-III/VII shape, which Wikipedia's Luganda numerals note describes as the form "used when counting"
    // — that is what a TTS reading a bare integer must say, since there is no noun to agree with. 6–9 (mukaaga,
    // musanvu, munaana, mwenda) are NOUNS and never inflect, which is why they recur unchanged in every slot.
    // SOURCES: Wikivoyage "Luganda phrasebook" §Numbers (1–20, amakumi abiri/asatu/ana/ataano, the SINGLE-WORD
    // tens nkaaga 60 / nsanvu 70 / kinaana 80 / kyenda 90, kikumi 100, bikumi bibiri 200, lukumi 1 000,
    // nkumi bbiri 2 000, kakadde kamu 1 000 000, akawumbi kamu 1 000 000 000) cross-checked against
    // "How to count in Luganda" (eggsforeducation.wordpress.com, 2011-05-09) and Omniglot "Numbers in Luganda".
    // CONNECTIVES (two of them, both attested): "na"/"n'" inside the teens — kkumi n'emu (11), kkumi na bbiri
    // (12) — and "mu" between magnitude components — amakumi abiri mu emu (21), kikumi mu amakumi abiri mu bbiri
    // (122), bikumi bibiri mu amakumi abiri mu bbiri (222).
    // SIMPLIFIED / EXTRAPOLATED (a reviewer should know): only the ×1 forms of million/billion are attested
    // ("kakadde kamu", "akawumbi kamu"); the plural multipliers obukadde/obuwumbi + the class-14 bu- concord
    // (bubiri, busatu, buna, butaano) are extrapolated from the regular concord series. Luganda also has the
    // higher unit omutwalo (10 000); it is NOT modelled — 10 000 composes as nkumi kkumi ("ten thousands"),
    // which is the ordinary decimal reading.
    "numbers": {
        "zero": "ziro",
        "units": ["", "emu", "bbiri", "ssatu", "nnya", "ttaano", "mukaaga", "musanvu", "munaana", "mwenda"],
        "ten": "kkumi",
        // the round tens: 20–50 are the multiplicative amakumi + class-6 a- concord, 60–90 are SINGLE nouns.
        "tens": ["", "kkumi", "amakumi abiri", "amakumi asatu", "amakumi ana", "amakumi ataano",
                 "nkaaga", "nsanvu", "kinaana", "kyenda"],
        "hundredOne": "kikumi",
        "hundreds": "bikumi",
        "hundredsMult": ["", "", "bibiri", "bisatu", "bina", "bitaano", "mukaaga", "musanvu", "munaana", "mwenda"],
        "thousandOne": "lukumi",
        "thousands": "nkumi",
        "millionOne": "kakadde kamu",
        "millions": "obukadde",
        "billionOne": "akawumbi kamu",
        "billions": "obuwumbi",
        "buMult": ["", "", "bubiri", "busatu", "buna", "butaano", "mukaaga", "musanvu", "munaana", "mwenda"],
        "andTeen": "na",
        "andTeenElided": "n'",
        "mu": "mu"
    }
}
