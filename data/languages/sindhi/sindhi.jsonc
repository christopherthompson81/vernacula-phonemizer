// Native canonical-IPA definition for Sindhi (sd) — Indo-Aryan, Perso-Arabic (Sindhi) ABJAD. sindhi.ts reads this.
// Sindhi's signature is the four-way IMPLOSIVE series ٻ→ɓ, ڏ→ɗ, ڄ→ʄ, ڳ→ɠ (a real census gap) + a full retroflex
// series ٽ ٺ ڊ ڍ ڻ ڙ. Like Urdu, the SHORT vowels are usually UNWRITTEN → a default [ə] stands in (the abjad wall);
// the consonant + LONG-vowel skeleton (incl. the implosives) IS recoverable. Aspiration: some letters are dedicated
// (ڀ bʰ, ٿ t̪ʰ, ٺ ʈʰ, ڦ pʰ, ک kʰ, ڇ t͡ʃʰ, ڌ d̪ʰ, ڍ ɖʰ), others take ھ (جھ d͡ʒʰ, گھ ɡʰ, نھ nʰ …).
{
    "language": "sd",
    "name": "Sindhi",
    "script": ["Arabic"],
    "provenance": "Authored from standard Sindhi (Perso-Arabic) orthography + phonology; cross-checked vs kaikki + wikipron snd.",

    "consonants": {
        "ب": "b", "ٻ": "ɓ", "ڀ": "bʰ", "پ": "p", "ڦ": "pʰ",
        "ت": "t̪", "ٿ": "t̪ʰ", "ٽ": "ʈ", "ٺ": "ʈʰ", "ث": "s",
        "د": "d̪", "ڌ": "d̪ʰ", "ڏ": "ɗ", "ڊ": "ɖ", "ڍ": "ɖʰ", "ذ": "z",
        "ج": "d͡ʒ", "ڄ": "ʄ", "ڃ": "ɲ", "چ": "t͡ʃ", "ڇ": "t͡ʃʰ",
        "ح": "h", "خ": "x", "ر": "ɾ", "ڙ": "ɽ", "ز": "z", "س": "s", "ش": "ʃ",
        "ص": "s", "ض": "z", "ط": "t̪", "ظ": "z", "غ": "ɣ", "ف": "f", "ق": "q",
        "ک": "kʰ", "ڪ": "k", "گ": "ɡ", "ڳ": "ɠ", "ڱ": "ŋ",
        "ل": "l", "م": "m", "ن": "n", "ڻ": "ɳ", "ه": "h", "ھ": "h", "ہ": "h",
        "ء": "ʔ"
    },
    // C + ھ → aspirated, for the consonants WITHOUT a dedicated aspirate letter (ج گ + the sonorants).
    "aspirateWithHe": { "ج": "d͡ʒʰ", "گ": "ɡʰ", "ڪ": "kʰ", "ن": "nʰ", "ڻ": "ɳʰ", "م": "mʰ", "ل": "lʰ", "ر": "ɾʰ", "ڙ": "ɽʰ", "و": "ʋʰ", "ي": "jʰ" },

    // Long-vowel / glide letters (context-resolved in g2p.ts): ا/آ→ɑː, و→uː/oː or ʋ, ي/ی/ے→iː/eː or j.
    "longVowels": { "ا": "aː", "آ": "aː", "و": "oː", "ي": "iː", "ی": "iː", "ے": "eː" },
    "glides": { "و": "ʋ", "ي": "j", "ی": "j", "ے": "j" },

    // Harakat (short-vowel diacritics), used when explicitly written; otherwise a default [ə] is inserted.
    "harakat": { "َ": "ə", "ِ": "i", "ُ": "u" },

    "clausePunctuation": {
        "۔": ".", "؟": "?", "،": ",", "؛": ",", ".": ".", "?": "?", ",": ","
    },

    // NUMBERS. Sindhi had NO number composer: sindhi.ts handed every digit run to the foreign
    // phonemizer, so `5` was spoken as English "five" and `100` as "one hundred". Sindhi is Indo-Aryan
    // with lakh/crore grouping, so the shared `indicNumberWords` is the right composer.
    "numbers": {
        "units": ["ٻڙي", "هڪ", "ٻه", "ٽي", "چار", "پنج", "ڇهه", "ست", "اٺ", "نو"],
        "teens": ["ڏهه", "يارهن", "ٻارهن", "تيرهن", "چوڏهن", "پندرهن", "سورهن", "سترهن", "ارڙهن", "اوڻيهه"],
        "tens": { "20": "ويهه", "30": "ٽيهه", "40": "چاليهه", "50": "پنجاهه", "60": "سٺ", "70": "ستر", "80": "اسي", "90": "نوي" },
        // FUSED 21–99. Sourced from a Sindhi numerals chart (1–100, Sindhi and Urdu columns),
        // then ATTESTATION-CHECKED one at a time against sd.wikipedia `insource:` — 58 of the 72
        // non-round values are attested; the 14 that are not appear below in the omission list, NOT here.
        "compound": {
            "21": "ايڪيهه", "22": "ٻاويهه", "23": "ٽيويهه", "24": "چوويهه",
            "25": "پنجويهه", "26": "ڇويهه", "27": "ستاويهه", "28": "اٺاويهه",
            "29": "اوڻٽيهه", "31": "ايڪٽيهه", "32": "ٻٽيهه", "33": "ٽيٽيهه",
            "34": "چوٽيهه", "35": "پنجٽيهه", "36": "ڇٽيهه", "37": "ستٽيهه",
            "38": "اٺٽيهه", "42": "ٻائيتاليهه", "43": "ٽيتاليهه", "44": "چوئيتاليهه",
            "45": "پنجيتاليهه", "46": "ڇائيتاليهه", "47": "ستيتاليهه", "48": "اٺيتاليهه",
            "49": "اوڻونجاهه", "52": "ٻاونجاهه", "53": "ٽيونجاهه", "55": "پنجونجاهه",
            "56": "ڇاونجاهه", "57": "ستونجاهه", "58": "اٺونجاهه", "61": "ايڪهٺ",
            "63": "ٽيهٺ", "64": "چوهٺ", "65": "پنجهٺ", "66": "ڇاهٺ",
            "67": "ستهٺ", "68": "اٺهٺ", "71": "ايڪهتر", "72": "ٻاهتر",
            "73": "ٽيهتر", "75": "پنجهتر", "76": "ڇاهتر", "78": "اٺهتر",
            "81": "ايڪاسي", "82": "ٻياسي", "84": "چوراسي", "85": "پنجاسي",
            "87": "ستاسي", "88": "اٺاسي", "91": "ايڪانوي", "92": "ٻيانوي",
            "93": "ٽيانوي", "94": "چورانوي", "95": "پنجانوي", "97": "ستانوي",
            "98": "اٺانوي", "99": "نوانوي",
        },
        "magnitudes": { "hundred": "سؤ", "thousand": "هزار", "lakh": "لک", "crore": "ڪروڙ" },
    },
}
