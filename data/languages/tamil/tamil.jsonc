{
    // Tamil (ta) abugida definition — consumed by the shared core/abugida.ts interpreter (same engine as Hindi).
    // Base (citation) consonant phonemes; the Dravidian plosive voicing allophony + two-level stress are applied
    // as a post-pass in tamil.ts (they are context-sensitive, not declarative).
    "language": "ta",
    "name": "Tamil",
    "script": ["Tamil"],
    "inherentVowel": "ɐ",
    "consonants": {
        "க": { "ipa": "k" },
        "ங": { "ipa": "ŋ" },
        "ச": { "ipa": "t͡ɕ" },
        "ஞ": { "ipa": "ɲ" },
        "ட": { "ipa": "ʈ" },
        "ண": { "ipa": "ɳ" },
        "த": { "ipa": "t̪" },
        "ந": { "ipa": "n̪" },
        "ப": { "ipa": "p" },
        "ம": { "ipa": "m" },
        "ய": { "ipa": "j" },
        "ர": { "ipa": "ɾ" },
        "ல": { "ipa": "l" },
        "வ": { "ipa": "ʋ" },
        "ழ": { "ipa": "ɻ" },
        "ள": { "ipa": "ɭ" },
        "ற": { "ipa": "r" },
        "ன": { "ipa": "n" },
        "ஜ": { "ipa": "d͡ʒ" },
        "ஷ": { "ipa": "ʂ" },
        "ஸ": { "ipa": "s" },
        "ஹ": { "ipa": "h" },
        "ஶ": { "ipa": "ɕ" },
    },
    "independentVowels": {
        "அ": { "ipa": "a" },
        "ஆ": { "ipa": "aː" },
        "இ": { "ipa": "ɪ" },
        "ஈ": { "ipa": "iː" },
        "உ": { "ipa": "ʊ" },
        "ஊ": { "ipa": "uː" },
        "எ": { "ipa": "e" },
        "ஏ": { "ipa": "eː" },
        "ஐ": { "ipa": "aᶦ" },
        "ஒ": { "ipa": "o" },
        "ஓ": { "ipa": "oː" },
        "ஔ": { "ipa": "aᶷ" },
    },
    "vowelSigns": {
        "ா": { "ipa": "aː" },
        "ி": { "ipa": "ɪ" },
        "ீ": { "ipa": "iː" },
        "ு": { "ipa": "ʊ" },
        "ூ": { "ipa": "uː" },
        "ெ": { "ipa": "e" },
        "ே": { "ipa": "eː" },
        "ை": { "ipa": "aᶦ" },
        "ொ": { "ipa": "o" },
        "ோ": { "ipa": "oː" },
        "ௌ": { "ipa": "aᶷ" },
    },
    // Tamil has only the pulli (virama) + aytham (ஃ, visarga-like → [h]). Anusvara / chandrabindu / nukta do not
    // occur in Tamil script; they are set to inert (non-Tamil) placeholder chars so the shared core never fires them.
    "signs": {
        "virama": { "char": "்" },
        "anusvara": { "char": "ं" },
        "chandrabindu": { "char": "ँ" },
        "visarga": { "char": "ஃ" },
        "nukta": { "char": "़" },
    },

    // Dravidian plosive voicing allophony (a post-pass over the abugida phoneme units). க/ட/த/ப voice; a
    // following stop is BLOCKED from voicing after a voiceless obstruent or ற (r); it voices after a nasal.
    "voicing": {
        "voice": { "k": "ɡ", "ʈ": "ɖ", "t̪": "d̪", "p": "b" },
        "nasals": ["m", "n", "n̪", "ɳ", "ŋ", "ɲ"],
        "voicelessBlock": ["k", "t͡ɕ", "ʈ", "t̪", "p", "s", "ʂ", "ɕ", "h", "r"],
    },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Cardinal number words (Indian grouping: ஆயிரம் 10³ / லட்சம் 10⁵ / கோடி 10⁷). Phonemized by the g2p.
    //
    // Tamil numerals are SANDHI-FUSED, not concatenated. Every multi-part numeral changes shape at
    // the joint, so a compositor with only `units`/`tens`/`hundred` produced readings no Tamil speaker
    // uses: 11 was *பத்து ஒன்று (பதினொன்று), 200 was *இரண்டு நூறு (இருநூறு), 1000 was *ஒன்று ஆயிரம்
    // (ஆயிரம்), and 1995 was *ஒன்று ஆயிரம் ஒன்பது நூறு தொண்ணூறு ஐந்து where Tamil says ஆயிரத்து
    // தொள்ளாயிரத்து தொண்ணூற்றி ஐந்து. Hence the four extra tables below: the irregular TEENS, and a
    // COMBINING (oblique) form of each ten / hundred / thousand used when a remainder follows it.
    "numbers": {
        "units": [
            "பூஜ்ஜியம்",
            "ஒன்று",
            "இரண்டு",
            "மூன்று",
            "நான்கு",
            "ஐந்து",
            "ஆறு",
            "ஏழு",
            "எட்டு",
            "ஒன்பது",
        ],
        "tens": [
            "",
            "பத்து",
            "இருபது",
            "முப்பது",
            "நாற்பது",
            "ஐம்பது",
            "அறுபது",
            "எழுபது",
            "எண்பது",
            "தொண்ணூறு",
        ],
        // 11–19. Suppletive: not பத்து + unit but a fused stem (பன்னிரண்டு, not *பத்து இரண்டு).
        "teens": [
            "பதினொன்று",
            "பன்னிரண்டு",
            "பதிமூன்று",
            "பதினான்கு",
            "பதினைந்து",
            "பதினாறு",
            "பதினேழு",
            "பதினெட்டு",
            "பத்தொன்பது",
        ],
        // Oblique form of each ten, used for 21–99 (இருபத்தி ஒன்று = 21). Index 0/1 unused: 1–9 are the
        // units and 11–19 are the suppletive teens above.
        "tensCombining": [
            "",
            "",
            "இருபத்தி",
            "முப்பத்தி",
            "நாற்பத்தி",
            "ஐம்பத்தி",
            "அறுபத்தி",
            "எழுபத்தி",
            "எண்பத்தி",
            "தொண்ணூற்றி",
        ],
        // Exact multiples of 100. Fused, and 900 is suppletive (தொள்ளாயிரம், lit. "nine-hundred" but
        // built on ஆயிரம்).
        "hundreds": [
            "",
            "நூறு",
            "இருநூறு",
            "முந்நூறு",
            "நானூறு",
            "ஐந்நூறு",
            "அறுநூறு",
            "எழுநூறு",
            "எண்ணூறு",
            "தொள்ளாயிரம்",
        ],
        // Oblique form of each hundred, used when a 1–99 remainder follows (நூற்றி ஒன்று = 101).
        "hundredsCombining": [
            "",
            "நூற்றி",
            "இருநூற்றி",
            "முந்நூற்றி",
            "நானூற்றி",
            "ஐந்நூற்றி",
            "அறுநூற்றி",
            "எழுநூற்றி",
            "எண்ணூற்றி",
            "தொள்ளாயிரத்து",
        ],
        // Exact multiples of 1000, index 1–10 (பத்தாயிரம் = 10,000 is fused too, so it is listed).
        "thousands": [
            "",
            "ஆயிரம்",
            "இரண்டாயிரம்",
            "மூவாயிரம்",
            "நான்காயிரம்",
            "ஐயாயிரம்",
            "ஆறாயிரம்",
            "ஏழாயிரம்",
            "எட்டாயிரம்",
            "ஒன்பதாயிரம்",
            "பத்தாயிரம்",
        ],
        // Oblique form of each thousand, used when a 1–999 remainder follows (ஆயிரத்து ஒன்று = 1001).
        "thousandsCombining": [
            "",
            "ஆயிரத்து",
            "இரண்டாயிரத்து",
            "மூவாயிரத்து",
            "நான்காயிரத்து",
            "ஐயாயிரத்து",
            "ஆறாயிரத்து",
            "ஏழாயிரத்து",
            "எட்டாயிரத்து",
            "ஒன்பதாயிரத்து",
            "பத்தாயிரத்து",
        ],
        "magnitudes": {
            "hundred": "நூறு",
            "thousand": "ஆயிரம்",
            "thousandCombining": "ஆயிரத்து",
            "lakh": "லட்சம்",
            "lakhCombining": "லட்சத்து",
            "crore": "கோடி",
            "croreCombining": "கோடியே",
            // The attributive "one" before a magnitude noun: ஒரு லட்சம், never *ஒன்று லட்சம்.
            "one": "ஒரு",
        },
    },

    // ⚠ WRITTEN FORMS FOR RECOGNITION, NOT A SPELLING MAP. These are the letter-name spellings as they
    // appear IN TEXT (யு.எஸ். = U.S., ஏ.டி. = A.D.), used to build the regex that finds a dot-separated
    // initialism run so its interior dots can be deleted. Nothing here is ever EMITTED as a reading — the
    // names pass through as the corpus's own spellings. That is why this is not `letterNames`, which in
    // every other language is character → spoken name.
    //
    // ⚠ A CLOSED LIST, and it has to be: a generic "short token, dot, short token" rule cannot be written
    // safely against a script with no case distinction. Probing one against the corpus matched SENTENCE
    // BOUNDARIES — "…ஆவர். கட்பேக்தான்", "…அல்ல. செங்குத்தாக". Restricting the members to actual letter
    // names is what makes the rule sound.
    "initialismLetterForms": [
        "ஏ", "பி", "சி", "டி", "இ", "எஃப்", "ஜி", "எச்", "ஐ", "ஜே", "கே", "எல்", "எம்", "என்", "ஓ", "க்யூ",
        "ஆர்", "எஸ்", "யு", "வி", "டபிள்யூ", "எக்ஸ்", "ஒய்", "இசட்", "நா"
    ],

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, one name fleet-wide — `symbols` is the BARE-SIGN → word map the tokenizer reads.
    "symbolTier": {
        // `multiply` — this language had NO word for the sign at all. ⚠ STANDARD MATHEMATICAL REGISTER, not a
        // corpus attestation: the sweep's plausible hits were homographs of PREPOSITIONS (es `por` ×23, it `per` ×25,
        // ru `на` ×31 are all the preposition), the same trap that defeated the exponent sourcing. One word, so `by`
        // defaults to it — this language does not split dimension from product.
        "multiply": { "times": "பெருக்கல்" },
        // `&` was DROPPED outright, so `B&Bs` lost the sign and read as two bare consonants. `மற்றும்`
        // is the ordinary conjunction, ×997 in the corpus, and the wiki examples put it in exactly this slot —
        // inside an institution name: `எண்ணெய் மற்றும் இயற்கை எரிவாயுக் கழகம்` (Oil and Natural Gas Corporation).
        // ⚠ `அண்ட்`, the transliterated English "and", was the adversarial candidate and is REJECTED on the
        // corpus: ×1 there against மற்றும்'s 997. It is common in the wiki (121 tokens) because that haystack is
        // full of transliterated company names, which is a fact about the haystack and not about how this
        // language reads an ampersand.
        // ⚠ THE STRONGEST EVIDENCE IS IN THE SENTENCE ITSELF: the corpus GLOSSES the abbreviation using this very
        // word — `B&Bs இரண்டு முக்கிய விஷயங்களில் போட்டியிடுகின்றன: படுக்கை மற்றும் காலை உணவு` ("bed AND
        // breakfast"). The text states what the sign expands to, in the same breath, with the conjunction chosen
        // here. Frequency counts are the weaker argument; this is the slot, glossed.
        "ampersand": "மற்றும்",
        "percent": ["சதவீதம்"],
        "currency": { "US$": ["டாலர்"], "$": ["டாலர்"] },
        "magnitudes": ["மில்லியன்", "பில்லியன்", "ட்ரில்லியன்", "லட்சம்", "கோடி"],
        "units": {
            "km": ["கிலோமீட்டர்"],
            "cm": ["சென்டிமீட்டர்"],
            "mm": ["மில்லிமீட்டர்"],
            "kg": ["கிலோகிராம்"],
            "mi": ["மைல்"],
            "m": ["மீட்டர்"],
        },
        "exponentWords": { "squared": ["சதுர"], "cubed": ["கன"], "position": "before" }
    },

    // ⚠ ORDER IS LOAD-BEARING: LONGEST FIRST. These are matched by prefix against the text after the
    // numeral, so a shorter suffix listed first shadows a longer one that contains it. A JSON array
    // preserves order; an object or a set would not, which is why this stays a list.
    // Ordinal suffixes: ஆவது / வது take -ஆவது, ஆம் / ம் take -ஆம்.
    "ordinalSuffixes": ["ஆவது", "ஆம்", "வது", "ம்"]
}
