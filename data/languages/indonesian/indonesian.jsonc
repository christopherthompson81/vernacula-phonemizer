// Native canonical-IPA definition for Indonesian (id) — a shallow, near-phonemic Latin orthography. The g2p
// (indonesian.ts) reads this file: digraphs first (ng→ŋ, ny→ɲ, sy→ʃ, kh→x, gh→ɣ), then single letters, with
// ⟨e⟩ defaulting to schwa [ə] (the pepet — the one real ambiguity; loanword [e]/[ɛ] is a lexical tail), the
// closed-syllable lax allophones (i→ɪ, u→ʊ, e→ɛ, o→ɔ), diphthongs ai/au/oi, and final ⟨k⟩ → glottal stop [ʔ].
{
    "language": "id",
    "name": "Indonesian",
    "script": ["Latin"],
    "provenance": "Authored from standard Indonesian (Bahasa Indonesia) orthography + phonology. This file IS the language data — the g2p reads it directly.",

    // Multi-letter graphemes (longest-first) → IPA.
    "digraphs": {
        "ng": "ŋ", "ny": "ɲ", "sy": "ʃ", "kh": "x", "gh": "ɣ"
    },

    // Single consonant letters → IPA.
    "consonants": {
        "b": "b", "c": "t͡ʃ", "d": "d", "f": "f", "g": "ɡ", "h": "h",
        "j": "d͡ʒ", "k": "k", "l": "l", "m": "m", "n": "n", "p": "p",
        "q": "k", "r": "r", "s": "s", "t": "t", "v": "v", "w": "w",
        "x": "ks", "y": "j", "z": "z"
    },

    // Vowel letters → their DEFAULT (open-syllable, tense) IPA. ⟨e⟩ → schwa by default.
    "vowels": { "a": "a", "e": "ə", "i": "i", "o": "o", "u": "u" },

    // Closed-syllable LAX allophones (a vowel with a following coda consonant in the same syllable).
    "laxVowels": { "i": "ɪ", "u": "ʊ", "e": "ɛ", "o": "ɔ" },

    // Falling diphthongs (word-final vowel sequences).
    "diphthongs": { "ai": "ai", "au": "au", "oi": "oi" },

    // Letter NAMES (for all-caps acronyms spelled out letter-by-letter: BBM → be-be-em → bebeem).
    "letterNames": {
        "a": "a", "b": "be", "c": "t͡ʃe", "d": "de", "e": "e", "f": "ɛf",
        "g": "ɡe", "h": "ha", "i": "i", "j": "d͡ʒe", "k": "ka", "l": "ɛl",
        "m": "ɛm", "n": "ɛn", "o": "o", "p": "pe", "q": "ki", "r": "ɛr",
        "s": "ɛs", "t": "te", "u": "u", "v": "fe", "w": "we", "x": "ɛks",
        "y": "je", "z": "zɛt"
    },

    "clausePunctuation": {
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Indonesian spellings; canonical IPA DERIVED by running them through the same g2p. Indonesian
    // numbers are regular and compositional (belas teens, puluh tens, ratus/ribu/juta), unlike the Indic irregulars.
    "numbers": {
        "units": ["nol", "satu", "dua", "tiga", "empat", "lima", "enam", "tujuh", "delapan", "sembilan"],
        "belas": "belas", "puluh": "puluh", "ratus": "ratus", "ribu": "ribu", "juta": "juta", "seprefix": "se",
        // Indonesian reads the decimal comma as "koma"; without it "1,5" ran the two numbers together.
        "decimalWord": "koma"
    },

    "phonotactics": {
        "vowels": "aeiou",
        "onsets": [
            "b", "c", "d", "f", "g", "h", "j", "k", "l", "m", "n", "p", "q", "r", "s", "t", "v", "w", "y",
            "z", "ng", "ny", "sy", "kh", "bl", "br", "dr", "fl", "fr", "gl", "gr", "kl", "kr", "pl", "pr",
            "sl", "sp", "st", "sk", "tr", "sw", "ps", "kw"
        ],
        "codas": [
            "b", "d", "f", "h", "k", "l", "m", "n", "ng", "p", "r", "s", "t", "kh"
        ],
        "digraphs": [
            "ng", "ny", "sy", "kh"
        ]
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    // ⚠ NAMED `symbolTier`, one name fleet-wide — `symbols` is the BARE-SIGN → word map the tokenizer reads.
    "symbolTier": {
        // ⚠ `multiply` IS STANDARD MATHEMATICAL REGISTER, not a corpus attestation: a corpus sweep for the operator
        // returns homographs of PREPOSITIONS in every language tried. One word, so `by` defaults to it — this
        // language does not split dimension from product.
        "multiply": { "times": "kali" },
        // Unread, `&` is DROPPED outright and `B&B` loses the sign entirely.
        // `dan` ×1053 in this corpus. The tier spaces it on both sides, because `B&B` is two
        // initialisms and joining them would make one token.
        "ampersand": "dan",
        "percent": ["persen"],
        "currency": { "$": ["dolar"], "€": ["euro"], "£": ["pound"], "¥": ["yen"] },
        // REQUIRED BY THE `US$` FOLD, and found only because the fold exposed it. Unfolding `US$ 14,7
        // miliar` let the tier place the currency noun at last, and it placed it in the WRONG SLOT:
        // *empat belas koma tujuh DOLAR MILIAR*, because without this list the magnitude is not part of the
        // quantity and the noun lands directly after the digits. Indonesian puts the noun after the magnitude —
        // *14,7 miliar dolar*. So the fold turned a silent DROP into an audible word-order error, which is a
        // reminder that closing a drop is not finished until the reading is checked, not just the differential.
        //
        // NO `magnitudeConnective`: Indonesian juxtaposes (*miliar dolar*, not *miliar de dolar*), unlike
        // Catalan's *de* or Italian's *di*. Attested in this corpus as `juta` ×8, `miliar` and `ribu`.
        "magnitudes": ["triliun", "miliar", "juta", "ribu"],
        "units": { "km": ["kilometer"], "cm": ["sentimeter"], "mm": ["milimeter"], "kg": ["kilogram"], "m": ["meter"],
            "g": ["gram"], // ⚠ ⟨L⟩ AND ⟨l⟩ ARE BOTH OFFICIAL for the litre (⟨L⟩ is the dominant printed form), so BOTH are
            // declared — the one exception to the one-letter case rule in core/normalizeSymbols.ts, which
            // exists for symbols whose two cases are DIFFERENT units. Here they are the same unit.
            "l": ["liter"], "L": ["liter"], "ha": ["hektar"] },
        // `kilometer persegi` ×3 — the modifier follows. Bare `persegi` ×9 includes the SHAPE ("persegi yang
        // tidak memiliki sisi bawahnya"), so the collocation is what attests the unit sense. `kubik` ×0, so
        // `m³` keeps the fallback.
        "exponentWords": { "squared": ["persegi"], "position": "after" }
    }
}
