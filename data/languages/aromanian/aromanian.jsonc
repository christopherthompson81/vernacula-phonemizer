// Native canonical-IPA data manifest for Aromanian (rup) — armãneashti, an EASTERN ROMANCE (Balkan
// Romance) language, a close sibling of Romanian, spoken across the Balkans (Greece, Albania, North
// Macedonia, Romania, Bulgaria; ~250k). A near-phonemic Latin orthography (the Cunia/DIARO system) — the
// engine (aromanian.ts) is a greedy left-to-right scan with the shared Romance contextual phonology plus
// Aromanian's own digraphs.
//   ⚠ AROMANIAN DIGRAPHS (not in Romanian, which uses diacritic letters): ⟨ts⟩→[t͡s], ⟨dz⟩→[d͡z] (but [d͡ʒ]
//     in the ⟨ndz⟩+front-vowel soft-g reflex: sãndze→[sənd͡ʒe]), ⟨sh⟩→[ʃ], ⟨nj⟩→[ɲ], ⟨lj⟩/⟨ll⟩→[ʎ]
//     (palatals), ⟨dh⟩→[ð], ⟨th⟩→[θ] (the Greek-contact interdentals), ⟨gh⟩→[ɡ], ⟨ch⟩→[k]; ⟨y⟩ (Greek
//     gamma)→[ɣ], NOT the glide [j].
//   ⚠ ⟨ã⟩ is the single central-vowel letter → [ə] (also realised [ɨ]; the two are not distinguished in
//     the orthography — folded). The shared Romance rules: ⟨c/g⟩ SOFTEN before ⟨e i⟩ (⟨ce ci⟩→t͡ʃ,
//     ⟨ge gi⟩→d͡ʒ, silent softener i); RISING DIPHTHONGS ⟨ea⟩→[e̯a], ⟨oa⟩→[o̯a]; the ⟨i u⟩ GLIDES
//     ([j w] next to another vowel). ⟨r⟩→[r].
// The softening/diphthong/glide/final-⟨-u⟩ rules are code, in aromanian.ts; the grapheme values live here.
// Stress is unwritten (deferred, not emitted); the word-final desyllabified ⟨-u⟩ ([ʷ]/[ŭ]) is emitted as [u].
// Referee: wikipron rup_latn narrow (196) + kaikki Aromanian (201).
{
    "language": "rup",
    "name": "Aromanian (armãneashti)",
    "script": ["Latin"],

    // Digraphs, longest-first (2 letters). ⟨ch gh⟩ are the HARD dorsals — ⟨gh⟩→[ɡ] (matches 2/3 referee vs
    // [ɣ] 1/3; the ɣ~ɡ fold covers it); ⟨ll⟩ = ⟨lj⟩ = [ʎ]. ⟨dz⟩ is handled specially in aromanian.ts (the
    // ⟨ndz⟩+front-vowel soft-g reflex → [ndʒ], else [d͡z]).
    "digraphs": [
        ["ts", "t͡s"], ["sh", "ʃ"], ["nj", "ɲ"], ["lj", "ʎ"], ["ll", "ʎ"],
        ["dh", "ð"], ["th", "θ"], ["gh", "ɡ"], ["ch", "k"],
    ],

    // The VOWEL LETTERS — the environment for the two code rules in aromanian.ts: the SILENT softener ⟨i⟩ in
    // ⟨ci gi⟩ + vowel, and the on/offglide test that turns a non-high vowel letter into part of a diphthong.
    // ⟨â î⟩ are absent deliberately: they are the same [ɨ] and never take part in either rule.
    "vowelLetters": ["a", "e", "i", "o", "u", "ã"],

    // Single letters. ⟨y⟩ = the Greek-gamma letter → [ɣ] (anyedz→anɣed͡z), NOT the glide [j].
    "letters": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u", "ã": "ə", "â": "ɨ", "î": "ɨ",
        "b": "b", "d": "d", "f": "f", "h": "h", "j": "ʒ", "k": "k", "l": "l", "m": "m", "n": "n",
        "p": "p", "q": "k", "r": "r", "s": "s", "t": "t", "v": "v", "w": "w", "x": "ks", "y": "ɣ", "z": "z",
        "ñ": "ɲ", "ç": "t͡s",
    },
}
