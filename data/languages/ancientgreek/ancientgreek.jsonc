// Native canonical-IPA data manifest for Ancient Greek (grc) — Ἑλληνική, the POLYTONIC Greek script,
// targeting the reconstructed 5th-century BCE CLASSICAL ATTIC pronunciation (Allen, *Vox Graeca*). The
// classical Hellenic counterpart to the Classical-Latin bring-up. The engine (ancientgreek.ts) is a
// grapheme scan over the NFD-decomposed polytonic text:
//   ⚠ Vowels α ε η ι ο υ ω → [a e ɛː i o y ɔː] (η/ω are LONG mid; υ is the front-rounded [y]); the MACRON
//     marks length on α ι υ (ᾱ→aː). DIPHTHONGS: αι→[ai̯], ει→[eː], οι→[oi̯], αυ→[au̯], ευ→[eu̯],
//     ου→[uː], ηυ→[ɛːu̯], ωυ→[ɔːu̯]; the IOTA SUBSCRIPT (ᾳ ῃ ῳ) → long vowel + [i̯]; a DIAERESIS breaks a
//     diphthong. ⚠ ⟨υι⟩ IS THE MONOPHTHONG [yː] IN THE TABLE BELOW, not [yi̯]: it had monophthongized by the
//     classical period, and this header used to claim [yi̯] against its own data. υἱός → hyːós.
//   ⚠ Consonants: the ASPIRATES θ φ χ → [tʰ pʰ kʰ], β γ δ → [b ɡ d], ζ→[zd], ξ→[ks], ψ→[ps]; γ before a
//     velar (γ κ χ ξ) → [ŋ] (ἄγγελος→áŋɡelos); ρ/σ/etc. direct.
//   ⚠ ROUGH BREATHING (dasia ῾) on a word-initial vowel → a prefixed [h] (ἵππος→híppos); SMOOTH → ∅.
//   ⚠ PITCH ACCENT (acute/grave/circumflex) is emitted on the vowel and folded by the eval (the Latin
//     treatment).
// The context rules (γ-agma, σ-voicing, voiceless ρ, aspirate assimilation, the combining-mark grammar)
// are code, in ancientgreek.ts; the letter values live here.
// Referee: wikipron grc_grek (human, {{grc-IPA}} 5th-BCE Attic row).
{
    "language": "grc",
    "name": "Ancient Greek (Ἑλληνική)",
    "script": ["Greek"],

    // Base vowel letter → [short, long] IPA. η ω are inherently long; α ι υ take length from the
    // macron/subscript.
    "vowels": {
        "α": ["a", "aː"], "ε": ["e", "e"], "η": ["ɛː", "ɛː"], "ι": ["i", "iː"], "ο": ["o", "o"],
        "υ": ["y", "yː"], "ω": ["ɔː", "ɔː"],
    },

    // The VOICED consonants that assimilate a preceding ⟨σ⟩ to [z] — Λέσβια → lézbia, Σμύρνα → zmýrna, the
    // standard sibilant assimilation. Both shapes of sigma trigger it, so ancientgreek.ts tests ⟨σ⟩ and the
    // final ⟨ς⟩ against this one list.
    "voicedAfterSigma": ["β", "γ", "δ", "μ", "ν", "λ", "ρ"],

    // The VELAR phones before which ⟨γ⟩ is the nasal [ŋ] — the ⟨γγ γκ γχ γξ⟩ spelling of a velar nasal.
    // ⟨ks⟩ is here because ⟨ξ⟩ scans to a two-phone value whose head is the velar.
    "velars": ["ɡ", "k", "kʰ", "ks"],

    // Base consonant letter → IPA (γ is context-sensitive; handled in the scan).
    "consonants": {
        "β": "b", "δ": "d", "ζ": "zd", "θ": "tʰ", "κ": "k", "λ": "l", "μ": "m", "ν": "n", "ξ": "ks", "π": "p",
        "ρ": "r", "σ": "s", "ς": "s", "τ": "t", "φ": "pʰ", "χ": "kʰ", "ψ": "ps", "ϝ": "w",
    },

    // Diphthong: a base vowel + an offglide ⟨ι⟩/⟨υ⟩ → the diphthong IPA (unless the offglide has a
    // diaeresis).
    "diphthongs": {
        "αι": "ai̯", "αυ": "au̯", "ει": "eː", "ευ": "eu̯", "οι": "oi̯", "ου": "uː", "υι": "yː",
        "ηυ": "ɛːu̯", "ωυ": "ɔːu̯", "ηι": "ɛːi̯", "ωι": "ɔːi̯",
    },
}
