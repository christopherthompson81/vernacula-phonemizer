// Native canonical-IPA MANIFEST for French (fr) — standard / Parisian, broad IPA. A self-describing description
// of the language's DATA, matching english.jsonc / arabic.jsonc: the vowel-letter inventory, the oral/nasal
// vowel-multigraph tables, the yod (mouillé) groups, the sounded-final-consonant set, clause punctuation, the
// liaison + h-aspiré lists, and the cardinal number words. The ALGORITHMS (the left-to-right scan, open/closed
// syllable eu/o rules, schwa deletion, liaison re-syllabification, vigesimal number composition) stay in code
// and read these tables; only the closed, hand-curatable data lives here.
//
// LOAD-BEARING blocks (read via manifest.ts): "vowelLetters", "vowelPhonemes", "vowelGroups", "nasalGroups",
// "finalSounded", "yodDouble", "yodFinal", "clausePunctuation", "liaison", "hAspire", "numbers".
// "convention" / "provenance" are self-describing documentation.
{
    "language": "fr",
    "script": ["Latin"],
    "name": "French (standard / Parisian)",
    "provenance": "Cleanroom, rule-based g2p (French orthography is deep but rule-governed in the reading direction) + an exception lexicon (lexicon.tsv) + a vigesimal number compositor. WHICH words are h-aspiré / take liaison, and the number words, are language facts.",

    // The canonical-IPA conventions the values below are written in (documentation).
    "convention": {
        "vowels": "ø/œ (peu/peur), nasals ɛ̃ ɑ̃ ɔ̃ œ̃, schwa ə",
        "glides": "ɥ (huit), j (yod / mouillé -ill-), w (oi→wa)",
        "rhotic": "uvular ʁ; palatal nasal ɲ (gn)",
        "openClosed": "eu→ø open / œ closed; o→o open / ɔ closed (Lexique syllable-closure convention)",
        "liaison": "obligatory liaison consonant re-syllabifies as the next word's onset; h-aspiré blocks it",
        "numbers": "vigesimal 70/80/90 (soixante-dix, quatre-vingts); words space-separated so each reads through the g2p",
    },

    // Vowel LETTERS (orthographic) and vowel PHONEME starts (IPA — for schwa-deletion consonant counting / nuclei).
    "vowelLetters": "aeiouyàâäéèêëîïôöùûüœæ",
    "vowelPhonemes": "aeiouyɛɔøœəɑ",

    // Oral vowel multigraphs → IPA, matched in ORDER (a longest-match scan; nasal groups are separate). [ortho, ipa].
    "vowelGroups": [
        ["eau", "o"],
        ["eaux", "o"],
        ["ou", "u"],
        ["au", "o"],
        ["où", "u"],
        ["oû", "u"],
        ["oi", "wa"],
        ["oy", "waj"],
        ["ei", "ɛ"],
        ["ay", "ɛj"],
        ["ey", "ɛj"],
        ["é", "e"],
        ["è", "ɛ"],
        ["ê", "ɛ"],
        ["ë", "ɛ"],
        ["â", "a"],
        ["à", "a"],
        ["ù", "y"],
        ["û", "y"],
        ["î", "i"],
        ["ï", "i"],
        ["ô", "o"],
        ["ö", "o"],
        ["ü", "y"],
    ],

    // Nasal vowel groups (vowel + n/m) → IPA. Applied when NOT followed by a vowel and NOT doubled (année/bonne = oral).
    "nasalGroups": [
        ["ain", "ɛ̃"],
        ["aim", "ɛ̃"],
        ["ein", "ɛ̃"],
        ["eim", "ɛ̃"],
        ["oin", "wɛ̃"],
        ["ien", "jɛ̃"],
        ["ion", "jɔ̃"],
        ["yn", "ɛ̃"],
        ["ym", "ɛ̃"],
        ["an", "ɑ̃"],
        ["am", "ɑ̃"],
        ["en", "ɑ̃"],
        ["em", "ɑ̃"],
        ["in", "ɛ̃"],
        ["im", "ɛ̃"],
        ["on", "ɔ̃"],
        ["om", "ɔ̃"],
        ["un", "œ̃"],
        ["um", "œ̃"],
    ],

    // Final consonants normally PRONOUNCED (c r f l q k); others are silent word-finally (-er/-ez/-et are special-cased).
    "finalSounded": ["c", "r", "f", "l", "q", "k"],

    // vowel + ill/il → yod (mouillé glide): double-l anywhere, single-l only word-finally. Matched longest-first.
    "yodDouble": [
        ["ouill", "uj"],
        ["euill", "œj"],
        ["aill", "aj"],
        ["eill", "ɛj"],
        ["ueill", "œj"],
        ["uill", "ɥij"],
    ],
    "yodFinal": [
        ["ouil", "uj"],
        ["euil", "œj"],
        ["ail", "aj"],
        ["eil", "ɛj"],
        ["ueil", "œj"],
    ],

    // Clause / phrase punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Obligatory liaison: a normally-silent final consonant of a function word / number, pronounced as the onset
    // of a following vowel-initial word. z (plural determiners/pronouns, -x/-s numbers), n (nasal monosyllables),
    // t (est/sont/tout/petit…; grand/quand d→t). Attached to the next word (re-syllabified in code).
    "liaison": {
        "les": "z",
        "des": "z",
        "ces": "z",
        "mes": "z",
        "tes": "z",
        "ses": "z",
        "nos": "z",
        "vos": "z",
        "leurs": "z",
        "aux": "z",
        "ils": "z",
        "elles": "z",
        "nous": "z",
        "vous": "z",
        "dans": "z",
        "chez": "z",
        "sans": "z",
        "très": "z",
        "plus": "z",
        "moins": "z",
        "deux": "z",
        "trois": "z",
        "six": "z",
        "dix": "z",
        "un": "n",
        "mon": "n",
        "ton": "n",
        "son": "n",
        "en": "n",
        "on": "n",
        "aucun": "n",
        "bien": "n",
        "rien": "n",
        "commun": "n",
        "est": "t",
        "sont": "t",
        "ont": "t",
        "font": "t",
        "vont": "t",
        "tout": "t",
        "quand": "t",
        "grand": "t",
        "petit": "t",
        "dont": "t",
        "cet": "t",
        "c'est": "t",
        "c’est": "t",
        "n'est": "t",
        "n’est": "t",
    },

    // h aspiré (+ vowel-initial words that block liaison, e.g. huit/onze/y-): looks vowel-initial but forbids
    // liaison — les héros → le eʁo, not le zeʁo.
    // HETERONYMS — one spelling, two pronunciations, disambiguated by NEIGHBOURING WORDS. French has no
    // POS tagger (frenchTagger.ts is the OOV g2p reader, not a POS model), and Lexique carries exactly one
    // reading per spelling, so the alternate reading has to be supplied here with the context that selects
    // it. `default` is Lexique's reading; each case's `ipa` wins when its `prev`/`next` matches.
    //
    // Two classes carry most of it:
    //  1. The 3rd-person-plural -ENT ending is SILENT, so every -ent noun/adjective is a homograph of a
    //     verb: content [kɔ̃tɑ̃] vs "ils content" [kɔ̃t]. The verb reading is systematically Lexique's minus
    //     the final ɑ̃. Gated on ils/elles ONLY — deliberately high precision over recall, since reading
    //     "le président" as a verb would be far worse than missing "les enfants content".
    //  2. A latent FINAL CONSONANT that one reading sounds and the other does not: plus, tous, os, as,
    //     sens, vis. Here the selecting context is a determiner or a subject pronoun.
    // Not attempted: `fils` ([fis] son / [fil] threads) is genuinely ambiguous after "les"; `est` is
    // unreachable because the tokenizer keeps "l'est" as one token.
    "heteronyms": {
        "plus": { "default": "ply", "cases": [{ "ipa": "plys", "nextIsNumber": true }] },
        "tous": { "default": "tus", "cases": [{ "ipa": "tu", "next": ["les", "ces", "mes", "tes", "ses", "nos", "vos", "leurs"] }] },
        "os": { "default": "ɔs", "cases": [{ "ipa": "o", "prev": ["les", "des", "aux", "ces", "mes", "tes", "ses", "nos", "vos", "leurs", "quelques", "plusieurs"] }] },
        "as": { "default": "a", "cases": [{ "ipa": "ɑs", "prev": ["un", "cet", "ce", "le", "son", "mon"] }] },
        "sens": { "default": "sɑ̃", "cases": [{ "ipa": "sɑ̃s", "prev": ["le", "du", "un", "ce", "dans", "au", "mon", "son", "bon", "dernier", "premier", "double"] }] },
        "vis": { "default": "vi", "cases": [{ "ipa": "vis", "prev": ["une", "la", "cette", "des", "les", "deux", "trois", "quatre"] }] },
        "portions": { "default": "pɔʁsjɔ̃", "cases": [{ "ipa": "pɔʁtjɔ̃", "prev": ["nous"] }] },
        "ferment": { "default": "fɛʁm", "cases": [{ "ipa": "fɛʁmɑ̃", "prev": ["le", "du", "un", "ce", "son"] }] },
        "affluent": { "default": "afly", "cases": [{ "ipa": "aflyɑ̃", "prev": ["un", "le", "ce", "son", "grand", "petit"] }] },
        // The -ENT class below is GENERATED — `npx tsx tools/french/heteronym-candidates.ts` — not hand-listed.
        // The verb reading is taken from Lexique's 3sg entry (stem+"e"), which IS a verb form, rather than
        // by stripping the nasal off the noun: where the two disagree Lexique is internally inconsistent
        // and the 3sg wins. That cross-check caught a hand-written error here — `excellent` had [eksɛl],
        // copying the noun's first vowel, where Lexique's own `excelle` is [ɛksɛl].
        // `pressent` is a real double: "ils pressent" (they press) [pʁɛs] vs "il pressent" (he senses,
        // from pressentir) [pʁesɑ̃] — the ils/il number contrast is exactly what the rule keys on.
        "ardent": { "default": "aʁdɑ̃", "cases": [{ "ipa": "aʁd", "prev": ["ils", "elles"] }] },
        "confluent": { "default": "kɔ̃flyɑ̃", "cases": [{ "ipa": "kɔ̃fly", "prev": ["ils", "elles"] }] },
        "content": { "default": "kɔ̃tɑ̃", "cases": [{ "ipa": "kɔ̃t", "prev": ["ils", "elles"] }] },
        "couvent": { "default": "kuvɑ̃", "cases": [{ "ipa": "kuv", "prev": ["ils", "elles"] }] },
        "excellent": { "default": "eksɛlɑ̃", "cases": [{ "ipa": "ɛksɛl", "prev": ["ils", "elles"] }] },
        "influent": { "default": "ɛ̃flyɑ̃", "cases": [{ "ipa": "ɛ̃fly", "prev": ["ils", "elles"] }] },
        "négligent": { "default": "neɡliʒɑ̃", "cases": [{ "ipa": "neɡliʒ", "prev": ["ils", "elles"] }] },
        "parent": { "default": "paʁɑ̃", "cases": [{ "ipa": "paʁ", "prev": ["ils", "elles"] }] },
        "pressent": { "default": "pʁesɑ̃", "cases": [{ "ipa": "pʁɛs", "prev": ["ils", "elles"] }] },
        "président": { "default": "pʁezidɑ̃", "cases": [{ "ipa": "pʁezid", "prev": ["ils", "elles"] }] },
        "résident": { "default": "ʁezidɑ̃", "cases": [{ "ipa": "ʁezid", "prev": ["ils", "elles"] }] },
        "somnolent": { "default": "sɔmnɔlɑ̃", "cases": [{ "ipa": "sɔmnɔl", "prev": ["ils", "elles"] }] },
        "talent": { "default": "talɑ̃", "cases": [{ "ipa": "tal", "prev": ["ils", "elles"] }] },
        "violent": { "default": "vjɔlɑ̃", "cases": [{ "ipa": "vjɔl", "prev": ["ils", "elles"] }] },
        "évident": { "default": "evidɑ̃", "cases": [{ "ipa": "evid", "prev": ["ils", "elles"] }] },
    },

    // ACRONYMS read letter-by-letter although their lowercase form is an attested French word, so Lexique
    // cannot express the distinction ("usa" is in it as the passé simple of *user*). A LEXICAL fact.
    // Also listed here: the acronyms attested in the corpus whose reading is letters rather than a word —
    // the OOV rule can only catch the ones that are UNPRONOUNCEABLE (SNCF, TGV, PDG), and these are
    // perfectly pronounceable, so nothing but recorded knowledge can decide them.
    "acronymLetters": [
        "usa", "ong", "pib", "rer", "vtt", "jo", "cd", "dvd", "aol", "cio", "oha", "tda", "acma",
        "irm", "adn", "gps", "utc", "pbs", "nba", "gp", "cnrs", "hjr", "ratp", "edf", "tva", "sncb",
    ],

    "hAspire": [
        "hache",
        "haie",
        "haillon",
        "haine",
        "haïr",
        "hall",
        "halle",
        "halte",
        "hamac",
        "hameau",
        "hamburger",
        "hamster",
        "hanche",
        "handicap",
        "handicapé",
        "hangar",
        "hanter",
        "harceler",
        "hardi",
        "hareng",
        "hargne",
        "haricot",
        "harpe",
        "hasard",
        "hâte",
        "hausse",
        "haut",
        "hautain",
        "hauteur",
        "havre",
        "hennir",
        "hérault",
        "hérisson",
        "hérissé",
        "hernie",
        "héron",
        "héros",
        "hêtre",
        "heurter",
        "hibou",
        "hiboux",
        "hiérarchie",
        "homard",
        "hongrie",
        "hongrois",
        "honte",
        "hoquet",
        "horde",
        "hors",
        "hotte",
        "houle",
        "hublot",
        "huer",
        "huit",
        "huitième",
        "hurler",
        "hutte",
        "hollande",
        "hollandais",
        "onze",
        "onzième",
        "yaourt",
        "yacht",
        "yoga",
        "oui",
        "ouistiti",
        "uhlan",
    ],

    // Cardinal number words (vigesimal 70/80/90). Composition logic is in numbers.ts.
    "numbers": {
        "small": [
            "zéro",
            "un",
            "deux",
            "trois",
            "quatre",
            "cinq",
            "six",
            "sept",
            "huit",
            "neuf",
            "dix",
            "onze",
            "douze",
            "treize",
            "quatorze",
            "quinze",
            "seize",
            "dix-sept",
            "dix-huit",
            "dix-neuf",
        ],
        "tens": ["", "", "vingt", "trente", "quarante", "cinquante"],
        "magnitudes": {
            "sixty": "soixante",
            "eighty": "quatre-vingt",
            "hundred": "cent",
            "thousand": "mille",
            "million": "million",
            "millions": "millions",
        },
        "decimalSeparator": "virgule",
    },

    "letterNames": {
        "a": "a", "b": "bé", "c": "cé", "d": "dé", "e": "e", "f": "effe", "g": "gé", "h": "ache", "i": "i",
        "j": "ji", "k": "ka", "l": "elle", "m": "emme", "n": "enne", "o": "o", "p": "pé", "q": "ku",
        "r": "erre", "s": "esse", "t": "té", "u": "u", "v": "vé", "w": "double vé", "x": "ixe",
        "y": "i grec", "z": "zède"
    },
    "phonotactics": {
        "vowels": "aeiouyàâäéèêëîïôöûüùœæ",
        "onsets": [
            "bl", "br", "cl", "cr", "dr", "fl", "fr", "gl", "gr", "pl", "pr", "tr", "vr", "kl", "kr", "ch",
            "ph", "th", "gn", "qu", "sc", "sp", "st", "ps", "pn", "pt", "sm", "sn", "gu", "rh", "ct"
        ],
        "codas": [
            "bl", "br", "cl", "cr", "dr", "fl", "fr", "gl", "gr", "pl", "pr", "tr", "vr", "ch", "gn", "st",
            "sc", "sk", "sp", "ct", "pt", "ft", "xt", "ss", "tt", "ll", "mm", "nn", "pp", "rr", "ff", "rt",
            "rd", "rs", "rc", "rl", "rm", "rn", "rp", "rb", "rg", "rf", "rv", "rq", "lt", "ld", "ls", "lc",
            "lm", "lp", "lb", "lf", "lk", "lv", "nt", "nd", "ns", "nc", "nk", "ng", "mp", "mb", "cs", "ks",
            "ts", "ps", "bs", "ds", "gs", "fs", "ms"
        ]
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbols": {
        // ⚠ THE AMPERSAND IS A LATIN-SCRIPT PRINTING LIGATURE, so what it takes is a READING and not a
        // translation. For a language written in Latin script that is its own conjunction; for one that is not,
        // the symbol only ever arrives inside a Latin run. Either way the tier substitutes the conjunction, SPACED —
        // see the tier, where the spacing exists because `B&B` is two initialisms.
        "ampersand": "et",
        // `multiply` — this language DROPPED the sign outright. ⚠ STANDARD MATHEMATICAL REGISTER, not a corpus
        // attestation: the sweep failed exactly as the exponent sweep did, because the plausible hits are homographs
        // of PREPOSITIONS — es `por` ×23, it `per` ×25, ru `на` ×31 are all the preposition, never the operator.
        // One word, so `by` defaults to it; this language does not split dimension from product.
        "multiply": { "times": "fois" },
        "percent": ["pour cent"],
        "currency": { "€": ["euro", "euros"], "$": ["dollar", "dollars"], "£": ["livre", "livres"], "¥": ["yen", "yens"] },
        // Longest keys match first (the builder sorts by length), so km/h beats km and °c beats c.
        "units": { "km": ["kilomètre", "kilomètres"], "cm": ["centimètre", "centimètres"], "mm": ["millimètre", "millimètres"],
            "kg": ["kilogramme", "kilogrammes"], "mg": ["milligramme", "milligrammes"], "g": ["gramme", "grammes"],
            "t": ["tonne", "tonnes"], "m": ["mètre", "mètres"], // ⚠ ⟨L⟩ AND ⟨l⟩ ARE BOTH OFFICIAL for the litre (⟨L⟩ is the dominant printed form), so BOTH are
            // declared — the one exception to the one-letter case rule in core/normalizeSymbols.ts, which
            // exists for symbols whose two cases are DIFFERENT units. Here they are the same unit.
            "l": ["litre", "litres"], "L": ["litre", "litres"], "ml": ["millilitre", "millilitres"],
            "cl": ["centilitre", "centilitres"], "dl": ["décilitre", "décilitres"], "ha": ["hectare", "hectares"],
            "km/h": ["kilomètre par heure", "kilomètres par heure"], "m/s": ["mètre par seconde", "mètres par seconde"],
            "°c": ["degré Celsius", "degrés Celsius"], "°f": ["degré Fahrenheit", "degrés Fahrenheit"],
            // ⚠ ⟨W⟩ capital (named after Watt) — a one-letter symbol resolves case-SENSITIVELY since #763. The
            // multi-letter kw/hz/khz/mhz still fold, so their sloppy spellings keep reading.
            "kw": ["kilowatt", "kilowatts"], "W": ["watt", "watts"], "hz": ["hertz"], "khz": ["kilohertz"], "mhz": ["mégahertz"],
            "go": ["gigaoctet", "gigaoctets"], "mo": ["mégaoctet", "mégaoctets"], "ko": ["kilooctet", "kilooctets"],
            "min": ["minute", "minutes"] },
        // `kilomètres carrés` ×9 and `mètres cubes` ×2. The adjective agrees, so both numbers are listed; only
        // the PLURAL is corpus-attested (no `1 km²` occurs) and the singular is regular agreement, stated here
        // rather than left to look like an attested form.
        // ⚠ Bare `carré` ×2 is the SHAPE ("un carré dont le côté inférieur est manquant") — the collocation
        // with the unit noun is the attestation, never the bare word.
        "exponentWords": { "squared": ["carré", "carrés"], "cubed": ["cube", "cubes"], "position": "after" },
        // BARE EXPONENT — the reading for a power with NO unit to modify (`20²`, `mc²`), which every language
        // in the fleet was dropping silently. See `bareExponent` in core/normalizeSymbols.ts for why this cannot
        // reuse `exponentWords` above: that is the unit MODIFIER and this is the PREDICATE, and in most languages
        // they are different words (kilomètres carrés but vingt au carré).
        // ⚠ PROVENANCE, stated because it is weaker than most data in this repo: these are STANDARD MATHEMATICAL
        // REGISTER, not corpus attestations. The power words are ×0 in this language's artifact, and the apparent
        // hits for other languages were substring traps of exactly the kind tools/normalization/attest.ts warns
        // about — th `กำลัง` matched the progressive-aspect marker, fa `توان` and ar `أس` matched inside unrelated
        // words. FLEURS is news and encyclopedia prose and simply does not contain spoken arithmetic.
        // The cardinal is used for the generic power, never the ordinal — see core for that argument.
        "bareExponent": { "squared": "{n} au carré", "cubed": "{n} au cube", "power": "{n} puissance {e}" , "negative": "moins" },
        "magnitudes": ["millions", "million", "milliards", "milliard"],
        "magnitudeConnective": "de", // cinq millions DE dollars
    }
}
