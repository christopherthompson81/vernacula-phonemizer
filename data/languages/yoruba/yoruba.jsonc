// Native canonical-IPA definition for Yoruba / Èdè Yorùbá (yo) — Volta-Niger (Niger-Congo), Latin script, a
// highly PHONEMIC three-tone orthography. yoruba.ts reads this file. Signature features: the labial-velar stops
// ⟨gb⟩→ɡ͡b and ⟨p⟩→k͡p (Yoruba has NO plain /p/), ⟨j⟩→d͡ʒ, ⟨ṣ⟩→ʃ, ⟨r⟩→tap ɾ, ⟨y⟩→j; the dotted-below vowels
// ẹ→ɛ ọ→ɔ (7 oral vowels i e ɛ a ɔ o u); NASAL vowels from a coda ⟨n⟩ (ọn→ɔ̃; onset n before a vowel stays n);
// syllabic nasals m̩/n̩; and THREE level tones marked on the vowel: High=acute ˥, Mid=unmarked ˧, Low=grave ˩
// (Chao letters). Epitran-validated.
{
    "language": "yo",
    "name": "Yoruba",
    "script": ["Latin"],
    "provenance": "Authored from standard Yoruba phonology + the highly phonemic orthography. Validated against wikipron yor + kaikki yor (human) + epitran yor-Latn.",

    // Consonant letters → IPA. ⟨gb⟩/⟨p⟩ are the labial-velars ɡ͡b/k͡p; ⟨j⟩ is the affricate d͡ʒ, ⟨y⟩ the glide j;
    // ⟨ṣ⟩ (s with dot below) → ʃ (handled in yoruba.ts via the combining dot). ⟨r⟩ → tap ɾ.
    "consonants": {
        "b": "b", "d": "d", "f": "f", "g": "ɡ", "gb": "ɡ͡b", "h": "h",
        "j": "d͡ʒ", "k": "k", "l": "l", "m": "m", "n": "n", "p": "k͡p",
        "r": "ɾ", "s": "s", "t": "t", "w": "w", "y": "j"
    },

    // Oral vowels → IPA. The dotted-below ẹ/ọ (→ ɛ/ɔ) are derived in yoruba.ts from the base + combining dot.
    "vowels": { "a": "a", "e": "e", "i": "i", "o": "o", "u": "u" },

    // Three level tones → Chao contour letters: High (acute ́), Mid (unmarked), Low (grave ̀).
    "tones": { "high": "˥", "mid": "˧", "low": "˩" },

    // CARDINAL NUMBERS — a VIGESIMAL system with both ADDITION and SUBTRACTION, and every form below is either
    // attested in a 112,738-paragraph yo.wikipedia dump or glossed with its own digits by the corpus.
    //
    // ⚠ THE CORPUS GLOSSES ITS OWN NUMERALS, which is what made this table verifiable rather than inferred. It
    // writes the numeral out and repeats it in figures — `ẹgbẹ̀rún méjì (2,000)`, `irinwó ó lé ọgọ́rin (480)`,
    // `ẹ̀ẹ́dẹ́gbẹ̀rún mítà (900m)`, and one instance that pins the whole multi-part shape:
    //     ẹgbẹ̀rún lọ́nà méjìlélọ́gbọ̀n lé ẹgbẹ̀rin lé méjìlá  (32,812)   = 1000×32 + 800 + 12
    // 576 such glosses were extracted; 186 numeral phrases are glossed consistently. See
    // for the mining and every count.
    //
    // ⚠ AND THE DUMP CONTAINS DUPLICATE PARAGRAPHS (123,405 → 112,738 unique, 8.6%), which inflates exactly the
    // rare forms this table depends on. One gloss, `mẹ́tàdínlọ́gọ́rin (75%)`, appeared four times and looked like
    // corroboration; it is ONE sentence repeated, and it contradicts the rule 86 other values support
    // (mẹ́tà-dín-lọ́gọ́rin is 3-from-80 = 77). Every count here is from the deduplicated text.
    "numbers": {
        // `òdo` is thin (28) but it is the only tone-marked candidate: the untoned `odo` (432) is dominated by
        // odò "river". Digits rarely render as a bare zero, so little rests on it.
        "zero": "òdo",
        // FREE forms, for a numeral standing alone. ⚠ 1 is `ọ̀kan` (2,357) and NOT `kan`: `kan` has 19,097 hits
        // because it is the ordinary determiner "a/certain", which is a count that would look like overwhelming
        // evidence for the wrong word.
        "units": ["", "ọ̀kan", "méjì", "mẹ́ta", "mẹ́rin", "márùn-ún", "mẹ́fà", "méje", "mẹ́jọ", "mẹ́sàn-án", "mẹ́wàá"],
        //            2357    3023    1724    1111     804        794      518     376      191        597
        // ⚠ `márùn` (964) and `mẹ́sàn` (232) look like competing spellings but are NOT: a hyphen is neither
        // \p{L} nor \p{M}, so a whole-word count of `márùn` also matches the `márùn` inside `márùn-ún`. The true
        // standalone counts are 160 and 41. Same trap as km's យ័ន.
        //
        // FUSING forms, used at the front of a compound. ⚠ 1 takes the m- prefix like every other unit —
        // mọ́kànlá 171 : ọ̀kànlá 3, mọ́kàndínlógún 68 : 10 — and for 39 and 59 the ọ̀kàn- form has ZERO hits
        // while the m- form has 12 and 13. Two values looked unattested purely from getting this wrong.
        "front": ["", "mọ́kàn", "méjì", "mẹ́tà", "mẹ́rìn", "márùn", "mẹ́rìn", "mẹ́tà", "méjì", "mọ́kàn"],
        // Tens as FREE words, and as the FUSED base that follows lé-/dín-. The fused base takes an l- and a tone
        // change; ⚠ the àádọ́- bases KEEP their à (láàdọ́ta, not ládọ́ta — the one-à spelling has a single corpus
        // hit and made 45-48 and 52-54 look unattested), and ⚠ 90's fused base DROPS its final -ún (láàdọ́rùn).
        "tens": {
            "20": { "free": "ogún", "fused": "lógún" },
            "30": { "free": "ọgbọ̀n", "fused": "lọ́gbọ̀n" },
            "40": { "free": "ogójì", "fused": "lógójì" },
            "50": { "free": "àádọ́ta", "fused": "láàdọ́ta" },
            "60": { "free": "ọgọ́ta", "fused": "lọ́gọ́ta" },
            "70": { "free": "àádọ́rin", "fused": "láàdọ́rin" },
            "80": { "free": "ọgọ́rin", "fused": "lọ́gọ́rin" },
            "90": { "free": "àádọ́rùn-ún", "fused": "láàdọ́rùn" },
            "100": { "free": "ọgọ́rùn-ún", "fused": "lọ́gọ́rùn-ún" },
            // ⚠ THE VIGESIMAL SERIES CONTINUES PAST 100, and the first version of this table stopped there —
            // so 101-199 was composed as `ọgọ́rùn-ún ó lé <remainder>`, which the corpus does not write. It uses
            // single words on bases of TWENTY (ọgọ́fà 120 = 6×20, ogóje 140 = 7×20, ọgọ́jọ 160, ọgọ́sàn-án 180)
            // with the intervening tens formed by àádọ́- (150 = àádọ́jọ, ten less than 160). Found by READING the
            // artifact rather than counting its cells: `Ogóje náírà (N140.00)` and `ọgọ́sàn-án náírà (N180.00)`
            // sat in the `clock` cell, which the counting audit had called covered.
            //
            // Each is glossed with its own digits: 120 ×6, 130 ×2, 140 ×5, 150 ×3, 160 ×4, 170 ×1, 180 ×4. And
            // the lé/dín machinery generalises onto them — `mẹ́tàdínlógóje` (137, three from 140),
            // `márùn-ún-dín-lógósàn-án` (175, five from 180) — with the fused bases attested independently
            // (lógóje 14, lọ́gọ́jọ 15, lọ́gọ́sàn 8, lógófà 1).
            //
            // ⚠ THE FUSED FORMS ARE READ OFF THE CORPUS, NOT DERIVED. My first guesses (`lédọ́je`, `lọ́gba`)
            // have 0 and 1 hits; the attested shapes are `láàdó-` for the àádọ́ series and `nígba` for igba,
            // which the glosses state outright: `marundinlaadoje(125)`, `kànléláàdóje(131)`, `marundinnigba(195)`,
            // `kàndínnígba(199)`, `marundinlaadowaa(185)`. Counts: láàdóje 7, láàdówàá 1, nígba 117, lógófà 1,
            // lógóje 14, lọ́gọ́jọ 15, lọ́gọ́sàn 8. THREE are unattested and composed by analogy with the rest —
            // láàdófà (110), láàdójọ (150), láàdósàn (170).
            //
            // ⚠ AND ONE GLOSS DIVERGES: `márùn-ún lé lọ́gọ́jọ (165)` reads 5 as ADDITIVE on 160, where the rule
            // (and 115, 125, 135, 155, 185, 195, all `márùndín-`) makes 5 subtractive from the ten above. Writers
            // evidently pivot on the twenty-bases as well as the tens. The subtractive form is followed here
            // because six glosses attest it against one.
            "110": { "free": "àádọ́fà", "fused": "láàdófà" },
            "120": { "free": "ọgọ́fà", "fused": "lógófà" },
            "130": { "free": "àádọ́je", "fused": "láàdóje" },
            "140": { "free": "ogóje", "fused": "lógóje" },
            "150": { "free": "àádọ́jọ", "fused": "láàdójọ" },
            "160": { "free": "ọgọ́jọ", "fused": "lọ́gọ́jọ" },
            "170": { "free": "àádọ́sàn", "fused": "láàdósàn" },
            "180": { "free": "ọgọ́sàn-án", "fused": "lọ́gọ́sàn" },
            "190": { "free": "àádọ́wàá", "fused": "láàdówàá" },
            "200": { "free": "igba", "fused": "nígba" }
        },
        // 11-14 are unit + `lá` (méjìlá 257, mẹ́tàlá 186, mẹ́rìnlá 206, mọ́kànlá 171).
        "teen": "lá",
        // 15 and 25 have their own mẹ́ẹ̀ẹ́d- shape, which OUTNUMBERS the regular subtractive form:
        // mẹ́ẹ̀ẹ́dógún 127 : márùndínlógún 29, and mẹ́ẹ̀ẹ́dọ́gbọ̀n 65 : márùndínlọ́gbọ̀n 21. From 35 up the
        // regular márùndín- form is the only one attested, so this is a two-entry irregularity, not a pattern.
        "fifteen": "mẹ́ẹ̀ẹ́dógún",
        "twentyFive": "mẹ́ẹ̀ẹ́dọ́gbọ̀n",
        // The additive and subtractive infixes. 1-4 past a ten are ADDITIVE on it (mẹ́rìnlélógún 103 = 24);
        // 5-9 are SUBTRACTIVE from the ten above (mẹ́rìndínlọ́gbọ̀n 54 = 26, márùndínlógójì 32 = 35).
        "add": "lé",
        "subtract": "dín",
        // HUNDREDS, each glossed with its own digits by the corpus: 500 and 900 directly
        // (`ẹ̀ẹ́dẹ́gbẹ̀rún mítà (900m)`), 700 inside `Ẹgbẹ̀rún-lọ́nà-ẹ̀ẹ́dẹ́gbẹ̀rin` (1000×700).
        // ⚠ `igba` (200) is HOMOGRAPHIC with ìgbà "time" once tone is dropped, and this corpus is ~51%
        // tone-marked — so its 1,387 whole-word hits are mostly the ordinary word. The numeral rests on the 21
        // `igba (200)` glosses and the 70 uses before a multiplier, not on that number.
        // ⚠ SLOTS 0 AND 1 ARE NEVER READ, and slot 1 is the one worth saying so about: `below1000` sends
        // everything under 200 to the VIGESIMAL series, so 100-199 is composed from the tens table
        // (`"100": { "free": "ọgọ́rùn-ún" }`) and this table is consulted only from 200 up. Replacing this
        // entry with nonsense changes no reading — 100 still reads ọgọ́rùn-ún, 137 mẹ́tàdínlógóje, 1100
        // ẹgbẹ̀rún kan ó lé ọgọ́rùn-ún. It is kept rather than blanked because an empty string here would be
        // a SILENT gap if the 100-199 range were ever routed back through this path, where a correct word is
        // merely unused; the index must stay put either way.
        "hundreds": ["", "ọgọ́rùn-ún", "igba", "ọ̀ọ́dúnrún", "irinwó", "ẹ̀ẹ́dẹ́gbẹ̀ta", "ẹgbẹ̀ta",
            "ẹ̀ẹ́dẹ́gbẹ̀rin", "ẹgbẹ̀rin", "ẹ̀ẹ́dẹ́gbẹ̀rún"],
        // MAGNITUDE FIRST, multiplier second — counted, not assumed: ẹgbẹ̀rún 249:2, mílíọ̀nù 197:7, igba 70:4.
        "thousand": "ẹgbẹ̀rún",
        "million": "mílíọ̀nù",
        "billion": "bílíọ̀nù",
        // ⚠ A THOUSAND TAKES `kan` FOR ×1 BUT A HUNDRED DOES NOT: ẹgbẹ̀rún kan 52 and mílíọ̀nù kan 60 against
        // ọgọ́rùn-ún kan 2 and irinwó kan 0, and the corpus glosses bare `ọgọ́rùn-ún (100)` eight times.
        "multiplierOne": "kan",
        // ⚠ `lọ́nà` MULTIPLIES when the multiplier is above ten, and a direct multiplier is used below it:
        // ẹgbẹ̀rún + unit 249 : ẹgbẹ̀rún lọ́nà + unit 4, but ẹgbẹ̀rún lọ́nà + ten 46 : ẹgbẹ̀rún + ten 7.
        // Attested with any multiplier over ten, not only round ones — `ẹgbẹ̀rún lọ́nà mẹ́ẹ̀ẹ́dógún (15,000)`.
        "times": "lọ́nà",
        // The joiner between a magnitude and its remainder: `irinwó ó lé ọgọ́rin (480)`, `igba ó lé ọgọ́rin (280)`.
        "join": "ó lé"
    },

    // THE SYMBOL READINGS, for normalize.ts. Counts are from the same deduplicated dump.
    "symbols": {
        // `sí` ("to") — 1,427 digit-flanked, and glossed twice: `ọgọ́rùn-ún méjì sí mẹ́fà (200-600 kg)` for a
        // range and `góòlù mẹ́rin sí òdo (4–0)` for a scoreline.
        "range": "sí",
        // ⚠ THE PERCENT IS A CIRCUMFIX: a word before the number AND a phrase after it. `ìdá 84 nínú ọgọ́rùn-ún`.
        // 21 digit-form instances against 0 for the competing `ọgọ́rùn-ún lọ́nà X` order.
        "percentBefore": "ìdá",
        "percentAfter": "nínú ọgọ́rùn-ún",
        // ⚠ `dásímà` is a BORROWING of "decimal", and the frame `X àti dásímà <digits>` is unanimous across all
        // 18 instances, with the fraction read digit by digit. Native candidates (ààmì, àmì, ẹ̀là, pọ́ìntì, ojú)
        // are all 0 between digits, and `ẹsẹ` — which a mathematics dictionary gives — means FOOT in all 478 of
        // its corpus occurrences. See normalize.ts for why that dictionary entry is refused.
        "decimalWord": "àti dásímà",
        // The ordinary connective, 42,897 whole-word hits, 430 of them digit-flanked.
        "and": "àti",
        // ⚠ THE NEGATIVE MARKER, AND yo.wikipedia GLOSSES IT AGAINST THE SIGNED DIGITS. The article
        // `Nọ́mbà alòdì àti nọ́mbà adájú` ("negative numbers and positive numbers") defines the term with
        // examples written as figures: *"Nomba alodi ni awon nomba tiwonkere ju òdo lo fun apere -√2,
        // -1.44, -1"* — "negative numbers are the numbers less than ZERO, for example −√2, −1.44, −1".
        // That is the same gloss shape that settled tn (`kwa tlase ga lefela` beside `(−6.5 °C)`) and nan
        // (`hū-hō tāi-piáu hong-hiòng` beside `(−10 m/s)`), and it is the strongest evidence available for
        // a sign reading: the term named beside its own operand.
        //
        // `alòdì` ×4/2 whole-word; `nọ́mbà alòdì` ×2/1. ⚠ TWO SENSES, and the other one is ordinary:
        // *alòdì sí ìwà ìbàjẹ́* is "opposed to corruption". A temperature or a bare figure is not that
        // context, and the alternative is a reading that INVERTS.
        //
        // ⚠ NOT `ìyọkúrò` AND NOT `yọ kúrò`, which are the dictionary's answer for "subtract": both are
        // physical REMOVAL in every corpus instance (methane removed from the air, water removed by
        // evaporation), and a transitive verb before a numeral reads as an imperative — *yọ …dígírì*,
        // "remove … degrees". ⚠ AND NOT `dín ní` ("less than"), which is worse than wrong here: it is how
        // Yoruba BUILDS NUMERALS — *márùn dín ní ọgọ́ta* is 55, "five less than sixty" — so a `dín ní`
        // emitted before a figure would be parsed as part of the number.
        "negative": "alòdì",
        // ⚠ THE BARE METRE IS READ LOCALLY, NOT THROUGH THE UNIT TIER — see normalize.ts for the two
        // `9h 50m` counter-examples that keep `m` out of `units`. The WORD is data either way.
        "metre": "mítà",
        // The SQUARED measure word, which follows the unit noun: `kìlómítà onígun mẹ́rin`. 27 occurrences of
        // the phrase, 9 of them directly after a unit word (kìlómítà/mítà/máìlì).
        "squared": "onígun mẹ́rin",
        // ⚠ TEMPERATURE IS A CIRCUMFIX TOO: `ìwọ̀n` before the number, the scale name after —
        // `ìwọ̀n 3.4 Celsius`, `ìwọ̀n 36 sí 50 Fahrenheit`, `ìwọ̀n Celsius meji (3.6 ìwọ̀n Fahrenheit)`.
        //
        // ⚠ THIS CLASS WAS FIRST REFUSED, AND THE REFUSAL WAS WRONG. It rested on `dígírí` 0 and `sẹ́lísíọ̀sì` 0
        // — two Yorubized spellings I invented. The corpus borrows the scale names UNCHANGED (Celsius 9,
        // Fahrenheit 5, Kelvin 17) and uses the ordinary measure word `ìwọ̀n` (1,198) for "degrees", which I had
        // counted and dismissed as a general quantifier. Meanwhile °C is 211 occurrences and °F 144, all read as
        // a bare number. Same failure as the decimal word: a guessed candidate list, and its zeros measured the
        // list rather than the language.
        //
        // The Yorubized `digiri` (3) and `dìgírí` (1) exist but are a DIFFERENT sense — three are academic
        // degrees (`ẹ̀rí digiri (doctorate)`, `masita digiri (MBA)`) and one is angular (`4.34 digiri si
        // ekilipkiti`). Not temperature, so not used here.
        "degree": "ìwọ̀n",
        "scales": { "C": "Celsius", "F": "Fahrenheit", "K": "Kelvin" },
        // ⚠ `lọ́nà` IS THE MULTIPLICATION WORD, and refusing × while numbers.ts uses this very particle for
        // multiplication was not defensible. `ẹgbẹ̀rún lọ́nà ogún` is 1000×20 — the same A-times-B relation the
        // sign writes — with 77 instances after ẹgbẹ̀rún alone. Composing a symbol reading from a particle
        // attested only between spelled-out numerals is a LEAD rather than a finding (the playbook's zu/xh
        // `Kristu` case), so this is a judgement: an unidiomatic reading in the right language beats dropping
        // the sign, which is this project's standing preference everywhere else.
        "times": "lọ́nà"
    },

    "clausePunctuation": {
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbolTier": {
        /** `US$` is its own "key": with only a bare `$`, the letters read as a word and the sign is dropped. */
        "currency": { "US$": ["dọ́là Amẹ́ríkà"], "₦": ["náírà"], "$": ["dọ́là"] },
        /**
         * ⚠ `mm` AND `l` JOIN `km`/`ha`/`mi`; `m` IS STILL NOT HERE, and it is claimed locally instead — see
         * `METRE` below for the two counter-examples that decide it. Cubed is undeclared because no cube word
         * exists in the language's usage here.
         *
         * · `mm` → *mílímítà*, yo.wikipedia 1 token / 1 article and a flood article at "that": *"ó sì mú kí òjò
         *   tó ju MÍLÍMÍTÀ 250 rọ̀"* ("rain of more than 250 mm fell"). ⚠ One article is a lead, so the
         *   UNTONED spelling was probed as its own word and carries the "finding": `milimita` is 12 tokens / 9
         *   articles, every readable hit rainfall or a botanical measurement — *"1189.7 milimita gbogbo òjò"*,
         *   *"òjò tí ó ju milimita 150 (5.9 in) lọ"*, *"10 nípasẹ 10 milimita"*, *"àwọn milimita 61.59 ti
         *   ojoriro"*. Same word, tone marks written or not, which is this corpus's normal condition; the
         *   TONED form is emitted because every other unit noun in this file is toned and the g2p reads it.
         * · `l` → *lítà*, 10 tokens / 5 articles, senses read and all "volume": *"tó lítà 298 (ẹsẹ̀ onígun mẹ́ta
         *   10.5)"* (a car's boot), *"ẹ̀rọ Ford OHC lítà 2.0"*, *"Jala Porimala Jojona (35,000 lítà)"*, *"lítà
         *   omi bílíọ̀nù 61.7 lójoojúmọ́"*, and a Wikipedia style note that glosses the English "outright":
         *   *"wọ́n lè kọ \"one litre\" (LÍTÀ KAN)"*. `líta` is ×0; `lita` ×9 is mostly the footballer Leroy
         *   Lita and a Ford engine displacement, which is why the toned form is the one taken.
         *
         * ⚠ THE ONE-LETTER KEY `l` IS SAFE HERE, AND THE MEASUREMENT IS THE OPPOSITE OF WHAT THE RAW COUNT
         * SAYS (trap 46). A bare grep for a digit then `l` finds THIRTEEN hits in the mined artifact and not
         * one is a "litre": every one is Yoruba's proclitic `l-` glued to the next word after a number —
         * `1975 lẹ́yìn`, `1829 látàrí`, `2.8 làti`, `30,000 lábẹ́`, `2015 lọ`, `1985 lóri`, `2012 láti`. That
         * is exactly the shape that bit `mad`, `rn` and `hmn` this session. What saves it is that the tier's
         * trailing guard is `(?![\p{L}\p{M}'’ʼ])` and a Yoruba letter follows the `l` in all "thirteen": rebuilt
         * with the guard, the count is 0 matches, so declaring `l` claims nothing the corpus would refuse.
         * ⚠ `L` IS DECLARED ALONGSIDE `l` — the litre's documented exception to the one-letter rule
         * (`resolveUnitSymbol`): both cases are official for this unit and the exact branch is case-sensitive.
         *
         * ⚠ POSTPOSED, AND THE MIXED COUNT RESOLVES ON A READING. Over the mined artifact the unit noun follows
         * its number 4 times and precedes it 6, which looks like the `hil`/`rw` question — but the six are all
         * ATHLETICS EVENT NAMES (`mita 5000`, `mita 3000`, `kilomita 10`, "the 5000 metres"), an idiom naming a
         * race rather than measuring anything, while every genuine MEASUREMENT is digit-first: `4,180 kìlómítà
         * (2,600 miles)`, `500 mítà (1,600 ẹsẹ̀ bàtà)`, `8.62 mítà (28.3 ft)`, `10,000 mita`. 4:0 once the
         * event names are set aside, so the tier's default order stands and no `unitPrefix` is declared.
         */
        /**
         * ⚠ `ft` IS DECLARED, AND IT IS THE ONE PLACE THIS FILE PARTS COMPANY WITH THE FLEET-WIDE IMPERIAL
         * REFUSAL. ak, sn, mos and jv all leave `ft` reported inside a metric-glossing parenthetical, and the
         * reason each of them gives is that the language has NO FOOT WORD to give it. Yoruba has one, and this
         * corpus's own line is the "gloss": `tí ọkọọkan tó 150 ẹsẹ̀ (FT) ní gíga` — the abbreviation set beside
         * the Yoruba noun, in the same sentence, as the definition of it. The layer's `METRE` note already
         * quotes a "second": `500 mítà (1,600 ẹsẹ̀ bàtà)`.
         *
         * · `ẹsẹ̀ bàtà` — 19 tokens / 15 articles on yo.wikipedia (tools/corpus/attest/yo.jsonc), and every
         *   example read is the imperial foot in a metric "gloss": *"ẹ̀ẹ́dẹ́gbẹ̀rún mítà (900m), ìwọ̀n ẹsẹ̀ bàtà
         *   ẹ́ẹ́tà lé-láádọ̀ta-lé-lẹ́gbẹ̀rún méjì (2,953ft)"*, *"mítà méje (ẹsẹ̀ bàtà mẹ́tàlélógún àti ìnṣì)"*,
         *   *"ère … tí ó tó ẹsẹ bàtà mẹrin (1.2 m)"*. The untoned `ẹsẹ bàtà` ×9/8 is the same word.
         * ⚠ THE COMPOUND, NEVER BARE `ẹsẹ̀`, and the header already says "why": bare `ẹsẹ̀` is a foot/leg and a
         *   verse-line, which is exactly the wrong-sense argument that keeps it out of the decimal-point slot.
         *   `bàtà` ("shoe") is what makes the measure sense unambiguous, and it is the collocation the corpus
         *   writes.
         * ⚠ POSTPOSED LIKE THE REST, AND THE COUNT LOOKS PREPOSED UNTIL IT IS READ — the same trap this file's
         *   `units` note records for the athletics event names. Six of the attested hits put the noun first,
         *   and in every one of those the number is SPELLED OUT (`ẹsẹ bàtà mẹrin`, `ẹsẹ̀ bàtà mẹ́tàlélógún`) or
         *   the phrase is framed by `ìwọ̀n` ("the measure of"). Where a DIGIT is involved — which is the only
         *   shape this rule can ever match — the corpus writes `1,600 ẹsẹ̀ bàtà` and `150 ẹsẹ̀`, number first.
         */
        "units": {
            "km": ["kìlómítà"], "ha": ["hẹ́kítà"], "mi": ["máìlì"], "mm": ["mílímítà"], "l": ["lítà"], "L": ["lítà"],
            "ft": ["ẹsẹ̀ bàtà"],
        },
        /** ⚠ `w` is the YORUBA abbreviation — wákàtí, "hour" — so both `km/w` and the borrowed `km/h` occur. */
        "rateDenominators": { "w": "wákàtí kan", "h": "wákàtí kan" },
        "unitPer": "ni"
    }
}
