// Native canonical-IPA definition for Polish (pl) — West Slavic, Latin script with diacritics. polish.ts / g2p.ts
// read this file. Polish orthography is systematic but with real rule systems (handled in g2p.ts):
//   - digraphs ch→x, cz→t͡ʂ, dz→d͡z, dź→d͡ʑ, dż→d͡ʐ, rz→ʐ, sz→ʂ
//   - the ⟨i⟩ palatalizer: coronal c/s/z/n(/dz) + i → the SOFT series t͡ɕ/ɕ/ʑ/ɲ(/d͡ʑ) (i silent before a vowel:
//     siano→ɕanɔ; the i-vowel before a consonant/end: zima→ʑima); velar k/g + i → palatalized kʲ/ɡʲ; any other
//     consonant + i + VOWEL → a [j] glide (pies→pjɛs, radio→radjɔ).
//   - nasal vowels ą/ę: oral vowel + a homorganic nasal element by the FOLLOWING consonant's place — matching the
//     wikipron human convention, which realizes the nasality as a consonant before an obstruent (stop OR fricative):
//     m/n/ŋ (ząb→zɔmp, wąs→vɔns, wąchać→vɔŋx), a [w̃] glide before a palatal fricative ɕ/ʑ (gęś→ɡɛw̃ɕ), and pure
//     vowel-nasalization before a sonorant. ą word-FINAL → [ɔw̃] (są→sɔw̃); ę word-FINAL denasalizes to ɛ (się→ɕɛ).
//   - regressive voicing assimilation + word-final devoicing; progressive devoicing of w(v)/rz(ʐ) after a voiceless
//     obstruent (świat→ɕfjat, przez→pʂɛs). Stress is PENULTIMATE (applied in polish.ts).
{
    "language": "pl",
    "name": "Polish",
    "script": ["Latin"],
    "provenance": "Authored from standard Polish orthography + phonology; cross-checked vs wikipron pol + epitran pol-Latn.",

    "vowels": { "a": "a", "e": "ɛ", "i": "i", "o": "ɔ", "u": "u", "ó": "u", "y": "ɨ" },
    "nasalVowels": { "ą": "ɔ", "ę": "ɛ" },

    "consonants": {
        "p": "p", "b": "b", "t": "t", "d": "d", "k": "k", "g": "ɡ",
        "c": "t͡s", "ć": "t͡ɕ", "f": "f", "w": "v", "s": "s", "z": "z",
        "ś": "ɕ", "ź": "ʑ", "ż": "ʐ", "l": "l", "ł": "w", "r": "r", "j": "j",
        "m": "m", "n": "n", "ń": "ɲ", "h": "x", "q": "k", "v": "v", "x": "ks"
    },
    "digraphs": { "ch": "x", "cz": "t͡ʂ", "dz": "d͡z", "dź": "d͡ʑ", "dż": "d͡ʐ", "rz": "ʐ", "sz": "ʂ" },

    // ⟨i⟩-palatalizer classes: coronal SOFT series (c/s/z/n + i → these); the velar/labial/glide behaviour is in g2p.ts.
    "softI": { "c": "t͡ɕ", "s": "ɕ", "z": "ʑ", "n": "ɲ" },

    // Voicing-assimilation pairs (voiced ↔ voiceless), for regressive assimilation + final devoicing.
    "voicing": {
        "toVoiceless": { "b": "p", "d": "t", "ɡ": "k", "v": "f", "z": "s", "ʑ": "ɕ", "ʐ": "ʂ", "d͡z": "t͡s", "d͡ʑ": "t͡ɕ", "d͡ʐ": "t͡ʂ" },
        "toVoiced": { "p": "b", "t": "d", "k": "ɡ", "f": "v", "s": "z", "ɕ": "ʑ", "ʂ": "ʐ", "x": "ɣ", "t͡s": "d͡z", "t͡ɕ": "d͡ʑ", "t͡ʂ": "d͡ʐ" }
    },

    "clausePunctuation": {
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // LEXICAL FACT, not derivable from spelling: acronyms Polish reads LETTER BY LETTER although the
    // letters would form a perfectly readable Polish word (so the OOV phonotactic test in
    // core/initialisms.ts leaves them alone). Attested in the pl_pl corpus: USA ×11 [u es a], RPA ×6
    // [er pe a], ONZ ×4 [o en zet], PKB ×3, DNA ×3, GPS ×3, AOL ×3. The genuinely unpronounceable ones
    // (GMT, UTC, DVD, XDR, PNG, TB) need no entry — the no-vowel rule already spells them out, and the
    // pronounceable acronyms Polish reads AS words (NASA, UNESCO, FIFA, OPEC, ACTA, ASUS, LATAM, SWAPO,
    // COVID) are deliberately absent so the OOV g2p keeps reading them as words.
    "acronymLetters": ["usa", "rpa", "onz", "pkb", "dna", "gps", "aol", "ue", "zsrr", "nba"],

    // Cardinal number words (composition logic in numbers.ts). SOURCE: pl.wikipedia's per-number articles
    // ("1 (liczba)" → jeden … "1000 (liczba)" → tysiąc, tys.), which spell every unit / teen / round ten /
    // round hundred used below; the magnitude agreement forms are the standard Polish paradigm (tysiąc ·
    // tysiące · tysięcy; milion · miliony · milionów; miliard · miliardy · miliardów).
    //   • Everything is SPACE-separated (dwadzieścia jeden, unlike Czech dvacetjeden).
    //   • Round hundreds are irregular and must be listed (sto, dwieście, trzysta, czterysta, then -set).
    //   • Magnitude agreement is the Slavic three-way sg / paucal / gen-pl, but Polish differs from Russian on
    //     compounds ending in "jeden": Polish takes the GENITIVE PLURAL there (dwadzieścia jeden tysięcy —
    //     attested on pl.wikipedia; *dwadzieścia jeden tysiąc has zero hits), so the singular is used ONLY for
    //     an exact count of 1. See the countForm note in numbers.ts.
    //   • "jeden" is the masculine citation form (Polish 1/2 also inflect for gender: jedna/jedno, dwie) —
    //     gender concord needs a counted noun, which a bare numeral does not have → masculine, as in the
    //     Latvian/Russian engines.
    "numbers": {
        "units": ["zero", "jeden", "dwa", "trzy", "cztery", "pięć", "sześć", "siedem", "osiem", "dziewięć"],
        "teens": [
            "dziesięć", "jedenaście", "dwanaście", "trzynaście", "czternaście",
            "piętnaście", "szesnaście", "siedemnaście", "osiemnaście", "dziewiętnaście"
        ],
        "tens": [
            "", "", "dwadzieścia", "trzydzieści", "czterdzieści",
            "pięćdziesiąt", "sześćdziesiąt", "siedemdziesiąt", "osiemdziesiąt", "dziewięćdziesiąt"
        ],
        "hundreds": [
            "", "sto", "dwieście", "trzysta", "czterysta",
            "pięćset", "sześćset", "siedemset", "osiemset", "dziewięćset"
        ],
        "magnitudes": {
            "thousand": { "sg": "tysiąc", "paucal": "tysiące", "plural": "tysięcy" },
            "million": { "sg": "milion", "paucal": "miliony", "plural": "milionów" },
            "billion": { "sg": "miliard", "paucal": "miliardy", "plural": "miliardów" }
        }
    },

    "letterNames": {
        "a": "a", "ą": "a z ogonkiem", "b": "be", "c": "ce", "ć": "cie", "d": "de", "e": "e",
        "ę": "e z ogonkiem", "f": "ef", "g": "gie", "h": "ha", "i": "i", "j": "jot", "k": "ka", "l": "el",
        "ł": "eł", "m": "em", "n": "en", "ń": "eń", "o": "o", "ó": "o kreskowane", "p": "pe", "q": "ku",
        "r": "er", "s": "es", "ś": "eś", "t": "te", "u": "u", "v": "fau", "w": "wu", "x": "iks",
        "y": "igrek", "z": "zet", "ź": "ziet", "ż": "żet"
    },
    "phonotactics": {
        "vowels": "aeiouyąęó",
        "onsets": [
            "bl", "br", "ch", "cz", "dl", "dr", "dz", "dż", "dź", "gl", "gr", "gd", "gn", "gw", "kl", "kn",
            "kr", "kt", "kw", "ml", "mł", "mn", "mr", "pl", "pr", "ps", "pt", "rz", "sk", "sl", "sł", "sm",
            "sn", "sp", "st", "sw", "sz", "śc", "śl", "śm", "śn", "św", "tl", "tr", "tw", "wl", "wł", "wr",
            "zb", "zd", "zg", "zł", "zn", "zw", "źr", "żr"
        ],
        "codas": [
            "ch", "cz", "sz", "rz", "st", "śc", "ść", "zd", "nt", "nd", "nk", "ng", "ns", "nc", "rt", "rd",
            "rk", "rs", "rn", "rm", "rz", "lt", "ld", "lk", "ls", "lm", "łt", "łd", "łk", "kt", "ks", "pt",
            "ft", "zm", "zn", "sk", "sm", "tr", "dr", "br", "gr", "pr", "kr", "wr", "cs", "js", "js"
        ]
    },

    // The name of the DECIMAL COMMA, emitted between the integer and fractional parts. ⚠ 35 languages
    // already declared this; these four alone passed the word to the engine as a bare literal, so the
    // same fact was manifest data in Dutch and a string in the code next door.
    "decimalWord": "przecinek",

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbols": {
        // `&` was DROPPED outright: the corpus's `B&B` and `Arts & Sciences` lost the sign.
        // `i` ×846 in this corpus. The tier spaces it on both sides, because `B&B` is two
        // initialisms and joining them would make one token.
        // `multiply` — this language DROPPED the sign outright. ⚠ STANDARD MATHEMATICAL REGISTER, not a corpus
        // attestation: the sweep failed exactly as the exponent sweep did, because the plausible hits are homographs
        // of PREPOSITIONS — es `por` ×23, it `per` ×25, ru `на` ×31 are all the preposition, never the operator.
        // One word, so `by` defaults to it; this language does not split dimension from product.
        "multiply": { "times": "razy" },
        "ampersand": "i",
        "units": {
        "km": ["kilometr", "kilometry", "kilometrów", "kilometra"],
        "m": ["metr", "metry", "metrów", "metra"],
        "cm": ["centymetr", "centymetry", "centymetrów", "centymetra"],
        "mm": ["milimetr", "milimetry", "milimetrów", "milimetra"],
        "kg": ["kilogram", "kilogramy", "kilogramów", "kilograma"],
        "mln": ["milion", "miliony", "milionów", "miliona"],
        "mld": ["miliard", "miliardy", "miliardów", "miliarda"],
        },
        "percent": ["procent", "procenty", "procent", "procenta"],
        "currency": {
            "$": ["dolar", "dolary", "dolarów", "dolara"],
            "€": ["euro"],
            "£": ["funt", "funty", "funtów", "funta"],
            "¥": ["jen", "jeny", "jenów", "jena"],
            // Polish's own currency, which could not be declared while the tier keyed currencies as single
            // characters — the Polish run reported exactly this gap and had to omit złoty.
            "zł": ["złoty", "złote", "złotych", "złotego"],
            "PLN": ["złoty", "złote", "złotych", "złotego"],
        },
        "magnitudes": ["tysiąca", "tysięcy", "miliona", "milionów", "miliarda", "miliardów"],
        // MIGRATION TEST: km²/mm² composed by the shared tier. The adjective agrees, so it carries the
        // same three count forms the unit nouns do.
        "exponentWords": {
            "squared": ["kwadratowy", "kwadratowe", "kwadratowych", "kwadratowego"],
            "cubed": ["sześcienny", "sześcienne", "sześciennych", "sześciennego"],
        }
    }
}
