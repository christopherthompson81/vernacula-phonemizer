{
    // Sinhala (si) abugida definition for the shared core/abugida.ts. Canonical IPA forms baked in (ණ→n, ළ→l
    // merged; ත→t̪ dental; ව→ʋ; ᶯɖ preserved). Schwa (inherent a↔ə), geminates, and stress are a post-pass in
    // sinhala.ts. Anusvara ං is pre-rewritten to ඞ් (coda ŋ).
    "language": "si",
    "name": "Sinhala",
    "script": ["Sinhala"],
    "inherentVowel": "a",
    "consonants": {
        "ක": { "ipa": "k" },
        "ඛ": { "ipa": "kʰ" },
        "ග": { "ipa": "ɡ" },
        "ඝ": { "ipa": "ɡʰ" },
        "ඞ": { "ipa": "ŋ" },
        "ඟ": { "ipa": "ᵑɡ" },
        "ච": { "ipa": "t͡ʃ" },
        "ඡ": { "ipa": "t͡ʃh" },
        "ජ": { "ipa": "d͡ʒ" },
        "ඣ": { "ipa": "d͡ʒh" },
        "ඤ": { "ipa": "ɲ" },
        "ඥ": { "ipa": "ɡn" },
        "ට": { "ipa": "ʈ" },
        "ඨ": { "ipa": "ʈʰ" },
        "ඩ": { "ipa": "ɖ" },
        "ඪ": { "ipa": "ɖ" },
        "ණ": { "ipa": "n" },
        "ඬ": { "ipa": "ᶯɖ" },
        "ත": { "ipa": "t̪" },
        "ථ": { "ipa": "t̪ʰ" },
        "ද": { "ipa": "d̪" },
        "ධ": { "ipa": "d̪ʰ" },
        "න": { "ipa": "n" },
        "ඳ": { "ipa": "ⁿd̪" },
        "ප": { "ipa": "p" },
        "ඵ": { "ipa": "pʰ" },
        "බ": { "ipa": "b" },
        "භ": { "ipa": "bʰ" },
        "ම": { "ipa": "m" },
        "ඹ": { "ipa": "ᵐb" },
        "ය": { "ipa": "j" },
        "ර": { "ipa": "r" },
        "ල": { "ipa": "l" },
        "ව": { "ipa": "ʋ" },
        // ⚠ ALL THREE SIBILANTS ARE /s/, AND THE SHIPPED MIXTURE (ශ→s, ෂ→ʃ) WAS AN ANALYSIS NO SOURCE HOLDS.
        // ශ (miśra śa) and ෂ (miśra ṣa) are the SAME sound as each other under every description — r12a's
        // script notes give both as /ʃ/, and Wikipedia's phonology says /ʃ/ "is found in learned borrowings
        // from Sanskrit and English" and is "commonly … replaced by /s/". So there are two coherent
        // analyses, literary (both ʃ) and colloquial (both s), and the engine had neither.
        //
        // The referee decides, four ways, on wikipron sin_sinh_narrow (648 human transcriptions):
        //     ශ=s ෂ=ʃ  607   as shipped — an analysis no source holds
        //     ශ=ʃ ෂ=ʃ  604   literary/prescriptive (r12a) — the WORST of the four
        //     ශ=s ෂ=s  612   colloquial — chosen
        //     ශ=ʃ ෂ=s  609   the inconsistent opposite
        //
        // And the referee's own words say why: ෂ is `s` in 9 of 9 (ඖෂධය → a u s ə d ə j ə, පුරුෂ, විෂ්ණු,
        // තෘෂ්ණාව …) and ශ is `s` in 6 of 9 — including ශ්‍රී → `s r iː`, the very word Wikipedia cites as
        // THE example of Sinhala /ʃ/. A written three-way distinction with no spoken basis is exactly why
        // Sinhala spellers are documented as confusing these letters.
        //
        // ⚠ The cost is that si no longer emits ʃ at all. That is the correct reading for a SPOKEN-Sinhala
        // target and it is what the only referee this language has attests; the three ʃ transcriptions it
        // does carry (බංගලාදේශය, ශිශ්නය, ශුක්‍ර) are the learned-borrowing register, and reading the whole
        // language that way costs eight words to buy three.
        "ශ": { "ipa": "s" },
        "ෂ": { "ipa": "s" },
        "ස": { "ipa": "s" },
        "හ": { "ipa": "h" },
        "ළ": { "ipa": "l" },
        "ෆ": { "ipa": "f" },
    },
    "independentVowels": {
        "අ": { "ipa": "a" },
        "ආ": { "ipa": "aː" },
        "ඇ": { "ipa": "æ" },
        "ඈ": { "ipa": "æː" },
        "ඉ": { "ipa": "i" },
        "ඊ": { "ipa": "iː" },
        "උ": { "ipa": "u" },
        "ඌ": { "ipa": "uː" },
        "එ": { "ipa": "e" },
        "ඒ": { "ipa": "eː" },
        "ඓ": { "ipa": "aᶦ" },
        "ඔ": { "ipa": "o" },
        "ඕ": { "ipa": "oː" },
        "ඖ": { "ipa": "aᶷ" },
        "ඍ": { "ipa": "ru" },
        "ඎ": { "ipa": "ruː" },
    },
    "vowelSigns": {
        "ා": { "ipa": "aː" },
        "ැ": { "ipa": "æ" },
        "ෑ": { "ipa": "æː" },
        "ි": { "ipa": "i" },
        "ී": { "ipa": "iː" },
        "ු": { "ipa": "u" },
        "ූ": { "ipa": "uː" },
        "ෙ": { "ipa": "e" },
        "ේ": { "ipa": "eː" },
        "ෛ": { "ipa": "aᶦ" },
        "ො": { "ipa": "o" },
        "ෝ": { "ipa": "oː" },
        "ෞ": { "ipa": "aᶷ" },
        "ෘ": { "ipa": "ru" },
        "ෲ": { "ipa": "ruː" },
    },
    "signs": {
        "virama": { "char": "්" },
        "anusvara": { "char": "ఀ" },
        "chandrabindu": { "char": "ఀ" },
        "visarga": { "char": "ඃ" },
        "nukta": { "char": "఼" },
    },

    // Anusvara ං is a homorganic nasal set by the FOLLOWING consonant. Each class lists the trigger consonants and
    // the nasal-coda letter (nasal + virama) that ං is rewritten to; anything else falls to "default" (ම් = m).
    "anusvara": {
        "default": "ම්",
        "classes": [
            {
                "triggers": "කඛගඝඞහ",
                "nasal": "ඞ්",
                "note": "velar + h → ŋ",
            },
            { "triggers": "චඡජඣඤ", "nasal": "ඤ්", "note": "palatal → ɲ" },
            { "triggers": "ටඨඩඪණඬ", "nasal": "ණ්", "note": "retroflex → n" },
            // ⚠ SIBILANTS WERE FALLING TO THE ම් DEFAULT, and the referee refutes it: wikipron's one
            // ං+sibilant word is පංසු → `p ə ŋ s u`, where the engine read *pˈamsu*. The corpus writes the
            // shape constantly — `අක්ෂාංශ` (latitude) and `දේශාංශ` (longitude) in every coordinate
            // sentence — and si/normalize.ts now EMITS `අංශක` (degrees) for every `°`, so the same gap
            // would have been introduced into a high-traffic reading rather than merely inherited.
            { "triggers": "ශෂස", "nasal": "ඞ්", "note": "sibilant → ŋ (referee: පංසු = p ə ŋ s u)" },
        ],
    },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Cardinal number words. Magnitudes ≥100 use the analytic multiplier form (දෙක සියය "two hundred").
    // The words are phonemized by the g2p.
    "numbers": {
        "units": [
            "බින්දුව",
            "එක",
            "දෙක",
            "තුන",
            "හතර",
            "පහ",
            "හය",
            "හත",
            "අට",
            "නවය",
        ],
        "teens": [
            "දහය",
            "එකොළහ",
            "දොළහ",
            "දහතුන",
            "දාහතර",
            "පහළොව",
            "දහසය",
            "දහහත",
            "දහඅට",
            "දහනවය",
        ],
        "tensWord": {
            "2": "විස්ස",
            "3": "තිහ",
            "4": "හතළිහ",
            "5": "පනහ",
            "6": "හැට",
            "7": "හැත්තෑව",
            "8": "අසූව",
            "9": "අනූව",
        },
        "tensStem": {
            "2": "විසි",
            "3": "තිස්",
            "4": "හතළිස්",
            "5": "පනස්",
            "6": "හැට",
            "7": "හැත්තෑ",
            "8": "අසූ",
            "9": "අනූ",
        },
        "magnitudes": {
            "hundred": "සියය",
            "thousand": "දහස",
            "lakh": "ලක්ෂය",
            "million": "මිලියනය",
        },
    },
}
