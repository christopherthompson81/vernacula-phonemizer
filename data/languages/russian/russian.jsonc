// Native canonical-IPA data manifest for Russian (ru) — standard Moscow Russian.
// This file IS the hand-authored context-free DATA: the hard/soft consonant table, the letter class sets, the
// voicing-pair maps + obstruent sets, the regressive-softening dental classes, the genitive-ɡ adverb list, the
// closed-class irregulars, the adjective-ending → lemma table, clause punctuation, and the number words. The
// ALGORITHMS that read it stay in code:
//   g2p.ts     — the Cyrillic scan (palatalization, iotation, affricate digraphs), the stress-based vowel
//                reduction (akanye/ikanye) realize pass, voicing assimilation + final devoicing, gemination
//   russian.ts — stress-dictionary lookup, ё-restoration, adjective-lemma stress inference, tokenizer
//   numbers.ts — the cardinal compositor (Slavic plural selection + тысяча feminine agreement)
// Stress is lexical → the sibling stress.tsv (word → stressed-vowel ordinal) and the loanword hard-e.tsv drive
// the g2p; those append-heavy dictionaries stay as .tsv, which the manifest only references.
//
// Format: plain JSONC. Every phoneme value is CANONICAL IPA.
{
    // ACRONYMS read letter-by-letter that the OOV phonotactic rule would leave alone. A LEXICAL fact:
    // США (x47 in the corpus) and ДНК are spelled out while СМИ and ООН are said as words, and nothing in
    // the spelling distinguishes them. Russian's lexicon is a STRESS dictionary, not a wordlist, so it
    // cannot serve as the "is this recorded" test the way CMUdict or Lexique do.
    "acronymLetters": [
        "сша", "днк", "тв", "вмс", "мвд", "фсб", "ссср", "рф", "мчс", "гибдд", "ржд",
        "мид", "пцр", "ввп", "цру"
    ],
    // Deliberately NOT listed, because they are said as WORDS and the OOV rule already leaves them alone:
    // СМИ [smʲi], ООН [ɐon], НАТО, ВУЗ, ГЭС, АЭС, ЛЭП.

    "language": "ru",
    "name": "Russian (Standard, Moscow)",
    "script": ["Cyrillic"],
    "provenance": "Authored from Russian orthography + standard Moscow phonology. This file IS the language data — the native Cyrillic G2P engine reads it directly. Stress (lexical, not spelling-derivable) comes from a stress dictionary (stress.tsv); loanword hard-е from hard-e.tsv.",

    "convention": {
        "palatalization": "hard/soft consonant pairs Cʲ; ж ш ц always hard, ч щ й always soft",
        "reduction": "akanye/ikanye — unstressed а/о → ɐ (strong) / ə; soft-context → ɪ / ə",
        "voicing": "regressive assimilation + word-final devoicing over the obstruent sequence",
        "iotation": "я/е/ё/ю after a vowel/ъ/ь/word-initial → j+V",
        "stress": "lexical (from stress.tsv); ё is inherently stressed; monosyllables carry no ˈ mark",
    },

    // The 10 vowel letters (drives vowel detection, the stress-ordinal count, and iotation).
    "vowelLetters": "аеёиоуыэюя",

    // Consonant letter → [hard, soft] IPA. ж/ш/ц are always hard; ч/щ/й always soft (both slots identical).
    "consonants": {
        "б": ["b", "bʲ"],
        "в": ["v", "vʲ"],
        "г": ["ɡ", "ɡʲ"],
        "д": ["d", "dʲ"],
        "ж": ["ʐ", "ʐ"],
        "з": ["z", "zʲ"],
        "к": ["k", "kʲ"],
        "л": ["ɫ", "lʲ"],
        "м": ["m", "mʲ"],
        "н": ["n", "nʲ"],
        "п": ["p", "pʲ"],
        "р": ["r", "rʲ"],
        "с": ["s", "sʲ"],
        "т": ["t", "tʲ"],
        "ф": ["f", "fʲ"],
        "х": ["x", "xʲ"],
        "ц": ["t͡s", "t͡s"],
        "ч": ["t͡ɕ", "t͡ɕ"],
        "ш": ["ʂ", "ʂ"],
        "щ": ["ɕː", "ɕː"],
        "й": ["j", "j"],
    },
    "alwaysHard": ["ж", "ш", "ц"],
    "alwaysSoft": ["ч", "щ", "й"],
    "softVowels": ["е", "ё", "и", "ю", "я"], // palatalize the preceding consonant
    "iotatedVowels": ["е", "ё", "ю", "я"], // → j+V after a vowel/ъ/ь/word-initial

    // Voicing pairs (final devoicing + regressive assimilation) and the obstruent-class membership sets.
    "devoice": {
        "b": "p",
        "bʲ": "pʲ",
        "v": "f",
        "vʲ": "fʲ",
        "ɡ": "k",
        "ɡʲ": "kʲ",
        "d": "t",
        "dʲ": "tʲ",
        "z": "s",
        "zʲ": "sʲ",
        "ʐ": "ʂ",
    },
    "voice": {
        "p": "b",
        "pʲ": "bʲ",
        "f": "v",
        "fʲ": "vʲ",
        "k": "ɡ",
        "kʲ": "ɡʲ",
        "t": "d",
        "tʲ": "dʲ",
        "s": "z",
        "sʲ": "zʲ",
        "ʂ": "ʐ",
        "t͡s": "d͡z",
        "t͡ɕ": "d͡ʑ",
    },
    "voicelessObstruents": [
        "p",
        "pʲ",
        "f",
        "fʲ",
        "k",
        "kʲ",
        "t",
        "tʲ",
        "s",
        "sʲ",
        "ʂ",
        "x",
        "xʲ",
        "t͡s",
        "t͡ɕ",
        "ɕː",
    ],
    "voicedObstruents": [
        "b",
        "bʲ",
        "v",
        "vʲ",
        "ɡ",
        "ɡʲ",
        "d",
        "dʲ",
        "z",
        "zʲ",
        "ʐ",
    ],

    // Regressive palatalization: dentals that soften (л excluded) before a following soft trigger.
    "softenTargets": "сзтдн",
    "softenTriggers": "тд",

    // Adverbs in -ого that KEEP [ɡ] (the genitive -ого/-его → v rule does not apply to them).
    "genitiveKeepG": [
        "много",
        "немного",
        "намного",
        "дорого",
        "недорого",
        "строго",
        "нестрого",
        "убого",
        "полого",
        "отлого",
    ],

    // Closed-class irregulars the rules can't predict (чт→ʂt, чн→ʃn, genitive -ого→v, silent letters).
    "irregulars": {
        "что": "ʂto",
        "чтобы": "ʂtˈobɨ",
        "чтоб": "ʂtop",
        "конечно": "kɐnʲˈeʃnə",
        "скучно": "skˈuʃnə",
        "его": "jɪvˈo",
        "него": "nʲɪvˈo",
        "сегодня": "sʲɪvˈodnʲə",
        "ничего": "nʲɪt͡ɕɪvˈo",
        "чей": "t͡ɕej",
        "солнце": "sˈont͡sə",
        "сердце": "sʲˈert͡sə",
        "сейчас": "sʲɪt͡ɕˈas",
        "здравствуйте": "zdrˈastvʊjtʲe",
    },

    // OOV inflected adjective/pronoun stress: strip a case ending, reconstruct the masculine lemma, transfer its
    // stress. Each ending is HARD (-ое/-ая/-ые… → lemma -ый/-ой/-ий) or SOFT (-ее/-яя/-ие… → -ий/-ый). Longest first.
    "adjectiveStress": {
        "hardLemmas": ["ый", "ой", "ий"],
        "softLemmas": ["ий", "ый"],
        "endings": [
            { "end": "ыми", "type": "hard" },
            { "end": "ими", "type": "soft" },
            { "end": "ого", "type": "hard" },
            { "end": "его", "type": "soft" },
            { "end": "ому", "type": "hard" },
            { "end": "ему", "type": "soft" },
            { "end": "ая", "type": "hard" },
            { "end": "яя", "type": "soft" },
            { "end": "ое", "type": "hard" },
            { "end": "ее", "type": "soft" },
            { "end": "ые", "type": "hard" },
            { "end": "ие", "type": "soft" },
            { "end": "ым", "type": "hard" },
            { "end": "им", "type": "soft" },
            { "end": "ых", "type": "hard" },
            { "end": "их", "type": "soft" },
            { "end": "ую", "type": "hard" },
            { "end": "юю", "type": "soft" },
            { "end": "ой", "type": "hard" },
            { "end": "ей", "type": "soft" },
            { "end": "ом", "type": "hard" },
            { "end": "ем", "type": "soft" },
        ],
    },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Cardinal number words (nominative; Slavic plural selection + тысяча feminine agreement in numbers.ts).
    "numbers": {
        "ones": [
            "ноль",
            "один",
            "два",
            "три",
            "четыре",
            "пять",
            "шесть",
            "семь",
            "восемь",
            "девять",
            "десять",
            "одиннадцать",
            "двенадцать",
            "тринадцать",
            "четырнадцать",
            "пятнадцать",
            "шестнадцать",
            "семнадцать",
            "восемнадцать",
            "девятнадцать",
        ],
        "tens": [
            "",
            "",
            "двадцать",
            "тридцать",
            "сорок",
            "пятьдесят",
            "шестьдесят",
            "семьдесят",
            "восемьдесят",
            "девяносто",
        ],
        "hundreds": [
            "",
            "сто",
            "двести",
            "триста",
            "четыреста",
            "пятьсот",
            "шестьсот",
            "семьсот",
            "восемьсот",
            "девятьсот",
        ],
        "million": ["миллион", "миллиона", "миллионов"], // one / few / many
        "thousand": ["тысяча", "тысячи", "тысяч"], // one / few / many (feminine)
        "thousandFeminine": { "one": "одна", "two": "две" }, // один→одна, два→две before тысяча
        "decimalConnector": "целых", // 3,14 → три целых…
    },

    "letterNames": {
        "а": "а", "б": "бэ", "в": "вэ", "г": "гэ", "д": "дэ", "е": "е", "ё": "ё", "ж": "жэ", "з": "зэ",
        "и": "и", "й": "и краткое", "к": "ка", "л": "эль", "м": "эм", "н": "эн", "о": "о", "п": "пэ",
        "р": "эр", "с": "эс", "т": "тэ", "у": "у", "ф": "эф", "х": "ха", "ц": "цэ", "ч": "че", "ш": "ша",
        "щ": "ща", "ы": "ы", "э": "э", "ю": "ю", "я": "я"
    },
    "phonotactics": {
        "vowels": "аеёиоуыэюя",
        "onsets": [
            "бл", "бр", "вл", "вр", "гл", "гр", "дв", "др", "жд", "зв", "зд", "кл", "кр", "пл", "пр", "сл",
            "см", "сн", "сп", "ст", "тр", "фл", "фр", "хл", "хр", "цв", "шк", "шл", "шп", "шт", "щи"
        ],
        "codas": [
            "ст", "сть", "нт", "нд", "нс", "рт", "рд", "рс", "рн", "рм", "лт", "лд", "лс", "кт", "кс",
            "пт", "фт", "зд", "зн", "сн", "см", "тр", "др", "бр", "вр", "гр", "пр", "кр", "нк", "нг"
        ]
    },

    // ---------------------------------------------------------------------------------------------------
    // THE SHARED SYMBOL TIER's data. Moved here VERBATIM, comments included: the evidence for every
    // declared unit and currency — why a one-letter symbol is or is not declared, which hazards are
    // bounded — is the part that cannot be reconstructed, so it travels with the data it explains.
    "symbols": {
        // `multiply` — this language had NO word for the sign at all. ⚠ STANDARD MATHEMATICAL REGISTER, not a
        // corpus attestation: the sweep's plausible hits were homographs of PREPOSITIONS (es `por` ×23, it `per` ×25,
        // ru `на` ×31 are all the preposition), the same trap that defeated the exponent sourcing. One word, so `by`
        // defaults to it — this language does not split dimension from product.
        "multiply": { "times": "умножить на" },
        // `&` was DROPPED outright: the corpus's `B&B` and `Arts & Sciences` lost the sign.
        // `и` ×1129 in this corpus. The tier spaces it on both sides, because `B&B` is two
        // initialisms and joining them would make one token.
        "ampersand": "и",
        "percent": ["процент", "процента", "процентов"],
        "currency": { "€": ["евро"], "$": ["доллар", "доллара", "долларов"], "£": ["фунт", "фунта", "фунтов"] },
        "units": { "км": ["километр", "километра", "километров"], "см": ["сантиметр", "сантиметра", "сантиметров"],
            "мм": ["миллиметр", "миллиметра", "миллиметров"], "кг": ["килограмм", "килограмма", "килограммов"],
            // LATIN aliases. The corpus writes Cyrillic км, but Latin `km` occurs in foreign-sourced text and
            // reached the g2p raw — "120 km/h" came out as the cluster [ˈʊkm] plus the ENGLISH letter H.
            "km": ["километр", "километра", "километров"], "cm": ["сантиметр", "сантиметра", "сантиметров"],
            "mm": ["миллиметр", "миллиметра", "миллиметров"], "kg": ["килограмм", "килограмма", "килограммов"],
            "ч": ["час", "часа", "часов"], "h": ["час", "часа", "часов"],
            // THE BARE METRE, both spellings. метров ×6 / метра ×2, and digit-adjacent bare Latin `m` is ×0 in
            // this corpus. `кубический` was already declared below but unreachable without a head noun, so
            // `120 m³` read as the letter name while `120 km³` read correctly. The apostrophe hazard that kept
            // Ukrainian's `м` out is guarded by the tier itself (`'’ʼ` are rejected after a unit key).
            "м": ["метр", "метра", "метров"], "m": ["метр", "метра", "метров"] },
        "unitPer": "в",
        "exponentWords": { "squared": ["квадратный", "квадратных"], "cubed": ["кубический", "кубических"], "position": "before" },
        // BARE EXPONENT — the reading for a power with NO unit to modify (`20²`, `mc²`), which every language
        // in the fleet was dropping silently. See `bareExponent` in core/normalizeSymbols.ts for why this cannot
        // reuse `exponentWords` above: that is the unit MODIFIER and this is the PREDICATE, and in most languages
        // they are different words (квадратных километров but двадцать в квадрате).
        // ⚠ PROVENANCE, stated because it is weaker than most data in this repo: these are STANDARD MATHEMATICAL
        // REGISTER, not corpus attestations. The power words are ×0 in this language's artifact, and the apparent
        // hits for other languages were substring traps of exactly the kind tools/normalization/attest.ts warns
        // about — th `กำลัง` matched the progressive-aspect marker, fa `توان` and ar `أس` matched inside unrelated
        // words. FLEURS is news and encyclopedia prose and simply does not contain spoken arithmetic.
        // The cardinal is used for the generic power, never the ordinal — see core for that argument.
        "bareExponent": { "squared": "{n} в квадрате", "cubed": "{n} в кубе", "power": "{n} в степени {e}" , "negative": "минус" },
        // Without these the magnitude never matched, so "$5 миллионов" hopped the currency word to the WRONG
        // side and read *пять долларов миллионов*. The inflected forms are listed because running text writes
        // the one its numeral governs (5 миллионов, 2 миллиона).
        "magnitudes": ["тысячи", "тысяч", "миллион", "миллиона", "миллионов", "миллиард", "миллиарда", "миллиардов"]
    }
}
