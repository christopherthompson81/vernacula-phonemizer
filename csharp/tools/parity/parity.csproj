<Project Sdk="Microsoft.NET.Sdk">
  <!-- ⚠ NOT in the solution on purpose: it references the engine API before the port compiles, and
       adding it early would fail the core agent's build gate. `dotnet sln add` it once Core lands. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Vernacula.Phonemizer/Vernacula.Phonemizer.csproj" />
  </ItemGroup>
</Project>
