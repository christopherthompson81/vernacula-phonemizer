<Project Sdk="Microsoft.NET.Sdk">
  <!-- ⚠ NOT in the solution on purpose: it references the engine API before the port compiles, and
       adding it early would fail the core agent's build gate. `dotnet sln add` it once Core lands. -->
  <!-- ⚠ NEVER set InvariantGlobalization here. It makes string.Normalize a SILENT NO-OP, so every NFC/NFD
       fold in the engine stops working and the gate reports the engine as broken: qu alone went from 2
       failing rows to 20, with `aći` reading as *at͡ɕi* because the nativiser's fold could not decompose it.
       The engine now refuses to start in that mode (Phonemizer's globalization guard), so this cannot
       silently come back. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Vernacula.Phonemizer/Vernacula.Phonemizer.csproj" />
  </ItemGroup>
</Project>
