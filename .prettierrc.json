{
  "printWidth": 120,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "printWidth": 110,
        "proseWrap": "preserve"
      }
    },
    {
      "files": "*.jsonc",
      "options": {
        "parser": "json5",
        "quoteProps": "preserve"
      }
    }
  ],
  "quoteProps": "preserve"
}
