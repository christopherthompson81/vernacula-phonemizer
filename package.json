{
  "name": "vernacula-phonemizer",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "src",
    "LICENSES",
    "NOTICE.md",
    "!src/**/*.scratch.*",
    "!src/**/*.log",
    "!src/**/__pycache__"
  ],
  "description": "Canonical-IPA phonemizer \u2014 native, rule- and lexicon-based. Hindi, English, Mandarin, Spanish, Arabic.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "node tools/check-package-fence.mjs",
    "ci": "npm run typecheck && npm test && npm run check:package"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=22.3"
  },
  "workspaces": [
    "data"
  ],
  "dependencies": {
    "vernacula-phonemizer-data": "0.1.0"
  }
}
