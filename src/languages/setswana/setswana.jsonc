// Native canonical-IPA data manifest for Setswana / Tswana (tn) — Bantu (Sotho-Tswana, S31; Botswana + South
// Africa, ~14M), the Latin orthography, espeak-independent. A greedy longest-match scan (Chichewa pattern):
// Setswana is open CV with the syllabic-nasal + C clusters as onset units, so a pure left-to-right longest match
// suffices. Referee: epitran tsn-Latn (INDEPENDENT, programmatic). Phonology from Mistry (Cole 1955) + epitran.
// Signatures (where we AGREE with epitran): ⟨kg⟩→k͡χʰ, ⟨kh⟩→kʰ, ⟨tlh⟩→t͡ɬʰ, ⟨tl⟩→t͡ɬ, ⟨tsh⟩→t͡sʰ, ⟨tš/š⟩→t͡ʃ/ʃ,
// ⟨ph th⟩→pʰ tʰ, ⟨ng⟩→ŋ, ⟨j⟩→d͡ʒ. Where we DIVERGE (we are more correct, epitran is naive):
//   • ⟨g⟩ → [χ] — Setswana has NO /g/ phoneme (*g lenited to Ø historically); single ⟨g⟩ is the voiceless UVULAR
//     fricative /χ/ (Matlhaku 2020, Wikipedia: ⟨gana⟩ [χana] 'refuse'; [x]~[h] by variety). epitran emits plain
//     [g] — WRONG. Folded χ~x~g. ⟨ny⟩→ɲ (epitran emits n+glide) is the other correction.
// VOWELS are the standard 7-vowel system /i ɪ ɛ a ɔ ʊ u/ (Cole 1955; DALL 1999; Matlhaku 2020): ⟨e⟩→ɪ, ⟨o⟩→ʊ
// (near-close), ⟨ê⟩→ɛ, ⟨ô⟩→ɔ (open-mid), ⟨i a u⟩→i a u. Some dialects add close-mid /e o/ (the further raising of
// ⟨e o⟩ before high vowels) — that finer height is dialectal/underdetermined, folded ɪ~ɛ~e / ʊ~ɔ~o for scoring.
// DEFERRED (genuinely unrecoverable from the standard orthography, confirmed by modern sources):
//   • TONE (H/L) is LEXICAL (only high tones underlying; Zerbian & Kügler 2021, Creissels) and UNWRITTEN — which
//     syllable is H is a lexical fact absent from the spelling, and no toned lexicon exists → not emitted (as nya).
//   • The EJECTIVE realization of p/t/k/tl/ts is post-nasal strengthening + a seNgwato-dialect trait (Matlhaku
//     2020), NOT the citation form → we emit PLAIN (epitran-corroborated).
// See docs/investigations/tn_native_bringup_investigation.md.
{
    "language": "tn",
    "name": "Setswana (Tswana)",
    "script": "Latin",
    "provenance": "Authored from the Setswana orthography + Mistry (Cole 1955) phonology. Referee: epitran tsn-Latn.",

    "convention": {
        "g": "single ⟨g⟩ → [χ] (voiceless UVULAR fricative; NO /g/ phoneme — epitran's plain [g] is wrong, folded χ~x~g)",
        "dorsalAspirates": "⟨kg⟩→k͡χʰ (uvular, consistent w/ g→χ), ⟨kh⟩→kʰ (complementary: kh before i/u, kg elsewhere — orthography already picks)",
        "laterals": "⟨tl⟩→t͡ɬ, ⟨tlh⟩→t͡ɬʰ (lateral affricates)",
        "sibilants": "⟨tš⟩→t͡ʃ, ⟨š⟩→ʃ, ⟨tšh⟩→t͡ʃʰ, ⟨sh⟩→ʃ (RSA/citation values; Botswana merges tš/š→ts/s)",
        "vowels": "7-vowel /i ɪ ɛ a ɔ ʊ u/: ⟨e⟩→ɪ, ⟨o⟩→ʊ (near-close), ⟨ê⟩→ɛ, ⟨ô⟩→ɔ. Dialectal close-mid /e o/ raising folded",
        "tone": "H/L tone is LEXICAL + UNWRITTEN → DEFERRED (no toned lexicon; Zerbian & Kügler 2021)",
        "ejectives": "p/t/k/tl/ts ejective only post-nasally + seNgwato dialect (Matlhaku 2020) → emitted PLAIN"
    },

    // Orthography → canonical IPA. The scanner sorts keys by LENGTH DESC (⟨tšh tsh tlh⟩ → ⟨tš ts tl ph…⟩ → singles).
    "graphemes": {
        "tšh": "t͡ʃʰ", "tsh": "t͡sʰ", "tlh": "t͡ɬʰ",
        "tš": "t͡ʃ", "ts": "t͡s", "tl": "t͡ɬ",
        "ph": "pʰ", "th": "tʰ", "kh": "kʰ", "kg": "k͡χʰ", "sh": "ʃ", "ng": "ŋ", "ny": "ɲ",
        "š": "ʃ", "j": "d͡ʒ", "y": "j", "g": "χ",
        "b": "b", "d": "d", "f": "f", "h": "h", "k": "k", "l": "l", "m": "m",
        "n": "n", "p": "p", "r": "r", "s": "s", "t": "t", "v": "v", "w": "w",
        "a": "a", "e": "ɪ", "ê": "ɛ", "i": "i", "o": "ʊ", "ô": "ɔ", "u": "u"
    },

    "clausePunctuation": {
        ".": " . ", "!": " ! ", "?": " ? ", "…": " … ", ",": " , ", ";": " ; ", ":": " : "
    },

    // Cardinal number words (Mistry Cycle 29 bo-counting series). 8/9 are the two-word "bofera …" forms (bent
    // fingers); tens/hundreds multiply with the ma- forms (7/8/9 → participial -ang). Composition: descending,
    // joined by ⟨le⟩ "and"; ⟨masome/makgolo a …⟩ = "tens/hundreds of …". Thousands (dikete tse …) best-effort;
    // ≥10⁴ degrades to digit-by-digit. Numbers are UNMEASURED (the referee is word-only) — best effort.
    "numbers": {
        "zero": "lefela",
        "units": ["", "bongwe", "bobedi", "boraro", "bone", "botlhano", "borataro", "bosupa", "bofera bobedi", "bofera bongwe"],
        "ten": "lesome",
        "tensWord": "masome",
        "mult": ["", "", "mabedi", "mararo", "mane", "matlhano", "marataro", "supang", "ferang bobedi", "ferang bongwe"],
        "hundred": "lekgolo",
        "hundredsWord": "makgolo",
        "thousand": "sekete",
        "thousandsWord": "dikete",
        "diMult": ["", "", "pedi", "tharo", "nne", "tlhano", "thataro", "supa", "robedi", "robongwe"],
        "and": "le",
        "of": "a",
        "these": "tse"
    }
}
