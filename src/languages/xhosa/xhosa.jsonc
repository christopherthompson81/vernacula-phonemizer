// Native canonical-IPA data manifest for Xhosa (xh, isiXhosa) — Nguni Bantu, Latin script, AUTHORED.
// Xhosa is the sibling of Zulu (zu) — a near-identical click-and-depressor inventory — so it REUSES the Zulu g2p
// scan (toSegments) and the Nguni penultimate-stress/length logic, differing only in DATA: it adds ⟨rh⟩→[x] (the
// voiceless velar fricative, from the Khoisan substrate — Zulu lacks it), and carries the Xhosa number words
// (6–9 differ from Zulu). Every phoneme value is CANONICAL IPA (the census click set ǀ ǃ ǁ).
{
    "language": "xh",
    "name": "Xhosa (isiXhosa)",
    "script": ["Latin"],
    "provenance": "Authored; the Nguni sibling of Zulu. IPA + inventory from the Zulu authored rules (epitran xho-Latn + wikipron xho + kaikki referees) + the Xhosa ⟨rh⟩→[x]. This file IS the language data — the shared Nguni rule engine reads it directly.",

    "convention": {
        "clicks": "15-way series: c/q/x → kǀ/kǃ/kǁ; aspirated ch/qh/xh; depressor gc/gq/gx; nasal nc/nq/nx; etc.",
        "rh": "⟨rh⟩ → [x] (voiceless velar fricative, the Xhosa-specific Khoisan reflex Zulu lacks)",
        "implosive": "b → ɓ (plain b only after m: mb = [mb])",
        "ejective": "plain voiceless stops p/t/k → pʼ/tʼ/kʼ; aspirates ph/th/kh → pʰ/tʰ/kʰ",
        "depressor": "voiced obstruents carry the breathy diacritic ̤ (g→ɡ̤, d→d̤, z→z̤)",
        "stress": "Nguni penultimate — the penult vowel takes ˈ and length ː",
        "tone": "lexical (H/L) and unwritten → DEFERRED (Xhosa words are left untoned; the referee eval folds tone)",
    },

    // Orthography → IPA, LONGEST-match. Identical to the Zulu table except ⟨rh⟩→[x] (before the bare ⟨r⟩).
    "rules": [
        ["tshh", "t͡ʃʰ", false],
        ["thsh", "t͡ʃʰ", false],
        ["ntsh", "ɲt͡ʃʼ", false],
        ["nkc", "ŋǀʼ", false],
        ["nkx", "ŋǁʼ", false],
        ["nkq", "ŋǃʼ", false],
        ["ngc", "ŋ̤ǀ", false],
        ["ngx", "ŋ̤ǁ", false],
        ["ngq", "ŋ̤ǃ", false],
        ["tsh", "t͡ʃʼ", false],
        ["ths", "t͡sʰ", false],
        ["tyh", "cʰ", false],
        ["bh", "b̤", false],
        ["ch", "kǀʰ", false],
        ["dl", "ɮ̤", false],
        ["dy", "ɟ̤", false],
        ["gc", "ɡ̤ǀ", false],
        ["gx", "ɡ̤ǁ", false],
        ["gq", "ɡ̤ǃ", false],
        ["gr", "ɣ̤", false],
        ["hh", "ɦ̤", false],
        ["hl", "ɬ", false],
        ["kh", "kʰ", false],
        ["kl", "k͡xʼ", false],
        ["mb", "mb", false],
        ["nc", "ŋǀ", false],
        ["nx", "ŋǁ", false],
        ["nq", "ŋǃ", false],
        ["ng", "ŋɡ̤", false],
        ["ny", "ɲ", false],
        ["nj", "ɲd͡ʒ̤", false],
        ["nk", "ŋkʼ", false],
        ["ph", "pʰ", false],
        ["qh", "kǃʰ", false],
        ["rh", "x", false],
        ["sh", "ʃ", false],
        ["th", "tʰ", false],
        ["ts", "t͡sʼ", false],
        ["ty", "cʼ", false],
        ["xh", "kǁʰ", false],
        ["a", "a", true],
        ["e", "ɛ", true],
        ["i", "i", true],
        ["o", "ɔ", true],
        ["u", "u", true],
        ["b", "ɓ", false],
        ["c", "kǀ", false],
        ["d", "d̤", false],
        ["f", "f", false],
        ["g", "ɡ̤", false],
        ["h", "h", false],
        ["j", "d͡ʒ̤", false],
        ["k", "kʼ", false],
        ["l", "l", false],
        ["m", "m", false],
        ["n", "n", false],
        ["p", "pʼ", false],
        ["q", "kǃ", false],
        ["r", "r", false],
        ["s", "s", false],
        ["t", "tʼ", false],
        ["v", "v̤", false],
        ["w", "w", false],
        ["x", "kǁ", false],
        ["y", "j", false],
        ["z", "z̤", false],
    ],

    "toneChao": { "H": "˥", "L": "˩", "F": "˥˩", "R": "˩˥" },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // Cardinal number words — agglutinative Nguni, as Zulu, but the Xhosa 2 is -bini (not -bili) and 6–9 differ
    // (isithandathu, isixhenxe, isibhozo, ithoba). Approximate for the higher multipliers (numbers are minor here).
    "numbers": {
        "ku": ["", "kunye", "kubini", "kuthathu", "kune", "kuhlanu", "isithandathu", "isixhenxe", "isibhozo", "ithoba"],
        "na": ["", "nanye", "nambini", "nantathu", "nane", "nanhlanu", "nesithandathu", "nesixhenxe", "nesibhozo", "nethoba"],
        "ama": ["", "", "amabini", "amathathu", "amane", "amahlanu", "asithandathu", "asixhenxe", "asibhozo", "athoba"],
        "zero": "iqanda",
        "ten": { "one": "ishumi", "many": "amashumi" },
        "hundred": { "one": "ikhulu", "many": "amakhulu" },
        "thousand": { "one": "iwaka", "many": "amawaka" },
        "million": { "one": "isigidi", "many": "izigidi" },
    },
}
