// Native canonical-IPA data manifest for Lao (lo) — ພາສາລາວ, Tai (Tai-Kadai), ~30M incl. Isan speakers,
// the LAO ABUGIDA (U+0E80–0EFF). Lao is a sibling of Thai but with a MORE PHONEMIC orthography (the
// Lao-PDR reforms stripped most Indic etymological spelling), so a leaner rule g2p suffices — no
// Sanskrit-reading dictionary. Like Thai: leading vowels (ເ ແ ໂ ໃ ໄ) are written BEFORE the consonant and
// reordered; the vowel is a (often discontinuous) pattern of signs around the onset; tone is computed from
// consonant CLASS × live/dead × length × tone mark (Vientiane values, derived empirically from the kaikki
// Chao contours). Tones are Chao contour letters (stripped by the eval backbone).
// WHAT IS DATA AND WHAT IS CODE. This file holds the letter values, the vowel PATTERN table and the tone
// table; lao.ts holds the ALGORITHMS that read them — the leading-vowel reorder pass, the ຫ-led cluster
// handling, the syllable scanner and the ordered first-match walk over the patterns below. (Until this was
// refactored the vowel and tone tables lived in lao.ts as if-chains, on the stated grounds that they were
// "positional logic, not lookups". Reading them settled it: all 37 vowel branches were literal character
// comparisons, and every sibling abugida in this tree — thai, burmese, shan, khmer, tibetan — already
// carries both as data.)
{
    "language": "lo",
    "name": "Lao (ພາສາລາວ)",
    "script": ["Lao"],

    // Onset consonant → [IPA, tonal class]. ຫ/ຮ = h; ອ = glottal ʔ; ວ onset = w. The ຫ-led sonorants
    // (ໜ ໝ, ຫຼ ຫງ …) become HIGH class — handled in the scanner (lao.ts).
    "onsets": {
        "ກ": ["k", "mid"], "ຂ": ["kʰ", "high"], "ຄ": ["kʰ", "low"], "ງ": ["ŋ", "low"],
        "ຈ": ["t͡ɕ", "mid"], "ສ": ["s", "high"], "ຊ": ["s", "low"], "ຍ": ["ɲ", "low"],
        "ດ": ["d", "mid"], "ຕ": ["t", "mid"], "ຖ": ["tʰ", "high"], "ທ": ["tʰ", "low"],
        "ນ": ["n", "low"], "ບ": ["b", "mid"], "ປ": ["p", "mid"], "ຜ": ["pʰ", "high"],
        "ຝ": ["f", "high"], "ພ": ["pʰ", "low"], "ຟ": ["f", "low"], "ມ": ["m", "low"],
        "ຢ": ["j", "mid"], "ຣ": ["l", "low"], "ລ": ["l", "low"], "ວ": ["ʋ", "low"],
        "ຫ": ["h", "high"], "ອ": ["ʔ", "mid"], "ຮ": ["h", "low"],
        "ໜ": ["n", "high"], "ໝ": ["m", "high"], // precomposed ຫນ/ຫມ
    },

    // ⚠ THE LEADING VOWEL SIGNS ⟨ເ ແ ໂ ໃ ໄ⟩ — written BEFORE the consonant they follow in speech. lao.ts
    // reorders them to after their consonant (cluster) first, so the rest of the scan can read strictly
    // left to right. This is the abugida's one visual/phonetic inversion.
    "leadingVowels": ["ເ", "ແ", "ໂ", "ໃ", "ໄ"],

    // The SONORANTS that ⟨ຫ⟩ leads. Lao tone is determined by the onset's CLASS, and the sonorants are
    // low-class on their own; a preceding silent ⟨ຫ⟩ raises the pair to HIGH class (ຫນ = ໜ, ຫມ = ໝ).
    // ⚠ ⟨ຫ⟩ + anything NOT in this list is a real ⟨ຫ⟩ onset, not a class-raising lead — which is exactly
    // what this list exists to decide.
    "hLedSonorants": ["ງ", "ຍ", "ນ", "ມ", "ລ", "ວ"],

    // The four TONE MARKS. They are not tones themselves: the tone is a lookup on (class × live/dead ×
    // length × mark), which is the "tone" table below; the resolver that walks it is in lao.ts.
    "toneMarks": ["່", "້", "໊", "໋"],

    // ⚠ THE VOWEL PATTERNS, AS AN ORDERED FIRST-MATCH LIST. This is the crux of Lao g2p: a vowel is a
    // (often discontinuous) pattern of signs around the onset, so the key is the leading vowel ⟨pre⟩ — if
    // any — plus the signs that FOLLOW the onset, and the number of following characters consumed is the
    // length of "signs".
    //
    // ⚠ ORDER IS SEMANTIC, NOT COSMETIC. The list is walked top-down and the first match wins, so a longer
    // pattern MUST precede any shorter one it starts with (ົະ before ົ, າະ before າ, ັຽ before ັ). Sorting
    // this list alphabetically would silently change the language.
    //
    // ⚠ EACH ⟨pre⟩ GROUP ENDS IN A CATCH-ALL with empty "signs", which is what makes a leading vowel with no
    // following sign read as its own long vowel (ເ → eː) — and is also why a ⟨pre⟩ word never falls through
    // to the non-leading group below. The entries with no "pre" apply only when there is no leading vowel;
    // matching nothing at all means the syllable takes its inherent vowel, which lao.ts supplies.
    "vowelPatterns": [
        // ໄC / ໃC → aj. The leading vowel is the whole nucleus and consumes no following sign.
        { "pre": "ໄ", "signs": "", "q": "a", "glide": "j" },
        { "pre": "ໃ", "signs": "", "q": "a", "glide": "j" },

        // ⟨ເ⟩ — the busiest group, and the one whose ordering matters most.
        { "pre": "ເ", "signs": "ົາ", "q": "a", "glide": "w" },        // ເ◌ົາ → aw
        { "pre": "ເ", "signs": "ຶອ", "q": "ɯːə" },                    // ເ◌ຶອ → ɯːə
        { "pre": "ເ", "signs": "ຶ", "q": "ɯːə" },                     // …and the ອ-less spelling of it
        { "pre": "ເ", "signs": "ືອ", "q": "ɯːə" },                    // ເ◌ືອ → ɯːə
        { "pre": "ເ", "signs": "ຍ", "q": "iːə" },                     // ເ◌ຍ → iːə
        { "pre": "ເ", "signs": "ິ", "q": "ɤ" },                       // ເ◌ິ → ɤ
        { "pre": "ເ", "signs": "ີ", "q": "ɤ", "long": true },         // ເ◌ີ → ɤː
        { "pre": "ເ", "signs": "າະ", "q": "ɔ" },                      // ເ◌າະ → ɔ
        { "pre": "ເ", "signs": "ະ", "q": "e" },                       // ເ◌ະ → e
        { "pre": "ເ", "signs": "ັຽ", "q": "iːə" },                    // ເ◌ັຽ → iːə (ເຊັຽ → siːə)
        { "pre": "ເ", "signs": "ັຍ", "q": "iːə" },                    // …and its ຍ spelling
        { "pre": "ເ", "signs": "ັ", "q": "e" },                       // ເ◌ັC → e (closed short)
        { "pre": "ເ", "signs": "", "q": "e", "long": true },          // ເ → eː

        { "pre": "ແ", "signs": "ະ", "q": "ɛ" },
        { "pre": "ແ", "signs": "ັ", "q": "ɛ" },
        { "pre": "ແ", "signs": "", "q": "ɛ", "long": true },          // ແ → ɛː

        { "pre": "ໂ", "signs": "ະ", "q": "o" },
        { "pre": "ໂ", "signs": "ັ", "q": "o" },
        { "pre": "ໂ", "signs": "", "q": "o", "long": true },          // ໂ → oː

        // NON-LEADING: signs written after / above / below the consonant.
        // ⚠ ວາ IS A VOWEL, NOT A kʷ CLUSTER (ຄວາຍ → kʰuːəj) — which is why it heads this group.
        { "signs": "ວາ", "q": "uːə" },
        { "signs": "ົວ", "q": "uːə" },
        { "signs": "ົະ", "q": "o" },                                  // rare
        { "signs": "ັ", "q": "a" },                                   // ◌ັC → a (closed short, mai kan)
        { "signs": "ົ", "q": "o" },                                   // ◌ົC → o (closed short, mai kong)
        { "signs": "ະ", "q": "a" },
        { "signs": "າະ", "q": "a" },
        { "signs": "າ", "q": "a", "long": true },
        { "signs": "ຳ", "q": "a", "glide": "m" },                     // ◌ຳ → am
        { "signs": "ິ", "q": "i" },
        { "signs": "ີ", "q": "i", "long": true },
        { "signs": "ຶ", "q": "ɯ" },
        { "signs": "ື", "q": "ɯ", "long": true },
        { "signs": "ຸ", "q": "u" },
        { "signs": "ູ", "q": "u", "long": true },
        { "signs": "ໍ", "q": "ɔ", "long": true },                     // ◌ໍ → ɔː
        { "signs": "ຽ", "q": "iːə" },
        { "signs": "ອ", "q": "ɔ", "long": true },                     // C + ອ → ɔː (ອ as a vowel)
        { "signs": "ວ", "q": "uːə" },                                 // C + ວ → uːə (open)
    ],

    // ⚠ THE TONE TABLE — Vientiane Lao (the Wiktionary Module:lo-pron system), DERIVED empirically from the
    // kaikki Chao contours: LOW ˩ · RISING ˧˥ · MID ˧ · HIGH-FALLING ˥˨ · LOW-FALLING ˧˩. A written tone
    // MARK overrides the computed tone outright; otherwise the tone is (live | dead-long | dead-short) ×
    // the onset's CLASS. Only "low" ever differs from the other two classes, so each row is a low value
    // and a default rather than three entries.
    "tone": {
        "marks": {
            "່": { "default": "˧" },                                  // mai ek → mid, all classes
            "້": { "low": "˥˨", "mid": "˥˨", "high": "˧˩" },          // mai tho → high: low-falling; else high-falling
            "໊": { "default": "˥" },                                  // mai ti (rare) → high
            "໋": { "default": "˧˥" },                                 // mai catawa (rare) → rising
        },
        "live": { "low": "˧˥", "default": "˩" },                      // live → low: rising; high/mid: low
        "deadLong": { "low": "˥˨", "default": "˧˩" },                 // dead-long → low: high-falling; else low-falling
        "deadShort": { "low": "˧", "default": "˧˥" },                 // dead-short → low: mid; high/mid: rising
    },

    // Final (coda) consonant → IPA. Lao has the 8-way final set (stops unreleased; sonorants + glides).
    "codas": {
        "ກ": "k̚", "ດ": "t̚", "ບ": "p̚", "ງ": "ŋ", "ນ": "n", "ມ": "m", "ຍ": "j", "ວ": "w",
    },

    // Cardinal number words (LAO-SCRIPT spellings — the compositor reads them back through the ordinary
    // g2p, so no IPA is authored here). Lao is Tai, structurally the Thai system (see thai.ts) with the
    // cognate irregulars: 20 is ຊາວ — and it REPLACES the whole "twenty" (ຊາວສອງ = 22, no ສິບ), unlike Thai
    // ຢີ່ສິບ; a FINAL 1 in any compound ≥11 is ເອັດ (ສິບເອັດ, ຊາວເອັດ); 10⁴ ໝື່ນ and 10⁵ ແສນ are their own
    // magnitude words. Source: Wiktionary "Category:Lao numerals" (the full 0–99 + ຮ້ອຍ / ພັນ / ໝື່ນ / ແສນ /
    // ລ້ານ inventory, incl. ຊາວ, ຊາວເອັດ, ສິບເອັດ).
    "numbers": {
        "units": ["ສູນ", "ໜຶ່ງ", "ສອງ", "ສາມ", "ສີ່", "ຫ້າ", "ຫົກ", "ເຈັດ", "ແປດ", "ເກົ້າ"],
        "ten": "ສິບ",
        "twenty": "ຊາວ",
        "finalOne": "ເອັດ",
        "magnitudes": [[1000000, "ລ້ານ"], [100000, "ແສນ"], [10000, "ໝື່ນ"], [1000, "ພັນ"], [100, "ຮ້ອຍ"]],
    },
}
