// Native canonical-IPA definition for Chittagonian / চাটগাঁইয়া (ctg) — Eastern Indo-Aryan, Bengali-Assamese script.
// ⛔ CANNOT-VERIFY. Chittagonian has NO independent phonetic referee (no wikipron/epitran/kaikki; <10 Wiktionary IPA
// entries; no JIPA Illustration; no accessible phonology grammar — Moniruzzaman 2007 / Hai 1965 are cited but out of
// reach). It IS a distinct language, but described almost entirely COMPARATIVELY against Bengali (high mutual
// intelligibility), so — per the fleet's Assamese pattern — it REUSES the Bengali engine (makeNativeBengali) with a
// Chittagonian override manifest carrying only the DOCUMENTED divergences. Authored from two COMPARATIVE sources
// (Uddin, "Chittagonian Variety: Dialect, Language, or Semi-Language?", IIUC Studies 12; and a Wikipedia-derived
// overview — both drawing on Moniruzzaman 2007), which independently corroborate the spirantisation signature +
// inventory and the loss of the voiced aspirates. What is NOT documented (the voiceless dental/retroflex aspirates,
// the vowels) is left Bengali-conservative and disclosed. See
// docs/investigations/ctg_native_bringup_investigation.md.
//
// DOCUMENTED divergences applied (grounded in the paper's inventory ɸ f x ɣ z + affricate /t͡s/ + [s]/[ʃ] contrast):
//   • SPIRANTISATION of the VOICELESS velar/labial aspirates: খ [kʰ]→[x] (xabar), ফ [pʰ]→[f]. (The signature —
//     Chittagonian fricatives where Bengali has aspirated stops.)
//   • DEAFFRICATION: চ ছ → [s], জ ঝ য → [z] (Bengali keeps t͡ʃ/d͡ʒ).
//   • the [s]/[ʃ] CONTRAST: স → [s] (Bengali merges all three sibilants to [ʃ]); শ ষ stay [ʃ].
//   • LOSS OF THE VOICED ASPIRATES (Uddin: "lost all the voiced aspirates"): ঘ→[ɡ], ধ→[d̪], ঢ→[ɖ], ভ→[b] (bát ভাত), ঝ→[z].
//   • contrastive NASALISATION (আর [ar] 'and' vs আঁর [ãr] 'my') via the candrabindu — handled by the Bengali engine.
// NOT applied (undocumented → kept Bengali): the VOICELESS dental/retroflex aspirates থ ঠ (no homorganic fricative), the vowel qualities.
{
    "language": "ctg",
    "name": "Chittagonian (চাটগাঁইয়া)",
    "script": "Bengali",
    "provenance": "⛔ cannot-verify. Bengali engine + the DOCUMENTED Chittagonian spirantisation/deaffrication (Uddin, IIUC Studies 12, from Moniruzzaman 2007). No independent referee; hand-gold on the distinctive features only.",

    "inherentVowel": "ɔ",
    // The Bengali whole-word LEXICON must NOT leak Bengali pronunciations onto Chittagonian (it would keep খবর as
    // [kʰɔboɾ], undoing the খ→x spirantisation). Disabled, as for Assamese.
    "skipLexicon": true,

    "consonants": {
        "ক": { "ipa": "k", "note": "velar stop, voiceless" },
        "খ": { "ipa": "x", "note": "SPIRANTISED to [x] velar fricative — the Chittagonian signature (Bengali kʰ; xabar খবর)" },
        "গ": { "ipa": "ɡ", "note": "velar stop, voiced" },
        "ঘ": { "ipa": "ɡ", "note": "DEASPIRATED to [ɡ] — Chittagonian lost the voiced aspirates (Bengali ɡʱ)" },
        "ঙ": { "ipa": "ŋ", "note": "velar nasal" },
        "চ": { "ipa": "s", "note": "DEAFFRICATED → [s] (Bengali t͡ʃ; the paper's /t͡s/~[s])" },
        "ছ": { "ipa": "s", "note": "DEAFFRICATED → [s] (Bengali t͡ʃʰ)" },
        "জ": { "ipa": "z", "note": "DEAFFRICATED → [z] (Bengali d͡ʒ)" },
        "ঝ": { "ipa": "z", "note": "DEAFFRICATED → [z] (Bengali d͡ʒʱ)" },
        "ঞ": { "ipa": "n", "note": "palatal nasal → [n]" },
        "ট": { "ipa": "ʈ", "note": "retroflex stop (kept Bengali — undocumented for ctg)" },
        "ঠ": { "ipa": "ʈʰ", "note": "retroflex aspirate (kept Bengali)" },
        "ড": { "ipa": "ɖ", "note": "retroflex, voiced (kept Bengali)" },
        "ঢ": { "ipa": "ɖ", "note": "DEASPIRATED (lost voiced aspirate; Bengali ɖʱ)" },
        "ণ": { "ipa": "n", "note": "retroflex nasal → [n]" },
        "ত": { "ipa": "t̪", "note": "dental stop (kept Bengali)" },
        "থ": { "ipa": "t̪ʰ", "note": "dental aspirate (kept Bengali — undocumented for ctg)" },
        "দ": { "ipa": "d̪", "note": "dental, voiced (kept Bengali)" },
        "ধ": { "ipa": "d̪", "note": "DEASPIRATED (lost voiced aspirate; Bengali d̪ʱ)" },
        "ন": { "ipa": "n", "note": "alveolar nasal" },
        "প": { "ipa": "p", "note": "labial stop, voiceless" },
        "ফ": { "ipa": "f", "note": "SPIRANTISED to [f] labiodental fricative — signature (Bengali pʰ)" },
        "ব": { "ipa": "b", "note": "labial stop, voiced" },
        "ভ": { "ipa": "b", "note": "DEASPIRATED to [b] — lost voiced aspirate (Bengali bʱ; the paper's bát ভাত)" },
        "ম": { "ipa": "m", "note": "labial nasal" },
        "য": { "ipa": "z", "note": "ja → [z] (deaffrication; Bengali d͡ʒ)" },
        "র": { "ipa": "ɾ", "note": "rhotic tap (kept Bengali)" },
        "ল": { "ipa": "l", "note": "alveolar lateral" },
        "শ": { "ipa": "ʃ", "note": "sibilant [ʃ] (Chittagonian keeps the [s]/[ʃ] contrast)" },
        "ষ": { "ipa": "ʃ", "note": "sibilant [ʃ]" },
        "স": { "ipa": "s", "note": "sibilant → [s] — the [s]/[ʃ] CONTRAST (Bengali merges all three to ʃ)" },
        "হ": { "ipa": "ɦ", "note": "voiced glottal fricative (kept Bengali)" },
        "ড়": { "ipa": "ɽ", "note": "retroflex flap" },
        "ঢ়": { "ipa": "ɽ", "note": "DEASPIRATED retroflex flap (lost voiced aspirate)" },
        "য়": { "ipa": "j", "note": "ya with nukta → glide [j]" },
        "ৎ": { "ipa": "t̪", "note": "khanda ta → final dental [t], no inherent vowel" },
    },

    "independentVowels": {
        "অ": { "ipa": "ɔ", "note": "inherent" },
        "আ": { "ipa": "a" },
        "ই": { "ipa": "i" },
        "ঈ": { "ipa": "i" },
        "উ": { "ipa": "u" },
        "ঊ": { "ipa": "u" },
        "ঋ": { "ipa": "ɾi" },
        "এ": { "ipa": "e" },
        "ঐ": { "ipa": "ɔi" },
        "ও": { "ipa": "o" },
        "ঔ": { "ipa": "ɔu" },
    },

    "vowelSigns": {
        "া": { "ipa": "a" },
        "ি": { "ipa": "i" },
        "ী": { "ipa": "i" },
        "ু": { "ipa": "u" },
        "ূ": { "ipa": "u" },
        "ৃ": { "ipa": "ɾi" },
        "ে": { "ipa": "e" },
        "ৈ": { "ipa": "ɔi" },
        "ো": { "ipa": "o" },
        "ৌ": { "ipa": "ɔu" },
    },

    "signs": {
        "virama": { "char": "্", "effect": "suppressInherentVowel", "note": "hôxôntô — conjuncts" },
        "anusvara": { "char": "ং", "effect": "velarNasal", "note": "ং → [ŋ]" },
        "chandrabindu": { "char": "ঁ", "effect": "nasalizeVowel", "note": "nasalizes the vowel — CONTRASTIVE in ctg (আর ar vs আঁর ãr)" },
        "visarga": { "char": "ঃ", "effect": "appendH", "note": "→ [h] (rare)" },
        "nukta": { "char": "়", "effect": "composeNukta", "note": "combines with ড়/ঢ়/য়" },
    },

    // NUMBERS — Chittagonian number words are undocumented; the Bengali spellings are a DISCLOSED placeholder, run
    // through the ctg G2P (so they carry the spirantisation but are not attested ctg forms). Numbers are unmeasured.
    "numbers": {
        "units": ["শূন্য", "এক", "দুই", "তিন", "চার", "পাঁচ", "ছয়", "সাত", "আট", "নয়"],
        "teens": ["দশ", "এগারো", "বারো", "তেরো", "চৌদ্দ", "পনেরো", "ষোল", "সতেরো", "আঠারো", "উনিশ"],
        "tens": {
            "20": "বিশ", "30": "ত্রিশ", "40": "চল্লিশ", "50": "পঞ্চাশ",
            "60": "ষাট", "70": "সত্তর", "80": "আশি", "90": "নব্বই"
        },
        "magnitudes": { "hundred": "একশ", "thousand": "হাজার", "lakh": "লাখ", "crore": "কোটি" },
        "decimalWord": "দশমিক"
    },

    "clausePunctuation": {
        "।": " । ", "॥": " ॥ ", ".": " . ", "?": " ? ", "!": " ! ", ",": " , ", ";": " ; ", ":": " : "
    }
}
