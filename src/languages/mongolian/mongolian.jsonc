// Native canonical-IPA data manifest for Standard Khalkha Mongolian (mn) — Cyrillic.
// This file IS the hand-authored language DATA: the vowel / long-vowel / diphthong / consonant letter→IPA tables,
// the back-harmony trigger set, and clause punctuation. The ALGORITHMS that read it stay in code:
//   g2p.ts        — greedy longest-match Cyrillic scan (diphthongs/long vowels before singles), harmony (г/х/reduced-
//                   vowel quality), final н→ŋ, palatalizing ь, iotated е/ё/я/ю; tags each nucleus short/long/diphthong
//   mongolian.ts  — the DEEP-orthography rules: non-initial SHORT-vowel reduction→ə / word-final deletion, final
//                   obstruent devoicing (в→f, г→k, ж→t͡ʃ, з→t͡s), tokenizer
// Cyrillic Khalkha is a DEEP orthography: written short vowels in non-first syllables are reduced/deleted in speech,
// so this is NOT a 1:1 scan. Referee: en.wiktionary Mongolian IPA (narrow).
{
    "language": "mn",
    "name": "Mongolian",
    "script": ["Cyrillic"],
    "provenance": "Authored from Khalkha Mongolian Cyrillic orthography + Svantesson et al. (2005) 'The Phonology of Mongolian'. Referee: en.wiktionary Mongolian IPA (1460 words, narrow/phonetic).",

    "convention": {
        "stops": "the stop/affricate contrast is ASPIRATED vs UNASPIRATED, not voiced/voiceless: б=[p] п=[pʰ], д=[t] т=[tʰ], г=[ɡ~ɢ] к=[kʰ], ж=[t͡ʃ] ч=[t͡ʃʰ], з=[t͡s] ц=[t͡sʰ] — the unaspirated affricates ж/з are emitted VOICELESS [t͡ʃ]/[t͡s] in every position (like б=p, д=t), contrasting with the aspirated ч/ц",
        "harmony": "back (pharyngeal) а/о/у vs front э/ө/ү; и neutral. г→ɢ / х→χ next to back harmony, ɡ / x next to front",
        "l": "л → the voiced lateral fricative ɮ (the Mongolian signature)",
        "finalN": "н → ŋ word-finally and before a velar/uvular",
        "reduction": "DEEP orthography: only the first-syllable vowel is full; a non-initial SHORT vowel reduces to ə, or DELETES word-finally (Дани→tän, Сири→sir). Long vowels (doubled) and diphthongs stay full everywhere",
        "devoicing": "the only word-final devoicing emitted is в→f (Женев→dʒɛnɛf); в→w elsewhere. The unaspirated series is already voiceless in the table (б=p, ж=t͡ʃ, з=t͡s) and final г stays voiced (хаг→xaɡ)",
        "soft": "ь palatalizes the preceding consonant and FRONTS the preceding vowel (а→æ, о→œ)"
    },

    // Single (short) vowel letters → their FULL first-syllable IPA quality. Reduction/deletion in non-first syllables
    // is applied in mongolian.ts. я/е/ё/ю are iotated (expand to j + vowel); handled in g2p.ts.
    "vowels": {
        "а": "a", "э": "e", "и": "i", "о": "ɔ", "ө": "ɵ", "у": "ʊ", "ү": "u", "ы": "i"
    },

    // Doubled vowels → one long vowel (always full, never reduced).
    "longVowels": {
        "аа": "aː", "ээ": "eː", "оо": "ɔː", "өө": "ɵː", "уу": "ʊː", "үү": "uː", "ии": "iː"
    },

    // Diphthongs (vowel + й, and the ий→iː long). Always full.
    "diphthongs": {
        "ай": "ai", "ой": "ɔi", "уй": "ui", "үй": "ui", "эй": "ei", "ой": "ɔi", "ый": "iː", "ий": "iː"
    },

    // Consonant letters → IPA (context-free part; г/х harmony, final н→ŋ, devoicing done in code).
    "consonants": {
        "б": "p", "в": "w", "г": "ɡ", "д": "t", "ж": "t͡ʃ", "з": "t͡s", "й": "j", "к": "kʰ",
        "л": "ɮ", "м": "m", "н": "n", "п": "pʰ", "р": "r", "с": "s", "т": "tʰ", "ф": "f",
        "х": "x", "ц": "t͡sʰ", "ч": "t͡ʃʰ", "ш": "ʃ", "щ": "ʃt͡ʃ", "к": "kʰ"
    },

    // Back-harmony vowel letters: their presence makes the word back (pharyngeal) → г→ɢ, х→χ, reduced vowel backs.
    "backVowels": "аоуяёы",

    // Cyrillic letter NAMES, for `core/initialisms.ts` (wired in normalize.ts). Without this table that seam
    // is a total no-op and `ДНБ` reaches the g2p as the cluster [tnp] — and worse here than in a shallow
    // orthography, because mongolian.ts's word-final short-vowel DELETION eats acronym letters: АНУ → [an],
    // ОХУ → [ɔχ], МЭӨ → [me].
    //
    // SOURCE: espeak-ng `dictsource/mn_list`'s own `_а`…`_я` block — 35 rows, verified to be genuine letter
    // names and not `$directive` entries (playbook trap 21: a plausible number deserves the same suspicion as
    // an absurd one; the block contains ZERO `$` rows and its ⟨й⟩/⟨ъ⟩/⟨ь⟩ names are Mongolian's own terms
    // rather than Russian's, so it is a Mongolian table and not a copied one).
    //
    // espeak is PHONETIC, so each spelling below was DERIVED from its mnemonic and then round-tripped back
    // through THIS engine's g2p and compared (playbook §5c). All 33 come back with espeak's segment skeleton
    // once this manifest's OWN three documented conventions are applied — they are engine-wide facts, not
    // letter-name errors:
    //   · the unaspirated/aspirated series: espeak be/de/ge/dZe/ze ↔ engine pe/te/ɡe/t͡ʃe/t͡se, and
    //     espeak ka/pe/te/tse/tSe ↔ engine kʰa/pʰe/tʰe/t͡sʰe/t͡ʃʰe   ("convention.stops", above)
    //   · ⟨в⟩ → w  (espeak ve, engine we)                            ("convention.devoicing")
    //   · ⟨л⟩ → ɮ  (espeak el, engine eɮ)                            ("convention.l")
    //   · ⟨н⟩ → ŋ word-finally (espeak en, engine eŋ)                ("convention.finalN")
    // The only residue is VOWEL LENGTH on the six bare-vowel names: espeak writes a: O: U: y: 8: e:, and the
    // single-letter spelling reads short. Doubling them (аа, оо…) would be inventing an orthography the
    // language does not write for a letter name, so the length is left to espeak's mnemonic and recorded here.
    //
    // ⟨ъ⟩ and ⟨ь⟩ are DELIBERATELY ABSENT, the same call Kyrgyz made: their espeak names are whole PHRASES
    // (хатуу тэмдэг / зөөлөн тэмдэг, "hard sign" / "soft sign") rather than letter names, and `spellOut`
    // returns undefined when any letter is missing — so an acronym containing one is left alone instead of
    // getting a half reading. ⟨й⟩'s name IS a phrase and is kept, because "хагас и" (half-i) is what the
    // letter is called rather than a description of a mark.
    "letterNames": {
        "а": "а", "б": "бэ", "в": "вэ", "г": "гэ", "д": "дэ", "е": "е", "ё": "ё", "ж": "жэ",
        "з": "зэ", "и": "и", "й": "хагас и", "к": "ка", "л": "эл", "м": "эм", "н": "эн",
        "о": "о", "ө": "ө", "п": "пэ", "р": "эр", "с": "эс", "т": "тэ", "у": "у", "ү": "ү",
        "ф": "эф", "х": "хэ", "ц": "цэ", "ч": "чэ", "ш": "ша", "щ": "ща", "ы": "ы", "э": "э",
        "ю": "ю", "я": "я"
    },

    // ACRONYMS READ LETTER-BY-LETTER that the OOV phonotactic rule leaves alone because their lowercase form
    // is phonotactically legal. A LEXICAL fact, exactly as in russian.jsonc (США/ДНК listed, СМИ/ООН not) —
    // nothing in the spelling distinguishes the two, and this tree has no Mongolian pronunciation dictionary
    // to ask.
    //
    // ⚠ THIS LIST WAS EMPTY IN THE FIRST CUT AND THE ARGUMENT FOR LEAVING IT EMPTY WAS WRONG ON ITS FACE. It
    // said "a readable string is left readable, which is the conservative direction". In a shallow
    // orthography that is true. Here it is not: mongolian.ts DELETES a word-final short vowel and reduces
    // every non-initial one, so the alternative on offer is not "letter reading versus word reading" — it is
    // "letters named versus letters DESTROYED". Measured on this corpus's own acronyms with the list empty:
    //     АНУ ×15 → [an]     the ⟨У⟩ gone          ОХУ ×6 → [ɔχ]     the ⟨У⟩ gone
    //     УИХ ×6  → [ʊəx]                          НҮБ ×4 → [nup]
    //     МЭӨ ×4  → [me]     the ⟨Ө⟩ gone          ОУ  ×3 → [ɔ]      ONE phoneme for two letters
    // Those are ~38 retained instances against the 17 the seam did claim, and `initialism` is this corpus's
    // second-largest cell (×53329). Leaving them was not conservative, it was silent.
    //
    // ADMISSION CRITERION, applied to every all-caps token in the retained text and stated so the next reader
    // can re-run it: the token's EXPANSION is written out beside it, which is what proves it is an initialism
    // of separate words rather than a syllabic acronym said as one. The wiki states four of them
    // definitionally, in the same `товчоор X` shape the unit articles use for their abbreviations:
    //     `Америкийн Нэгдсэн Улс (ТОВЧООР АНУ; Англи: United States of America)`
    //     `Оросын Холбооны Улс (ТОВЧООР ОХУ, орос. Российская Федерация)`
    //     `Нэгдсэн Үндэстний Байгууллага ТОВЧ. НҮБ (англи. United Nations)`
    //     `Олон улсын хөлбөмбөгийн холбоо (ОУХБХ)`                    — О+У = "Олон улсын", the ОУ- prefix
    // and the corpus supplies the other two in its own running text: `Монгол Улсын Их Хурлын дэд даргаар …
    // УИХ-ын гишүүнээр` (one sentence, both forms) and the era article's `Манай эриний өмнөх … МЭӨ анхны
    // зуун` (`манай эриний` ×29/20 on the wiki). `МЭ` is the same series as `МЭӨ` and moves with it.
    //
    // EVERY LETTER NAME COMES FROM espeak's `mn_list` (rows `_а a:`, `_н en`, `_у U:`, `_о O:`, `_х xe`,
    // `_м em`, `_э e:`, `_ө 8:`, `_и i:`, `_ү y:`, `_б be`), verified row by row; none is invented, and the
    // readings are `а эн у`, `о хэ у`, `у и хэ`, `эн ү бэ`, `эм э ө`, `эм э`, `о у`.
    //
    // DELIBERATELY NOT LISTED, and each is a token in the retained text:
    //   · МУ ×4 (Монгол Улс), УБ ×4 (Улаанбаатар) — no `товчоор` definition anywhere and no expansion beside
    //     them, so the criterion above does not admit them. They also lose no letter today ([mʊ], [ʊp]).
    //   · ДОХ, МИАТ, МАН, ДАШТ, ТЭЗҮ, ШУА, ӨМӨЗО — pronounceable acronyms said as WORDS (`дох` is AIDS,
    //     `МИАТ` the airline). This is the СМИ/ООН row of the Russian file: readable AND conventionally read.
    //   · МОНГОЛ, ДЭЭД, ХҮН, ГУРАВ, ДАРГА, ЕРӨНХИЙ … — ordinary words in a shouted phrase, which the
    //     phonotactic test already leaves alone.
    // Every listed form is ×0 as a lowercase running word in both the mined corpus and the attest artifact,
    // so none of them can spell out a word of the language.
    "acronymLetters": ["ану", "оху", "уих", "нүб", "мэө", "мэ", "оу"],

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // Cardinal number words (Cyrillic; the compositor in numbers.ts phonemizes each through the g2p so they stay in
    // our convention). Khalkha numerals have an ABSOLUTE form (utterance-final) and an ATTRIBUTIVE form used when a
    // smaller unit or a place word follows (гурав→гурван, хорь→хорин, зуу→зуун): the compositor uses the attributive
    // form for every word EXCEPT the last (арван тав = 15, хорин таван мянга = 25000). 1× a place word is bare
    // (100=зуу, 1000=мянга), a multiplier ≥2 precedes it (200=хоёр зуу).
    "numbers": {
        "units":     ["тэг", "нэг",   "хоёр", "гурав",  "дөрөв",  "тав",   "зургаа",  "долоо",  "найм",   "ес"],
        "unitsAttr": ["тэг", "нэгэн",  "хоёр", "гурван", "дөрвөн", "таван", "зургаан", "долоон", "найман", "есөн"],
        "tens":      ["", "арав",  "хорь",  "гуч",   "дөч",   "тавь",  "жар",   "дал",   "ная",  "ер"],
        "tensAttr":  ["", "арван", "хорин", "гучин", "дөчин", "тавин", "жаран", "далан", "наян", "ерэн"],
        "hundred": "зуу", "hundredAttr": "зуун",
        "thousand": "мянга", "thousandAttr": "мянган",
        "million": "сая", "billion": "тэрбум"
    }
}
