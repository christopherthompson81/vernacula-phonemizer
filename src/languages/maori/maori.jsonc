// Native canonical-IPA data manifest for Māori (mi) — te reo Māori, Eastern Polynesian, New Zealand (~185k).
// One of the simplest orthographies in the fleet: a near-1:1 phonemic map + the macron = LENGTH
// + two digraphs (⟨wh⟩→ɸ, ⟨ng⟩→ŋ). Strict CV syllables — no codas, no clusters, no glide formation. Stress
// (mora-based, unmarked) is not emitted. Engine: maori.ts.
{
    "language": "mi",
    "name": "Māori (te reo Māori)",
    "script": "Latin",

    // The two digraphs, scanned LONGEST-FIRST: ⟨wh⟩→[ɸ] (a bilabial fricative), ⟨ng⟩→[ŋ] (a velar nasal).
    "digraphs": { "wh": "ɸ", "ng": "ŋ" },

    // Single grapheme → canonical IPA. The 5 vowels + their MACRON (long) forms, and the 8 simple consonants
    // (⟨r⟩→[ɾ] tap). ⟨wh ng⟩ are the digraphs above; there is no ⟨g⟩ alone (only ⟨ng⟩).
    "graphemes": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "ā": "aː", "ē": "eː", "ī": "iː", "ō": "oː", "ū": "uː",
        "p": "p", "t": "t", "k": "k", "m": "m", "n": "n", "r": "ɾ", "h": "h", "w": "w"
    },

    // Cardinal numerals (composed by numbers.ts — see that file for the mā/kotahi rules and the source list). The
    // MODERN STANDARD tekau series (tekau mā tahi 11, rua tekau 20), not the older ngahuru decade forms. The KAHAKŌ
    // (macron) is phonemic length and load-bearing here: whā [ɸaː] 4, mā [maː] the additive particle.
    "numbers": {
        "zero": "kore",
        "units": ["", "tahi", "rua", "toru", "whā", "rima", "ono", "whitu", "waru", "iwa"],
        "ten": "tekau",
        "and": "mā",
        "one": "kotahi",
        "magnitudes": { "hundred": "rau", "thousand": "mano", "million": "miriona", "billion": "piriona" }
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },
}
