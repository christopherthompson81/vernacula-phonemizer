// Native canonical-IPA data manifest for Umbundu (umb) — Bantu (R11, Benguela/Angola, ~6M), the Latin orthography,
// A greedy longest-match scan (the Chichewa/Shona pattern): Umbundu is open CV with prenasalised
// clusters as single onset units, so a pure left-to-right longest match suffices. Referee-SCARCE (no wikipron /
// kaikki / epitran / Wiktionary-IPA); authored from the documented phonology (Wikipedia/Schadeberg) + an ASJP-
// corroborated curated gold — single-source. Signatures:
//   • VOICED obstruents occur ONLY PRENASALISED: ⟨mb nd nj ng⟩ → ᵐb ⁿd ᶮd͡ʒ ᵑɡ (there is no plain /b d d͡ʒ ɡ/).
//   • ⟨c⟩ → [t͡ʃ] (the affricate), ⟨v⟩ → [v], ⟨ñ⟩/⟨ny⟩ → [ɲ], ⟨ng'⟩ → [ŋ] (plain velar nasal, ≠ ⟨ng⟩=ᵑɡ), ⟨l⟩ → [l].
//   • plain stops p t k; fricatives f s h (voiceless) + v (voiced); nasals m n ɲ ŋ; approximants w l j.
// Tone (H á / L à + downstep) is often unwritten and the accents are STRIPPED (tone deferred; segmental output).
// Nasal vowels (tilde) are kept.
{
    "language": "umb",
    "name": "Umbundu",
    "script": ["Latin"],
    "provenance": "Authored from Schadeberg (1982) 'Nasalization in UMbundu' (J. African Langs & Linguistics) — the primary R11 phonology, Table 1 systematic-phonetic inventory — + the Umbundu orthography; ASJP Umbundu-3 corroborated. Referee-scarce (no wikipron/kaikki/epitran/Wiktionary-IPA) → single-source, grammar-grounded gold-anchored.",

    "convention": {
        "prenasalised": "the voiced stops b/d/j/g occur ONLY after a homorganic nasal (Schadeberg 1982 rule (1): b/d/j/g /N_ ~ v/l/y/∅ elsewhere), written ⟨mb nd nj ng⟩ → ᵐb ⁿd ᶮd͡ʒ ᵑɡ (also ⟨mp nt nc nk ns⟩ → ᵐp ⁿt ᶮt͡ʃ ᵑk ⁿs); ⟨ng'⟩ → ŋ",
        "affricate": "⟨c⟩ → t͡ʃ (a palatal obstruent in Schadeberg's Table 1, NOT the fricative [ʃ] that Omniglot's chart gives; ASJP-corroborated); ⟨v⟩ → v (labiodental, not [β]); ⟨ñ⟩/⟨ny⟩ → ɲ",
        "liquid": "⟨l⟩ → l; Umbundu has NO native /r/ (Schadeberg's inventory lists only /l/), so ⟨r⟩ (loanwords) → l",
        "vowels": "/a e i o u/, mid vowels CLOSE-mid [e o] (Schadeberg; not the [ɛ ɔ]/[ɔ] some charts give). NO length; nasal vowels (tilde) ã ẽ ĩ õ ũ kept",
        "tone": "H (á) / L (à) + downstepped-H — often unwritten; accents STRIPPED → tone DEFERRED",
        "deferred": "Schadeberg's rare NASALIZED continuant consonants (ṽ l̃ h̃ ỹ w̃) are not orthographically distinguished in a clean way → not emitted; morphophonological N+C rules (N+k→h in the class-9 prefix, etc.) deferred"
    },

    // Orthography → canonical IPA (scanner sorts keys LENGTH DESC: trigraph ng' → prenasal digraphs → singles).
    "graphemes": {
        "ng'": "ŋ",
        "mb": "ᵐb", "nd": "ⁿd", "nj": "ᶮd͡ʒ", "ng": "ᵑɡ",
        "mp": "ᵐp", "nt": "ⁿt", "nc": "ᶮt͡ʃ", "nk": "ᵑk", "ns": "ⁿs",
        "ny": "ɲ",

        "p": "p", "t": "t", "k": "k", "c": "t͡ʃ",
        "f": "f", "v": "v", "s": "s", "h": "h",
        "m": "m", "n": "n", "ñ": "ɲ", "l": "l", "r": "l",
        "w": "w", "y": "j",
        // fallbacks for loanwords / proper nouns (native Umbundu has these voiced obstruents only prenasalised):
        "b": "b", "d": "d", "g": "ɡ", "j": "d͡ʒ", "z": "z",

        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "ã": "ã", "ẽ": "ẽ", "ĩ": "ĩ", "õ": "õ", "ũ": "ũ"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // CARDINAL NUMBERS — the CITATION / COUNTING series for a bare numeral (mosi, vali, tatu, kwãla, tãlo,
    // epandu, epandu vali, ecelãla, ecea). Umbundu numerals 1–5 are adjectival and take noun-class concord, so
    // there is no class-neutral numeral; the counting series is what a speaker recites, and a TTS reading a bare
    // integer has no noun to agree with.
    // QUINARY RESIDUE: 6–9 are NOT concording adjectives but nouns built on a "hand/group" base — epandu (6),
    // epandu vali (7), ecelãla (8), ecea (9) — which is why they appear UNCHANGED in every multiplier slot below
    // (akwi epandu = 60, ovita epandu = 600). That is correct, not a copy-paste slip.
    // SOURCES: Filomena Camacho, "Números em Umbundo" (aeppea.wordpress.com, 2013-02-21) — the fullest list
    // found: the units, the teens (ekui la mosi, ekui la vali, ekui la vitatu, ekui la kuãla, ekui la vitãlo,
    // ekui l'epandu, ekui l'epandu vali, ekui l'ecelãla, ekui l'ecea), the tens (akui avali, akui atatu, akui
    // akuãla, akui atãlo, akui epandu, akui epandu vali, akui ecelãla, akui ecea), the hundreds (ocita, ovita
    // vivali, ovita vitatu, ovita vikuãla, ovita vitãlo, ovita epandu, ovita epandu vali, ovita ecelãla, ovita
    // ecea), ohulukãi (1 000) and ohulua (1 000 000); cross-checked against Omniglot "Numbers in Umbundu"
    // (which gives ekwí / akwí / kwãla / tãlo / ohulukãyi with ⟨w⟩ and the tone accent).
    // ORTHOGRAPHIC NORMALISATION (deliberate, documented): the ⟨w⟩ spellings are used (kwãla, ekwi, akwi,
    // ohulukãyi) rather than Camacho's ⟨u⟩ hiatus spellings (kuãla, ekui, ohulukãi), because standard Umbundu
    // orthography — and this manifest's grapheme table — writes the labialised onset with ⟨w⟩; Omniglot's tone
    // accents are dropped since umbundu.ts strips tone anyway.
    // THREE SEPARATE MULTIPLIER SERIES, one per magnitude (collapsing them is the classic Bantu numeral bug):
    // `units` (bare citation), `additive` (the slot after the connective "la" — note it is IRREGULAR in the
    // source: 3 and 5 take the vi- prefix, 2 and 4 do not), `tensMult` (cl.6 a- after akwi) and `hundredsMult`
    // (cl.8 vi- after ovita).
    // CONNECTIVE: "la" ("and"), ELIDED to "l'" before a vowel-initial word — attested in Camacho's
    // "ekui l'epandu" / "ekui l'ecelãla" / "ekui l'ecea"; applied to every vowel-initial follower (so 555 is
    // "ovita vitãlo l'akwi atãlo la vitãlo").
    // SIMPLIFIED / EXTRAPOLATED (a reviewer should know): (a) the PLURAL of ohulukãyi is not attested in any
    // source I could reach, so multi-thousands use the noun INVARIANT with a cl.8 multiplier
    // ("ohulukãyi vivali" = 2 000) rather than inventing a plural prefix; (b) 10⁹ has no word — it composes as
    // "ohulua ohulukãyi" ("a thousand million"), and multi-millions likewise take the cl.8 multiplier;
    // (c) zero is not in any source reached — "zero" is entered as the Portuguese loan universally used for
    // arithmetic in Angola, and it is flagged as a loan rather than dressed up as a native term.
    "numbers": {
        "zero": "zero",
        "units": ["", "mosi", "vali", "tatu", "kwãla", "tãlo", "epandu", "epandu vali", "ecelãla", "ecea"],
        "additive": ["", "mosi", "vali", "vitatu", "kwãla", "vitãlo", "epandu", "epandu vali", "ecelãla", "ecea"],
        "ten": "ekwi",
        "tens": "akwi",
        "tensMult": ["", "", "avali", "atatu", "akwãla", "atãlo", "epandu", "epandu vali", "ecelãla", "ecea"],
        "hundredOne": "ocita",
        "hundreds": "ovita",
        "hundredsMult": ["", "", "vivali", "vitatu", "vikwãla", "vitãlo", "epandu", "epandu vali", "ecelãla", "ecea"],
        "thousand": "ohulukãyi",
        "million": "ohulua",
        "and": "la",
        "andElided": "l'"
    }
}
