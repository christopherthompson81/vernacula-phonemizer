// Native canonical-IPA MANIFEST for Slovak (sk) — West Slavic, Latin script, espeak-independent. Sibling of Czech
// (cs) but with its own signatures: palatalisation of d/t/n/l → ɟ/c/ɲ/ʎ before the SOFT vowels i/í (y/ý are HARD,
// like Czech), the rising diphthongs ⟨ia ie iu⟩ → ɪ̯a ɪ̯e ɪ̯u and ⟨ô⟩ → u̯ɔ, ⟨ä⟩ → æ, the syllabic liquids l̩/r̩
// (long ⟨ĺ ŕ⟩ → l̩ː/r̩ː), ⟨ľ⟩ = ʎ, ⟨h⟩ = ɦ, ⟨ch⟩ = x, and regressive voicing assimilation + word-final devoicing.
// ⟨v⟩ is a LIMITED target: it devoices to [f] before a voiceless obstruent (vták→ftaːk) but stays [v] word-finally
// (stav→stav — unlike Czech v→f) and before voiced/sonorant (dievča→ɟɪ̯evt͡ʃa); v never triggers voicing.
//
// LOAD-BEARING blocks (read via manifest.ts): "vowels", "palatalisation", "consonants", "voicing",
// "clausePunctuation", "numbers". "convention" / "provenance" are self-describing documentation.
{
    "language": "sk",
    "name": "Slovak",
    "provenance": "Cleanroom rule-based g2p + number compositor (no lexicon). Consonant/vowel maps + number words are language facts. espeak-independent; scored against the wikipron slk_latn_broad HUMAN referee. See docs/investigations/sk_native_bringup_investigation.md.",

    "convention": {
        "vowels": "short a e i/y o u → a e i ɔ u; long á é í/ý ó ú → aː eː iː ɔː uː; ⟨ä⟩ → æ",
        "diphthongs": "⟨ia ie iu⟩ → ɪ̯a ɪ̯e ɪ̯u (rising, palatalise a preceding d/t/n/l); ⟨ô⟩ → u̯ɔ",
        "palatalisation": "d/t/n/l → ɟ/c/ɲ/ʎ before i, í (and the i-diphthongs). y/ý are HARD (milý→miliː). Before ⟨e⟩ it is LEXICAL (deti→ɟeci but ten→ten) → not modelled by rule; the majority default is set from the referee.",
        "voicing": "regressive assimilation + word-final devoicing; ⟨v⟩ devoices to [f] only before a voiceless obstruent (vták→ftaːk), stays [v] word-finally (stav→stav, unlike Czech) + before voiced/sonorant, never triggers; ⟨h⟩=ɦ pairs with ⟨ch⟩=x",
        "syllabic": "r/l between consonants → syllabic r̩/l̩; long ⟨ĺ ŕ⟩ → l̩ː/r̩ː",
        "stress": "fixed first-syllable ˈ, with ˌ on even non-final nuclei (folded in the referee eval)"
    },

    // Vowel letter → IPA. y/ý share i/iː with i/í (merged in pronunciation) but are HARD (no palatalisation).
    "vowels": {
        "a": "a", "e": "e", "i": "i", "o": "ɔ", "u": "u", "y": "i", "ä": "æ",
        "á": "aː", "é": "eː", "í": "iː", "ó": "ɔː", "ú": "uː", "ý": "iː"
    },

    // Palatalisation: d/t/n/l → ɟ/c/ɲ/ʎ, triggered before i / í (the scanner also treats a following i-diphthong
    // ⟨ia ie iu⟩ as a trigger). NOT before y, ý (hard). ⟨e⟩ is lexical → deliberately NOT a trigger.
    "palatalisation": {
        "map": { "d": "ɟ", "t": "c", "n": "ɲ", "l": "ʎ" },
        "triggers": ["i", "í", "e"]
    },

    // Consonant letter → IPA (ch→x, dz→d͡z, dž→d͡ʒ, x→ks and the diphthongs are handled in the scanner).
    "consonants": {
        "b": "b", "c": "t͡s", "č": "t͡ʃ", "d": "d", "ď": "ɟ", "f": "f", "g": "ɡ", "h": "ɦ",
        "j": "j", "k": "k", "l": "l", "ľ": "ʎ", "m": "m", "n": "n", "ň": "ɲ", "p": "p",
        "q": "k", "r": "r", "s": "s", "š": "ʃ", "t": "t", "ť": "c", "v": "v", "w": "v",
        "z": "z", "ž": "ʒ"
    },

    // Voicing assimilation pairs (IPA phoneme ↔ IPA phoneme). ⟨v⟩ is DELIBERATELY absent from the maps — its limited
    // devoicing (→f before a voiceless obstruent, never final, never triggering) is a special case in g2p.ts.
    // ɦ↔x is the Slovak glottal/velar voiced-voiceless pair.
    "voicing": {
        "toVoiceless": { "b": "p", "d": "t", "ɟ": "c", "ɡ": "k", "z": "s", "ʒ": "ʃ", "ɦ": "x", "d͡z": "t͡s", "d͡ʒ": "t͡ʃ" },
        "toVoiced": { "p": "b", "t": "d", "c": "ɟ", "k": "ɡ", "s": "z", "ʃ": "ʒ", "x": "ɦ", "f": "v", "t͡s": "d͡z", "t͡ʃ": "d͡ʒ" }
    },

    // Cardinal number words (Standard Slovak). units[1]/[2] have masculine forms here; magnitude agreement (tisíc/
    // milión) uses the singular/paucal/plural like Czech.
    "numbers": {
        "units": ["nula", "jeden", "dva", "tri", "štyri", "päť", "šesť", "sedem", "osem", "deväť"],
        "teens": ["desať", "jedenásť", "dvanásť", "trinásť", "štrnásť", "pätnásť", "šestnásť", "sedemnásť", "osemnásť", "devätnásť"],
        "tens": ["", "", "dvadsať", "tridsať", "štyridsať", "päťdesiat", "šesťdesiat", "sedemdesiat", "osemdesiat", "deväťdesiat"],
        "hundreds": ["", "sto", "dvesto", "tristo", "štyristo", "päťsto", "šesťsto", "sedemsto", "osemsto", "deväťsto"],
        "magnitudes": {
            "thousand": { "sg": "tisíc", "paucal": "tisíce", "plural": "tisíc" },
            "million": { "sg": "milión", "paucal": "milióny", "plural": "miliónov" }
        }
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // LEXICAL: acronyms Slovak spells out letter-by-letter although their lowercase form COULD be read as a
    // word, so no phonotactic rule can derive it (core/initialisms.ts states this limit explicitly). Every
    // entry occurs in the sk_sk corpus; the counts are in the investigation log, Run 14.
    // Tokens with NO VOWEL LETTER need no entry — the shared OOV rule letter-spells them automatically, and
    // that is most of this corpus's inventory: HDP, DVD, USD, GMT, TB, XDR, NHK, VPN, PTWC, GPS, GBP, DSLR,
    // FTIR, FKP, KNP, NMR, NPWS, NSW, TMZ, CCTV, CG, HK, QC, SM, MS, TT, PBS, APS, HJR, PNG.
    // Six entries below (osn, fbi, nba, add, usgs, rspca) DO carry a vowel and are additionally caught by
    // the cluster rules, so they are redundant today. They are kept deliberately: the reading is a lexical
    // convention, and the phonotactic sets are tuning parameters — loosening an onset later must not
    // silently turn OSN into a word.
    // Said as WORDS and deliberately NOT listed, matching Czech's identical decision on the same set:
    // UNESCO, NASA, COVID, OPEC, SWAPO, ISIS, FIFA, ACTA, ASUS, REM, PALM, LATAM, MINAE, METI, FATA, EVA.
    "acronymLetters": [
        "usa", "osn", "fbi", "nba", "mri", "aol", "add", "cep", "usoc", "usgs", "usaf", "ucla",
        "rspca", "fic", "faa", "acma", "mip", "mov", "hiv", "suv", "aud", "ip", "ui", "uw", "it", "ai"
    ]
}
