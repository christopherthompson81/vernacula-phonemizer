// Native canonical-IPA data manifest for Hawaiian / ʻŌlelo Hawaiʻi (haw) — Austronesian (Eastern Polynesian,
// sibling of Māori), Hawaiʻi (~24k). ONE OF THE SIMPLEST phonologies in the world: 5 vowels
// /a e i o u/ + the MACRON (kahakō) = LENGTH, and 8 consonants ⟨p k m n l h w⟩ + the ʻokina ⟨ʻ⟩→[ʔ]. A near-1:1
// phonemic grapheme map, no digraphs. Loanwords adapt the non-Hawaiian letters to the nearest phoneme (t→k, s→k,
// r→l, b→p, d/g→k, v→w …). Stress (penultimate, mora-based, unmarked) is not emitted. Engine: hawaiian.ts.
{
    "language": "haw",
    "name": "Hawaiian (ʻŌlelo Hawaiʻi)",
    "script": "Latin",

    // Single grapheme → canonical IPA. The 5 vowels + their MACRON (long) forms; the 8 native consonants; the
    // ʻOKINA ⟨ʻ⟩ (and its ASCII/Unicode variants ' ʼ ‘ `) → the glottal stop [ʔ]; and the LOAN-LETTER adaptations
    // (t/s/g/d/c/j/q/x/z→k, r→l, b/f→p, v→w, y→i) for foreign words.
    "graphemes": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "ā": "aː", "ē": "eː", "ī": "iː", "ō": "oː", "ū": "uː",
        "p": "p", "k": "k", "m": "m", "n": "n", "l": "l", "h": "h", "w": "w",
        "ʻ": "ʔ", "'": "ʔ", "ʼ": "ʔ", "‘": "ʔ", "`": "ʔ", "ʔ": "ʔ",
        "b": "p", "c": "k", "d": "k", "f": "p", "g": "k", "j": "k", "q": "k",
        "r": "l", "s": "k", "t": "k", "v": "w", "x": "k", "y": "i", "z": "k"
    },

    // Cardinal numerals (composed by numbers.ts — see that file for the ʻe-/stem, kana-, kūmā and multiplier rules
    // and the source list). Note the ʻOKINA is part of the spelling: ʻekahi, ʻumi, ʻole, hoʻokahi — it is a full
    // consonant [ʔ] here, so these must be written with U+02BB (or one of the variants the grapheme map accepts),
    // never with a bare vowel. The KAHAKŌ (macron) is likewise phonemic length: ʻehā [ʔehaː], iwakālua, kūmā.
    // The powers of ten are English loans (precontact Hawaiian counted in fours: kāuna 4, kaʻau 40, lau 400).
    "numbers": {
        "zero": "ʻole",
        "units": ["", "ʻekahi", "ʻelua", "ʻekolu", "ʻehā", "ʻelima", "ʻeono", "ʻehiku", "ʻewalu", "ʻeiwa"],
        "stems": ["", "kahi", "lua", "kolu", "hā", "lima", "ono", "hiku", "walu", "iwa"],
        "ten": "ʻumi",
        "twenty": "iwakālua",
        "tensPrefix": "kana",
        "kuma": "kūmā",
        "one": "hoʻokahi",
        "magnitudes": { "hundred": "haneli", "thousand": "kaukani", "million": "miliona", "billion": "biliona" }
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },
}
