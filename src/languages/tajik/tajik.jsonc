// Native canonical-IPA data manifest for Tajik / тоҷикӣ (tg) — Cyrillic.
// Tajik is a variety of Persian (Iranian, SW) written in a CYRILLIC alphabet that — unlike the Perso-Arabic
// abjad our `fa` uses — WRITES ALL ITS VOWELS. So this is a near-phonemic left-to-right Cyrillic scan with NO
// short-vowel restoration (the wall that keeps fa ) — the Kurmanji-vs-Persian advantage.
//
// The ALGORITHMS that read this stay in tajik.ts: the greedy grapheme scan (word-initial / post-vowel е→je,
// iotated ё/ю/я, the special letters), Persian FINAL stress, the tokenizer, and the cardinal-number compositor.
//
// CANONICAL values are adjudicated from three referees (wikipron tgk_cyrl broad + narrow, both human/Wiktionary;
// epitran tgk-Cyrl, programmatic): о→ɔ (broad writes o), а→a (narrow ä, epitran æ), ӯ→ɵ, х→χ (fold x), в→v (narrow
// writes the allophonic w), ҳ→h (narrow's intervocalic ɦ), к→k (narrow marks aspiration kʰ).
{
    "language": "tg",
    "name": "Tajik",
    "script": ["Cyrillic"],
    "provenance": "Authored from the Tajik Cyrillic orthography + standard Tajik (Persian) phonology — a shallow, near-phonemic alphabet, so the native Cyrillic G2P reads this manifest directly. Validated against wikipron tgk_cyrl (broad + narrow, human) and epitran tgk-Cyrl. No short-vowel restoration is needed (Cyrillic writes the vowels), unlike the fa abjad.",

    "convention": {
        "eInitial": "word-initial or post-vowel е → je (Ев→jev); after a consonant → e",
        "sixVowels": "и e а о у ӯ → i e a ɔ u ɵ. о is the Tajik reflex of Persian ā = [ɔ]; ӯ is the mid central rounded [ɵ] (northern dialects; merges with u in the south).",
        "stress": "Persian FINAL stress — the last vowel nucleus of the word carries primary stress",
        "special": "ғ→ʁ, қ→q, ҳ→h, ҷ→d͡ʒ, ӣ→i (stress-marked final и), ъ→ʔ (ayn/hamza)",
        "relabels": "х→χ (uvular), в→v, ч→t͡ʃ, ш→ʃ, ж→ʒ; loan ц→t͡s, щ→ʃt͡ʃ",
    },

    // Plain vowel letters → IPA nucleus (the six-vowel Tajik system).
    "vowels": {
        "а": "a",
        "о": "ɔ",
        "и": "i",
        "ӣ": "i",
        "е": "e",
        "у": "u",
        "ӯ": "ɵ",
        "э": "e",
        "ы": "i",
    },

    // Iotated letters → a fixed IPA sequence (the vowel is the nucleus). й is a pure glide (no nucleus).
    "glides": { "ё": "jɔ", "ю": "ju", "я": "ja", "й": "j" },

    // Consonant letters → canonical IPA (context-free).
    "consonants": {
        "б": "b",
        "в": "v",
        "г": "ɡ",
        "ғ": "ʁ",
        "д": "d",
        "ж": "ʒ",
        "з": "z",
        "к": "k",
        "қ": "q",
        "л": "l",
        "м": "m",
        "н": "n",
        "п": "p",
        "р": "r",
        "с": "s",
        "т": "t",
        "ф": "f",
        "х": "χ",
        "ҳ": "h",
        "ч": "t͡ʃ",
        "ҷ": "d͡ʒ",
        "ш": "ʃ",
        "ц": "t͡s",
        "щ": "ʃt͡ʃ",
        "ъ": "ʔ",
        "ь": "",
    },

    // Tajik cardinal numbers (Persian-based). The compositor in tajik.ts glues them; these are the atoms.
    "numbers": {
        "units": ["сифр", "як", "ду", "се", "чор", "панҷ", "шаш", "ҳафт", "ҳашт", "нӯҳ"],
        "teens": ["даҳ", "ёздаҳ", "дувоздаҳ", "сездаҳ", "чордаҳ", "понздаҳ", "шонздаҳ", "ҳабдаҳ", "ҳаждаҳ", "нуздаҳ"],
        "tens": { "20": "бист", "30": "сӣ", "40": "чил", "50": "панҷоҳ", "60": "шаст", "70": "ҳафтод", "80": "ҳаштод", "90": "навад" },
        "hundred": "сад",
        "thousand": "ҳазор",
        "million": "миллион",
        "and": "у",
    },

    "clausePunctuation": {
        ".": ".",
        "?": "?",
        "!": "!",
        ",": ",",
        ";": ",",
        ":": ",",
        "…": ".",
    },
}
