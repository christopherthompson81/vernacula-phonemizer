// Native Sepedi / Northern Sotho (nso) canonical-IPA definition — Bantu (Sotho-Tswana, S32; ~5M, South Africa,
// official). Latin orthography. Sibling of the done Setswana (tn) + Sesotho (st), but a DISTINCT language. NO
// machine referee AT ALL (no wikipron/kaikki/epitran) → ⛔ cannot-verify; authored from standard Sepedi phonology
// (Ziervogel & Mokgokong) as a beyond-referee module, the Setswana pattern. Greedy longest-match scan.
//
// Sepedi's profile among Sotho-Tswana: prominent ⟨š⟩→[ʃ] / ⟨tš⟩→[t͡ʃ], ⟨g⟩→[x] / ⟨kg⟩→[kx], the voiceless lateral
// ⟨hl⟩→[ɬ] and lateral affricate ⟨tl⟩→[t͡ɬ]. Plain voiceless stops taken as EJECTIVE ⟨p t k⟩→[pʼ tʼ kʼ] (the
// Sotho-Tswana pattern, per the Sesotho attestations — UNVERIFIED for Sepedi). No clicks. Vowel height (7-vowel
// /i e ɛ a ɔ o u/) is unwritten → default mid [ɛ ɔ]. Tone (H/L) lexical + unwritten → DEFERRED. ⛔ cannot-verify.
// See docs/investigations/nso_native_bringup_investigation.md.
{
    "language": "nso",
    "name": "Sepedi (Northern Sotho)",
    "script": "Latin",
    "provenance": "Authored from standard Sepedi/Northern Sotho orthography + phonology (Ziervogel & Mokgokong). NO machine referee (no wikipron/kaikki/epitran) → ⛔ cannot-verify; a couple of hand examples only.",

    "graphemes": {
        "tšh": "t͡ʃʰ", "tsh": "t͡sʰ", "tlh": "t͡ɬʰ",
        "tš": "t͡ʃʼ", "ts": "t͡sʼ", "tl": "t͡ɬʼ",
        "ph": "pʰ", "th": "tʰ", "kh": "kʰ", "kg": "kx",
        "sh": "ʃ", "hl": "ɬ", "ng": "ŋ", "ny": "ɲ",
        "š": "ʃ", "j": "d͡ʒ", "y": "j",
        "b": "b", "d": "d", "f": "f", "g": "x", "h": "ɦ", "k": "kʼ", "l": "l", "m": "m",
        "n": "n", "p": "pʼ", "r": "r", "s": "s", "t": "tʼ", "v": "v", "w": "w", "z": "z",
        "a": "ɑ", "e": "ɛ", "ê": "ɛ", "i": "i", "o": "ɔ", "ô": "ɔ", "u": "u"
    },

    "clausePunctuation": {
        ".": " . ", "!": " ! ", "?": " ? ", "…": " … ", ",": " , ", ";": " ; ", ":": " : "
    },

    // CARDINAL NUMBERS — the CITATION / COUNTING series, and Sepedi's own CONJUNCTIVE compound orthography.
    // ⚠ Sepedi is NOT Sesotho with a spelling shift: the numeral stems and the compound morphology both differ,
    // and this table was authored from Northern Sotho sources only (verified, not copied from st):
    //   1 tee (st nngwe) · 6 tshela (st tshelela) · 7 šupa (st supa) · 8 seswai (st robedi) ·
    //   9 senyane (st robong) · 10 lesome (st leshome) · and 11–99 are written CONJUNCTIVELY as one word
    //   (lesometee, masomepedi) where Sesotho is fully disjunctive with the motso/metso dummy noun.
    // SOURCES: the UNISA free online Northern Sotho course, "Theme 3: Numbers, days, months, seasons", Track 7 +
    // Video 3 — which gives the COUNTING list verbatim ("Tee, pedi, tharo, nne, hlano, tšhela, tšhupa, seswai,
    // senyane, lesome, diranta tše lekgolo, diranta tše makgolopedi" = "one – two – three – four – five – six –
    // seven – eight – nine – ten – one hundred Rand – two hundred Rand"), the hundreds series (makgolopedi,
    // makgolotharo, makgolonne, makgolohlano, makgolotshela, makgološupa, makgoloseswai, makgolosenyane),
    // sekete (1 000) and the cl.8 concord particle "tše"; plus Omniglot "Numbers in Northern Sotho"
    // (omniglot.com/language/numbers/northernsotho.htm) for lesometee…lesomesenyane, masomepedi…masomesenyane and
    // the tens+unit compounds (masomepedi-tee, masomepedi-pedi, …); Wiktionary Category:Northern Sotho numerals
    // corroborates the stem set (hlano, lekgolo, lesome, nne, pedi, sekete, senyane, seswai, tharo, tshela, šupa).
    // Zero = lefeela (Northern Sotho "nothing/nil"; DBE 2019 Northern Sotho Wordlist).
    // ORTHOGRAPHIC NORMALISATIONS (documented, deliberate): Omniglot's HYPHEN in the tens+unit compounds
    // ("masomepedi-tee") is rendered as a SPACE, because the engine's word tokenizer treats a hyphen as a word
    // break and gluing two numerals into one phonemic word would remove a real TTS word boundary; and Omniglot's
    // variant spellings "thlano/tlhano" + "seswae" are normalised to the standard "hlano" / "seswai" (the forms
    // the UNISA course and Wiktionary use).
    // SIMPLIFIED / EXTRAPOLATED: the multi-thousand / million / billion plurals (dikete tše pedi, dimilione tše
    // pedi, dibilione tše pedi) apply the cl.8 "tše" concord that the UNISA course attests for "diranta tše
    // sekete"; the exact strings are extrapolated. The magnitude components are joined with the standard Sotho
    // conjunction "le" (lekgolo le masomehlano hlano = 155).
    "numbers": {
        "zero": "lefeela",
        // The counting/citation stems 1–9; also the multiplier after lesome/masome/makgolo in the conjunctive
        // compounds (Northern Sotho glues the bare stem on: lesome+tee, masome+pedi, makgolo+tharo).
        "units": ["", "tee", "pedi", "tharo", "nne", "hlano", "tshela", "šupa", "seswai", "senyane"],
        // cl.8 concord stems, indices 2–9 (after dikete / dimilione / dibilione).
        "class8": ["", "", "pedi", "tharo", "nne", "hlano", "tshela", "šupa", "seswai", "senyane"],
        "ten": "lesome",
        // the CONJUNCTIVE heads: 11–19 = "lesome"+unit, 20–90 = "masome"+unit, 200–900 = "makgolo"+unit.
        "teenHead": "lesome",
        "tensHead": "masome",
        "hundredOne": "lekgolo",
        "hundredsHead": "makgolo",
        "thousandOne": "sekete",
        "thousands": "dikete",
        "millionOne": "milione",
        "millions": "dimilione",
        "billionOne": "bilione",
        "billions": "dibilione",
        "class8Concord": "tše",
        "and": "le"
    }
}
