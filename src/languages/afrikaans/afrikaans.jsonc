// Native canonical-IPA data manifest for Afrikaans (af)
//
// Indo-European (West Germanic, daughter of Dutch), ~7M, South Africa/Namibia, Latin script + diacritics.
//
// Fairly regular orthography, but with the Germanic OPEN/CLOSED-SYLLABLE vowel-length rule (a single vowel
// is long/tense in an open syllable, short/lax in a closed one) → the engine (afrikaans.ts) does the length
// lookahead; this file holds the declarative tables. Referee: en.wiktionary Afrikaans IPA.
{
    "language": "af",
    "name": "Afrikaans",
    "script": ["Latin"],
    "provenance": "Authored greedy g2p for Standard Afrikaans. Referee: en.wiktionary Afrikaans IPA (2220 words).",

    "convention": {
        "vowelLength": "single vowel: LONG/tense in an open syllable (V.CV: ape→ɑː), SHORT/lax in a closed one (VC#/VCC: al→a) — engine lookahead",
        "longMids": "the long mid vowels are CENTERING DIPHTHONGS: ee / open-e = iə, oo / open-o = uə; long a = ɑː; ie = i, oe = u",
        "signatures": "⟨g⟩ = velar/uvular fricative [χ] (not [ɡ]); ⟨w⟩ = [v]; ⟨v⟩ = [f]; ⟨h⟩ = [ɦ]; final obstruent DEVOICING (b→p, d→t); ⟨y⟩ = diphthong [əi]",
        "folded": "stress (unwritten) + syllable dots not emitted; r~ɾ one symbol [r]; nasalization before nasal+C and unstressed-vowel schwa-reduction DEFERRED"
    },

    // Fixed multi-letter graphemes + ⟨y⟩ + consonants (the greedy length-desc table; bare a/e/i/o/u go through the
    // open/closed length code instead). Long vowels here are the doubled/di-graph spellings (always long).
    // ⚠ ⟨sch⟩ AND ⟨chr⟩ MUST OUT-RANK ⟨ch⟩, and longest-match is what makes that work — the same argument
    // as every other multi-letter entry here. Without ⟨sch⟩ the surnames come out [sʃ], which is not a
    // possible Afrikaans onset (Schalk → *sʃalk); the referee's majority is [sk] — Schalk, Schoeman,
    // Schutte, Labuschagne — against Schuster/Laubscher [ʃ] and Hauptfleisch [s]. ⟨schr⟩ falls out of
    // ⟨sch⟩ + ⟨r⟩ with no entry of its own.
    "fixed": {
        "aai": "ɑːi", "ooi": "oːi", "oei": "ui", "eeu": "iːu", "aau": "ɑːu",
        "aa": "ɑː", "ee": "iə", "oo": "uə", "uu": "yː", "ie": "i", "oe": "u", "eu": "øː",
        "ei": "əi", "ui": "œy", "ou": "œu", "au": "œu", "y": "əi",
        "tjie": "ki", "djie": "ki", "jie": "ki", "tz": "ts", "sj": "ʃ", "tj": "c", "dj": "dʒ", "ch": "ʃ",
        "sch": "sk", "chr": "kr", "ng": "ŋ", "nk": "ŋk",
        "b": "b", "d": "d", "f": "f", "g": "χ", "h": "ɦ", "j": "j", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "p", "q": "k", "r": "r", "s": "s", "t": "t",
        "v": "f", "w": "v", "x": "ks", "z": "z"
    },

    // Bare single vowels — the engine picks long (open syllable) or short (closed) per the length rule.
    "vowelsLong": { "a": "ɑː", "e": "iə", "i": "i", "o": "uə", "u": "yː" },
    "vowelsShort": { "a": "a", "e": "ɛ", "i": "ə", "o": "ɔ", "u": "œ" },

    // Diacritic vowels: circumflex = long (ê ô û î); diaeresis ë ï = syllable-break, base value; acute/grave = loan stress.
    "diacriticVowels": {
        "ê": "ɛː", "ô": "ɔː", "û": "œː", "î": "əː",
        "ë": "ə", "ï": "i", "é": "eː", "è": "ɛ", "á": "ɑː", "à": "a", "ó": "oː", "ú": "y", "ü": "y", "ö": "ø"
    },

    // The BARE single vowels — the five letters routed through the open/closed length rule above (the
    // digraphs and the diacritic vowels carry their own length, so only these need the lookahead).
    "bareVowels": ["a", "e", "i", "o", "u"],
    // Every letter that heads a vowel/nucleus, bare or diacritic. This BOUNDS THE CONSONANT RUN in that same
    // lookahead: the syllable is open iff at most one consonant separates a vowel from the next one, so a
    // letter missing here would be counted as a consonant and close the syllable that should be open.
    "vowelLetters": [
        "a", "e", "i", "o", "u", "y", "ê", "ô", "û", "î", "ë", "ï",
        "é", "è", "á", "à", "ó", "ú", "ü", "ö"
    ],

    // FINAL DEVOICING (Auslautverhärtung): a voiced obstruent devoices word- and morpheme-finally
    // (hond→ɦɔnt). ⟨g⟩→[χ] and ⟨v⟩→[f] need no entry — the grapheme table already emits the voiceless one.
    "voicedFinal": { "b": "p", "d": "t", "z": "s" },

    // ⚠ UNSTRESSED BARE VOWELS REDUCE. The open/closed length rule only lengthens in a STRESSED syllable;
    // elsewhere the vowel stays short and ⟨e⟩/⟨i⟩ centralise to schwa. Digraph vowels (aa, ee=iə …) are
    // inherently long and never reach this table.
    "unstressedReduction": { "a": "a", "e": "ə", "i": "ə", "o": "ɔ", "u": "œ" },

    // ⟨c⟩ is soft [s] before one of these and [k] elsewhere. A LETTER list, not a phone list — it is read
    // off the spelling during the scan.
    "cSoftBefore": ["e", "i", "y", "ê", "é", "è"],

    // ⚠ LOAN SUFFIXES THAT MOVE THE STRESS off the native first syllable. Afrikaans stress is initial by
    // default (the Germanic pattern) and these Romance/Latinate endings override it: "final" takes the last
    // nucleus (ingenieur, universiteit), "penultimate" the second-to-last (aborsie → a·BOR·sie). Matched as
    // word-final alternatives, LONGEST FIRST so ⟨siteit⟩ wins over ⟨teit⟩.
    "stressFinalSuffixes": ["siteit", "teit", "isme", "eer", "eur", "oor", "oon", "ees", "yn"],
    "stressPenultSuffixes": ["ie"],

    // Reduced IPA for the UNSTRESSED (inseparable) prefixes named in `morphology.prefixUnstressed`.
    // ⚠ PHONEMISED STANDALONE THEY WOULD STRESS THEIR OWN VOWEL (ver→fɛr); as a prefix the vowel reduces
    // (ver·staan → fər·stɑːn). The KEYS must match morphology.prefixUnstressed — afrikaans.ts throws if
    // they diverge, because this list, that one and the stress regex were three copies of the same six.
    "prefixIpa": { "be": "bə", "ge": "χə", "ver": "fər", "ont": "ɔnt", "her": "ɦər", "er": "ər" },

    // ── TEXT NORMALIZATION DATA (normalize.ts) ─────────────────────────────────────────────────────────
    // Ordinals 1–19. The regular ending is the cardinal plus -de; ⟨eerste⟩, ⟨derde⟩ and ⟨agtste⟩ are the
    // suppletive/assimilated forms. From 20 up the ending is -ste (twintigste), except that a sub-20
    // remainder carries its own small-ordinal form onto the compound — 101e honderdeerste, 112e
    // honderdtwaalfde. Index 0 is unused padding.
    "ordinalsBelow20": [
        "", "eerste", "tweede", "derde", "vierde", "vyfde", "sesde", "sewende", "agtste", "neënde",
        "tiende", "elfde", "twaalfde", "dertiende", "veertiende", "vyftiende", "sestiende",
        "sewentiende", "agtiende", "negentiende"
    ],

    // ⚠ MULTI-DOT ABBREVIATIONS, and EVERY LETTER PAIR HERE IS DOT-BOUND — that is load-bearing, not
    // tidiness. The corpus's four BC instances are `v. C.`, `v.C.`, `V.C.` and the undotted `vC`/`VC` — a
    // dotted form, or the two letters ADJACENT, never "letter space letter". Allowing the unpunctuated
    // spaced form (`v\.?\s?C\.?`) made `n\.?\s?C\.?` match the indefinite article before any c-word:
    // `'n Chinese skip` → *'na Christushinese skip*. Afrikaans's commonest word, destroyed by a rule with
    // ZERO corpus instances of its own (na Christus never occurs).
    // Values are REGEX SOURCE, so a backslash is doubled for JSON.
    "multiDotAbbreviations": [
        ["v\\.\\s?C\\.?", "voor Christus"],
        ["vC(?![\\p{L}\\p{M}])", "voor Christus"],
        ["n\\.\\s?C\\.?", "na Christus"],
        ["d\\.\\s?i\\.", "dit is"]
    ],

    // Single-dot abbreviations → the spoken words. The dot is a phrase break otherwise, and the stem is
    // usually unpronounceable. `m.p.u` = myl per uur (mph, the Afrikaans way); `n.m.` = namiddag (PM). The
    // undotted vm/nm AM/PM suffixes are handled by the clock rule instead — they attach to a clock.
    // ⚠ Only the DOTTED keys may appear without their trailing dot; a plain word like `dr` is never matched
    // bare, since it starts "Dromaeosauridae" and would misfire (the split is computed in normalize.ts).
    "dottedAbbreviations": {
        "dr": "Dokter", "m.p.u": "myl per uur", "m.p.u.": "myl per uur",
        "n.m": "namiddag", "n.m.": "namiddag"
    },

    // Afrikaans letter names — aa, bee, see … (the corpus's own alphabet article: "die gewone alfabet as
    // die ABC (uitgespreek aa-bee-see)"). The g2p spells them through itself.
    "letterNames": {
        "a": "aa", "b": "bee", "c": "see", "d": "dee", "e": "ee", "f": "ef", "g": "gee", "h": "haa",
        "i": "ie", "j": "jee", "k": "kaa", "l": "el", "m": "em", "n": "en", "o": "oo", "p": "pee",
        "q": "kuu", "r": "er", "s": "es", "t": "tee", "u": "uu", "v": "vee", "w": "wee", "x": "eks",
        "y": "ei", "z": "zet"
    },

    // LEXICAL: acronyms read AS WORDS despite being unreadable by phonotactics (REM-slaap, COVID, FIFA,
    // NATO, OPEC, UNESCO, AIDS). "die GPS" by contrast is read as letters.
    "wordAcronyms": ["rem", "covid", "fifa", "nato", "opec", "unesco", "aids"],
    // …and the readable-looking runs Afrikaans nonetheless SPELLS OUT, which the phonotactic rule would
    // otherwise hand to the g2p as a word.
    "acronymLetters": ["uk", "vk", "vn", "vsa", "vs", "aol"],

    // Afrikaans phonotactics for the OOV initialism rule (core/initialisms.ts): can this letter run be a
    // word at all? Onsets and codas that a native word may actually carry.
    "phonotactics": {
        "legalOnsets": [
            "bl", "br", "ch", "dr", "dw", "fl", "fr", "gl", "gn", "gr", "kl", "kn", "kr", "kw", "pl",
            "pr", "ps", "sc", "sch", "sf", "sj", "sk", "sl", "sm", "sn", "sp", "st", "sw", "th", "tj",
            "tr", "tw", "vl", "vr", "wr", "zw"
        ],
        "legalCodas": [
            "ch", "ck", "ft", "ht", "kt", "ld", "lf", "lg", "lk", "lm", "lp", "ls", "lt", "mp", "ms",
            "mt", "nd", "ng", "nk", "ns", "nt", "pt", "rd", "rf", "rg", "rk", "rl", "rm", "rn", "rp",
            "rs", "rt", "sp", "st", "ts", "ks", "ps", "sk"
        ]
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // Cardinal number words (authored spelling; the compositor in numbers.ts phonemizes each through the g2p, so
    // they stay in our convention). Afrikaans uses the Dutch-style UNIT-en-TEN order: 21 = een-en-twintig.
    "numbers": {
        "units": ["nul", "een", "twee", "drie", "vier", "vyf", "ses", "sewe", "agt", "nege"],
        "teens": ["tien", "elf", "twaalf", "dertien", "veertien", "vyftien", "sestien", "sewentien", "agtien", "negentien"],
        "tens": ["", "", "twintig", "dertig", "veertig", "vyftig", "sestig", "sewentig", "tagtig", "negentig"],
        "en": "en", "hundred": "honderd", "thousand": "duisend", "million": "miljoen"
    },

    // Morphology for the shared West-Germanic compound engine (core/germanicMorphology.ts). Afrikaans is heavily
    // compounding like Dutch/German; splitting a word into its morphemes lets each element be phonemized with its own
    // stress + coda devoicing (aand·ete → ɑnt·iətə). Affixes longest-first. The stem lexicon is a frequency wordlist.
    "morphology": {
        "prefixUnstressed": ["ver", "ont", "her", "be", "ge", "er"],
        "prefixStressed": ["agter", "binne", "buite", "onder", "terug", "deur", "voor", "saam", "teen", "aan", "af", "by", "in", "om", "oor", "op", "uit", "weg", "mee", "toe", "na"],
        "ambiguousPrefixes": ["be", "ge", "er"],
        "suffixes": ["likheid", "heid", "teit", "asie", "isie", "isme", "agtig", "baar", "loos", "saam", "lik"],
        "vowelInitialSuffixes": ["agtig", "asie", "isie"],
        "linkingElements": ["", "s", "e"],
        "validOnsets": ["st", "sp", "sk", "sl", "sm", "sn", "sw", "skr", "str", "spr", "spl", "tr", "dr", "kr", "kn", "gr", "gl", "br", "bl", "pr", "pl", "fr", "fl", "vr", "vl", "kw", "tw", "dw", "gn", "ts", "kl"],
        "stKeep": []
    }
}
