// Native canonical-IPA data manifest for Luxembourgish (lb) — Lëtzebuergesch, a Moselle-Franconian (West Central
// German) variety standardized in Luxembourg (~390k), Latin script with a German-derived orthography + French loans.
// The engine (luxembourgish.ts) is a greedy longest-match grapheme scan (digraphs/diphthongs
// first) + German-style rules: initial st/sp→ʃt/ʃp, s→z (voiced onset), short stressed ⟨e⟩→æ, geminate collapse,
// final + regressive devoicing, final g→χ (after a vowel) / k (after a consonant). Vowel LENGTH is folded
// (open/closed-syllable-conditioned, deferred).
{
    "language": "lb",
    "name": "Luxembourgish (Lëtzebuergesch)",
    "script": "Latin",

    // Multi-letter graphemes — scanned LONGEST-FIRST (see ORDER in luxembourgish.ts). Diphthongs map to the two vowel
    // SEGMENTS (the offglide diacritic folds in the backbone). ⟨ei ai⟩→ai̯, ⟨au⟩→æu̯, ⟨ou⟩→əu̯, ⟨éi⟩→ei̯ (the front
    // closing diphthong; ⟨é⟩ ALONE→eː below), ⟨ie⟩→iə, ⟨ue⟩→uə. ⟨sch⟩→ʃ, ⟨ch⟩→χ, ⟨qu⟩→kv, ⟨ck⟩→k, ⟨ng⟩→ŋ.
    "digraphs": {
        "sch": "ʃ", "tsch": "t͡ʃ",
        "ch": "χ", "ck": "k", "qu": "kv", "ng": "ŋ", "ph": "f", "tz": "t͡s", "th": "t",
        "éi": "ei̯", "ei": "ai̯", "ai": "ai̯", "ay": "ai̯", "ey": "ai̯",
        "au": "æu̯", "äu": "æu̯", "ou": "əu̯",
        "ie": "iə", "ue": "uə",
        "aa": "aː", "ee": "eː", "oo": "oː", "uu": "uː", "ii": "iː", "ää": "æː",
        "ss": "s"
    },

    // Single grapheme → canonical IPA. ⟨é⟩→eː (the long mid; only ⟨éi⟩ is the diphthong), ⟨ë⟩→ə, ⟨ä⟩→æ; ⟨w⟩→v, ⟨v⟩→f, ⟨z⟩→t͡s,
    // ⟨s⟩→s (→z as an onset in code), ⟨g⟩→ɡ (→χ word-final in code), ⟨c⟩→k, ⟨x⟩→ks, ⟨y⟩→i.
    "graphemes": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u", "é": "eː", "ë": "ə", "ä": "æ", "y": "i",
        "b": "b", "c": "k", "d": "d", "f": "f", "g": "ɡ", "h": "h", "j": "j", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "p", "r": "r", "s": "s", "t": "t",
        "v": "f", "w": "v", "x": "ks", "z": "t͡s"
    },

    // The PARENTHETICAL EN DASH is a pause, and it was being dropped outright in 31 utterances:
    // `Kloteren a Sprangen – erfuerdert awer …` ran the two clauses together with nothing between them.
    // It reads as the same short break `;` and `:` already map to. The corpus's 54 en dashes are 11 numeric
    // ranges — claimed as `bis` by normalize.ts step 10, long before the tokenizer sees them — and this.
    // NOTE: dropping a parenthetical dash is a CROSS-LANGUAGE gap, not an lb one. Only cantonese.jsonc
    // declares it today; de, nl and cs all drop it on the same sentence. Fixed here because it is this
    // language's own manifest and this corpus's measured defect; the sweep for the rest wants its own pass.
    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",", "–": ",",
    },

    // ── CARDINAL NUMBER WORDS ────────────────────────────────────────────────────────────────────────────────────
    // Source: omniglot.com/language/numbers/luxembourgish.htm (the 0–20 / tens / honnert / dausend / Millioun
    // table), plus en.wikipedia.org/wiki/Luxembourgish for the EIFELER REGEL evidence — that article's own numeral
    // examples "fënnefandrësseg" (35) vs "fënnefavéierzeg" (45) are exactly the pair that pins the n-deletion
    // condition on the unit→tens connector. Luxembourgish is units-FIRST like German: eenanzwanzeg = 21.
    //
    // The EIFELER REGEL (implemented in numbers.ts, not expressible as a table): a word-final ⟨n⟩ is DROPPED before
    // a following consonant, but RETAINED before ⟨n d t z h⟩ and before a vowel. Applied to the connector "an" this
    // gives an- before zwanzeg (z), drësseg (d), achtzeg (vowel) and nonzeg (n), but a- before véierzeg (v),
    // fofzeg (f), siechzeg (s) and siwwenzeg (s).
    //
    // JUDGMENT CALL: bare 1 is "eent" (the counting form, as in the source table) while the unit inside a tens
    // compound is "een-" (eenanzwanzeg) — hence the separate `compoundOnes` entry. Millioun / Milliard are
    // feminine, so their bare-one spelling carries the article-like "eng".
    "numbers": {
        "ones": [
            "null", "eent", "zwee", "dräi", "véier", "fënnef", "sechs", "siwen", "aacht", "néng",
            "zéng", "eelef", "zwielef", "dräizéng", "véierzéng", "fofzéng", "siechzéng", "siwwenzéng", "uechtzéng", "nonzéng"
        ],
        "tens": ["", "", "zwanzeg", "drësseg", "véierzeg", "fofzeg", "siechzeg", "siwwenzeg", "achtzeg", "nonzeg"],
        "compoundOnes": ["", "een"],
        "connector": "an",
        "hundred": { "one": "honnert", "word": "honnert" },
        "thousand": { "one": "dausend", "word": "dausend" },
        "million": { "one": "eng Millioun", "plural": "Milliounen" },
        "billion": { "one": "eng Milliard", "plural": "Milliarden" }
    },
}
