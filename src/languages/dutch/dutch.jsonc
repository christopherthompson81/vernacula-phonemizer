// Native canonical-IPA MANIFEST for Dutch (nl) — Northern Standard Dutch (Netherlands), broad IPA, matching the
// wikipron nld_latn broad convention. Self-describing DATA (the vowel length maps, final-devoicing pairs, clause
// punctuation, number words); the ALGORITHMS (the open/closed length scan, the diphthong/digraph scanner, final
// devoicing, stress, number composition) stay in code (g2p.ts, dutch.ts, numbers.ts) and read these tables.
//
// LOAD-BEARING blocks (read via manifest.ts): "vowelChars", "vowels", "voicedFinal", "clausePunctuation",
// "numbers". "convention" / "provenance" are documentation.
{
    "language": "nl",
    "script": ["Latin"],
    "name": "Dutch (Northern Standard / Netherlands)",
    "provenance": "Cleanroom, rule-based g2p (open/closed-syllable vowel length, Dutch diphthongs, final devoicing g→x/ɣ, w→ʋ, h→ɦ) + a cardinal number compositor. The number words are language facts.",

    // The canonical-IPA conventions the values below are written in (documentation).
    "convention": {
        "vowelLength": "tense/long vs lax/short by syllable structure: open (V# or V.CV) → tense aː eː i oː y øː; closed (VC# or VCC) → lax ɑ ɛ ɪ ɔ ʏ; unstressed → ə",
        "finalDevoicing": "Auslautverhärtung — b/d/v/z/ɣ → p/t/f/s/x word/syllable-finally (hond → hɔnt, dag → dɑx)",
        "fricatives": "g is /ɣ/ in the onset (geven → ɣeːvə), /x/ in a coda (dag → dɑx); ch → x; sch → sx (school) / s (final -isch)",
        "glides": "diphthongs ɛi̯ (ij/ei) œy̯ (ui) ɑu̯ (ou/au) øː (eu); w → ʋ (labiodental); h → ɦ (voiced)",
        "numbers": "compound words, units before tens with the connector -en- (eenentwintig); split at thousand/million boundaries",
    },

    // IPA vowel inventory (nucleus detection).
    "vowelChars": "ɑaɛeɪioɔuyʏøœəɐ",

    // Orthographic vowel letter → IPA, chosen by the g2p's open/closed length rule. `long` = tense (open
    // syllable / doubled); `short` = lax (closed syllable). Trema letters (ë ï ö ü) base-map to their plain
    // vowel; they never join a preceding vowel into a digraph (tweeën → tʋeːə, the ë breaks the ⟨ee⟩).
    // Dutch's CONSONANT phone inventory — the engine tests it to collapse a doubled coda+onset across a
    // syllable seam, so it must list exactly the phones the tables above can emit (⟨ʋ⟩ for ⟨w⟩, ⟨ɦ⟩ for
    // ⟨h⟩, ⟨ɣ⟩ for the voiced velar fricative).
    "consonantPhones": [
        "p", "t", "k", "b", "d", "f", "s", "x", "ʃ", "ɣ", "v",
        "z", "ŋ", "n", "m", "l", "r", "ɦ", "j", "ʋ", "ɡ"
    ],

    "vowels": {
        "long": {
            "a": "aː",
            "e": "eː",
            "i": "i",
            "o": "oː",
            "u": "y",
            "y": "i",
            "ë": "eː",
            "ï": "i",
            "ö": "øː",
            "ü": "y",
        },
        "short": {
            "a": "ɑ",
            "e": "ɛ",
            "i": "ɪ",
            "o": "ɔ",
            "u": "ʏ",
            "y": "ɪ",
            "ë": "ɛ",
            "ï": "ɪ",
            "ö": "œ",
            "ü": "ʏ",
        },
    },

    // Context-free consonant letters → IPA (the g2p's final switch). The context-DEPENDENT letters g (ɣ/x),
    // c (s/k), s (sch), h (ɦ), x (→ks) and all digraphs/diphthongs stay in the g2p scanner.
    "consonants": {
        "b": "b",
        "d": "d",
        "f": "f",
        "j": "j",
        "k": "k",
        "l": "l",
        "m": "m",
        "n": "n",
        "p": "p",
        "q": "k",
        "r": "r",
        "s": "s",
        "t": "t",
        "v": "v",
        "w": "ʋ",
        "z": "z",
    },

    // Final devoicing (Auslautverhärtung): voiced obstruent → voiceless word/syllable-finally.
    "voicedFinal": { "b": "p", "d": "t", "v": "f", "z": "s", "ɣ": "x", "ʒ": "ʃ" },

    // Clause / phrase punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // acronyms Dutch SPELLS OUT even though the letter run is phonotactically readable, so the OOV
    // rule in core/initialisms.ts would otherwise hand them to the g2p as a word (CEO → seːoː, VOC → vɔk).
    // Lexical facts, one per attested convention; runs that are already unreadable (VS, VN, GMT, DNA, FBI,
    // MRI, NBA, PBS, NSA) need no entry because the phonotactic rule catches them. Entries marked ✓ occur in
    // the nl_nl corpus. Acronyms Dutch reads as WORDS (UNESCO, NAVO, NASA, FIFA, ISIS, COVID, ACTA, OPEC) are
    // deliberately ABSENT — listing them would spell out a word.
    "acronymLetters": [
        "us", // ✓ ×1 — US Corps of Engineers
        "usa", // ✓ ×2 — uu-es-aa
        "ussr", // ✓ ×1
        "ceo", // ✓ ×2
        "aol", // ✓ ×2
        "ehbo", // ✓ ×2 — eerste hulp bij ongelukken
        "voc", // ✓ ×2 — Vereenigde Oostindische Compagnie
        "ai", // ✓ ×1
        "it", // ✓ ×1
        "pa", // ✓ ×2 — only ALL-CAPS runs reach this pass, so the Dutch word "pa" is unaffected
        "bbp", // ✓ ×1 — bruto binnenlands product
        "eu", // Europese Unie — ee-uu
        "vk", // ✓ ×1 — Verenigd Koninkrijk
        "btw", // belasting toegevoegde waarde
        "cd",
        "dvd",
        "sms",
        "wc",
        "tv", // ✓ ×1
        "pc", // ✓ ×1
    ],

    // Cardinal number words. Units precede tens, compounded with the connector -en- (eenentwintig); composition
    // logic is in numbers.ts. Tens index 0/1 are unused (0-19 come from `ones`).
    "numbers": {
        "ones": [
            "nul",
            "een",
            "twee",
            "drie",
            "vier",
            "vijf",
            "zes",
            "zeven",
            "acht",
            "negen",
            "tien",
            "elf",
            "twaalf",
            "dertien",
            "veertien",
            "vijftien",
            "zestien",
            "zeventien",
            "achttien",
            "negentien",
        ],
        "tens": [
            "",
            "",
            "twintig",
            "dertig",
            "veertig",
            "vijftig",
            "zestig",
            "zeventig",
            "tachtig",
            "negentig",
        ],
        "connector": "en",
        "hundred": "honderd",
        "thousand": "duizend",
        "million": { "sg": "een miljoen", "pl": "miljoen" },
        "milliard": { "sg": "een miljard", "pl": "miljard" },
    },

    // Morphology for the shared West-Germanic compound engine (core/germanicMorphology.ts). Dutch compounds heavily
    // (stadhuis, voetbalveld). The g2p (g2p.ts) already handles a word's OWN prefix reduction (ge-/be-/ver-/te-) and
    // suffix schwa (-ig/-lijk/-isch) internally, so dutch.ts splits ONLY at compound (stem·stem) boundaries and
    // phonemizes each element with the existing engine — giving each its own stress + boundary devoicing
    // (stad·huis → stɑt·ɦœys, not stɑdɦœys). Affixes longest-first; the stem lexicon is hunspell nl.dic base forms.
    "morphology": {
        "prefixUnstressed": ["ver", "ont", "her", "be", "ge", "te"],
        "prefixStressed": ["achter", "binnen", "buiten", "onder", "tegen", "terug", "tussen", "samen", "over", "voor", "door", "mee", "aan", "af", "bij", "in", "om", "op", "na", "toe", "uit", "weg"],
        "ambiguousPrefixes": ["be", "ge", "te"],
        "suffixes": ["heid", "teit", "isme", "achtig", "baar", "loos", "zaam", "schap", "ling", "ende", "ing", "end", "lijk", "isch", "nis", "dom"],
        "vowelInitialSuffixes": ["achtig", "isme", "isch", "ende", "end"],
        "linkingElements": ["", "s", "en", "e"],
        "validOnsets": ["st", "sp", "sk", "sl", "sm", "sn", "sw", "sch", "schr", "str", "spr", "spl", "tr", "dr", "kr", "kn", "gr", "gl", "br", "bl", "pr", "pl", "fr", "fl", "vr", "vl", "kw", "tw", "dw", "zw", "kl"],
        "stKeep": []
    },
}
