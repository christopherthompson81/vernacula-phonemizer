// Native canonical-IPA definition for Balochi / بلوچی (bal) — Northwestern Iranian, ~9M speakers (Balochistan:
// Pakistan + Iran + Afghanistan, the Gulf, Turkmenistan). Target = SOUTHERN Balochi (the Jahani & Korn 2009
// reference variety), written in the Balochi ARABIC alphabet (the default script the Baloch use). Authored from
// Jahani & Korn, "Balochi", in *The Iranian Languages* (2009) — Table 11.1 (the Pakistan alphabet), Table 11.6
// (SWBal. consonants), Table 11.2 (ComBal. vowels). NO machine referee exists (no wikipron/kaikki/epitran for
// bal/bcc/bgn/bgp) → a hand-gold on the sourced inventory (test/balochi.test.ts), verdict .
//
// SIGNATURE (what makes Balochi distinct among the Iranian fleet fa/ps/ckb): the RETROFLEX series ٹ→ʈ, ڈ→ɖ, ڑ→ɽ
// (from Indic contact) contrasting with the DENTAL stops ت→t̪, د→d̪; no native /q/ (ق→k); Southern Balochi is
// UNASPIRATED. Peripheral loan fricatives f/x/ɣ kept at their written value.
//
// THE SCRIPT IS DEFECTIVE (a "variant without sufficient vowel-encoding"): the short vowels /a i u/ are UNWRITTEN
// (abjad), AND ⟨و⟩ conflates long /uː oː/ while ⟨ی⟩ conflates long /iː eː/. So the g2p recovers the consonant
// backbone + long-vowel POSITIONS but not the short vowels or the o/u–e/i quality — those are folded/defaulted
// (و→uː, ی→iː). This is the honest ceiling of an Arabic-script Balochi g2p.
{
    "language": "bal",
    "name": "Balochi (Southern)",
    "script": ["Arabic", "Latin"],
    "provenance": "Authored from Jahani & Korn (2009), 'Balochi', The Iranian Languages, Tables 11.1/11.2/11.6 (Southern Balochi, Pakistan alphabet). No machine referee — hand-gold on the sourced inventory. cannot-verify (defective vowel encoding).",

    "consonants": {
        "ب": "b", "پ": "p", "ت": "t̪", "ٹ": "ʈ", "ث": "s", "ج": "d͡ʒ", "چ": "t͡ʃ", "ح": "h", "خ": "x",
        "د": "d̪", "ڈ": "ɖ", "ذ": "z", "ر": "r", "ڑ": "ɽ", "ز": "z", "ژ": "ʒ", "س": "s", "ش": "ʃ",
        "ص": "s", "ض": "z", "ط": "t̪", "ظ": "z", "غ": "ɣ", "ف": "f", "ق": "k", "ک": "k", "گ": "ɡ",
        "ل": "l", "م": "m", "ن": "n", "ه": "h", "ھ": "h"
    },

    // Written (long) vowels + the matres lectionis. Short /a i u/ have NO letter (unwritten).
    "vowels": {
        "ا": "aː", "آ": "aː", "ے": "eː"
    },

    // Every letter that can WRITE a vowel — the three above plus the two ambivalent matres ⟨و⟩ and ⟨ی/ى⟩,
    // which are themselves in the set. This is the environment for the glide test in balochi.ts: ⟨و⟩/⟨ی⟩ are
    // the glides [w]/[j] word-initially or ADJACENT TO another vowel letter, and the long vowels [uː]/[iː]
    // between consonants. Two matres in a row therefore make each other a glide, which is what the defective
    // abjad intends.
    "vowelLetters": ["ا", "آ", "و", "ى", "ی", "ے"],

    // ⚠ THE ROMAN ORTHOGRAPHY, a SECOND full g2p in the same engine — Balochi is written in both scripts and
    // this half is PHONEMIC where the Arabic half is defective, so it resolves to full IPA on its own rather
    // than leaning on the lexicon. The two halves share nothing but the language.
    "roman": {
        // ⚠ ORTHOGRAPHIC, NOT IPA, AND NOT THE ARABIC-SCRIPT "vowelLetters" ABOVE — that one is the abjad's
        // set, for the other scan in this same engine. These are the Roman letters, then long vs short by
        // diacritic; a MACRON writes length.
        // ⚠ ⟨e o⟩ ARE LONG IN BOTH COLUMNS: Balochi has no short /e o/, so an unmarked ⟨e⟩ is still [eː].
        "vowelLetters": ["a", "e", "i", "o", "u"],
        "long": { "a": "aː", "e": "eː", "i": "iː", "o": "oː", "u": "uː" },
        "short": { "a": "a", "e": "eː", "i": "i", "o": "oː", "u": "u" },
        // Base consonants. ⟨t d⟩ are DENTAL [t̪ d̪] — the retroflex series below is derived from them.
        "consonants": {
            "b": "b", "p": "p", "t": "t̪", "d": "d̪", "k": "k", "g": "ɡ", "q": "k", "f": "f", "v": "v",
            "s": "s", "z": "z", "š": "ʃ", "ž": "ʒ", "c": "t͡ʃ", "j": "d͡ʒ", "x": "x", "ġ": "ɣ", "h": "h",
            "m": "m", "n": "n", "r": "r", "l": "l", "w": "w", "y": "j"
        },
        // A DOT BELOW makes the consonant retroflex; a HÁČEK makes it postalveolar. Keyed by the phone the
        // base letter already produced (hence "t̪"/"d̪" here, not ⟨t⟩/⟨d⟩) except where the letter is the
        // only handle — balochi.ts tries the phone first, then the letter.
        "retroflex": { "t̪": "ʈ", "d̪": "ɖ", "r": "ɽ", "n": "ɳ", "s": "ʂ", "l": "ɭ" },
        "postalveolar": { "c": "t͡ʃ", "s": "ʃ", "z": "ʒ", "j": "d͡ʒ" }
    },

    // NUMBERS — Balochi Arabic spellings; the canonical IPA is resolved through the cross-script lexicon
    // (balochi-lexicon.tsv now carries these headwords with their full vowels — the defective abjad cannot recover
    // them: ⟨هپت⟩ alone scans to *hpt̪). Composed by balochi/numbers.ts.
    // SOURCE: Jahani & Korn (2009), "Balochi", in *The Iranian Languages*, §3.1.6 / TABLE 11.19 (Cardinal Numbers),
    // first (= most common) variant per slot, Southern-Balochi reference variety. The system is IRANIAN in its
    // 1-999 core (units + irregular teens + round-ten words, groups linked by the enclitic connective -u, exactly
    // as in Persian: bīst-u-yak '21', do-sad '200') but INDIC in its MAGNITUDES: J&K give sad '100', hazār
    // '1,000', lak(k) '100,000', kurōr '10,000,000', arab '1,000,000,000' and NO word for 10^6 — so 1,000,000 is
    // dah lakk 'ten lakh'. NOT in J&K: sifr '0' (a Perso-Arabic loan; Table 11.19 starts at 1). 40 uses the
    // J&K variant čihil ⟨چهل⟩ (not čil ⟨چل⟩, which is a lexicon homograph of čul).
    "numbers": {
        "units": ["صفر", "یک", "دو", "سئے", "چار", "پنچ", "شش", "هپت", "هشت", "نو"],
        "teens": ["ده", "یازده", "دوازده", "سیزده", "چارده", "پنزده", "شنزده", "هبده", "هژده", "نوزده"],
        "tens": {
            "20": "بیست", "30": "سی", "40": "چهل", "50": "پنجاه",
            "60": "شست", "70": "هپتاد", "80": "هشتاد", "90": "نود"
        },
        "magnitudes": { "hundred": "سد", "thousand": "هزار", "lakh": "لک", "crore": "کرور", "arab": "ارب" },
        // The enclitic connective -u (J&K bīst-u-yak). Given as IPA, not orthography: written ⟨و⟩ it would be
        // misread by the abjad g2p (⟨و⟩ → uː, and ⟨سیو⟩ would reparse the ⟨ی⟩ as a glide), so numbers.ts appends
        // this single segment to the preceding word AFTER that word has been phonemized.
        "connectiveIpa": "u"
    },

    "clausePunctuation": {
        "،": ",", "؛": ",", "؟": "?", ".": ".", "?": "?", "!": "!", ",": ",", ":": ",", "…": "."
    }
}
