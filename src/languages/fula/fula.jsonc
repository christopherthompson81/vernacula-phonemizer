// Native canonical-IPA MANIFEST for Fula (ff, Fulfulde) — A
// self-describing description of the language's DATA, matching english.jsonc / arabic.jsonc: the longest-match
// orthography→IPA rule table and the clause punctuation. The ALGORITHM (the longest-match scan + penultimate
// stress) stays in code and reads these tables.
//
// LOAD-BEARING blocks (read via manifest.ts): "rules", "clausePunctuation". "convention" / "provenance" are
// self-describing documentation. The Adlam script (𞤀𞤁𞤂𞤃) is handled by fulaAdlam.ts, which transliterates Adlam→Boko before this g2p (identical IPA).
{
    "language": "ff",
    // ⚠ ORTHOGRAPHIC, NOT IPA. adlamToLatin emits the LATIN spelling of an Adlam word, and the Adlam
    // vowel LENGTHENER doubles the vowel letter it just wrote. These are those letters.
    "latinVowels": ["a", "e", "i", "o", "u"],

    // ⚠ THE ADLAM FRONT-END (𞤀𞤁𞤂𞤃, U+1E900–1E95F) — the second script Fula is registered for, transliterated
    // to the Boko/Latin orthography so the ONE g2p serves both. Adlam is the modern (1989, the Barry
    // brothers) phonemic alphabet for Fulfulde/Pular, in wide diaspora and West-African use.
    // Keys are the SMALL letters (U+1E922–1E943); the uppercase range folds onto them by a −0x22 offset in
    // fulaAdlam.ts, since Adlam case is not phonemic. The last four (va x gb z kp sh) are the loan letters,
    // mapped to the same Boko equivalents the Latin engine already uses so the two scripts stay consistent.
    "adlam": {
        "letters": {
            "𞤢": "a", "𞤣": "d", "𞤤": "l", "𞤥": "m", "𞤦": "b", "𞤧": "s", "𞤨": "p", "𞤩": "ɓ", "𞤪": "r", "𞤫": "e",
            "𞤬": "f", "𞤭": "i", "𞤮": "o", "𞤯": "ɗ", "𞤰": "ƴ", "𞤱": "w", "𞤲": "n", "𞤳": "k", "𞤴": "y", "𞤵": "u",
            "𞤶": "j", "𞤷": "c", "𞤸": "h", "𞤹": "q", "𞤺": "g", "𞤻": "ny", "𞤼": "t", "𞤽": "ŋ", "𞤾": "v", "𞤿": "x",
            "𞥀": "gb", "𞥁": "z", "𞥂": "kp", "𞥃": "sh"
        },
        // ⚠ ADLAM MARKS LENGTH AND GEMINATION WITH COMBINING MARKS, NOT BY DOUBLING — which is why the
        // transliteration has to DOUBLE the letter it just wrote rather than map these to anything:
        //   lengtheners (ALIF U+1E944 / VOWEL LENGTHENER U+1E945) double the preceding VOWEL (𞤢𞥅 → "aa" → aː)
        //   gemination  (U+1E946)                                double the preceding CONSONANT (𞤦𞥆 → "bb")
        // ⚠ WRITTEN AS SURROGATE PAIRS: these are ASTRAL codepoints and JSON has no \u{…} form. They are
        // also INVISIBLE combining marks, so a literal would be an unreadable blank in this file.
        // U+1E944 ALIF LENGTHENER, U+1E945 VOWEL LENGTHENER.
        "lengtheners": ["\uD83A\uDD44", "\uD83A\uDD45"],
        "gemination": "\uD83A\uDD46", // U+1E946 GEMINATION MARK
        "hamza": "\uD83A\uDD47", // → the glottal ⟨q⟩, which the Latin g2p already reads as [ʔ]
        // CONSONANT MODIFIER / GEMINATE CONSONANT MODIFIER / NUKTA — rare foreign-sound marks, dropped.
        "drop": ["\uD83A\uDD48", "\uD83A\uDD49", "\uD83A\uDD4A"] // U+1E948–1E94A
    },

    "script": ["Latin", "Adlam"],
    "name": "Fula (Fulfulde)",
    "provenance": "Cleanroom, rule-based g2p — Fulfulde Boko/Latin orthography is shallow and near-1:1; validated vs the r12a/Wikipedia references + languagesandnumbers. Sole census provider of the implosives ʄ (ƴ) / ɠ.",

    // The canonical-IPA conventions the values below are written in (documentation).
    "convention": {
        "implosives": "ɓ ɗ ɠ, and ƴ → ʄ (palatal implosive)",
        "prenasalised": "mb→ᵐb, nd→ⁿd, nj→ⁿd͡ʒ, ng→ᵑɡ; the doubled nasal nng→ŋːɡ (velar)",
        "gemination": "a doubled consonant → length mark Cː",
        "longVowels": "doubled vowels aa/ee/ii/oo/uu → long aː eː iː oː uː",
        "stress": "penultimate (a diphthong / long vowel counts as one nucleus)",
    },

    // Orthography → IPA rules, matched in ORDER (longest-match: multi-char keys precede the bare letter). Each
    // entry is [orthography, ipa, isNucleus] — isNucleus marks a vowel (for penultimate-stress placement).
    "rules": [
        ["nng", "ŋːɡ", false],
        ["mb", "ᵐb", false],
        ["nd", "ⁿd", false],
        ["nj", "ⁿd͡ʒ", false],
        ["ng", "ᵑɡ", false],
        ["ny", "ɲ", false],
        ["aa", "aː", true],
        ["ee", "eː", true],
        ["ii", "iː", true],
        ["oo", "oː", true],
        ["uu", "uː", true],
        ["bb", "bː", false],
        ["pp", "pː", false],
        ["tt", "tː", false],
        ["dd", "dː", false],
        ["cc", "t͡ʃː", false],
        ["jj", "d͡ʒː", false],
        ["kk", "kː", false],
        ["gg", "ɡː", false],
        ["ff", "fː", false],
        ["ss", "sː", false],
        ["mm", "mː", false],
        ["nn", "nː", false],
        ["rr", "ɾː", false],
        ["ll", "lː", false],
        ["ww", "wː", false],
        ["yy", "jː", false],
        ["ɓɓ", "ɓː", false],
        ["ɗɗ", "ɗː", false],
        ["ƴƴ", "ʄː", false],
        ["a", "a", true],
        ["e", "e", true],
        ["i", "i", true],
        ["o", "o", true],
        ["u", "u", true],
        ["b", "b", false],
        ["p", "p", false],
        ["t", "t", false],
        ["d", "d", false],
        ["c", "t͡ʃ", false],
        ["j", "d͡ʒ", false],
        ["k", "k", false],
        ["g", "ɡ", false],
        ["f", "f", false],
        ["s", "s", false],
        ["h", "h", false],
        ["m", "m", false],
        ["n", "n", false],
        ["ŋ", "ŋ", false],
        ["ɲ", "ɲ", false],
        ["ñ", "ɲ", false],
        ["r", "ɾ", false],
        ["l", "l", false],
        ["w", "w", false],
        ["y", "j", false],
        ["ɓ", "ɓ", false],
        ["ɗ", "ɗ", false],
        ["ɠ", "ɠ", false],
        ["ƴ", "ʄ", false],
        ["q", "ʔ", false],
    ],

    // Clause / phrase punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },
}
