// Native canonical-IPA data manifest for Totontepec Mixe (mto) — ayöök, Mixe-Zoquean (Mixean, Oaxaca,
// North Highland), ~6k, the modern SIL practical orthography. The g2p (totontepecmixe.ts) is AUTHORED FROM
// Crawford, *Totontepec Mixe Phonotagmemics* (SIL, 1963) — a published phonology (the bho/Balochi mold).
// The consonants + allophony are Crawford-grounded and confident; the modern-orthography VOWEL mapping is
// reconstructed from Crawford's example words (kääm 'pig'=/kæːm/, këp 'tree'=/kɨp/, üts 'I'=/ʌts/, ök
// 'dog'=/ʊk/) with the central-vowel series + the UNDERLINE diacritic as the disclosed residual.
//   · 9 VOWELS (Crawford §1.112): a→[a], e→[e], i→[i], o→[o], u→[u]; ä→[æ], ë→[ɨ], ü→[ʌ], ö→[ʊ]; a DOUBLED
//     vowel → LENGTH (kääm→kæːm). ⟨ts⟩→[t͡s], ⟨tx cy⟩→[t͡ʃ] (palatalized), ⟨x⟩→[ʃ], ⟨j⟩→[h], ⟨c⟩→[k],
//     ⟨ꞌ ' ⟩→[ʔ].
//   ⚠ POST-NASAL VOICING (§1.121d): /p t ts k/ → [b d d͡z ɡ] after a nasal (mp→mb, nt→nd, nts→nd͡z, nk→ŋɡ).
//   · /d g/ → the fricatives [ð ɣ] intervocalically; ⟨n⟩→[ŋ] before a velar; ⟨ny⟩→[ɲ].
// The allophony passes are code, in totontepecmixe.ts; the grapheme values live here. Stress (accentual,
// not lexical-tonal) is not emitted. Referee: the ASJP North-Highland-Mixe Swadesh list (coarse,
// independent) — inventory-only.
{
    "language": "mto",
    "name": "Totontepec Mixe (ayöök)",
    "script": ["Latin"],

    // Multi-letter graphemes (longest-first). ⟨tx cy ch⟩ = the palatalized affricate /cy/ [t͡ʃ]; ⟨ts⟩ =
    // /c/ [t͡s]; ⟨qu⟩ = [k]. (Nasal clusters ⟨ny⟩ + post-nasal voicing are handled in the passes.)
    "digraphs": [["tx", "t͡ʃ"], ["cy", "t͡ʃ"], ["ch", "t͡ʃ"], ["ts", "t͡s"], ["qu", "k"]],

    // Single vowel graphemes → IPA. The central/back special vowels (ä ë ü ö) are the reconstructed values.
    "vowels": { "a": "a", "e": "e", "i": "i", "o": "o", "u": "u", "ä": "æ", "ë": "ɨ", "ü": "ʌ", "ö": "ʊ" },

    // ⚠ POST-NASAL VOICING fires after these two ONLY — and the engine does emit [ŋ], which is absent on
    // purpose: the rule is conditioned on ⟨m n⟩, not on nasality in general.
    "voicingNasals": ["m", "n"],
    // The velars, for the intervocalic lenition pass.
    "velars": ["k", "ɡ", "ɣ"],

    // Single consonant graphemes → IPA. ⟨c⟩=[k], ⟨x⟩=[ʃ] (Crawford's retroflex /š/), ⟨j⟩=[h], ⟨v w⟩=[v]/[w],
    // ⟨y⟩=[j]; every apostrophe shape → [ʔ].
    "consonants": {
        "p": "p", "t": "t", "k": "k", "c": "k", "b": "b", "d": "d", "g": "ɡ", "m": "m", "n": "n", "s": "s",
        "x": "ʃ", "j": "h", "h": "h", "v": "v", "w": "w", "y": "j", "l": "l", "r": "ɾ", "f": "f", "z": "ʒ",
        "ʼ": "ʔ", "'": "ʔ", "’": "ʔ", "ꞌ": "ʔ", "`": "ʔ",
    },

    // Post-nasal voicing (Crawford §1.121d), keyed by the plain IPA.
    "postNasalVoice": { "p": "b", "t": "d", "k": "ɡ", "t͡s": "d͡z" },
}
