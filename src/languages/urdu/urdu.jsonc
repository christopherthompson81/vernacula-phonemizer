// Native canonical-IPA definition for Urdu (ur) — the Perso-Arabic abjad. Urdu is the SAME spoken language as
// Hindi, so the phoneme inventory is Hindi's (retroflex ʈ ɖ ɽ, dental t̪ d̪, breathy-voiced aspirates, ɦ, ɲ/ŋ).
// The g2p (g2p.ts) reads this file: consonant letters → IPA, aspiration via ھ (do-chashmi he), long vowels
// written with ا و ی ے, short vowels from harakat WHEN present (usually omitted — the deferred restoration
// subsystem), ں nasalization, shadda gemination. Stored in logical order = phonetic order, so RTL is a non-issue.
{
    "language": "ur",
    "name": "Urdu",
    "script": "Arabic (Nastaʿlīq)",
    "provenance": "Authored from the Unicode Arabic/Urdu chart + standard Urdu (= Hindi) phonology. This file IS the language data — the g2p reads it directly.",

    // Unambiguous consonant letters → canonical IPA.
    "consonants": {
        "ب": "b", "پ": "p", "ت": "t̪", "ٹ": "ʈ", "ث": "s",
        "ج": "d͡ʒ", "چ": "t͡ʃ", "ح": "ɦ", "خ": "x", "د": "d̪",
        "ڈ": "ɖ", "ذ": "z", "ر": "ɾ", "ڑ": "ɽ", "ز": "z",
        "ژ": "ʒ", "س": "s", "ش": "ʃ", "ص": "s", "ض": "z",
        "ط": "t̪", "ظ": "z", "غ": "ɣ", "ف": "f", "ق": "q",
        "ک": "k", "گ": "ɡ", "ل": "l", "م": "m", "ن": "n",
        "ہ": "ɦ", "ھ": "ɦ", "ء": "ʔ", "ع": "ʔ"
    },

    // ھ / ﮪ (do-chashmi he) right after a consonant makes it ASPIRATED/breathy (کھ→kʰ, بھ→bʱ, تھ→t̪ʰ).
    "aspirateHe": "ھ",

    // Aspirated realizations (base consonant + ھ). Voiceless → ʰ, voiced → ʱ (breathy).
    "aspirates": {
        "k": "kʰ", "p": "pʰ", "t̪": "t̪ʰ", "ʈ": "ʈʰ", "t͡ʃ": "t͡ʃʰ",
        "b": "bʱ", "d̪": "d̪ʱ", "ɖ": "ɖʱ", "d͡ʒ": "d͡ʒʱ", "ɡ": "ɡʱ", "ɽ": "ɽʱ", "ɾ": "ɾʱ", "l": "lʱ", "m": "mʱ", "n": "nʱ"
    },

    // Long-vowel / vowel-carrier letters (resolved in context by g2p).
    "longVowels": {
        "ا": "ɑː",  // alif — medial/long ɑː (word-initial bare alif = a vowel-carrier, handled in g2p)
        "آ": "ɑː",  // alif madda — ɑː
        "و": "oː",  // waw as vowel — DEFAULT oː (also uː/ɔː; ambiguous, lexical)
        "ی": "iː",  // ya as vowel — DEFAULT iː (also eː; ambiguous, lexical)
        "ے": "eː",  // bari ye — eː
        "ﯼ": "iː", "ﯽ": "iː", "ئ": "iː"
    },

    // و and ی act as CONSONANT glides word-initially or after a vowel.
    "glides": { "و": "ʋ", "ی": "j" },

    // Harakat (short-vowel diacritics) — usually ABSENT in running text (the restoration gap). Applied when present.
    "harakat": {
        "َ": "ə",  // zabar / fatha → ə
        "ِ": "ɪ",  // zer / kasra → ɪ
        "ُ": "ʊ",  // pesh / damma → ʊ
        "ٰ": "ɑː", // khari zabar (superscript alif) → ɑː
        "ً": "ən", "ٌ": "ʊn", "ٍ": "ɪn" // tanwin
    },
    "sukun": "ْ",   // jazm/sukun → no vowel
    "shadda": "ّ",  // tashdid → gemination (→ length)

    // Nasalization: ں (noon ghunna) + ٘ nasalize the preceding vowel.
    "nasalizers": ["ں", "٘"],

    // The DEFAULT short vowel inserted between consonants when none is written (the abjad's missing vowel). ə is
    // the statistical default; ɪ/ʊ are lexical. This is the crude stand-in for the deferred restoration subsystem.
    "inherentVowel": "ə",

    // Danda / ASCII → canonical inline pause marks.
    "clausePunctuation": {
        "۔": ".", "؟": "?", "،": ",", "؛": ",",
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Urdu spellings; canonical IPA DERIVED by running them through the same g2p (with harakat so the
    // short vowels are correct). Units + round tens + magnitudes; 21-99 irregular (bounded authoring task).
    "numbers": {
        // 21-99 are NOT compositional in Urdu — each is a fused word — so the shared composer's unit+tens
        // fallback produced "ایک بیس" ("one twenty") for 21. 23 of these 72 are independently attested
        // across three sources (the CLE-speech referee x20, wikipron x7, the FLEURS corpus x4), spread over
        // every decade with no contradictions; the engine reproduces the referee's phone sequence exactly
        // for the ones it prices (اکیس -> ɪkkˈiːs vs ɪ k k iː s). Written WITHOUT harakat on purpose: the
        // undiacritized forms read correctly here and in places better than diacritized ones would.
        // NOTE: 72 بہتر is a genuine homograph — bahattar "72" vs behtar "better" — so the referee entry
        // for that string attests the adjective, not the numeral.
        "compound": {
            "21": "اکیس",  // attested
            "22": "بائیس",  // attested
            "23": "تیئیس",
            "24": "چوبیس",  // attested
            "25": "پچیس",
            "26": "چھببیس",
            "27": "ستائیس",
            "28": "اٹھائیس",  // attested
            "29": "انتیس",
            "31": "اکتیس",
            "32": "بتیس",
            "33": "تینتیس",
            "34": "چونتیس",  // attested
            "35": "پینتیس",
            "36": "چھتیس",
            "37": "سینتیس",
            "38": "اڑتیس",
            "39": "انتالیس",
            "41": "اکتالیس",
            "42": "بیالیس",
            "43": "تینتالیس",
            "44": "چوالیس",  // attested
            "45": "پینتالیس",
            "46": "چھیالیس",
            "47": "سینتالیس",
            "48": "اڑتالیس",  // attested
            "49": "انچاس",
            "51": "اکیاون",
            "52": "باون",  // attested
            "53": "ترپن",
            "54": "چون",  // attested
            "55": "پچپن",
            "56": "چھپن",  // attested
            "57": "ستاون",
            "58": "اٹھاون",  // attested
            "59": "انسٹھ",  // attested
            "61": "اکسٹھ",
            "62": "باسٹھ",
            "63": "تریسٹھ",
            "64": "چوسٹھ",
            "65": "پینسٹھ",  // attested
            "66": "چھیاسٹھ",
            "67": "سڑسٹھ",
            "68": "اڑسٹھ",  // attested
            "69": "انہتر",
            "71": "اکہتر",
            "72": "بہتر",  // attested
            "73": "تہتر",  // attested
            "74": "چوہتر",
            "75": "پچہتر",
            "76": "چھہتر",  // attested
            "77": "ستتر",
            "78": "اٹھہتر",
            "79": "اناسی",  // attested
            "81": "اکیاسی",
            "82": "بیاسی",
            "83": "تراسی",
            "84": "چوراسی",
            "85": "پچاسی",
            "86": "چھیاسی",  // attested
            "87": "ستاسی",
            "88": "اٹھاسی",  // attested
            "89": "نواسی",
            "91": "اکانوے",  // attested
            "92": "بانوے",
            "93": "ترانوے",
            "94": "چورانوے",
            "95": "پچانوے",
            "96": "چھیانوے",  // attested
            "97": "ستانوے",
            "98": "اٹھانوے",
            "99": "ننانوے",  // attested
        },
        "units": ["صِفْر", "ایک", "دو", "تِین", "چار", "پانچ", "چھے", "سات", "آٹھ", "نَو"],
        "teens": ["دَس", "گِیارہ", "بارہ", "تیرہ", "چودہ", "پَندرہ", "سولہ", "سَترہ", "اَٹھارہ", "اُنِیس"],
        "tens": { "20": "بِیس", "30": "تِیس", "40": "چالِیس", "50": "پَچاس", "60": "ساٹھ", "70": "سَتَّر", "80": "اَسّی", "90": "نَوے" },
        "magnitudes": { "hundred": "سَو", "thousand": "ہَزار", "lakh": "لاکھ", "crore": "کَروڑ" },
        // Urdu reads a decimal point as اعشاریہ; without it "1.5" ran the two numbers together.
        "decimalWord": "اعشاریہ"
    }
}
