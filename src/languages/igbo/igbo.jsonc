// Native canonical-IPA definition for Igbo / Asụsụ Igbo (ig) — Igboid (Volta-Niger, Niger-Congo), Latin script.
// igbo.ts reads this file. Signature features: the
// labial-velar stops ⟨gb⟩→ɡ͡b / ⟨kp⟩→k͡p, the labialised ⟨nw⟩→ŋʷ ⟨gw⟩→ɡʷ ⟨kw⟩→kʷ, ⟨ny⟩→ɲ, ⟨ch⟩→t͡ʃ, ⟨j⟩→d͡ʒ,
// ⟨sh⟩→ʃ, ⟨gh⟩→ɣ; the 8-vowel harmony system with dotted ị→ɪ ọ→ɔ ụ→ʊ; and TWO tones (High=acute ˥, Low=grave ˩)
// + downstep — but Igbo standard orthography usually OMITS tone, so it is read only when marked (else no tone).
// NO independent referee exists (no wikipron/epitran/kaikki) → adjudicated gold.
{
    "language": "ig",
    "name": "Igbo",
    "script": "Latin",
    "provenance": "Authored from standard Igbo phonology (Emenanjo 1978; Green & Igwe 1963). No independent referee — anchored on an adjudicated gold.",

    // Multi-letter graphemes (longest-first): affricates, labial-velars, labialised, palatal nasal.
    "digraphs": { "ch": "t͡ʃ", "gb": "ɡ͡b", "gh": "ɣ", "gw": "ɡʷ", "kp": "k͡p", "kw": "kʷ", "nw": "ŋʷ", "ny": "ɲ", "sh": "ʃ" },

    // Single consonant letters → IPA. ⟨j⟩→d͡ʒ, ⟨y⟩→j (glide), ⟨r⟩→tap ɾ, ⟨ṅ⟩/⟨ŋ⟩→ŋ (velar nasal).
    "consonants": {
        "b": "b", "p": "p", "d": "d", "t": "t", "j": "d͡ʒ", "g": "ɡ", "k": "k",
        "f": "f", "v": "v", "s": "s", "z": "z", "h": "h", "m": "m", "n": "n",
        "l": "l", "r": "ɾ", "w": "w", "y": "j", "ṅ": "ŋ", "ŋ": "ŋ"
    },

    // Oral vowels → IPA. The dotted-below ị/ọ/ụ (→ ɪ/ɔ/ʊ, the [-ATR] harmony set) are derived in igbo.ts from the
    // base + combining dot.
    "vowels": { "a": "a", "e": "e", "i": "i", "o": "o", "u": "u" },

    // Two tones → Chao contour letters: High (acute), Low (grave); downstep (macron) → a lowered mid.
    "tones": { "high": "˥", "low": "˩", "down": "˧" },

    // CARDINAL NUMBERS — the MODERN DECIMAL system, which is what running text uses.
    //
    // ⚠ IGBO'S TRADITIONAL SYSTEM IS VIGESIMAL and this is not it. `ọgụ` (a score, 20) is real and current —
    // 5,859 whole-word corpus hits — but the decimal `iri abụọ` ("two tens") outnumbers it 7,814 to 5,859 and is
    // the form that composes regularly to arbitrary size. The referee config records the vigesimal numbers as
    // deferred; this table deliberately does not attempt them, and a vigesimal reading is not wrong Igbo, just a
    // different register.
    //
    // ⚠ MAGNITUDE FIRST, MULTIPLIER SECOND — settled by counting, not assumed, because one corpus phrase
    // (`otu nde`, "one million") looks like the opposite:
    //     iri abụọ 7,814 : abụọ iri 82        narị abụọ 492 : abụọ narị 10
    //     puku abụọ 1,099 : abụọ puku 4       nde abụọ 77 : abụọ nde 7        ijeri abụọ 8 : abụọ ijeri 0
    // 11:1 to 275:1 in every case. `otu nde` is the irregular MULTIPLIER-1 form (otu narị 1,347, otu puku 1,256,
    // otu nde 479), which is why `one` is stored separately from the multiplier series.
    //
    // Sourced from a 558,991-line ig.wikipedia dump; counts are whole-word/phrase hits. Igbo has NO
    // independent referee — wikipron ibo_latn, epitran ibo-Latn and the kaikki Igbo extract are all 404 — so the
    // corpus IS the evidence and the anchor is the adjudicated gold in test/igbo.test.ts.
    //
    // The corpus writes large numbers out in full, which is where the whole structure was read off:
    //     "otu nde, puku narị anọ na otu, narị asatọ na iri asaa na atọ"  = 1,401,873
    //      1×10⁶       1000×401             800 + 70 + 3
    "numbers": {
        // ⚠ `efu` IS THINLY SOURCED AND POLYSEMOUS. 5,239 whole-word hits, but most are "free"/"empty"
        // (`n'efu` = for free, `furu efu` = lost). It does appear in numeric slots — a scoreline `efu - 2`, and
        // `efu, akara` (zero, points) — which is the only numeral evidence for it. Digits never render as a bare
        // zero in practice, so little rests on it.
        "zero": "efu",
        "one": "otu",                                                            // 104,534
        // The multiplier series, used after a magnitude word. Index 2..9; index 0/1 unused (see `one`).
        "units": ["", "", "abụọ", "atọ", "anọ", "ise", "isii", "asaa", "asatọ", "itoolu"],
        //          57,990  26,470  16,985  16,098  isii    asaa    asatọ   itoolu
        "ten": "iri",                                                            // 44,831
        "hundred": "narị",                                                       // 11,804
        "thousand": "puku",                                                      //  9,000-odd
        "million": "nde",                                                        //  6,983 whole-word
        "billion": "ijeri",                                                      //  1,709
        "and": "na",                                                             // iri na otu 2,056
        // THE DECIMAL SEPARATOR — `ǹtụ̀kpọ`, n. "decimal point; decimal number".
        //
        // ⚠ THE ONLY WORD IN THIS TABLE WITH NO CORPUS COUNT BESIDE IT, and the only one a corpus could not have
        // supplied: 0 hits for it and every variant, 0 digit-point-digit instances, and the 89 whole-word `point`
        // hits are all English text inside the Igbo wiki. `ntụpọ` (552) is a near-miss meaning a SPOT/blemish.
        // Sourced instead from Nkọwa okwu (nkowaokwu.com), an Igbo dictionary published by a 501(c)(3) nonprofit,
        // whose own example is definitional: "E ji ntụkpọ ekewapụ nọmba nnuzuroke na nọmba ọgwa" — "ntụkpọ is used
        // to separate whole numbers from fractions". Cited as one lexical fact; no site text is reproduced.
        //
        // A WRITTEN corpus is the weakest evidence there is about how a symbol is SPOKEN — writers type `2.5` and
        // never spell out how they say it — so silence here meant nothing, and the layer's first version wrongly
        // read the fraction with the separator dropped. Stored UNTONED like every other entry: standard Igbo
        // orthography omits tone and igbo.ts voices it only when marked.
        "decimalWord": "ntụkpọ"
    },
    "clausePunctuation": {
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    }
}
