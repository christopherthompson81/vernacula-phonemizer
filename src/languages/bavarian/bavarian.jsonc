// Native canonical-IPA data manifest for Bavarian (bar) — Boarisch, an Upper-German (Austro-Bavarian) group of
// dialects (~14M, Bavaria/Austria/South Tyrol), Latin script. There is NO codified state orthography, but the
// Bavarian Wikipedia / Wiktionary uses a de-facto German-derived convention (⟨å⟩ for the dark [ɔ], ⟨ä ö ü⟩, ⟨ß⟩) —
// that convention is what the wikipron referee transcribes, so the g2p is well-defined against it. espeak-independent.
// The engine (bavarian.ts) is a greedy longest-match grapheme scan (digraphs/diphthongs first) + code rules the table
// can't express: r-vocalization (coda r→[ɐ̯], -er→[ɐ]), ch→[ç]/[x] (front/back split), n→[ŋ] before a velar, initial
// st/sp→ʃt/ʃp, geminate collapse. The referee is a NARROW transcription (lenis under-ring b̥ d̥ ɡ̥, fine vowel qualities,
// offglides) with ~1.29 dialect variants/headword → heavy folding + the backbone strip. See the investigation doc.
{
    "language": "bar",
    "name": "Bavarian (Boarisch)",
    "script": "Latin",

    // Multi-letter graphemes — scanned LONGEST-FIRST (see ORDER in bavarian.ts). The DIPHTHONGS map to two vowel
    // SEGMENTS (the offglide ◌̯ folds in the backbone). Bavarian's distinctive FALLING diphthongs ⟨ia ua oa⟩→[iɐ̯ uɐ̯ oɐ̯]
    // (Biaschtl→biɐ̯ʃ…, Duafa→duɐ̯fɐ, Boarisch→boɐ̯rɪʃ) — a hallmark that separates it from Standard German. The closing
    // diphthongs ⟨ei⟩→[ɑɛ̯], ⟨ai⟩→[ai̯], ⟨au⟩→[ɑɔ̯], ⟨eu äu⟩→[ɔy̯]; ⟨ie⟩→[i] (a length/quality digraph, Diensdåg→dinsdɔɡ).
    "digraphs": {
        "sch": "ʃ", "tsch": "d̥ʃ",
        "ch": "x", "ck": "k", "ng": "ŋ", "ph": "f", "tz": "t͡s", "qu": "kv", "th": "t", "dt": "t",
        "ia": "iɐ̯", "ua": "uɐ̯", "oa": "oɐ̯",
        "ei": "ɑɛ̯", "ai": "ai̯", "ay": "ai̯", "ey": "ai̯",
        "au": "ɑɔ̯", "eu": "ɔy̯", "äu": "ɔy̯", "oi": "oe",
        "ie": "i",
        "aa": "aː", "ee": "eː", "oo": "oː", "åå": "ɔ",
        "ss": "s"
    },

    // Single grapheme → canonical IPA. ⟨å⟩→[ɔ] (the dark a, the Bavarian orthography's signature letter), ⟨a⟩→[ɑ],
    // ⟨e⟩→[e], ⟨ä⟩→[ɛ], ⟨ö⟩→[œ], ⟨ü⟩→[y], ⟨é⟩→[e], ⟨y⟩→[y]. The stops ⟨b d g⟩ are the Bavarian voiceless-LENIS [b̥ d̥ ɡ̥]
    // (under-ring; folds/backbone-strips to b d ɡ); ⟨p t k⟩ fortis. ⟨w⟩→[ʋ], ⟨v⟩→[f], ⟨z⟩→[t͡s], ⟨s⟩→[s] (Bavarian does
    // NOT voice s→z), ⟨c⟩→[k], ⟨x⟩→[ks], ⟨j⟩→[j], ⟨r⟩→[r] (→[ɐ̯]/[ɐ] in coda, in code), ⟨h⟩→[h].
    "graphemes": {
        "a": "ɑ", "å": "ɔ", "e": "e", "i": "i", "o": "o", "u": "u",
        "ä": "ɛ", "ö": "œ", "ü": "y", "é": "e", "è": "ɛ", "á": "ɑ", "à": "ɑ", "â": "ɑ", "y": "y",
        "b": "b̥", "c": "k", "d": "d̥", "f": "f", "g": "ɡ̥", "h": "h", "j": "j", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "b̥", "r": "r", "s": "s", "t": "d̥",
        "v": "f", "w": "ʋ", "x": "ks", "z": "t͡s", "ß": "s"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // ── CARDINAL NUMBER WORDS ────────────────────────────────────────────────────────────────────────────────────
    // Source: omniglot.com/language/numbers/bavarian.htm (the Bairisch cardinal table). Bavarian is units-FIRST
    // like German but the connector has reduced from ⟨und⟩ to a bare linking ⟨-a-⟩: the source gives 21 as
    // "oana-zwånzg" and 22 as "zwoara-zwånzg", i.e. unit-stem + a + tens, fused into one word.
    //
    // JUDGMENT CALLS (Bavarian has NO codified orthography, and the source lists 2–4 spellings per numeral):
    //   1. The ⟨å⟩-using Bavarian-Wikipedia convention is picked wherever the source offers a choice (åcht, åchzg,
    //      zwånzg) — that is the convention the rest of this manifest and the wikipron referee are written in.
    //   2. The optional emphatic/counting ⟨-e⟩ (fiare, seggse, zwånzge, dreißge) is DROPPED: the bare stem is the
    //      figure-reading form. Likewise "oans" not "oas/àns", "zwoa" not "zwà", "fimf" not "fümf".
    //   3. Teens: the source's ⟨-zea⟩ series (dreizea, fiazea, fuchzea …) is used over the ⟨-zen⟩ variant.
    //   4. `compoundOnes` carries the linking stems the source shows for 1 and 2 — "oan-" (oanazwånzg, not
    //      *oansazwånzg) and "zwoar-" (zwoarazwånzg, with the hiatus-breaking ⟨r⟩); 3–9 link on their bare stem.
    "numbers": {
        "ones": [
            "null", "oans", "zwoa", "drei", "fiar", "fimf", "sechs", "siem", "åcht", "nein",
            "zeah", "öif", "zwöif", "dreizea", "fiazea", "fuchzea", "sechzea", "sibzea", "åchzea", "neizea"
        ],
        "tens": ["", "", "zwånzg", "dreißg", "fiazg", "fuchzg", "sechzg", "sibzg", "åchtzg", "neinzg"],
        "compoundOnes": ["", "oan", "zwoar"],
        "connector": "a",
        "hundred": { "one": "hundad", "word": "hundad" },
        "thousand": { "one": "dausnd", "word": "dausnd" },
        "million": { "one": "oa Million", "plural": "Millionen" },
        "billion": { "one": "oa Milliarde", "plural": "Milliardn" }
    },
}
