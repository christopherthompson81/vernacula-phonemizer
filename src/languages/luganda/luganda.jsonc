// Native canonical-IPA data manifest for Luganda / Oluganda (lg) — Bantu (Great Lakes, JE15), the Latin
// orthography, espeak-independent. The principal language of Uganda (~11M incl. L2). A greedy longest-match scan
// (luganda.ts) with CONSONANT GEMINATION (doubled → Cː) and VOWEL LENGTHENING before a prenasalised consonant
// (Buganda → buɡaːnda). Phonology grounded in Wikipedia (Luganda) + the epitran lug-Latn map. Signatures:
//   • 5 vowels a e i o u; DOUBLING = LENGTH (aa→aː …). Length is phonemic (bana 'four' vs baana 'children').
//   • PRENASALISED consonants as single onset units (mb→ᵐb, nd→ⁿd, ng→ᵑɡ, nj→ⁿɟ, nc→ⁿc, nk→ᵑk, mp→ᵐp, nf→ᵐf,
//     nv→ᵐv); ⟨ng'⟩→ŋ (velar nasal, distinct from ⟨ng⟩→ᵑɡ), ⟨ny⟩→ɲ; LABIALISATION ⟨Cw⟩→Cʷ.
//   • ⟨c⟩=c, ⟨j⟩=ɟ (voiceless/voiced palatal STOPS, Wikipedia — [tʃ]/[dʒ] are allophones before front vowels;
//     folded c~tʃ, ɟ~dʒ vs the epitran referee). ⟨l⟩=l, ⟨r⟩=ɾ (allophones the orthography already writes).
// TONE (3-way H/L/falling) is LEXICAL + UNWRITTEN → DEFERRED (not emitted). REFEREE = epitran lug-Latn only, which
// is itself RULE-based, so the comparison is partly circular (single-source, 🔷). See
// docs/investigations/lg_native_bringup_investigation.md.
{
    "language": "lg",
    "name": "Luganda (Oluganda)",
    "script": "Latin",
    "provenance": "Authored greedy g2p from the Luganda orthography; phonology per Wikipedia + epitran lug-Latn (the referee, rule-based → partly circular).",

    "convention": {
        "vowels": "5 vowels a e i o u; DOUBLING = LENGTH (aa→aː, ee→eː, ii→iː, oo→oː, uu→uː)",
        "prenasal": "⟨mb mp nf nv nd nt nc nj nk ng⟩ → ᵐb ᵐp ᵐf ᵐv ⁿd ⁿt ⁿc ⁿɟ ᵑk ᵑɡ (single onset units)",
        "velarNasal": "⟨ng'⟩ → ŋ (distinct from ⟨ng⟩ → ᵑɡ); ⟨nng'⟩ → ŋː; ⟨ny⟩ → ɲ, ⟨nny⟩ → ɲː",
        "gemination": "a doubled consonant is a GEMINATE Cː (bbiri→bːiri, kitto→citːo) — handled in code",
        "labialisation": "⟨Cw⟩ → Cʷ (bw→bʷ, gw→ɡʷ, …)",
        "palatalStops": "⟨c⟩=c, ⟨j⟩=ɟ (palatal STOPS, not affricates — Wikipedia); ⟨l⟩=l, ⟨r⟩=ɾ",
        "vowelLengthening": "a vowel before a prenasalised consonant is LONG (Buganda → buɡaːnda)",
        "tone": "3-way tone (H/L/falling) is LEXICAL + UNWRITTEN → DEFERRED"
    },

    // Orthography → canonical IPA. Scanner sorts keys LENGTH DESC (nng'/nny/ng'/ny + Cw + prenasal + vowel
    // digraphs → singles); consonant gemination + vowel-lengthening-before-prenasal are handled in code.
    "graphemes": {
        "nng'": "ŋː", "ng'": "ŋ", "nny": "ɲː", "ny": "ɲ", "n'": "ⁿ",
        "bw": "bʷ", "dw": "dʷ", "fw": "fʷ", "gw": "ɡʷ", "jw": "ɟʷ", "kw": "kʷ", "lw": "lʷ",
        "mw": "mʷ", "nw": "nʷ", "pw": "pʷ", "sw": "sʷ", "tw": "tʷ", "vw": "vʷ", "zw": "zʷ",
        "mb": "ᵐb", "mp": "ᵐp", "mf": "ᵐf", "mv": "ᵐv", "nf": "ᵐf", "nv": "ᵐv",
        "nd": "ⁿd", "nt": "ⁿt", "nc": "ⁿc", "nj": "ⁿɟ", "nk": "ᵑk", "ng": "ᵑɡ",
        "aa": "aː", "ee": "eː", "ii": "iː", "oo": "oː", "uu": "uː",
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "b": "b", "c": "c", "d": "d", "f": "f", "g": "ɡ", "h": "h", "j": "ɟ", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "p", "q": "k", "r": "ɾ", "s": "s", "t": "t",
        "v": "v", "w": "w", "x": "ks", "y": "j", "z": "z"
    },

    "clausePunctuation": {
        ".": " . ", "!": " ! ", "?": " ? ", "…": " … ", ",": " , ", ";": " ; ", ":": " : "
    }
}
