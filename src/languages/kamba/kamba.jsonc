// Native canonical-IPA data manifest for Kamba / Kikamba (kam) — Niger-Congo BANTU (E55), the Latin orthography,
// Kenya (~4M). A pure greedy longest-match scan (kamba.ts) — no code rules; the Bantu
// fricativization + prenasalization live entirely in the grapheme table (the Kikuyu pattern). Referee: en.wiktionary
// Kamba (HUMAN, only 5 words — a THIN anchor); phonology from the Omniglot Kikamba chart + Wikipedia (Roberts-Kohno
// 2000). Signatures:
//   • 7-vowel ATR — the TILDE marks vowel QUALITY, not nasalization (CONFIRMED by the 5 anchors: mũtĩ→mòté):
//     ⟨i⟩=i, ⟨ĩ⟩=e, ⟨e⟩=ɛ, ⟨a⟩=a, ⟨o⟩=ɔ, ⟨u⟩=u, ⟨ũ⟩=o. DOUBLING = LENGTH (aa→aː, ĩĩ→eː, ũũ→oː, …).
//   • KAMBA-SPECIFIC consonants (differ from Kikuyu): ⟨v⟩=β (Kamba writes [β] as ⟨v⟩, NOT ⟨b⟩ — the biggest
//     divergence; standalone ⟨b⟩ also →β for the older mission/Bible spelling); ⟨sy⟩=ʃ, ⟨ky⟩=tʃ (a palatal series
//     Kikuyu lacks); NO ⟨c⟩, NO ⟨g⟩=ɣ ([ɡ] surfaces only post-nasally in ⟨ng⟩). NO implosive (that was a Kambaata
//     mix-up).
//   • PRENASALIZED single onset units (post-nasal VOICING /t k s tʃ th/→[d ɡ z dʒ ð]): ⟨mb⟩=ᵐb, ⟨nd⟩=ⁿd, ⟨ng⟩=ᵑɡ,
//     ⟨nz⟩=ⁿz, ⟨nth⟩=ⁿð; ⟨ng'⟩=ŋ (velar nasal, distinct from ⟨ng⟩); ⟨ny⟩=ɲ; ⟨th⟩=ð; ⟨r⟩=ɾ (tap), ⟨y⟩=j, ⟨w⟩=w.
// TONE (2-tone H/L) is NOT written (contextual) → not emitted; the referee's tone marks + syllable dots are folded.
// CONTESTED (validate): ⟨th⟩ voicing [ð] (Omniglot + Wikipedia, 2 curated sources) vs [θ] (some descriptions) — went
// with [ð] (Kikuyu parallel); ⟨sy⟩=ʃ / ⟨ky⟩=tʃ are single-sourced. CARDINAL NUMBERS: the "numbers" block below (citation forms).
{
    "language": "kam",
    "name": "Kamba (Kikamba)",
    "script": "Latin",
    "provenance": "Authored greedy g2p from the Kamba Latin orthography; vowel system anchored on the 5-word en.wiktionary Kamba IPA referee (mũtĩ→mòté confirms ⟨ĩ⟩=e/⟨ũ⟩=o), consonants from the Omniglot Kikamba alphabet chart + Wikipedia Kamba consonant table (cites Roberts-Kohno 2000); a THIN single-source referee → .",

    "convention": {
        "vowels": "7-vowel ATR; TILDE = QUALITY not nasal — ⟨i⟩=i, ⟨ĩ⟩=e, ⟨e⟩=ɛ, ⟨a⟩=a, ⟨o⟩=ɔ, ⟨u⟩=u, ⟨ũ⟩=o",
        "length": "a doubled vowel is LONG — aa→aː, ĩĩ→eː, ũũ→oː, ee→ɛː, ii→iː, oo→ɔː, uu→uː",
        "labialFricative": "⟨v⟩=β (Kamba's spelling of the Bantu [β]); standalone ⟨b⟩ also →β (older mission/Bible orthography) — [b] appears only post-nasally in ⟨mb⟩",
        "palatals": "⟨sy⟩=ʃ, ⟨ky⟩=tʃ (Kamba palatal series — Kikuyu has ⟨c⟩ instead; Kamba has NO ⟨c⟩); ⟨ny⟩=ɲ, ⟨y⟩=j",
        "dentalFricative": "⟨th⟩=ð (CONTESTED [ð]~[θ]; went with voiced per Omniglot/Wikipedia + Kikuyu parallel); ⟨nth⟩=ⁿð",
        "prenasal": "⟨mb nd ng nz nth⟩ → ᵐb ⁿd ᵑɡ ⁿz ⁿð (single onset units; post-nasal voicing /t k s tʃ th/→[d ɡ z dʒ ð])",
        "velarNasal": "⟨ng'⟩ → ŋ (distinct from ⟨ng⟩ → ᵑɡ); the trigraph is matched before a bare apostrophe, which is otherwise a typographic quote → dropped (Kamba has NO phonemic glottal stop)",
        "noGloss": "NO native ⟨c⟩ (Kamba uses ⟨sy ky⟩) / NO ⟨g⟩=ɣ (that is Kikuyu's, not Kamba's) — but ⟨c d g j z⟩ ARE kept as loan/name values (c=tʃ, d=d, g=ɡ, j=dʒ, z=z) so borrowings like Daudi/kadeti don't silently drop a consonant",
        "tone": "2-tone (H/L) NOT written (contextual) → not emitted; the referee marks it (á/à) + syllable dots → folded"
    },

    // Scanner sorts keys LENGTH DESC: trigraphs ⟨ng'⟩⟨nth⟩ (3) → digraphs (prenasal, ⟨th sy ky ny⟩, vowel-length) → singles.
    "graphemes": {
        "ng'": "ŋ", "nth": "ⁿð",
        "ĩĩ": "eː", "ũũ": "oː", "aa": "aː", "ee": "ɛː", "ii": "iː", "oo": "ɔː", "uu": "uː",
        "mb": "ᵐb", "nd": "ⁿd", "ng": "ᵑɡ", "nz": "ⁿz",
        "sy": "ʃ", "ky": "tʃ", "ny": "ɲ", "th": "ð",
        "ĩ": "e", "ũ": "o", "a": "a", "e": "ɛ", "i": "i", "o": "ɔ", "u": "u",
        "v": "β", "b": "β", "s": "s", "z": "z", "t": "t", "d": "d", "k": "k", "l": "l", "r": "ɾ",
        "w": "w", "y": "j", "m": "m", "n": "n", "f": "f", "p": "p", "h": "h",
        "g": "ɡ", "c": "tʃ", "j": "dʒ"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // CARDINAL NUMBERS — the CITATION / COUNTING series, i.e. the manual's own kũtala "to count" list, NOT a
    // concord form for an arbitrary noun class (a TTS reading a bare integer has no noun to agree with).
    // PRIMARY SOURCE: the Peace Corps *Kikamba Self-Instruction Manual* (hosted at livelingua.com), Lesson 6
    // "Syĩndu Syiana? – How Many Are They?", vocabulary pp. 28–29 + the grammar note on p. 29 ("Numbers are
    // quantitative adjectives. Numbers one to five when used as adjectives take the prefix which agrees with the
    // noun modified. … The numbers six to ten are never inflected."). That table gives verbatim: Ĩmwe, Ĩlĩ,
    // Itatũ, Inya, Itano, Thanthatũ, Mũonza, Nyanya, Keenda, Ĩkũmi, Ĩkũmi na ĩmwe, Miongo ĩlĩ … Miongo keenda,
    // Ĩana (I/MA, pl. Maana), Ĩana yĩmwe, Maana elĩ, Ngili ĩmwe, Ngili ĩkũmi, Milioni. Zero = "Noti / nzilo"
    // (same manual, vocabulary list). Cross-checked against Omniglot "Numbers in Kamba".
    // The COMPOSITION rule is attested in the same manual's running text and is what the shared E5x composer
    // implements: components juxtaposed with "na" before the LAST one only — "maana elĩ na mĩongo ĩtano" (250),
    // "ĩana na mĩongo itano" (150, note bare Ĩana before a remainder), and the year 1957 as
    // "ngili ĩmwe maana kenda mĩongo ĩtano na mũonza".
    // SIMPLIFIED / EXTRAPOLATED: only maana elĩ (200) is attested for the hundreds multiplier; 300–500 are
    // extrapolated with the class-6 a- concord the manual documents (Andũ elĩ / atatũ), and 600–900 reuse the
    // uninflected 6–9 stems. No word for "billion": 10⁹ composes as milioni ngili ĩmwe ("a thousand million"),
    // extending the manual's own ngili ĩkũmi = 10 000 multiplicative pattern instead of inventing a loan.
    "numbers": {
        "zero": "noti",
        "units": ["", "ĩmwe", "ĩlĩ", "itatũ", "inya", "itano", "thanthatũ", "mũonza", "nyanya", "keenda"],
        "ten": "ĩkũmi",
        "tens": "miongo",
        "tensMult": ["", "", "ĩlĩ", "ĩtatũ", "ina", "ĩtano", "thanthatũ", "mũonza", "nyanya", "keenda"],
        "hundredOne": "ĩana yĩmwe",
        "hundredRest": "ĩana",
        "hundreds": "maana",
        "hundredsMult": ["", "", "elĩ", "atatũ", "ana", "atano", "thanthatũ", "mũonza", "nyanya", "keenda"],
        "thousand": "ngili",
        "million": "milioni",
        "and": "na"
    }
}
