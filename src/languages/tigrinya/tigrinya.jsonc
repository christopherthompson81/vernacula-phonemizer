// Native canonical-IPA definition for Tigrinya / ትግርኛ (ti) — Ethiopian Semitic (North Ethiosemitic, ~9M, Eritrea +
// Tigray), written in the Ge'ez/Fidäl SYLLABARY-abugida (each codepoint = a whole CV syllable). Read by the SHARED
// Ge'ez engine (core/geez.ts — the same fidel→CV lookup + epenthetic-ɨ deletion as Amharic `am`); the per-language
// difference is entirely in fidel.tsv.
//
// TIGRINYA'S SIGNATURE = the PRESERVED SEMITIC GUTTURALS that Amharic merged away:
//   • ⟨ሐ ኀ⟩ series → [ħ] (voiceless pharyngeal — Amharic flattens both to [h])
//   • ⟨ዐ⟩ series (ʕayn) → [ʕ] (voiced pharyngeal — Amharic drops it to a bare vowel)
//   • ⟨አ⟩ series (ʔälef) → [ʔ] (glottal onset — kept, unlike Amharic's bare-vowel fix)
//   • ⟨ኸ⟩ → [x] (spirantised k), ⟨ቀ⟩ → [kʼ] (velar ejective — the human referee's value; epitran renders it [q]).
// The guttural 1st-order vowel stays CENTRAL [ə] (kaikki ʔɐf, ʔɐdɾi), NOT lowered to [a] as in Amharic.
// UNWRITTEN (shared with Amharic): GEMINATION (phonemic, unmarked → single, folded) and the epenthetic 6th-order
// [ɨ]. Ejectives kʼ tʼ t͡ʃʼ pʼ t͡sʼ.
{
    "language": "ti",
    "name": "Tigrinya",
    "script": ["Ethiopic"],
    "provenance": "Fidel→CV syllabary adapted from the Amharic table with the Tigrinya guttural restoration (ħ/ʕ/ʔ/x) and central guttural-1st vowel, calibrated to kaikki tir (human) + epitran tir-Ethi; numbers authored from standard Tigrinya.",

    "clausePunctuation": {
        "።": ".", "፣": ",", "፤": ",", "፥": ",", "፦": ",", "፧": "?", "፨": ".",
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Tigrinya (Fidel) spellings; canonical IPA DERIVED via the same fidel→CV g2p. The units 1–10 are all
    // attested in the kaikki referee (ሓደ→ħadə, ክልተ→kɨltə, … ዓሰርተ→ʕasərtə). Units + teens (ዓሰርተ + unit) + round
    // tens + magnitudes; 21-99 compose as "tens unit" with the ን conjunction (below).
    //
    // SOURCE: Fitsum Gaim, "Tigrinya Number Verbalization: Rules, Algorithm, and Implementation", arXiv:2601.03403
    // — Table 1 (digits / tens / SCALES) and §3.1–3.3 (the conjunction system + the hundred-form alternation).
    // Scales per that table: 10²  ሚእቲ · 10³ ሽሕ · 10⁶ ሚልዮን · 10⁹ ቢልዮን (Tigrinya loans the scales above thousand).
    // The paper's variant spellings ሽዱሽተ (6), ሱሳ (60), ቴስዓ (90) are NOT adopted here — the repo's ሽድሽተ / ስሳ / ተስዓ
    // are the kaikki-calibrated forms already validated by the fidel g2p; both sets are attested.
    //
    // CONJUNCTION (paper §3.1–3.3): the suffix ን "and" attaches to EVERY term of an additive chain of length ≥ 2
    // (25 → ዕስራን ሓሙሽተን), and to NOTHING in a chain of length 1 (40 → ኣርብዓ; 700 → ሸውዓተ ሚእቲ). A multiplier of a
    // scale word is not itself a chain term (309 → ሰለስተ ሚእትን ትሽዓተን — ሰለስተ bare). A teen is ONE chain term, with
    // no internal ን (118 → ሚእትን ዓሰርተ ሸሞንተን). ሚእቲ has the allomorph ሚእትን when suffixed (§3.2); every other word
    // just takes ን. The leading ሓደ of a bare 1×scale is optional in the paper and omitted here (1000 → ሽሕ).
    "numbers": {
        "units": ["ዜሮ", "ሓደ", "ክልተ", "ሰለስተ", "ኣርባዕተ", "ሓሙሽተ", "ሽድሽተ", "ሸውዓተ", "ሸሞንተ", "ትሽዓተ"],
        "ten": "ዓሰርተ",
        "teenPrefix": "ዓሰርተ",
        "tens": { "20": "ዕስራ", "30": "ሰላሳ", "40": "ኣርብዓ", "50": "ሓምሳ", "60": "ስሳ", "70": "ሰብዓ", "80": "ሰማንያ", "90": "ተስዓ" },
        "hundred": "ሚእቲ", "hundredConjoined": "ሚእትን", "thousand": "ሽሕ", "million": "ሚልዮን", "billion": "ቢልዮን",
        "conjunction": "ን"
    }
}
