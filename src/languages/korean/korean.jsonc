// Native canonical-IPA data manifest for Korean (ko) — Seoul standard.
// This file IS the hand-authored language DATA: the jamo inventories (Unicode decomposition order), the
// onset / vowel / coda letter→IPA tables, the coda-cluster resolution table, the 7-way neutralisation and
// sandhi class maps, clause punctuation, and the Sino-Korean number words. The ALGORITHMS that read it stay
// in code:
//   g2p.ts     — Hangul syllable decomposition + cross-syllable sandhi (liaison, palatalization, voicing,
//                aspiration, tensification, nasalization, lateralization) + coda neutralisation + stress
//   numbers.ts — 만/억/조 group compositor (→ Hangul, then through the g2p)
//   korean.ts  — tokenizer + clause assembly
// The lexical-tensification exceptions stay in the sibling tensification.tsv (append-heavy wikipron data).
//
// Format: plain JSONC. Every phoneme value is CANONICAL IPA (contributes ̚ unreleased, ͈ tense).
{
    "language": "ko",
    "name": "Korean (Seoul standard)",
    "script": "Hangul",
    "provenance": "Authored from the Hangul jamo chart + standard Seoul phonology; the lexical-tensification exceptions are derived from wikipron (tensification.tsv). This file IS the language data — the native decomposition/sandhi engine reads it directly.",

    "convention": {
        "coda": "7-way neutralisation; obstruent codas unreleased ̚ (밥→pɐp̚)",
        "voicing": "lenis ㄱㄷㅂㅈ → ɡdbd͡ʑ between sonorants (가다→kɐdɐ)",
        "tense": "fortis series marked ͈ (학교→hɐk̚k͈jo)",
        "stress": "ˈ before the first heavy (coda-bearing) syllable's nucleus, else the first syllable",
    },

    // Jamo inventories in Unicode decomposition index order (drives the algorithmic syllable-block split).
    // "coda" omits the leading null coda (prepended in code) so its index lines up with the Unicode T value.
    "jamo": {
        "onset": "ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ",
        "vowel": "ㅏㅐㅑㅒㅓㅔㅕㅖㅗㅘㅙㅚㅛㅜㅝㅞㅟㅠㅡㅢㅣ",
        "coda": "ㄱㄲㄳㄴㄵㄶㄷㄹㄺㄻㄼㄽㄾㄿㅀㅁㅂㅄㅅㅆㅇㅈㅊㅋㅌㅍㅎ",
    },

    // Onset (initial) jamo → phoneme (underlying, before voicing). ㅇ = null onset.
    "onset": {
        "ㄱ": "k",
        "ㄲ": "k͈",
        "ㄴ": "n",
        "ㄷ": "t",
        "ㄸ": "t͈",
        "ㄹ": "ɾ",
        "ㅁ": "m",
        "ㅂ": "p",
        "ㅃ": "p͈",
        "ㅅ": "s",
        "ㅆ": "s͈",
        "ㅇ": "",
        "ㅈ": "t͡ɕ",
        "ㅉ": "t͡ɕ͈",
        "ㅊ": "t͡ɕʰ",
        "ㅋ": "kʰ",
        "ㅌ": "tʰ",
        "ㅍ": "pʰ",
        "ㅎ": "h",
    },
    "vowel": {
        "ㅏ": "ɐ",
        "ㅐ": "ɛ",
        "ㅑ": "jɐ",
        "ㅒ": "jɛ",
        "ㅓ": "ɘ",
        "ㅔ": "e",
        "ㅕ": "jɘ",
        "ㅖ": "je",
        "ㅗ": "o",
        "ㅘ": "wɐ",
        "ㅙ": "wɛ",
        "ㅚ": "we",
        "ㅛ": "jo",
        "ㅜ": "u",
        "ㅝ": "wɘ",
        "ㅞ": "we",
        "ㅟ": "wi",
        "ㅠ": "ju",
        "ㅡ": "ɯ",
        "ㅢ": "ɯi",
        "ㅣ": "i",
    },

    // Coda jamo → { cons: survivor before a consonant/pause (UNDERLYING jamo); lc: coda kept when liaised before
    // a vowel; lo: consonant released to the next onset when liaised }. Single codas keep their underlying jamo
    // (so liaison restores it: 같이 → ㅌ → t͡ɕʰ); clusters split.
    "coda": {
        "ㄱ": { "cons": "ㄱ", "lc": "", "lo": "ㄱ" },
        "ㄲ": { "cons": "ㄲ", "lc": "", "lo": "ㄲ" },
        "ㄴ": { "cons": "ㄴ", "lc": "", "lo": "ㄴ" },
        "ㄷ": { "cons": "ㄷ", "lc": "", "lo": "ㄷ" },
        "ㄹ": { "cons": "ㄹ", "lc": "", "lo": "ㄹ" },
        "ㅁ": { "cons": "ㅁ", "lc": "", "lo": "ㅁ" },
        "ㅂ": { "cons": "ㅂ", "lc": "", "lo": "ㅂ" },
        "ㅅ": { "cons": "ㅅ", "lc": "", "lo": "ㅅ" },
        "ㅆ": { "cons": "ㅆ", "lc": "", "lo": "ㅆ" },
        "ㅇ": { "cons": "ㅇ", "lc": "ㅇ", "lo": "ㅇ" },
        "ㅈ": { "cons": "ㅈ", "lc": "", "lo": "ㅈ" },
        "ㅊ": { "cons": "ㅊ", "lc": "", "lo": "ㅊ" },
        "ㅋ": { "cons": "ㅋ", "lc": "", "lo": "ㅋ" },
        "ㅌ": { "cons": "ㅌ", "lc": "", "lo": "ㅌ" },
        "ㅍ": { "cons": "ㅍ", "lc": "", "lo": "ㅍ" },
        "ㅎ": { "cons": "ㅎ", "lc": "", "lo": "ㅎ" },
        "ㄳ": { "cons": "ㄱ", "lc": "ㄱ", "lo": "ㅅ" },
        "ㄵ": { "cons": "ㄴ", "lc": "ㄴ", "lo": "ㅈ" },
        "ㄶ": { "cons": "ㄴ", "lc": "ㄴ", "lo": "ㅎ" },
        "ㄺ": { "cons": "ㄱ", "lc": "ㄹ", "lo": "ㄱ" },
        "ㄻ": { "cons": "ㅁ", "lc": "ㄹ", "lo": "ㅁ" },
        "ㄼ": { "cons": "ㄹ", "lc": "ㄹ", "lo": "ㅂ" },
        "ㄽ": { "cons": "ㄹ", "lc": "ㄹ", "lo": "ㅅ" },
        "ㄾ": { "cons": "ㄹ", "lc": "ㄹ", "lo": "ㅌ" },
        "ㄿ": { "cons": "ㅂ", "lc": "ㄹ", "lo": "ㅍ" },
        "ㅀ": { "cons": "ㄹ", "lc": "ㄹ", "lo": "ㅎ" },
        "ㅄ": { "cons": "ㅂ", "lc": "ㅂ", "lo": "ㅅ" },
    },

    // Underlying coda jamo → surface phoneme (7-way neutralisation; obstruents unreleased ̚).
    "codaPhoneme": {
        "ㄱ": "k̚",
        "ㄲ": "k̚",
        "ㅋ": "k̚",
        "ㄷ": "t̚",
        "ㅅ": "t̚",
        "ㅆ": "t̚",
        "ㅈ": "t̚",
        "ㅊ": "t̚",
        "ㅌ": "t̚",
        "ㅎ": "t̚",
        "ㅂ": "p̚",
        "ㅍ": "p̚",
        "ㄴ": "n",
        "ㅁ": "m",
        "ㅇ": "ŋ",
        "ㄹ": "ɭ",
    },

    // Codas that are sonorant (nasal + ㄹ separately); presence gates lenis voicing and the ㄹ→ㄴ rule.
    "nasalCodas": "ㄴㅁㅇ",

    // 7-way coda neutralisation to a representative jamo (for the obstruent-based sandhi rules).
    "neutralize": {
        "ㄱ": "ㄱ",
        "ㄲ": "ㄱ",
        "ㅋ": "ㄱ",
        "ㄷ": "ㄷ",
        "ㅅ": "ㄷ",
        "ㅆ": "ㄷ",
        "ㅈ": "ㄷ",
        "ㅊ": "ㄷ",
        "ㅌ": "ㄷ",
        "ㅎ": "ㄷ",
        "ㅂ": "ㅂ",
        "ㅍ": "ㅂ",
        "ㄴ": "ㄴ",
        "ㅁ": "ㅁ",
        "ㅇ": "ㅇ",
        "ㄹ": "ㄹ",
    },
    // Obstruent coda → homorganic nasal, before a nasal onset (nasalization).
    "obstruentToNasal": { "ㄱ": "ㅇ", "ㄷ": "ㄴ", "ㅂ": "ㅁ" },

    // Lenis onset phoneme → its voiced allophone (between sonorants).
    "voice": { "k": "ɡ", "t": "d", "p": "b", "t͡ɕ": "d͡ʑ" },
    // Lenis onset phoneme → its tense counterpart (used to test tensifiability).
    "tense": { "k": "k͈", "t": "t͈", "p": "p͈", "t͡ɕ": "t͡ɕ͈", "s": "s͈" },
    // Lenis onset jamo → its tense counterpart jamo (fortis). Used by rule tensification AND lexical 경음화.
    "tenseJamo": { "ㄱ": "ㄲ", "ㄷ": "ㄸ", "ㅂ": "ㅃ", "ㅅ": "ㅆ", "ㅈ": "ㅉ" },

    // Aspiration onset substitutions (a lenis onset jamo → its aspirated jamo).
    "aspiration": {
        "hCodaLenisOnset": { "ㄱ": "ㅋ", "ㄷ": "ㅌ", "ㅈ": "ㅊ", "ㅅ": "ㅆ" }, // ㅎ coda + lenis onset
        "stopCodaHOnset": { "ㄱ": "ㅋ", "ㄷ": "ㅌ", "ㅂ": "ㅍ" }, // (neutralised) stop coda + ㅎ onset
    },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        "…": ",",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Sino-Korean cardinal reading → Hangul (then through the g2p). Within a myriad group the place words 십/백/천
    // are glued (leading 1 dropped: 십 not 일십); groups scale by 만/억/조.
    "numbers": {
        "ones": ["영", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구"],
        "ten": "십",
        "hundred": "백",
        "thousand": "천",
        "myriadUnits": ["", "만", "억", "조"], // 10^0, 10^4, 10^8, 10^12

        // The NATIVE series, in the PRENOMINAL form a counter takes (한 명, not 하나 명). Used only by
        // normalize.ts, for the counters that select it (명 개 시 시간 번째); the series stops at 아흔아홉,
        // so 100 and above is Sino for every counter. 20 alone is 스무 (스물 only before a ones digit).
        "native": {
            "ones": ["", "한", "두", "세", "네", "다섯", "여섯", "일곱", "여덟", "아홉"],
            "tens": ["", "열", "스물", "서른", "마흔", "쉰", "예순", "일흔", "여든", "아흔"],
            "twenty": "스무",
        },
    },
}
