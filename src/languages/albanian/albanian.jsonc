// Native canonical-IPA data manifest for Standard Albanian (sq) — Shqip (Tosk-based standard), Latin (36 letters).
// Indo-European, its OWN branch. Fairly phonemic, with a rich DIGRAPH system:
// ⟨dh⟩→ð, ⟨th⟩→θ, ⟨sh⟩→ʃ, ⟨zh⟩→ʒ, ⟨xh⟩→d͡ʒ, ⟨gj⟩→ɟ (voiced palatal stop), ⟨nj⟩→ɲ, ⟨ll⟩→ɫ (dark l), ⟨rr⟩→r (trill).
// Singles: ⟨q⟩→c (voiceless palatal), ⟨c⟩→t͡s, ⟨ç⟩→t͡ʃ, ⟨x⟩→d͡z, ⟨j⟩→j, ⟨r⟩→ɾ (tap), ⟨l⟩→l. Seven vowels
// ⟨a e i o u y ë⟩ with ⟨e⟩→[ɛ], ⟨y⟩→[y] (front rounded), ⟨ë⟩→[ə] (schwa). A longest-match scan + penultimate stress.
// Engine: albanian.ts.
{
    "language": "sq",
    "name": "Albanian (Shqip)",
    "script": "Latin",

    // Scanned LONGEST-FIRST (all two-letter). The fricative/affricate/palatal/liquid digraphs.
    "digraphs": {
        "dh": "ð", "th": "θ", "sh": "ʃ", "zh": "ʒ", "xh": "d͡ʒ",
        "gj": "ɟ", "nj": "ɲ", "ll": "ɫ", "rr": "r"
    },

    // Single graphemes. The 7 vowels (⟨e⟩→ɛ, ⟨y⟩→y, ⟨ë⟩→ə) + the consonants (⟨q⟩→c palatal, ⟨c⟩→t͡s, ⟨ç⟩→t͡ʃ,
    // ⟨x⟩→d͡z, ⟨r⟩→ɾ tap, ⟨l⟩→l).
    "graphemes": {
        "a": "a", "e": "ɛ", "i": "i", "o": "o", "u": "u", "y": "y", "ë": "ə",
        "b": "b", "c": "t͡s", "ç": "t͡ʃ", "d": "d", "f": "f", "g": "ɡ", "h": "h", "j": "j",
        "k": "k", "l": "l", "m": "m", "n": "n", "p": "p", "q": "c", "r": "ɾ", "s": "s",
        "t": "t", "v": "v", "x": "d͡z", "z": "z"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // ── CARDINAL NUMERALS ────────────────────────────────────────────────────────────────────────────────
    // SOURCE: Newmark, Hubbard & Prifti, *Standard Albanian: A Reference Grammar for Students* (Stanford,
    // 1982), the cardinal-numeral section; cross-checked against Wiktionary's Albanian numeral entries and
    // the FGJSH (Fjalor i gjuhës shqipe) headwords. Tosk-based standard. Composition rules in numbers.ts.
    //
    // Decimal and regular. ⟨njëzet⟩ "20" and ⟨dyzet⟩ "40" are etymologically "one twenty" / "two twenties"
    // (a vigesimal fossil), but the system as a whole is decimal — 30/50/60/70/80/90 are all unit+dhjetë —
    // so they are stored as plain round-ten words, not as a base change.
    "numbers": {
        // 0–9. ⟨tre⟩ (masculine) is the CITATION form; the feminine ⟨tri⟩ is not emitted (see numbers.ts).
        "units": ["zero", "një", "dy", "tre", "katër", "pesë", "gjashtë", "shtatë", "tetë", "nëntë"],
        // 10–19: unit + ⟨mbë⟩ + dhjetë ("on ten"). ⟨tre⟩ appears as ⟨tre-⟩ in trembëdhjetë.
        "teens": [
            "dhjetë", "njëmbëdhjetë", "dymbëdhjetë", "trembëdhjetë", "katërmbëdhjetë",
            "pesëmbëdhjetë", "gjashtëmbëdhjetë", "shtatëmbëdhjetë", "tetëmbëdhjetë", "nëntëmbëdhjetë"
        ],
        "tens": {
            "20": "njëzet", "30": "tridhjetë", "40": "dyzet", "50": "pesëdhjetë",
            "60": "gjashtëdhjetë", "70": "shtatëdhjetë", "80": "tetëdhjetë", "90": "nëntëdhjetë"
        },
        // Round hundreds — FUSED (unit + qind), written as one word: njëqind, dyqind, treqind, …
        "hundreds": [
            "", "njëqind", "dyqind", "treqind", "katërqind",
            "pesëqind", "gjashtëqind", "shtatëqind", "tetëqind", "nëntëqind"
        ],
        // ⟨mijë⟩ is invariant; ⟨milion⟩/⟨miliard⟩ take the plural ⟨-ë⟩ above one.
        "magnitudes": {
            "thousand": "mijë",
            "million": "milion", "millionPlural": "milionë",
            "billion": "miliard", "billionPlural": "miliardë"
        },
        // The connector ⟨e⟩ "and", obligatory between the groups of a composed numeral: njëzet e një "21",
        // njëqind e një "101", një mijë e dyqind e tridhjetë e katër "1234".
        "connector": "e"
    },
}
