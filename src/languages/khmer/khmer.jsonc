// Khmer / ភាសាខ្មែរ (km) — Austroasiatic (Mon-Khmer), the Khmer abugida, canonical IPA. khmer.ts reads this file.
// Khmer's defining feature is the TWO CONSONANT SERIES: every base consonant is a-series (1st, inherent ɑː) or
// o-series (2nd, inherent ɔː), and the SAME vowel sign is read differently by series. Non-tonal. Consonant clusters
// are written with subscripts (coeng ្). The series values + vowel two-readings were DERIVED from wikipron khm.
{
    "language": "km",
    "name": "Khmer",
    "script": "Khmer",

    // Base consonant → [onset IPA, series ("a" | "o")]. The series sets the inherent vowel and the vowel-sign reading.
    "consonants": {
        "ក": ["k", "a"], "ខ": ["kʰ", "a"], "គ": ["k", "o"], "ឃ": ["kʰ", "o"], "ង": ["ŋ", "o"],
        "ច": ["c", "a"], "ឆ": ["cʰ", "a"], "ជ": ["c", "o"], "ឈ": ["cʰ", "o"], "ញ": ["ɲ", "o"],
        "ដ": ["ɗ", "a"], "ឋ": ["tʰ", "a"], "ឌ": ["ɗ", "o"], "ឍ": ["tʰ", "o"], "ណ": ["n", "a"],
        "ត": ["t", "a"], "ថ": ["tʰ", "a"], "ទ": ["t", "o"], "ធ": ["tʰ", "o"], "ន": ["n", "o"],
        "ប": ["ɓ", "a"], "ផ": ["pʰ", "a"], "ព": ["p", "o"], "ភ": ["pʰ", "o"], "ម": ["m", "o"],
        "យ": ["j", "o"], "រ": ["r", "o"], "ល": ["l", "o"], "វ": ["ʋ", "o"],
        "ស": ["s", "a"], "ហ": ["h", "a"], "ឡ": ["l", "a"], "អ": ["ʔ", "a"]
    },
    // Vowel sign → [a-series reading, o-series reading] (derived from wikipron). ំ/ះ carry a nasal-m / -h coda.
    "vowels": {
        "ា": ["aː", "iə"], "ិ": ["ə", "ɨ"], "ី": ["əj", "iː"], "ឹ": ["ə", "ɨ"], "ឺ": ["əɨ", "ɨː"],
        "ុ": ["o", "u"], "ូ": ["ou", "uː"], "ួ": ["uə", "uə"], "ើ": ["aə", "əː"], "ឿ": ["ɨə", "ɨə"],
        "ៀ": ["iə", "iə"], "េ": ["eː", "eː"], "ែ": ["ae", "ɛː"], "ៃ": ["aj", "ɨj"], "ោ": ["ao", "oː"],
        "ៅ": ["aw", "ɨw"], "ំ": ["ɑm", "um"], "ះ": ["ah", "eəh"]
    },
    // Multi-char vowels: a base vowel sign + ⟨ះ⟩ (reahmuk, adds -h) or ⟨ំ⟩ (nikahit, adds -m). The combination
    // shortens/re-colours the base vowel, so it needs its own [a-series, o-series] readings (derived from wikipron:
    // កោះ kɑh / ភ្លោះ pʰluəh, ចុះ coh / លុះ luh, ចេះ ceh, ជុំ cum / ដុំ ɗom, កាំ kam).
    "vowelCombos": {
        "ោះ": ["ɑh", "uəh"], "ុះ": ["oh", "uh"], "េះ": ["eh", "eh"], "ិះ": ["eh", "eh"],
        "ែះ": ["ɛh", "ɛh"], "ាះ": ["ah", "eəh"], "ុំ": ["om", "um"], "ាំ": ["am", "oəm"],
        "ិំ": ["əm", "em"], "ើះ": ["aəh", "əːh"]
    },
    // Final consonant (coda) → IPA. Khmer final ⟨ស⟩ → [h]; final ⟨រ⟩ is silent.
    // INDEPENDENT VOWELS (U+17A3–U+17B3) — a letter that IS a syllable: its own onset (ʔ, or r/l for the vocalic
    // four) plus its own vowel, taking no dependent vowel sign. The syllabifier SKIPPED these entirely, marked
    // "Phase 1", so every one was silently deleted from the reading: ឬដក read *ɗɑːk*, ឯណា read *naː*. 176,282
    // occurrences in the mined corpus (#585), 103,144 of them followed by a consonant.
    //
    // ⚠ THESE ARE THE IN-WORD READINGS, NOT THE LETTER NAMES, and the two differ. Standing alone as a word ឧ is
    // ʔoʔ (km-lexicon.tsv and wikipron agree) while inside a word it is ʔu — ឧត្តម ʔutɗɑm. The lexicon already
    // serves the standalone forms; this table serves the rule engine, so it carries the in-word value.
    //
    // Sourced from google/language-resources' Khmer pronunciation dictionary (CC BY 4.0, 69,184 entries) by taking
    // the first syllable of every word that BEGINS with each vowel and stripping a trailing coda consonant — j and
    // w are kept, being diphthong off-glides rather than codas, which a first pass wrongly stripped and turned ឦ
    // (ʔəj) into ʔə. Cross-checked against wikipron's human transcriptions and our own km-lexicon.tsv wherever
    // those cover a letter; all three agree on every one of the eight they share. `n` is the dictionary count.
    "independentVowels": {
        "ឣ": "ʔɑ",      // n=21
        "ឤ": "ʔaː",     // n=29
        "ឥ": "ʔə",      // n=85  (standalone ʔeʔ)
        "ឦ": "ʔəj",     // n=7,  and lexicon + wikipron
        "ឧ": "ʔu",      // n=239 (standalone ʔoʔ)
        "ឨ": "ʔao",     // ⚠ THIN: no word-initial entries; from the dictionary's single-letter entry, coda
                        // stripped. One occurrence in the whole corpus, so nothing rests on it.
        "ឩ": "ʔuː",     // n=12
        "ឪ": "ʔəw",     // n=15, and lexicon + wikipron all agree
        "ឫ": "rɨ",      // n=64 — the vocalic four: ឫ rɨ / ឬ rɨː / ឭ lɨ / ឮ lɨː, short-long and r-l
        "ឬ": "rɨː",     // lexicon + wikipron + the dictionary's single-letter entry
        "ឭ": "lɨ",      // រឭក rɔ.lɨk and រំឭក rum.lɨk — dictionary ×3, wikipron ×2
        "ឮ": "lɨː",     // n=6, and lexicon + wikipron
        "ឯ": "ʔae",     // n=84, and lexicon + wikipron
        "ឰ": "ʔaj",     // n=8
        "ឱ": "ʔao",     // n=80
        "ឲ": "ʔao",     // an allograph of ឱ; the dictionary gives both the same reading
        "ឳ": "ʔəw"      // lexicon + wikipron (the dictionary's single-letter entry says ʔaw)
    },
    "codas": {
        "ក": "k", "ខ": "k", "គ": "k", "ង": "ŋ", "ច": "c", "ជ": "c", "ញ": "ɲ",
        "ដ": "t", "ត": "t", "ថ": "t", "ទ": "t", "ធ": "t", "ណ": "n", "ន": "n",
        "ប": "p", "ព": "p", "ភ": "p", "ម": "m", "យ": "j", "រ": "", "ល": "l", "វ": "w",
        "ស": "h", "ហ": "h", "ឡ": "l"
    },
    // Inherent vowel [a-series, o-series] when no vowel sign is written.
    "inherent": ["ɑː", "ɔː"],

    "clausePunctuation": {
        "។": ".", "៕": ".", "?": "?", "!": "!", ",": ",", ".": ".", "៖": ","
    }
}
