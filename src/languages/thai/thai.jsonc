// Native canonical-IPA data manifest for Thai (th) — authored beyond-espeak.
// This file IS the hand-authored context-free DATA: the onset / coda / vowel-quality grapheme→IPA tables, the
// vowel-length exception sets, and the full tone system (consonant class × mark × life/length → tone → Chao
// letters). The ALGORITHMS that read it stay in code:
//   syllabifier.ts — the orthographic parser (leading-vowel reorder, อักษรนำ leaders, the schwa/inherent-vowel
//                    algorithm, syllable segmentation) — the context-sensitive scanner, kept as code
//   thaiTone.ts    — the tone-computation functions (effective class w/ silent-leader raise, computeThaiTone)
//   g2p.ts         — {onset, nucleus, coda, tone} → IPA rendering + stress; segment.ts — word segmentation
// The bulk lexica stay as sibling files (dictionary.tsv irregulars, seg-words.txt segmentation dictionary).
//
// Format: plain JSONC. Every phoneme value is CANONICAL IPA (contributes ɤ; tones as Chao contour letters).
// See docs/investigations/th_native_bringup_investigation.md.
{
    "language": "th",
    "name": "Thai",
    "script": "Thai",
    "provenance": "Authored from Thai orthography + phonology; the tone system is ported from Wiktionary Module:th-pron (CC-BY-SA, tone facts as provenance). This file IS the language data — the native syllabifier/renderer reads it directly. Irregulars are patched from a dictionary (dictionary.tsv).",

    "convention": {
        "tone": "Chao contour letters at syllable end; tone = consonant class × mark × (life × length)",
        "glottal": "a word-final short open syllable takes a glottal ʔ (จะ → t͡ɕaʔ)",
        "stress": "ˈ on syllable 1; ˌ on even syllable indices ≥2 (3, 5, 7…)",
    },

    // Onset consonant grapheme → IPA. อ = glottal ʔ; a silent ห/อ leader is dropped before this map is consulted.
    "onset": {
        "ก": "k",
        "ข": "kʰ",
        "ฃ": "kʰ",
        "ค": "kʰ",
        "ฅ": "kʰ",
        "ฆ": "kʰ",
        "ง": "ŋ",
        "จ": "t͡ɕ",
        "ฉ": "t͡ɕʰ",
        "ช": "t͡ɕʰ",
        "ซ": "s",
        "ฌ": "t͡ɕʰ",
        "ญ": "j",
        "ฎ": "d",
        "ฏ": "t",
        "ฐ": "tʰ",
        "ฑ": "tʰ",
        "ฒ": "tʰ",
        "ณ": "n",
        "ด": "d",
        "ต": "t",
        "ถ": "tʰ",
        "ท": "tʰ",
        "ธ": "tʰ",
        "น": "n",
        "บ": "b",
        "ป": "p",
        "ผ": "pʰ",
        "ฝ": "f",
        "พ": "pʰ",
        "ฟ": "f",
        "ภ": "pʰ",
        "ม": "m",
        "ย": "j",
        "ร": "r",
        "ล": "l",
        "ว": "w",
        "ศ": "s",
        "ษ": "s",
        "ส": "s",
        "ห": "h",
        "ฬ": "l",
        "อ": "ʔ",
        "ฮ": "h",
        "ฤ": "r",
    },
    // Coda consonant grapheme → IPA (8-way final neutralisation).
    "coda": {
        "ก": "k",
        "ข": "k",
        "ค": "k",
        "ฆ": "k",
        "ง": "ŋ",
        "จ": "t",
        "ช": "t",
        "ซ": "t",
        "ฎ": "t",
        "ฏ": "t",
        "ฐ": "t",
        "ฑ": "t",
        "ฒ": "t",
        "ด": "t",
        "ต": "t",
        "ถ": "t",
        "ท": "t",
        "ธ": "t",
        "ศ": "t",
        "ษ": "t",
        "ส": "t",
        "ญ": "n",
        "ณ": "n",
        "น": "n",
        "ร": "n",
        "ล": "n",
        "ฬ": "n",
        "บ": "p",
        "ป": "p",
        "พ": "p",
        "ฟ": "p",
        "ภ": "p",
        "ม": "m",
        "ย": "j",
        "ว": "w",
    },
    // Written-vowel unit (graphemes joined) → base quality (no length; ː is added from the scan's `long`).
    "vowelQuality": {
        "ะ": "a",
        "ั": "a",
        "า": "a",
        "ิ": "i",
        "ี": "i",
        "ึ": "ɯ",
        "ื": "ɯ",
        "ือ": "ɯ",
        "ุ": "u",
        "ู": "u",
        "ๅ": "a",
        "ัว": "ua",
        "ัวะ": "ua",
        "ว": "ua",
        "เ": "e",
        "เะ": "e",
        "แ": "ɛ",
        "แะ": "ɛ",
        "โ": "o",
        "โะ": "o",
        "เาะ": "ɔ",
        "เอ": "ɤ",
        "เอะ": "ɤ",
        "เิ": "ɤ",
        "เย": "ɤ",
        "เา": "a",
        "อ": "ɔ",
        "เีย": "ia",
        "เียะ": "ia",
        "เือ": "ɯa",
        "เือะ": "ɯa",
        "ไ": "a",
        "ใ": "a",
        "ไย": "a",
        "ำ": "a",
    },
    "noLength": ["ua", "ia", "ɯa"], // diphthongs — never take ː
    "forceLong": ["เอ", "เิ"], // เ–อ / เ–ิ are ɤː (long); the short exceptions (เงิน) are in the dict
    "raisable": "งญณนมยรลฬว", // sonorants a silent ห leader raises (drops the ห onset)

    // Tone system — a deterministic function of initial-consonant CLASS × syllable LIFE × vowel LENGTH × mark.
    "tone": {
        // Thai consonant → tonal class (อักษร กลาง/สูง/ต่ำ): 9 mid, 11 high, 24 low.
        "class": {
            "ก": "mid",
            "จ": "mid",
            "ฎ": "mid",
            "ฏ": "mid",
            "ด": "mid",
            "ต": "mid",
            "บ": "mid",
            "ป": "mid",
            "อ": "mid",
            "ข": "high",
            "ฃ": "high",
            "ฉ": "high",
            "ฐ": "high",
            "ถ": "high",
            "ผ": "high",
            "ฝ": "high",
            "ศ": "high",
            "ษ": "high",
            "ส": "high",
            "ห": "high",
            "ค": "low",
            "ฅ": "low",
            "ฆ": "low",
            "ง": "low",
            "ช": "low",
            "ซ": "low",
            "ฌ": "low",
            "ญ": "low",
            "ฑ": "low",
            "ฒ": "low",
            "ณ": "low",
            "ท": "low",
            "ธ": "low",
            "น": "low",
            "พ": "low",
            "ฟ": "low",
            "ภ": "low",
            "ม": "low",
            "ย": "low",
            "ร": "low",
            "ล": "low",
            "ฬ": "low",
            "ว": "low",
            "ฮ": "low",
        },
        // Tone from an explicit tone mark × class (mai ek/tho/tri/chattawa; ̄ = respelling-only forced mid).
        "fromMark": {
            "่": { "high": "low", "mid": "low", "low": "falling" },
            "้": { "high": "falling", "mid": "falling", "low": "high" },
            "๊": { "high": "high", "mid": "high", "low": "high" },
            "๋": { "high": "rising", "mid": "rising", "low": "rising" },
            "̄": { "high": "mid", "mid": "mid", "low": "mid" },
        },
        // Tone with NO mark, from syllable life+length × class.
        "noMark": {
            "dead-short": { "high": "low", "mid": "low", "low": "high" },
            "dead-long": { "high": "low", "mid": "low", "low": "falling" },
            "live": { "high": "rising", "mid": "mid", "low": "mid" },
        },
        // IPA Chao contour letters per tone.
        "ipa": {
            "high": "˦˥",
            "mid": "˧",
            "low": "˨˩",
            "rising": "˩˩˦",
            "falling": "˥˩",
        },
    },

    // Clause-terminating punctuation → canonical inline pause marks.
    "clausePunctuation": {
        ".": ".",
        "!": "!",
        "?": "?",
        ",": ",",
        ";": ",",
        ":": ",",
    },

    // Thai Character Cluster (TCC) rules — ported from PyThaiNLP (Apache-2.0; the Theeramunkong et al. algorithm).
    // Each alternative matches ONE inseparable cluster at the START of a string; segment.ts joins these with "|"
    // and wraps them "^(?:…)" to build THAI_TCC_RE (word boundaries are constrained to cluster boundaries).
    // ORDER IS LOAD-BEARING (leftmost-first, like the Python `|`). The literal `|` inside `[ูุ|ิ]` is faithful to
    // PyThaiNLP's expanded rule (its `[d|ิ]` template) — kept verbatim for parity; harmless since `|` never
    // occurs in a Thai run.
    "tcc": [
        "[ก-ฮ][ั]([่-๋][ก-ฮ])?",
        "[ก-ฮ][ั]([่-๋][ก-ฮ])?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ][่-๋]?าะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ]ี[่-๋]?ยะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ]ี[่-๋]?ย(?=[เ-ไก-ฮ]|$)([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ิีุู][่-๋]?ย(?=[เ-ไก-ฮ]|$)([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ][ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ิ[ก-ฮ]์[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ิ[่-๋]?[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ี[่-๋]?ยะ?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ื[่-๋]?อะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "เ[ก-ฮ]ื",
        "เ[ก-ฮ][่-๋]?า?ะ?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[ก-ฮ][ึื][่-๋]?[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[ก-ฮ][ะ-ู][่-๋]?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[ก-ฮ][ิุู]์",
        "[ก-ฮ]รร[ก-ฮ]์",
        "[ก-ฮ]็",
        "[ก-ฮ][่-๋]?[ะาำ]?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][ก-ฮ]์([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][่-๋]?ะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][ก-ฮ]็[ก-ฮ]([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "แ[ก-ฮ][ก-ฮ][ก-ฮ]์([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "โ[ก-ฮ][่-๋]?ะ([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "[เ-ไ][ก-ฮ][่-๋]?([ก-ฮ][ก-ฮ]?[ูุ|ิ]?[์])?",
        "ก็",
        "อึ",
        "หึ",
    ],
}
