// Native canonical-IPA data manifest for Luo / Dholuo (luo) — Western Nilotic (Luo group), Latin orthography,
// Spoken around Lake Victoria in Kenya + Tanzania (~4–5M).
// A greedy longest-match scan (luo.ts) with ONE code rule: a high vowel ⟨i u⟩ before another vowel becomes the glide
// ⟨j w⟩ (dhiang' → ðjaŋ). Phonology grounded in the 17-word en.wiktionary Luo IPA referee + Tucker (1994) 'A Grammar
// of Kenya Luo (Dholuo)' + Okoth-Okombo (1982) 'Dholuo Morphophonemics'. Signatures:
//   • DENTAL vs ALVEOLAR contrast — ⟨th dh⟩ → θ ð (dental) vs ⟨t d⟩ → t d (alveolar). We emit θ/ð to MATCH the
//     referee's ð directly (dhiang'→ðjæŋ; Tucker analyses these as dental plosives t̪/d̪ — an unsettled manner
//     question, no fold applied). NOTE the referee coverage is thin: only ⟨dh⟩→ð is attested (one word); ⟨th⟩→θ is
//     backed by Tucker + test/luo.test.ts, NOT by the referee (no ⟨th⟩ word in the 17).
//   • PRENASALISED voiced stops as single onset units — ⟨mb nd nj ng⟩ → ᵐb ⁿd ⁿd͡ʒ ᵑɡ; ⟨ng'⟩ → ŋ (velar nasal,
//     distinct from ⟨ng⟩ → ᵑɡ); ⟨ny⟩ → ɲ.
//   • PALATALS — ⟨ch⟩ → t͡ʃ (the referee also writes c / t͡ɕ — one palatal, folded), ⟨j⟩ → d͡ʒ, ⟨y⟩ → j.
//   • 9-vowel ±ATR system, but the orthography writes only 5 letters a e i o u and marks NO ATR trigger → ATR is
//     UNWRITTEN / harmonic → unrecoverable from spelling. We emit the +ATR (tense) default i e o u and FOLD [±ATR]
//     (ɪ~i ɛ~e ɔ~o ʊ~u) in the eval — the principled cap, like tone.
//   • ⟨r⟩ → ɾ (tap, folded r~ɾ). Register TONE (H/L) is UNWRITTEN → DEFERRED (folded). Single-source (): the only
//     numeric referee is the 17-word Wiktionary set; consonants corroborated by Tucker.
{
    "language": "luo",
    "name": "Luo (Dholuo)",
    "script": "Latin",
    "provenance": "Authored greedy g2p from the Dholuo orthography; mapping from the 17-word en.wiktionary Luo IPA referee + Tucker (1994) / Okoth-Okombo (1982).",

    "convention": {
        "dental": "⟨th dh⟩ → θ ð (dental) vs ⟨t d⟩ → t d (alveolar) — the Dholuo dental/alveolar contrast",
        "prenasal": "⟨mb nd nj ng⟩ → ᵐb ⁿd ⁿd͡ʒ ᵑɡ (single prenasalised onset units)",
        "velarNasal": "⟨ng'⟩ → ŋ (distinct from ⟨ng⟩ → ᵑɡ); ⟨ny⟩ → ɲ",
        "palatals": "⟨ch⟩ → t͡ʃ, ⟨j⟩ → d͡ʒ, ⟨y⟩ → j",
        "vowels": "5 letters a e i o u; the 9-vowel ±ATR distinction is UNWRITTEN → emit the +ATR default, fold [±ATR]",
        "glide": "a high vowel ⟨i u⟩ before another vowel → glide ⟨j w⟩ (dhiang' → ðjaŋ) — handled in code",
        "rhotic": "⟨r⟩ → ɾ (tap)",
        "tone": "register tone (H/L) is UNWRITTEN → DEFERRED (not emitted)"
    },

    // Orthography → canonical IPA. Scanner sorts keys LENGTH DESC (ng' → the mb/nd/nj/ng/ny/ch/dh/th/sh digraphs →
    // singles); the high-vowel-glide rule is handled in code (luo.ts).
    "graphemes": {
        "ng'": "ŋ",
        "mb": "ᵐb", "nd": "ⁿd", "nj": "ⁿd͡ʒ", "ng": "ᵑɡ",
        "ny": "ɲ", "ch": "t͡ʃ", "dh": "ð", "th": "θ", "sh": "ʃ",
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u",
        "b": "b", "c": "t͡ʃ", "d": "d", "f": "f", "g": "ɡ", "h": "h", "j": "d͡ʒ", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "p", "q": "k", "r": "ɾ", "s": "s", "t": "t",
        "v": "v", "w": "w", "x": "ks", "y": "j", "z": "z"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    }
}
