// Egyptian Arabic (arz) variety data. Applied on the MSA g2p output (the "restore MSA then transform" path): the
// shared Arabic engine + diacritizer produce the MSA vocalization, and these Cairene shifts make it Egyptian.
// See docs/investigations/arz_egyptian_bringup_investigation.md.
//
// Two kinds, because they need different scopes:
//   consonantShifts — unambiguous string rewrites on the joined IPA (a consonant is always a consonant).
//   diphthongShifts — applied to a whole VOWEL SEGMENT only, NOT as a string replace: a true diphthong (fatḥa +
//     ي/و + sukūn) is one atomic seg [aj]/[aw], but a fatḥa + a glide that ONSETS the next syllable (طَوِيل tˤawiːl,
//     three segs a·w·iː) concatenates to the same "aw" substring — a blanket replace would wrongly monophthongize
//     the hiatus (tˤoːiːl). Matching the seg's ph exactly restricts it to real diphthongs.
{
    "variety": "egyptian",
    "iso": "arz",
    // Egyptian definite article is [il-] (assimilating to sun letters: in-, iʃ-), NOT MSA [al-]: النهارده → in-nahaːrda,
    // القاهرة → il-qaːhira. Raised on the tagged article-vowel SEG (not a string replace — a word-initial [a] can't be
    // told from an article [a] once joined). The teacher/diacritizer writes the article alif bare, so this is a g2p
    // variety rule, not learnable from silver.
    "articleVowel": "i",
    "consonantShifts": [
        ["d͡ʒ", "ɡ"], // ج → [ɡ] (Cairene; the signature Egyptian consonant)
        ["q", "ʔ"], // ق → [ʔ] (urban glottal stop)
        ["θ", "t"], // ث → [t] (native; the learned/loan [s] is a lexical tail)
        ["ð", "d"] // ذ → [d]; also turns ظ [ðˤ]→[dˤ] (ð→d leaves the pharyngealization) — native default
    ],
    "diphthongShifts": {
        "aj": "eː", // بيت bajt → beːt (only the atomic diphthong seg, not aj-hiatus)
        "aw": "oː" // يوم jawm → joːm
    }
}
