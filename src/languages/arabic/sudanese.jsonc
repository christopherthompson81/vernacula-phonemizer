// Sudanese Arabic (apd — Khartoum/Sudanese) variety data. AUTHORED from the published phonology (Dickins, Sudanese
// Arabic Phonematics) — there is NO wikipron/kaikki apd referee, so this is gold-anchored (🔷 single-source), not
// referee-measured. The Sudanese fingerprint is the OPPOSITE of Egyptian/Levantine on two axes:
//   ق → [ɡ] (voiced velar — the Bedouin reflex, NOT urban [ʔ])   ج → [ɟ] (voiced PALATAL plosive — the signature)
// and it is CONSERVATIVE on the interdentals: ث ذ ظ are KEPT as [θ ð ðˤ] (Egyptian/Levantine merge them to stops),
// so there is no θ/ð shift here. Historical diphthongs are monophthongized (Khartoum ay→[eː], aw→[oː]).
{
    "variety": "sudanese",
    "iso": "apd",
    "consonantShifts": [
        ["q", "ɡ"], // ق → [ɡ] (voiced velar)
        ["d͡ʒ", "ɟ"] // ج → [ɟ] (voiced palatal plosive — the Sudanese signature). Interdentals ث ذ ظ are KEPT.
    ],
    "diphthongShifts": {
        "aj": "eː", // ay → [eː]
        "aw": "oː" // aw → [oː]
    }
}
