// Hijazi Arabic (acw — western Saudi Arabia, urban Mecca/Medina) variety data. Applied on the MSA g2p output, same
// shape as the other dialect files. Hijazi is a sedentary dialect with a DISTINCTIVE profile: ق→[ɡ] (the voiced
// reflex, أخلاق→ʔaxlaːɡ) but — UNLIKE Egyptian [ɡ] / Levantine [ʒ] — it RETAINS the affricate ⟨ج⟩=[d͡ʒ]
// (أبجورة→ʔabad͡ʒoːra), and keeps ⟨خ⟩=[x] (not the uvular [χ] of Gulf/Libyan). Urban Hijazi merges the interdentals
// to stops/sibilants: ث→[t], ذ→[d], ظ→[zˤ] (keeping ض=[dˤ] distinct). Historical diphthongs monophthongize (ay→eː,
// aw→oː). Interdental retention in learned words (أثاري→ʔaθaːri) is a lexical tail. Referee: wikipron acw_arab_broad
// (human). See docs/investigations/acw_hijazi_bringup_investigation.md.
{
    "variety": "hijazi",
    "iso": "acw",
    "consonantShifts": [
        ["q", "ɡ"],   // ق → [ɡ] (voiced reflex)
        ["θ", "t"],   // ث → [t] (learned words keep [θ]/[s] — lexical tail)
        ["ðˤ", "zˤ"], // ظ → [zˤ]; keep ض = [dˤ] distinct
        ["ð", "d"]    // ذ → [d]. ⟨ج⟩ stays [d͡ʒ] (affricate retained), ⟨خ⟩ stays [x].
    ],
    "diphthongShifts": {
        "aj": "eː", // بيت bajt → beːt
        "aw": "oː"  // يوم jawm → joːm
    }
}
