// Native canonical-IPA data manifest for Icelandic (is) — íslenska, the most archaic living North Germanic language
// (~330k), Latin script + ⟨þ ð æ ö⟩. espeak-independent. One of the DEEPEST orthographies in the fleet: no voicing
// contrast in stops (the contrast is ASPIRATION), so ⟨b d g⟩/⟨p t k⟩ neutralize to [p t k]; famous epenthetic-stop
// clusters ⟨ll⟩→[tl] ⟨rl⟩→[rtl] ⟨rn⟩→[rtn]; rich vowel values (á→au, ó→ou, æ→ai, au→øy). Aspiration + length are
// folded (run 1). Engine: icelandic.ts. See docs/investigations/is_native_bringup_investigation.md.
{
    "language": "is",
    "name": "Icelandic (íslenska)",
    "script": "Latin",

    // Multi-letter graphemes, scanned LONGEST-FIRST. Vowel digraphs ⟨au⟩→øy, ⟨ei ey⟩→ei; ⟨hv⟩→kv; the epenthetic-stop
    // sonorant clusters ⟨ll⟩→tl, ⟨rl⟩→rtl, ⟨rn⟩→rtn (⟨nn⟩ is context-dependent → handled in code).
    "digraphs": {
        "au": "øy", "ei": "ei", "ey": "ei",
        "hv": "kv", "hj": "ç", "hr": "r", "hl": "l", "hn": "n",
        "ll": "tl", "rl": "rtl", "rn": "rtn"
    },

    // Single grapheme → canonical IPA (aspiration folded, so ⟨p b⟩→p, ⟨t d⟩→t, ⟨k g⟩→k; g→ɣ/c is done in code).
    // Vowels: ⟨á⟩→au, ⟨é⟩→jɛ, ⟨í ý⟩→i, ⟨ó⟩→ou, ⟨u⟩→ʏ, ⟨ú⟩→u, ⟨ö⟩→œ, ⟨æ⟩→ai. ⟨þ⟩→θ, ⟨ð⟩→ð.
    "graphemes": {
        "a": "a", "á": "au", "e": "ɛ", "é": "jɛ", "i": "ɪ", "í": "i", "o": "ɔ", "ó": "ou",
        "u": "ʏ", "ú": "u", "y": "ɪ", "ý": "i", "ö": "œ", "æ": "ai",
        "b": "p", "d": "t", "g": "k", "p": "p", "t": "t", "k": "k",
        "f": "f", "s": "s", "h": "h", "j": "j", "l": "l", "m": "m", "n": "n", "r": "r", "v": "v",
        "þ": "θ", "ð": "ð", "x": "ks", "c": "k", "q": "k", "w": "v", "z": "s"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },
}
