// Native canonical-IPA data manifest for Icelandic (is) — íslenska, the most archaic living North Germanic language
// (~330k), Latin script + ⟨þ ð æ ö⟩. espeak-independent. One of the DEEPEST orthographies in the fleet: no voicing
// contrast in stops (the contrast is ASPIRATION), so ⟨b d g⟩/⟨p t k⟩ neutralize to [p t k]; famous epenthetic-stop
// clusters ⟨ll⟩→[tl] ⟨rl⟩→[rtl] ⟨rn⟩→[rtn]; rich vowel values (á→au, ó→ou, æ→ai, au→øy). Aspiration + length are
// folded (run 1). Engine: icelandic.ts. See docs/investigations/is_native_bringup_investigation.md.
{
    "language": "is",
    "name": "Icelandic (íslenska)",
    "script": "Latin",

    // Multi-letter graphemes, scanned LONGEST-FIRST. Vowel digraphs ⟨au⟩→øy, ⟨ei ey⟩→ei; ⟨hv⟩→kv; the epenthetic-stop
    // sonorant clusters ⟨ll⟩→tl, ⟨rl⟩→rtl, ⟨rn⟩→rtn (⟨nn⟩ is context-dependent → handled in code).
    "digraphs": {
        "au": "øy", "ei": "ei", "ey": "ei",
        "hv": "kv", "hj": "ç", "hr": "r", "hl": "l", "hn": "n",
        "ll": "tl", "rl": "rtl", "rn": "rtn"
    },

    // Single grapheme → canonical IPA (aspiration folded, so ⟨p b⟩→p, ⟨t d⟩→t, ⟨k g⟩→k; g→ɣ/c is done in code).
    // Vowels: ⟨á⟩→au, ⟨é⟩→jɛ, ⟨í ý⟩→i, ⟨ó⟩→ou, ⟨u⟩→ʏ, ⟨ú⟩→u, ⟨ö⟩→œ, ⟨æ⟩→ai. ⟨þ⟩→θ, ⟨ð⟩→ð.
    "graphemes": {
        "a": "a", "á": "au", "e": "ɛ", "é": "jɛ", "i": "ɪ", "í": "i", "o": "ɔ", "ó": "ou",
        "u": "ʏ", "ú": "u", "y": "ɪ", "ý": "i", "ö": "œ", "æ": "ai",
        "b": "p", "d": "t", "g": "k", "p": "p", "t": "t", "k": "k",
        "f": "f", "s": "s", "h": "h", "j": "j", "l": "l", "m": "m", "n": "n", "r": "r", "v": "v",
        "þ": "θ", "ð": "ð", "x": "ks", "c": "k", "q": "k", "w": "v", "z": "s"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // ── CARDINAL NUMBER WORDS ────────────────────────────────────────────────────────────────────────────────────
    // Source: Wiktionary "Appendix:Icelandic numerals" (the cardinal table, the gender paradigms for 1–4, and the
    // magnitude words hundrað / hundruð / þúsund / milljón / milljarður), cross-checked against
    // languagesandnumbers.com/how-to-count-in-icelandic. Icelandic is tens-FIRST and joins the final unit with "og":
    // tuttugu og einn = 21, fjörutíu og fimm = 45.
    //
    // GENDER. Icelandic 1–4 inflect (einn/ein/eitt, tveir/tvær/tvö, þrír/þrjár/þrjú, fjórir/fjórar/fjögur) and a
    // bare numeral has no noun to agree with. The citation form used for counting aloud is the MASCULINE (einn,
    // tveir, þrír, fjórir) — that is the `ones` table. The other two genders are needed anyway, because a
    // multiplier agrees with its MAGNITUDE NOUN: hundrað and þúsund are NEUTER (tvö hundruð, þrjú þúsund), milljón
    // is FEMININE (ein milljón, tvær milljónir) and milljarður is MASCULINE (einn milljarður). numbers.ts selects
    // the right column per position; only 1–4 have entries, everything from fimm up is invariant.
    "numbers": {
        "ones": [
            "núll", "einn", "tveir", "þrír", "fjórir", "fimm", "sex", "sjö", "átta", "níu",
            "tíu", "ellefu", "tólf", "þrettán", "fjórtán", "fimmtán", "sextán", "sautján", "átján", "nítján"
        ],
        "onesFeminine": ["", "ein", "tvær", "þrjár", "fjórar"],
        "onesNeuter": ["", "eitt", "tvö", "þrjú", "fjögur"],
        "tens": ["", "", "tuttugu", "þrjátíu", "fjörutíu", "fimmtíu", "sextíu", "sjötíu", "áttatíu", "níutíu"],
        "connector": "og",
        "hundred": { "one": "eitt hundrað", "plural": "hundruð" },
        "thousand": { "one": "eitt þúsund", "word": "þúsund" },
        "million": { "one": "ein milljón", "plural": "milljónir" },
        "billion": { "one": "einn milljarður", "plural": "milljarðar" }
    },
}
