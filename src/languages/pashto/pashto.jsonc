// Native canonical-IPA definition for Pashto / پښتو (ps) — first Eastern Iranian language, a Perso-Arabic ABJAD
// (extended: retroflex letters ټ ډ ړ ڼ ښ ږ, affricates څ ts / ځ dz, the velar ګ). pashto.ts reads this file.
// Pashto is a SHALLOWER abjad than Urdu/Arabic — it writes ā (ا), e (ې), o/u (و), i (ی) distinctly — but the SHORT
// vowels a/ə/i/u are still usually UNWRITTEN, so a default short vowel [ə] (the zwarakay) + medial-schwa deletion
// stand in for the deferred short-vowel restoration (, like Urdu/Persian). Dialect note: ښ/ږ are rendered as the
// SW/Kandahari retroflex ʂ/ʐ (NE dialects x/ɡ, Central ç/ʝ).
{
    "language": "ps",
    "name": "Pashto",
    "script": "Arabic (Perso-Arabic, extended)",
    "provenance": "Authored from the Unicode Arabic/Pashto chart + standard (Kandahari/literary) Pashto phonology. Validated against wikipron pus + kaikki pus (human).",

    // Consonant letters → canonical IPA. Dental t̪/d̪ (ت/ط, د), retroflex ʈ ɖ ɳ ɻ (ټ ډ ڼ ړ), retroflex sibilants
    // ʂ ʐ (ښ ږ, Kandahari), affricates t͡s d͡z (څ ځ), the Pashto velar ګ=ɡ.
    "consonants": {
        "ب": "b", "پ": "p", "ت": "t̪", "ټ": "ʈ", "ث": "s", "ج": "d͡ʒ", "ځ": "d͡z",
        "چ": "t͡ʃ", "څ": "t͡s", "ح": "h", "خ": "x", "د": "d̪", "ډ": "ɖ", "ذ": "z",
        "ر": "r", "ړ": "ɻ", "ز": "z", "ژ": "ʒ", "ږ": "ʐ", "س": "s", "ش": "ʃ",
        "ښ": "ʂ", "ص": "s", "ض": "z", "ط": "t̪", "ظ": "z", "ع": "ʔ", "غ": "ɣ",
        "ف": "f", "ق": "q", "ک": "k", "ك": "k", "ګ": "ɡ", "گ": "ɡ", "ل": "l",
        "م": "m", "ن": "n", "ڼ": "ɳ", "ء": "ʔ", "ھ": "h"
    },

    // Short-vowel diacritics (harakat) — usually ABSENT in running text (the restoration gap). Applied when present.
    "harakat": { "َ": "a", "ِ": "i", "ُ": "u", "ٰ": "ɑ", "ٗ": "u" },
    "sukun": "ْ",
    "shadda": "ّ",

    // The DEFAULT short vowel inserted between consonants when none is written — Pashto's zwarakay /ə/.
    "inherentVowel": "ə",

    "clausePunctuation": {
        "۔": ".", "؟": "?", "،": ",", "؛": ",",
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Pashto spellings; canonical IPA DERIVED by the same g2p.
    //
    // SOURCE: Omniglot "Pashto numbers and numerals" (omniglot.com/language/numbers/pashto.htm) — units, the
    // irregular teens, the round tens (شل / دېرش / څلوېښت …), سل, زر, میلیون; the same page supplies the whole
    // 21-29 ⟨ویشت⟩ series. Cross-checked against learn101.org/pashto_numbers.php, which also supplies the
    // 31-99 pattern (71 = یو اویا). میلیارد for 10⁹ is the form used throughout Pashto Wikipedia (ps.wikipedia.org,
    // e.g. "۹.۱ میلیارد ډالر"); بیلیون also occurs there in translated text but میلیارد is the dominant form.
    //
    // STRUCTURE (three separate patterns — this is NOT a uniform tens+unit system):
    //   • 11-19 are irregular fused forms (يوولس, دیارلس, شپاړس, نولس …) → an authored `teens` table.
    //   • 21-29 use the BOUND form ⟨ویشت⟩ of twenty, not ⟨شل⟩ (21 یوویشت, 25 پنځه ویشت) → an authored `compound` map.
    //     Omniglot writes 25/27/28 with a hamza (پنځهٔ ویشت); the plain-⟨ه⟩ spelling is used here because the
    //     hamza form mis-syllabifies in the abjad g2p (پنځهٔ → pənˈəd͡zh) — the pronunciation is identical.
    //   • 31-99 are UNITS-FIRST with no connector (یو دېرش "one-thirty", یو اویا "one-seventy").
    // ⟨و⟩ (and) joins only the hundred/thousand/million groups to their remainder.
    "numbers": {
        "units": ["صفر", "یو", "دوه", "درې", "څلور", "پنځه", "شپږ", "اووه", "اته", "نهه"],
        "ten": "لس",
        "teens": ["لس", "يوولس", "دولس", "دیارلس", "څوارلس", "پنځه لس", "شپاړس", "اووه لس", "اته لس", "نولس"],
        "tens": { "20": "شل", "30": "دېرش", "40": "څلوېښت", "50": "پنځوس", "60": "شپېته", "70": "اویا", "80": "اتیا", "90": "نوی" },
        "compound": {
            "21": "یوویشت", "22": "دوه ویشت", "23": "در ویشت", "24": "څلېر ویشت", "25": "پنځه ویشت",
            "26": "شپږ ویشت", "27": "اووه ویشت", "28": "اته ویشت", "29": "نهه ویشت"
        },
        "hundred": "سل", "thousand": "زر", "million": "میلیون", "billion": "میلیارد", "and": "و"
    }
}
