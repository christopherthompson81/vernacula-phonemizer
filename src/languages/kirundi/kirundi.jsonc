// Native canonical-IPA data manifest for Kirundi / Ikirundi (rn) — Bantu (JD62, Rwanda-Rundi), the Latin
// orthography, espeak-independent. The principal language of Burundi (~11M incl. L2). Kirundi is a NEAR-CLONE of
// Kinyarwanda (rw) — mutually intelligible; the Cox "Kirundi & Kinyarwanda Comparative Grammar" describes both.
// This module reuses the rw greedy longest-match g2p + the Cox palatal series verbatim, with ONE confident delta:
//   • ⟨j⟩ → d͡ʒ (the Kirundi voiced palatal AFFRICATE — the textbook difference from Kinyarwanda's fricative ⟨j⟩→ʒ).
// The referee (epitran run-Latn) additionally applies a blanket NC-SPIRANTISATION (mp→mh, nt→nh, nk→ŋx) and drops
// vowel length + ⟨ng⟩→ŋ; we do NOT follow those — the spirantisation is unverified by any independent source
// (Wikipedia is silent, Cox isn't on hand) and [mp]→[mh] looks over-applied, while length + ⟨ng⟩→ŋ are grounded
// (Wikipedia confirms phonemic length; Cox gives ⟨ng⟩→ŋ). So epitran run is CRUDE and partly circular → this is a
// weaker verification than rw. Tone (H/L) unwritten → DEFERRED. See docs/investigations/rn_native_bringup_investigation.md.
{
    "language": "rn",
    "name": "Kirundi (Ikirundi)",
    "script": "Latin",
    "provenance": "NEAR-CLONE of Kinyarwanda (rw): reuses the rw greedy g2p + Cox comparative-grammar palatals, with the one confident Kirundi delta ⟨j⟩→d͡ʒ (affricate, vs Kinyarwanda ʒ). Referee: epitran run-Latn (crude, partly circular).",

    "convention": {
        "palatals": "PALATALIZATION analysis (Cox K&KCG grammar, Table 25): ⟨Cy⟩ → Cʲ — ⟨cy⟩→kʲ (palatalized /k/), ⟨jy⟩→ɡʲ, ⟨shy⟩→ʃʲ, ⟨by⟩→bʲ, ⟨ry⟩→ɾʲ, ⟨my⟩→mʲ, ⟨py⟩→pʲ. ⟨ny⟩→ɲ is the PHONEMIC palatal nasal (kept). (Wikipedia's palatal-segment analysis c/ɟ/ç/bɟ was single-source and less supported; the grammar + epitran both back palatalization.)",
        "affricates": "⟨c⟩→t͡ʃ, ⟨j⟩→ʒ, ⟨sh⟩→ʃ",
        "nasals": "⟨ng⟩→ŋ (plain velar nasal, NOT ŋɡ); other ⟨mb nd nz nt nk mp⟩ stay nasal+C",
        "other": "⟨r⟩→ɾ (tap), double vowels → long (aa→aː); ⟨Cw⟩ labialisation = C+w",
        "tone": "H/L tone is unwritten → DEFERRED; written vowel length IS emitted"
    },

    // Orthography → canonical IPA. The scanner sorts keys by LENGTH DESC, so the trigraph ⟨shy⟩ wins over digraphs
    // (cy, sh, ng) over singles. The ⟨Cy⟩ palatalised consonants are listed explicitly (→ Cʲ, the Cox-grammar
    // analysis). ⟨tw kw bw gw rw⟩ velarised consonants need no entries — ⟨w⟩→w falls out of the greedy scan as C+w.
    "graphemes": {
        "shy": "ʃʲ",
        "cy": "kʲ", "jy": "ɡʲ", "by": "bʲ", "ry": "ɾʲ", "my": "mʲ", "py": "pʲ",
        "vy": "vʲ", "hy": "hʲ", "ky": "kʲ", "gy": "ɡʲ", "ty": "tʲ", "dy": "dʲ", "fy": "fʲ", "ly": "lʲ", "sy": "sʲ", "zy": "zʲ",
        "ny": "ɲ", "sh": "ʃ",
        "ng": "ŋ",
        "aa": "aː", "ee": "eː", "ii": "iː", "oo": "oː", "uu": "uː",

        "b": "b", "c": "t͡ʃ", "d": "d", "f": "f", "g": "ɡ", "h": "h", "j": "d͡ʒ", "k": "k", "l": "l",
        "m": "m", "n": "n", "p": "p", "r": "ɾ", "s": "s", "t": "t", "v": "v", "w": "w", "y": "j", "z": "z",

        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ","
    },

    // Cardinal number words (Kinyarwanda). Units 1–10; the compositor (numbers.ts) uses the simplified counting
    // form (makumi abiri = 20, ijana = 100, igihumbi = 1000) — the full noun-class concord is contextual (deferred).
    "numbers": {
        "units": ["zeru", "rimwe", "kabiri", "gatatu", "kane", "gatanu", "gatandatu", "karindwi", "umunani", "icyenda"],
        "ten": "icumi",
        "tens": "makumi",
        "hundred": "ijana",
        "thousand": "igihumbi",
        "and": "na"
    }
}
