// Native canonical-IPA data manifest for Irish Gaelic (ga) — Standard/Connacht-leaning.
// THE novel axis: every consonant is BROAD (velarized ˠ, next to a/o/u) or SLENDER (palatalized ʲ, next to
// e/i) — "caol le caol". The g2p determines each consonant's quality from the flanking vowel LETTERS and emits
// the matching form; the vowel clusters are a separate longest-match lookup (the pronounced vowel, semi-lexical).
// ALGORITHMS in g2p.ts (scan + quality) / irish.ts (stress + assembly).
{
    "language": "ga",
    "name": "Irish Gaelic (Standard/Connacht)",
    "script": "Latin",
    "provenance": "Authored from Irish orthography + the broad/slender system (Ó Siadhail), Connacht-leaning. Rule engine; the wikipron gle referee is a 3-dialect, vowel-noisy cross-check (~34% ceiling), not a tight guard.",

    // Slender-marking vowel LETTERS (e, i + fadas) vs broad-marking (a, o, u + fadas). A consonant is slender
    // when its determining adjacent vowel is slender.
    "slenderVowels": "eiéí",
    "broadVowels": "aouáóú",

    // Consonant → IPA, by quality. Digraphs (lenition) resolved before this.
    "broad": {
        "b": "bˠ", "c": "k", "d": "d̪ˠ", "f": "fˠ", "g": "ɡ", "h": "h", "l": "l̪ˠ", "m": "mˠ",
        "n": "n̪ˠ", "p": "pˠ", "r": "ɾˠ", "s": "sˠ", "t": "t̪ˠ", "v": "vˠ", "z": "zˠ",
    },
    "slender": {
        "b": "bʲ", "c": "c", "d": "dʲ", "f": "fʲ", "g": "ɟ", "h": "h", "l": "lʲ", "m": "mʲ",
        "n": "nʲ", "p": "pʲ", "r": "ɾʲ", "s": "ʃ", "t": "tʲ", "v": "vʲ", "z": "ʒ",
    },
    // Lenited digraphs (séimhiú): [broad, slender]. "" = silent. bh/mh add a glide handled in code.
    "lenition": {
        "bh": ["w", "vʲ"], "mh": ["w", "vʲ"], "ch": ["x", "ç"], "dh": ["ɣ", "j"], "gh": ["ɣ", "j"],
        "fh": ["", ""], "ph": ["fˠ", "fʲ"], "sh": ["h", "h"], "th": ["h", "h"],
    },

    // Vowel-cluster → IPA, matched LONGEST-first. The consonant quality is set separately (by the adjacent vowel
    // letter), so these are just the pronounced nucleus. Semi-lexical / dialect-variable (the Run-2+ residual).
    "vowels": {
        "aoi": "iː", "eoi": "oː", "uai": "uə", "iai": "iə", "aío": "iː",
        "ái": "ɑː", "aí": "iː", "ao": "eː", "ae": "eː", "eá": "ɑː", "éa": "eː", "eo": "oː", "eó": "oː", "éi": "eː",
        "ia": "iə", "ío": "iː", "iú": "uː", "iu": "ʊ", "ói": "oː", "oí": "iː", "ai": "a", "ea": "a",
        "ei": "ɛ", "io": "ɪ", "oi": "ɔ", "ua": "uə", "ui": "ɪ", "uí": "iː", "úi": "uː",
        "á": "ɑː", "é": "eː", "í": "iː", "ó": "oː", "ú": "uː",
        "a": "a", "e": "ɛ", "i": "ɪ", "o": "ɔ", "u": "ʊ",
    },

    "clausePunctuation": { ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": "," },

    // Cardinal number words (0–10 + tens; the counting system is complex — Phase 2).
    // Irish numerals. Two series are needed because Irish distinguishes the COUNTING form (used standalone and
    // after the particle "a": a haon, a dó, a ceathair) from the ATTRIBUTIVE form used before a counted noun
    // (aon, dhá, ceithre) — cf. ceathair vs ceithre, both attested in the wikipron referee. Magnitude words are
    // counted attributively (dhá chéad, not *a dó chéad), which is why both lists exist.
    "numbers": {
        "ones": ["náid", "aon", "dó", "trí", "ceathair", "cúig", "sé", "seacht", "ocht", "naoi", "deich"],
        "attributive": ["", "aon", "dhá", "trí", "ceithre", "cúig", "sé", "seacht", "ocht", "naoi", "deich"],
        // Round tens. Decimal (an córas nua) rather than the traditional VIGESIMAL system (dhá fhichead etc.):
        // the decimal series is what modern written Irish and school usage employ for bare figures.
        "tens": {
            "20": "fiche", "30": "tríocha", "40": "daichead", "50": "caoga",
            "60": "seasca", "70": "seachtó", "80": "ochtó", "90": "nócha",
        },
        "teenWord": "déag",
        "magnitudes": { "hundred": "céad", "thousand": "míle", "million": "milliún", "billion": "billiún" },
    },
}
