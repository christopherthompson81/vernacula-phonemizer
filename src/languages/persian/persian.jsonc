// Native canonical-IPA definition for Persian / Farsi (fa) — the Perso-Arabic ABJAD. Like Urdu, LONG vowels are
// written (ا/آ→aː, و→uː, ی→iː) but SHORT vowels (a e o) are usually OMITTED and must be restored — the deferred
// subsystem (🟠). Persian phonology (NOT Hindi): no retroflexes, no aspirates; â=[aː], and the four Persian
// letters پ چ ژ گ. persian.ts (g2p) reads this file. Stored in logical order = phonetic order (RTL is a non-issue).
{
    "language": "fa",
    "name": "Persian",
    "script": "Arabic (Perso-Arabic)",
    "provenance": "Authored from the Unicode Arabic/Persian chart + standard Iranian Persian phonology. This file IS the language data — the g2p reads it directly.",

    // Unambiguous consonant letters → canonical IPA.
    "consonants": {
        "ب": "b", "پ": "p", "ت": "t", "ث": "s", "ج": "d͡ʒ", "چ": "t͡ʃ",
        "ح": "h", "خ": "x", "د": "d", "ذ": "z", "ر": "ɾ", "ز": "z",
        "ژ": "ʒ", "س": "s", "ش": "ʃ", "ص": "s", "ض": "z", "ط": "t",
        "ظ": "z", "ع": "ʔ", "غ": "ɣ", "ف": "f", "ق": "q", "ک": "k",
        "ك": "k", "گ": "ɡ", "ل": "l", "م": "m", "ن": "n", "ه": "h",
        "ی": "j", "ي": "j", "و": "v", "ء": "ʔ"
    },

    // Harakat (short-vowel diacritics) — usually ABSENT in running text (the restoration gap). Applied when present.
    "harakat": {
        "َ": "a",  // zabar / fatha → a
        "ِ": "e",  // zer / kasra → e
        "ُ": "o",  // pesh / damma → o
        "ٰ": "aː", // superscript alef → aː
        "ً": "an", "ٌ": "on", "ٍ": "en"
    },
    "sukun": "ْ",   // jazm/sukun → no vowel
    "shadda": "ّ",  // tashdid → gemination (→ length)

    // The DEFAULT short vowel inserted between consonants when none is written (the abjad's missing vowel).
    // Persian's most frequent short vowel is /a/ (zabar); /e//o/ are lexical. The stand-in for the deferred layer.
    "inherentVowel": "a",

    // Danda / ASCII → canonical inline pause marks.
    "clausePunctuation": {
        "۔": ".", "؟": "?", "،": ",", "؛": ",",
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    },

    // NUMBERS — Persian spellings; canonical IPA DERIVED by the same g2p (with harakat so short vowels are right).
    // Composed by persian/numbers.ts (the DECIMAL IRANIAN system), NOT by the default Indic lakh/crore composer:
    // Persian's hundreds are irregular fused words and every group is linked by the enclitic ⟨و⟩ /o/. The previous
    // table faked "lakh": "صَد هِزار" / "crore": "دَه میلیون" to bend the Indic scale into shape, which read
    // 1,000,000 as "ده صد هزار" and glued the two-word fake into one [sadahzˈaːɾ]; both fakes are gone.
    "numbers": {
        "units": ["صِفر", "یِک", "دو", "سِه", "چَهار", "پَنج", "شِش", "هَفت", "هَشت", "نُه"],
        // پانْزْدَه / شانْزْدَه carry an explicit SUKUN. Without it the g2p inserts its default [a] into BOTH empty
        // slots and the shared Ohala deletion can only take one of the two back (deleting both would leave a
        // 3-consonant cluster, which the rule declines), so they read [paːnazdah] / [ʃaːnazdah]. The sukun states
        // the fact directly — there is no vowel there — instead of relying on a heuristic to remove one.
        "teens": ["دَه", "یازدَه", "دَوازدَه", "سیزدَه", "چَهاردَه", "پانْزْدَه", "شانْزْدَه", "هِفدَه", "هِجدَه", "نوزدَه"],
        "tens": { "20": "بیست", "30": "سی", "40": "چِهِل", "50": "پَنجاه", "60": "شَصت", "70": "هَفتاد", "80": "هَشتاد", "90": "نَوَد" },
        // The IRREGULAR round hundreds — single fused words, not multiplier + صد (index 0 unused; index 1 = صد).
        // سیصد and پانصد are independently attested as single headwords in the mined lexicon.tsv.
        // هَفْتْصَد / هَشْتْصَد take the same sukun treatment as پانْزْدَه above, for the same reason (ft-s / ʃt-s).
        "hundreds": ["", "صَد", "دِویست", "سیصَد", "چَهارصَد", "پانصَد", "شِشصَد", "هَفْتْصَد", "هَشْتْصَد", "نُهصَد"],
        "magnitudes": { "hundred": "صَد", "thousand": "هِزار", "million": "میلیون", "billion": "میلیارد" },
        // The linking enclitic ⟨و⟩ /o/ (bist-o-yek), given as IPA rather than orthography: this g2p reads a bare
        // ⟨و⟩ as the LONG [uː] (the isV branch), so a spelled ⟨بیستو⟩ would be [biːstuː] and a standalone ⟨و⟩
        // token [ˈuː]. numbers.ts appends this segment after the preceding word has been phonemized.
        "connectiveIpa": "o",
        // The decimal separator, read as a word (چهارده ممیز هفت). Emitted as PLAIN orthography by normalize.ts so
        // the neural vowel restorer can vocalize it like any other word; the sync g2p gives the abjad default.
        "decimalWord": "ممیز"
    }
}
