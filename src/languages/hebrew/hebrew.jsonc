// Native canonical-IPA data manifest for Hebrew (he) — Afro-Asiatic (Semitic), the Hebrew abjad, MODERN ISRAELI
// pronunciation, espeak-independent. PHASE 1: a niqqud→IPA segmental g2p over VOCALIZED (pointed) Hebrew — the
// deterministic core. Unvocalized restoration (a sentence-level neural nakdan) is PHASE 2 (done, hebrewNeural.ts);
// the `numbers` block feeds the cardinal compositor (numbers.ts). Referee: en.wiktionary vocalized-form →
// Modern-Israeli IPA (a=IL). The scan logic (dagesh/bgdkpt, shin/sin, vav specials, sheva, patach-genuvah) is in
// hebrew.ts. See docs/investigations/he_native_bringup_investigation.md.
{
    "language": "he",
    "name": "Hebrew",
    "script": "Hebrew",
    "provenance": "Authored niqqud→IPA g2p for MODERN ISRAELI Hebrew from the pointed orthography. Referee: en.wiktionary vocalized-form → a=IL Modern-Israeli IPA.",

    "convention": {
        "consonants": "Modern Israeli values; the bgdkpt ⟨בכפ⟩ take a DAGESH-hard b/k/p vs soft v/χ/f (גדת lost the split → always ɡ/d/t)",
        "gutturals": "⟨א⟩,⟨ע⟩ = optional glottal ʔ (Modern Hebrew often ∅ — folded); ⟨ה⟩ = h (silent word-final / mater)",
        "specials": "⟨ו⟩ = v (consonant) / u (shuruk וּ) / o (holam male וֹ); ⟨ש⟩ = ʃ (shin-dot ׁ) / s (sin-dot ׂ); ⟨צ⟩ = t͡s; ⟨ק⟩,⟨כּ⟩ = k; ⟨ר⟩ = ʁ; ⟨ח⟩,⟨כ⟩ = χ",
        "vowels": "patach/kamatz ַ ָ = a, tsere/segol ֵ ֶ = e, hiriq ִ = i, holam ֹ = o, kubutz/shuruk ֻ וּ = u; chataf ֱ ֲ ֳ = e a o; SHEVA ְ = ∅, except word-initial under a proclitic prefix וְ/לְ/בְּ/כְּ/מְ (sheva-na) = e",
        "stress": "phonemic but UNWRITTEN → not emitted; the referee marks it (ˈ) → folded"
    },

    // Base (SOFT / default) consonant → IPA. Finals ⟨ךםןףץ⟩ = their base soft value. The dagesh-hard overrides
    // (בכפ → b k p) and the shin/sin split live in code (hebrew.ts).
    "consonants": {
        "א": "ʔ", "ב": "v", "ג": "ɡ", "ד": "d", "ה": "h", "ו": "v", "ז": "z", "ח": "χ", "ט": "t",
        "י": "j", "כ": "χ", "ך": "χ", "ל": "l", "מ": "m", "ם": "m", "נ": "n", "ן": "n", "ס": "s",
        "ע": "ʔ", "פ": "f", "ף": "f", "צ": "t͡s", "ץ": "t͡s", "ק": "k", "ר": "ʁ", "ש": "ʃ", "ת": "t"
    },
    // Dagesh (ּ U+05BC) HARDENS only these three in Modern Hebrew (bgdkpt residue); the rest take a dagesh with no
    // pronunciation change (gemination is not realised in Modern Hebrew).
    "dageshHard": { "ב": "b", "כ": "k", "ך": "k", "פ": "p", "ף": "p" },

    // Niqqud (vowel points) → IPA. Sheva (ְ) is context-dependent → handled in code (default ∅).
    "vowels": {
        "ַ": "a", "ָ": "a", "ֵ": "e", "ֶ": "e", "ִ": "i", "ֹ": "o", "ֺ": "o", "ֻ": "u",
        "ֱ": "e", "ֲ": "a", "ֳ": "o", "ׇ": "o"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",", "׃": "."
    },

    // Cardinal number words, authored WITH NIQQUD so the Phase-1 g2p (phonemizeWord) renders them — the deterministic
    // path, consistent with the rest of Hebrew's canonical IPA (numbers.ts composes; hebrew.ts routes digit tokens).
    // Bare numbers read in the FEMININE citation forms (the abstract counting register). Gender/construct specifics:
    // מֵאָה hundred is feminine (3-9×100 use the reduced fem `teensOnes` + מֵאוֹת); אֶלֶף/מִילְיוֹן are masculine
    // (2× = dual אַלְפַּיִם / construct שְׁנֵי; 3-10× thousand use the construct `thousandsConstruct` + אֲלָפִים;
    // 3-10× million use masculine `unitsM`). 200/2000 are the duals מָאתַיִם/אַלְפַּיִם. The vav-conjunction is the
    // plain וְ prefix on the last term (the u-/va- morphophonology before labials/sheva is not modelled — a documented
    // simplification; our sheva-na also elides, so וְ surfaces as [v]). Beyond 10¹²-1 or unsafe → digit-by-digit.
    "numbers": {
        "point": "נְקֻדָּה",
        "and": "וְ",
        "unitsF": ["אֶפֶס", "אַחַת", "שְׁתַּיִם", "שָׁלוֹשׁ", "אַרְבַּע", "חָמֵשׁ", "שֵׁשׁ", "שֶׁבַע", "שְׁמוֹנֶה", "תֵּשַׁע"],
        "unitsM": ["אֶפֶס", "אֶחָד", "שְׁנַיִם", "שְׁלוֹשָׁה", "אַרְבָּעָה", "חֲמִשָּׁה", "שִׁשָּׁה", "שִׁבְעָה", "שְׁמוֹנָה", "תִּשְׁעָה"],
        "teensOnes": ["", "אַחַת", "שְׁתֵּים", "שְׁלוֹשׁ", "אַרְבַּע", "חֲמֵשׁ", "שֵׁשׁ", "שְׁבַע", "שְׁמוֹנֶה", "תְּשַׁע"],
        "ten": "עֶשֶׂר",
        "teenSuffix": "עֶשְׂרֵה",
        "tens": ["", "", "עֶשְׂרִים", "שְׁלוֹשִׁים", "אַרְבָּעִים", "חֲמִשִּׁים", "שִׁשִּׁים", "שִׁבְעִים", "שְׁמוֹנִים", "תִּשְׁעִים"],
        "hundred": "מֵאָה",
        "twoHundred": "מָאתַיִם",
        "hundredsPlural": "מֵאוֹת",
        "thousand": "אֶלֶף",
        "twoConstruct": "שְׁנֵי",
        "twoThousand": "אַלְפַּיִם",
        "thousandsPlural": "אֲלָפִים",
        "thousandsConstruct": ["", "", "", "שְׁלוֹשֶׁת", "אַרְבַּעַת", "חֲמֵשֶׁת", "שֵׁשֶׁת", "שִׁבְעַת", "שְׁמוֹנַת", "תִּשְׁעַת", "עֲשֶׂרֶת"],
        "million": "מִילְיוֹן",
        "milliard": "מִילְיַארְד"
    }
}
