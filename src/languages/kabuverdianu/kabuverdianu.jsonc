// Native canonical-IPA data manifest for Kabuverdianu (kea) — kriolu, a Portuguese-lexified creole of Cape Verde
// (~870k). Written in the ALUPEC/AK unified orthography (a standardized PHONEMIC alphabet), so
// the engine (kabuverdianu.ts) is a greedy grapheme scan (digraphs first) + Portuguese-creole NASALIZATION + stress
// (accent-or-penult). Targets the SANTIAGO (Sotavento/Badiu) variety (what the anchor pronunciations attest). No
// machine referee exists → authored from ALUPEC + the 7 kaikki IPA words (test/kabuverdianu.test.ts). Format: plain
// JSONC.
{
    "language": "kea",
    "name": "Kabuverdianu (kriolu)",
    "script": ["Latin"],

    // Digraphs (matched before single letters): ⟨dj tx nh lh⟩ + ⟨rr⟩ trill + ⟨ch⟩ (Portuguese-spelling loans).
    "digraphs": { "dj": "d͡ʒ", "tx": "t͡ʃ", "nh": "ɲ", "lh": "ʎ", "rr": "r", "ch": "t͡ʃ" },

    // Single grapheme → canonical IPA. The acute marks the OPEN mid quality (é→ɛ, ó→ɔ) + stress; ⟨h⟩ is silent ("");
    // ⟨s⟩ is always [s] (ALUPEC writes ⟨z⟩ for [z]); ⟨r⟩ is the tap [ɾ]. Non-ALUPEC loan letters (c q w y) nativized.
    "graphemes": {
        "a": "ɐ", "á": "ɐ", "à": "ɐ", "â": "ɐ",
        "e": "e", "é": "ɛ", "è": "ɛ", "ê": "e",
        "i": "i", "í": "i", "î": "i",
        "o": "o", "ó": "ɔ", "ò": "ɔ", "ô": "o",
        "u": "u", "ú": "u", "û": "u",
        "b": "b", "c": "k", "d": "d", "f": "f", "g": "ɡ", "h": "", "j": "ʒ", "k": "k",
        "l": "l", "m": "m", "n": "n", "p": "p", "q": "k", "r": "ɾ", "s": "s", "t": "t",
        "v": "v", "w": "v", "x": "ʃ", "y": "i", "z": "z",
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // CARDINAL NUMBER WORDS (Santiago / Badiu, ALUPEC). Composition logic in numbers.ts.
    // SOURCE: en.wiktionary.org Category:Kabuverdianu_cardinal_numbers — the attested ALUPEC lemmas ⟨zéru, un,
    // dos, tres, kuátu, sinku, sais, seti, oitu, novi, dés, onzi, treizi, vinti, trinta, korenta, sinkuenta,
    // sasenta, setenta, oitenta, noventa, sen, mil, milion⟩ plus the hundreds ⟨duzentus, trezentus, kuátusentus,
    // kinhentus⟩ (⟨duzentus⟩ is explicitly tagged "Badiú or Santiago", the variety this engine targets).
    // Cross-checked against omniglot.com/language/numbers/kriol.htm and
    // languagesandnumbers.com/how-to-count-in-cape-verdean-creole (both of which print the accented
    // Barlavento-flavoured spellings ⟨sunkuénta, sasénta, saténta⟩ — NOT used here; ALUPEC Santiago forms win).
    // 12/14/15 and 16–19 are the de-accented ALUPEC readings of the Omniglot forms (duzi, katorzi, kinzi;
    // the analytic ⟨diza-⟩ series dizasais … dizanovi). 600–900 are extrapolated on the attested
    // ⟨unit + -sentus⟩ pattern of ⟨kuátusentus⟩ — see the note in numbers.ts.
    "numbers": {
        "ones": ["zéru", "un", "dos", "tres", "kuátu", "sinku", "sais", "seti", "oitu", "novi"],
        "teens": ["dés", "onzi", "duzi", "treizi", "katorzi", "kinzi", "dizasais", "dizaseti", "dizaoitu",
            "dizanovi"],
        "tens": ["", "", "vinti", "trinta", "korenta", "sinkuenta", "sasenta", "setenta", "oitenta", "noventa"],
        "hundreds": ["", "sen", "duzentus", "trezentus", "kuátusentus", "kinhentus", "saisentus", "setisentus",
            "oitusentus", "novisentus"],
        "thousand": "mil",
        "million": { "one": "un milion", "word": "milion" },
    },
}
