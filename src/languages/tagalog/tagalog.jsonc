// Native canonical-IPA definition for Tagalog / Filipino (tl) — a shallow, near-phonemic Latin orthography.
// tagalog.ts reads this file: digraphs first (ng→ŋ, ch→t͡ʃ, ny/ñ→ɲ, sy→ʃ), then single letters, with a
// WORD-INITIAL glottal stop [ʔ] before a vowel and a hyphen → [ʔ] (pag-asa→paɡʔasa). Native words keep the
// 5-vowel a e i o u. Special words (mga→maŋa, ng→naŋ) and penultimate stress live in the g2p.
{
    "language": "tl",
    "name": "Tagalog",
    "script": "Latin",
    "provenance": "Authored from standard Filipino/Tagalog orthography + phonology. This file IS the language data — the g2p reads it directly.",

    // Multi-letter graphemes (longest-first).
    "digraphs": {
        "ng": "ŋ", "ch": "t͡ʃ", "ny": "ɲ", "sy": "ʃ", "ll": "lj", "ts": "t͡s",
        // Spanish-loan geminate ⟨rr⟩ → single tap (Tagalog has no geminate rhotic): aparri→apaɾi.
        "rr": "ɾ"
    },

    // Single consonant letters → IPA (native + nativized Spanish/English loans). ⟨z⟩→[s]: Tagalog has no native
    // [z], so every ⟨z⟩ is a loan realized [s] (almarez→almaɾes).
    "consonants": {
        "p": "p", "t": "t", "k": "k", "b": "b", "d": "d", "g": "ɡ",
        "m": "m", "n": "n", "s": "s", "h": "h", "l": "l", "r": "ɾ",
        "w": "w", "y": "j", "ñ": "ɲ",
        "c": "k", "q": "k", "z": "s", "f": "f", "v": "v", "j": "d͡ʒ", "x": "ks"
    },

    // Vowels → IPA (modern 5-vowel system; native i~e and u~o merger is a lexical residual).
    "vowels": { "a": "a", "e": "e", "i": "i", "o": "o", "u": "u" },

    // Whole-word irregulars, given as an orthographic RESPELLING the g2p scans: the plural marker ⟨mga⟩ →
    // ⟨manga⟩ = [maˈŋa], the linker/particle ⟨ng⟩ → ⟨nang⟩ = [naŋ].
    "specialWords": { "mga": "manga", "ng": "nang" },

    "clausePunctuation": {
        ".": " . ", "?": " ? ", "!": " ! ", ",": " , ", ";": " ; ", ":": " : "
    },

    // NUMBERS — native Tagalog (not Spanish) spellings; canonical IPA DERIVED by running them through the same g2p.
    // The teens (labing- + unit, irregular ng→n/m sandhi) and tens (o→u raising: tatlo→tatlu; na/ng split) are
    // IRREGULAR, so they are explicit tables rather than composed. The productive multiplier ligature -ng/" na" and
    // the daan→raan / at→'t sandhi are handled in numberWords(). See docs/tl_native_bringup_investigation.md.
    "numbers": {
        "units": ["sero", "isa", "dalawa", "tatlo", "apat", "lima", "anim", "pito", "walo", "siyam"],
        "teens": ["sampu", "labing-isa", "labindalawa", "labintatlo", "labing-apat", "labinlima", "labing-anim", "labimpito", "labingwalo", "labinsiyam"],
        "tens": ["", "sampu", "dalawampu", "tatlumpu", "apatnapu", "limampu", "animnapu", "pitumpu", "walumpu", "siyamnapu"],
        "hundred": "daan", "hundredAfterNa": "raan", "hundred1": "sandaan",
        "thousand": "libo", "thousand1": "sanlibo", "million": "milyon", "and": "at",
        // Number-sense stress (kaikki-mined): number words are FINAL-stressed EXCEPT these penult roots (séro, ápat,
        // ánim, líbo, sanlíbo, labíng-ápat, labíng-ánim). The -ng/'t/na ligatures add no vowel, so they don't move
        // stress. This overrides the general stress lexicon for the number path (which abstains on the number-sense
        // homographs isá/lima, pitó/píto 'bird', daán/libo). See docs/tl_native_bringup_investigation.md.
        "stressPenult": ["sero", "apat", "anim", "libo", "sanlibo", "labing-apat", "labing-anim"]
    }
}
