  // NUMBER WORDS — canonical IPA for the digit-input fragments, so 42 reads exactly like typed "forty two"
  // (12 → twˈɛɫv, with dark-l/aspiration). CMUdict-sourced + an authored high-magnitude supplement
  // (quadrillion…nonillion, on the regular -illion pattern). units[0-9], teens[10-19], tens by value,
  // magnitudes[0]=thousand…[9]=nonillion (hundred is separate). Canonical render only; espeak mode keeps
  // fragments.jsonl. The loader maps these to the pipeline's fragment keys (5→_5, 20→_2X, hundred→_0C,
  // thousand→_0M1, and→_0and, point→_dpt). See src/Phonemize/render.ts (applyPronunciationOverride,
  // fromNumber branch). ORDINALS (1st → "first") route through the flat lexicon as whole words — already
  // native, nothing needed here.
  "numbers": {
    "units":      ["zˈɪɹoᶷ", "wˈʌn", "tʰˈuː", "θɹˈiː", "fˈɔːɹ", "fˈaᶦv", "sˈɪks", "sˈɛvən", "ˈeᶦt", "nˈaᶦn"],
    "teens":      ["tʰˈɛn", "ɪlˈɛvən", "twˈɛɫv", "θˈɝtʰˈiːn", "fˈɔːɹtˈiːn", "fɪftˈiːn", "sɪkstˈiːn", "sˈɛvəntˈiːn", "eᶦtʰˈiːn", "nˈaᶦntˈiːn"],
    "tens":       { "20": "twˈɛnti", "30": "θˈɝd̬iː", "40": "fˈɔːɹt̬i", "50": "fˈɪfti", "60": "sˈɪksti", "70": "sˈɛvənti", "80": "ˈeᶦt̬i", "90": "nˈaᶦnti" },
    "hundred":    "hˈʌndɹəd",
    "magnitudes": ["θˈaᶷzənd", "mˈɪɫjən", "bˈɪɫjən", "tɹˈɪɫjən", "kwɑːdɹˈɪɫjən", "kwɪntˈɪɫjən", "sɛkstˈɪɫjən", "sɛptˈɪɫjən", "ɑːktˈɪɫjən", "nɑːnˈɪɫjən"],
    "and":        "ənd",
    "point":      "pɔᶦnt"
  },

  // REFERENCED statistical models — the part Hindi has no equivalent of. NOT inlined (megabytes of
  // lexical/statistical data, not authorable facts); listed here so the manifest documents the whole path.
  "models": {
    "lexicon":  { "file": "accent-lexicon.tsv", "words": 124928, "note": "CMUdict → canonical IPA; the flat per-word override (the 'grapheme→IPA table' an irregular language can only express as a word list)." },
    "oovG2p":   { "model": "g2p-model.json", "dict": "g2p-dict.tsv", "common": "g2p-common.txt", "note": "cleanroom joint n-gram — the rule engine Hindi doesn't need (English spelling isn't rule-derivable)." },
    "posModel": { "file": "pos-model.json", "note": "averaged perceptron (UD-EWT); drives heteronym selection. Hindi has no homographs to disambiguate." }
  },

  // Resolution order in applyPronunciationOverride (canonical mode). espeak base surfaces only in espeak mode.
  "resolve": ["number-fragment", "heteronym (POS-gated)", "possessive 's", "flat lexicon", "OOV G2P"],
  // UNSTRESSED function words (espeak $u set — a language fact): reduced/de-accented in connected speech.
  // The de-accent pass strips their citation primary stress (I -> a, not stressed); a clause left with no
  // primary then promotes its last word to the nuclear tonic. See src/languages/english/english.ts.
  "unstressedWords": ["about", "above", "across", "already", "among", "amongst", "an", "and", "as", "at", "be", "became", "become", "been", "before", "behind", "below", "beneath", "beside", "between", "beyond", "by", "could", "did", "do", "does", "doth", "for", "from", "goeth", "had", "has", "have", "he", "her", "hers", "his", "i", "if", "in", "is", "it", "its", "made", "may", "might", "my", "not", "of", "or", "our", "over", "per", "she", "should", "than", "that", "thee", "their", "there", "these", "they", "thine", "this", "those", "through", "to", "together", "under", "upon", "we", "what", "whenever", "which", "will", "with", "within", "without", "would", "wouldst", "ye", "yer", "you", "your"]
}
