// Native Ilocano / Iloko (ilo) canonical-IPA definition — Austronesian (NORTHERN Luzon, Ilocano subgroup — NOT
// Bisayan; ~8M, the lingua franca of northern Philippines). Near-phonemic Latin. The g2p reads this file directly.
// Ilocano shares the Philippine core (⟨ng⟩→ŋ, word-initial glottal, penultimate stress) but differs from the
// Bisayan langs (Cebuano/Hiligaynon) in its HIATUS: a HIGH vowel ⟨i u⟩ before another vowel GLIDES (dua→dwa,
// radio→ɾadjo, dies→djes) rather than taking a glottal, while non-high hiatus keeps the glottal (tao→taʔo). Its
// signature vowel is the CLOSE BACK UNROUNDED ⟨e⟩→[ɯ]~[ɛ] (the 6th vowel; not predictable native-vs-loan from
// spelling → default [ɛ], folded). ⟨ll⟩ is a native GEMINATE [lː] (not the Spanish [lj]). Validated against
// wikipron ilo_latn + kaikki ilo + epitran ilo-Latn.
{
    "language": "ilo",
    "name": "Ilocano (Iloko)",
    "script": "Latin",
    "provenance": "Authored from standard Ilocano orthography + phonology (Philippine near-phonemic pattern; high-vowel gliding hiatus + geminates). Calibrated to wikipron ilo_latn + kaikki ilo + epitran ilo-Latn.",

    "digraphs": { "ng": "ŋ", "ts": "t͡s", "gui": "ɡi", "gue": "ɡe", "qui": "ki", "que": "ke" },

    "consonants": {
        "p": "p", "t": "t", "k": "k", "b": "b", "d": "d", "g": "ɡ",
        "m": "m", "n": "n", "s": "s", "h": "h", "l": "l", "r": "ɾ",
        "w": "w", "y": "j", "ñ": "ɲ", "'": "ʔ", "ʼ": "ʔ",
        "c": "k", "q": "k", "z": "s", "f": "p", "v": "b", "j": "h", "x": "ks"
    },

    "vowels": { "a": "a", "e": "ɛ", "i": "i", "o": "o", "u": "u" },

    // NATIVE Austronesian cardinal numerals (composed morphologically by numbers.ts — see that file for the
    // sanga-/ligature/ket rules). Ilocano, like Tagalog and Cebuano, has BOTH a native set and a nativised SPANISH
    // loan set (onse, beinte, mil …) which dominates clock time, dates and money; Wikipedia calls the two "virtually
    // used interchangeably". We speak the NATIVE set, following the precedent already set by tagalog.jsonc
    // (isa/dalawa/sampu) and cebuano.jsonc (usa/duha/napulo): it is what the dictionaries lemmatise for a bare
    // numeral, and a written-out Spanish loan is just a word the g2p already handles. Sources: Wikipedia "Ilocano
    // numbers"; HandWiki "Ilocano numbers"; Wiktionary "Category:Ilocano cardinal numbers". Zero is the Spanish
    // loan "sero" (the native "awan" is 'none', not a numeral; matches tl/ceb). The native series tops out at
    // riwriw 10⁶ → ≥10⁹ reads digit-by-digit.
    "numbers": {
        "units": ["sero", "maysa", "dua", "tallo", "uppat", "lima", "innem", "pito", "walo", "siam"],
        "onePrefix": "sanga",
        "ligature": "a",
        "connector": "ket",
        "magnitudes": { "ten": "pulo", "hundred": "gasut", "thousand": "ribo", "million": "riwriw" }
    },

    "clausePunctuation": {
        ".": ".", "?": "?", "!": "!", ",": ",", ";": ",", ":": ","
    }
}
