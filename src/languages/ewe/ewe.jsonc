// Native canonical-IPA data manifest for Ewe (ee) — Eʋegbe, a Gbe language (Niger-Congo, Kwa), ~7M
// (Ghana/Togo), the Latin-based African alphabet with ⟨ɖ ƒ ʋ ɣ ŋ ɔ ɛ⟩ + the labial-velars ⟨gb kp⟩. The
// engine (ewe.ts) is a near-phonemic longest-match scan: digraphs ⟨gb kp dz ts ny⟩→[ɡ͡b k͡p d͡z t͡s ɲ]
// before single letters; the bilabial/labiodental CONTRAST ⟨ƒ⟩→[ɸ] vs ⟨f⟩→[f] and ⟨ʋ⟩→[β] vs ⟨v⟩→[v];
// ⟨w⟩→[ɰ] and ⟨ɣ⟩→[ɰ] (velar approximant — Standard/Southern Ewe, per Jalloh); ⟨x⟩→[x], ⟨y⟩→[j].
// Nasalization is WRITTEN (a tilde: ã ẽ … → kept). The ⟨r⟩ [l]~[r] and ⟨w⟩ rounding allophony rules are
// code, in ewe.ts. TONE (H/M/L) is UNMARKED in the orthography → not emitted (the Akan/Shona
// unwritten-tone situation; a tone lexicon is deferred).
// ⚠ SINGLE-SOURCE-FAMILY: kaikki and wikipron are the only referees and both derive from Wiktionary, so
// their agreement is not two independent confirmations.
{
    "language": "ee",
    "name": "Ewe (Eʋegbe)",
    "script": ["Latin"],

    // Multi-letter units (longest-match first): labial-velars, affricates, ⟨ny⟩→ɲ.
    "digraphs": { "gb": "ɡ͡b", "kp": "k͡p", "dz": "d͡z", "ts": "t͡s", "ny": "ɲ" },

    // Single letters. ⟨ƒ⟩/⟨ʋ⟩ are the BILABIAL series (vs labiodental ⟨f⟩/⟨v⟩); ⟨ɣ⟩→ɰ, ⟨x⟩→x, ⟨y⟩→j,
    // ⟨r⟩→l (Ewe [l~ɾ], position rule in ewe.ts).
    "letters": {
        "a": "a", "e": "e", "i": "i", "o": "o", "u": "u", "ɛ": "ɛ", "ɔ": "ɔ",
        "b": "b", "d": "d", "ɖ": "ɖ", "f": "f", "ƒ": "ɸ", "g": "ɡ", "h": "h", "k": "k", "l": "l", "m": "m",
        "n": "n", "ŋ": "ŋ", "p": "p", "r": "r", "s": "s", "t": "t", "v": "v", "ʋ": "β", "x": "x",
        "y": "j", "z": "z", "ɣ": "ɰ", "c": "t͡s", "j": "d͡z", "q": "k", "'": "ʔ",
        // ⚠ ⟨ñ⟩ NEEDS ITS OWN ROW OR IT BECOMES /n/. It is not an Ewe letter, but it decomposes to ⟨n⟩ + a
        // tilde, so the base-letter branch in ewe.ts would read the Spanish names Ewe borrows as plain /n/ and
        // throw the palatal away — while Ewe HAS /ɲ/ and writes it ⟨ny⟩ (the digraph above). Listed here, it
        // is matched before that branch is reached.
        "ñ": "ɲ",
    },
}
