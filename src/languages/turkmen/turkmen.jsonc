// Native canonical-IPA data manifest for Standard Turkmen (tk) — Türkmençe, Oghuz Turkic, Latin (30 letters,
// post-1990s). NO digraphs (one sound per letter). The HALLMARK: the INTERDENTAL fricatives
// ⟨s⟩→[θ] and ⟨z⟩→[ð] (Türkmen shares this with Bashkir — surat→θuːrɑt, göz→ɡœð). 9 vowels ⟨a e ä i o ö u ü y⟩ with
// ⟨ä⟩→[æ], ⟨ö⟩→[ø], ⟨ü⟩→[y] (front rounded), ⟨y⟩→[ɯ] (close back unrounded) + UNWRITTEN phonemic length (not
// emitted). ⟨ç⟩→t͡ʃ, ⟨j⟩→d͡ʒ, ⟨ž⟩→ʒ, ⟨ş⟩→ʃ, ⟨ň⟩→ŋ, ⟨ý⟩→j (the glide, vs the vowel ⟨y⟩), ⟨h⟩→x, ⟨w⟩→w, ⟨r⟩→ɾ.
// A longest-match scan + word-final (oxytone) stress. Engine: turkmen.ts.
{
    "language": "tk",
    "name": "Turkmen (Türkmençe)",
    "script": ["Latin"],

    "digraphs": {},

    // The NASALS, for the maximal-onset stress scan (sonority 3) and for the nasal+stop test that keeps a
    // medial nasal in the coda rather than letting it start an onset cluster — Turkic has no such onsets.
    "nasals": ["m", "n", "ŋ"],

    // Single graphemes. Vowels: ⟨ä⟩→æ, ⟨ö⟩→ø, ⟨ü⟩→y, ⟨y⟩→ɯ. Consonants: the interdentals ⟨s⟩→θ / ⟨z⟩→ð, ⟨ç⟩→t͡ʃ,
    // ⟨j⟩→d͡ʒ, ⟨ž⟩→ʒ, ⟨ş⟩→ʃ, ⟨ň⟩→ŋ, ⟨ý⟩→j (glide), ⟨h⟩→x, ⟨r⟩→ɾ (tap), ⟨w⟩→w.
    "graphemes": {
        "a": "ɑ", "e": "e", "ä": "æ", "i": "i", "o": "o", "ö": "ø", "u": "u", "ü": "y", "y": "ɯ",
        "b": "b", "ç": "t͡ʃ", "d": "d", "f": "f", "g": "ɡ", "h": "x", "j": "d͡ʒ", "ž": "ʒ",
        "k": "k", "l": "l", "m": "m", "n": "n", "ň": "ŋ", "p": "p", "r": "ɾ", "s": "θ",
        "ş": "ʃ", "t": "t", "v": "v", "w": "w", "ý": "j", "z": "ð"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // NUMBERS — Turkmen Latin spellings; canonical IPA DERIVED via the same grapheme scan above (never hand-written
    // IPA). Turkic decimal system: a distinct word for each round ten (10 = on lives in `tens`), then juxtaposition
    // with NO connector — 11 = on bir, 25 = ýigrimi bäş, 121 = ýüz ýigrimi bir. Compounds are written as SEPARATE
    // words ("Goşma sanlar goşulyp ýazylman, aýry-aýry ýazylýarlar"), unlike Tatar's fused unbér.
    //
    // SOURCE: enedilim.com "Sanlar" (Türkmen dili / Morfologiýa we orfografiýa) for the composition rule and the
    // worked example "bir müň dokuz ýüz togsan iki" (1992); Wiktionary "Appendix:Turkmen numerals" (Module:number
    // list/data/tk) + Omniglot "Numbers in Turkmen" for the lexemes.
    // JUDGMENT CALL — 90: Omniglot spells it ⟨dogsan⟩, Wiktionary's data module ⟨togsan⟩. Taken as "dogsan": it
    // matches Turkmen's initial-d in ⟨dokuz⟩ 9 (vs Kipchak тоғыз/тоқсан), and it is the form in the Turkmen
    // orthographic tradition Omniglot follows. The enedilim example writes "togsan", so both circulate.
    "numbers": {
        "units": ["nol", "bir", "iki", "üç", "dört", "bäş", "alty", "ýedi", "sekiz", "dokuz"],
        "tens": { "10": "on", "20": "ýigrimi", "30": "otuz", "40": "kyrk", "50": "elli", "60": "altmyş", "70": "ýetmiş", "80": "segsen", "90": "dogsan" },
        "magnitudes": { "hundred": "ýüz", "thousand": "müň", "million": "million", "billion": "milliard" }
    },
}
