// Native canonical-IPA data manifest for Occitan (oc) — occitan / lenga d'òc, Occitano-Romance (Gallo-Romance) of
// southern France (~200k). Targets LANGUEDOCIEN (the central reference standard). espeak-independent, beyond-espeak.
// Signature: final unstressed ⟨a⟩→[ɔ], unstressed ⟨o⟩→[u], ⟨u⟩→[y]; ⟨lh⟩→ʎ, ⟨nh⟩→ɲ, ⟨ch⟩→t͡ʃ. Spirantization +
// stress folded. Engine: occitan.ts. See docs/investigations/oc_native_bringup_investigation.md.
{
    "language": "oc",
    "name": "Occitan (occitan)",
    "script": "Latin",

    // Multi-letter graphemes, scanned LONGEST-FIRST. Digraphs ⟨lh nh ch⟩; ⟨qu gu⟩ before a front vowel = [k ɡ];
    // diphthong offglides ⟨u⟩→[w] and ⟨i⟩→[j] are handled in code (context-dependent).
    "digraphs": {
        "lh": "ʎ", "nh": "ɲ", "ch": "t͡ʃ", "tg": "d͡ʒ", "tj": "d͡ʒ", "tz": "t͡s", "rr": "r", "ss": "s"
    },

    // Single grapheme → canonical IPA (BASE values; the ⟨c g⟩ softening, ⟨o⟩→[u], final-⟨a⟩→[ɔ], intervocalic ⟨s⟩→[z],
    // and the offglides are applied in code). ⟨v⟩→b (betacism), ⟨u⟩→y, accented vowels á→a é→e í→i ó→u ú→y à→a è→ɛ ò→ɔ.
    "graphemes": {
        "a": "a", "e": "e", "i": "i", "o": "u", "u": "y",
        "á": "a", "é": "e", "í": "i", "ó": "u", "ú": "y", "à": "a", "è": "ɛ", "ò": "ɔ", "ï": "i", "ü": "y",
        "b": "b", "c": "k", "ç": "s", "d": "d", "f": "f", "g": "ɡ", "h": "", "j": "d͡ʒ",
        "k": "k", "l": "l", "m": "m", "n": "n", "p": "p", "q": "k", "r": "ɾ", "s": "s", "t": "t",
        "v": "b", "w": "w", "x": "ks", "y": "i", "z": "z"
    },

    "clausePunctuation": {
        ".": ".", "!": "!", "?": "?", "…": ",", ",": ",", ";": ",", ":": ",",
    },

    // CARDINAL NUMBER WORDS (Languedocien reference forms). Composition logic in numbers.ts.
    // SOURCE: omniglot.com/language/numbers/occitan.htm + languagesandnumbers.com/how-to-count-in-occitan
    // (mirrored at occitan-foss.blogspot.com/2025/04/numbers-in-occitan.html), cross-checked against
    // Alibèrt's Gramatica occitana forms. Occitan is DECIMAL throughout — the tens are setanta / ochanta /
    // nonanta, NOT the Provençal-style vigesimal ⟨quatre-vint⟩ (the Languedocien reference variety this
    // engine targets). The orthographic hyphens of ⟨dètz-e-sèt⟩ / ⟨vint-e-un⟩ are written as SPACES so each
    // element reads through the g2p as its own word.
    "numbers": {
        // 0–19. 17–19 are the analytic ⟨dètz e …⟩ series (stored pre-split into words).
        "ones": ["zèro", "un", "dos", "tres", "quatre", "cinc", "sièis", "sèt", "uèch", "nòu", "dètz", "onze",
            "dotze", "tretze", "catòrze", "quinze", "setze", "dètz e sèt", "dètz e uèch", "dètz e nòu"],
        "tens": ["", "", "vint", "trenta", "quaranta", "cinquanta", "seissanta", "setanta", "ochanta", "nonanta"],
        "hundreds": ["", "cent", "dos cents", "tres cents", "quatre cents", "cinc cents", "sièis cents",
            "sèt cents", "uèch cents", "nòu cents"],
        "thousand": "mila", // 1000 = mila, 2000 = dos mila (invariable)
        // The ⟨e⟩ connector joins ONLY the twenties (vint e un, vint e dos); 30–90 juxtapose (trenta un).
        "and": "e",
        // Long-scale-free French-shaped chain: milion = 10⁶, miliard = 10⁹.
        "scales": [
            { "value": 1000000000, "one": "un miliard", "many": "miliards" },
            { "value": 1000000, "one": "un milion", "many": "milions" },
        ],
    },
}
